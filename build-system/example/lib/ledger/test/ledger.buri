// The suite for //lib/ledger. It may import the library under test, the
// library's own dependencies (//lib/money), anything in `test.dependencies`,
// and core/*.
//
// The fixture comes from this library's own testing surface rather than from a
// private helper, because //tools/report's suite wants the same one.

from "//lib/ledger" import { total, Rule, apply };
from "//lib/ledger/testing" import { sample };
from "//lib/money" import { fromCents };
from "core/testing/assert" import * as assert;
from "core/testing/context" import { context };

test "total sums every entry" {
  assert.eq(total(sample()), fromCents(3650));
}

test "DropZero removes zero-amount entries" {
  let ctx = context();
  let kept = apply(sample(), ctx, Rule.DropZero);
  assert.eq(kept.len(), 2);
  assert.eq(total(kept), fromCents(3650));
}

test "MemoPrefix keeps matching memos" {
  let ctx = context();
  let kept = apply(sample(), ctx, Rule.MemoPrefix { prefix: "co" });
  assert.eq(kept.len(), 1);
}
