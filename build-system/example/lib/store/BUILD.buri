# //lib/store — the persistence layer. Two restrictions, for two different
# reasons:
#
#   visibility  who may write a dependency edge to it   (API ownership)
#   tags        what may end up in one artifact         (deployment boundary)
#
# Visibility keeps the layering honest: only the server binary and the library
# itself may depend on it directly. The tag is the one that survives four hops
# of indirection — nothing tagged `server` is ever linked into a client binary,
# whoever pulls it in.
#
# Note what is *not* here: no platform restriction. This library has no opinion
# about platforms of its own. It cannot be built for JS, but that follows from
# the `server` tag's policy in REPO.buri, stated once for all server code.

library {
  name: "store"
  sources: [
    "codec.buri",
    "file_store.buri",
  ]
  dependencies: [
    "//lib/ledger",
    "//lib/money",
  ]
  tags: ["server"]
  visibility: ["//cmd/server"]

  test {
    sources: ["test/store.buri"]
    data: ["test/golden/log.txt"]
  }
}
