// Internal to //lib/money. Reachable from ./parse and ./lib, and from nothing
// outside the library.
//
// A type's methods live in the module that declares the type (SPEC.md 6.7.3),
// so `Cents` and everything callable as `c.something()` are in this file. That
// is the constraint that decides how a library's files are laid out: one type,
// one module, however many free functions elsewhere.

from "core/cap" import { Alloc };
from "core/str" import * as str;

/// Money is never a raw integer. The representation is not exported, so there
/// is no way to add a Cents to an I64 anywhere — including inside this library,
/// outside this module.
export opaque struct Cents(I64);

derive Eq, Ord, Show for Cents;

export fn fromDollars(d: I64): Cents { Cents(d * 100) }

export fn fromCents(c: I64): Cents { Cents(c) }

export fn add(self: Cents, other: Cents): Cents { Cents(self.0 + other.0) }

export fn isZero(self: Cents): Bool { self.0 == 0 }

/// Receiver first, context second, as everything callable as a method is.
/// Allocates, and says so; performs no I/O, and says that by omission.
export fn format(self: Cents, ctx: { alloc: Alloc, .. }): Str {
  let whole = self.0 / 100;
  let rest = self.0 % 100;
  let pad = if (rest < 10) { "0" } else { "" };
  str.format(ctx, "\$${whole}.${pad}${rest}")
}

/// Exported from this module so ./parse can build one from a checked integer,
/// and absent from lib.buri, so it stops at the library boundary — as a free
/// function and as a method. `c.toCents()` outside //lib/money does not resolve.
export fn toCents(self: Cents): I64 { self.0 }
