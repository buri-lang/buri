// Tests for the library half of this package. `//tools/report` is the library,
// so this suite sees lib.buri's surface.
//
// The ledger fixture comes from //lib/ledger's testing surface — a real
// library, declared in `test.dependencies`, that no production target can
// import because its path contains a `testing` segment.

from "//tools/report" import { render };
from "//lib/ledger/testing" import { oneOff, sample };
from "core/testing/assert" import * as assert;
from "core/testing/context" import { context };

test "the terse report is one line" {
  let ctx = context();
  assert.eq(render(oneOff(), ctx, false), "\ntotal \$4.50");
}

test "verbose lists every entry" {
  let ctx = context();
  let out = render(sample(), ctx, true);
  assert.isTrue(out.contains("coffee"));
  assert.isTrue(out.contains("books"));
}
