# //cmd/web:web — the same language, a different output. One entry point, one
# JS module.
#
# Adding "//lib/store" to deps compiles fine as a graph and fails the tag check
# with the path printed:
#
#   error: //cmd/web:web cannot be built for js
#     = configuration: platform=js, tier=client
#     = //lib/store accepts only tier=server, and this build is tier=client
#     = reached by: //cmd/web:web -> //lib/store
#     = "server": runs on infrastructure we operate
#
# Dropping `tags: ["client"]` does not help either — REPO.buri constrains
# platform=js to require tier=client, so the binary would fail before any
# library was consulted.

binary {
  name: "web"
  deps: [
    "//lib/ledger",
    "//lib/money",
  ]
  tags: ["client"]

  outputs: [
    { platform: JS, js { module: ESM } },
  ]
}
