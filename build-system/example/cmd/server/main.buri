// The entry point. It is also this binary's surface for tests: `test/routes.buri`
// sees what this file exports, and nothing else — the same rule `lib.buri`
// follows for a library.

from "core/cap" import { Alloc, Env, Fs, Stdout };
from "core/env" import * as env;
from "core/io" import * as io;

from "//lib/ledger" import { entry };
from "//lib/money" import { fromCents };
from "//lib/store" import { append };

// Re-exported so the suite can reach it. Everything else in ./routes stays
// inside the binary.
from "./routes" export { Route, route };

from "./routes" import { route };

/// The context is closed — no trailing `..` — so the platform grants exactly
/// these four capabilities and nothing else. Under `platform: JS` this same
/// signature would fail to build: a browser platform has no `Fs` to grant.
export fn main(ctx: { alloc: Alloc, stdout: Stdout, fs: Fs, env: Env }): Result<{}, Str> {
  let path = env.get(ctx, "LEDGER_LOG") ?? "ledger.log";
  let hit = route("/entries");

  match (append(ctx, path, [entry("startup", fromCents(0))])) {
    .Err(_) => .Err("could not open the ledger log"),
    .Ok(_) => {
      let _ = io.println(ctx, "serving ${hit.name} from ${path}");
      .Ok({})
    },
  }
}
