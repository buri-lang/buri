// Tests for a binary. The label needs its `:name`, because `//cmd/server` on
// its own means the package's library and this package has none.

from "//cmd/server:server" import { route };
from "core/cap" import { Alloc };
from "core/test" import { Expect };
from "core/test" import * as t;

test "known paths get their handler" (ctx: { alloc: Alloc, expect: Expect }): Result<{}, Str> {
  t.eq(ctx, route("/entries").name, "entries")?;
  t.eq(ctx, route("/health").name, "health")?;
  .Ok({})
}

test "unknown paths fall back" (ctx: { alloc: Alloc, expect: Expect }): Result<{}, Str> {
  t.eq(ctx, route("/nope").name, "fallback")?;
  .Ok({})
}

// The suite can only see what main.buri exports. Moving logic behind the entry
// point is what makes it testable, which is the pressure you want.
