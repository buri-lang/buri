# The root of the example repository. Its presence is what makes this directory
# the repository root, and what `//` in every label resolves against.
#
# Schema: buri.build.v1.RepoConfig — ../schema/build.proto

name: "acme"

toolchain {
  version: "0.2.0"
  sha256: "9f2b1c4e8a7d3f60b5c1e9a24d7f8036b1c5e2a94f7d0b83c6e1a5d2f9b04c7e3"
  flags: ["--warnings-as-errors"]
}

# `platform` and `arch` are predeclared. This repository adds one axis: whether
# code runs on a user's machine or on ours.
dimension {
  name: "tier"
  value { name: "client" doc: "ships to a user's machine or browser" }
  value { name: "server" doc: "runs on infrastructure we operate" }
}

# Policy, stated once, about which worlds may exist at all. Independent of any
# particular library — libraries say where they may go, this says which
# configurations are coherent.
constraint {
  when: "platform=js"
  require: ["tier=client"]
  message: "the JS output ships to browsers; server code is not shipped to users"
}

defaults {
  # Nothing is visible until a library says so.
  visibility: ["//visibility:private"]
  test_timeout_seconds: 60
}

lint {
  error: ["unreachable-export"]
}
