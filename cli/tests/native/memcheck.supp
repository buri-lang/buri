# Memcheck suppressions (cli/tests/native/valgrind.rs). Every entry says why it
# is not a bug in Buri or its runtime. An error in Buri code or in cli/runtime
# is never suppressed here: it is filed.

# ring's AES-GCM on x86_64. Memcheck models PCLMULQDQ and AES-NI as opaque
# helpers whose result is wholly undefined when any input bit is, so a GHASH
# over a block ring loads whole and masks makes the tag "uninitialised". The
# arm64 build of the same code reports nothing.
{
   ring-gcm-tag-compare
   Memcheck:Cond
   fun:*ring*aead*open_within*
}
# The same compare where an optimised program inlined `open_within` into
# rustls's decrypt. Valgrind's own CPU has no ADX, so under it the runtime
# takes ring rather than graviola (cli/runtime/tls.rs, `provider`).
{
   ring-gcm-tag-compare-inlined
   Memcheck:Cond
   fun:*rustls*ring*tls13*Tls13MessageDecrypter*decrypt*
}
{
   ring-gcm-ciphertext-sendto
   Memcheck:Param
   socketcall.sendto(msg)
   ...
   fun:*rustls*ChunkVecBuffer*write_to*
}
# Memcheck names a `writev` parameter by its index exactly, so one entry each
# for the slices rustls writes a record from.
{
   ring-gcm-ciphertext-writev-0
   Memcheck:Param
   writev(vector[0])
   ...
   fun:*write_to*
}
{
   ring-gcm-ciphertext-writev-1
   Memcheck:Param
   writev(vector[1])
   ...
   fun:*write_to*
}
{
   ring-gcm-ciphertext-writev-2
   Memcheck:Param
   writev(vector[2])
   ...
   fun:*write_to*
}
{
   ring-gcm-ciphertext-writev-3
   Memcheck:Param
   writev(vector[3])
   ...
   fun:*write_to*
}
# tokio's timer wheel on arm64, in a test build only: `debug_assert!` that no
# level expires before the one found. `no_expirations_before` reads each
# level's `Option<Expiration>`, and LLVM selects with `csinc` on the deadline
# before it tests the tag, so for `None` the select is keyed on an unset
# deadline whose arms are both `true`. Memcheck marks the result unset. x86_64
# reports nothing, and a release runtime has no `debug_assert!`.
{
   tokio-wheel-debug-assert-arm64
   Memcheck:Cond
   fun:*tokio*time*wheel*Wheel*next_expiration*
}
