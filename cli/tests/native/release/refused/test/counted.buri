from "core/str" import * as str;
from "core/tasks" import * as tasks;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "platform/effect" import { Allocator, Region, Tasks };
from "platform/effect/testing" import { alloc, tasks };

// An allocator that holds a `Str`, so a context of it owns a count.
struct Named {
    name: Str,
}

impl Allocator for Named {
    fn allocate(self, bytes: Int): Region {
        Region(bytes)
    }
}

test "a step whose context owns a count" {
    let first = context {
        Allocator: alloc(),
    };
    let ctx = context {
        Allocator: Named { name: str.format(first, "${7}") },
        Tasks: tasks(),
    };
    let out = tasks.parallel(ctx, [1, 2], fn(c, i, n) => str.format(c, "${i}${n}"));
    assert.equal(out, ["01", "12"]);
}

test "a timer whose context owns a count" {
    let first = context {
        Allocator: alloc(),
    };
    let ctx = context {
        Allocator: Named { name: str.format(first, "${7}") },
        Tasks: tasks(),
    };
    tasks.cancel(ctx, tasks.after(ctx, time.milliseconds(1), fn(c) => ()));
}
