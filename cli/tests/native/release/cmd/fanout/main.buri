from "core/io" import * as io;
from "core/str" import * as str;
from "core/tasks" import * as tasks;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout, Tasks };

// Forty `Int`s and a `Str`: wide, and counted.
struct Job(Str, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int, Int);

fn job(name: Str, n: Int): Job {
    Job(
        name,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
        n,
    )
}

// The host's implementations hold nothing, so the step's context is no bytes.
export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Tasks: host.tasks,
    };
    let jobs = [job("a", 1), job("b", 2), job("c", 3)];
    let done = tasks.parallel(ctx, jobs, fn(c, i, j) => {
        str.format(c, "${j.0}${j.1 + j.40 + i}")
    });
    io
        .println(ctx, done.join(ctx, " "))
        .mapErr(fn(_e) => "could not write to standard output")
}
