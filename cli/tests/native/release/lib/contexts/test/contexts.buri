from "core/fs" import * as fs;
from "core/fs" import { FileSystemRead };
from "core/path" import * as path;
from "core/str" import * as str;
from "core/tasks" import * as tasks;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Region, Tasks };
from "platform/effect/testing" import { alloc, fs as testFs, tasks as testTasks };

// An allocator that owns a `Str`, so a context binding it owns a count.
struct Named {
    name: Str,
}

impl Allocator for Named {
    fn allocate(self, bytes: Int): Region {
        Region(bytes + self.name.length())
    }
}

fn sizes<C: Allocator + FileSystemRead + Tasks>(ctx: C, names: [Str]): [Int] {
    tasks.parallel(ctx, names, fn(c, i, name) => {
        match (fs.readText(c, path.of(c, name))) {
            .Ok(text) => text.length() + i - i,
            .Err(_) => -1,
        }
    })
}

test "parallel reads through the test file system" {
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: testFs().files([("a.txt", "one"), ("b.txt", "three")]),
        Tasks: testTasks(),
    };
    assert.equal(sizes(ctx, ["a.txt", "b.txt"]), [3, 5]);
    assert.equal(sizes(ctx, ["b.txt", "c.txt", "a.txt"]), [5, -1, 3]);
}

test "a step is handed a context that owns a count" {
    let first = context {
        Allocator: alloc(),
    };
    let ctx = context {
        Allocator: Named { name: str.format(first, "${7}") },
        Tasks: testTasks(),
    };
    assert.equal(tasks.parallel(ctx, [1, 2], fn(c, i, x) => x + i), [1, 3]);
    // A second element type: a second copy of the step.
    assert.equal(tasks.parallel(ctx, [true], fn(c, i, b) => !b), [false]);
    // A step that allocates through the context it was handed.
    let out = tasks.parallel(ctx, ["a", "b"], fn(c, i, s) => str.format(c, "${i}${s}"));
    assert.equal(out, ["0a", "1b"]);
}
