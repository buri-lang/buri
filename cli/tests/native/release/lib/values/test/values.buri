from "core/bits" import * as bits;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

// A function field leaves `Handler` with no `Show` to print a failure with.
struct Handler {
    id: Int,
    run: fn(Int) => Int,
}

impl Equal for Handler {
    fn equal(self, other: Self): Bool {
        self.id == other.id
    }
}

test "a value with no Show is still asserted equal" {
    let a = Handler { id: 1, run: fn(n) => n + 1 };
    let b = Handler { id: 1, run: fn(n) => n * 2 };
    assert.equal(a, b);
    assert.notEqual(a, Handler { ..b, id: 2 });
    assert.equal(a.run(3) + b.run(3), 10);
}

test "a function the runtime supplies is passed as a value" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal([1, 3, 7].map(ctx, bits.popCount), [1, 2, 3]);
    let count = bits.popCount;
    assert.equal(count(255), 8);
}

// A word, then padding, then a 128-bit value.
struct Mixed {
    a: Int,
    b: I128,
}

test "a word beside a 128-bit value is stored and read back" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = [Mixed { a: 1, b: 2 }, Mixed { a: 3, b: 4 }];
    assert.equal(xs.map(ctx, fn(m) => m.a), [1, 3]);
}
