from "node" import { NodeHost };
from "platform/effect" import { Allocator, Environment, Stdout };
from "//libs/convert" import { run };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Environment: host.env,
        Stdout: host.stdout,
    };

    match (run(ctx)) {
        .Ok(_) => .Ok(()),
        .Err(e) => .Err(e.message()),
    }
}
