// Evaluation order is left to right (SPEC 8.2). An argument that needs
// statements to compute turns into statements placed *before* the call, so
// anything written to its left has to be pinned ahead of them rather than left
// sitting in the argument list to run afterwards.
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

enum Pick { A, B }

fn noisy<C: Stdout>(ctx: C, tag: Str, v: Int): Int {
  let _ = io.println(ctx, "${tag}").ignore();
  v
}

fn both(a: Int, b: Int): Int { a * 100 + b }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let p: Pick = .B;

  // The first argument has an effect; the second needs statements.
  let r = both(noisy(ctx, "first", 1), match (p) { .A => 0, .B => noisy(ctx, "second", 2) });
  let _ = io.println(ctx, "${r}").ignore();

  // Three deep, so a single pin is not enough.
  let s = both(
    noisy(ctx, "one", 1),
    both(noisy(ctx, "two", 2), match (p) { .A => 0, .B => noisy(ctx, "three", 3) }),
  );
  let _ = io.println(ctx, "${s}").ignore();
  .Ok(())
}
