// Array patterns, including a trailing rest — which allocates, so where the
// allocation happens relative to the test that guards it is visible here.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn describe(xs: [Int]): Template {
    match (xs) {
        [] => "empty",
        [only] => "one: ${only}",
        [a, b] => "two: ${a},${b}",
        [head, ..rest] => "head ${head} and ${rest.length()} more",
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, describe([])).ignore();
    let _ = io.println(ctx, describe([1])).ignore();
    let _ = io.println(ctx, describe([1, 2])).ignore();
    let _ = io.println(ctx, describe([1, 2, 3, 4])).ignore();
    .Ok(())
}
