// design/ui-reactivity.md, "Styling" — a style handed to a node, compiled.
//
// `badge` is given its style rather than writing it. The style stays a value
// until the node reads it, so `ui/style`'s `classify` names it there: it is
// handed the names and classes of every style the compiler saw reach that
// node, and the sheet in `expected.css` holds each of those classes.
//
// What it prints is one line. A mounted page has nothing to say on the way out.

from "core/io" import * as io;
from "platform/effect" import { Allocator, Stdout, Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Style };

// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "web" import { WebHost };

fn badge<C>(look: Style): Node<C> {
    ui.stack({ styles: [look], children: [] })
}

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Ui: host.ui,
        Watch: host.watch,
    };
    let _ = io.println(ctx, "handed").ignore();
    ui.mount(
        ctx,
        ui.stack({
            styles: [],
            children: [badge(.Padding(.Px(8))), badge(.Width(.Px(12)))],
        }),
        [],
    )
}
