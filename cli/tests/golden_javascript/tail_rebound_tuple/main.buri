// A tuple bound in a tail-recursive function and read in the call that loops.
// The loop rebinds the parameters before it reads the tuple, so a slot pasted
// to its read sees the next call's `n` instead of this one's.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn doubledSum(n: Int, acc: Int): Int {
    let pair = (n * 2, acc + 1);
    if (n == 0) { acc } else { doubledSum(n - 1, acc + pair.0) }
}

fn ping(n: Int, acc: Int): Int {
    let pair = (n * 2, acc);
    if (n == 0) { acc } else { pong(n - 1, acc + pair.0) }
}

fn pong(n: Int, acc: Int): Int {
    let pair = (n * 3, acc);
    if (n == 0) { acc } else { ping(n - 1, acc + pair.0) }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    // `6 + 4 + 2`, and `5*2 + 4*3 + 3*2 + 2*3 + 1*2`.
    let _ = io.println(ctx, "${doubledSum(3, 0)} ${ping(5, 0)}").ignore();
    .Ok(())
}
