// Every variant nullary, so the enum is already a bare integer tag. The match
// over it is the cheapest one the backend has to compile.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

enum Colour {
    Red,
    Green,
    Blue,
    Cyan,
    Magenta,
    Yellow,
}

fn name(c: Colour): Str {
    match (c) {
        .Red => "red",
        .Green => "green",
        .Blue => "blue",
        .Cyan => "cyan",
        .Magenta => "magenta",
        .Yellow => "yellow",
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, "${name(Colour.Red)} ${name(Colour.Yellow)}").ignore();
    let _ = io.println(ctx, "${name(Colour.Blue)} ${name(Colour.Magenta)}").ignore();
    .Ok(())
}
