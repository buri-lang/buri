// A closure with a block body that nothing calls. Its binding goes, and the
// arrow stays behind as a statement of its own, which JavaScript reads as a
// block unless it is parenthesised.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn next(n: Int): Int {
    let square = fn(x: Int) => {
        let y = x + n;
        y * y + y
    };
    n + 1
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, "${next(3)} ${next(41)}").ignore();
    .Ok(())
}
