// Construction, field access, and functional update — which copies, because
// the language has no assignment and the backend does not yet know when the
// copy is unobservable.
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

struct Point { x: Int, y: Int }

struct Line { from_: Point, to: Point, label: Str }

fn moved(p: Point, dx: Int, dy: Int): Point {
  Point { x: p.x + dx, y: p.y + dy }
}

fn relabelled(l: Line, label: Str): Line {
  Line { ..l, label: label }
}

fn span(l: Line): Int {
  (l.to.x - l.from_.x) + (l.to.y - l.from_.y)
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let a = Point { x: 1, y: 2 };
  let b = moved(a, 10, 20);
  let l = Line { from_: a, to: b, label: "first" };
  let m = relabelled(l, "second");
  let _ = ctx.println("${b.x},${b.y}");
  let _ = ctx.println("${m.label} ${span(m)}");
  .Ok(())
}
