// The same constant aggregates built over and over. Nothing observes the
// identity of an immutable value, so each of these could be built once.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

enum Level {
    Debug,
    Info,
    Warn,
    Error_(Str),
}

struct Config {
    retries: Int,
    label: Str,
}

fn defaultConfig(): Config {
    Config { retries: 3, label: "default" }
}

fn quiet(): Level {
    Level.Info
}

fn origin(): (Int, Int) {
    (0, 0)
}

fn primes(): [Int] {
    [2, 3, 5, 7, 11]
}

fn severity(l: Level): Int {
    match (l) {
        .Debug => 0,
        .Info => 1,
        .Warn => 2,
        .Error_(_) => 3,
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let a = defaultConfig();
    let b = defaultConfig();
    let _ = io.println(ctx, "${a.retries + b.retries} ${a.label}").ignore();
    let _ = io
        .println(ctx, "${severity(quiet())} ${severity(Level.Error_("x"))}")
        .ignore();
    let _ = io
        .println(ctx, "${origin().0} ${primes().length()} ${primes().sum()}")
        .ignore();
    .Ok(())
}
