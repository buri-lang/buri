// A match over string literals: a run of `===` comparisons where a JavaScript
// `switch` would do.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn code(name: Str): Int {
    match (name) {
        "get" => 1,
        "put" => 2,
        "post" => 3,
        "patch" => 4,
        "delete" => 5,
        "head" => 6,
        _ => 0,
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io
        .println(ctx, "${code("get")} ${code("delete")} ${code("nope")}")
        .ignore();
    .Ok(())
}
