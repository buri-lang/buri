// `Animation`, when the compiler cannot fold which one.
//
// The variant comes through an effectful read, so it is not a class. It is
// written inline as the `--buri-anim` custom property, and one stylesheet rule
// reads it, still inside the reduced-motion guard, so a reader who asked for
// less motion sees the element still. Either variant can land there, so both
// keyframes are written, and `expected.mjs` binds the inline lowering that
// knows `Animation`.

from "core/io" import * as io;
from "platform/effect" import { Allocator, Stdout, Ui, Watch };
from "ui/node" import * as ui;
from "ui/signal" import { signal };

// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Ui: host.ui,
        Watch: host.watch,
    };
    let busy = signal(ctx, true);
    let _ = io.println(ctx, "busy").ignore();
    ui.mount(
        ctx,
        ui.stack({
            styles: [
                .Width(.Px(20)),
                .Height(.Px(20)),
                .Animation(if (busy.get(ctx)) { .Spin } else { .Pulse }),
            ],
            children: [],
        }),
        [],
    )
}
