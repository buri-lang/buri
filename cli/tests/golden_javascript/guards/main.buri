// Guards: an arm that matches may still fall through, which is why the arms
// are a sequence of `if`s rather than a chain. In tail position every arm
// returns, so nothing wraps them.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn size(n: Int): Str {
    match (n) {
        x if x > 100 => "huge",
        x if x > 10 => "big",
        x if x > 0 => "small",
        _ => "none",
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, "${size(500)} ${size(50)} ${size(5)} ${size(0)}").ignore();
    .Ok(())
}
