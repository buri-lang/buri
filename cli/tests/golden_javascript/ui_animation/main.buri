// `Animation`, compiled: a closed style in the static tier.
//
// Three things to read in `expected.css`:
//
//   - **Every rule that moves is guarded.** Each one sits alone inside
//     `@media (prefers-reduced-motion:no-preference)`, so a reader who asked
//     for less motion sees the spinner still.
//   - **The keyframes are written once**, though three classes run them.
//   - **Only what is used is written.** Nothing here pulses, so there are no
//     pulse keyframes, and `expected.mjs` carries no animation code: every
//     animation is a class.

from "core/io" import * as io;
from "platform/effect" import { Allocator, Stdout, Ui, Watch };
from "ui/node" import * as ui;

// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Ui: host.ui,
        Watch: host.watch,
    };
    let _ = io.println(ctx, "spinning").ignore();
    ui.mount(
        ctx,
        ui.stack({
            styles: [.Layout(.Row), .Gap(.Px(8))],
            children: [
                ui.progress({
                    label: .Const("Loading"),
                    styles: [.Width(.Px(20)), .Height(.Px(20)), .Animation(.Spin)],
                }),
                ui.stack({
                    styles: [
                        .Width(.Px(20)),
                        .On(.Hover, [.Animation(.Spin)]),
                        .At(.Medium, [.Animation(.Spin)]),
                    ],
                    children: [],
                }),
            ],
        }),
        [],
    )
}
