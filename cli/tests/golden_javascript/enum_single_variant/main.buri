// One variant, so there is nothing to discriminate: the tag test is dead
// weight and the backend already knows it.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

enum Wrapped {
    Only(Int, Str),
}

fn describe(w: Wrapped): Template {
    match (w) {
        .Only(n, s) => "${s}:${n}",
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, describe(Wrapped.Only(7, "seven"))).ignore();
    .Ok(())
}
