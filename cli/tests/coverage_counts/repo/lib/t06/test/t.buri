from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s06" import * as g;
from "//lib/s06" import { E, R };
from "//lib/t06" import * as t;

test "f0" {
    assert.equal(g.f0(true, false, true), 1);
}

test "f1" {
    assert.equal(g.f1(true, 10, 4), false);
}

test "f1 aborts 0" {
    assert.equal(g.f1(true, 3, 0), false);
}

test "f2" {
    let p0 = R { f0: -2, f1: true, f2: 2 };
    let q0 = R { f0: -2, f1: false, f2: 2 };
    assert.equal(g.f2(false, p0, q0), false);
    let p1 = R { f0: 1, f1: true, f2: -1 };
    let q1 = R { f0: 1, f1: true, f2: -1 };
    assert.equal(g.f2(true, p1, q1), true);
}

test "f3" {
    assert.equal(g.f3(175, 0), 43);
    assert.equal(g.f3(1473, 0), 368);
}

test "f4" {
    assert.equal(g.f4(true, 17, 1), true);
    assert.equal(g.f4(true, 7, 3), true);
}

test "f4 aborts 0" {
    assert.equal(g.f4(true, 2, 0), false);
}

test "f5" {
    assert.equal(g.f5(true, 4, 1), true);
}

test "f6" {
    assert.equal(g.f6([]), 0);
    assert.equal(g.f6([9, 9, 3]), 21);
}

test "f7" {
    assert.equal(g.f7([3]), 0);
    assert.equal(g.f7([2, 1, 4]), 0);
    assert.equal(g.f7([6, 8]), 14);
}

test "pick" {
    assert.equal(t.pick(false), 0);
    assert.equal(t.pick(true), 1);
    assert.equal(t.pick(true), 1);
}
