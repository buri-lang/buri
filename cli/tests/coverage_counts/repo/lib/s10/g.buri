from "core/bits" import * as bits;

export fn f0<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}

export fn f1(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 5 == 3) { 1 } else { 0 };
        here + f1(n - 1)
    }
}

export fn f2(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        1 => 11,
        _ => 99,
    }
}

export fn f3(n: Int): Int {
    bits.shiftLeft(1, n)
}

export fn f4(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        _ => 99,
    }
}
