from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s05" import * as g;
from "//lib/s05" import { E, R };

test "f0" {
    let p2 = R { f0: true, f1: false };
    let q2 = R { f0: true, f1: false };
    assert.equal(g.f0(false, p2, q2), false);
    let p3 = R { f0: false, f1: true };
    let q3 = R { f0: false, f1: false };
    assert.equal(g.f0(true, p3, q3), false);
}

test "f2" {
    assert.equal(g.f2(true, 12), true);
    assert.equal(g.f2(true, 5), false);
}

test "f3" {
    assert.equal(g.f3([3, 8]), 8);
    assert.equal(g.f3([4, 5, 0, 1]), 9);
}

test "f5" {
    assert.equal(g.f5(true, "3", "4"), "3");
}

test "f6" {
    assert.equal(g.f6(true, 12, 2), true);
}

test "derived" {
    assert.equal(E.B(2) == E.C(1, 2), false);
    assert.equal(E.C(2, 0) == E.C(2, 0), true);
    let a0 = R { f0: false, f1: false };
    let b0 = R { f0: false, f1: false };
    assert.equal(a0 == b0, true);
    assert.equal(E.C(0, 2) < E.C(0, 2), false);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(E.A.show(ctx), ".A");
    assert.equal(E.A.show(ctx), ".A");
    let r0 = R { f0: false, f1: false };
    assert.equal(r0.show(ctx), "R { f0: false, f1: false }");
    let r1 = R { f0: true, f1: false };
    assert.equal(r1.show(ctx), "R { f0: true, f1: false }");
}
