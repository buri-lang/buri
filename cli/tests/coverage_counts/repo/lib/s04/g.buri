export fn f0<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}

export fn f1(a: Bool, n: Int): Bool {
    a && f1big(n)
}

fn f1big(n: Int): Bool {
    n > 3
}

export fn f2(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 2 == 0) { 1 } else { 0 };
        f2(n - 1, acc + step)
    }
}

fn f3check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f3(a: Int, b: Int): Result<Int, Str> {
    let x = f3check(a)?;
    let y = f3check(b)?;
    .Ok(x + y)
}

fn f4check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f4(a: Int, b: Int): Result<Int, Str> {
    let x = f4check(a)?;
    let y = f4check(b)?;
    .Ok(x + y)
}

fn f5check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f5(a: Int, b: Int): Result<Int, Str> {
    let x = f5check(a)?;
    let y = f5check(b)?;
    .Ok(x + y)
}
