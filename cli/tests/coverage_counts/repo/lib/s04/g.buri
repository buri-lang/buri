derive Equal, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal for R;
export struct R {
    export f0: E,
    export f1: E,
}

export fn f0(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 5 == 1) { 1 } else { 0 };
        f0(n - 1, acc + step)
    }
}

export fn f1(a: Bool, p: R, q: R): Bool {
    a && p == q
}

export fn f2(items: [Int]): Int {
    items.fold(fn(acc, x) => if (x > 4) { acc + x } else { acc }, 0)
}

export fn f3(a: Bool, n: Int): Bool {
    a && f3big(n)
}

fn f3big(n: Int): Bool {
    n > 7
}

export fn f4(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 2 == 1) { 1 } else { 0 };
        f4(n - 1, acc + step)
    }
}

export fn f5(a: Bool, b: Bool, c: Bool, d: Bool): Int {
    if (!(a && !b && c) || d) {
        let r = 1;
        r
    } else {
        let r = 0;
        r
    }
}
