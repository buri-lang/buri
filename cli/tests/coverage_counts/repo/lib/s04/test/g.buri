from "core/testing/assert" import * as assert;
from "//lib/s04" import * as g;

test "f0" {
    assert.equal(g.f0(false, "1", "9"), "9");
}

test "f1" {
    assert.equal(g.f1(true, 0), false);
}

test "f3" {
    assert.equal(g.f3(1, 7), .Ok(8));
    assert.equal(g.f3(7, -2), .Err("negative"));
}

test "f4" {
    assert.equal(g.f4(4, 5), .Ok(9));
}

test "f5" {
    assert.equal(g.f5(0, -2), .Err("negative"));
    assert.equal(g.f5(-1, 4), .Err("negative"));
    assert.equal(g.f5(4, 1), .Ok(5));
    assert.equal(g.f5(7, -3), .Err("negative"));
}
