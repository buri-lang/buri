from "core/testing/assert" import * as assert;
from "//lib/s10" import * as g;
from "//lib/t10" import * as t;

test "f0" {
    assert.equal(g.f0(true, "0", "5"), "0");
    assert.equal(g.f0(false, "5", "7"), "7");
    assert.equal(g.f0(false, true, false), false);
}

test "f1" {
    assert.equal(g.f1(1), 0);
    assert.equal(g.f1(12), 2);
    assert.equal(g.f1(6), 1);
}

test "f2" {
    assert.equal(g.f2(8, true), 99);
    assert.equal(g.f2(5, true), 99);
    assert.equal(g.f2(2, true), 99);
    assert.equal(g.f2(3, true), 99);
}

test "f3" {
    assert.equal(g.f3(2), 4);
}

test "f4" {
    assert.equal(g.f4(3, true), 99);
    assert.equal(g.f4(1, false), 99);
    assert.equal(g.f4(4, false), 99);
    assert.equal(g.f4(0, false), 10);
    assert.equal(g.f4(10, true), 99);
}

test "pick" {
    assert.equal(t.pick(true), 1);
    assert.equal(t.pick(false), 0);
    assert.equal(t.pick(false), 0);
}
