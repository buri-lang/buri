from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s05" import * as g;
from "//lib/s05" import { E, R };
from "//lib/t05" import * as t;

test "f0" {
    let p0 = R { f0: true, f1: true };
    let q0 = R { f0: true, f1: true };
    assert.equal(g.f0(false, p0, q0), false);
    let p1 = R { f0: true, f1: true };
    let q1 = R { f0: true, f1: true };
    assert.equal(g.f0(true, p1, q1), true);
}

test "f2" {
    assert.equal(g.f2(false, 3), false);
    assert.equal(g.f2(true, 0), false);
}

test "f3" {
    assert.equal(g.f3([0, 4]), 4);
    assert.equal(g.f3([2, 9]), 9);
}

test "f4" {
    assert.equal(g.f4(false, true, true), true);
    assert.equal(g.f4(true, false, false), false);
}

test "f5" {
    assert.equal(g.f5(false, true, false), false);
}

test "pick" {
    assert.equal(t.pick(false), 0);
    assert.equal(t.pick(true), 1);
    assert.equal(t.pick(true), 1);
    assert.equal(t.pick(false), 0);
}
