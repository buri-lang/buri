from "core/testing/assert" import * as assert;
from "//lib/s00" import * as g;

test "f0" {
    assert.equal(g.f0(true, true), true);
    assert.equal(g.f0(true, false), true);
    assert.equal(g.f0(true, false), true);
}

test "f1" {
    assert.equal(g.f1(false, true, false), false);
    assert.equal(g.f1(true, -6, 2), -6);
    assert.equal(g.f1(false, -4, -5), -5);
    assert.equal(g.f1(false, 4, -4), -4);
}

test "f2" {
    assert.equal(g.f2(1), 2);
}

test "f3" {
    assert.equal(g.f3(2151, 0), 430);
    assert.equal(g.f3(3309, 0), 662);
}

test "f4" {
    assert.equal(g.f4(true, 5, 4), false);
    assert.equal(g.f4(false, 5, 1), false);
    assert.equal(g.f4(true, 7, 3), false);
    assert.equal(g.f4(false, 12, 4), false);
    assert.equal(g.f4(true, 0, 3), false);
    assert.equal(g.f4(false, 13, 3), false);
}

test "f4 aborts 0" {
    assert.equal(g.f4(true, 4, 0), false);
}

test "f4 aborts 1" {
    assert.equal(g.f4(true, 4, 0), false);
}

test "f5" {
    assert.equal(g.f5(true, "8", "7"), "8");
    assert.equal(g.f5(true, true, false), true);
    assert.equal(g.f5(false, true, false), false);
    assert.equal(g.f5(true, -5, 5), -5);
    assert.equal(g.f5(false, true, false), false);
}

test "f6" {
    assert.equal(g.f6([]), 0);
    assert.equal(g.f6([6, 2, 1]), 9);
}

test "f7" {
    assert.equal(g.f7(25), 5);
    assert.equal(g.f7(7), 1);
    assert.equal(g.f7(2), 0);
    assert.equal(g.f7(25), 5);
    assert.equal(g.f7(10), 2);
    assert.equal(g.f7(4), 1);
}
