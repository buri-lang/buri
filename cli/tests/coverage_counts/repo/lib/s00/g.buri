from "core/bits" import * as bits;

export fn f0(a: Bool, b: Bool): Bool {
    a || b
}

export fn f1<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}

export fn f2(n: Int): Int {
    bits.shiftLeft(1, n)
}

export fn f3(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 5 == 2) { 1 } else { 0 };
        f3(n - 1, acc + step)
    }
}

export fn f4(a: Bool, n: Int, d: Int): Bool {
    a && n / d > 4
}

export fn f5<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}

export fn f6(items: [Int]): Int {
    items.fold(fn(acc, x) => if (x > 0) { acc + x } else { acc }, 0)
}

export fn f7(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 5 == 3) { 1 } else { 0 };
        here + f7(n - 1)
    }
}
