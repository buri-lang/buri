from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s09" import * as g;
from "//lib/s09" import { E, R };

test "f0" {
    assert.equal(g.f0(6), 64);
    assert.equal(g.f0(5), 32);
    assert.equal(g.f0(1), 2);
    assert.equal(g.f0(9), 512);
    assert.equal(g.f0(9), 512);
}

test "f1" {
    assert.equal(g.f1([3, 5, 4, 4]), 5);
}

test "f2" {
    assert.equal(g.f2(1, 3), .Ok(4));
}

test "f3" {
    let p0 = R { f0: -2, f1: 0, f2: -2 };
    let q0 = R { f0: 2, f1: 0, f2: -2 };
    assert.equal(g.f3(true, p0, q0), false);
    let p1 = R { f0: 2, f1: 1, f2: -1 };
    let q1 = R { f0: 2, f1: 1, f2: -1 };
    assert.equal(g.f3(false, p1, q1), false);
    let p2 = R { f0: 1, f1: 2, f2: 2 };
    let q2 = R { f0: 1, f1: 2, f2: 2 };
    assert.equal(g.f3(false, p2, q2), false);
}

test "f4" {
    assert.equal(g.f4(true, false, false), true);
    assert.equal(g.f4(false, false, true), false);
}

test "derived" {
    assert.equal(E.C(2, 2) == E.B(1), false);
    assert.equal(E.A == E.A, true);
    let a0 = R { f0: 0, f1: -2, f2: -2 };
    let b0 = R { f0: 0, f1: -2, f2: -2 };
    assert.equal(a0 == b0, true);
    let a1 = R { f0: -2, f1: 0, f2: -2 };
    let b1 = R { f0: -2, f1: 0, f2: 0 };
    assert.equal(a1 == b1, false);
    let a2 = R { f0: -2, f1: 0, f2: -2 };
    let b2 = R { f0: -2, f1: 0, f2: -2 };
    assert.equal(a2 == b2, true);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(E.B(1).show(ctx), ".B(1)");
    let r0 = R { f0: -2, f1: -1, f2: 1 };
    assert.equal(r0.show(ctx), "R { f0: -2, f1: -1, f2: 1 }");
}
