from "core/testing/assert" import * as assert;
from "//lib/s09" import * as g;

test "f0" {
    assert.equal(g.f0(9, false), 100);
    assert.equal(g.f0(2, false), 12);
    assert.equal(g.f0(0, true), 10);
    assert.equal(g.f0(8, true), 99);
    assert.equal(g.f0(3, true), 99);
}

test "f1" {
    assert.equal(g.f1([4, 8, 0, 2]), 14);
    assert.equal(g.f1([]), 0);
    assert.equal(g.f1([4]), 4);
    assert.equal(g.f1([2, 0]), 2);
}

test "f2" {
    assert.equal(g.f2(true, true, false), true);
    assert.equal(g.f2(false, true, false), false);
    assert.equal(g.f2(true, true, false), true);
    assert.equal(g.f2(true, true, false), true);
}

test "f4" {
    assert.equal(g.f4(3, -2), .Err("negative"));
    assert.equal(g.f4(-3, 3), .Err("negative"));
}

test "f5" {
    assert.equal(g.f5(4100, 0), 1367);
    assert.equal(g.f5(153, 0), 51);
    assert.equal(g.f5(1392, 0), 464);
    assert.equal(g.f5(307, 0), 102);
    assert.equal(g.f5(1864, 0), 621);
    assert.equal(g.f5(2997, 0), 999);
}

test "f6" {
    assert.equal(g.f6(8), 3);
    assert.equal(g.f6(3), 1);
}

test "f7" {
    assert.equal(g.f7(true, false, false), true);
    assert.equal(g.f7(false, false, true), false);
}
