from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s09" import * as g;
from "//lib/s09" import { E, R };

test "f0" {
    assert.equal(g.f0(false), 1);
    assert.equal(g.f0(true), 0);
    assert.equal(g.f0(true), 0);
    assert.equal(g.f0(false), 1);
    assert.equal(g.f0(true), 0);
}

test "f1" {
    let p0 = R { f0: 1 };
    let q0 = R { f0: 1 };
    assert.equal(g.f1(false, p0, q0), false);
    let p1 = R { f0: -2 };
    let q1 = R { f0: -2 };
    assert.equal(g.f1(true, p1, q1), true);
    let p2 = R { f0: 2 };
    let q2 = R { f0: -2 };
    assert.equal(g.f1(true, p2, q2), false);
    let p3 = R { f0: -2 };
    let q3 = R { f0: -2 };
    assert.equal(g.f1(true, p3, q3), true);
    let p4 = R { f0: -2 };
    let q4 = R { f0: -2 };
    assert.equal(g.f1(true, p4, q4), true);
}

test "f2" {
    assert.equal(g.f2(true, -6, -9), -6);
    assert.equal(g.f2(true, -1, -7), -1);
}

test "f3" {
    assert.equal(g.f3(6), 64);
    assert.equal(g.f3(5), 32);
    assert.equal(g.f3(5), 32);
    assert.equal(g.f3(6), 64);
}

test "f3 aborts 0" {
    assert.equal(g.f3(-3), 0);
}

test "f3 aborts 1" {
    assert.equal(g.f3(-3), 0);
}

test "f5" {
    assert.equal(g.f5(false, true, false), false);
    assert.equal(g.f5(true, 4, -2), 4);
    assert.equal(g.f5(false, "7", "9"), "9");
    assert.equal(g.f5(false, -8, 0), 0);
}

test "f6" {
    assert.equal(g.f6(5), 32);
}

test "derived" {
    assert.equal(E.C(0, 1) == E.C(0, 1), true);
    assert.equal(E.C(0, 0) == E.A, false);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(E.A.show(ctx), ".A");
    assert.equal(E.B(1).show(ctx), ".B(1)");
    let r0 = R { f0: 0 };
    assert.equal(r0.show(ctx), "R { f0: 0 }");
}
