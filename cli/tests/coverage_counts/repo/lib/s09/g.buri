from "core/bits" import * as bits;

derive Equal, Ordered, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal, Show for R;
export struct R {
    export f0: Int,
    export f1: Int,
    export f2: Int,
}

export fn f0(n: Int): Int {
    bits.shiftLeft(1, n)
}

export fn f1(items: [Int]): Int {
    items.fold(fn(acc, x) => if (x > 4) { acc + x } else { acc }, 0)
}

fn f2check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f2(a: Int, b: Int): Result<Int, Str> {
    let x = f2check(a)?;
    let y = f2check(b)?;
    .Ok(x + y)
}

export fn f3(a: Bool, p: R, q: R): Bool {
    a && p == q
}

export fn f4(a: Bool, b: Bool, c: Bool): Bool {
    a || b && c
}
