from "core/testing/assert" import * as assert;
from "//lib/s04" import * as g;
from "//lib/t04" import * as t;

test "f0" {
    assert.equal(g.f0(false, "3", "3"), "3");
}

test "f1" {
    assert.equal(g.f1(false, 5), false);
    assert.equal(g.f1(false, 7), false);
    assert.equal(g.f1(false, 6), false);
}

test "f3" {
    assert.equal(g.f3(4, 8), .Ok(12));
    assert.equal(g.f3(1, 4), .Ok(5));
}

test "f4" {
    assert.equal(g.f4(-1, 0), .Err("negative"));
    assert.equal(g.f4(-3, -1), .Err("negative"));
}

test "f5" {
    assert.equal(g.f5(1, 1), .Ok(2));
}

test "pick" {
    assert.equal(t.pick(true), 1);
    assert.equal(t.pick(false), 0);
    assert.equal(t.pick(false), 0);
    assert.equal(t.pick(false), 0);
    assert.equal(t.pick(false), 0);
}
