from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s03" import * as g;
from "//lib/s03" import { E, R };

test "f0" {
    assert.equal(g.f0(6, true), 99);
    assert.equal(g.f0(-1, false), 99);
    assert.equal(g.f0(3, false), 99);
}

test "f1" {
    let p0 = R { f0: .A, f1: false, f2: -2 };
    let q0 = R { f0: .A, f1: false, f2: -2 };
    assert.equal(g.f1(false, p0, q0), false);
    let p1 = R { f0: .A, f1: true, f2: -2 };
    let q1 = R { f0: .A, f1: true, f2: -2 };
    assert.equal(g.f1(true, p1, q1), true);
    let p2 = R { f0: .B(2), f1: true, f2: 0 };
    let q2 = R { f0: .C(2, 1), f1: true, f2: 0 };
    assert.equal(g.f1(false, p2, q2), false);
}

test "f2" {
    assert.equal(g.f2(false, "8", "0"), "0");
}

test "f3" {
    assert.equal(g.f3(true, 4), true);
    assert.equal(g.f3(false, 0), false);
    assert.equal(g.f3(true, 6), true);
    assert.equal(g.f3(true, 4), true);
    assert.equal(g.f3(false, 12), false);
}

test "f4" {
    assert.equal(g.f4(2, 2), 1);
    assert.equal(g.f4(11, 5), 2);
}

test "derived" {
    assert.equal(E.C(2, 1) == E.C(2, 1), true);
    assert.equal(E.C(0, 2) == E.C(0, 2), true);
    assert.equal(E.B(1) == E.B(1), true);
    let a0 = R { f0: .A, f1: true, f2: -1 };
    let b0 = R { f0: .A, f1: true, f2: -1 };
    assert.equal(a0 == b0, true);
    let a1 = R { f0: .A, f1: false, f2: -2 };
    let b1 = R { f0: .A, f1: false, f2: -2 };
    assert.equal(a1 == b1, true);
    let a2 = R { f0: .A, f1: true, f2: 1 };
    let b2 = R { f0: .A, f1: true, f2: 0 };
    assert.equal(a2 == b2, false);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(E.A.show(ctx), ".A");
    assert.equal(E.A.show(ctx), ".A");
}
