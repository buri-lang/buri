from "core/testing/assert" import * as assert;
from "//lib/s03" import * as g;

test "f0" {
    assert.equal(g.f0(2, 4), .Ok(6));
    assert.equal(g.f0(-2, 3), .Err("negative"));
    assert.equal(g.f0(8, -3), .Err("negative"));
    assert.equal(g.f0(-3, 2), .Err("negative"));
}

test "f1" {
    assert.equal(g.f1(4, false), 99);
    assert.equal(g.f1(5, true), 99);
    assert.equal(g.f1(1, true), 11);
    assert.equal(g.f1(4, false), 99);
    assert.equal(g.f1(3, false), 99);
}

test "f2" {
    assert.equal(g.f2(true, false), false);
    assert.equal(g.f2(false, true), false);
    assert.equal(g.f2(false, true), false);
    assert.equal(g.f2(true, false), false);
    assert.equal(g.f2(false, false), true);
    assert.equal(g.f2(true, false), false);
}

test "f3" {
    assert.equal(g.f3(15, 4), 3);
    assert.equal(g.f3(21, 3), 7);
    assert.equal(g.f3(26, 4), 6);
    assert.equal(g.f3(27, 4), 6);
    assert.equal(g.f3(9, 1), 9);
}

test "f4" {
    assert.equal(g.f4(-1, 7), .Err("negative"));
    assert.equal(g.f4(3, 3), .Ok(6));
    assert.equal(g.f4(4, 2), .Ok(6));
}

test "f5" {
    assert.equal(g.f5(true, false), true);
}
