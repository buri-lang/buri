fn f0check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f0(a: Int, b: Int): Result<Int, Str> {
    let x = f0check(a)?;
    let y = f0check(b)?;
    .Ok(x + y)
}

export fn f1(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        1 => 11,
        _ => 99,
    }
}

export fn f2(a: Bool, b: Bool): Bool {
    !a && !b
}

export fn f3<T: Divide>(a: T, b: T): T {
    a / b
}

fn f4check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f4(a: Int, b: Int): Result<Int, Str> {
    let x = f4check(a)?;
    let y = f4check(b)?;
    .Ok(x + y)
}

export fn f5(a: Bool, b: Bool): Bool {
    !a || !b
}
