derive Equal, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal for R;
export struct R {
    export f0: E,
    export f1: Bool,
    export f2: Int,
}

export fn f0(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        1 => 11,
        2 => 12,
        k if k > 3 && !flag => 100,
        _ => 99,
    }
}

export fn f1(a: Bool, p: R, q: R): Bool {
    a && p == q
}

export fn f2<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}

export fn f3(a: Bool, n: Int): Bool {
    a && f3big(n)
}

fn f3big(n: Int): Bool {
    n > 0
}

export fn f4(a: Int, b: Int): Int {
    a / b
}
