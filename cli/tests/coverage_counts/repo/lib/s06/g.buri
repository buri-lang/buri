derive Equal, Ordered, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal for R;
export struct R {
    export f0: Int,
    export f1: Bool,
    export f2: Int,
}

export fn f0(a: Bool, b: Bool, c: Bool): Int {
    if (!a || !(b && !c)) { 1 } else { 0 }
}

export fn f1(a: Bool, n: Int, d: Int): Bool {
    a && n / d > 3
}

export fn f2(a: Bool, p: R, q: R): Bool {
    a && p == q
}

export fn f3(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 4 == 0) { 1 } else { 0 };
        f3(n - 1, acc + step)
    }
}

export fn f4(a: Bool, n: Int, d: Int): Bool {
    a && n / d > 0
}

export fn f5(a: Bool, n: Int, d: Int): Bool {
    a && n / d > 2
}

export fn f6(items: [Int]): Int {
    items.fold(fn(acc, x) => if (x > 1) { acc + x } else { acc }, 0)
}

export fn f7(items: [Int]): Int {
    items.fold(fn(acc, x) => if (x > 5) { acc + x } else { acc }, 0)
}
