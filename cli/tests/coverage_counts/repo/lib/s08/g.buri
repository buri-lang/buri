fn f0check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f0(a: Int, b: Int): Result<Int, Str> {
    let x = f0check(a)?;
    let y = f0check(b)?;
    .Ok(x + y)
}

export fn f1(a: Int, b: Int): Int {
    a / b
}

export fn f2(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        1 => 11,
        2 => 12,
        _ => 99,
    }
}

fn f3check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f3(a: Int, b: Int): Result<Int, Str> {
    let x = f3check(a)?;
    let y = f3check(b)?;
    .Ok(x + y)
}

export fn f4(a: Bool, b: Bool, c: Bool, d: Bool): Int {
    if (!a || !(b && !c) && d) {
        let r = 1;
        r
    } else {
        let r = 0;
        r
    }
}
