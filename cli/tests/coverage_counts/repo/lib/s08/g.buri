from "core/bits" import * as bits;

fn f0check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f0(a: Int, b: Int): Result<Int, Str> {
    let x = f0check(a)?;
    let y = f0check(b)?;
    .Ok(x + y)
}

export fn f1(a: Int, b: Int): Int {
    a / b
}

fn f2check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f2(a: Int, b: Int): Result<Int, Str> {
    let x = f2check(a)?;
    let y = f2check(b)?;
    .Ok(x + y)
}

export fn f3(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 4 == 3) { 1 } else { 0 };
        f3(n - 1, acc + step)
    }
}

export fn f4(n: Int): Int {
    bits.shiftLeft(1, n)
}
