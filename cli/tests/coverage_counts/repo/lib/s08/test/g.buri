from "core/testing/assert" import * as assert;
from "//lib/s08" import * as g;

test "f0" {
    assert.equal(g.f0(-2, 2), .Err("negative"));
    assert.equal(g.f0(5, -1), .Err("negative"));
}

test "f1" {
    assert.equal(g.f1(15, 2), 7);
    assert.equal(g.f1(13, 1), 13);
    assert.equal(g.f1(17, 4), 4);
    assert.equal(g.f1(20, 2), 10);
    assert.equal(g.f1(1, 1), 1);
}

test "f1 aborts 0" {
    assert.equal(g.f1(1, 0), 0);
}

test "f3" {
    assert.equal(g.f3(6, 4), .Ok(10));
    assert.equal(g.f3(1, 5), .Ok(6));
    assert.equal(g.f3(6, -2), .Err("negative"));
    assert.equal(g.f3(9, 6), .Ok(15));
    assert.equal(g.f3(-3, 5), .Err("negative"));
}

test "f4" {
    assert.equal(g.f4(false, false, true, false), 1);
}
