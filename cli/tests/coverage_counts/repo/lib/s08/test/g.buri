from "core/testing/assert" import * as assert;
from "//lib/s08" import * as g;

test "f0" {
    assert.equal(g.f0(-2, 2), .Err("negative"));
}

test "f1" {
    assert.equal(g.f1(9, 1), 9);
    assert.equal(g.f1(6, 3), 2);
    assert.equal(g.f1(15, 4), 3);
    assert.equal(g.f1(15, 1), 15);
}

test "f1 aborts 1" {
    assert.equal(g.f1(1, 0), 0);
}

test "f3" {
    assert.equal(g.f3(1405, 0), 351);
    assert.equal(g.f3(2239, 0), 560);
    assert.equal(g.f3(1569, 0), 392);
}

test "f4 aborts 0" {
    assert.equal(g.f4(-3), 0);
}
