from "core/testing/assert" import * as assert;
from "//lib/s08" import * as g;
from "//lib/s08" import { E, R };

test "f0" {
    assert.equal(g.f0(5), 32);
    assert.equal(g.f0(0), 1);
    assert.equal(g.f0(4), 16);
    assert.equal(g.f0(4), 16);
    assert.equal(g.f0(4), 16);
}

test "f0 aborts 0" {
    assert.equal(g.f0(-1), 0);
}

test "f0 aborts 1" {
    assert.equal(g.f0(-1), 0);
}

test "f1" {
    assert.equal(g.f1(true, false, true, false), 1);
    assert.equal(g.f1(true, true, false, false), 1);
}

test "f2" {
    assert.equal(g.f2(1, false), 11);
    assert.equal(g.f2(3, true), 99);
    assert.equal(g.f2(6, true), 99);
    assert.equal(g.f2(1, true), 11);
    assert.equal(g.f2(4, true), 99);
    assert.equal(g.f2(3, true), 99);
}

test "f3" {
    let p0 = R { f0: -2, f1: .A };
    let q0 = R { f0: -2, f1: .A };
    assert.equal(g.f3(true, p0, q0), true);
    let p1 = R { f0: 2, f1: .B(1) };
    let q1 = R { f0: -2, f1: .B(1) };
    assert.equal(g.f3(true, p1, q1), false);
    let p2 = R { f0: -1, f1: .C(0, 0) };
    let q2 = R { f0: -1, f1: .A };
    assert.equal(g.f3(true, p2, q2), false);
    let p3 = R { f0: 1, f1: .B(0) };
    let q3 = R { f0: -1, f1: .B(0) };
    assert.equal(g.f3(false, p3, q3), false);
    let p4 = R { f0: 0, f1: .A };
    let q4 = R { f0: 0, f1: .A };
    assert.equal(g.f3(true, p4, q4), true);
    let p5 = R { f0: -1, f1: .A };
    let q5 = R { f0: 1, f1: .A };
    assert.equal(g.f3(false, p5, q5), false);
}

test "f4" {
    assert.equal(g.f4(24, 3), 8);
    assert.equal(g.f4(2, 4), 0);
    assert.equal(g.f4(10, 3), 3);
    assert.equal(g.f4(23, 1), 23);
}

test "f4 aborts 0" {
    assert.equal(g.f4(4, 0), 0);
}

test "derived" {
    assert.equal(E.B(0) == E.B(1), false);
}
