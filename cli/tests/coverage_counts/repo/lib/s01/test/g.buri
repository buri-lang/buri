from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s01" import * as g;
from "//lib/s01" import { E, R };

test "f0" {
    assert.equal(g.f0(2), 4);
    assert.equal(g.f0(2), 4);
}

test "f0 aborts 0" {
    assert.equal(g.f0(-3), 0);
}

test "f1" {
    assert.equal(g.f1(1, false), 99);
}

test "f2" {
    assert.equal(g.f2(6), 2);
    assert.equal(g.f2(7), 2);
}

test "f3" {
    assert.equal(g.f3(0), 0);
    assert.equal(g.f3(23), 7);
    assert.equal(g.f3(21), 7);
}

test "f4" {
    assert.equal(g.f4(18), 6);
    assert.equal(g.f4(30), 10);
}

test "f5" {
    let p0 = R { f0: -2 };
    let q0 = R { f0: 1 };
    assert.equal(g.f5(false, p0, q0), false);
}
