export fn f0(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        1 => 11,
        _ => 99,
    }
}

export fn f1(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        1 if flag => 11,
        2 => 12,
        k if k > 6 && !flag => 100,
        _ => 99,
    }
}

export fn f2(a: Bool, b: Bool, c: Bool): Int {
    if (!a && (b && c)) { 1 } else { 0 }
}

export fn f3(a: Bool, n: Int): Bool {
    a && f3big(n)
}

fn f3big(n: Int): Bool {
    n > 4
}

fn f4check(n: Int): Result<Int, Str> {
    if (n < 0) { .Err("negative") } else { .Ok(n) }
}

export fn f4(a: Int, b: Int): Result<Int, Str> {
    let x = f4check(a)?;
    let y = f4check(b)?;
    .Ok(x + y)
}

export fn f5(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 2 == 0) { 1 } else { 0 };
        f5(n - 1, acc + step)
    }
}

export fn f6<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}
