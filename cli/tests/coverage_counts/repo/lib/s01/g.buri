from "core/bits" import * as bits;

derive Equal, Ordered, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal, Ordered, Show for R;
export struct R {
    export f0: Int,
}

export fn f0(n: Int): Int {
    bits.shiftLeft(1, n)
}

export fn f1(n: Int, flag: Bool): Int {
    match (n) {
        0 if flag => 10,
        _ => 99,
    }
}

export fn f2(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 4 == 2) { 1 } else { 0 };
        here + f2(n - 1)
    }
}

export fn f3(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 3 == 0) { 1 } else { 0 };
        here + f3(n - 1)
    }
}

export fn f4(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 3 == 0) { 1 } else { 0 };
        here + f4(n - 1)
    }
}

export fn f5(a: Bool, p: R, q: R): Bool {
    a && p == q
}
