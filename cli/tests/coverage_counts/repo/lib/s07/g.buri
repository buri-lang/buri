derive Equal, Ordered, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal for R;
export struct R {
    export f0: Int,
    export f1: E,
}

export fn f0<T>(flag: Bool, x: T, y: T): T {
    if (flag) {
        let r = x;
        r
    } else {
        let r = y;
        r
    }
}

export fn f1(a: Bool, n: Int): Bool {
    a && f1big(n)
}

fn f1big(n: Int): Bool {
    n > 8
}

export fn f2(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 5 == 4) { 1 } else { 0 };
        here + f2(n - 1)
    }
}

export fn f3(a: Bool, b: Bool, c: Bool): Bool {
    a || !(b && c)
}

export fn f4(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 5 == 2) { 1 } else { 0 };
        f4(n - 1, acc + step)
    }
}

export fn f5(a: Bool, p: R, q: R): Bool {
    a && p == q
}

export fn f6(a: Bool, n: Int, d: Int): Bool {
    a && n / d > 4
}
