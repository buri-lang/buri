from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s07" import * as g;
from "//lib/s07" import { E, R };

test "f1" {
    assert.equal(g.f1(true, 10), true);
    assert.equal(g.f1(true, 7), false);
    assert.equal(g.f1(true, 1), false);
    assert.equal(g.f1(false, 0), false);
}

test "f2" {
    assert.equal(g.f2(25), 5);
    assert.equal(g.f2(25), 5);
    assert.equal(g.f2(15), 3);
    assert.equal(g.f2(11), 2);
    assert.equal(g.f2(15), 3);
}

test "f3" {
    assert.equal(g.f3(false, true, false), true);
}

test "f4" {
    assert.equal(g.f4(1626, 0), 325);
    assert.equal(g.f4(3643, 0), 729);
}

test "f5" {
    let p0 = R { f0: 1, f1: .A };
    let q0 = R { f0: 1, f1: .C(2, 1) };
    assert.equal(g.f5(false, p0, q0), false);
    let p1 = R { f0: 0, f1: .B(0) };
    let q1 = R { f0: 0, f1: .C(2, 2) };
    assert.equal(g.f5(true, p1, q1), false);
    let p2 = R { f0: -2, f1: .B(0) };
    let q2 = R { f0: -2, f1: .B(0) };
    assert.equal(g.f5(true, p2, q2), true);
    let p3 = R { f0: -1, f1: .A };
    let q3 = R { f0: -1, f1: .A };
    assert.equal(g.f5(true, p3, q3), true);
}

test "f6" {
    assert.equal(g.f6(false, 19, 4), false);
    assert.equal(g.f6(true, 10, 2), true);
    assert.equal(g.f6(false, 20, 4), false);
    assert.equal(g.f6(false, 1, 3), false);
}

test "derived" {
    assert.equal(E.B(1) == E.A, false);
    assert.equal(E.B(2) < E.B(2), false);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(E.B(0).show(ctx), ".B(0)");
    assert.equal(E.C(2, 2).show(ctx), ".C(2, 2)");
}
