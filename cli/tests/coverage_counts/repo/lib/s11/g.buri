derive Equal, Ordered, Show for E;
export enum E {
    A,
    B(Int),
    C(Int, Int),
}

derive Equal, Ordered for R;
export struct R {
    export f0: Int,
    export f1: Int,
    export f2: Int,
}

export fn f0(items: [Int]): Int {
    items.fold(fn(acc, x) => if (x > 0) { acc + x } else { acc }, 0)
}

export fn f1(a: Bool, n: Int): Bool {
    a && f1big(n)
}

fn f1big(n: Int): Bool {
    n > 8
}

export fn f2(a: Bool, p: R, q: R): Bool {
    a && p == q
}

export fn f3(n: Int, flag: Bool): Int {
    match (n) {
        0 => 10,
        _ => 99,
    }
}

export fn f4(n: Int, acc: Int): Int {
    if (n == 0) {
        acc
    } else {
        let step = if (n % 5 == 4) { 1 } else { 0 };
        f4(n - 1, acc + step)
    }
}

export fn f5(n: Int): Int {
    if (n == 0) {
        0
    } else {
        let here = if (n % 5 == 3) { 1 } else { 0 };
        here + f5(n - 1)
    }
}
