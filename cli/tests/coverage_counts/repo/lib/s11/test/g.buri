from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/s11" import * as g;
from "//lib/s11" import { E, R };

test "f0" {
    assert.equal(g.f0([]), 0);
}

test "f1" {
    assert.equal(g.f1(true, 12), true);
    assert.equal(g.f1(true, 0), false);
    assert.equal(g.f1(false, 11), false);
    assert.equal(g.f1(true, 10), true);
    assert.equal(g.f1(true, 0), false);
    assert.equal(g.f1(false, 2), false);
}

test "f2" {
    let p0 = R { f0: 2, f1: -2, f2: 1 };
    let q0 = R { f0: 2, f1: -2, f2: 1 };
    assert.equal(g.f2(true, p0, q0), true);
    let p1 = R { f0: -1, f1: -1, f2: -2 };
    let q1 = R { f0: -1, f1: -1, f2: 0 };
    assert.equal(g.f2(true, p1, q1), false);
    let p2 = R { f0: -1, f1: 2, f2: 0 };
    let q2 = R { f0: -1, f1: 2, f2: 0 };
    assert.equal(g.f2(true, p2, q2), true);
    let p3 = R { f0: 1, f1: 0, f2: 2 };
    let q3 = R { f0: 1, f1: 0, f2: 1 };
    assert.equal(g.f2(false, p3, q3), false);
}

test "f3" {
    assert.equal(g.f3(4, false), 99);
    assert.equal(g.f3(2, true), 99);
    assert.equal(g.f3(3, true), 99);
    assert.equal(g.f3(0, true), 10);
}

test "f4" {
    assert.equal(g.f4(2895, 0), 579);
    assert.equal(g.f4(917, 0), 183);
    assert.equal(g.f4(1977, 0), 395);
    assert.equal(g.f4(3519, 0), 704);
    assert.equal(g.f4(1431, 0), 286);
}

test "f5" {
    assert.equal(g.f5(21), 4);
    assert.equal(g.f5(22), 4);
    assert.equal(g.f5(5), 1);
}

test "derived" {
    assert.equal(E.A == E.A, true);
    let a0 = R { f0: -2, f1: 0, f2: 0 };
    let b0 = R { f0: -2, f1: 0, f2: 1 };
    assert.equal(a0 == b0, false);
    let a1 = R { f0: 0, f1: 2, f2: 1 };
    let b1 = R { f0: 0, f1: 2, f2: 1 };
    assert.equal(a1 == b1, true);
    let a2 = R { f0: 2, f1: -1, f2: 2 };
    let b2 = R { f0: 2, f1: 1, f2: 2 };
    assert.equal(a2 == b2, false);
    assert.equal(E.C(2, 2) < E.B(1), false);
    let c0 = R { f0: -2, f1: 2, f2: -1 };
    let d0 = R { f0: -2, f1: 2, f2: -1 };
    assert.equal(c0 < d0, false);
    let c1 = R { f0: 0, f1: 2, f2: 2 };
    let d1 = R { f0: 0, f1: 2, f2: -2 };
    assert.equal(c1 < d1, false);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(E.C(1, 2).show(ctx), ".C(1, 2)");
}
