from "core/testing/assert" import * as assert;
from "//lib/s11" import * as g;

test "f0" {
    assert.equal(g.f0(2772, 0), 693);
}

test "f1" {
    assert.equal(g.f1(9, 5), .Ok(14));
    assert.equal(g.f1(1, 3), .Ok(4));
    assert.equal(g.f1(5, 8), .Ok(13));
    assert.equal(g.f1(5, 1), .Ok(6));
    assert.equal(g.f1(-3, -3), .Err("negative"));
}

test "f2" {
    assert.equal(g.f2([5, 8, 8, 8]), 29);
    assert.equal(g.f2([7, 2]), 7);
    assert.equal(g.f2([]), 0);
    assert.equal(g.f2([]), 0);
    assert.equal(g.f2([0, 7, 0]), 7);
    assert.equal(g.f2([3]), 3);
}

test "f3" {
    assert.equal(g.f3(4540, 0), 1135);
    assert.equal(g.f3(4062, 0), 1015);
    assert.equal(g.f3(3580, 0), 895);
}

test "f4" {
    assert.equal(g.f4(5), 32);
}

test "f4 aborts 0" {
    assert.equal(g.f4(-1), 0);
}

test "f4 aborts 1" {
    assert.equal(g.f4(-2), 0);
}

test "f5" {
    assert.equal(g.f5(true, 7), true);
}

test "f6" {
    assert.equal(g.f6(0, 8), .Ok(8));
    assert.equal(g.f6(-1, 0), .Err("negative"));
    assert.equal(g.f6(7, 8), .Ok(15));
    assert.equal(g.f6(2, 8), .Ok(10));
    assert.equal(g.f6(1, 9), .Ok(10));
    assert.equal(g.f6(8, -3), .Err("negative"));
}
