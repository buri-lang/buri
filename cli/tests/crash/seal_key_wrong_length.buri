// CRASH: a sealing key is 32 bytes
// `seal` answers a `[U8]` rather than a `Result`, so a key of the wrong size
// stops the program instead of sealing under something weaker.
from "core/crypto" import * as crypto;
from "core/env" import * as env;
from "core/io" import * as io;
from "core/secret" import * as secret;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Entropy, Environment, Stdout };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Environment: host.env,
        Entropy: host.entropy,
    };
    // Opaque to the compiler, so the call is really made.
    let key = crypto.randomBytes(ctx, 16 + env.arguments(ctx).length());
    let _ = io
        .println(ctx, "${crypto.seal(ctx, secret.of(key), [], []).length()}")
        .ignore();
    .Ok(())
}
