// CRASH: division by zero
// `%` at a narrow width, which is a different code path from `Int`.
from "core/cap" import { Alloc, Stdout, Env };
from "core/host" import * as host;
from "core/env" import * as env;

fn leftover(a: I8, b: I8): I8 { a % b }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout, Env: host.env };
  let zero: I8 = env.args(ctx).len().toI8() ?? 0;
  let _ = ctx.println("${leftover(7, zero)}");
  .Ok(())
}
