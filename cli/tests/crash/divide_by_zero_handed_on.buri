// CRASH: division by zero
//
// The division is in a function that only hands its context on, called at two
// different contexts. The first call answers; the second divides by zero and
// aborts with the same message a non-generic function would.
from "platform/effect" import { Allocator, Region, Stdout, Environment };
from "core/env" import * as env;
from "node" import { NodeHost };
from "core/io" import * as io;

struct Quiet<C> {
  inner: C,
}

impl<C: Allocator> Allocator for Quiet<C> {
  fn allocate(self, bytes: Int): Region {
    self.inner.allocate(bytes)
  }
}

fn ratio<C: Allocator>(ctx: C, a: Int, b: Int): Int {
  [a].push(ctx, b).length() * (a / b)
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  let zero = env.arguments(ctx).length();
  let _ = io.println(ctx, "${ratio(ctx, 10, zero + 5)}").ignore();
  let _ = io.println(ctx, "${ratio(Quiet { inner: host.alloc }, 10, zero)}").ignore();
  .Ok(())
}
