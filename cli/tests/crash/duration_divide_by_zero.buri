// CRASH: division by zero
//
// `Duration.divide` is `/` over the nanoseconds, and `/` by zero aborts (SPEC
// 6.2). The doc comment says so; this is the sentence being true.
from "platform/effect" import { Allocator, Environment, Stdout };
from "core/env" import * as env;
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/time" import * as time;

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  // The program's own argument count, so nothing here folds to a constant.
  let zero = env.arguments(ctx).length();
  let split = time.seconds(10).divide(zero);
  let _ = io.println(ctx, "${split.milliseconds()}").ignore();
  .Ok(())
}
