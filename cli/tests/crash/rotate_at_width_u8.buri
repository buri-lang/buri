// CRASH: shift out of range
// A rotate by the whole width is the identity on paper, and `core/bits` refuses
// it anyway: the count is held to the same range the shifts are, so a byte
// rotate takes 0 to 7 and nothing else (`bits.buri`).
from "core/bits" import * as bits;
from "core/effect" import { Alloc, Stdout, Env };
from "core/env" import * as env;
from "core/host" import * as host;
from "core/io" import * as io;

fn spin(x: U8, n: Int): U8 { bits.rotateLeftU8(x, n) }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout, Env: host.env };
  let width = 8 + env.args(ctx).len();
  let _ = io.println(ctx, "${spin(1, width)}").ignore();
  .Ok(())
}
