// CRASH: shift out of range
from "core/bits" import * as bits;
from "platform/effect" import { Allocator, Stdout, Environment };
from "core/env" import * as env;
from "node" import { NodeHost };
from "core/io" import * as io;

fn push(x: Int, n: Int): Int { bits.shiftLeft(x, n) }

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  let width = 64 + env.arguments(ctx).length();
  let _ = io.println(ctx, "${push(1, width)}").ignore();
  .Ok(())
}
