// CRASH: shift out of range
// The `U32` shifts are a distinct runtime path from the `Int` ones, so the
// guard is asserted on each width separately.
from "core/effect" import { Alloc, Stdout, Env };
from "core/bits" import * as bits;
from "core/host" import * as host;
from "core/env" import * as env;

fn push(x: U32, n: Int): U32 { bits.shlU32(x, n) }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout, Env: host.env };
  let width = 32 + env.args(ctx).len();
  let _ = ctx.println("${push(1, width)}");
  .Ok(())
}
