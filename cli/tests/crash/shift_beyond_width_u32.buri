// CRASH: shift out of range
// The `U32` shifts are a distinct runtime path from the `Int` ones, so the
// guard is asserted on each width separately.
from "core/bits" import * as bits;
from "core/effect" import { Allocator, Stdout, Environment };
from "core/env" import * as env;
from "core/host" import * as host;
from "core/io" import * as io;

fn push(x: U32, n: Int): U32 { bits.shiftLeftU32(x, n) }

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  let width = 32 + env.arguments(ctx).length();
  let _ = io.println(ctx, "${push(1, width)}").ignore();
  .Ok(())
}
