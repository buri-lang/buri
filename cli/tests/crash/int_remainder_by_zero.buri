// CRASH: division by zero
from "core/effect/lib.buri" import { Alloc, Stdout, Env };
from "core/host/lib.buri" import * as host;
from "core/env/lib.buri" import * as env;

fn leftover(a: Int, b: Int): Int { a % b }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout, Env: host.env };
  let zero = env.args(ctx).len();
  let _ = ctx.println("${leftover(10, zero)}");
  .Ok(())
}
