// CRASH: division by zero
//
// `number.remainderEuclidean` is written in terms of `%`, and `%` by zero aborts with the
// same message `/` does (`int_remainder_by_zero.buri`): there is no remainder
// to give either.
from "platform/effect" import { Allocator, Stdout, Environment };
from "core/env" import * as env;
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/number" import * as number;

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  let zero = env.arguments(ctx).length();
  let _ = io.println(ctx, "${number.remainderEuclidean(-7, zero)}").ignore();
  .Ok(())
}
