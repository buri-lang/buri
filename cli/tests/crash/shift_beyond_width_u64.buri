// CRASH: shift out of range
// 64 bits is where a double stops being exact, so this path goes through a
// BigInt — and the guard has to survive that.
from "core/bits" import * as bits;
from "core/effect" import { Allocator, Stdout, Environment };
from "core/env" import * as env;
from "core/host" import * as host;
from "core/io" import * as io;

fn push(x: U64, n: Int): U64 { bits.shiftRightU64(x, n) }

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  let width = 64 + env.arguments(ctx).length();
  let _ = io.println(ctx, "${push(1, width)}").ignore();
  .Ok(())
}
