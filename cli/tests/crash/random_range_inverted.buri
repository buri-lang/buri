// CRASH: random range is empty
// `hi < lo` is the same emptiness as `hi == lo`, and is worth its own case
// because a subtraction of the two would silently produce a negative span.
from "core/effect" import { Alloc, Stdout, Env, Rand };
from "core/env" import * as env;
from "core/host" import * as host;
from "core/io" import * as io;
from "core/random" import * as random;

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Env: host.env,
    Rand: host.rand,
  };
  let n = env.args(ctx).len();
  let _ = io.println(ctx, "${random.int(ctx, n + 10, n)}").ignore();
  .Ok(())
}
