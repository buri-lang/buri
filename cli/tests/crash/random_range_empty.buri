// CRASH: random range is empty
// `nextInt` has no value to return when the range holds none, and there is no
// `Option` in its signature to say so.
from "core/effect" import { Allocator, Stdout, Environment, Random };
from "core/env" import * as env;
from "core/host" import * as host;
from "core/io" import * as io;
from "core/random" import * as random;

export fn main(): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    Environment: host.env,
    Random: host.rand,
  };
  // Opaque to the compiler, so the call is really made.
  let hi = env.arguments(ctx).length();
  let _ = io.println(ctx, "${random.int(ctx, hi, hi)}").ignore();
  .Ok(())
}
