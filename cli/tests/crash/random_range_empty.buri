// CRASH: random range is empty
// `nextInt` has no value to return when the range holds none, and there is no
// `Option` in its signature to say so.
from "core/effect/lib.buri" import { Alloc, Stdout, Env, Rand };
from "core/host/lib.buri" import * as host;
from "core/env/lib.buri" import * as env;
from "core/random/lib.buri" import * as random;

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Env: host.env,
    Rand: host.rand,
  };
  // Opaque to the compiler, so the call is really made.
  let hi = env.args(ctx).len();
  let _ = ctx.println("${random.int(ctx, hi, hi)}");
  .Ok(())
}
