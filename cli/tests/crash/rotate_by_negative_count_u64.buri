// CRASH: shift out of range
// A rotate the other way is `rotateRightU64`, not a negative `rotateLeftU64`:
// the count is a distance and the guard refuses one below zero.
from "core/bits" import * as bits;
from "platform/effect" import { Allocator, Stdout, Environment };
from "core/env" import * as env;
from "node" import { NodeHost };
from "core/io" import * as io;

fn spin(x: U64, n: Int): U64 { bits.rotateRightU64(x, n) }

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, Environment: host.env };
  let count = 0 - env.arguments(ctx).length() - 1;
  let one: U64 = 1;
  let _ = io.println(ctx, "${spin(one, count)}").ignore();
  .Ok(())
}
