// A mixed enum: nullary, tuple-like and record-like variants in one type.
// The nullary variant is what pays for the others — it carries no payload but
// is represented like the ones that do.
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

enum Shape { Empty, Circle(F64), Rect { width: F64, height: F64 }, Square(F64) }

fn area(s: Shape): F64 {
  match (s) {
    .Empty => 0.0,
    .Circle(r) => 3.0 * r * r,
    .Rect { width, height } => width * height,
    .Square(side) => side * side,
  }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("${area(Shape.Empty)}");
  let _ = ctx.println("${area(Shape.Circle(2.0))}");
  let _ = ctx.println("${area(Shape.Rect { width: 3.0, height: 4.0 })}");
  let _ = ctx.println("${area(Shape.Square(5.0))}");
  .Ok(())
}
