// A `Template` is an array of parts handed to the runtime's formatter. Where
// every hole renders on its own, the array and the call are both avoidable.
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/str" import * as str;

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let name = "world";
  let n = 42;
  let x = 1.5;

  let _ = ctx.println("hello ${name}");
  let _ = ctx.println("${n} and ${x} and ${name}");
  let _ = ctx.println("no holes at all");
  let joined = str.format(ctx, "n=${n}");
  let _ = ctx.println("${joined}${joined}");
  .Ok(())
}
