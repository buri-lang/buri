# A package with both a library and a binary: the rendering is reusable and
# testable, the CLI around it is one file of argument handling.
#
# Rules for this shape:
#   - the sources sets are disjoint, and every .buri file in the package is in
#     exactly one of them;
#   - the binary implicitly depends on the co-located library and does not list
#     it in dependencies;
#   - main.buri reaches the library through //tools/report and never through
#     //tools/report/render.
#
# Neither rule has a name, and neither needs one: the kind tells them apart, and
# both are //tools/report. The binary's artifact takes the directory name,
# `report`; an `artifact_name` on an output would change that.
library {
    sources: ["render.buri"]
    dependencies: ["//lib/ledger", "//lib/money"]
    visibility: ["//visibility:public"]

    test {
        sources: ["test/render.buri"]

        # A test-only library from another package. Declared here, and importable
        # only because these are test sources.
        dependencies: ["//lib/ledger/testing"]
    }
}

binary {
    sources: ["flags.buri"]
    dependencies: ["//lib/ledger", "//lib/money"]
    tags: ["server"]

    outputs: [
        { platform: LINUX, arch: X86_64 },
        { platform: MACOS, arch: ARM64 },
    ]

    test {
        sources: ["test/flags.buri"]
    }
}
