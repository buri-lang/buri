// The components. Every one of them is a plain function returning a `Node<C>`,
// takes no context and no allocator, and is called once — building a tree is
// fixed-size construction, and nothing here holds any authority.
//
// `C` is unbounded in all three signatures, and that is not laziness: a node's
// type parameter is what its *handlers* are given, and none of these three has
// a handler. A component that took `C: Ui` would be asking every caller for an
// effect it has no use for.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/prop" import { Prop };
from "ui/style" import { Style };
from "//lib/kit/tokens.buri" import { Token };

// --- the static tier ---------------------------------------------------------
//
// A `let` of `Style` is evaluated by the compiler, turned into one atomic
// class per distinct property value, and written into the stylesheet that ships
// with the artifact. Two packages asking for the same padding get the same
// class and one rule. Nothing below is built at run time.

// Hover is a style and not an event. A pseudo-class costs nothing at run time,
// needs no listener, and survives to a platform that has no pointer; a signal
// written on every mouse move would cost a render each time.
let cardStyle: Style = .Group([
    .Layout(.Column),
    .Gap(.Px(6)),
    .Padding(.Rem(0.75)),
    .Radius(.Px(8)),
    .BorderWidth(.Px(1)),
    .BorderColor(Token.Edge.color()),
    .Background(Token.Surface.color()),
    .Foreground(Token.OnSurface.color()),
    .On(.Hover, [.BorderColor(Token.Accent.color())]),
]);

// `Truncate` is at most two lines, ellipsised. A card is a fixed shape, and a
// long title is the reader's problem to hover over rather than the layout's to
// be broken by.
let titleStyle: Style = .Group([
    .FontWeight(.Semibold),
    .TextWrap(.Balance),
    .Truncate(2),
]);

let pillStyle: Style = .Group([
    .PaddingX(.Rem(0.5)),
    .PaddingY(.Rem(0.125)),
    .Radius(.Px(999)),
    .FontSize(.Rem(0.75)),
    .Background(Token.Accent.color()),
    .Foreground(Token.Surface.color()),
]);

// The filled part is an ordinary child that is simply as wide as it is told, so
// the track has to clip what does not fit — which is what `Scroll` says, and
// what makes the rounded ends hold.
let trackStyle: Style = .Group([
    .Height(.Px(6)),
    .Width(.Full),
    .Radius(.Px(999)),
    .Background(Token.Edge.color()),
    .Scroll(.X),
]);

let fillStyle: Style = .Group([
    .Height(.Full),
    .Radius(.Px(999)),
    .Background(Token.Accent.color()),
]);

// --- the components ----------------------------------------------------------

/// A titled surface with whatever is put in it underneath.
///
/// `Group` is the role rather than `Article` or `Main`: the children are a
/// labelled cluster of related things, which is what a card is. A card that
/// claimed to be `Main` would tell a screen reader that the page's content
/// starts here, and a page has one of those.
export fn card<C>(title: Prop<Str>, children: [Node<C>]): Node<C> {
    ui.region(.Group, [cardStyle], [
        ui.row([titleStyle], [ui.text(title)]),
        ui.column([.Gap(.Px(4))], children),
    ])
}

/// A small standing label — a count, a state, a category.
///
/// A stack rather than a region, because a pill is appearance: what it says is
/// already in its text, and a role would be inventing a landmark out of a
/// rounded rectangle.
export fn pill<C>(label: Prop<Str>): Node<C> {
    ui.row([pillStyle], [ui.text(label)])
}

/// How full something is, from `0.0` to `1.0`.
///
/// The one component here in the **computed** style tier: its width is driven
/// by whatever the caller's `Prop` reads, so it is serialised inline on the
/// element and re-serialised when that changes, and it is deliberately absent
/// from the stylesheet — there is no class for "however wide it is right now".
/// Everything else in this file is static. Reach for the static tier first;
/// this is what the other one is for.
///
/// The track and the fill are two elements because a meter is a bar inside a
/// bar. Only the fill's width varies, so only the fill pays for varying.
export fn meter<C>(fraction: Prop<Float>): Node<C> {
    ui.row([trackStyle], [
        ui.stack(
            [
                fillStyle,
                .Computed(fn(scope) => {
                    [.Width(.Percent(percent(fraction.read(scope))))]
                }),
            ],
            [],
        ),
    ])
}

/// A fraction as a percentage, clamped.
///
/// Out-of-range input is clamped rather than refused: a meter is a picture of a
/// number, and a picture that renders nothing because the number was 1.02 is
/// worse than one that renders full.
fn percent(fraction: Float): Float {
    if (fraction <= 0.0) {
        0.0
    } else {
        if (fraction >= 1.0) { 100.0 } else { fraction * 100.0 }
    }
}
