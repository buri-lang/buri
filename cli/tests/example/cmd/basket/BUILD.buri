# //cmd/basket — the same language and the same libraries as //cmd/server, and
# an output that is a page.
#
# `platform: "web"` is not a flag on the JavaScript output: it is a different set
# of effects. `WebHost` has `ui` and `watch`, and no `fs`, `stdin`, `env` or
# `proc` — so main.buri below builds for this output and would not build for
# //cmd/web's, and //cmd/server/main.buri is the same refusal the other way
# round. A `web` output takes no `variant`: there is no machine under a page.
#
# Three files: `main.mjs`, `main.css` — the styles the compiler extracted,
# deduped across every package in the build — and the `index.html` `web` ships,
# which loads both.
binary {
    sources: ["model.buri", "state.buri", "theme.buri", "view.buri"]
    dependencies: ["//lib/kit", "//lib/ledger", "//lib/money"]
    tags: ["client"]

    outputs: [
        { platform: "web" },
    ]

    test {
        sources: ["test/model.buri", "test/view.buri"]

        # The reactive graph and the document a rendered tree goes into are
        # intrinsics of the JavaScript backend. `platform/effect/testing` runs the shipping
        # runtime against a document the runtime supplies rather than a
        # browser's, so these suites run headlessly — but they cannot run on a
        # backend that has no graph at all. The suite runs as the page its
        # output is.
        backends: [JS]
    }
}
