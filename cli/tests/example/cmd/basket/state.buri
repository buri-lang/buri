// Everything the page can change, and the three things that change it.
//
// A `Signal` is an index into the runtime's graph and holds no authority, so a
// struct of them holds none either — which is why a handler's lambda may
// capture a whole `State` while it may not capture the context it needs to use
// one. The authority arrives as a parameter, every time, and that split is what
// the rest of this package is shaped around.

from "core/effect/lib.buri" import { Alloc, NetResponse };
from "core/str/lib.buri" import * as str;
from "ui/effect/lib.buri" import { Fetch, fetch, FetchError, Request, Ui, Watch };
from "ui/signal/lib.buri" import { Signal, signal };

from "//lib/ledger/lib.buri" import { Entry };
from "//cmd/basket/model.buri" import { draft, entriesFrom, flip, LEDGER_URL };

/// The whole of this page's state.
export struct State {
  /// The lines, in the order they were added. Keyed by memo when they are
  /// rendered, so this list may be reordered without rebuilding a row.
  export items: Signal<[Entry]>,
  /// The memos of the lines that have been settled.
  ///
  /// Beside the list rather than inside it, because a row is built from its
  /// item once: if a row's *item* carried its settled flag, ticking a line
  /// would change the item, and the item is what the list is made of. Keeping
  /// the flag in a second signal is what lets the row read it as a `Prop` —
  /// the changing part of a row that is otherwise unchanged.
  export ticked: Signal<[Str]>,
  /// What has been typed into the composer's first field.
  export draftMemo: Signal<Str>,
  /// And its second.
  export draftAmount: Signal<Str>,
  /// What the page has to say, or the empty string. Rendered into an `Alert`.
  export notice: Signal<Str>,
  /// Whether the dark theme is the one installed.
  export dark: Signal<Bool>,
}

/// A fresh, empty basket.
///
/// Empty on purpose: the first thing the page shows is the branch of `choose`
/// that says so, and pressing "Load the ledger" is what replaces it.
export fn newState<C: Ui>(ctx: C): State {
  let noItems: [Entry] = [];
  let noMemos: [Str] = [];
  State {
    items: signal(ctx, noItems),
    ticked: signal(ctx, noMemos),
    draftMemo: signal(ctx, ""),
    draftAmount: signal(ctx, ""),
    notice: signal(ctx, ""),
    dark: signal(ctx, false),
  }
}

/// Adds whatever the composer's two fields currently say, and says why not.
///
/// `Signal.update` is not usable here: it takes a `fn(T) => T`, which is a
/// lambda, and a lambda may not capture a context — so a new list that has to
/// be *allocated* cannot be built inside one. Reading, computing with the
/// context this call was handed, and writing back is the shape that works, and
/// it is the shape every handler in this package uses.
export fn add<C: Alloc + Ui + Watch>(ctx: C, state: State): () {
  match (draft(state.draftMemo.get(ctx), state.draftAmount.get(ctx))) {
    .Blank => state.notice.set(ctx, "a line needs a memo"),
    .BadAmount(text) => state.notice.set(ctx, str.format(ctx, "\"${text}\" is not an amount")),
    .Line(line) => {
      let _ = state.items.set(ctx, state.items.get(ctx).push(ctx, line));
      let _ = state.draftMemo.set(ctx, "");
      let _ = state.draftAmount.set(ctx, "");
      state.notice.set(ctx, "")
    },
  }
}

/// Settles the line called `memo`, or unsettles it.
export fn tick<C: Alloc + Ui + Watch>(ctx: C, state: State, memo: Str): () {
  state.ticked.set(ctx, flip(ctx, state.ticked.get(ctx), memo))
}

/// Asks the server for its ledger and shows whatever comes back.
///
/// `Net.fetch` blocks until the response arrives, which on a page means
/// freezing it, so a platform with an interface grants `Fetch` instead: it
/// starts the request and returns immediately, and `done` runs later with the
/// very context this call was made with. That is why the callback can write
/// signals without capturing anything — the authority arrives as its first
/// parameter, exactly as a press handler's does.
export fn load<C: Alloc + Fetch + Ui>(ctx: C, state: State): () {
  let _ = state.notice.set(ctx, "asking the server for its ledger");
  let request = Request { method: "GET", url: LEDGER_URL, headers: [], body: "" };
  fetch(ctx, request, fn(c, result) => received(c, state, result))
}

/// What to do with a response, or with the reason there was not one.
fn received<C: Alloc + Ui>(
  ctx: C,
  state: State,
  result: Result<NetResponse, FetchError>,
): () {
  match (result) {
    .Err(why) => state.notice.set(ctx, refusal(why)),
    .Ok(response) => if (response.status == 200) {
      let lines = entriesFrom(ctx, response.body);
      let _ = state.items.set(ctx, lines);
      let noMemos: [Str] = [];
      let _ = state.ticked.set(ctx, noMemos);
      if (lines.isEmpty()) {
        state.notice.set(ctx, "the server's ledger is empty")
      } else {
        state.notice.set(ctx, "")
      }
    } else {
      state.notice.set(ctx, str.format(ctx, "the server answered ${response.status}"))
    },
  }
}

/// Why there was no response, in words a reader can act on.
///
/// Exhaustive, and that is the point of `FetchError` being a closed enum: the
/// day a fifth reason is added, this page stops compiling rather than quietly
/// showing the wrong one.
fn refusal(why: FetchError): Str {
  match (why) {
    .Timeout => "the server took too long",
    .Refused => "the server refused the connection",
    .BadUrl(_) => "that is not a URL",
    .Transport(_) => "the connection broke",
    .Aborted => "the request was cancelled",
  }
}
