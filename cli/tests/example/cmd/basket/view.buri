// The page, as eight functions that return a `Node<C>`.
//
// Every one of them is called exactly once. A component is an ordinary
// function, so there is no component lifecycle to learn, no re-render to
// reason about, and nothing to memoise: what re-runs when something changes is
// whichever of the three reactive constructors surrounds it, and each of them
// re-runs the smallest thing it can.
//
//   `.Computed` on a leaf   the string in a `Prop`, and nothing else
//   `ui.choose`             one of two subtrees, when the condition flips
//   `ui.each`               one row, and only a row whose key is new
//
// There is no `ui.computed` in this file, and that is a choice worth reading:
// it rebuilds its whole subtree, so it is the coarse instrument. Everything
// here that varies is a string or a class, so everything here is a `Prop`.

from "core/effect" import { Alloc, Net };
from "core/str" import * as str;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/prop" import { memo, Prop };
from "ui/style" import { Style };
from "//cmd/basket/model.buri" import { isTicked, LEDGER_URL, pad, settledFraction };
from "//cmd/basket/state.buri" import { add, load, State, tick };
from "//cmd/basket/theme.buri" import { Shade };
from "//lib/kit" import { card, meter, pill };
from "//lib/ledger" import { Entry, total };

// --- appearance ----------------------------------------------------------------------
//
// The static tier: a `let` of `Style` is evaluated by the compiler, turned
// into one atomic class per distinct property value, and written into the
// stylesheet beside the module. Nothing below is built at run time, and the
// `At` breakpoints cost nothing to have — they are media queries in that same
// sheet, ascending, so a wider screen's rules win by being written later.

let pageStyle: Style = .Group([
    .Layout(.Column),
    .Gap(.Rem(1.0)),
    .Padding(.Rem(1.0)),
    .MinHeight(.Full),
    .FontFamily(.Sans),
    .Background(Shade.Bg.color()),
    .Foreground(Shade.Fg.color()),
    .At(.Medium, [.Padding(.Rem(2.0))]),
    .At(.Large, [.MaxWidth(.Rem(48.0))]),
]);

let barStyle: Style = .Group([
    .Layout(.Row),
    .AlignCross(.Center),
    .Gap(.Px(12)),
    .PaddingY(.Rem(0.5)),
]);

let formStyle: Style = .Group([
    .Layout(.Row),
    .Wrap(true),
    .AlignCross(.End),
    .Gap(.Px(8)),
]);

let noticeStyle: Style = .Group([
    .Padding(.Rem(0.5)),
    .Radius(.Px(6)),
    .FontSize(.Rem(0.875)),
    .Foreground(Shade.Accent.color()),
]);

let listStyle: Style = .Group([.Layout(.Column), .Gap(.Px(8))]);

let rowStyle: Style = .Group([.Layout(.Row), .AlignCross(.Center), .Gap(.Px(8))]);

let settledStyle: [Style] = [.TextLine(.Strike), .Opacity(0.55)];

let amountStyle: Style = .Group([
    .FontFamily(.Mono),
    .TextAlign(.End),
    .MinWidth(.Rem(5.0)),
]);

let emptyStyle: Style = .Group([
    .Padding(.Rem(1.5)),
    .TextAlign(.Center),
    .Opacity(0.7),
]);

let totalStyle: Style = .Group([
    .FontSize(.Rem(1.25)),
    .FontWeight(.Semibold),
    .FontFamily(.Mono),
]);

// --- the page ------------------------------------------------------------------------

/// The whole page.
///
/// `C` names every effect a handler anywhere below may reach for, and nothing
/// wider: `Net` is here because one button asks the server for the ledger, and
/// `Alloc` because two handlers build a list. `main` decides what those are
/// worth, and a platform decides whether `main` may ask.
export fn page<C: Alloc + Net + Ui + Watch>(ctx: C, state: State): Node<C> {
    ui.column([pageStyle], [
        banner(state),
        ui.region(.Main, [.Layout(.Column), .Gap(.Rem(1.0))], [
            composer(state),
            notice(state),
            lines(state),
            summary(ctx, state),
        ]),
        colophon(),
    ])
}

/// The heading, and the switch that changes what every token is worth.
///
/// Dark mode is a `Prop<Bool>` and not a second stylesheet. Writing this signal
/// rewrites one block of custom properties; every class on every element stays
/// exactly as it was, nothing is re-extracted, and the browser repaints from
/// variables it already had. `main.buri` is where the two value sets meet it.
fn banner<C>(state: State): Node<C> {
    ui.region(.Banner, [barStyle], [
        ui.heading(1, .Const("Basket")),
        ui.spacer(),
        ui.toggle(.Const("Dark mode"), state.dark),
    ])
}

/// The two fields and the two ways to use them.
///
/// A `form` rather than a stack, because submission is behaviour: pressing
/// Enter in either field runs `onSubmit`, which is the browser's own dispatch
/// and not a key handler this program had to write. The button does the same
/// thing for a reader who would rather press it.
///
/// Both fields are labelled, because `ui.field` has no form that is not. An
/// unlabelled input is the commonest accessibility failure there is and, unlike
/// a missing `alt`, it has no visual fallback — so it is not expressible.
fn composer<C: Alloc + Net + Ui + Watch>(state: State): Node<C> {
    ui.form(fn(c, submitted) => add(c, state), [formStyle], [
        ui.field(.Const("Item"), .Text, state.draftMemo),
        ui.field(.Const("Amount in dollars"), .Number, state.draftAmount),
        ui.button(.Const("Add"), fn(c, pressed) => add(c, state)),
        ui.spacer(),
        ui.button(.Const("Load the ledger"), fn(c, pressed) => load(c, state)),
    ])
}

/// What the page has to say, when it has something.
///
/// `Alert` is the assertive live region: its changes interrupt whatever a
/// screen reader was saying, which is right for "that is not an amount" and
/// would be wrong for a running total. The total below is a `Status`, which is
/// the polite one.
///
/// `choose` and not a `Prop` on the text, because when there is nothing to say
/// there should be no live region on the page at all — an empty alert is still
/// an alert.
fn notice<C>(state: State): Node<C> {
    ui.choose(
        .Computed(fn(scope) => !state.notice.get(scope).isEmpty()),
        ui.region(.Alert, [noticeStyle], [ui.text(.Cell(state.notice))]),
        ui.nothing(),
    )
}

/// The basket, or the fact that there is not one yet.
fn lines<C: Alloc + Ui + Watch>(state: State): Node<C> {
    ui.choose(
        .Computed(fn(scope) => state.items.get(scope).isEmpty()),
        card(.Const("Nothing in the basket"), [
            ui.stack([emptyStyle], [
                ui.text(
                    .Const(
                        "Add a line above, or load the ones the server already has.",
                    ),
                ),
            ]),
        ]),
        ui.region(.List, [listStyle], [
            ui.each(.Cell(state.items), keyOf, fn(c, item, index) => {
                line(c, state, item)
            }),
        ]),
    )
    // `List` is a role and not a layout: a screen reader announces how many
    // items are in it, which is the difference between a list of things and a
    // stack of things that happen to be arranged downwards.
}

/// The key of a row.
///
/// A parameter rather than a convention, for the reason `alt` is one: keying a
/// list by position silently corrupts it the moment the list is reordered, and
/// nothing can notice. The memo is the key here because it is what makes a line
/// that line — two lines with one memo is a mistake the runtime refuses at the
/// point it is made, which is the answer this app wants.
fn keyOf(item: Entry): Str {
    item.memo
}

/// One line of the basket.
///
/// Built from its item once, and never rebuilt while its key is still in the
/// list — that is what keyed means, and it is what keeps the focus and the
/// scroll position across a reorder. So the part of a row that can change while
/// its key does not is a `Prop`: whether the line is settled lives in a second
/// signal, and the row reads it through one.
///
/// `.When` is the style tier's version of the same idea. Both branches are
/// extracted into the stylesheet at compile time and the runtime picks between
/// two class strings it was handed; no rule is built anywhere, ever.
fn line<C: Alloc + Ui + Watch>(ctx: C, state: State, item: Entry): Node<C> {
    let settled: Prop<Bool> = .Computed(fn(scope) => {
        isTicked(state.ticked.get(scope), item.memo)
    });
    ui.region(.ListItem, [rowStyle], [
        ui.button(.Const(str.format(ctx, "settle ${item.memo}")), fn(c, pressed) => {
            tick(c, state, item.memo)
        }),
        ui.stack([.Grow(1), .When(settled, settledStyle, [])], [
            ui.text(.Const(item.memo)),
        ]),
        ui.stack([amountStyle], [ui.text(.Const(item.amount.format(ctx)))]),
    ])
    // The label names the line, because a screen reader announces a button by
    // its label and "settle, button" five times over says nothing.
    // The amount cannot change without the line changing, so it is a `Const`
    // and the row pays nothing for it. `format` allocates, and this is a place
    // that has an allocator — a reactive closure is not.
}

/// The running total, and how much of it is settled.
///
/// `Status` is the polite live region: its changes are announced when the
/// reader is idle rather than interrupting. Without a live region here a
/// reactive change to the total would be silent, which is the failure mode a
/// screen reader cannot work around.
fn summary<C: Ui>(ctx: C, state: State): Node<C> {
    // A memo, so that the fraction is computed once per change however many
    // things read it, and not at all while nothing does.
    let settled: Prop<Float> = memo(ctx, fn(scope) => {
        settledFraction(state.items.get(scope), state.ticked.get(scope))
    });
    ui.region(.Status, [.Layout(.Column), .Gap(.Px(8))], [
        ui.row([.AlignCross(.Center), .Gap(.Px(8))], [
            ui.stack([totalStyle], [
                ui.text(
                    .Computed(fn(scope) => {
                        let both = total(state.items.get(scope)).parts();
                        "\$${both.0}.${pad(both.1)}${both.1}"
                    }),
                ),
            ]),
            ui.spacer(),
            pill(.Computed(fn(scope) => "${state.ticked.get(scope).len()} settled")),
        ]),
        meter(settled),
    ])
    // The amount is rendered inside the reactive closure because that is
    // where the numbers are. A named function could not do it: turning an
    // interpolation into a `Str` allocates, and what a computation is handed
    // is a `Scope`, which grants reading the graph and nothing else.
}

/// Where the lines come from, as a link a reader can follow.
fn colophon<C>(): Node<C> {
    ui.region(.ContentInfo, [.FontSize(.Rem(0.75)), .Opacity(0.7)], [
        ui.row([.Gap(.Px(4))], [
            ui.text(.Const("Lines come from the server's")),
            ui.link(.Const(LEDGER_URL), [ui.text(.Const("ledger route"))]),
        ]),
    ])
}
