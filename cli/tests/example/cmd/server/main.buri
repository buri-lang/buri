// The entry point. It is also this binary's surface for tests:
// test/routes.buri sees what this file exports, and nothing else — the same
// rule lib.buri follows for a library.

from "core/effect" import { Alloc, Env, Stdout };
from "core/env" import * as env;
from "core/fs" import { FsRead, FsWrite };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/path" import * as filepath;
from "core/str" import * as str;
from "//lib/ledger" import { entry };
from "//lib/money" import { fromCents };
from "//lib/store" import { append };

// Re-exported so the suite can reach it. Everything else in routes.buri stays
// inside the binary.
from "//cmd/server/routes.buri" export { Route, route };

from "//cmd/server/routes.buri" import { route };

/// The context is this program's complete effect budget. Under `platform: JS`
/// this same body would fail to build: a browser platform's `core/host` has no
/// filesystem to export, so `host.fsRead` does not resolve — and the error
/// lands on that line rather than at runtime.
///
/// The filesystem is two bindings because it is two authorities. `append`
/// reads the log and then writes it, so this program needs both; a program
/// that only served the log would bind `FsRead` alone and be unable to change
/// a byte of it anywhere in its call graph.
export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
        FsRead: host.fsRead,
        FsWrite: host.fsWrite,
        Env: host.env,
    };

    let log = filepath.of(ctx, env.get(ctx, "LEDGER_LOG").withDefault("ledger.log"));
    let path = log.text();
    let hit = route("/entries");

    match (append(ctx, log, [entry("startup", fromCents(0))])) {
        .Err(_) => .Err(str.format(ctx, "could not open the ledger log at ${path}")),
        .Ok(_) => {
            match (io.println(ctx, "serving ${hit.name} at ${hit.path} from ${path}")) {
                .Ok(_) => .Ok(()),
                .Err(_) => .Err("could not write to standard output"),
            }
        },
    }
}
