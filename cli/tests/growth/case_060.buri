fn g060_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g060_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g060_pick(code))
}

fn g060_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    g060_add(ctx, held, i * 7 + 3)
}

fn g060_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g060_runLoop(ctx, acc, base, base + count)
}

fn g060_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end || acc.length() >= 1101) {
        acc
    } else {
        g060_runLoop(ctx, g060_step(ctx, acc, i), i + 1, end)
    }
}

fn g060_hash(items: Str): Int {
    g060_walk(items, 0, 7)
}

fn g060_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g060_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g060<C: Allocator>(ctx: C): Str {
