        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g060_run(c, "", r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g060_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

