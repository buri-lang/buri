from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G085Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g085_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g085_step<C: Allocator>(ctx: C, acc: G085Acc, i: Int): G085Acc {
    let seen = acc.items.length();
    G085Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g085_put(ctx, acc.items, i * 3 + 9 + seen % 7, 0)
        } else {
            g085_put(ctx, acc.items, i * 3 + 9 + seen % 7, 1)
        },
    }
}

fn g085_run<C: Allocator>(ctx: C, acc: G085Acc, base: Int, count: Int): G085Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g085_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g085_step(ctx, acc, i)
    }
}

fn g085_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g085<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => {
            g085_run(
                c,
                G085Acc { n: 0, items: list.empty<Int>(), tag: 42 },
                r * 100,
                100,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g085_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g085(host.alloc)).ignore();
    .Ok(())
}
