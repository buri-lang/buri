from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G085Row {
    id: Int,
    name: Str,
}

fn g085_measure(items: [G085Row]): Int {
    items.length()
}

fn g085_gate(i: Int): Result<Int, Str> {
    if (i == 201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g085_run<C: Allocator>(
    ctx: C,
    acc: (Int, [G085Row]),
    base: Int,
    count: Int,
): Result<(Int, [G085Row]), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
            ctx,
            fn(c, acc: (Int, [G085Row]), i) => {
                let q = g085_gate(i)?;
                let (n, items) = acc;
                let seen = g085_measure(items);
                .Ok(
                    (
                        n + 1,
                        items.concat(c, [
                            G085Row {
                                id: i * 3 + 6 + seen % 7 + q,
                                name: str.fromInt(c, i * 3 + 6 + seen % 7 + q),
                            },
                        ]),
                    ),
                )
            },
            acc,
        )
}

fn g085_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [G085Row]),
    base: Int,
    count: Int,
): Result<(Int, [G085Row]), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g085_rounds(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g085_run(ctx, acc, i * 50, 50)
    }
}

fn g085_hash(items: [G085Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g085<C: Allocator>(ctx: C): Str {
    match (g085_rounds(ctx, (0, []), 0, 4)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x.name,
                .None => "-1",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x.name,
                .None => "-1",
            };
            let hash = g085_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g085(host.alloc)).ignore();
    .Ok(())
