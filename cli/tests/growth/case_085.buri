from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g085_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g085_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g085_pick(k)) }
}

fn g085_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g085_put(ctx, acc, i * 3 + 1, 0)
            } else {
                g085_put(ctx, acc, i * 3 + 1, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g085_put(ctx, acc, i * 3 + 1 + 1, 0)
            } else {
                g085_put(ctx, acc, i * 3 + 1 + 1, 1)
            }
        },
    }
}

fn g085_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g085_step(c, acc, i), acc)
}

fn g085_hash(items: Str): Int {
    g085_walk(items, 0, 7)
}

fn g085_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g085_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g085<C: Allocator>(ctx: C): Str {
    let acc = g085_run(ctx, "", 0, 600);
    let size = acc.length();
    let first = acc.slice(0, 8);
    let last = acc.slice(size - 8, size);
    let hash = g085_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g085(host.alloc)).ignore();
    .Ok(())
}
