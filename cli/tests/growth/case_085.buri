from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g085_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g085_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let seen = acc.length();
    if (i % 2 == 0) {
        g085_put(ctx, acc, i * 3 + 9 + seen % 7, 0)
    } else {
        g085_put(ctx, acc, i * 3 + 9 + seen % 7, 1)
    }
}

fn g085_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    if (count == 0) {
        acc
    } else {
        let acc = g085_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g085_step(ctx, acc, i)
    }
}

fn g085_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g085<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => g085_run(c, list.empty<Int>(), r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g085_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g085(host.alloc)).ignore();
    .Ok(())
