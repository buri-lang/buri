fn g223<C: Allocator>(ctx: C): Str {
    match (g223_run(ctx, "", 0, 800)) {
        .Ok(acc) => {
            let size = acc.length();
            let first = acc.slice(0, 8);
            let last = acc.slice(size - 8, size);
