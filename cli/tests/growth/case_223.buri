fn g223_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g223_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g223_pick(code))
}

fn g223_gate(i: Int): Result<Int, Str> {
