fn g202_run<C: Allocator>(ctx: C, acc: G202Outer, base: Int, count: Int): G202Outer {
    g202_runLoop(ctx, acc, base, base + count)
}

fn g202_runLoop<C: Allocator>(ctx: C, acc: G202Outer, i: Int, end: Int): G202Outer {
