from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g202_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g202_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g202_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let seen = g202_survey(acc) + g202_survey(acc);
    acc.concat(ctx, g202_pick(i * 1 + 3 + seen % 7))
}

fn g202_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g202_runLoop(ctx, acc, base, base + count)
}

fn g202_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end) { acc } else { g202_runLoop(ctx, g202_step(ctx, acc, i), i + 1, end) }
}

fn g202_hash(items: Str): Int {
    g202_walk(items, 0, 7)
}

fn g202_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g202_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g202<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => g202_run(c, "", r * 50, 50));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g202_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g202(host.alloc)).ignore();
    .Ok(())
}
