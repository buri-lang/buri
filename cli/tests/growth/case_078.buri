from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G078Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g078_step<C: Allocator>(ctx: C, acc: G078Acc, i: Int): G078Acc {
    let held = acc.items;
    G078Acc { ..acc, n: acc.n + 1, items: held.push(ctx, str.fromInt(ctx, i * 3 + 9)) }
}

fn g078_run<C: Allocator>(ctx: C, acc: G078Acc, base: Int, count: Int): G078Acc {
    g078_runLoop(ctx, acc, base, base + count)
}

fn g078_runLoop<C: Allocator>(ctx: C, acc: G078Acc, i: Int, end: Int): G078Acc {
    if (i == end) { acc } else { g078_runLoop(ctx, g078_step(ctx, acc, i), i + 1, end) }
}

fn g078_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g078<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g078_run(
                c,
                G078Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g078_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g078(host.alloc)).ignore();
    .Ok(())
