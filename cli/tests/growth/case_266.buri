from "platform/effect" import { Allocator };

fn g266_measure(items: [Int]): Int {
    items.length()
}

fn g266_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(
            ctx,
            fn(c, acc: (Int, [Int]), i) => {
