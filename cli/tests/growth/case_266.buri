from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g266_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g266_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g266_gate(i: Int): Result<Int, Str> {
    if (i == 401) { .Err("bad") } else { .Ok(i % 5) }
}

fn g266_step<C: Allocator>(ctx: C, acc: [Str], i: Int): Result<[Str], Str> {
    let q = g266_gate(i)?;
    let items = acc;
    let held = items;
    let seen = g266_survey(held) + g266_survey(held);
    .Ok(g266_add(ctx, held, i * 1 + 5 + seen % 7 + q))
}

fn g266_run<C: Allocator>(
    ctx: C,
    acc: [Str],
    base: Int,
    count: Int,
): Result<[Str], Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g266_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g266_step(ctx, acc, i)
    }
}

fn g266_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g266<C: Allocator>(ctx: C): Str {
    match (g266_run(ctx, list.empty<Str>(), 0, 400)) {
        .Ok(acc) => {
            let first = match (acc.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g266_hash(acc);
            str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g266(host.alloc)).ignore();
    .Ok(())
}
