fn g300_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g300_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let items = acc;
    let seen = items.length();
    items.push(ctx, g300_pick(i * 7 + 3 + seen % 7))
}

fn g300_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    if (count == 0) {
        acc
    } else {
        let acc = g300_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        if (acc.length() >= 850) { acc } else { g300_step(ctx, acc, i) }
    }
}

fn g300_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g300<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g300_run(c, list.empty<Str>(), r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g300_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

