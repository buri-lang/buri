fn g300_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let (n, items) = acc;
    let seen = items.length();
    (n + 1, items.push(ctx, i * 7 + 3 + seen % 7))
}

fn g300_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    if (count == 0) {
        acc
    } else {
        let acc = g300_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        if (acc.1.length() >= 850) { acc } else { g300_step(ctx, acc, i) }
    }
}

fn g300_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g300<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g300_run(c, (0, list.empty<Int>()), r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g300_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
