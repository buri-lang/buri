fn g300_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g300_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g300_pick(code))
}

fn g300_measure(items: Str): Int {
    items.length()
}

fn g300_step<C: Allocator>(ctx: C, acc: G300Acc, i: Int): G300Acc {
    match (acc) {
        G300Acc { n, items, tag } => {
            let seen = g300_measure(items);
            G300Acc { n: n + 1, items: g300_add(ctx, items, i * 1 + 9 + seen % 7), tag }
        },
    }
}

fn g300_run<C: Allocator>(ctx: C, acc: G300Acc, base: Int, count: Int): G300Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g300_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g300_step(ctx, acc, i)
    }
}

fn g300_hash(items: Str): Int {
    g300_walk(items, 0, 7)
}

fn g300_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g300_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
