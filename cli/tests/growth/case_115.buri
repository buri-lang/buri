fn g115_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g115_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g115_pick(k)) }
}

fn g115_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g115_step<C: Allocator>(ctx: C, acc: G115Acc, i: Int): G115Acc {
    let seen = g115_survey(acc.items) + g115_survey(acc.items);
    G115Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g115_put(ctx, acc.items, i * 3 + 0 + seen % 7, 0)
        } else {
            g115_put(ctx, acc.items, i * 3 + 0 + seen % 7, 1)
        },
    }
}

fn g115_run<C: Allocator>(ctx: C, acc: G115Acc, base: Int, count: Int): G115Acc {
    if (count == 0) {
        acc
