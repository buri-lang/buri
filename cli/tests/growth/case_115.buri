    n: Int,
    items: Str,
    tag: Int,
}

fn g115_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g115_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g115_pick(k)) }
}

fn g115_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g115_step<C: Allocator>(ctx: C, acc: G115Acc, i: Int): G115Acc {
    let seen = g115_survey(acc.items) + g115_survey(acc.items);
    G115Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g115_put(ctx, acc.items, i * 3 + 0 + seen % 7, 0)
        } else {
            g115_put(ctx, acc.items, i * 3 + 0 + seen % 7, 1)
        },
    }
}

fn g115_run<C: Allocator>(ctx: C, acc: G115Acc, base: Int, count: Int): G115Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g115_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        if (acc.items.length() >= 605) { acc } else { g115_step(ctx, acc, i) }
    }
}

fn g115_hash(items: Str): Int {
    g115_walk(items, 0, 7)
}

fn g115_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g115_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g115<C: Allocator>(ctx: C): Str {
    let acc = g115_run(ctx, G115Acc { n: 0, items: "", tag: 42 }, 0, 800);
    let size = acc.items.length();
    let first = acc.items.slice(0, 8);
    let last = acc.items.slice(size - 8, size);
