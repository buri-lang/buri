from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G186Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g186_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g186_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g186_pick(k)) }
}

fn g186_step<C: Allocator>(ctx: C, acc: G186Acc, i: Int): G186Acc {
    match (acc) {
        G186Acc { n, items, tag } => {
            let seen = items.length();
            G186Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g186_put(ctx, items, i * 3 + 7 + seen % 7, 0)
                } else {
                    g186_put(ctx, items, i * 3 + 7 + seen % 7, 1)
                },
                tag,
            }
        },
    }
}

fn g186_run<C: Allocator>(ctx: C, acc: G186Acc, base: Int, count: Int): G186Acc {
    g186_runLoop(ctx, acc, base, base + count)
}

fn g186_runLoop<C: Allocator>(ctx: C, acc: G186Acc, i: Int, end: Int): G186Acc {
    if (i == end || acc.items.length() >= 177) {
        acc
    } else {
        g186_runLoop(ctx, g186_step(ctx, acc, i), i + 1, end)
    }
}

fn g186_hash(items: Str): Int {
    g186_walk(items, 0, 7)
}

fn g186_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g186_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g186<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g186_run(c, G186Acc { n: 0, items: "", tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g186_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g186(host.alloc)).ignore();
    .Ok(())
}
