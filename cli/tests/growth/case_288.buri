from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g288_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g288_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let (n, items) = acc;
    let held = items;
    (n + 1, g288_add(ctx, held, i * 7 + 0))
}

fn g288_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    g288_runLoop(ctx, acc, base, base + count)
}

fn g288_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
    end: Int,
): (Int, [Int]) {
    if (i == end) { acc } else { g288_runLoop(ctx, g288_step(ctx, acc, i), i + 1, end) }
}

fn g288_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g288<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g288_run(c, (0, list.empty<Int>()), r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g288_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g288(host.alloc)).ignore();
    .Ok(())
