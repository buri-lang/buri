fn g308_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g308_gate(i: Int): Result<Int, Str> {
    if (i == 1201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g308_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
): Result<(Int, [Str]), Str> {
    let q = g308_gate(i)?;
    let (n, items) = acc;
    let seen = items.length();
    .Ok(
        (
            n + 1,
            if (i % 2 == 0) {
                g308_put(ctx, items, i * 3 + 3 + seen % 7 + q, 0)
            } else {
                g308_put(ctx, items, i * 3 + 3 + seen % 7 + q, 1)
            },
        ),
    )
}

fn g308_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    g308_runLoop(ctx, acc, base, base + count)
}

fn g308_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): Result<(Int, [Str]), Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g308_runLoop(ctx, g308_step(ctx, acc, i)?, i + 1, end)
