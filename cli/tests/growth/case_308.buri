from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G308Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g308_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g308_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g308_pick(k)) }
}

fn g308_gate(i: Int): Result<Int, Str> {
    if (i == 1201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g308_step<C: Allocator>(ctx: C, acc: G308Acc, i: Int): Result<G308Acc, Str> {
    let q = g308_gate(i)?;
    let G308Acc { n, items, tag } = acc;
    let seen = items.length();
    .Ok(G308Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g308_put(ctx, items, i * 3 + 3 + seen % 7 + q, 0)
        } else {
            g308_put(ctx, items, i * 3 + 3 + seen % 7 + q, 1)
        },
        tag,
    })
}

fn g308_run<C: Allocator>(
    ctx: C,
    acc: G308Acc,
    base: Int,
    count: Int,
): Result<G308Acc, Str> {
    g308_runLoop(ctx, acc, base, base + count)
}

fn g308_runLoop<C: Allocator>(
    ctx: C,
    acc: G308Acc,
    i: Int,
    end: Int,
): Result<G308Acc, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g308_runLoop(ctx, g308_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g308_rounds<C: Allocator>(
    ctx: C,
    acc: G308Acc,
    base: Int,
    count: Int,
): Result<G308Acc, Str> {
    g308_roundsLoop(ctx, acc, base, base + count)
}

fn g308_roundsLoop<C: Allocator>(
    ctx: C,
    acc: G308Acc,
    i: Int,
    end: Int,
): Result<G308Acc, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g308_roundsLoop(ctx, g308_run(ctx, acc, i * 150, 150)?, i + 1, end)
    }
}

fn g308_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g308<C: Allocator>(ctx: C): Str {
    match (
        g308_rounds(ctx, G308Acc { n: 0, items: list.empty<Str>(), tag: 42 }, 0, 8)
    ) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.items.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g308_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g308(host.alloc)).ignore();
    .Ok(())
}
