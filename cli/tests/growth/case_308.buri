}

fn g308_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    g308_roundsLoop(ctx, acc, base, base + count)
}

fn g308_roundsLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): Result<(Int, [Str]), Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g308_roundsLoop(ctx, g308_run(ctx, acc, i * 150, 150)?, i + 1, end)
    }
}

fn g308_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g308<C: Allocator>(ctx: C): Str {
    match (g308_rounds(ctx, (0, list.empty<Str>()), 0, 8)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g308_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g308(host.alloc)).ignore();
    .Ok(())
