from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G039Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g039_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g039_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g039_pick(k)) }
}

fn g039_measure(items: [Str]): Int {
    items.length()
}

fn g039_gate(i: Int): Result<Int, Str> {
    if (i == 1001) { .Err("bad") } else { .Ok(i % 5) }
}

struct G039Outer {
    inner: G039Acc,
    k: Int,
}

fn g039_inner<C: Allocator>(ctx: C, acc: G039Acc, i: Int): Result<G039Acc, Str> {
    let q = g039_gate(i)?;
    let held = acc.items;
    let seen = g039_measure(held);
    .Ok(G039Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g039_put(ctx, held, i * 7 + 0 + seen % 7 + q, 0)
        } else {
            g039_put(ctx, held, i * 7 + 0 + seen % 7 + q, 1)
        },
    })
}

fn g039_step<C: Allocator>(ctx: C, acc: G039Outer, i: Int): Result<G039Outer, Str> {
    if (acc.inner.items.length() >= 785) {
        .Ok(acc)
    } else {
        let held = acc.inner;
        .Ok(G039Outer { ..acc, k: acc.k + 1, inner: g039_inner(ctx, held, i)? })
    }
}

fn g039_run<C: Allocator>(
    ctx: C,
    acc: G039Outer,
    base: Int,
    count: Int,
): Result<G039Outer, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g039_step(c, acc, i), acc)
}

fn g039_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g039<C: Allocator>(ctx: C): Str {
    match (
        g039_run(
            ctx,
            G039Outer {
                inner: G039Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                k: 0,
            },
            0,
            1000,
        )
    ) {
        .Ok(acc) => {
            let first = match (acc.inner.items.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.inner.items.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g039_hash(acc.inner.items);
            str.format(
                ctx,
                "${acc.k} ${acc
                    .inner
                    .n} ${acc
                    .inner
                    .tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g039(host.alloc)).ignore();
    .Ok(())
}
