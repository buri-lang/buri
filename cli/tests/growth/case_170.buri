}

fn g170_run<C: Allocator>(ctx: C, acc: G170Acc, base: Int, count: Int): G170Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g170_step(c, acc, i), acc)
}

fn g170_rounds<C: Allocator>(ctx: C, acc: G170Acc, base: Int, count: Int): G170Acc {
    g170_roundsLoop(ctx, acc, base, base + count)
}

fn g170_roundsLoop<C: Allocator>(ctx: C, acc: G170Acc, i: Int, end: Int): G170Acc {
    if (i == end) {
