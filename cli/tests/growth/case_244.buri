}

fn g244_rounds<C: Allocator>(
    ctx: C,
    acc: G244Acc,
    base: Int,
    count: Int,
): Result<G244Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g244_run(c, acc, i * 150, 150), acc)
}

fn g244_hash(items: Str): Int {
    g244_walk(items, 0, 7)
}

fn g244_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g244_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g244<C: Allocator>(ctx: C): Str {
    match (g244_rounds(ctx, G244Acc { n: 0, items: "", tag: 42 }, 0, 4)) {
        .Ok(acc) => {
            let size = acc.items.length();
            let first = acc.items.slice(0, 8);
            let last = acc.items.slice(size - 8, size);
            let hash = g244_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

