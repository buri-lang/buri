from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G244Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g244_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g244_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g244_pick(k)) }
}

fn g244_measure(items: Str): Int {
    items.length()
}

fn g244_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g244_step<C: Allocator>(ctx: C, acc: G244Acc, i: Int): Result<G244Acc, Str> {
    let q = g244_gate(i)?;
    let seen = g244_measure(acc.items);
    .Ok(G244Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g244_put(ctx, acc.items, i * 3 + 2 + seen % 7 + q, 0)
        } else {
            g244_put(ctx, acc.items, i * 3 + 2 + seen % 7 + q, 1)
        },
    })
}

fn g244_run<C: Allocator>(
    ctx: C,
    acc: G244Acc,
    base: Int,
    count: Int,
): Result<G244Acc, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g244_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g244_step(ctx, acc, i)
