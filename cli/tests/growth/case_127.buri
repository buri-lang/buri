from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G127Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g127_step<C: Allocator>(ctx: C, acc: G127Acc, i: Int): G127Acc {
    G127Acc {
        ..acc,
        n: acc.n + 1,
        items: acc.items.push(ctx, str.fromInt(ctx, i * 3 + 8)),
    }
}

fn g127_run<C: Allocator>(ctx: C, acc: G127Acc, base: Int, count: Int): G127Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g127_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g127_step(ctx, acc, i)
    }
}

fn g127_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g127<C: Allocator>(ctx: C): Str {
    let acc = g127_run(
        ctx,
        G127Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        1000,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g127_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g127(host.alloc)).ignore();
    .Ok(())
}
