}

fn g195_run<C: Allocator>(ctx: C, acc: G195Acc, base: Int, count: Int): G195Acc {
    g195_runLoop(ctx, acc, base, base + count)
}

fn g195_runLoop<C: Allocator>(ctx: C, acc: G195Acc, i: Int, end: Int): G195Acc {
    if (i == end) { acc } else { g195_runLoop(ctx, g195_step(ctx, acc, i), i + 1, end) }
}

fn g195_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

