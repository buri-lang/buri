fn g195_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g195_measure(items: [Str]): Int {
