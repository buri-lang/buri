fn g195_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g195_measure(items: [Str]): Int {
    items.length()
}

fn g195_step<C: Allocator>(ctx: C, acc: G195Acc, i: Int): G195Acc {
