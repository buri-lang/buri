from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g195_measure(items: [Int]): Int {
    items.length()
}

fn g195_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let items = acc;
    let held = items;
    let seen = g195_measure(held);
    held.push(ctx, i * 3 + 9 + seen % 7)
}

fn g195_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    g195_runLoop(ctx, acc, base, base + count)
}

fn g195_runLoop<C: Allocator>(ctx: C, acc: [Int], i: Int, end: Int): [Int] {
    if (i == end) { acc } else { g195_runLoop(ctx, g195_step(ctx, acc, i), i + 1, end) }
}

fn g195_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g195<C: Allocator>(ctx: C): Str {
    let acc = g195_run(ctx, list.empty<Int>(), 0, 400);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g195_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
