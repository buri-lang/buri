}

struct G195Outer {
    inner: G195Acc,
    k: Int,
}

fn g195_inner<C: Allocator>(ctx: C, acc: G195Acc, i: Int): G195Acc {
    let held = acc.items;
    let seen = g195_measure(held);
    G195Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g195_put(ctx, held, i * 3 + 3 + seen % 7, 0)
        } else {
            g195_put(ctx, held, i * 3 + 3 + seen % 7, 1)
        },
    }
}

fn g195_step<C: Allocator>(ctx: C, acc: G195Outer, i: Int): G195Outer {
    let held = acc.inner;
    G195Outer { ..acc, k: acc.k + 1, inner: g195_inner(ctx, held, i) }
}

fn g195_run<C: Allocator>(ctx: C, acc: G195Outer, base: Int, count: Int): G195Outer {
    g195_runLoop(ctx, acc, base, base + count)
}

fn g195_runLoop<C: Allocator>(ctx: C, acc: G195Outer, i: Int, end: Int): G195Outer {
    if (i == end) { acc } else { g195_runLoop(ctx, g195_step(ctx, acc, i), i + 1, end) }
}

fn g195_hash(items: [Str]): Int {
