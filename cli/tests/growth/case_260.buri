fn g260_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g260_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let items = acc;
    items.push(ctx, g260_pick(i * 3 + 1))
}

fn g260_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    if (count == 0) {
        acc
    } else {
        let acc = g260_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g260_step(ctx, acc, i)
    }
}

fn g260_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g260<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => g260_run(c, list.empty<Str>(), r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g260_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

