}

fn g260_measure(items: [G260Row]): Int {
    items.length()
}

fn g260_step<C: Allocator>(ctx: C, acc: [G260Row], i: Int): [G260Row] {
    let held = acc;
    let seen = g260_measure(held);
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g260_put(ctx, held, i * 3 + 9 + seen % 7, 0)
            } else {
                g260_put(ctx, held, i * 3 + 9 + seen % 7, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g260_put(ctx, held, i * 3 + 9 + seen % 7 + 1, 0)
            } else {
                g260_put(ctx, held, i * 3 + 9 + seen % 7 + 1, 1)
            }
        },
    }
}

fn g260_run<C: Allocator>(ctx: C, acc: [G260Row], base: Int, count: Int): [G260Row] {
    g260_runLoop(ctx, acc, base, base + count)
}

fn g260_runLoop<C: Allocator>(ctx: C, acc: [G260Row], i: Int, end: Int): [G260Row] {
    if (i == end) { acc } else { g260_runLoop(ctx, g260_step(ctx, acc, i), i + 1, end) }
}

fn g260_hash(items: [G260Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g260<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => g260_run(c, [], r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g260_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

