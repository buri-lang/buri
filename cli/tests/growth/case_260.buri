struct G260Row {
    id: Int,
    name: Str,
}

fn g260_put<C: Allocator>(ctx: C, items: [G260Row], code: Int, salt: Int): [G260Row] {
    let k = code + salt;
    if (k < 0) {
        items
    } else {
        items.push(ctx, G260Row { id: k, name: str.fromInt(ctx, k) })
