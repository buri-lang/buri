from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G260Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g260_step<C: Allocator>(ctx: C, acc: G260Acc, i: Int): G260Acc {
    let G260Acc { n, items, tag } = acc;
    G260Acc { n: n + 1, items: items.push(ctx, i * 3 + 1), tag }
}

fn g260_run<C: Allocator>(ctx: C, acc: G260Acc, base: Int, count: Int): G260Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g260_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g260_step(ctx, acc, i)
    }
}

fn g260_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g260<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g260_run(
                c,
                G260Acc { n: 0, items: list.empty<Int>(), tag: 42 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g260_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

