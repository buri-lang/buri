}

fn g257_step<C: Allocator>(ctx: C, acc: G257Outer, i: Int): G257Outer {
    if (acc.inner.items.length() >= 740) {
        acc
    } else {
        G257Outer { ..acc, k: acc.k + 1, inner: g257_inner(ctx, acc.inner, i) }
    }
}

fn g257_run<C: Allocator>(ctx: C, acc: G257Outer, base: Int, count: Int): G257Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g257_step(c, acc, i), acc)
}

fn g257_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g257<C: Allocator>(ctx: C): Str {
