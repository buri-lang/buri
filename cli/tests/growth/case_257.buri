fn g257_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g257_step<C: Allocator>(ctx: C, acc: G257Acc, i: Int): G257Acc {
    match (acc) {
        G257Acc { n, items, tag } => {
