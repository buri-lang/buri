            G257Acc { n: n + 1, items: g257_add(ctx, held, i * 7 + 8), tag }
        },
    }
}

fn g257_run<C: Allocator>(ctx: C, acc: G257Acc, base: Int, count: Int): G257Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g257_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g257_step(ctx, acc, i)
