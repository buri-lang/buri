from "platform/effect" import { Allocator };

struct G257Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g257_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

struct G257Outer {
    inner: G257Acc,
    k: Int,
}

fn g257_inner<C: Allocator>(ctx: C, acc: G257Acc, i: Int): G257Acc {
