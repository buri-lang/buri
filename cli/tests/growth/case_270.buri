    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

struct G270Outer {
    inner: G270Acc,
    k: Int,
}

fn g270_inner<C: Allocator>(ctx: C, acc: G270Acc, i: Int): G270Acc {
    let seen = g270_survey(acc.items) + g270_survey(acc.items);
    G270Acc {
        ..acc,
        n: acc.n + 1,
        items: g270_add(ctx, acc.items, i * 1 + 7 + seen % 7),
