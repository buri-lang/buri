from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G270Row {
    id: Int,
    name: Str,
}

struct G270Pair {
    items: [G270Row],
    also: [Int],
    n: Int,
}

fn g270_survey(items: [G270Row]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g270_step<C: Allocator>(ctx: C, acc: G270Pair, i: Int): G270Pair {
    let seen = g270_survey(acc.items) + g270_survey(acc.items);
    G270Pair {
        ..acc,
        n: acc.n + 1,
        items: acc
            .items
            .push(ctx, G270Row {
                id: i * 1 + 7 + seen % 7,
                name: str.fromInt(ctx, i * 1 + 7 + seen % 7),
            }),
        also: acc.also.push(ctx, i),
    }
}

fn g270_run<C: Allocator>(ctx: C, acc: G270Pair, base: Int, count: Int): G270Pair {
    g270_runLoop(ctx, acc, base, base + count)
}

fn g270_runLoop<C: Allocator>(ctx: C, acc: G270Pair, i: Int, end: Int): G270Pair {
    if (i == end) { acc } else { g270_runLoop(ctx, g270_step(ctx, acc, i), i + 1, end) }
}

fn g270_hash(items: [G270Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g270<C: Allocator>(ctx: C): Str {
    let acc = g270_run(ctx, G270Pair { items: [], also: [], n: 0 }, 0, 800);
    let first = match (acc.items.first()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let hash = g270_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.also.length()} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

