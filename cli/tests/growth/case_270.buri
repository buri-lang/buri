}

fn g270_step<C: Allocator>(ctx: C, acc: G270Outer, i: Int): G270Outer {
    G270Outer { ..acc, k: acc.k + 1, inner: g270_inner(ctx, acc.inner, i) }
}

fn g270_run<C: Allocator>(ctx: C, acc: G270Outer, base: Int, count: Int): G270Outer {
    g270_runLoop(ctx, acc, base, base + count)
}

fn g270_runLoop<C: Allocator>(ctx: C, acc: G270Outer, i: Int, end: Int): G270Outer {
