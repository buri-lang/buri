fn g270_add<C: Allocator>(ctx: C, items: [G270Row], code: Int): [G270Row] {
    items.push(ctx, G270Row { id: code, name: str.fromInt(ctx, code) })
}

fn g270_survey(items: [G270Row]): Int {
