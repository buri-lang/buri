    (acc.0 + 1, g270_add(ctx, acc.1, i * 1 + 7 + seen % 7))
}

fn g270_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
