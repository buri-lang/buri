from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G270Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g270_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g270_measure(items: [Int]): Int {
    items.length()
}

fn g270_step<C: Allocator>(ctx: C, acc: G270Acc, i: Int): G270Acc {
    let G270Acc { n, items, tag } = acc;
    let seen = g270_measure(items);
    G270Acc { n: n + 1, items: g270_add(ctx, items, i * 1 + 5 + seen % 7), tag }
}

fn g270_run<C: Allocator>(ctx: C, acc: G270Acc, base: Int, count: Int): G270Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g270_step(c, acc, i), acc)
}

fn g270_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g270<C: Allocator>(ctx: C): Str {
    let acc = g270_run(
        ctx,
        G270Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        400,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g270_hash(acc.items);
