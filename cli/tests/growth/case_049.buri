from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G049Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g049_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g049_measure(items: [Int]): Int {
    items.length()
}

fn g049_step<C: Allocator>(ctx: C, acc: G049Acc, i: Int): G049Acc {
    let held = acc.items;
    let seen = g049_measure(held);
    G049Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g049_put(ctx, held, i * 7 + 9 + seen % 7, 0)
        } else {
            g049_put(ctx, held, i * 7 + 9 + seen % 7, 1)
        },
    }
}

fn g049_run<C: Allocator>(ctx: C, acc: G049Acc, base: Int, count: Int): G049Acc {
    g049_runLoop(ctx, acc, base, base + count)
}

fn g049_runLoop<C: Allocator>(ctx: C, acc: G049Acc, i: Int, end: Int): G049Acc {
    if (i == end) { acc } else { g049_runLoop(ctx, g049_step(ctx, acc, i), i + 1, end) }
}

fn g049_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g049<C: Allocator>(ctx: C): Str {
    let mid = g049_run(
        ctx,
        G049Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        400,
    );
    let acc = g049_run(ctx, mid, 400, 400);
    let kept = g049_hash(mid.items);
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g049_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
