fn g180_step<C: Allocator>(ctx: C, acc: G180Outer, i: Int): G180Outer {
    let G180Outer { inner, k } = acc;
    let held = inner;
    G180Outer { inner: g180_inner(ctx, held, i), k: k + 1 }
