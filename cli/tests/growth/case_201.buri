fn g201_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g201_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g201_pick(k)) }
}

fn g201_run<C: Allocator>(ctx: C, acc: G201Acc, base: Int, count: Int): G201Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(
            ctx,
            fn(c, acc: G201Acc, i) => {
                let held = acc.items;
                G201Acc {
                    ..acc,
                    n: acc.n + 1,
                    items: if (i % 2 == 0) {
                        g201_put(c, held, i * 7 + 2, 0)
                    } else {
                        g201_put(c, held, i * 7 + 2, 1)
                    },
                }
            },
            acc,
        )
}

fn g201_hash(items: Str): Int {
    g201_walk(items, 0, 7)
}

fn g201_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g201_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
