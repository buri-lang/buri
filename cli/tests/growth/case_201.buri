struct G201Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g201_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

struct G201Outer {
    inner: G201Acc,
    k: Int,
}

fn g201_inner<C: Allocator>(ctx: C, acc: G201Acc, i: Int): G201Acc {
    let held = acc.items;
    G201Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g201_put(ctx, held, i * 7 + 2, 0)
        } else {
            g201_put(ctx, held, i * 7 + 2, 1)
        },
    }
}

fn g201_run<C: Allocator>(ctx: C, acc: G201Outer, base: Int, count: Int): G201Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(
            ctx,
            fn(c, acc: G201Outer, i) => {
                let held = acc.inner;
                G201Outer { ..acc, k: acc.k + 1, inner: g201_inner(c, held, i) }
            },
            acc,
        )
}

fn g201_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g201<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => {
            g201_run(
                c,
                G201Outer {
                    inner: G201Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                    k: 0,
                },
                r * 50,
                50,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.inner.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g201_hash(acc.inner.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
