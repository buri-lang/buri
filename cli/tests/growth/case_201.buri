        .None => h,
    }
}

fn g201<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => {
            g201_run(c, G201Acc { n: 0, items: "", tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g201_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

