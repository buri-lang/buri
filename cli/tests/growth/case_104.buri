from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g104_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g104_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let held = acc.1;
    let seen = held.length();
    (
        acc.0 + 1,
        if (i % 2 == 0) {
            g104_put(ctx, held, i * 3 + 4 + seen % 7, 0)
        } else {
            g104_put(ctx, held, i * 3 + 4 + seen % 7, 1)
        },
    )
}

fn g104_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    g104_runLoop(ctx, acc, base, base + count)
}

fn g104_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): (Int, [Str]) {
    if (i == end) { acc } else { g104_runLoop(ctx, g104_step(ctx, acc, i), i + 1, end) }
}

fn g104_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g104<C: Allocator>(ctx: C): Str {
    let mid = g104_run(ctx, (0, list.empty<Str>()), 0, 200);
    let acc = g104_run(ctx, mid, 200, 200);
    let kept = g104_hash(mid.1);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g104_hash(acc.1);
    str.format(
        ctx,
        "${acc.0} ${acc.1.length()} ${first} ${last} ${hash} | ${mid.1.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g104(host.alloc)).ignore();
    .Ok(())
