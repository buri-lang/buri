from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G104Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g104_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g104_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g104_pick(code))
}

fn g104_measure(items: [Str]): Int {
    items.length()
}

fn g104_step<C: Allocator>(ctx: C, acc: G104Acc, i: Int): G104Acc {
    let held = acc.items;
    let seen = g104_measure(held);
    G104Acc { ..acc, n: acc.n + 1, items: g104_add(ctx, held, i * 1 + 1 + seen % 7) }
}

fn g104_run<C: Allocator>(ctx: C, acc: G104Acc, base: Int, count: Int): G104Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g104_step(c, acc, i), acc)
}

fn g104_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g104<C: Allocator>(ctx: C): Str {
    let acc = g104_run(
        ctx,
        G104Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        600,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
