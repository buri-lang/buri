from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G104Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g104_measure(items: [Str]): Int {
    items.length()
}

fn g104_step<C: Allocator>(ctx: C, acc: G104Acc, i: Int): G104Acc {
    let held = acc.items;
    let seen = g104_measure(held);
    G104Acc {
        ..acc,
        n: acc.n + 1,
        items: held
            .push(ctx, str.fromInt(ctx, i * 3 + 4 + seen % 7))
            .push(ctx, str.fromInt(ctx, i * 3 + 4 + seen % 7 + 1)),
    }
}

fn g104_run<C: Allocator>(ctx: C, acc: G104Acc, base: Int, count: Int): G104Acc {
    g104_runLoop(ctx, acc, base, base + count)
}

fn g104_runLoop<C: Allocator>(ctx: C, acc: G104Acc, i: Int, end: Int): G104Acc {
    if (i == end) { acc } else { g104_runLoop(ctx, g104_step(ctx, acc, i), i + 1, end) }
}

fn g104_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g104<C: Allocator>(ctx: C): Str {
    let mid = g104_run(
        ctx,
        G104Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        200,
    );
    let acc = g104_run(ctx, mid, 200, 200);
    let kept = g104_hash(mid.items);
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g104_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g104(host.alloc)).ignore();
    .Ok(())
}
