from "platform/effect" import { Allocator };

fn g104_measure(items: [Str]): Int {
    items.length()
}

fn g104_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let held = acc.1;
    let seen = g104_measure(held);
    (
        acc.0 + 1,
        held
            .push(ctx, str.fromInt(ctx, i * 3 + 4 + seen % 7))
            .push(ctx, str.fromInt(ctx, i * 3 + 4 + seen % 7 + 1)),
    )
}

fn g104_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    g104_runLoop(ctx, acc, base, base + count)
}

fn g104_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): (Int, [Str]) {
    if (i == end) { acc } else { g104_runLoop(ctx, g104_step(ctx, acc, i), i + 1, end) }
}

fn g104_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g104<C: Allocator>(ctx: C): Str {
    let mid = g104_run(ctx, (0, list.empty<Str>()), 0, 200);
    let acc = g104_run(ctx, mid, 200, 200);
    let kept = g104_hash(mid.1);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
