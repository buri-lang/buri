struct G104Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g104_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g104_step<C: Allocator>(ctx: C, acc: G104Acc, i: Int): G104Acc {
    let held = acc.items;
    let seen = held.length();
    G104Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g104_put(ctx, held, i * 3 + 4 + seen % 7, 0)
        } else {
            g104_put(ctx, held, i * 3 + 4 + seen % 7, 1)
        },
    }
}

fn g104_run<C: Allocator>(ctx: C, acc: G104Acc, base: Int, count: Int): G104Acc {
    g104_runLoop(ctx, acc, base, base + count)
}

fn g104_runLoop<C: Allocator>(ctx: C, acc: G104Acc, i: Int, end: Int): G104Acc {
    if (i == end) { acc } else { g104_runLoop(ctx, g104_step(ctx, acc, i), i + 1, end) }
}

fn g104_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g104<C: Allocator>(ctx: C): Str {
    let mid = g104_run(
        ctx,
        G104Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        200,
    );
    let acc = g104_run(ctx, mid, 200, 200);
    let kept = g104_hash(mid.items);
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g104_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

