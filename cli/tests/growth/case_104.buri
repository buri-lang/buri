from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G104Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g104_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g104_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g104_pick(code))
}

fn g104_measure(items: Str): Int {
    items.length()
}

struct G104Outer {
    inner: G104Acc,
    k: Int,
}

fn g104_inner<C: Allocator>(ctx: C, acc: G104Acc, i: Int): G104Acc {
    let held = acc.items;
    let seen = g104_measure(held);
    G104Acc { ..acc, n: acc.n + 1, items: g104_add(ctx, held, i * 1 + 1 + seen % 7) }
}

fn g104_step<C: Allocator>(ctx: C, acc: G104Outer, i: Int): G104Outer {
    let held = acc.inner;
    G104Outer { ..acc, k: acc.k + 1, inner: g104_inner(ctx, held, i) }
}

fn g104_run<C: Allocator>(ctx: C, acc: G104Outer, base: Int, count: Int): G104Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g104_step(c, acc, i), acc)
}

fn g104_hash(items: Str): Int {
    g104_walk(items, 0, 7)
}

fn g104_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g104_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g104<C: Allocator>(ctx: C): Str {
    let acc = g104_run(
        ctx,
        G104Outer { inner: G104Acc { n: 0, items: "", tag: 42 }, k: 0 },
        0,
        600,
    );
    let size = acc.inner.items.length();
    let first = acc.inner.items.slice(0, 8);
    let last = acc.inner.items.slice(size - 8, size);
    let hash = g104_hash(acc.inner.items);
    str.format(
        ctx,
        "${acc.k} ${acc
            .inner
            .n} ${acc.inner.tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g104(host.alloc)).ignore();
    .Ok(())
