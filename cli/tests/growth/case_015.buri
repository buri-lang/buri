fn g015_measure(items: [Int]): Int {
    items.length()
}

fn g015_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    match (acc) {
        (n, items) => {
            let held = items;
            let seen = g015_measure(held);
