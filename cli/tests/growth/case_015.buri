from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G015Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g015_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g015_step<C: Allocator>(ctx: C, acc: G015Acc, i: Int): G015Acc {
    G015Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g015_put(ctx, acc.items, i * 1 + 7, 0)
        } else {
            g015_put(ctx, acc.items, i * 1 + 7, 1)
        },
    }
}

fn g015_run<C: Allocator>(ctx: C, acc: G015Acc, base: Int, count: Int): G015Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g015_step(c, acc, i), acc)
}

fn g015_rounds<C: Allocator>(ctx: C, acc: G015Acc, base: Int, count: Int): G015Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g015_run(c, acc, i * 50, 50), acc)
}

fn g015_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g015<C: Allocator>(ctx: C): Str {
    let acc = g015_rounds(
        ctx,
        G015Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        16,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g015_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g015(host.alloc)).ignore();
    .Ok(())
}
