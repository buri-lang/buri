from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G015Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g015_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g015_survey(items: [Int]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g015_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g015_step<C: Allocator>(ctx: C, acc: G015Acc, i: Int): Result<G015Acc, Str> {
    let q = g015_gate(i)?;
    let G015Acc { n, items, tag } = acc;
    let seen = g015_survey(items) + g015_survey(items);
    .Ok(G015Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g015_put(ctx, items, i * 3 + 1 + seen % 7 + q, 0)
        } else {
            g015_put(ctx, items, i * 3 + 1 + seen % 7 + q, 1)
        },
        tag,
    })
}

fn g015_run<C: Allocator>(
    ctx: C,
    acc: G015Acc,
    base: Int,
    count: Int,
): Result<G015Acc, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g015_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g015_step(ctx, acc, i)
    }
}

fn g015_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g015<C: Allocator>(ctx: C): Str {
    match (g015_run(ctx, G015Acc { n: 0, items: list.empty<Int>(), tag: 42 }, 0, 600)) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.items.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g015_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g015(host.alloc)).ignore();
    .Ok(())
}
