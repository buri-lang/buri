fn g015_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    if (count == 0) {
        acc
    } else {
        let acc = g015_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g015_step(ctx, acc, i)
    }
}

fn g015_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    g015_roundsLoop(ctx, acc, base, base + count)
}

fn g015_roundsLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
    end: Int,
): (Int, [Int]) {
    if (i == end) {
        acc
    } else {
        g015_roundsLoop(ctx, g015_run(ctx, acc, i * 150, 150), i + 1, end)
