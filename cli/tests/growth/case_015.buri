fn g015_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g015<C: Allocator>(ctx: C): Str {
    match (
        g015_rounds(
            ctx,
            G015Outer {
                inner: G015Acc { n: 0, items: list.empty<Str>(), tag: 42 },
