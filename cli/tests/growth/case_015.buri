        G015Acc { n, items, tag } => {
            let seen = items.length();
            .Ok(G015Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g015_put(ctx, items, i * 1 + 2 + seen % 7 + q, 0)
