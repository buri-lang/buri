}

fn g015_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g015<C: Allocator>(ctx: C): Str {
    let acc = g015_rounds(ctx, (0, list.empty<Int>()), 0, 16);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => -1,
    };
