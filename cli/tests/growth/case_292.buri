from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G292Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g292_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g292_step<C: Allocator>(ctx: C, acc: G292Acc, i: Int): G292Acc {
    let held = acc.items;
    G292Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g292_put(ctx, held, i * 1 + 4, 0)
        } else {
            g292_put(ctx, held, i * 1 + 4, 1)
        },
    }
}

fn g292_run<C: Allocator>(ctx: C, acc: G292Acc, base: Int, count: Int): G292Acc {
    g292_runLoop(ctx, acc, base, base + count)
}

fn g292_runLoop<C: Allocator>(ctx: C, acc: G292Acc, i: Int, end: Int): G292Acc {
    if (i == end) { acc } else { g292_runLoop(ctx, g292_step(ctx, acc, i), i + 1, end) }
}

fn g292_rounds<C: Allocator>(ctx: C, acc: G292Acc, base: Int, count: Int): G292Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g292_run(c, acc, i * 50, 50), acc)
}

fn g292_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g292<C: Allocator>(ctx: C): Str {
    let acc = g292_rounds(
        ctx,
        G292Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        4,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g292_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
