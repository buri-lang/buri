from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G264Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g264_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g264_measure(items: Str): Int {
    items.length()
}

struct G264Outer {
    inner: G264Acc,
    k: Int,
}

fn g264_inner<C: Allocator>(ctx: C, acc: G264Acc, i: Int): G264Acc {
    let seen = g264_measure(acc.items);
    G264Acc {
        ..acc,
        n: acc.n + 1,
        items: acc.items.concat(ctx, g264_pick(i * 1 + 8 + seen % 7)),
    }
}

fn g264_step<C: Allocator>(ctx: C, acc: G264Outer, i: Int): G264Outer {
    G264Outer { ..acc, k: acc.k + 1, inner: g264_inner(ctx, acc.inner, i) }
}

fn g264_run<C: Allocator>(ctx: C, acc: G264Outer, base: Int, count: Int): G264Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g264_step(c, acc, i), acc)
}

fn g264_hash(items: Str): Int {
    g264_walk(items, 0, 7)
}

fn g264_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g264_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g264<C: Allocator>(ctx: C): Str {
    let acc = g264_run(
        ctx,
        G264Outer { inner: G264Acc { n: 0, items: "", tag: 42 }, k: 0 },
        0,
        400,
    );
    let size = acc.inner.items.length();
    let first = acc.inner.items.slice(0, 8);
    let last = acc.inner.items.slice(size - 8, size);
    let hash = g264_hash(acc.inner.items);
    str.format(
        ctx,
        "${acc.k} ${acc
            .inner
            .n} ${acc.inner.tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g264(host.alloc)).ignore();
    .Ok(())
}
