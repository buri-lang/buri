from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g264_measure(items: [Int]): Int {
    items.length()
}

fn g264_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let seen = g264_measure(acc);
    acc.push(ctx, i * 1 + 8 + seen % 7)
}

fn g264_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g264_step(c, acc, i), acc)
}

fn g264_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g264<C: Allocator>(ctx: C): Str {
    let acc = g264_run(ctx, list.empty<Int>(), 0, 400);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g264_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g264(host.alloc)).ignore();
    .Ok(())
}
