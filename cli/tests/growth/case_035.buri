fn g035_put<C: Allocator>(ctx: C, items: [G035Row], code: Int, salt: Int): [G035Row] {
    let k = code + salt;
    if (k < 0) {
        items
    } else {
        items.push(ctx, G035Row { id: k, name: str.fromInt(ctx, k) })
