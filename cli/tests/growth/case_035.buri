fn g035_gate(i: Int): Result<Int, Str> {
    if (i == 1001) { .Err("bad") } else { .Ok(i % 5) }
}

fn g035_step<C: Allocator>(ctx: C, acc: G035Acc, i: Int): Result<G035Acc, Str> {
    let q = g035_gate(i)?;
    match (acc) {
        G035Acc { n, items, tag } => {
            let held = items;
            .Ok(G035Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g035_put(ctx, held, i * 3 + 9 + q, 0)
                } else {
                    g035_put(ctx, held, i * 3 + 9 + q, 1)
                },
                tag,
            })
        },
    }
}

fn g035_run<C: Allocator>(
    ctx: C,
    acc: G035Acc,
    base: Int,
    count: Int,
): Result<G035Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g035_step(c, acc, i), acc)
