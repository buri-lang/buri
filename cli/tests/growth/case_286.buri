from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G286Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g286_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g286_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g286_pick(k)) }
}

fn g286_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g286_step<C: Allocator>(ctx: C, acc: G286Acc, i: Int): G286Acc {
    let G286Acc { n, items, tag } = acc;
    let held = items;
    let seen = g286_survey(held) + g286_survey(held);
    G286Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g286_put(ctx, held, i * 3 + 9 + seen % 7, 0)
        } else {
            g286_put(ctx, held, i * 3 + 9 + seen % 7, 1)
        },
        tag,
    }
}

fn g286_run<C: Allocator>(ctx: C, acc: G286Acc, base: Int, count: Int): G286Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g286_step(c, acc, i), acc)
}

fn g286_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g286<C: Allocator>(ctx: C): Str {
    let mid = g286_run(
        ctx,
        G286Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        500,
    );
    let acc = g286_run(ctx, mid, 500, 500);
    let kept = g286_hash(mid.items);
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g286_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g286(host.alloc)).ignore();
    .Ok(())
