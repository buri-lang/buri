}

fn g301_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let seen = g301_measure(acc);
    acc.push(ctx, i * 7 + 9 + seen % 7)
}

fn g301_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
