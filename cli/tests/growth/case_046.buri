from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g046_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g046_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g046_pick(k)) }
}

fn g046_gate(i: Int): Result<Int, Str> {
    if (i == 201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g046_step<C: Allocator>(ctx: C, acc: Str, i: Int): Result<Str, Str> {
    let q = g046_gate(i)?;
    let seen = acc.length();
    .Ok(if (i % 2 == 0) {
        g046_put(ctx, acc, i * 3 + 2 + seen % 7 + q, 0)
    } else {
        g046_put(ctx, acc, i * 3 + 2 + seen % 7 + q, 1)
    })
}

fn g046_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Result<Str, Str> {
    g046_runLoop(ctx, acc, base, base + count)
}

fn g046_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Result<Str, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g046_runLoop(ctx, g046_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g046_hash(items: Str): Int {
    g046_walk(items, 0, 7)
}

fn g046_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g046_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g046<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => g046_run(c, "", r * 50, 50));
    let lengths = all.fold(
        fn(t, got) => {
            t
                + match (got) {
                    .Ok(acc) => acc.length(),
                    .Err(_e) => -1,
                }
        },
        0,
    );
    let hashes = all.fold(
        fn(t, got) => {
            match (got) {
                .Ok(acc) => (t + g046_hash(acc)) % 1000003,
                .Err(_e) => t,
            }
        },
        0,
    );
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g046(host.alloc)).ignore();
    .Ok(())
}
