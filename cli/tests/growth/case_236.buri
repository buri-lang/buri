fn g236_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g236_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
