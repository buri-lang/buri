fn g141_inner<C: Allocator>(ctx: C, acc: G141Acc, i: Int): Result<G141Acc, Str> {
    let q = g141_gate(i)?;
    let G141Acc { n, items, tag } = acc;
    let held = items;
    let seen = held.length();
    .Ok(G141Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g141_put(ctx, held, i * 1 + 8 + seen % 7 + q, 0)
        } else {
            g141_put(ctx, held, i * 1 + 8 + seen % 7 + q, 1)
        },
        tag,
    })
}

fn g141_step<C: Allocator>(ctx: C, acc: G141Outer, i: Int): Result<G141Outer, Str> {
    let G141Outer { inner, k } = acc;
    let held = inner;
    .Ok(G141Outer { inner: g141_inner(ctx, held, i)?, k: k + 1 })
