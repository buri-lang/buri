from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g141_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g141_gate(i: Int): Result<Int, Str> {
    if (i == 801) { .Err("bad") } else { .Ok(i % 5) }
}

fn g141_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
): Result<(Int, [Str]), Str> {
    let q = g141_gate(i)?;
    let (n, items) = acc;
    let held = items;
    let seen = held.length();
    .Ok(
        (
            n + 1,
            if (i % 2 == 0) {
                g141_put(ctx, held, i * 1 + 8 + seen % 7 + q, 0)
            } else {
                g141_put(ctx, held, i * 1 + 8 + seen % 7 + q, 1)
            },
        ),
    )
}

fn g141_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    g141_runLoop(ctx, acc, base, base + count)
}

fn g141_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): Result<(Int, [Str]), Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g141_runLoop(ctx, g141_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g141_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    g141_roundsLoop(ctx, acc, base, base + count)
}

fn g141_roundsLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): Result<(Int, [Str]), Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g141_roundsLoop(ctx, g141_run(ctx, acc, i * 100, 100)?, i + 1, end)
    }
}

fn g141_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g141<C: Allocator>(ctx: C): Str {
    match (g141_rounds(ctx, (0, list.empty<Str>()), 0, 8)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g141_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g141(host.alloc)).ignore();
    .Ok(())
}
