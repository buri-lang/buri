}

fn g050_rounds<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    g050_roundsLoop(ctx, acc, base, base + count)
}

fn g050_roundsLoop<C: Allocator>(ctx: C, acc: [Str], i: Int, end: Int): [Str] {
