}

fn g050_run<C: Allocator>(ctx: C, acc: G050Outer, base: Int, count: Int): G050Outer {
    g050_runLoop(ctx, acc, base, base + count)
}

fn g050_runLoop<C: Allocator>(ctx: C, acc: G050Outer, i: Int, end: Int): G050Outer {
    if (i == end) { acc } else { g050_runLoop(ctx, g050_step(ctx, acc, i), i + 1, end) }
}

fn g050_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

