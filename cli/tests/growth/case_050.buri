    if (k < 0) { items } else { items.push(ctx, g050_pick(k)) }
}

fn g050_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let held = acc;
    let seen = held.length();
    if (i % 2 == 0) {
        g050_put(ctx, held, i * 3 + 2 + seen % 7, 0)
    } else {
        g050_put(ctx, held, i * 3 + 2 + seen % 7, 1)
    }
}

fn g050_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    if (count == 0) {
        acc
    } else {
        let acc = g050_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g050_step(ctx, acc, i)
