fn g102_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g102_step<C: Allocator>(ctx: C, acc: G102Acc, i: Int): G102Acc {
    let held = acc.items;
    G102Acc { ..acc, n: acc.n + 1, items: g102_add(ctx, held, i * 3 + 3) }
}

fn g102_run<C: Allocator>(ctx: C, acc: G102Acc, base: Int, count: Int): G102Acc {
    g102_runLoop(ctx, acc, base, base + count)
}

fn g102_runLoop<C: Allocator>(ctx: C, acc: G102Acc, i: Int, end: Int): G102Acc {
    if (i == end) { acc } else { g102_runLoop(ctx, g102_step(ctx, acc, i), i + 1, end) }
}

fn g102_rounds<C: Allocator>(ctx: C, acc: G102Acc, base: Int, count: Int): G102Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g102_run(c, acc, i * 150, 150), acc)
}

fn g102_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

