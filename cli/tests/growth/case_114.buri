}

fn g114_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g114_pick(code))
}

fn g114_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): (Int, Str) {
    let seen = acc.1.length();
    (acc.0 + 1, g114_add(ctx, acc.1, i * 3 + 7 + seen % 7))
}

fn g114_run<C: Allocator>(ctx: C, acc: (Int, Str), base: Int, count: Int): (Int, Str) {
    g114_runLoop(ctx, acc, base, base + count)
}

fn g114_runLoop<C: Allocator>(ctx: C, acc: (Int, Str), i: Int, end: Int): (Int, Str) {
    if (i == end) { acc } else { g114_runLoop(ctx, g114_step(ctx, acc, i), i + 1, end) }
}

fn g114_hash(items: Str): Int {
    g114_walk(items, 0, 7)
}

fn g114_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g114_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
