}

fn g114<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => g114_run(c, (0, ""), r * 50, 50));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g114_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

