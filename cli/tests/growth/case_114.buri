fn g114_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g114_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g114_pick(k)) }
}

fn g114_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): (Int, Str) {
    let held = acc.1;
    (
        acc.0 + 1,
        if (i % 2 == 0) {
            g114_put(ctx, held, i * 1 + 7, 0)
        } else {
            g114_put(ctx, held, i * 1 + 7, 1)
        },
    )
}

fn g114_run<C: Allocator>(ctx: C, acc: (Int, Str), base: Int, count: Int): (Int, Str) {
    if (count == 0) {
        acc
    } else {
        let acc = g114_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        if (acc.1.length() >= 77) { acc } else { g114_step(ctx, acc, i) }
    }
}

fn g114_hash(items: Str): Int {
    g114_walk(items, 0, 7)
}

fn g114_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g114_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
