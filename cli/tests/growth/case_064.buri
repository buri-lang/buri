fn g064_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g064_gate(i: Int): Result<Int, Str> {
    if (i == 595) { .Err("bad") } else { .Ok(i % 5) }
}

fn g064_step<C: Allocator>(ctx: C, acc: G064Acc, i: Int): Result<G064Acc, Str> {
    let q = g064_gate(i)?;
    let G064Acc { n, items, tag } = acc;
    let held = items;
    .Ok(G064Acc { n: n + 1, items: held.concat(ctx, g064_pick(i * 7 + 1 + q)), tag })
}

fn g064_run<C: Allocator>(
    ctx: C,
    acc: G064Acc,
    base: Int,
    count: Int,
): Result<G064Acc, Str> {
    g064_runLoop(ctx, acc, base, base + count)
}

fn g064_runLoop<C: Allocator>(
    ctx: C,
    acc: G064Acc,
    i: Int,
    end: Int,
): Result<G064Acc, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g064_runLoop(ctx, g064_step(ctx, acc, i)?, i + 1, end)
