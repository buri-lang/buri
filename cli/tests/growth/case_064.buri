from "platform/effect" import { Allocator };

struct G064Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g064_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g064_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g064_step<C: Allocator>(ctx: C, acc: G064Acc, i: Int): G064Acc {
    match (acc) {
        G064Acc { n, items, tag } => {
            let seen = g064_survey(items) + g064_survey(items);
            G064Acc {
                n: n + 1,
                items: items.push(ctx, g064_pick(i * 1 + 8 + seen % 7)),
                tag,
            }
        },
    }
}

fn g064_run<C: Allocator>(ctx: C, acc: G064Acc, base: Int, count: Int): G064Acc {
    g064_runLoop(ctx, acc, base, base + count)
}

fn g064_runLoop<C: Allocator>(ctx: C, acc: G064Acc, i: Int, end: Int): G064Acc {
    if (i == end) { acc } else { g064_runLoop(ctx, g064_step(ctx, acc, i), i + 1, end) }
}

fn g064_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g064<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g064_run(
                c,
                G064Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 150,
                150,
