        .None => h,
    }
}

fn g064<C: Allocator>(ctx: C): Str {
    match (g064_run(ctx, G064Acc { n: 0, items: "", tag: 42 }, 0, 1000)) {
        .Ok(acc) => {
            let size = acc.items.length();
            let first = acc.items.slice(0, 8);
            let last = acc.items.slice(size - 8, size);
