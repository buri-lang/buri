fn g064_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g064_step<C: Allocator>(ctx: C, acc: G064Acc, i: Int): G064Acc {
    let G064Acc { n, items, tag } = acc;
    let held = items;
    let probe = fn() => held.length();
    let seen = probe();
    G064Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g064_put(ctx, held, i * 3 + 5 + seen % 7, 0)
        } else {
            g064_put(ctx, held, i * 3 + 5 + seen % 7, 1)
        },
        tag,
    }
}

fn g064_run<C: Allocator>(ctx: C, acc: G064Acc, base: Int, count: Int): G064Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g064_step(c, acc, i), acc)
}

fn g064_rounds<C: Allocator>(ctx: C, acc: G064Acc, base: Int, count: Int): G064Acc {
    g064_roundsLoop(ctx, acc, base, base + count)
}

fn g064_roundsLoop<C: Allocator>(ctx: C, acc: G064Acc, i: Int, end: Int): G064Acc {
