    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

struct G193Outer {
    inner: G193Acc,
    k: Int,
}

fn g193_inner<C: Allocator>(ctx: C, acc: G193Acc, i: Int): G193Acc {
    match (acc) {
        G193Acc { n, items, tag } => {
            let held = items;
            let seen = g193_survey(held) + g193_survey(held);
            G193Acc { n: n + 1, items: g193_add(ctx, held, i * 3 + 7 + seen % 7), tag }
        },
    }
}

fn g193_step<C: Allocator>(ctx: C, acc: G193Outer, i: Int): G193Outer {
    match (acc) {
        G193Outer { inner, k } => {
            let held = inner;
            G193Outer { inner: g193_inner(ctx, held, i), k: k + 1 }
        },
    }
}

fn g193_run<C: Allocator>(ctx: C, acc: G193Outer, base: Int, count: Int): G193Outer {
    if (count == 0) {
        acc
