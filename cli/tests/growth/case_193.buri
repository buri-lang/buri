struct G193Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g193_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g193_survey(items: [Str]): Int {
