fn g193_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g193_survey(items: [Int]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g193_step<C: Allocator>(ctx: C, acc: G193Acc, i: Int): G193Acc {
    match (acc) {
        G193Acc { n, items, tag } => {
            let held = items;
            let seen = g193_survey(held) + g193_survey(held);
            G193Acc { n: n + 1, items: g193_add(ctx, held, i * 3 + 7 + seen % 7), tag }
        },
    }
}

fn g193_run<C: Allocator>(ctx: C, acc: G193Acc, base: Int, count: Int): G193Acc {
    if (count == 0) {
        acc
