from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g199_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let held = acc.1;
    let seen = held.length();
    (acc.0 + 1, held.push(ctx, i * 1 + 7 + seen % 7))
}

fn g199_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g199_step(c, acc, i), acc)
}

fn g199_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g199<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g199_run(c, (0, list.empty<Int>()), r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g199_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g199(host.alloc)).ignore();
    .Ok(())
}
