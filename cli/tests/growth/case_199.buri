        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g199_step(c, acc, i), acc)
}

fn g199_hash(items: Str): Int {
    g199_walk(items, 0, 7)
}

fn g199_walk(text: Str, at: Int, h: Int): Int {
