fn g232_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g232_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g232_pick(code))
}

fn g232_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    match (acc) {
        (n, items) => {
            let held = items;
            (n + 1, g232_add(ctx, held, i * 3 + 9))
        },
    }
}

fn g232_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    if (count == 0) {
        acc
    } else {
        let acc = g232_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g232_step(ctx, acc, i)
    }
}

fn g232_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g232_run(c, acc, i * 50, 50), acc)
}

fn g232_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g232<C: Allocator>(ctx: C): Str {
    let acc = g232_rounds(ctx, (0, list.empty<Str>()), 0, 4);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g232_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g232(host.alloc)).ignore();
    .Ok(())
