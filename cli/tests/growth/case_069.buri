from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G069Row {
    id: Int,
    name: Str,
}

enum G069Box {
    Full(Int, [G069Row]),
    Empty,
}

impl G069Box {
    fn count(self): Int {
        match (self) {
            .Full(n, _items) => n,
            .Empty => -1,
        }
    }

    fn items(self): [G069Row] {
        match (self) {
            .Full(_n, items) => items,
            .Empty => [],
        }
    }
}

fn g069_measure(items: [G069Row]): Int {
    items.length()
}

fn g069_step<C: Allocator>(ctx: C, acc: G069Box, i: Int): G069Box {
    match (acc) {
        .Full(n, items) => {
            let seen = g069_measure(items);
            G069Box.Full(
                n + 1,
                items.push(ctx, G069Row {
                    id: i * 7 + 9 + seen % 7,
                    name: str.fromInt(ctx, i * 7 + 9 + seen % 7),
                }),
            )
        },
        .Empty => G069Box.Empty,
    }
}

fn g069_run<C: Allocator>(ctx: C, acc: G069Box, base: Int, count: Int): G069Box {
    if (count == 0) {
        acc
    } else {
        let acc = g069_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g069_step(ctx, acc, i)
    }
}

fn g069_rounds<C: Allocator>(ctx: C, acc: G069Box, base: Int, count: Int): G069Box {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g069_run(c, acc, i * 100, 100), acc)
}

fn g069_hash(items: [G069Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g069<C: Allocator>(ctx: C): Str {
    let acc = g069_rounds(ctx, G069Box.Full(0, []), 0, 4);
    let first = match (acc.items().first()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let last = match (acc.items().last()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let hash = g069_hash(acc.items());
    str.format(ctx, "${acc.count()} ${acc.items().length()} ${first} ${last} ${hash}")
}

