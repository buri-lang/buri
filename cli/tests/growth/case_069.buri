fn g069_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g069_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g069_pick(code))
}

fn g069_step<C: Allocator>(ctx: C, acc: G069Acc, i: Int): G069Acc {
    let held = acc.items;
    G069Acc { ..acc, n: acc.n + 1, items: g069_add(ctx, held, i * 3 + 8) }
}

fn g069_run<C: Allocator>(ctx: C, acc: G069Acc, base: Int, count: Int): G069Acc {
    g069_runLoop(ctx, acc, base, base + count)
}

fn g069_runLoop<C: Allocator>(ctx: C, acc: G069Acc, i: Int, end: Int): G069Acc {
    if (i == end || acc.items.length() >= 756) {
        acc
    } else {
        g069_runLoop(ctx, g069_step(ctx, acc, i), i + 1, end)
    }
}

fn g069_hash(items: Str): Int {
    g069_walk(items, 0, 7)
}

fn g069_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g069_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
