from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G069Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g069_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g069_step<C: Allocator>(ctx: C, acc: G069Acc, i: Int): G069Acc {
    let held = acc.items;
    let seen = held.length();
    G069Acc { ..acc, n: acc.n + 1, items: g069_add(ctx, held, i * 1 + 9 + seen % 7) }
}

fn g069_run<C: Allocator>(ctx: C, acc: G069Acc, base: Int, count: Int): G069Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g069_step(c, acc, i), acc)
}

fn g069_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g069<C: Allocator>(ctx: C): Str {
    let acc = g069_run(
        ctx,
        G069Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        600,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g069_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g069(host.alloc)).ignore();
    .Ok(())
}
