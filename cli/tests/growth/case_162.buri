}

fn g162_hash(items: Str): Int {
    g162_walk(items, 0, 7)
}

fn g162_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g162_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g162<C: Allocator>(ctx: C): Str {
    let acc = g162_rounds(ctx, "", 0, 8);
    let size = acc.length();
    let first = acc.slice(0, 8);
    let last = acc.slice(size - 8, size);
    let hash = g162_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

