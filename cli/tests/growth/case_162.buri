fn g162_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g162<C: Allocator>(ctx: C): Str {
    let acc = g162_rounds(
        ctx,
        G162Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
