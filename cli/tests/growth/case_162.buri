fn g162_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g162_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g162_pick(k)) }
}

fn g162_measure(items: [Str]): Int {
    items.length()
}

fn g162_step<C: Allocator>(ctx: C, acc: G162Acc, i: Int): G162Acc {
    let G162Acc { n, items, tag } = acc;
    let held = items;
    let seen = g162_measure(held);
    G162Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g162_put(ctx, held, i * 3 + 8 + seen % 7, 0)
        } else {
            g162_put(ctx, held, i * 3 + 8 + seen % 7, 1)
        },
        tag,
    }
}

fn g162_run<C: Allocator>(ctx: C, acc: G162Acc, base: Int, count: Int): G162Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g162_step(c, acc, i), acc)
}

fn g162_rounds<C: Allocator>(ctx: C, acc: G162Acc, base: Int, count: Int): G162Acc {
    g162_roundsLoop(ctx, acc, base, base + count)
}

fn g162_roundsLoop<C: Allocator>(ctx: C, acc: G162Acc, i: Int, end: Int): G162Acc {
