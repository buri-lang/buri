fn g103_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g103_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g103_pick(k)) }
}

fn g103_gate(i: Int): Result<Int, Str> {
    if (i == 220) { .Err("bad") } else { .Ok(i % 5) }
}

fn g103_step<C: Allocator>(ctx: C, acc: G103Box, i: Int): Result<G103Box, Str> {
    let q = g103_gate(i)?;
    match (acc) {
        .Full(n, items) => {
