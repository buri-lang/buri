    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g103_gate(i: Int): Result<Int, Str> {
    if (i == 220) { .Err("bad") } else { .Ok(i % 5) }
}

fn g103_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
): Result<(Int, [Str]), Str> {
    let q = g103_gate(i)?;
    let (n, items) = acc;
    .Ok(
        (
            n + 1,
            if (i % 2 == 0) {
                g103_put(ctx, items, i * 7 + 6 + q, 0)
            } else {
                g103_put(ctx, items, i * 7 + 6 + q, 1)
            },
        ),
    )
}

fn g103_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g103_step(c, acc, i), acc)
}

fn g103_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g103_run(c, acc, i * 50, 50), acc)
