fn g103_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g103<C: Allocator>(ctx: C): Str {
    match (g103_rounds(ctx, (0, list.empty<Str>()), 0, 8)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g103_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
