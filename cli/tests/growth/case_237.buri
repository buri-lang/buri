from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G237Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g237_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g237_survey(items: [Int]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g237_step<C: Allocator>(ctx: C, acc: G237Acc, i: Int): G237Acc {
    let held = acc.items;
    let seen = g237_survey(held) + g237_survey(held);
    G237Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g237_put(ctx, held, i * 3 + 5 + seen % 7, 0)
        } else {
            g237_put(ctx, held, i * 3 + 5 + seen % 7, 1)
        },
    }
}

fn g237_run<C: Allocator>(ctx: C, acc: G237Acc, base: Int, count: Int): G237Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g237_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g237_step(ctx, acc, i)
    }
}

fn g237_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g237<C: Allocator>(ctx: C): Str {
    let acc = g237_run(
        ctx,
        G237Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        800,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g237_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g237(host.alloc)).ignore();
    .Ok(())
}
