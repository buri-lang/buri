fn g153_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g153_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let held = acc.1;
    let seen = held.length();
    (
        acc.0 + 1,
        if (i % 2 == 0) {
            g153_put(ctx, held, i * 3 + 5 + seen % 7, 0)
        } else {
            g153_put(ctx, held, i * 3 + 5 + seen % 7, 1)
        },
    )
}

fn g153_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    if (count == 0) {
        acc
    } else {
        let acc = g153_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g153_step(ctx, acc, i)
    }
}

fn g153_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g153_run(c, acc, i * 50, 50), acc)
}

fn g153_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g153<C: Allocator>(ctx: C): Str {
    let acc = g153_rounds(ctx, (0, list.empty<Str>()), 0, 4);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g153_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g153(host.alloc)).ignore();
    .Ok(())
