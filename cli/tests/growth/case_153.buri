}

fn g153_run<C: Allocator>(ctx: C, acc: G153Acc, base: Int, count: Int): G153Acc {
    g153_runLoop(ctx, acc, base, base + count)
}

fn g153_runLoop<C: Allocator>(ctx: C, acc: G153Acc, i: Int, end: Int): G153Acc {
    if (i == end) { acc } else { g153_runLoop(ctx, g153_step(ctx, acc, i), i + 1, end) }
}

fn g153_hash(items: Str): Int {
