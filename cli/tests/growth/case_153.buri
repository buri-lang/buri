struct G153Row {
    id: Int,
    name: Str,
}

fn g153_put<C: Allocator>(ctx: C, items: [G153Row], code: Int, salt: Int): [G153Row] {
    let k = code + salt;
    if (k < 0) {
        items
    } else {
        items.push(ctx, G153Row { id: k, name: str.fromInt(ctx, k) })
    }
}

fn g153_step<C: Allocator>(ctx: C, acc: (Int, [G153Row]), i: Int): (Int, [G153Row]) {
    let held = acc.1;
    let seen = held.length();
    (
        acc.0 + 1,
        if (i % 2 == 0) {
            g153_put(ctx, held, i * 3 + 5 + seen % 7, 0)
        } else {
            g153_put(ctx, held, i * 3 + 5 + seen % 7, 1)
        },
    )
}

fn g153_run<C: Allocator>(
    ctx: C,
    acc: (Int, [G153Row]),
    base: Int,
    count: Int,
): (Int, [G153Row]) {
    if (count == 0) {
        acc
    } else {
        let acc = g153_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g153_step(ctx, acc, i)
    }
}

fn g153_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [G153Row]),
    base: Int,
    count: Int,
): (Int, [G153Row]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g153_run(c, acc, i * 50, 50), acc)
}

fn g153_hash(items: [G153Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g153<C: Allocator>(ctx: C): Str {
    let acc = g153_rounds(ctx, (0, []), 0, 4);
    let first = match (acc.1.first()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let hash = g153_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

