struct G153Row {
    id: Int,
    name: Str,
}

fn g153_survey(items: [G153Row]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g153_step<C: Allocator>(ctx: C, acc: (Int, [G153Row]), i: Int): (Int, [G153Row]) {
    let held = acc.1;
    let seen = g153_survey(held) + g153_survey(held);
    (
        acc.0 + 1,
        held
            .push(ctx, G153Row {
                id: i * 3 + 5 + seen % 7,
                name: str.fromInt(ctx, i * 3 + 5 + seen % 7),
            })
            .push(ctx, G153Row {
                id: i * 3 + 5 + seen % 7 + 1,
                name: str.fromInt(ctx, i * 3 + 5 + seen % 7 + 1),
            }),
    )
}

fn g153_run<C: Allocator>(
    ctx: C,
    acc: (Int, [G153Row]),
    base: Int,
    count: Int,
): (Int, [G153Row]) {
    if (count == 0) {
        acc
    } else {
        let acc = g153_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g153_step(ctx, acc, i)
    }
}

fn g153_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [G153Row]),
    base: Int,
    count: Int,
): (Int, [G153Row]) {
