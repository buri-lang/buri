fn g024_hash(items: Str): Int {
    g024_walk(items, 0, 7)
}

fn g024_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g024_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
