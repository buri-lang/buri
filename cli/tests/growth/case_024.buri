}

fn g024_hash(items: Str): Int {
    g024_walk(items, 0, 7)
}

fn g024_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g024_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g024<C: Allocator>(ctx: C): Str {
    match (g024_rounds(ctx, "", 0, 16)) {
        .Ok(acc) => {
            let size = acc.length();
            let first = acc.slice(0, 8);
            let last = acc.slice(size - 8, size);
