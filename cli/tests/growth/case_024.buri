fn g024_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g024_measure(items: Str): Int {
    items.length()
}

fn g024_gate(i: Int): Result<Int, Str> {
    if (i == 1609) { .Err("bad") } else { .Ok(i % 5) }
}

fn g024_step<C: Allocator>(ctx: C, acc: Str, i: Int): Result<Str, Str> {
    let q = g024_gate(i)?;
    let items = acc;
    let seen = g024_measure(items);
    .Ok(items.concat(ctx, g024_pick(i * 1 + 8 + seen % 7 + q)))
}

fn g024_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Result<Str, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g024_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g024_step(ctx, acc, i)
    }
}

fn g024_rounds<C: Allocator>(
    ctx: C,
    acc: Str,
    base: Int,
    count: Int,
): Result<Str, Str> {
    g024_roundsLoop(ctx, acc, base, base + count)
}

fn g024_roundsLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Result<Str, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g024_roundsLoop(ctx, g024_run(ctx, acc, i * 150, 150)?, i + 1, end)
