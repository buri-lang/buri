from "platform/effect" import { Allocator };

struct G240Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g240_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g240_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g240_step<C: Allocator>(ctx: C, acc: G240Acc, i: Int): G240Acc {
    let G240Acc { n, items, tag } = acc;
    let held = items;
    let seen = g240_survey(held) + g240_survey(held);
    G240Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g240_put(ctx, held, i * 1 + 0 + seen % 7, 0)
        } else {
            g240_put(ctx, held, i * 1 + 0 + seen % 7, 1)
        },
        tag,
    }
}

fn g240_run<C: Allocator>(ctx: C, acc: G240Acc, base: Int, count: Int): G240Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g240_step(c, acc, i), acc)
}

fn g240_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g240<C: Allocator>(ctx: C): Str {
    let acc = g240_run(
        ctx,
        G240Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        1000,
