fn g252_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g252_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g252_pick(code))
}

fn g252_survey(items: Str): Int {
