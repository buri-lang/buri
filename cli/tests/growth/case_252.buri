    let seen = g252_survey(held) + g252_survey(held);
    G252Acc { ..acc, n: acc.n + 1, items: g252_add(ctx, held, i * 3 + 5 + seen % 7) }
}

fn g252_step<C: Allocator>(ctx: C, acc: G252Outer, i: Int): G252Outer {
    let held = acc.inner;
    G252Outer { ..acc, k: acc.k + 1, inner: g252_inner(ctx, held, i) }
}

fn g252_run<C: Allocator>(ctx: C, acc: G252Outer, base: Int, count: Int): G252Outer {
    g252_runLoop(ctx, acc, base, base + count)
}

fn g252_runLoop<C: Allocator>(ctx: C, acc: G252Outer, i: Int, end: Int): G252Outer {
