from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G164Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g164_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g164_gate(i: Int): Result<Int, Str> {
    if (i == 333) { .Err("bad") } else { .Ok(i % 5) }
}

fn g164_step<C: Allocator>(ctx: C, acc: G164Acc, i: Int): Result<G164Acc, Str> {
    let q = g164_gate(i)?;
    let held = acc.items;
    .Ok(G164Acc { ..acc, n: acc.n + 1, items: g164_add(ctx, held, i * 1 + 3 + q) })
}

fn g164_run<C: Allocator>(
    ctx: C,
    acc: G164Acc,
    base: Int,
    count: Int,
): Result<G164Acc, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g164_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g164_step(ctx, acc, i)
    }
}

fn g164_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g164<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => {
            g164_run(
                c,
                G164Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(
        fn(t, got) => {
            t
                + match (got) {
                    .Ok(acc) => acc.items.length(),
                    .Err(_e) => -1,
                }
        },
        0,
    );
    let hashes = all.fold(
        fn(t, got) => {
            match (got) {
                .Ok(acc) => (t + g164_hash(acc.items)) % 1000003,
                .Err(_e) => t,
            }
        },
        0,
    );
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g164(host.alloc)).ignore();
    .Ok(())
}
