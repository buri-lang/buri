from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G152Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g152_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g152_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g152_pick(code))
}

fn g152_measure(items: Str): Int {
    items.length()
}

struct G152Outer {
    inner: G152Acc,
    k: Int,
}

fn g152_inner<C: Allocator>(ctx: C, acc: G152Acc, i: Int): G152Acc {
    let seen = g152_measure(acc.items);
    G152Acc {
        ..acc,
        n: acc.n + 1,
        items: g152_add(ctx, acc.items, i * 1 + 6 + seen % 7),
    }
}

fn g152_step<C: Allocator>(ctx: C, acc: G152Outer, i: Int): G152Outer {
    G152Outer { ..acc, k: acc.k + 1, inner: g152_inner(ctx, acc.inner, i) }
}

fn g152_run<C: Allocator>(ctx: C, acc: G152Outer, base: Int, count: Int): G152Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g152_step(c, acc, i), acc)
}

fn g152_hash(items: Str): Int {
    g152_walk(items, 0, 7)
}

fn g152_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g152_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g152<C: Allocator>(ctx: C): Str {
    let acc = g152_run(
        ctx,
        G152Outer { inner: G152Acc { n: 0, items: "", tag: 42 }, k: 0 },
        0,
        600,
    );
    let size = acc.inner.items.length();
    let first = acc.inner.items.slice(0, 8);
    let last = acc.inner.items.slice(size - 8, size);
    let hash = g152_hash(acc.inner.items);
    str.format(
        ctx,
        "${acc.k} ${acc
            .inner
            .n} ${acc.inner.tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
