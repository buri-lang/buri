fn g152_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g152_measure(items: Str): Int {
    items.length()
}

fn g152_step<C: Allocator>(ctx: C, acc: G152Pair, i: Int): G152Pair {
    let seen = g152_measure(acc.items);
    G152Pair {
        ..acc,
        n: acc.n + 1,
        items: acc.items.concat(ctx, g152_pick(i * 1 + 6 + seen % 7)),
        also: acc.also.push(ctx, i),
    }
}

fn g152_run<C: Allocator>(ctx: C, acc: G152Pair, base: Int, count: Int): G152Pair {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g152_step(c, acc, i), acc)
}

fn g152_hash(items: Str): Int {
    g152_walk(items, 0, 7)
}

fn g152_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g152_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
