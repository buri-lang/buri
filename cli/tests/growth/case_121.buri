fn g121_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g121_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g121_pick(k)) }
}

fn g121_measure(items: [Str]): Int {
    items.length()
}

fn g121_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let (n, items) = acc;
    let held = items;
    let seen = g121_measure(held);
    (
        n + 1,
        if (i % 2 == 0) {
            g121_put(ctx, held, i * 7 + 5 + seen % 7, 0)
        } else {
            g121_put(ctx, held, i * 7 + 5 + seen % 7, 1)
        },
    )
}

fn g121_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g121_step(c, acc, i), acc)
}

fn g121_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g121<C: Allocator>(ctx: C): Str {
    let mid = g121_run(ctx, (0, list.empty<Str>()), 0, 500);
    let acc = g121_run(ctx, mid, 500, 500);
    let kept = g121_hash(mid.1);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g121_hash(acc.1);
    str.format(
        ctx,
        "${acc.0} ${acc.1.length()} ${first} ${last} ${hash} | ${mid.1.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g121(host.alloc)).ignore();
