from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G121Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g121_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g121_measure(items: [Int]): Int {
    items.length()
}

fn g121_step<C: Allocator>(ctx: C, acc: G121Acc, i: Int): G121Acc {
    let G121Acc { n, items, tag } = acc;
    let held = items;
    let seen = g121_measure(held);
    G121Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g121_put(ctx, held, i * 7 + 5 + seen % 7, 0)
        } else {
            g121_put(ctx, held, i * 7 + 5 + seen % 7, 1)
        },
        tag,
    }
}

fn g121_run<C: Allocator>(ctx: C, acc: G121Acc, base: Int, count: Int): G121Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g121_step(c, acc, i), acc)
}

fn g121_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g121<C: Allocator>(ctx: C): Str {
    let mid = g121_run(
        ctx,
        G121Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        500,
    );
    let acc = g121_run(ctx, mid, 500, 500);
    let kept = g121_hash(mid.items);
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g121_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g121(host.alloc)).ignore();
    .Ok(())
}
