fn g121_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g121_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g121_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let (n, items) = acc;
    let held = items;
    let seen = g121_survey(held) + g121_survey(held);
    (
        n + 1,
        held
            .push(ctx, g121_pick(i * 7 + 5 + seen % 7))
            .push(ctx, g121_pick(i * 7 + 5 + seen % 7 + 1)),
    )
}

fn g121_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
