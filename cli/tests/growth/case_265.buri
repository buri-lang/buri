from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G265Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g265_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g265_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g265_pick(k)) }
}

fn g265_step<C: Allocator>(ctx: C, acc: G265Acc, i: Int): G265Acc {
    match (acc) {
        G265Acc { n, items, tag } => {
            let seen = items.length();
            G265Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g265_put(ctx, items, i * 3 + 4 + seen % 7, 0)
                } else {
                    g265_put(ctx, items, i * 3 + 4 + seen % 7, 1)
                },
                tag,
            }
        },
    }
}

fn g265_run<C: Allocator>(ctx: C, acc: G265Acc, base: Int, count: Int): G265Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g265_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g265_step(ctx, acc, i)
    }
}

fn g265_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g265<C: Allocator>(ctx: C): Str {
    let acc = g265_run(
        ctx,
        G265Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        400,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g265_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
