fn g265_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g265_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g265_pick(k)) }
}

fn g265_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let seen = acc.length();
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g265_put(ctx, acc, i * 3 + 4 + seen % 7, 0)
            } else {
                g265_put(ctx, acc, i * 3 + 4 + seen % 7, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g265_put(ctx, acc, i * 3 + 4 + seen % 7 + 1, 0)
            } else {
                g265_put(ctx, acc, i * 3 + 4 + seen % 7 + 1, 1)
            }
        },
    }
}

fn g265_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    if (count == 0) {
        acc
    } else {
        let acc = g265_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g265_step(ctx, acc, i)
    }
}

fn g265_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g265<C: Allocator>(ctx: C): Str {
    let acc = g265_run(ctx, list.empty<Str>(), 0, 400);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g265_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

