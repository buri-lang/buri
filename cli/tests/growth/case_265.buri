from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G265Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g265_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g265_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g265_pick(k)) }
}

fn g265_step<C: Allocator>(ctx: C, acc: G265Acc, i: Int): G265Acc {
    let seen = acc.items.length();
    G265Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g265_put(ctx, acc.items, i * 3 + 0 + seen % 7, 0)
        } else {
            g265_put(ctx, acc.items, i * 3 + 0 + seen % 7, 1)
        },
    }
}

fn g265_run<C: Allocator>(ctx: C, acc: G265Acc, base: Int, count: Int): G265Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g265_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g265_step(ctx, acc, i)
    }
}

fn g265_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g265<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g265_run(
                c,
                G265Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g265_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g265(host.alloc)).ignore();
    .Ok(())
}
