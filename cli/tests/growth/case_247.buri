from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G247Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g247_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g247_step<C: Allocator>(ctx: C, acc: G247Acc, i: Int): G247Acc {
    let G247Acc { n, items, tag } = acc;
    let held = items;
    G247Acc { n: n + 1, items: g247_add(ctx, held, i * 1 + 2), tag }
}

fn g247_run<C: Allocator>(ctx: C, acc: G247Acc, base: Int, count: Int): G247Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g247_step(c, acc, i), acc)
}

fn g247_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g247<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g247_run(
                c,
                G247Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 100,
                100,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g247_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g247(host.alloc)).ignore();
    .Ok(())
}
