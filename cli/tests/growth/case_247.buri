fn g247_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g247_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g247_step<C: Allocator>(ctx: C, acc: G247Acc, i: Int): G247Acc {
    match (acc) {
        G247Acc { n, items, tag } => {
            let seen = g247_survey(items) + g247_survey(items);
            G247Acc { n: n + 1, items: g247_add(ctx, items, i * 1 + 1 + seen % 7), tag }
        },
    }
}

fn g247_run<C: Allocator>(ctx: C, acc: G247Acc, base: Int, count: Int): G247Acc {
    if (count == 0) {
        acc
