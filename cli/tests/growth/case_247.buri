}

fn g247_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let items = acc;
    let held = items;
    g247_add(ctx, held, i * 1 + 2)
}

fn g247_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
