        let acc = g247_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        if (acc.items.length() >= 805) { acc } else { g247_step(ctx, acc, i) }
    }
}

fn g247_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g247<C: Allocator>(ctx: C): Str {
    let mid = g247_run(
        ctx,
        G247Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        500,
