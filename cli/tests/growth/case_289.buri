from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G289Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g289_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g289_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g289_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g289_step<C: Allocator>(ctx: C, acc: G289Acc, i: Int): Result<G289Acc, Str> {
    let q = g289_gate(i)?;
    let G289Acc { n, items, tag } = acc;
    let seen = g289_survey(items) + g289_survey(items);
    .Ok(G289Acc {
        n: n + 1,
        items: items.concat(ctx, g289_pick(i * 1 + 2 + seen % 7 + q)),
        tag,
    })
}

fn g289_run<C: Allocator>(
    ctx: C,
    acc: G289Acc,
    base: Int,
    count: Int,
): Result<G289Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g289_step(c, acc, i), acc)
}

fn g289_hash(items: Str): Int {
    g289_walk(items, 0, 7)
}

fn g289_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g289_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g289<C: Allocator>(ctx: C): Str {
    match (g289_run(ctx, G289Acc { n: 0, items: "", tag: 42 }, 0, 600)) {
        .Ok(acc) => {
            let size = acc.items.length();
            let first = acc.items.slice(0, 8);
            let last = acc.items.slice(size - 8, size);
            let hash = g289_hash(acc.items);
            str.format(
