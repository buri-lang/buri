from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g287_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g287_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g287_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    let seen = g287_survey(held) + g287_survey(held);
    held.concat(ctx, g287_pick(i * 7 + 0 + seen % 7))
}

fn g287_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g287_runLoop(ctx, acc, base, base + count)
}

fn g287_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end) { acc } else { g287_runLoop(ctx, g287_step(ctx, acc, i), i + 1, end) }
}

fn g287_hash(items: Str): Int {
    g287_walk(items, 0, 7)
}

fn g287_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g287_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g287<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g287_run(c, "", r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g287_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g287(host.alloc)).ignore();
    .Ok(())
}
