}

fn g161_rounds<C: Allocator>(ctx: C, acc: G161Acc, base: Int, count: Int): G161Acc {
    g161_roundsLoop(ctx, acc, base, base + count)
}

fn g161_roundsLoop<C: Allocator>(ctx: C, acc: G161Acc, i: Int, end: Int): G161Acc {
