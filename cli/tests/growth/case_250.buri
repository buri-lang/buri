from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g250_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g250_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    (
        acc.0 + 1,
        if (i % 2 == 0) {
            g250_put(ctx, acc.1, i * 7 + 0, 0)
        } else {
            g250_put(ctx, acc.1, i * 7 + 0, 1)
        },
    )
}

fn g250_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g250_step(c, acc, i), acc)
}

fn g250_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g250<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g250_run(c, (0, list.empty<Int>()), r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g250_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g250(host.alloc)).ignore();
    .Ok(())
}
