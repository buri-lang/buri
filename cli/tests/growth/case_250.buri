from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G250Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g250_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g250_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g250_pick(k)) }
}

struct G250Outer {
    inner: G250Acc,
    k: Int,
}

fn g250_inner<C: Allocator>(ctx: C, acc: G250Acc, i: Int): G250Acc {
    G250Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g250_put(ctx, acc.items, i * 7 + 0, 0)
        } else {
            g250_put(ctx, acc.items, i * 7 + 0, 1)
        },
    }
}

fn g250_step<C: Allocator>(ctx: C, acc: G250Outer, i: Int): G250Outer {
    G250Outer { ..acc, k: acc.k + 1, inner: g250_inner(ctx, acc.inner, i) }
}

fn g250_run<C: Allocator>(ctx: C, acc: G250Outer, base: Int, count: Int): G250Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g250_step(c, acc, i), acc)
}

fn g250_hash(items: Str): Int {
    g250_walk(items, 0, 7)
}

fn g250_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g250_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g250<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g250_run(
                c,
                G250Outer { inner: G250Acc { n: 0, items: "", tag: 42 }, k: 0 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.inner.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g250_hash(acc.inner.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g250(host.alloc)).ignore();
    .Ok(())
}
