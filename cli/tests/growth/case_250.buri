from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G250Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g250_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g250_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g250_pick(code))
}

fn g250_gate(i: Int): Result<Int, Str> {
    if (i == 529) { .Err("bad") } else { .Ok(i % 5) }
}

struct G250Outer {
    inner: G250Acc,
    k: Int,
}

fn g250_inner<C: Allocator>(ctx: C, acc: G250Acc, i: Int): Result<G250Acc, Str> {
    let q = g250_gate(i)?;
    match (acc) {
        G250Acc { n, items, tag } => {
            let held = items;
            let seen = held.length();
            .Ok(G250Acc {
                n: n + 1,
                items: g250_add(ctx, held, i * 3 + 8 + seen % 7 + q),
                tag,
            })
        },
    }
}

fn g250_step<C: Allocator>(ctx: C, acc: G250Outer, i: Int): Result<G250Outer, Str> {
    match (acc) {
        G250Outer { inner, k } => {
            let held = inner;
            .Ok(G250Outer { inner: g250_inner(ctx, held, i)?, k: k + 1 })
        },
    }
}

fn g250_run<C: Allocator>(
    ctx: C,
    acc: G250Outer,
    base: Int,
    count: Int,
): Result<G250Outer, Str> {
    g250_runLoop(ctx, acc, base, base + count)
}

fn g250_runLoop<C: Allocator>(
    ctx: C,
    acc: G250Outer,
    i: Int,
    end: Int,
): Result<G250Outer, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g250_runLoop(ctx, g250_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g250_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g250<C: Allocator>(ctx: C): Str {
    match (
        g250_run(
            ctx,
            G250Outer {
                inner: G250Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                k: 0,
