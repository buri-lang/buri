// Generated by `cli/tests/native/growth/generator.rs`; do not edit.
// value=Text acc=Tuple access=Match pusher=Large reader=Small alias=false inner=Fold outer=None nest=None stop=false fail=holds
// expect: 800 1498 abbbbacc bbabbbba 561329
// blocks: 32
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g148_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g148_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g148_pick(k)) }
}

fn g148_measure(items: Str): Int {
    items.length()
}

fn g148_gate(i: Int): Result<Int, Str> {
    if (i == 801) { .Err("bad") } else { .Ok(i % 5) }
}

fn g148_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): Result<(Int, Str), Str> {
    let q = g148_gate(i)?;
    match (acc) {
        (n, items) => {
            let seen = g148_measure(items);
            .Ok(
                (
                    n + 1,
                    if (i % 2 == 0) {
                        g148_put(ctx, items, i * 1 + 6 + seen % 7 + q, 0)
                    } else {
                        g148_put(ctx, items, i * 1 + 6 + seen % 7 + q, 1)
                    },
                ),
            )
        },
    }
}

fn g148_run<C: Allocator>(
    ctx: C,
    acc: (Int, Str),
    base: Int,
    count: Int,
): Result<(Int, Str), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g148_step(c, acc, i), acc)
}

fn g148_hash(items: Str): Int {
    g148_walk(items, 0, 7)
}

fn g148_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g148_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g148<C: Allocator>(ctx: C): Str {
    match (g148_run(ctx, (0, ""), 0, 800)) {
        .Ok(acc) => {
            let size = acc.1.length();
            let first = acc.1.slice(0, 8);
            let last = acc.1.slice(size - 8, size);
            let hash = g148_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g148(host.alloc)).ignore();
    .Ok(())
}
