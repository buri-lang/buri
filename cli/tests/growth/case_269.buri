    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g269_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc
            .also
            .length()} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

