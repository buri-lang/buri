}

fn g269_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g269_step<C: Allocator>(ctx: C, acc: G269Pair, i: Int): G269Pair {
    match (acc) {
        G269Pair { items, also, n } => {
            let held = items;
            G269Pair {
                items: if (i % 2 == 0) {
                    g269_put(ctx, held, i * 1 + 2, 0)
                } else {
                    g269_put(ctx, held, i * 1 + 2, 1)
                },
                also: also.push(ctx, i),
                n: n + 1,
            }
        },
    }
}

fn g269_run<C: Allocator>(ctx: C, acc: G269Pair, base: Int, count: Int): G269Pair {
    if (count == 0) {
        acc
    } else {
        let acc = g269_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g269_step(ctx, acc, i)
    }
}

fn g269_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g269<C: Allocator>(ctx: C): Str {
    let mid = g269_run(
        ctx,
        G269Pair { items: list.empty<Str>(), also: [], n: 0 },
        0,
        400,
