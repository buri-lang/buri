from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G285Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g285_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g285_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g285_step<C: Allocator>(ctx: C, acc: G285Acc, i: Int): G285Acc {
    if (acc.items.length() >= 455) {
        acc
    } else {
        let G285Acc { n, items, tag } = acc;
        let held = items;
        let seen = g285_survey(held) + g285_survey(held);
        G285Acc {
            n: n + 1,
            items: held.push(ctx, g285_pick(i * 3 + 4 + seen % 7)),
            tag,
        }
    }
}

fn g285_run<C: Allocator>(ctx: C, acc: G285Acc, base: Int, count: Int): G285Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g285_step(c, acc, i), acc)
}

fn g285_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g285<C: Allocator>(ctx: C): Str {
    let acc = g285_run(
        ctx,
        G285Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        1000,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g285_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g285(host.alloc)).ignore();
    .Ok(())
}
