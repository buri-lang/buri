                n: n + 1,
                items: held.concat(ctx, g224_pick(i * 7 + 2 + seen % 7)),
                tag,
            }
        },
    }
}

fn g224_run<C: Allocator>(ctx: C, acc: G224Acc, base: Int, count: Int): G224Acc {
    g224_runLoop(ctx, acc, base, base + count)
}

fn g224_runLoop<C: Allocator>(ctx: C, acc: G224Acc, i: Int, end: Int): G224Acc {
    if (i == end) { acc } else { g224_runLoop(ctx, g224_step(ctx, acc, i), i + 1, end) }
}

fn g224_hash(items: Str): Int {
    g224_walk(items, 0, 7)
}

fn g224_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g224_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
