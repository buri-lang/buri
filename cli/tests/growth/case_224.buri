from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G224Row {
    id: Int,
    name: Str,
}

fn g224_put<C: Allocator>(ctx: C, items: [G224Row], code: Int, salt: Int): [G224Row] {
    let k = code + salt;
    if (k < 0) {
        items
    } else {
        items.push(ctx, G224Row { id: k, name: str.fromInt(ctx, k) })
    }
}

fn g224_measure(items: [G224Row]): Int {
    items.length()
}

fn g224_gate(i: Int): Result<Int, Str> {
    if (i == 801) { .Err("bad") } else { .Ok(i % 5) }
}

fn g224_run<C: Allocator>(
    ctx: C,
    acc: [G224Row],
    base: Int,
    count: Int,
): Result<[G224Row], Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
            ctx,
            fn(c, acc: [G224Row], i) => {
                let q = g224_gate(i)?;
                let items = acc;
                let seen = g224_measure(items);
                .Ok(if (i % 2 == 0) {
                    g224_put(c, items, i * 3 + 1 + seen % 7 + q, 0)
                } else {
                    g224_put(c, items, i * 3 + 1 + seen % 7 + q, 1)
                })
            },
            acc,
        )
}

fn g224_hash(items: [G224Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g224<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => g224_run(c, [], r * 100, 100));
    let lengths = all.fold(
        fn(t, got) => {
            t
                + match (got) {
                    .Ok(acc) => acc.length(),
                    .Err(_e) => -1,
                }
        },
        0,
    );
    let hashes = all.fold(
        fn(t, got) => {
            match (got) {
                .Ok(acc) => (t + g224_hash(acc)) % 1000003,
                .Err(_e) => t,
            }
        },
        0,
    );
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g224(host.alloc)).ignore();
