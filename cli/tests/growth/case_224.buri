fn g224_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g224_step<C: Allocator>(ctx: C, acc: G224Acc, i: Int): G224Acc {
    match (acc) {
        G224Acc { n, items, tag } => {
            let held = items;
            let seen = held.length();
