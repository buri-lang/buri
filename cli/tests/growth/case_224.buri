from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g224_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g224_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    let seen = held.length();
    match (i % 2) {
        0 => held.concat(ctx, g224_pick(i * 7 + 2 + seen % 7)),
        _ => held.concat(ctx, g224_pick(i * 7 + 2 + seen % 7 + 1)),
    }
}

fn g224_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g224_runLoop(ctx, acc, base, base + count)
}

fn g224_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end) { acc } else { g224_runLoop(ctx, g224_step(ctx, acc, i), i + 1, end) }
}

fn g224_hash(items: Str): Int {
    g224_walk(items, 0, 7)
}

fn g224_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g224_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g224<C: Allocator>(ctx: C): Str {
    let acc = g224_run(ctx, "", 0, 600);
    let size = acc.length();
    let first = acc.slice(0, 8);
    let last = acc.slice(size - 8, size);
    let hash = g224_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g224(host.alloc)).ignore();
    .Ok(())
}
