        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g200_step(c, acc, i), acc)
}

fn g200_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g200<C: Allocator>(ctx: C): Str {
    let acc = g200_run(ctx, list.empty<Int>(), 0, 600);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => -1,
