    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g200_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let seen = g200_survey(acc) + g200_survey(acc);
    if (i % 2 == 0) {
        g200_put(ctx, acc, i * 3 + 4 + seen % 7, 0)
    } else {
        g200_put(ctx, acc, i * 3 + 4 + seen % 7, 1)
    }
}

fn g200_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
