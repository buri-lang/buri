from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G200Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g200_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g200_survey(items: [Int]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g200_step<C: Allocator>(ctx: C, acc: G200Acc, i: Int): G200Acc {
    let seen = g200_survey(acc.items) + g200_survey(acc.items);
    G200Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g200_put(ctx, acc.items, i * 3 + 4 + seen % 7, 0)
        } else {
            g200_put(ctx, acc.items, i * 3 + 4 + seen % 7, 1)
        },
    }
}

fn g200_run<C: Allocator>(ctx: C, acc: G200Acc, base: Int, count: Int): G200Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g200_step(c, acc, i), acc)
}

fn g200_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g200<C: Allocator>(ctx: C): Str {
    let acc = g200_run(
        ctx,
        G200Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        600,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g200_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g200(host.alloc)).ignore();
    .Ok(())
}
