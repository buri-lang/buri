from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g200_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g200_measure(items: [Int]): Int {
    items.length()
}

fn g200_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let seen = g200_measure(acc);
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g200_put(ctx, acc, i * 3 + 5 + seen % 7, 0)
            } else {
                g200_put(ctx, acc, i * 3 + 5 + seen % 7, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g200_put(ctx, acc, i * 3 + 5 + seen % 7 + 1, 0)
            } else {
                g200_put(ctx, acc, i * 3 + 5 + seen % 7 + 1, 1)
            }
        },
    }
}

fn g200_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    g200_runLoop(ctx, acc, base, base + count)
}

fn g200_runLoop<C: Allocator>(ctx: C, acc: [Int], i: Int, end: Int): [Int] {
    if (i == end) { acc } else { g200_runLoop(ctx, g200_step(ctx, acc, i), i + 1, end) }
}

fn g200_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g200<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => g200_run(c, list.empty<Int>(), r * 50, 50));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g200_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g200(host.alloc)).ignore();
