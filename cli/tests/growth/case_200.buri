}

fn g200_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let seen = g200_survey(acc) + g200_survey(acc);
    match (i % 2) {
        0 => acc.concat(ctx, [i * 3 + 5 + seen % 7]),
        _ => acc.concat(ctx, [i * 3 + 5 + seen % 7 + 1]),
