fn g001_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g001_step<C: Allocator>(ctx: C, acc: G001Pair, i: Int): G001Pair {
