fn g001_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g001<C: Allocator>(ctx: C): Str {
    match (g001_rounds(ctx, list.empty<Str>(), 0, 16)) {
        .Ok(acc) => {
            let first = match (acc.first()) {
                .Some(x) => x,
                .None => "-",
