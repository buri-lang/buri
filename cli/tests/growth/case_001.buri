}

fn g001_run<C: Allocator>(ctx: C, acc: G001Pair, base: Int, count: Int): G001Pair {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g001_step(c, acc, i), acc)
}

fn g001_rounds<C: Allocator>(ctx: C, acc: G001Pair, base: Int, count: Int): G001Pair {
    if (count == 0) {
        acc
    } else {
        let acc = g001_rounds(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g001_run(ctx, acc, i * 100, 100)
