from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G075Pair {
    items: Str,
    also: [Int],
    n: Int,
}

fn g075_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g075_measure(items: Str): Int {
    items.length()
}

fn g075_step<C: Allocator>(ctx: C, acc: G075Pair, i: Int): G075Pair {
    if (acc.items.length() >= 892) {
        acc
    } else {
        let seen = g075_measure(acc.items);
        G075Pair {
            ..acc,
            n: acc.n + 1,
            items: acc.items.concat(ctx, g075_pick(i * 7 + 0 + seen % 7)),
            also: acc.also.push(ctx, i),
        }
    }
}

fn g075_run<C: Allocator>(ctx: C, acc: G075Pair, base: Int, count: Int): G075Pair {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g075_step(c, acc, i), acc)
}

fn g075_rounds<C: Allocator>(ctx: C, acc: G075Pair, base: Int, count: Int): G075Pair {
    if (count == 0) {
        acc
    } else {
        let acc = g075_rounds(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g075_run(ctx, acc, i * 100, 100)
    }
}

fn g075_hash(items: Str): Int {
    g075_walk(items, 0, 7)
}

fn g075_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g075_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g075<C: Allocator>(ctx: C): Str {
    let acc = g075_rounds(ctx, G075Pair { items: "", also: [], n: 0 }, 0, 16);
    let size = acc.items.length();
    let first = acc.items.slice(0, 8);
    let last = acc.items.slice(size - 8, size);
    let hash = g075_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.also.length()} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

