from "platform/effect" import { Allocator };

fn g143_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g143_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g143_pick(k)) }
}

fn g143_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g143_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
): Result<(Int, [Str]), Str> {
    let q = g143_gate(i)?;
    let held = acc.1;
    .Ok(
        (
            acc.0 + 1,
            if (i % 2 == 0) {
                g143_put(ctx, held, i * 1 + 6 + q, 0)
            } else {
                g143_put(ctx, held, i * 1 + 6 + q, 1)
            },
        ),
    )
}

fn g143_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g143_step(c, acc, i), acc)
}

fn g143_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g143_rounds(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g143_run(ctx, acc, i * 150, 150)
    }
}

fn g143_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g143<C: Allocator>(ctx: C): Str {
    match (g143_rounds(ctx, (0, list.empty<Str>()), 0, 4)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g143_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g143(host.alloc)).ignore();
    .Ok(())
