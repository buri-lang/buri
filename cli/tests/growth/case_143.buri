fn g143_rounds<C: Allocator>(
    ctx: C,
    acc: G143Outer,
    base: Int,
    count: Int,
): Result<G143Outer, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g143_rounds(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g143_run(ctx, acc, i * 150, 150)
