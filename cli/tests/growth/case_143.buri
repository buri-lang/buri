fn g143_inner<C: Allocator>(ctx: C, acc: G143Acc, i: Int): Result<G143Acc, Str> {
    let q = g143_gate(i)?;
    let held = acc.items;
    .Ok(G143Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g143_put(ctx, held, i * 1 + 6 + q, 0)
