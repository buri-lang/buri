}

fn g143_step<C: Allocator>(ctx: C, acc: G143Outer, i: Int): Result<G143Outer, Str> {
    let held = acc.inner;
    .Ok(G143Outer { ..acc, k: acc.k + 1, inner: g143_inner(ctx, held, i)? })
