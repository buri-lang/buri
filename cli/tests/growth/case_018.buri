from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g018_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g018_gate(i: Int): Result<Int, Str> {
    if (i == 401) { .Err("bad") } else { .Ok(i % 5) }
}

fn g018_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
): Result<(Int, [Int]), Str> {
    let q = g018_gate(i)?;
    let held = acc.1;
    .Ok(
        (
            acc.0 + 1,
            if (i % 2 == 0) {
                g018_put(ctx, held, i * 1 + 2 + q, 0)
            } else {
                g018_put(ctx, held, i * 1 + 2 + q, 1)
            },
        ),
    )
}

fn g018_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): Result<(Int, [Int]), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g018_step(c, acc, i), acc)
}

fn g018_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g018<C: Allocator>(ctx: C): Str {
    match (g018_run(ctx, (0, list.empty<Int>()), 0, 400)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g018_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g018(host.alloc)).ignore();
    .Ok(())
}
