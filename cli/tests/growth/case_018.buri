from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g018_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g018_survey(items: [Int]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g018_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g018_step<C: Allocator>(ctx: C, acc: [Int], i: Int): Result<[Int], Str> {
    let q = g018_gate(i)?;
    let held = acc;
    let seen = g018_survey(held) + g018_survey(held);
    .Ok(match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g018_put(ctx, held, i * 1 + 9 + seen % 7 + q, 0)
            } else {
                g018_put(ctx, held, i * 1 + 9 + seen % 7 + q, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g018_put(ctx, held, i * 1 + 9 + seen % 7 + q + 1, 0)
            } else {
                g018_put(ctx, held, i * 1 + 9 + seen % 7 + q + 1, 1)
            }
        },
    })
}

fn g018_run<C: Allocator>(
    ctx: C,
    acc: [Int],
    base: Int,
    count: Int,
): Result<[Int], Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g018_step(c, acc, i), acc)
}

fn g018_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g018<C: Allocator>(ctx: C): Str {
    match (g018_run(ctx, list.empty<Int>(), 0, 600)) {
        .Ok(acc) => {
            let first = match (acc.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g018_hash(acc);
            str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
