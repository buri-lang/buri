fn g154_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g154_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let (n, items) = acc;
    let seen = items.length();
    (
        n + 1,
        if (i % 2 == 0) {
            g154_put(ctx, items, i * 7 + 5 + seen % 7, 0)
        } else {
            g154_put(ctx, items, i * 7 + 5 + seen % 7, 1)
        },
    )
}

fn g154_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    g154_runLoop(ctx, acc, base, base + count)
}

fn g154_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
    end: Int,
): (Int, [Int]) {
    if (i == end) { acc } else { g154_runLoop(ctx, g154_step(ctx, acc, i), i + 1, end) }
}

fn g154_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g154<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g154_run(c, (0, list.empty<Int>()), r * 50, 50));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g154_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g154(host.alloc)).ignore();
    .Ok(())
