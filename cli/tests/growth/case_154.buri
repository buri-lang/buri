from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G154Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g154_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g154_step<C: Allocator>(ctx: C, acc: G154Acc, i: Int): G154Acc {
    let G154Acc { n, items, tag } = acc;
    let seen = items.length();
    G154Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g154_put(ctx, items, i * 7 + 5 + seen % 7, 0)
        } else {
            g154_put(ctx, items, i * 7 + 5 + seen % 7, 1)
        },
        tag,
    }
}

fn g154_run<C: Allocator>(ctx: C, acc: G154Acc, base: Int, count: Int): G154Acc {
    g154_runLoop(ctx, acc, base, base + count)
}

fn g154_runLoop<C: Allocator>(ctx: C, acc: G154Acc, i: Int, end: Int): G154Acc {
    if (i == end) { acc } else { g154_runLoop(ctx, g154_step(ctx, acc, i), i + 1, end) }
}

fn g154_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g154<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g154_run(c, G154Acc { n: 0, items: list.empty<Str>(), tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g154_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g154(host.alloc)).ignore();
    .Ok(())
