}

fn g274_gate(i: Int): Result<Int, Str> {
    if (i == 380) { .Err("bad") } else { .Ok(i % 5) }
}

fn g274_run<C: Allocator>(
    ctx: C,
    acc: G274Acc,
    base: Int,
    count: Int,
): Result<G274Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
            ctx,
            fn(c, acc: G274Acc, i) => {
                let q = g274_gate(i)?;
                let seen = acc.items.length();
                .Ok(G274Acc {
                    ..acc,
                    n: acc.n + 1,
                    items: if (i % 2 == 0) {
                        g274_put(c, acc.items, i * 7 + 9 + seen % 7 + q, 0)
                    } else {
                        g274_put(c, acc.items, i * 7 + 9 + seen % 7 + q, 1)
                    },
                })
            },
            acc,
        )
}

fn g274_rounds<C: Allocator>(
    ctx: C,
    acc: G274Acc,
    base: Int,
    count: Int,
): Result<G274Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g274_run(c, acc, i * 150, 150), acc)
