fn g274_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g274_gate(i: Int): Result<Int, Str> {
    if (i == 380) { .Err("bad") } else { .Ok(i % 5) }
}

fn g274_run<C: Allocator>(
    ctx: C,
    acc: G274Acc,
    base: Int,
    count: Int,
): Result<G274Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
