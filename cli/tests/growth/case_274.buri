fn g274_hash(items: [G274Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g274<C: Allocator>(ctx: C): Str {
    match (g274_rounds(ctx, G274Acc { n: 0, items: [], tag: 42 }, 0, 8)) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x.name,
                .None => "-1",
            };
            let last = match (acc.items.last()) {
                .Some(x) => x.name,
                .None => "-1",
            };
            let hash = g274_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
