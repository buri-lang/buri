    tag: Int,
}

fn g311_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g311_measure(items: [Int]): Int {
    items.length()
}

fn g311_step<C: Allocator>(ctx: C, acc: G311Acc, i: Int): G311Acc {
