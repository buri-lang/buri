from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G311Row {
    id: Int,
    name: Str,
}

struct G311Acc {
    n: Int,
    items: [G311Row],
    tag: Int,
}

fn g311_add<C: Allocator>(ctx: C, items: [G311Row], code: Int): [G311Row] {
    items.push(ctx, G311Row { id: code, name: str.fromInt(ctx, code) })
}

fn g311_measure(items: [G311Row]): Int {
    items.length()
}

fn g311_step<C: Allocator>(ctx: C, acc: G311Acc, i: Int): G311Acc {
    match (acc) {
        G311Acc { n, items, tag } => {
            let held = items;
            let seen = g311_measure(held);
            G311Acc { n: n + 1, items: g311_add(ctx, held, i * 7 + 0 + seen % 7), tag }
        },
    }
}

fn g311_run<C: Allocator>(ctx: C, acc: G311Acc, base: Int, count: Int): G311Acc {
    g311_runLoop(ctx, acc, base, base + count)
}

fn g311_runLoop<C: Allocator>(ctx: C, acc: G311Acc, i: Int, end: Int): G311Acc {
    if (i == end) { acc } else { g311_runLoop(ctx, g311_step(ctx, acc, i), i + 1, end) }
}

fn g311_hash(items: [G311Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g311<C: Allocator>(ctx: C): Str {
    let mid = g311_run(ctx, G311Acc { n: 0, items: [], tag: 42 }, 0, 300);
    let acc = g311_run(ctx, mid, 300, 300);
    let kept = g311_hash(mid.items);
    let first = match (acc.items.first()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let hash = g311_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc
            .items
            .length()} ${first} ${last} ${hash} | ${mid.items.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g311(host.alloc)).ignore();
    .Ok(())
}
