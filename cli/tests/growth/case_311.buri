struct G311Row {
    id: Int,
    name: Str,
}

fn g311_survey(items: [G311Row]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g311_step<C: Allocator>(ctx: C, acc: (Int, [G311Row]), i: Int): (Int, [G311Row]) {
    match (acc) {
        (n, items) => {
            let held = items;
            let seen = g311_survey(held) + g311_survey(held);
            (
                n + 1,
                held.concat(ctx, [
                    G311Row {
                        id: i * 7 + 0 + seen % 7,
                        name: str.fromInt(ctx, i * 7 + 0 + seen % 7),
                    },
                ]),
            )
        },
    }
}

fn g311_run<C: Allocator>(
    ctx: C,
    acc: (Int, [G311Row]),
    base: Int,
    count: Int,
): (Int, [G311Row]) {
    g311_runLoop(ctx, acc, base, base + count)
}

fn g311_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [G311Row]),
    i: Int,
    end: Int,
): (Int, [G311Row]) {
    if (i == end) { acc } else { g311_runLoop(ctx, g311_step(ctx, acc, i), i + 1, end) }
}

fn g311_hash(items: [G311Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g311<C: Allocator>(ctx: C): Str {
    let mid = g311_run(ctx, (0, []), 0, 300);
    let acc = g311_run(ctx, mid, 300, 300);
    let kept = g311_hash(mid.1);
    let first = match (acc.1.first()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let hash = g311_hash(acc.1);
    str.format(
        ctx,
        "${acc.0} ${acc.1.length()} ${first} ${last} ${hash} | ${mid.1.length()} ${kept}",
    )
}

