        }
    }
}

fn g311_run<C: Allocator>(ctx: C, acc: G311Acc, base: Int, count: Int): G311Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g311_step(c, acc, i), acc)
}

fn g311_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

