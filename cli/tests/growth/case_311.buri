}

fn g311_run<C: Allocator>(ctx: C, acc: (Int, Str), base: Int, count: Int): (Int, Str) {
    g311_runLoop(ctx, acc, base, base + count)
}

fn g311_runLoop<C: Allocator>(ctx: C, acc: (Int, Str), i: Int, end: Int): (Int, Str) {
    if (i == end) { acc } else { g311_runLoop(ctx, g311_step(ctx, acc, i), i + 1, end) }
}

fn g311_hash(items: Str): Int {
    g311_walk(items, 0, 7)
}

fn g311_walk(text: Str, at: Int, h: Int): Int {
