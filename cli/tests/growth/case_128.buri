from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G128Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g128_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g128_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g128_pick(code))
}

fn g128_step<C: Allocator>(ctx: C, acc: G128Acc, i: Int): G128Acc {
    let G128Acc { n, items, tag } = acc;
    let seen = items.length();
    G128Acc { n: n + 1, items: g128_add(ctx, items, i * 7 + 6 + seen % 7), tag }
}

fn g128_run<C: Allocator>(ctx: C, acc: G128Acc, base: Int, count: Int): G128Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g128_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g128_step(ctx, acc, i)
    }
}

fn g128_rounds<C: Allocator>(ctx: C, acc: G128Acc, base: Int, count: Int): G128Acc {
    g128_roundsLoop(ctx, acc, base, base + count)
}

fn g128_roundsLoop<C: Allocator>(ctx: C, acc: G128Acc, i: Int, end: Int): G128Acc {
    if (i == end) {
        acc
    } else {
        g128_roundsLoop(ctx, g128_run(ctx, acc, i * 150, 150), i + 1, end)
    }
}

fn g128_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g128<C: Allocator>(ctx: C): Str {
    let acc = g128_rounds(
        ctx,
        G128Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        8,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g128_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

