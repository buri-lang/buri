fn g128_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g128<C: Allocator>(ctx: C): Str {
    match (g128_rounds(ctx, (0, list.empty<Int>()), 0, 16)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
