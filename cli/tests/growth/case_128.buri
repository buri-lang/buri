from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G128Row {
    id: Int,
    name: Str,
}

fn g128_add<C: Allocator>(ctx: C, items: [G128Row], code: Int): [G128Row] {
    items.push(ctx, G128Row { id: code, name: str.fromInt(ctx, code) })
}

fn g128_step<C: Allocator>(ctx: C, acc: [G128Row], i: Int): [G128Row] {
    let items = acc;
    let seen = items.length();
    g128_add(ctx, items, i * 7 + 6 + seen % 7)
}

fn g128_run<C: Allocator>(ctx: C, acc: [G128Row], base: Int, count: Int): [G128Row] {
    if (count == 0) {
        acc
    } else {
        let acc = g128_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g128_step(ctx, acc, i)
    }
}

fn g128_rounds<C: Allocator>(ctx: C, acc: [G128Row], base: Int, count: Int): [G128Row] {
    g128_roundsLoop(ctx, acc, base, base + count)
}

fn g128_roundsLoop<C: Allocator>(ctx: C, acc: [G128Row], i: Int, end: Int): [G128Row] {
    if (i == end) {
        acc
    } else {
        g128_roundsLoop(ctx, g128_run(ctx, acc, i * 150, 150), i + 1, end)
    }
}

fn g128_hash(items: [G128Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g128<C: Allocator>(ctx: C): Str {
    let acc = g128_rounds(ctx, [], 0, 8);
    let first = match (acc.first()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let last = match (acc.last()) {
        .Some(x) => x.name,
        .None => "-1",
    };
    let hash = g128_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

