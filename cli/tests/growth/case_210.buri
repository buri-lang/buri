}

fn g210_step<C: Allocator>(ctx: C, acc: G210Acc, i: Int): G210Acc {
    let G210Acc { n, items, tag } = acc;
    let held = items;
    let seen = g210_survey(held) + g210_survey(held);
    G210Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g210_put(ctx, held, i * 1 + 0 + seen % 7, 0)
