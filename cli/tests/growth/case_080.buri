}

fn g080_rounds<C: Allocator>(
    ctx: C,
    acc: G080Acc,
    base: Int,
    count: Int,
): Result<G080Acc, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g080_rounds(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g080_run(ctx, acc, i * 100, 100)
