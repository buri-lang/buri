}

fn g080_hash(items: Str): Int {
    g080_walk(items, 0, 7)
}

fn g080_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g080_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g080<C: Allocator>(ctx: C): Str {
    match (g080_rounds(ctx, G080Acc { n: 0, items: "", tag: 42 }, 0, 8)) {
        .Ok(acc) => {
            let size = acc.items.length();
            let first = acc.items.slice(0, 8);
            let last = acc.items.slice(size - 8, size);
            let hash = g080_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

