struct G080Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g080_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g080_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g080_pick(k)) }
}

fn g080_gate(i: Int): Result<Int, Str> {
    if (i == 447) { .Err("bad") } else { .Ok(i % 5) }
}

fn g080_step<C: Allocator>(ctx: C, acc: G080Acc, i: Int): Result<G080Acc, Str> {
    let q = g080_gate(i)?;
    let G080Acc { n, items, tag } = acc;
    let held = items;
    let seen = held.length();
    .Ok(G080Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g080_put(ctx, held, i * 1 + 6 + seen % 7 + q, 0)
        } else {
            g080_put(ctx, held, i * 1 + 6 + seen % 7 + q, 1)
        },
        tag,
    })
}

fn g080_run<C: Allocator>(
    ctx: C,
    acc: G080Acc,
    base: Int,
    count: Int,
): Result<G080Acc, Str> {
    g080_runLoop(ctx, acc, base, base + count)
}

fn g080_runLoop<C: Allocator>(
    ctx: C,
    acc: G080Acc,
    i: Int,
    end: Int,
): Result<G080Acc, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g080_runLoop(ctx, g080_step(ctx, acc, i)?, i + 1, end)
