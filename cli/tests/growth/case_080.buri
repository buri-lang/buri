from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G080Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g080_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g080_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g080_pick(k)) }
}

fn g080_step<C: Allocator>(ctx: C, acc: G080Acc, i: Int): G080Acc {
    let G080Acc { n, items, tag } = acc;
    let held = items;
    let seen = held.length();
    G080Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g080_put(ctx, held, i * 3 + 0 + seen % 7, 0)
        } else {
            g080_put(ctx, held, i * 3 + 0 + seen % 7, 1)
        },
        tag,
    }
}

fn g080_run<C: Allocator>(ctx: C, acc: G080Acc, base: Int, count: Int): G080Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g080_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g080_step(ctx, acc, i)
    }
}

fn g080_hash(items: Str): Int {
    g080_walk(items, 0, 7)
}

fn g080_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g080_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g080<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g080_run(c, G080Acc { n: 0, items: "", tag: 42 }, r * 100, 100)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g080_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g080(host.alloc)).ignore();
    .Ok(())
