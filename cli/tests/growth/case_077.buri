    .Ok(if (i % 2 == 0) {
        g077_put(ctx, held, i * 1 + 9 + seen % 7 + q, 0)
    } else {
        g077_put(ctx, held, i * 1 + 9 + seen % 7 + q, 1)
    })
}

fn g077_run<C: Allocator>(
    ctx: C,
    acc: [Str],
    base: Int,
    count: Int,
