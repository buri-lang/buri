fn g077_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g077<C: Allocator>(ctx: C): Str {
    match (g077_run(ctx, list.empty<Str>(), 0, 400)) {
        .Ok(acc) => {
            let first = match (acc.first()) {
                .Some(x) => x,
