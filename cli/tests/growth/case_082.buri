}

fn g082_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g082_pick(k)) }
}

fn g082_step<C: Allocator>(ctx: C, acc: G082Acc, i: Int): G082Acc {
    match (acc) {
        G082Acc { n, items, tag } => {
            let held = items;
            G082Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g082_put(ctx, held, i * 7 + 8, 0)
