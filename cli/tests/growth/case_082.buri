                    g082_put(ctx, held, i * 7 + 8, 1)
                },
                tag,
            }
        },
    }
}

fn g082_run<C: Allocator>(ctx: C, acc: G082Acc, base: Int, count: Int): G082Acc {
    g082_runLoop(ctx, acc, base, base + count)
}

fn g082_runLoop<C: Allocator>(ctx: C, acc: G082Acc, i: Int, end: Int): G082Acc {
    if (i == end || acc.items.length() >= 257) {
        acc
