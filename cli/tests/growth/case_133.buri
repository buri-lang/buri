from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G133Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g133_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

struct G133Outer {
    inner: G133Acc,
    k: Int,
}

fn g133_inner<C: Allocator>(ctx: C, acc: G133Acc, i: Int): G133Acc {
    let seen = acc.items.length();
    G133Acc {
        ..acc,
        n: acc.n + 1,
        items: g133_add(ctx, acc.items, i * 1 + 2 + seen % 7),
    }
}

fn g133_step<C: Allocator>(ctx: C, acc: G133Outer, i: Int): G133Outer {
    G133Outer { ..acc, k: acc.k + 1, inner: g133_inner(ctx, acc.inner, i) }
}

fn g133_run<C: Allocator>(ctx: C, acc: G133Outer, base: Int, count: Int): G133Outer {
    g133_runLoop(ctx, acc, base, base + count)
}

fn g133_runLoop<C: Allocator>(ctx: C, acc: G133Outer, i: Int, end: Int): G133Outer {
    if (i == end) { acc } else { g133_runLoop(ctx, g133_step(ctx, acc, i), i + 1, end) }
}

fn g133_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g133<C: Allocator>(ctx: C): Str {
    let acc = g133_run(
        ctx,
        G133Outer { inner: G133Acc { n: 0, items: list.empty<Str>(), tag: 42 }, k: 0 },
        0,
        800,
