    let last = match (acc.inner.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g133_hash(acc.inner.items);
    str.format(
        ctx,
        "${acc.k} ${acc
            .inner
            .n} ${acc.inner.tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
