from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g258_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g258_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g258_pick(k)) }
}

fn g258_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g258_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): Result<(Int, Str), Str> {
    let q = g258_gate(i)?;
    let (n, items) = acc;
    .Ok(
        (
            n + 1,
            if (i % 2 == 0) {
                g258_put(ctx, items, i * 1 + 3 + q, 0)
            } else {
                g258_put(ctx, items, i * 1 + 3 + q, 1)
            },
        ),
    )
}

fn g258_run<C: Allocator>(
    ctx: C,
    acc: (Int, Str),
    base: Int,
    count: Int,
): Result<(Int, Str), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g258_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g258_step(ctx, acc, i)
    }
}

fn g258_hash(items: Str): Int {
    g258_walk(items, 0, 7)
}

fn g258_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g258_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g258<C: Allocator>(ctx: C): Str {
    match (g258_run(ctx, (0, ""), 0, 600)) {
        .Ok(acc) => {
            let size = acc.1.length();
            let first = acc.1.slice(0, 8);
            let last = acc.1.slice(size - 8, size);
            let hash = g258_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g258(host.alloc)).ignore();
    .Ok(())
