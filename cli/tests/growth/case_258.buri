fn g258_step<C: Allocator>(ctx: C, acc: G258Acc, i: Int): Result<G258Acc, Str> {
    let q = g258_gate(i)?;
    let G258Acc { n, items, tag } = acc;
    .Ok(G258Acc { n: n + 1, items: g258_add(ctx, items, i * 1 + 9 + q), tag })
