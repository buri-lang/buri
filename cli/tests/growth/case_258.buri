fn g258_run<C: Allocator>(
    ctx: C,
    acc: G258Acc,
    base: Int,
    count: Int,
): Result<G258Acc, Str> {
    g258_runLoop(ctx, acc, base, base + count)
}

fn g258_runLoop<C: Allocator>(
    ctx: C,
    acc: G258Acc,
    i: Int,
    end: Int,
): Result<G258Acc, Str> {
    if (i == end) {
        .Ok(acc)
