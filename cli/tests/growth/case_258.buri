from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g258_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g258_gate(i: Int): Result<Int, Str> {
    if (i == 601) { .Err("bad") } else { .Ok(i % 5) }
}

fn g258_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
): Result<(Int, [Int]), Str> {
    let q = g258_gate(i)?;
    let (n, items) = acc;
    .Ok(
        (
            n + 1,
            if (i % 2 == 0) {
                g258_put(ctx, items, i * 1 + 3 + q, 0)
            } else {
                g258_put(ctx, items, i * 1 + 3 + q, 1)
            },
        ),
    )
}

fn g258_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): Result<(Int, [Int]), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g258_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g258_step(ctx, acc, i)
    }
}

fn g258_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g258<C: Allocator>(ctx: C): Str {
    match (g258_run(ctx, (0, list.empty<Int>()), 0, 600)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g258_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g258(host.alloc)).ignore();
    .Ok(())
}
