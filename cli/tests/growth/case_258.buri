        g258_run(ctx, G258Acc { n: 0, items: list.empty<Int>(), tag: 42 }, 0, 1000)
    ) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => -1,
