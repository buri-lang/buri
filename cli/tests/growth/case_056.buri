}

fn g056_rounds<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g056_run(c, acc, i * 100, 100), acc)
}

fn g056_hash(items: [Int]): Int {
