fn g310<C: Allocator>(ctx: C): Str {
    let mid = g310_run(ctx, [], 0, 400);
    let acc = g310_run(ctx, mid, 400, 400);
    let kept = g310_hash(mid);
    let first = match (acc.first()) {
        .Some(x) => x.name,
        .None => "-1",
