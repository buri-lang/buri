}

fn g310_step<C: Allocator>(ctx: C, acc: [G310Row], i: Int): [G310Row] {
    let seen = g310_measure(acc);
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g310_put(ctx, acc, i * 3 + 0 + seen % 7, 0)
            } else {
                g310_put(ctx, acc, i * 3 + 0 + seen % 7, 1)
