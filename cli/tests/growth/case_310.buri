from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G310Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g310_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g310_step<C: Allocator>(ctx: C, acc: G310Acc, i: Int): G310Acc {
    let held = acc.items;
    let seen = held.length();
    G310Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g310_put(ctx, held, i * 3 + 5 + seen % 7, 0)
        } else {
            g310_put(ctx, held, i * 3 + 5 + seen % 7, 1)
        },
    }
}

fn g310_run<C: Allocator>(ctx: C, acc: G310Acc, base: Int, count: Int): G310Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g310_step(c, acc, i), acc)
}

fn g310_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g310<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g310_run(
                c,
                G310Acc { n: 0, items: list.empty<Int>(), tag: 42 },
                r * 100,
                100,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g310_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g310(host.alloc)).ignore();
    .Ok(())
}
