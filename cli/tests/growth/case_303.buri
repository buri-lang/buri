}

fn g303_step<C: Allocator>(ctx: C, acc: G303Outer, i: Int): G303Outer {
    match (acc) {
        G303Outer { inner, k } => {
            let held = inner;
            G303Outer { inner: g303_inner(ctx, held, i), k: k + 1 }
