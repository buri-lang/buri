from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G160Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g160_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g160_gate(i: Int): Result<Int, Str> {
    if (i == 155) { .Err("bad") } else { .Ok(i % 5) }
}

fn g160_step<C: Allocator>(ctx: C, acc: G160Acc, i: Int): Result<G160Acc, Str> {
    let q = g160_gate(i)?;
    let seen = acc.items.length();
    .Ok(G160Acc {
        ..acc,
        n: acc.n + 1,
        items: g160_add(ctx, acc.items, i * 3 + 5 + seen % 7 + q),
    })
}

fn g160_run<C: Allocator>(
    ctx: C,
    acc: G160Acc,
    base: Int,
    count: Int,
): Result<G160Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g160_step(c, acc, i), acc)
}

fn g160_rounds<C: Allocator>(
    ctx: C,
    acc: G160Acc,
    base: Int,
    count: Int,
): Result<G160Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g160_run(c, acc, i * 50, 50), acc)
}

fn g160_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g160<C: Allocator>(ctx: C): Str {
    match (
        g160_rounds(ctx, G160Acc { n: 0, items: list.empty<Int>(), tag: 42 }, 0, 8)
    ) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.items.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g160_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g160(host.alloc)).ignore();
    .Ok(())
