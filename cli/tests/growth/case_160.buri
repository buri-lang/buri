    if (i % 2 == 0) {
        g160_put(ctx, held, i * 1 + 0, 0)
    } else {
        g160_put(ctx, held, i * 1 + 0, 1)
    }
}

fn g160_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
