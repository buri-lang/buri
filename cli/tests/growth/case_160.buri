from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G160Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g160_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g160_step<C: Allocator>(ctx: C, acc: G160Acc, i: Int): G160Acc {
    let G160Acc { n, items, tag } = acc;
    let held = items;
    G160Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g160_put(ctx, held, i * 1 + 0, 0)
        } else {
            g160_put(ctx, held, i * 1 + 0, 1)
        },
        tag,
    }
}

fn g160_run<C: Allocator>(ctx: C, acc: G160Acc, base: Int, count: Int): G160Acc {
    g160_runLoop(ctx, acc, base, base + count)
}

fn g160_runLoop<C: Allocator>(ctx: C, acc: G160Acc, i: Int, end: Int): G160Acc {
    if (i == end) { acc } else { g160_runLoop(ctx, g160_step(ctx, acc, i), i + 1, end) }
}

fn g160_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g160<C: Allocator>(ctx: C): Str {
    let acc = g160_run(
        ctx,
        G160Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        1000,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g160_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g160(host.alloc)).ignore();
    .Ok(())
}
