from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g160_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g160_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g160_pick(code))
}

fn g160_gate(i: Int): Result<Int, Str> {
    if (i == 155) { .Err("bad") } else { .Ok(i % 5) }
}

fn g160_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): Result<(Int, Str), Str> {
    let q = g160_gate(i)?;
    let seen = acc.1.length();
    .Ok((acc.0 + 1, g160_add(ctx, acc.1, i * 3 + 5 + seen % 7 + q)))
}

fn g160_run<C: Allocator>(
    ctx: C,
    acc: (Int, Str),
    base: Int,
    count: Int,
): Result<(Int, Str), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g160_step(c, acc, i), acc)
}

fn g160_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, Str),
    base: Int,
    count: Int,
): Result<(Int, Str), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g160_run(c, acc, i * 50, 50), acc)
}

fn g160_hash(items: Str): Int {
    g160_walk(items, 0, 7)
}

fn g160_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g160_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g160<C: Allocator>(ctx: C): Str {
    match (g160_rounds(ctx, (0, ""), 0, 8)) {
        .Ok(acc) => {
            let size = acc.1.length();
            let first = acc.1.slice(0, 8);
            let last = acc.1.slice(size - 8, size);
            let hash = g160_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g160(host.alloc)).ignore();
    .Ok(())
}
