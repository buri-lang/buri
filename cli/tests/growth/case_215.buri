}

fn g215_put<C: Allocator>(ctx: C, items: [G215Row], code: Int, salt: Int): [G215Row] {
    let k = code + salt;
    if (k < 0) {
        items
    } else {
        items.push(ctx, G215Row { id: k, name: str.fromInt(ctx, k) })
    }
}

fn g215_measure(items: [G215Row]): Int {
    items.length()
}

fn g215_step<C: Allocator>(ctx: C, acc: G215Box, i: Int): G215Box {
    match (acc) {
        .Full(n, items) => {
            let seen = g215_measure(items);
            G215Box.Full(n + 1, if (i % 2 == 0) {
                g215_put(ctx, items, i * 1 + 6 + seen % 7, 0)
            } else {
                g215_put(ctx, items, i * 1 + 6 + seen % 7, 1)
            })
        },
        .Empty => G215Box.Empty,
    }
}

fn g215_run<C: Allocator>(ctx: C, acc: G215Box, base: Int, count: Int): G215Box {
