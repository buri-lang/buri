        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g215_step(c, acc, i), acc)
}

fn g215_hash(items: [G215Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g215<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => g215_run(c, G215Box.Full(0, []), r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.items().length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g215_hash(acc.items())) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
