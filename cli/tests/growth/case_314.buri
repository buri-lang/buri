from "platform/effect" import { Allocator };

fn g314_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g314_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g314_pick(k)) }
}

fn g314_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g314_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let held = acc;
    let seen = g314_survey(held) + g314_survey(held);
    if (i % 2 == 0) {
        g314_put(ctx, held, i * 3 + 8 + seen % 7, 0)
    } else {
        g314_put(ctx, held, i * 3 + 8 + seen % 7, 1)
    }
}

fn g314_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    g314_runLoop(ctx, acc, base, base + count)
}

fn g314_runLoop<C: Allocator>(ctx: C, acc: [Str], i: Int, end: Int): [Str] {
    if (i == end) { acc } else { g314_runLoop(ctx, g314_step(ctx, acc, i), i + 1, end) }
}

fn g314_rounds<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    if (count == 0) {
        acc
    } else {
        let acc = g314_rounds(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g314_run(ctx, acc, i * 100, 100)
    }
}

fn g314_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g314<C: Allocator>(ctx: C): Str {
    let acc = g314_rounds(ctx, list.empty<Str>(), 0, 4);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g314_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g314(host.alloc)).ignore();
    .Ok(())
