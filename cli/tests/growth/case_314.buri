}

fn g314<C: Allocator>(ctx: C): Str {
    match (g314_rounds(ctx, (0, list.empty<Str>()), 0, 8)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
