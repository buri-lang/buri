}

fn g151_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g151<C: Allocator>(ctx: C): Str {
    let acc = g151_run(ctx, (0, list.empty<Int>()), 0, 400);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => -1,
