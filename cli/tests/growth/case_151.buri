fn g151_rounds<C: Allocator>(ctx: C, acc: G151Acc, base: Int, count: Int): G151Acc {
    g151_roundsLoop(ctx, acc, base, base + count)
}

fn g151_roundsLoop<C: Allocator>(ctx: C, acc: G151Acc, i: Int, end: Int): G151Acc {
