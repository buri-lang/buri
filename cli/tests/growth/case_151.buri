from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G151Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g151_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g151_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g151_pick(k)) }
}

fn g151_measure(items: Str): Int {
    items.length()
}

struct G151Outer {
    inner: G151Acc,
    k: Int,
}

fn g151_inner<C: Allocator>(ctx: C, acc: G151Acc, i: Int): G151Acc {
    let G151Acc { n, items, tag } = acc;
    let held = items;
    let seen = g151_measure(held);
    G151Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g151_put(ctx, held, i * 7 + 2 + seen % 7, 0)
        } else {
            g151_put(ctx, held, i * 7 + 2 + seen % 7, 1)
        },
        tag,
    }
}

fn g151_step<C: Allocator>(ctx: C, acc: G151Outer, i: Int): G151Outer {
    let G151Outer { inner, k } = acc;
    let held = inner;
    G151Outer { inner: g151_inner(ctx, held, i), k: k + 1 }
}

fn g151_run<C: Allocator>(ctx: C, acc: G151Outer, base: Int, count: Int): G151Outer {
    if (count == 0) {
        acc
    } else {
        let acc = g151_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g151_step(ctx, acc, i)
    }
}

fn g151_hash(items: Str): Int {
    g151_walk(items, 0, 7)
}

fn g151_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g151_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g151<C: Allocator>(ctx: C): Str {
    let acc = g151_run(
        ctx,
        G151Outer { inner: G151Acc { n: 0, items: "", tag: 42 }, k: 0 },
        0,
        400,
    );
    let size = acc.inner.items.length();
    let first = acc.inner.items.slice(0, 8);
    let last = acc.inner.items.slice(size - 8, size);
    let hash = g151_hash(acc.inner.items);
    str.format(
        ctx,
        "${acc.k} ${acc
            .inner
            .n} ${acc.inner.tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g151(host.alloc)).ignore();
    .Ok(())
