        n + 1,
        if (i % 2 == 0) {
            g151_put(ctx, held, i * 7 + 2 + seen % 7, 0)
        } else {
            g151_put(ctx, held, i * 7 + 2 + seen % 7, 1)
        },
    )
}

fn g151_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
