    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g151_measure(items: [Int]): Int {
    items.length()
}

fn g151_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let (n, items) = acc;
    let held = items;
    let seen = g151_measure(held);
