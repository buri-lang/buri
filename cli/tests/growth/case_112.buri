}

fn g112_rounds<C: Allocator>(
    ctx: C,
    acc: G112Outer,
    base: Int,
    count: Int,
): Result<G112Outer, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g112_rounds(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g112_run(ctx, acc, i * 50, 50)
