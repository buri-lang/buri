// Generated by `cli/tests/native/growth/generator.rs`; do not edit.
// value=Names acc=Record access=Field pusher=Small reader=None alias=true inner=Fold outer=None nest=None stop=false fail=none
// expect: 600 42 600 9 1806 417960
// blocks: 631
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G112Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g112_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g112_step<C: Allocator>(ctx: C, acc: G112Acc, i: Int): G112Acc {
    let held = acc.items;
    G112Acc { ..acc, n: acc.n + 1, items: g112_add(ctx, held, i * 3 + 9) }
}

fn g112_run<C: Allocator>(ctx: C, acc: G112Acc, base: Int, count: Int): G112Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g112_step(c, acc, i), acc)
}

fn g112_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g112<C: Allocator>(ctx: C): Str {
    let acc = g112_run(
        ctx,
        G112Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        600,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g112_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g112(host.alloc)).ignore();
    .Ok(())
}
