struct G112Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g112_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g112_gate(i: Int): Result<Int, Str> {
    if (i == 801) { .Err("bad") } else { .Ok(i % 5) }
}

struct G112Outer {
    inner: G112Acc,
    k: Int,
}

fn g112_inner<C: Allocator>(ctx: C, acc: G112Acc, i: Int): Result<G112Acc, Str> {
    let q = g112_gate(i)?;
    let held = acc.items;
    .Ok(G112Acc {
        ..acc,
        n: acc.n + 1,
        items: held.push(ctx, g112_pick(i * 3 + 2 + q)),
    })
}

fn g112_step<C: Allocator>(ctx: C, acc: G112Outer, i: Int): Result<G112Outer, Str> {
    let held = acc.inner;
    .Ok(G112Outer { ..acc, k: acc.k + 1, inner: g112_inner(ctx, held, i)? })
}

fn g112_run<C: Allocator>(
    ctx: C,
    acc: G112Outer,
    base: Int,
    count: Int,
): Result<G112Outer, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g112_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g112_step(ctx, acc, i)
