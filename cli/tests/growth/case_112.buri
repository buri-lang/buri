    .Ok((acc.0 + 1, g112_add(ctx, held, i * 3 + 2 + seen % 7 + q)))
}

fn g112_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
