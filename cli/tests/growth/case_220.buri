from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G220Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g220_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g220_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g220_pick(k)) }
}

fn g220_step<C: Allocator>(ctx: C, acc: G220Acc, i: Int): G220Acc {
    let G220Acc { n, items, tag } = acc;
    let seen = items.length();
    G220Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g220_put(ctx, items, i * 3 + 8 + seen % 7, 0)
        } else {
            g220_put(ctx, items, i * 3 + 8 + seen % 7, 1)
        },
        tag,
    }
}

fn g220_run<C: Allocator>(ctx: C, acc: G220Acc, base: Int, count: Int): G220Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g220_step(c, acc, i), acc)
}

fn g220_hash(items: Str): Int {
    g220_walk(items, 0, 7)
}

fn g220_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g220_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g220<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g220_run(c, G220Acc { n: 0, items: "", tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g220_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g220(host.alloc)).ignore();
    .Ok(())
