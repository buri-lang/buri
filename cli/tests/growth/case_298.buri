fn g298_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g298_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let seen = g298_survey(acc.1) + g298_survey(acc.1);
    (acc.0 + 1, acc.1.push(ctx, str.fromInt(ctx, i * 7 + 1 + seen % 7)))
}

fn g298_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    if (count == 0) {
        acc
    } else {
        let acc = g298_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g298_step(ctx, acc, i)
    }
}

fn g298_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g298<C: Allocator>(ctx: C): Str {
    let acc = g298_run(ctx, (0, list.empty<Str>()), 0, 1000);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g298_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

