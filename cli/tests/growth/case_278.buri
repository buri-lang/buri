from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G278Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g278_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g278_measure(items: [Str]): Int {
    items.length()
}

fn g278_step<C: Allocator>(ctx: C, acc: G278Acc, i: Int): G278Acc {
    let held = acc.items;
    let seen = g278_measure(held);
    G278Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g278_put(ctx, held, i * 3 + 9 + seen % 7, 0)
        } else {
            g278_put(ctx, held, i * 3 + 9 + seen % 7, 1)
        },
    }
}

fn g278_run<C: Allocator>(ctx: C, acc: G278Acc, base: Int, count: Int): G278Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g278_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g278_step(ctx, acc, i)
    }
}

fn g278_rounds<C: Allocator>(ctx: C, acc: G278Acc, base: Int, count: Int): G278Acc {
    g278_roundsLoop(ctx, acc, base, base + count)
}

fn g278_roundsLoop<C: Allocator>(ctx: C, acc: G278Acc, i: Int, end: Int): G278Acc {
    if (i == end) {
        acc
    } else {
        g278_roundsLoop(ctx, g278_run(ctx, acc, i * 150, 150), i + 1, end)
    }
}

fn g278_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g278<C: Allocator>(ctx: C): Str {
    let acc = g278_rounds(
        ctx,
        G278Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        4,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g278_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g278(host.alloc)).ignore();
    .Ok(())
}
