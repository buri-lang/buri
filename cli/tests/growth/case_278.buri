    items: [Int],
    tag: Int,
}

fn g278_step<C: Allocator>(ctx: C, acc: G278Acc, i: Int): G278Acc {
    let held = acc.items;
    let probe = fn() => held.length();
    let seen = probe();
    G278Acc { ..acc, n: acc.n + 1, items: held.concat(ctx, [i * 3 + 9 + seen % 7]) }
}

fn g278_run<C: Allocator>(ctx: C, acc: G278Acc, base: Int, count: Int): G278Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g278_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g278_step(ctx, acc, i)
    }
}

fn g278_rounds<C: Allocator>(ctx: C, acc: G278Acc, base: Int, count: Int): G278Acc {
    g278_roundsLoop(ctx, acc, base, base + count)
}

fn g278_roundsLoop<C: Allocator>(ctx: C, acc: G278Acc, i: Int, end: Int): G278Acc {
    if (i == end) {
        acc
    } else {
        g278_roundsLoop(ctx, g278_run(ctx, acc, i * 150, 150), i + 1, end)
