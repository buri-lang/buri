        )
}

fn g278_rounds<C: Allocator>(ctx: C, acc: G278Acc, base: Int, count: Int): G278Acc {
    g278_roundsLoop(ctx, acc, base, base + count)
}

fn g278_roundsLoop<C: Allocator>(ctx: C, acc: G278Acc, i: Int, end: Int): G278Acc {
