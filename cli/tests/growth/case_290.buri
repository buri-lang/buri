    let seen = g290_survey(items) + g290_survey(items);
    items.concat(ctx, g290_pick(i * 1 + 3 + seen % 7))
}

fn g290_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g290_runLoop(ctx, acc, base, base + count)
}

fn g290_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
