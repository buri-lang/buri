struct G290Pair {
    items: [Str],
    also: [Int],
    n: Int,
}

fn g290_gate(i: Int): Result<Int, Str> {
    if (i == 1201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g290_step<C: Allocator>(ctx: C, acc: G290Pair, i: Int): Result<G290Pair, Str> {
    let q = g290_gate(i)?;
    let held = acc.items;
    let probe = fn() => held.length();
    let seen = probe();
    .Ok(G290Pair {
        ..acc,
        n: acc.n + 1,
        items: held
            .push(ctx, str.fromInt(ctx, i * 7 + 5 + seen % 7 + q))
            .push(ctx, str.fromInt(ctx, i * 7 + 5 + seen % 7 + q + 1)),
        also: acc.also.push(ctx, i),
    })
}

fn g290_run<C: Allocator>(
    ctx: C,
    acc: G290Pair,
    base: Int,
    count: Int,
): Result<G290Pair, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g290_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g290_step(ctx, acc, i)
    }
}

fn g290_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g290<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g290_run(
                c,
                G290Pair { items: list.empty<Str>(), also: [], n: 0 },
                r * 150,
                150,
