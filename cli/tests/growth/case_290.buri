}

fn g290_rounds<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g290_roundsLoop(ctx, acc, base, base + count)
}

fn g290_roundsLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
