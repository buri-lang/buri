from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g290_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g290_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g290_pick(k)) }
}

fn g290_gate(i: Int): Result<Int, Str> {
    if (i == 1201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g290_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
): Result<(Int, [Str]), Str> {
    let q = g290_gate(i)?;
    let held = acc.1;
    let seen = held.length();
    .Ok(
        (
            acc.0 + 1,
            if (i % 2 == 0) {
                g290_put(ctx, held, i * 7 + 5 + seen % 7 + q, 0)
            } else {
                g290_put(ctx, held, i * 7 + 5 + seen % 7 + q, 1)
            },
        ),
    )
}

fn g290_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g290_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g290_step(ctx, acc, i)
    }
}

fn g290_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g290<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => g290_run(c, (0, list.empty<Str>()), r * 150, 150));
    let lengths = all.fold(
        fn(t, got) => {
            t
                + match (got) {
                    .Ok(acc) => acc.1.length(),
                    .Err(_e) => -1,
                }
        },
        0,
    );
    let hashes = all.fold(
        fn(t, got) => {
            match (got) {
                .Ok(acc) => (t + g290_hash(acc.1)) % 1000003,
                .Err(_e) => t,
            }
        },
        0,
    );
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g290(host.alloc)).ignore();
    .Ok(())
}
