from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G120Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g120_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g120_gate(i: Int): Result<Int, Str> {
    if (i == 300) { .Err("bad") } else { .Ok(i % 5) }
}

struct G120Outer {
    inner: G120Acc,
    k: Int,
}

fn g120_inner<C: Allocator>(ctx: C, acc: G120Acc, i: Int): Result<G120Acc, Str> {
    let q = g120_gate(i)?;
    let held = acc.items;
    .Ok(G120Acc {
        ..acc,
        n: acc.n + 1,
        items: held.concat(ctx, g120_pick(i * 3 + 1 + q)),
    })
}

fn g120_step<C: Allocator>(ctx: C, acc: G120Outer, i: Int): Result<G120Outer, Str> {
    let held = acc.inner;
    .Ok(G120Outer { ..acc, k: acc.k + 1, inner: g120_inner(ctx, held, i)? })
}

fn g120_run<C: Allocator>(
    ctx: C,
    acc: G120Outer,
    base: Int,
    count: Int,
): Result<G120Outer, Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g120_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g120_step(ctx, acc, i)
    }
}

fn g120_rounds<C: Allocator>(
    ctx: C,
    acc: G120Outer,
    base: Int,
    count: Int,
): Result<G120Outer, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g120_run(c, acc, i * 150, 150), acc)
}

fn g120_hash(items: Str): Int {
    g120_walk(items, 0, 7)
}

fn g120_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g120_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g120<C: Allocator>(ctx: C): Str {
    match (
        g120_rounds(
            ctx,
            G120Outer { inner: G120Acc { n: 0, items: "", tag: 42 }, k: 0 },
            0,
            4,
        )
    ) {
        .Ok(acc) => {
            let size = acc.inner.items.length();
            let first = acc.inner.items.slice(0, 8);
            let last = acc.inner.items.slice(size - 8, size);
            let hash = g120_hash(acc.inner.items);
            str.format(
                ctx,
                "${acc.k} ${acc
                    .inner
                    .n} ${acc
                    .inner
                    .tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

