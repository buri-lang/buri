from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G120Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g120_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g120_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g120_pick(k)) }
}

fn g120_step<C: Allocator>(ctx: C, acc: G120Acc, i: Int): G120Acc {
    G120Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g120_put(ctx, acc.items, i * 7 + 0, 0)
        } else {
            g120_put(ctx, acc.items, i * 7 + 0, 1)
        },
    }
}

fn g120_run<C: Allocator>(ctx: C, acc: G120Acc, base: Int, count: Int): G120Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g120_step(c, acc, i), acc)
}

fn g120_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g120<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g120_run(
                c,
                G120Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g120_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g120(host.alloc)).ignore();
    .Ok(())
}
