from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g100_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g100_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g100_pick(k)) }
}

fn g100_measure(items: [Str]): Int {
    items.length()
}

fn g100_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    match (acc) {
        (n, items) => {
            let seen = g100_measure(items);
            (
                n + 1,
                if (i % 2 == 0) {
                    g100_put(ctx, items, i * 7 + 1 + seen % 7, 0)
                } else {
                    g100_put(ctx, items, i * 7 + 1 + seen % 7, 1)
                },
            )
        },
    }
}

fn g100_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    if (count == 0) {
        acc
    } else {
        let acc = g100_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g100_step(ctx, acc, i)
    }
}

fn g100_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g100<C: Allocator>(ctx: C): Str {
    let acc = g100_run(ctx, (0, list.empty<Str>()), 0, 800);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g100_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g100(host.alloc)).ignore();
    .Ok(())
}
