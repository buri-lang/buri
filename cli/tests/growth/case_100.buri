from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g100_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g100_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g100_pick(k)) }
}

fn g100_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    let seen = held.length();
    if (i % 2 == 0) {
        g100_put(ctx, held, i * 7 + 3 + seen % 7, 0)
    } else {
        g100_put(ctx, held, i * 7 + 3 + seen % 7, 1)
    }
}

fn g100_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    if (count == 0) {
        acc
    } else {
        let acc = g100_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g100_step(ctx, acc, i)
    }
}

fn g100_hash(items: Str): Int {
    g100_walk(items, 0, 7)
}

fn g100_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g100_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g100<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g100_run(c, "", r * 100, 100));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g100_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g100(host.alloc)).ignore();
    .Ok(())
}
