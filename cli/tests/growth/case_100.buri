// blocks: 32
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G100Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g100_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g100_measure(items: [Int]): Int {
    items.length()
}

fn g100_step<C: Allocator>(ctx: C, acc: G100Acc, i: Int): G100Acc {
    match (acc) {
        G100Acc { n, items, tag } => {
            let seen = g100_measure(items);
            G100Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g100_put(ctx, items, i * 7 + 1 + seen % 7, 0)
                } else {
                    g100_put(ctx, items, i * 7 + 1 + seen % 7, 1)
                },
                tag,
            }
        },
    }
}

fn g100_run<C: Allocator>(ctx: C, acc: G100Acc, base: Int, count: Int): G100Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g100_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g100_step(ctx, acc, i)
    }
}

fn g100_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g100<C: Allocator>(ctx: C): Str {
    let acc = g100_run(
        ctx,
        G100Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        800,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g100_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g100(host.alloc)).ignore();
    .Ok(())
}
