from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G231Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g231_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g231_measure(items: [Int]): Int {
    items.length()
}

struct G231Outer {
    inner: G231Acc,
    k: Int,
}

fn g231_inner<C: Allocator>(ctx: C, acc: G231Acc, i: Int): G231Acc {
    let seen = g231_measure(acc.items);
    G231Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g231_put(ctx, acc.items, i * 7 + 3 + seen % 7, 0)
        } else {
            g231_put(ctx, acc.items, i * 7 + 3 + seen % 7, 1)
        },
    }
}

fn g231_step<C: Allocator>(ctx: C, acc: G231Outer, i: Int): G231Outer {
    G231Outer { ..acc, k: acc.k + 1, inner: g231_inner(ctx, acc.inner, i) }
}

fn g231_run<C: Allocator>(ctx: C, acc: G231Outer, base: Int, count: Int): G231Outer {
    if (count == 0) {
        acc
    } else {
        let acc = g231_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g231_step(ctx, acc, i)
    }
}

fn g231_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g231<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g231_run(
                c,
                G231Outer {
                    inner: G231Acc { n: 0, items: list.empty<Int>(), tag: 42 },
                    k: 0,
                },
                r * 50,
                50,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.inner.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g231_hash(acc.inner.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

