}

fn g231_step<C: Allocator>(ctx: C, acc: G231Outer, i: Int): G231Outer {
    match (acc) {
        G231Outer { inner, k } => {
            G231Outer { inner: g231_inner(ctx, inner, i), k: k + 1 }
