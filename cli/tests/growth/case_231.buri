fn g231_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    (acc.0 + 1, acc.1.push(ctx, i * 7 + 3))
}

fn g231_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    if (count == 0) {
        acc
    } else {
        let acc = g231_run(ctx, acc, base, count - 1);
