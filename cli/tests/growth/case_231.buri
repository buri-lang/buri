fn g231_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g231_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g231_pick(code))
}

fn g231_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g231_step<C: Allocator>(ctx: C, acc: G231Acc, i: Int): G231Acc {
    match (acc) {
        G231Acc { n, items, tag } => {
            let seen = g231_survey(items) + g231_survey(items);
            G231Acc { n: n + 1, items: g231_add(ctx, items, i * 3 + 6 + seen % 7), tag }
        },
    }
}

fn g231_run<C: Allocator>(ctx: C, acc: G231Acc, base: Int, count: Int): G231Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g231_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g231_step(ctx, acc, i)
    }
}

fn g231_rounds<C: Allocator>(ctx: C, acc: G231Acc, base: Int, count: Int): G231Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g231_run(c, acc, i * 50, 50), acc)
}

fn g231_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g231<C: Allocator>(ctx: C): Str {
    let acc = g231_rounds(
        ctx,
        G231Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        4,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
