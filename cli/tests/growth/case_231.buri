from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G231Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g231_step<C: Allocator>(ctx: C, acc: G231Acc, i: Int): G231Acc {
    G231Acc { ..acc, n: acc.n + 1, items: acc.items.push(ctx, i * 7 + 3) }
}

fn g231_run<C: Allocator>(ctx: C, acc: G231Acc, base: Int, count: Int): G231Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g231_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g231_step(ctx, acc, i)
    }
}

fn g231_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g231<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g231_run(c, G231Acc { n: 0, items: list.empty<Int>(), tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g231_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g231(host.alloc)).ignore();
    .Ok(())
