                if (i % 2 == 0) {
                    g054_put(c, acc, i * 1 + 4 + seen % 7, 0)
                } else {
                    g054_put(c, acc, i * 1 + 4 + seen % 7, 1)
                }
            },
            acc,
        )
}

fn g054_hash(items: Str): Int {
