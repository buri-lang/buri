}

fn g054_run<C: Allocator>(ctx: C, acc: G054Acc, base: Int, count: Int): G054Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g054_step(c, acc, i), acc)
}

fn g054_hash(items: Str): Int {
    g054_walk(items, 0, 7)
}

fn g054_walk(text: Str, at: Int, h: Int): Int {
