fn g054_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g054_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g054_pick(k)) }
}

fn g054_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
