}

fn g315_hash(items: Str): Int {
    g315_walk(items, 0, 7)
}

fn g315_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g315_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g315<C: Allocator>(ctx: C): Str {
    match (g315_rounds(ctx, (0, ""), 0, 16)) {
        .Ok(acc) => {
            let size = acc.1.length();
