from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g280_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g280_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    if (acc.1.length() >= 350) {
        acc
    } else {
        let (n, items) = acc;
        let seen = g280_survey(items) + g280_survey(items);
        (n + 1, items.push(ctx, str.fromInt(ctx, i * 3 + 4 + seen % 7)))
    }
}

fn g280_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g280_step(c, acc, i), acc)
}

fn g280_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g280<C: Allocator>(ctx: C): Str {
    let acc = g280_run(ctx, (0, list.empty<Str>()), 0, 1000);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g280_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

