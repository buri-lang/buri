from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G280Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g280_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g280_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g280_step<C: Allocator>(ctx: C, acc: G280Acc, i: Int): G280Acc {
    if (acc.items.length() >= 350) {
        acc
    } else {
        let G280Acc { n, items, tag } = acc;
        let seen = g280_survey(items) + g280_survey(items);
        G280Acc {
            n: n + 1,
            items: items.concat(ctx, g280_pick(i * 3 + 4 + seen % 7)),
            tag,
        }
    }
}

fn g280_run<C: Allocator>(ctx: C, acc: G280Acc, base: Int, count: Int): G280Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g280_step(c, acc, i), acc)
}

fn g280_hash(items: Str): Int {
    g280_walk(items, 0, 7)
}

fn g280_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g280_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g280<C: Allocator>(ctx: C): Str {
    let acc = g280_run(ctx, G280Acc { n: 0, items: "", tag: 42 }, 0, 1000);
    let size = acc.items.length();
    let first = acc.items.slice(0, 8);
    let last = acc.items.slice(size - 8, size);
    let hash = g280_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g280(host.alloc)).ignore();
    .Ok(())
}
