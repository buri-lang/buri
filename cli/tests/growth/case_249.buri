}

fn g249_step<C: Allocator>(ctx: C, acc: G249Acc, i: Int): Result<G249Acc, Str> {
    let q = g249_gate(i)?;
    let G249Acc { n, items, tag } = acc;
    let seen = g249_survey(items) + g249_survey(items);
    .Ok(G249Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g249_put(ctx, items, i * 1 + 8 + seen % 7 + q, 0)
        } else {
            g249_put(ctx, items, i * 1 + 8 + seen % 7 + q, 1)
        },
        tag,
    })
}

fn g249_run<C: Allocator>(
    ctx: C,
    acc: G249Acc,
    base: Int,
    count: Int,
