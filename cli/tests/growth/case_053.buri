from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G053Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g053_measure(items: [Int]): Int {
    items.length()
}

fn g053_gate(i: Int): Result<Int, Str> {
    if (i == 254) { .Err("bad") } else { .Ok(i % 5) }
}

fn g053_step<C: Allocator>(ctx: C, acc: G053Acc, i: Int): Result<G053Acc, Str> {
    let q = g053_gate(i)?;
    let seen = g053_measure(acc.items);
    .Ok(G053Acc {
        ..acc,
        n: acc.n + 1,
        items: acc.items.push(ctx, i * 7 + 6 + seen % 7 + q),
    })
}

fn g053_run<C: Allocator>(
    ctx: C,
    acc: G053Acc,
    base: Int,
    count: Int,
): Result<G053Acc, Str> {
    g053_runLoop(ctx, acc, base, base + count)
}

fn g053_runLoop<C: Allocator>(
    ctx: C,
    acc: G053Acc,
    i: Int,
    end: Int,
): Result<G053Acc, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g053_runLoop(ctx, g053_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g053_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g053<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g053_run(c, G053Acc { n: 0, items: list.empty<Int>(), tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(
        fn(t, got) => {
            t
                + match (got) {
                    .Ok(acc) => acc.items.length(),
                    .Err(_e) => -1,
                }
        },
        0,
    );
    let hashes = all.fold(
        fn(t, got) => {
            match (got) {
                .Ok(acc) => (t + g053_hash(acc.items)) % 1000003,
                .Err(_e) => t,
            }
        },
        0,
    );
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g053(host.alloc)).ignore();
    .Ok(())
