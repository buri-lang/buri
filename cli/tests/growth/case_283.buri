fn g283_rounds<C: Allocator>(ctx: C, acc: G283Outer, base: Int, count: Int): G283Outer {
    g283_roundsLoop(ctx, acc, base, base + count)
}

fn g283_roundsLoop<C: Allocator>(ctx: C, acc: G283Outer, i: Int, end: Int): G283Outer {
