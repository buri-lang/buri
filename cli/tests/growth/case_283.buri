fn g283_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g283_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g283_pick(k)) }
}

fn g283_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
