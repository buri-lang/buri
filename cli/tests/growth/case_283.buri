fn g283_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g283_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g283_pick(k)) }
}

fn g283_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g283_put(ctx, held, i * 7 + 3, 0)
            } else {
                g283_put(ctx, held, i * 7 + 3, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g283_put(ctx, held, i * 7 + 3 + 1, 0)
            } else {
                g283_put(ctx, held, i * 7 + 3 + 1, 1)
            }
        },
    }
}

fn g283_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    if (count == 0) {
        acc
    } else {
        let acc = g283_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g283_step(ctx, acc, i)
