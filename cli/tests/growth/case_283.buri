        .None => h,
    }
}

fn g283<C: Allocator>(ctx: C): Str {
    let acc = g283_run(ctx, "", 0, 600);
    let size = acc.length();
    let first = acc.slice(0, 8);
    let last = acc.slice(size - 8, size);
    let hash = g283_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

