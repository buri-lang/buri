from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G088Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g088_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g088_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g088_pick(k)) }
}

fn g088_step<C: Allocator>(ctx: C, acc: G088Acc, i: Int): G088Acc {
    let seen = acc.items.length();
    G088Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g088_put(ctx, acc.items, i * 7 + 7 + seen % 7, 0)
        } else {
            g088_put(ctx, acc.items, i * 7 + 7 + seen % 7, 1)
        },
    }
}

fn g088_run<C: Allocator>(ctx: C, acc: G088Acc, base: Int, count: Int): G088Acc {
    g088_runLoop(ctx, acc, base, base + count)
}

fn g088_runLoop<C: Allocator>(ctx: C, acc: G088Acc, i: Int, end: Int): G088Acc {
    if (i == end) { acc } else { g088_runLoop(ctx, g088_step(ctx, acc, i), i + 1, end) }
}

fn g088_hash(items: Str): Int {
    g088_walk(items, 0, 7)
}

fn g088_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g088_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g088<C: Allocator>(ctx: C): Str {
    let acc = g088_run(ctx, G088Acc { n: 0, items: "", tag: 42 }, 0, 1000);
    let size = acc.items.length();
    let first = acc.items.slice(0, 8);
    let last = acc.items.slice(size - 8, size);
    let hash = g088_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g088(host.alloc)).ignore();
    .Ok(())
