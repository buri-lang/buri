from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G282Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g282_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g282_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g282_pick(code))
}

fn g282_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g282_gate(i: Int): Result<Int, Str> {
    if (i == 801) { .Err("bad") } else { .Ok(i % 5) }
}

fn g282_run<C: Allocator>(
    ctx: C,
    acc: G282Acc,
    base: Int,
    count: Int,
): Result<G282Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
            ctx,
            fn(c, acc: G282Acc, i) => {
                let q = g282_gate(i)?;
                match (acc) {
                    G282Acc { n, items, tag } => {
                        let seen = g282_survey(items) + g282_survey(items);
                        .Ok(G282Acc {
                            n: n + 1,
                            items: g282_add(c, items, i * 1 + 6 + seen % 7 + q),
                            tag,
                        })
                    },
                }
            },
            acc,
        )
}

fn g282_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g282<C: Allocator>(ctx: C): Str {
    match (g282_run(ctx, G282Acc { n: 0, items: list.empty<Str>(), tag: 42 }, 0, 800)) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.items.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g282_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
