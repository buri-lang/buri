from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G025Pair {
    items: [Str],
    also: [Int],
    n: Int,
}

fn g025_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g025_measure(items: [Str]): Int {
    items.length()
}

fn g025_step<C: Allocator>(ctx: C, acc: G025Pair, i: Int): G025Pair {
    let G025Pair { items, also, n } = acc;
    let held = items;
    let seen = g025_measure(held);
    G025Pair {
        items: held.concat(ctx, [g025_pick(i * 7 + 6 + seen % 7)]),
        also: also.push(ctx, i),
        n: n + 1,
    }
}

fn g025_run<C: Allocator>(ctx: C, acc: G025Pair, base: Int, count: Int): G025Pair {
    g025_runLoop(ctx, acc, base, base + count)
}

fn g025_runLoop<C: Allocator>(ctx: C, acc: G025Pair, i: Int, end: Int): G025Pair {
    if (i == end) { acc } else { g025_runLoop(ctx, g025_step(ctx, acc, i), i + 1, end) }
}

fn g025_rounds<C: Allocator>(ctx: C, acc: G025Pair, base: Int, count: Int): G025Pair {
    if (count == 0) {
        acc
    } else {
        let acc = g025_rounds(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g025_run(ctx, acc, i * 50, 50)
    }
}

fn g025_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g025<C: Allocator>(ctx: C): Str {
    let acc = g025_rounds(
        ctx,
        G025Pair { items: list.empty<Str>(), also: [], n: 0 },
        0,
        4,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g025_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.also.length()} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g025(host.alloc)).ignore();
    .Ok(())
