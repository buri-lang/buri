    .Ok((n + 1, items.push(ctx, str.fromInt(ctx, i * 1 + 1 + q))))
}

fn g025_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    g025_runLoop(ctx, acc, base, base + count)
}

fn g025_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): Result<(Int, [Str]), Str> {
