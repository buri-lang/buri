fn g025_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g025_step<C: Allocator>(ctx: C, acc: G025Acc, i: Int): G025Acc {
    let G025Acc { n, items, tag } = acc;
    let held = items;
    G025Acc { n: n + 1, items: held.push(ctx, g025_pick(i * 7 + 6)), tag }
}

fn g025_run<C: Allocator>(ctx: C, acc: G025Acc, base: Int, count: Int): G025Acc {
    g025_runLoop(ctx, acc, base, base + count)
}

fn g025_runLoop<C: Allocator>(ctx: C, acc: G025Acc, i: Int, end: Int): G025Acc {
    if (i == end) { acc } else { g025_runLoop(ctx, g025_step(ctx, acc, i), i + 1, end) }
}

fn g025_rounds<C: Allocator>(ctx: C, acc: G025Acc, base: Int, count: Int): G025Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g025_rounds(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g025_run(ctx, acc, i * 50, 50)
    }
}

fn g025_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g025<C: Allocator>(ctx: C): Str {
    let acc = g025_rounds(
        ctx,
        G025Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        4,
