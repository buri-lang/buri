fn g025_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g025<C: Allocator>(ctx: C): Str {
    match (g025_rounds(ctx, (0, list.empty<Str>()), 0, 4)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => "-",
