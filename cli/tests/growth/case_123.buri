fn g123_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g123_gate(i: Int): Result<Int, Str> {
    if (i == 232) { .Err("bad") } else { .Ok(i % 5) }
}

fn g123_step<C: Allocator>(ctx: C, acc: [Int], i: Int): Result<[Int], Str> {
    let q = g123_gate(i)?;
    let items = acc;
    let held = items;
    let seen = held.length();
    .Ok(if (i % 2 == 0) {
        g123_put(ctx, held, i * 3 + 1 + seen % 7 + q, 0)
    } else {
        g123_put(ctx, held, i * 3 + 1 + seen % 7 + q, 1)
    })
}

fn g123_run<C: Allocator>(
    ctx: C,
    acc: [Int],
    base: Int,
    count: Int,
): Result<[Int], Str> {
    g123_runLoop(ctx, acc, base, base + count)
}

fn g123_runLoop<C: Allocator>(
    ctx: C,
    acc: [Int],
    i: Int,
    end: Int,
): Result<[Int], Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g123_runLoop(ctx, g123_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g123_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g123<C: Allocator>(ctx: C): Str {
    match (g123_run(ctx, list.empty<Int>(), 0, 600)) {
        .Ok(acc) => {
            let first = match (acc.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g123_hash(acc);
            str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
