from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g255_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g255_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let (n, items) = acc;
    let held = items;
    (n + 1, held.push(ctx, g255_pick(i * 3 + 8)))
}

fn g255_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    g255_runLoop(ctx, acc, base, base + count)
}

fn g255_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
): (Int, [Str]) {
    if (i == end) { acc } else { g255_runLoop(ctx, g255_step(ctx, acc, i), i + 1, end) }
}

fn g255_rounds<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g255_run(c, acc, i * 50, 50), acc)
}

fn g255_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g255<C: Allocator>(ctx: C): Str {
    let acc = g255_rounds(ctx, (0, list.empty<Str>()), 0, 8);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g255_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g255(host.alloc)).ignore();
    .Ok(())
}
