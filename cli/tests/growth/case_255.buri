from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G255Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g255_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g255_step<C: Allocator>(ctx: C, acc: G255Acc, i: Int): G255Acc {
    let G255Acc { n, items, tag } = acc;
    let held = items;
    G255Acc { n: n + 1, items: held.push(ctx, g255_pick(i * 3 + 8)), tag }
}

fn g255_run<C: Allocator>(ctx: C, acc: G255Acc, base: Int, count: Int): G255Acc {
    g255_runLoop(ctx, acc, base, base + count)
}

fn g255_runLoop<C: Allocator>(ctx: C, acc: G255Acc, i: Int, end: Int): G255Acc {
    if (i == end) { acc } else { g255_runLoop(ctx, g255_step(ctx, acc, i), i + 1, end) }
}

fn g255_rounds<C: Allocator>(ctx: C, acc: G255Acc, base: Int, count: Int): G255Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g255_run(c, acc, i * 50, 50), acc)
}

fn g255_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g255<C: Allocator>(ctx: C): Str {
    let acc = g255_rounds(
        ctx,
        G255Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        8,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g255_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g255(host.alloc)).ignore();
    .Ok(())
