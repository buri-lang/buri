fn g146_run<C: Allocator>(ctx: C, acc: G146Acc, base: Int, count: Int): G146Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g146_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g146_step(ctx, acc, i)
