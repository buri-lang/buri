fn g253_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g253_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let held = acc;
    held.push(ctx, g253_pick(i * 3 + 3))
