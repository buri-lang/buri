from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G299Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g299_step<C: Allocator>(ctx: C, acc: G299Acc, i: Int): G299Acc {
    G299Acc { ..acc, n: acc.n + 1, items: acc.items.push(ctx, i * 3 + 8) }
}

fn g299_run<C: Allocator>(ctx: C, acc: G299Acc, base: Int, count: Int): G299Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g299_step(c, acc, i), acc)
}

fn g299_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g299<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g299_run(
                c,
                G299Acc { n: 0, items: list.empty<Int>(), tag: 42 },
                r * 100,
                100,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g299_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g299(host.alloc)).ignore();
    .Ok(())
}
