fn g105_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g105_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g105_pick(k)) }
}

fn g105_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let (n, items) = acc;
    let held = items;
    let seen = held.length();
    (
        n + 1,
        if (i % 2 == 0) {
            g105_put(ctx, held, i * 1 + 5 + seen % 7, 0)
        } else {
            g105_put(ctx, held, i * 1 + 5 + seen % 7, 1)
        },
    )
}

fn g105_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    g105_runLoop(ctx, acc, base, base + count)
}

fn g105_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
    end: Int,
