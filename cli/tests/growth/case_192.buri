    }
}

fn g192_run<C: Allocator>(ctx: C, acc: G192Outer, base: Int, count: Int): G192Outer {
    g192_runLoop(ctx, acc, base, base + count)
}

fn g192_runLoop<C: Allocator>(ctx: C, acc: G192Outer, i: Int, end: Int): G192Outer {
    if (i == end) { acc } else { g192_runLoop(ctx, g192_step(ctx, acc, i), i + 1, end) }
