from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g192_measure(items: [Int]): Int {
    items.length()
}

fn g192_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let held = acc.1;
    let seen = g192_measure(held);
    (acc.0 + 1, held.push(ctx, i * 1 + 6 + seen % 7))
}

fn g192_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    g192_runLoop(ctx, acc, base, base + count)
}

fn g192_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
    end: Int,
): (Int, [Int]) {
    if (i == end) { acc } else { g192_runLoop(ctx, g192_step(ctx, acc, i), i + 1, end) }
}

fn g192_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g192<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g192_run(c, (0, list.empty<Int>()), r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g192_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g192(host.alloc)).ignore();
    .Ok(())
}
