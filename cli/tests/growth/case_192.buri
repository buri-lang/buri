}

fn g192_step<C: Allocator>(ctx: C, acc: G192Outer, i: Int): G192Outer {
    match (acc) {
        G192Outer { inner, k } => {
            let held = inner;
            G192Outer { inner: g192_inner(ctx, held, i), k: k + 1 }
