}

fn g216_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    if (count == 0) {
        acc
    } else {
        let acc = g216_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g216_step(ctx, acc, i)
    }
}

fn g216_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g216<C: Allocator>(ctx: C): Str {
