fn g216_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g216_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
