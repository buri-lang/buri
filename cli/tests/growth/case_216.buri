// value=Ints acc=Record access=Match pusher=Large reader=Small alias=false inner=FoldLambda outer=None nest=None stop=false fail=holds
// expect: 1000 42 1000 6 7009 388382
// blocks: 32
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G216Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g216_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g216_measure(items: [Int]): Int {
    items.length()
}

fn g216_gate(i: Int): Result<Int, Str> {
    if (i == 1001) { .Err("bad") } else { .Ok(i % 5) }
}

fn g216_run<C: Allocator>(
    ctx: C,
    acc: G216Acc,
    base: Int,
    count: Int,
): Result<G216Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
            ctx,
            fn(c, acc: G216Acc, i) => {
                let q = g216_gate(i)?;
                match (acc) {
                    G216Acc { n, items, tag } => {
                        let seen = g216_measure(items);
                        .Ok(G216Acc {
                            n: n + 1,
                            items: if (i % 2 == 0) {
                                g216_put(c, items, i * 7 + 6 + seen % 7 + q, 0)
                            } else {
                                g216_put(c, items, i * 7 + 6 + seen % 7 + q, 1)
                            },
                            tag,
                        })
                    },
                }
            },
            acc,
        )
}

fn g216_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g216<C: Allocator>(ctx: C): Str {
    match (
        g216_run(ctx, G216Acc { n: 0, items: list.empty<Int>(), tag: 42 }, 0, 1000)
    ) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => -1,
            };
            let last = match (acc.items.last()) {
                .Some(x) => x,
                .None => -1,
            };
            let hash = g216_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g216(host.alloc)).ignore();
    .Ok(())
}
