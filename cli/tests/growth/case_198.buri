}

fn g198_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g198<C: Allocator>(ctx: C): Str {
    match (g198_run(ctx, (0, list.empty<Str>()), 0, 1000)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.1.last()) {
                .Some(x) => x,
                .None => "-",
