                ),
            )
        },
    }
}

fn g198_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g198_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g198_step(ctx, acc, i)
