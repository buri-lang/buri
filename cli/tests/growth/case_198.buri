from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G198Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g198_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g198_step<C: Allocator>(ctx: C, acc: G198Acc, i: Int): G198Acc {
    let seen = acc.items.length();
    G198Acc {
        ..acc,
        n: acc.n + 1,
        items: g198_add(ctx, acc.items, i * 7 + 1 + seen % 7),
    }
}

fn g198_run<C: Allocator>(ctx: C, acc: G198Acc, base: Int, count: Int): G198Acc {
    g198_runLoop(ctx, acc, base, base + count)
}

fn g198_runLoop<C: Allocator>(ctx: C, acc: G198Acc, i: Int, end: Int): G198Acc {
    if (i == end || acc.items.length() >= 475) {
        acc
    } else {
        g198_runLoop(ctx, g198_step(ctx, acc, i), i + 1, end)
    }
}

fn g198_rounds<C: Allocator>(ctx: C, acc: G198Acc, base: Int, count: Int): G198Acc {
    g198_roundsLoop(ctx, acc, base, base + count)
}

fn g198_roundsLoop<C: Allocator>(ctx: C, acc: G198Acc, i: Int, end: Int): G198Acc {
    if (i == end) {
        acc
    } else {
        g198_roundsLoop(ctx, g198_run(ctx, acc, i * 100, 100), i + 1, end)
    }
}

fn g198_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g198<C: Allocator>(ctx: C): Str {
    let acc = g198_rounds(
        ctx,
        G198Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        8,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g198_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
