fn g198_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g198_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g198_pick(k)) }
}

fn g198_gate(i: Int): Result<Int, Str> {
    if (i == 674) { .Err("bad") } else { .Ok(i % 5) }
}

fn g198_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): Result<(Int, Str), Str> {
    let q = g198_gate(i)?;
    match (acc) {
        (n, items) => {
            let seen = items.length();
            .Ok(
                (
                    n + 1,
                    if (i % 2 == 0) {
                        g198_put(ctx, items, i * 7 + 2 + seen % 7 + q, 0)
                    } else {
                        g198_put(ctx, items, i * 7 + 2 + seen % 7 + q, 1)
                    },
                ),
            )
        },
    }
}

fn g198_run<C: Allocator>(
    ctx: C,
    acc: (Int, Str),
    base: Int,
    count: Int,
): Result<(Int, Str), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g198_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g198_step(ctx, acc, i)
    }
}

fn g198_hash(items: Str): Int {
    g198_walk(items, 0, 7)
}

fn g198_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g198_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g198<C: Allocator>(ctx: C): Str {
    match (g198_run(ctx, (0, ""), 0, 1000)) {
        .Ok(acc) => {
            let size = acc.1.length();
            let first = acc.1.slice(0, 8);
            let last = acc.1.slice(size - 8, size);
            let hash = g198_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

