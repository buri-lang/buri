// Generated by `cli/tests/native/growth/generator.rs`; do not edit.
// value=Text acc=Record access=Match pusher=Small reader=Inline alias=false inner=Fold outer=None nest=None stop=true fail=holds
// expect: 73 42 151 bbbbbbbb bcccccca 781190
// blocks: 31
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G109Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g109_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g109_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g109_pick(code))
}

fn g109_gate(i: Int): Result<Int, Str> {
    if (i == 401) { .Err("bad") } else { .Ok(i % 5) }
}

fn g109_step<C: Allocator>(ctx: C, acc: G109Acc, i: Int): Result<G109Acc, Str> {
    if (acc.items.length() >= 151) {
        .Ok(acc)
    } else {
        let q = g109_gate(i)?;
        match (acc) {
            G109Acc { n, items, tag } => {
                let seen = items.length();
                .Ok(G109Acc {
                    n: n + 1,
                    items: g109_add(ctx, items, i * 3 + 4 + seen % 7 + q),
                    tag,
                })
            },
        }
    }
}

fn g109_run<C: Allocator>(
    ctx: C,
    acc: G109Acc,
    base: Int,
    count: Int,
): Result<G109Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g109_step(c, acc, i), acc)
}

fn g109_hash(items: Str): Int {
    g109_walk(items, 0, 7)
}

fn g109_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g109_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g109<C: Allocator>(ctx: C): Str {
    match (g109_run(ctx, G109Acc { n: 0, items: "", tag: 42 }, 0, 400)) {
        .Ok(acc) => {
            let size = acc.items.length();
            let first = acc.items.slice(0, 8);
            let last = acc.items.slice(size - 8, size);
            let hash = g109_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g109(host.alloc)).ignore();
    .Ok(())
}
