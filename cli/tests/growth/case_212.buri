from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G212Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g212_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g212_step<C: Allocator>(ctx: C, acc: G212Acc, i: Int): G212Acc {
    match (acc) {
        G212Acc { n, items, tag } => {
            let held = items;
            G212Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g212_put(ctx, held, i * 1 + 8, 0)
                } else {
                    g212_put(ctx, held, i * 1 + 8, 1)
                },
                tag,
            }
        },
    }
}

fn g212_run<C: Allocator>(ctx: C, acc: G212Acc, base: Int, count: Int): G212Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g212_step(c, acc, i), acc)
}

fn g212_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g212<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 4)
        .mapCtx(ctx, fn(c, r) => {
            g212_run(c, G212Acc { n: 0, items: list.empty<Str>(), tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g212_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g212(host.alloc)).ignore();
    .Ok(())
