struct G212Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g212_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

struct G212Outer {
    inner: G212Acc,
    k: Int,
}

fn g212_inner<C: Allocator>(ctx: C, acc: G212Acc, i: Int): G212Acc {
    match (acc) {
        G212Acc { n, items, tag } => {
            G212Acc { n: n + 1, items: g212_add(ctx, items, i * 3 + 4), tag }
        },
    }
}

fn g212_run<C: Allocator>(ctx: C, acc: G212Outer, base: Int, count: Int): G212Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(
            ctx,
            fn(c, acc: G212Outer, i) => {
                match (acc) {
                    G212Outer { inner, k } => {
                        G212Outer { inner: g212_inner(c, inner, i), k: k + 1 }
                    },
                }
