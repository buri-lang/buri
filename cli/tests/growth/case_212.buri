            acc,
        )
}

fn g212_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g212<C: Allocator>(ctx: C): Str {
    let acc = g212_run(
        ctx,
        G212Outer { inner: G212Acc { n: 0, items: list.empty<Int>(), tag: 42 }, k: 0 },
        0,
        1000,
