from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G256Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g256_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g256_step<C: Allocator>(ctx: C, acc: G256Acc, i: Int): G256Acc {
    let held = acc.items;
    G256Acc { ..acc, n: acc.n + 1, items: held.push(ctx, g256_pick(i * 3 + 4)) }
}

fn g256_run<C: Allocator>(ctx: C, acc: G256Acc, base: Int, count: Int): G256Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g256_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g256_step(ctx, acc, i)
    }
}

fn g256_rounds<C: Allocator>(ctx: C, acc: G256Acc, base: Int, count: Int): G256Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g256_run(c, acc, i * 50, 50), acc)
}

fn g256_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g256<C: Allocator>(ctx: C): Str {
    let acc = g256_rounds(
        ctx,
        G256Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        4,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g256_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g256(host.alloc)).ignore();
    .Ok(())
}
