}

fn g256_run<C: Allocator>(
    ctx: C,
    acc: (Int, [G256Row]),
    base: Int,
    count: Int,
): (Int, [G256Row]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g256_step(c, acc, i), acc)
}

fn g256_hash(items: [G256Row]): Int {
    items.fold(fn(h, x) => (h * 31 + x.id) % 1000003, 7)
}

fn g256<C: Allocator>(ctx: C): Str {
    let acc = g256_run(ctx, (0, []), 0, 600);
    let first = match (acc.1.first()) {
        .Some(x) => x.name,
        .None => "-1",
