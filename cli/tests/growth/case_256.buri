struct G256Row {
    id: Int,
    name: Str,
}

fn g256_survey(items: [G256Row]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g256_step<C: Allocator>(ctx: C, acc: (Int, [G256Row]), i: Int): (Int, [G256Row]) {
    if (acc.1.length() >= 287) {
        acc
    } else {
        let seen = g256_survey(acc.1) + g256_survey(acc.1);
        (
            acc.0 + 1,
            acc.1
                .push(ctx, G256Row {
                    id: i * 7 + 4 + seen % 7,
                    name: str.fromInt(ctx, i * 7 + 4 + seen % 7),
                })
                .push(ctx, G256Row {
                    id: i * 7 + 4 + seen % 7 + 1,
                    name: str.fromInt(ctx, i * 7 + 4 + seen % 7 + 1),
