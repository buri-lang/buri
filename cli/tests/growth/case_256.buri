from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g256_step<C: Allocator>(ctx: C, acc: [Int], i: Int): [Int] {
    let held = acc;
    held.push(ctx, i * 3 + 4)
}

fn g256_run<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    if (count == 0) {
        acc
    } else {
        let acc = g256_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g256_step(ctx, acc, i)
    }
}

fn g256_rounds<C: Allocator>(ctx: C, acc: [Int], base: Int, count: Int): [Int] {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g256_run(c, acc, i * 50, 50), acc)
}

fn g256_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g256<C: Allocator>(ctx: C): Str {
    let acc = g256_rounds(ctx, list.empty<Int>(), 0, 4);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g256_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

