}

fn g030_inner<C: Allocator>(ctx: C, acc: G030Acc, i: Int): G030Acc {
    let G030Acc { n, items, tag } = acc;
    let held = items;
    let seen = g030_survey(held) + g030_survey(held);
    G030Acc {
        n: n + 1,
        items: held.push(ctx, str.fromInt(ctx, i * 1 + 2 + seen % 7)),
