fn g030_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g030_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g030_pick(k)) }
}

fn g030_measure(items: Str): Int {
    items.length()
}

fn g030_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    let seen = g030_measure(held);
    if (i % 2 == 0) {
        g030_put(ctx, held, i * 3 + 3 + seen % 7, 0)
    } else {
        g030_put(ctx, held, i * 3 + 3 + seen % 7, 1)
    }
}

fn g030_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g030_runLoop(ctx, acc, base, base + count)
}

fn g030_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end) { acc } else { g030_runLoop(ctx, g030_step(ctx, acc, i), i + 1, end) }
}

fn g030_rounds<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g030_run(c, acc, i * 50, 50), acc)
}

fn g030_hash(items: Str): Int {
    g030_walk(items, 0, 7)
}

fn g030_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g030_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g030<C: Allocator>(ctx: C): Str {
    let acc = g030_rounds(ctx, "", 0, 4);
    let size = acc.length();
    let first = acc.slice(0, 8);
    let last = acc.slice(size - 8, size);
    let hash = g030_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

