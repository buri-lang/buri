}

fn g030_step<C: Allocator>(ctx: C, acc: G030Outer, i: Int): G030Outer {
    let G030Outer { inner, k } = acc;
    let held = inner;
    G030Outer { inner: g030_inner(ctx, held, i), k: k + 1 }
}

fn g030_run<C: Allocator>(ctx: C, acc: G030Outer, base: Int, count: Int): G030Outer {
    if (count == 0) {
        acc
    } else {
        let acc = g030_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g030_step(ctx, acc, i)
    }
}

fn g030_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g030<C: Allocator>(ctx: C): Str {
