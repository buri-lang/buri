fn g145_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g145_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g145_pick(k)) }
}

fn g145_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g145_step<C: Allocator>(ctx: C, acc: G145Acc, i: Int): G145Acc {
    let G145Acc { n, items, tag } = acc;
    let seen = g145_survey(items) + g145_survey(items);
    G145Acc {
        n: n + 1,
        items: if (i % 2 == 0) {
            g145_put(ctx, items, i * 7 + 4 + seen % 7, 0)
        } else {
            g145_put(ctx, items, i * 7 + 4 + seen % 7, 1)
        },
        tag,
    }
}

fn g145_run<C: Allocator>(ctx: C, acc: G145Acc, base: Int, count: Int): G145Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g145_step(c, acc, i), acc)
}

fn g145_hash(items: Str): Int {
    g145_walk(items, 0, 7)
}

fn g145_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g145_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
