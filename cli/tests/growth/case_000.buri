fn g000_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
    end: Int,
): (Int, [Int]) {
    if (i == end) { acc } else { g000_runLoop(ctx, g000_step(ctx, acc, i), i + 1, end) }
}

fn g000_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

