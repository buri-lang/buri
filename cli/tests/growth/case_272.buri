from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G272Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g272_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g272_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g272_pick(code))
}

fn g272_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g272_step<C: Allocator>(ctx: C, acc: G272Acc, i: Int): G272Acc {
    let held = acc.items;
    let seen = g272_survey(held) + g272_survey(held);
    G272Acc { ..acc, n: acc.n + 1, items: g272_add(ctx, held, i * 3 + 3 + seen % 7) }
}

fn g272_run<C: Allocator>(ctx: C, acc: G272Acc, base: Int, count: Int): G272Acc {
    g272_runLoop(ctx, acc, base, base + count)
}

fn g272_runLoop<C: Allocator>(ctx: C, acc: G272Acc, i: Int, end: Int): G272Acc {
    if (i == end) { acc } else { g272_runLoop(ctx, g272_step(ctx, acc, i), i + 1, end) }
}

fn g272_hash(items: Str): Int {
    g272_walk(items, 0, 7)
}

fn g272_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g272_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g272<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g272_run(c, G272Acc { n: 0, items: "", tag: 42 }, r * 150, 150)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g272_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g272(host.alloc)).ignore();
    .Ok(())
