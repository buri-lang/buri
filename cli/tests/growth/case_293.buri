struct G293Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g293_step<C: Allocator>(ctx: C, acc: G293Acc, i: Int): G293Acc {
    let G293Acc { n, items, tag } = acc;
    let seen = items.length();
    G293Acc { n: n + 1, items: items.push(ctx, i * 7 + 5 + seen % 7), tag }
}

fn g293_run<C: Allocator>(ctx: C, acc: G293Acc, base: Int, count: Int): G293Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g293_step(c, acc, i), acc)
}

fn g293_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g293<C: Allocator>(ctx: C): Str {
    let acc = g293_run(
        ctx,
        G293Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
