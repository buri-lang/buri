fn g217_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g217_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g217_pick(code))
}

fn g217_step<C: Allocator>(ctx: C, acc: G217Acc, i: Int): G217Acc {
    match (acc) {
        G217Acc { n, items, tag } => {
            let held = items;
            G217Acc { n: n + 1, items: g217_add(ctx, held, i * 1 + 0), tag }
        },
    }
}

fn g217_run<C: Allocator>(ctx: C, acc: G217Acc, base: Int, count: Int): G217Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g217_step(c, acc, i), acc)
}

fn g217_hash(items: Str): Int {
    g217_walk(items, 0, 7)
}

fn g217_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g217_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
