from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G130Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g130_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g130_step<C: Allocator>(ctx: C, acc: G130Acc, i: Int): G130Acc {
    let seen = acc.items.length();
    G130Acc {
        ..acc,
        n: acc.n + 1,
        items: g130_add(ctx, acc.items, i * 7 + 7 + seen % 7),
    }
}

fn g130_run<C: Allocator>(ctx: C, acc: G130Acc, base: Int, count: Int): G130Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g130_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g130_step(ctx, acc, i)
    }
}

fn g130_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g130<C: Allocator>(ctx: C): Str {
    let acc = g130_run(
        ctx,
        G130Acc { n: 0, items: list.empty<Int>(), tag: 42 },
        0,
        800,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g130_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g130(host.alloc)).ignore();
    .Ok(())
}
