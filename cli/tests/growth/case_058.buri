        _ => {
            if (i % 2 == 0) {
                g058_put(ctx, held, i * 3 + 3 + seen % 7 + 1, 0)
            } else {
                g058_put(ctx, held, i * 3 + 3 + seen % 7 + 1, 1)
            }
        },
    }
}

fn g058_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
