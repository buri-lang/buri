struct G182Pair {
    items: [Int],
    also: [Int],
    n: Int,
}

fn g182_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g182_step<C: Allocator>(ctx: C, acc: G182Pair, i: Int): G182Pair {
    let G182Pair { items, also, n } = acc;
    let seen = items.length();
    G182Pair {
        items: if (i % 2 == 0) {
            g182_put(ctx, items, i * 3 + 2 + seen % 7, 0)
        } else {
            g182_put(ctx, items, i * 3 + 2 + seen % 7, 1)
        },
        also: also.push(ctx, i),
        n: n + 1,
    }
}

fn g182_run<C: Allocator>(ctx: C, acc: G182Pair, base: Int, count: Int): G182Pair {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g182_step(c, acc, i), acc)
}

fn g182_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g182<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => {
            g182_run(
                c,
                G182Pair { items: list.empty<Int>(), also: [], n: 0 },
                r * 150,
                150,
