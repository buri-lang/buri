struct G182Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g182_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g182_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g182_pick(k)) }
}

fn g182_run<C: Allocator>(ctx: C, acc: G182Acc, base: Int, count: Int): G182Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(
            ctx,
            fn(c, acc: G182Acc, i) => {
                match (acc) {
                    G182Acc { n, items, tag } => {
                        let held = items;
                        G182Acc {
                            n: n + 1,
                            items: if (i % 2 == 0) {
                                g182_put(c, held, i * 3 + 3, 0)
                            } else {
                                g182_put(c, held, i * 3 + 3, 1)
                            },
                            tag,
                        }
                    },
                }
            },
            acc,
        )
}

fn g182_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g182<C: Allocator>(ctx: C): Str {
    let acc = g182_run(
        ctx,
        G182Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        1000,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
