from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g110_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g110_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g110_pick(code))
}

fn g110_step<C: Allocator>(ctx: C, acc: (Int, Str), i: Int): (Int, Str) {
    let (n, items) = acc;
    let held = items;
    let seen = held.length();
    (n + 1, g110_add(ctx, held, i * 1 + 0 + seen % 7))
}

fn g110_run<C: Allocator>(ctx: C, acc: (Int, Str), base: Int, count: Int): (Int, Str) {
    g110_runLoop(ctx, acc, base, base + count)
}

fn g110_runLoop<C: Allocator>(ctx: C, acc: (Int, Str), i: Int, end: Int): (Int, Str) {
    if (i == end) { acc } else { g110_runLoop(ctx, g110_step(ctx, acc, i), i + 1, end) }
}

fn g110_hash(items: Str): Int {
    g110_walk(items, 0, 7)
}

fn g110_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g110_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g110<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g110_run(c, (0, ""), r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.1.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g110_hash(acc.1)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g110(host.alloc)).ignore();
    .Ok(())
}
