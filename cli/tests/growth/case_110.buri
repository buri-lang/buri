fn g110_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g110_add<C: Allocator>(ctx: C, items: Str, code: Int): Str {
    items.concat(ctx, g110_pick(code))
}

fn g110_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g110_step<C: Allocator>(ctx: C, acc: G110Acc, i: Int): G110Acc {
    let seen = g110_survey(acc.items) + g110_survey(acc.items);
    G110Acc {
        ..acc,
        n: acc.n + 1,
        items: g110_add(ctx, acc.items, i * 7 + 8 + seen % 7),
    }
}

fn g110_run<C: Allocator>(ctx: C, acc: G110Acc, base: Int, count: Int): G110Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g110_step(c, acc, i), acc)
}

fn g110_hash(items: Str): Int {
    g110_walk(items, 0, 7)
}

fn g110_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g110_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
