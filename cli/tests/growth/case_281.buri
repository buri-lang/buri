struct G281Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g281_put<C: Allocator>(ctx: C, items: [Int], code: Int, salt: Int): [Int] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, k) }
}

fn g281_measure(items: [Int]): Int {
    items.length()
}

struct G281Outer {
    inner: G281Acc,
    k: Int,
}

fn g281_inner<C: Allocator>(ctx: C, acc: G281Acc, i: Int): G281Acc {
    let held = acc.items;
    let seen = g281_measure(held);
    G281Acc {
        ..acc,
        n: acc.n + 1,
        items: if (i % 2 == 0) {
            g281_put(ctx, held, i * 3 + 9 + seen % 7, 0)
        } else {
            g281_put(ctx, held, i * 3 + 9 + seen % 7, 1)
        },
    }
}

fn g281_step<C: Allocator>(ctx: C, acc: G281Outer, i: Int): G281Outer {
    if (acc.inner.items.length() >= 337) {
        acc
    } else {
        let held = acc.inner;
        G281Outer { ..acc, k: acc.k + 1, inner: g281_inner(ctx, held, i) }
    }
}

fn g281_run<C: Allocator>(ctx: C, acc: G281Outer, base: Int, count: Int): G281Outer {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g281_step(c, acc, i), acc)
}

fn g281_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g281<C: Allocator>(ctx: C): Str {
