// blocks: 32
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G281Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g281_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g281_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g281_pick(k)) }
}

fn g281_measure(items: [Str]): Int {
    items.length()
}

fn g281_step<C: Allocator>(ctx: C, acc: G281Acc, i: Int): G281Acc {
    if (acc.items.length() >= 337) {
        acc
    } else {
        let held = acc.items;
        let seen = g281_measure(held);
        G281Acc {
            ..acc,
            n: acc.n + 1,
            items: if (i % 2 == 0) {
                g281_put(ctx, held, i * 3 + 9 + seen % 7, 0)
            } else {
                g281_put(ctx, held, i * 3 + 9 + seen % 7, 1)
            },
        }
    }
}

fn g281_run<C: Allocator>(ctx: C, acc: G281Acc, base: Int, count: Int): G281Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g281_step(c, acc, i), acc)
}

fn g281_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g281<C: Allocator>(ctx: C): Str {
    let acc = g281_run(
        ctx,
        G281Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        800,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g281_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g281(host.alloc)).ignore();
    .Ok(())
}
