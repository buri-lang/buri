from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G245Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g245_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g245_survey(items: [Str]): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g245_step<C: Allocator>(ctx: C, acc: G245Acc, i: Int): G245Acc {
    let G245Acc { n, items, tag } = acc;
    let held = items;
    let seen = g245_survey(held) + g245_survey(held);
    G245Acc { n: n + 1, items: g245_add(ctx, held, i * 3 + 7 + seen % 7), tag }
}

fn g245_run<C: Allocator>(ctx: C, acc: G245Acc, base: Int, count: Int): G245Acc {
    g245_runLoop(ctx, acc, base, base + count)
}

fn g245_runLoop<C: Allocator>(ctx: C, acc: G245Acc, i: Int, end: Int): G245Acc {
    if (i == end) { acc } else { g245_runLoop(ctx, g245_step(ctx, acc, i), i + 1, end) }
}

fn g245_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g245<C: Allocator>(ctx: C): Str {
    let acc = g245_run(
        ctx,
        G245Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        1000,
    );
    let first = match (acc.items.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.items.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g245_hash(acc.items);
    str.format(
        ctx,
        "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g245(host.alloc)).ignore();
    .Ok(())
}
