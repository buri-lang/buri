fn g225_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g225_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g225_pick(k)) }
}

fn g225_measure(items: Str): Int {
    items.length()
}

fn g225_gate(i: Int): Result<Int, Str> {
    if (i == 648) { .Err("bad") } else { .Ok(i % 5) }
}

fn g225_step<C: Allocator>(ctx: C, acc: G225Box, i: Int): Result<G225Box, Str> {
    if (acc.items().length() >= 611) {
        .Ok(acc)
    } else {
        let q = g225_gate(i)?;
        match (acc) {
            .Full(n, items) => {
                let held = items;
                let seen = g225_measure(held);
                .Ok(
                    G225Box.Full(n + 1, if (i % 2 == 0) {
                        g225_put(ctx, held, i * 7 + 2 + seen % 7 + q, 0)
                    } else {
                        g225_put(ctx, held, i * 7 + 2 + seen % 7 + q, 1)
                    }),
