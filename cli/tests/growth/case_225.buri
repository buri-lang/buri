}

fn g225_run<C: Allocator>(
    ctx: C,
    acc: G225Box,
    base: Int,
    count: Int,
): Result<G225Box, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g225_step(c, acc, i), acc)
}

fn g225_hash(items: Str): Int {
    g225_walk(items, 0, 7)
}

fn g225_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g225_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g225<C: Allocator>(ctx: C): Str {
    match (g225_run(ctx, G225Box.Full(0, ""), 0, 1000)) {
        .Ok(acc) => {
            let size = acc.items().length();
            let first = acc.items().slice(0, 8);
            let last = acc.items().slice(size - 8, size);
            let hash = g225_hash(acc.items());
            str.format(
                ctx,
                "${acc.count()} ${acc.items().length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

