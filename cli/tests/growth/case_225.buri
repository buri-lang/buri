// Generated by `cli/tests/native/growth/generator.rs`; do not edit.
// value=Text acc=Record access=Match pusher=Large reader=Small alias=true inner=Fold outer=None nest=None snapshot=false stop=true fail=fires
// expect: 327 42 611 ccccccaa abbbbbba 594688
// blocks: 32
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G225Acc {
    n: Int,
    items: Str,
    tag: Int,
}

fn g225_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g225_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g225_pick(k)) }
}

fn g225_measure(items: Str): Int {
    items.length()
}

fn g225_gate(i: Int): Result<Int, Str> {
    if (i == 648) { .Err("bad") } else { .Ok(i % 5) }
}

fn g225_step<C: Allocator>(ctx: C, acc: G225Acc, i: Int): Result<G225Acc, Str> {
    if (acc.items.length() >= 611) {
        .Ok(acc)
    } else {
        let q = g225_gate(i)?;
        match (acc) {
            G225Acc { n, items, tag } => {
                let held = items;
                let seen = g225_measure(held);
                .Ok(G225Acc {
                    n: n + 1,
                    items: if (i % 2 == 0) {
                        g225_put(ctx, held, i * 7 + 2 + seen % 7 + q, 0)
                    } else {
                        g225_put(ctx, held, i * 7 + 2 + seen % 7 + q, 1)
                    },
                    tag,
                })
            },
        }
    }
}

fn g225_run<C: Allocator>(
    ctx: C,
    acc: G225Acc,
    base: Int,
    count: Int,
): Result<G225Acc, Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(ctx, fn(c, acc, i) => g225_step(c, acc, i), acc)
}

fn g225_hash(items: Str): Int {
    g225_walk(items, 0, 7)
}

fn g225_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g225_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g225<C: Allocator>(ctx: C): Str {
    match (g225_run(ctx, G225Acc { n: 0, items: "", tag: 42 }, 0, 1000)) {
        .Ok(acc) => {
            let size = acc.items.length();
            let first = acc.items.slice(0, 8);
            let last = acc.items.slice(size - 8, size);
            let hash = g225_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g225(host.alloc)).ignore();
    .Ok(())
}
