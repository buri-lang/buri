}

fn g116_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    g116_runLoop(ctx, acc, base, base + count)
}

fn g116_runLoop<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    i: Int,
    end: Int,
): (Int, [Int]) {
    if (i == end) { acc } else { g116_runLoop(ctx, g116_step(ctx, acc, i), i + 1, end) }
}

fn g116_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g116<C: Allocator>(ctx: C): Str {
