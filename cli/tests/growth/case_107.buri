fn g107_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g107_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g107_pick(k)) }
}

fn g107_step<C: Allocator>(ctx: C, acc: (Int, [Str]), i: Int): (Int, [Str]) {
    let (n, items) = acc;
    let held = items;
    let seen = held.length();
    (
        n + 1,
        if (i % 2 == 0) {
            g107_put(ctx, held, i * 7 + 9 + seen % 7, 0)
        } else {
            g107_put(ctx, held, i * 7 + 9 + seen % 7, 1)
        },
    )
}

fn g107_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): (Int, [Str]) {
    if (count == 0) {
        acc
    } else {
        let acc = g107_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g107_step(ctx, acc, i)
    }
}

fn g107_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g107<C: Allocator>(ctx: C): Str {
    let mid = g107_run(ctx, (0, list.empty<Str>()), 0, 500);
    let acc = g107_run(ctx, mid, 500, 500);
    let kept = g107_hash(mid.1);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g107_hash(acc.1);
    str.format(
        ctx,
        "${acc.0} ${acc.1.length()} ${first} ${last} ${hash} | ${mid.1.length()} ${kept}",
    )
}

export fn main(host: NativeHost): Result<(), Str> {
