fn g197_gate(i: Int): Result<Int, Str> {
    if (i == 201) { .Err("bad") } else { .Ok(i % 5) }
}

fn g197_step<C: Allocator>(ctx: C, acc: [Str], i: Int): Result<[Str], Str> {
    let q = g197_gate(i)?;
    let items = acc;
    let held = items;
    .Ok(held.push(ctx, str.fromInt(ctx, i * 1 + 5 + q)))
}

fn g197_run<C: Allocator>(
    ctx: C,
    acc: [Str],
    base: Int,
    count: Int,
): Result<[Str], Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g197_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g197_step(ctx, acc, i)
    }
}

fn g197_rounds<C: Allocator>(
    ctx: C,
    acc: [Str],
    base: Int,
    count: Int,
): Result<[Str], Str> {
    if (count == 0) {
        .Ok(acc)
