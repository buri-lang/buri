from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G181Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g181_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g181_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, g181_pick(k)) }
}

fn g181_measure(items: [Str]): Int {
    items.length()
}

fn g181_step<C: Allocator>(ctx: C, acc: G181Acc, i: Int): G181Acc {
    match (acc) {
        G181Acc { n, items, tag } => {
            let seen = g181_measure(items);
            G181Acc {
                n: n + 1,
                items: if (i % 2 == 0) {
                    g181_put(ctx, items, i * 1 + 3 + seen % 7, 0)
                } else {
                    g181_put(ctx, items, i * 1 + 3 + seen % 7, 1)
                },
                tag,
            }
        },
    }
}

fn g181_run<C: Allocator>(ctx: C, acc: G181Acc, base: Int, count: Int): G181Acc {
    g181_runLoop(ctx, acc, base, base + count)
}

fn g181_runLoop<C: Allocator>(ctx: C, acc: G181Acc, i: Int, end: Int): G181Acc {
    if (i == end) { acc } else { g181_runLoop(ctx, g181_step(ctx, acc, i), i + 1, end) }
}

fn g181_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g181<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g181_run(
                c,
                G181Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                r * 150,
                150,
            )
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g181_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g181(host.alloc)).ignore();
    .Ok(())
