from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g181_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g181_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g181_pick(k)) }
}

fn g181_measure(items: Str): Int {
    items.length()
}

fn g181_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let seen = g181_measure(acc);
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g181_put(ctx, acc, i * 1 + 3 + seen % 7, 0)
            } else {
                g181_put(ctx, acc, i * 1 + 3 + seen % 7, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g181_put(ctx, acc, i * 1 + 3 + seen % 7 + 1, 0)
            } else {
                g181_put(ctx, acc, i * 1 + 3 + seen % 7 + 1, 1)
            }
        },
    }
}

fn g181_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g181_runLoop(ctx, acc, base, base + count)
}

fn g181_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end) { acc } else { g181_runLoop(ctx, g181_step(ctx, acc, i), i + 1, end) }
}

fn g181_hash(items: Str): Int {
    g181_walk(items, 0, 7)
}

fn g181_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g181_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g181<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => g181_run(c, "", r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g181_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g181(host.alloc)).ignore();
    .Ok(())
}
