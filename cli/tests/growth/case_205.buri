}

fn g205_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    let seen = g205_measure(held);
    if (i % 2 == 0) {
        g205_put(ctx, held, i * 7 + 3 + seen % 7, 0)
    } else {
        g205_put(ctx, held, i * 7 + 3 + seen % 7, 1)
    }
}

fn g205_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    if (count == 0) {
        acc
    } else {
        let acc = g205_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g205_step(ctx, acc, i)
