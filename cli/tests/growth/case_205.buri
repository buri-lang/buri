}

fn g205_rounds<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    g205_roundsLoop(ctx, acc, base, base + count)
}

fn g205_roundsLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
