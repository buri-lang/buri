fn g219_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g219_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, g219_pick(code))
}

fn g219_gate(i: Int): Result<Int, Str> {
    if (i == 540) { .Err("bad") } else { .Ok(i % 5) }
}

fn g219_step<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    i: Int,
): Result<(Int, [Str]), Str> {
    let q = g219_gate(i)?;
    let seen = acc.1.length();
    .Ok((acc.0 + 1, g219_add(ctx, acc.1, i * 1 + 7 + seen % 7 + q)))
}

fn g219_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Str]),
    base: Int,
    count: Int,
): Result<(Int, [Str]), Str> {
    if (count == 0) {
        .Ok(acc)
    } else {
        let acc = g219_run(ctx, acc, base, count - 1)?;
        let i = base + count - 1;
        g219_step(ctx, acc, i)
