}

fn g219_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g219<C: Allocator>(ctx: C): Str {
    match (g219_run(ctx, (0, list.empty<Str>()), 0, 1000)) {
        .Ok(acc) => {
            let first = match (acc.1.first()) {
                .Some(x) => x,
                .None => "-",
