from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G144Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g144_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g144_gate(i: Int): Result<Int, Str> {
    if (i == 189) { .Err("bad") } else { .Ok(i % 5) }
}

struct G144Outer {
    inner: G144Acc,
    k: Int,
}

fn g144_inner<C: Allocator>(ctx: C, acc: G144Acc, i: Int): Result<G144Acc, Str> {
    let q = g144_gate(i)?;
    .Ok(G144Acc { ..acc, n: acc.n + 1, items: g144_add(ctx, acc.items, i * 1 + 0 + q) })
}

fn g144_step<C: Allocator>(ctx: C, acc: G144Outer, i: Int): Result<G144Outer, Str> {
    .Ok(G144Outer { ..acc, k: acc.k + 1, inner: g144_inner(ctx, acc.inner, i)? })
}

fn g144_run<C: Allocator>(
    ctx: C,
    acc: G144Outer,
    base: Int,
    count: Int,
): Result<G144Outer, Str> {
    g144_runLoop(ctx, acc, base, base + count)
}

fn g144_runLoop<C: Allocator>(
    ctx: C,
    acc: G144Outer,
    i: Int,
    end: Int,
): Result<G144Outer, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g144_runLoop(ctx, g144_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g144_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g144<C: Allocator>(ctx: C): Str {
    match (
        g144_run(
            ctx,
            G144Outer {
                inner: G144Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                k: 0,
            },
            0,
            400,
        )
    ) {
        .Ok(acc) => {
            let first = match (acc.inner.items.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.inner.items.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g144_hash(acc.inner.items);
            str.format(
                ctx,
                "${acc.k} ${acc
                    .inner
                    .n} ${acc
                    .inner
                    .tag} ${acc.inner.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g144(host.alloc)).ignore();
    .Ok(())
}
