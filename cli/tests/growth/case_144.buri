from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G144Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g144_gate(i: Int): Result<Int, Str> {
    if (i == 189) { .Err("bad") } else { .Ok(i % 5) }
}

fn g144_step<C: Allocator>(ctx: C, acc: G144Acc, i: Int): Result<G144Acc, Str> {
    let q = g144_gate(i)?;
    .Ok(G144Acc {
        ..acc,
        n: acc.n + 1,
        items: acc.items.push(ctx, str.fromInt(ctx, i * 1 + 0 + q)),
    })
}

fn g144_run<C: Allocator>(
    ctx: C,
    acc: G144Acc,
    base: Int,
    count: Int,
): Result<G144Acc, Str> {
    g144_runLoop(ctx, acc, base, base + count)
}

fn g144_runLoop<C: Allocator>(
    ctx: C,
    acc: G144Acc,
    i: Int,
    end: Int,
): Result<G144Acc, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g144_runLoop(ctx, g144_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g144_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g144<C: Allocator>(ctx: C): Str {
    match (g144_run(ctx, G144Acc { n: 0, items: list.empty<Str>(), tag: 42 }, 0, 400)) {
        .Ok(acc) => {
            let first = match (acc.items.first()) {
                .Some(x) => x,
                .None => "-",
            };
            let last = match (acc.items.last()) {
                .Some(x) => x,
                .None => "-",
            };
            let hash = g144_hash(acc.items);
            str.format(
                ctx,
                "${acc.n} ${acc.tag} ${acc.items.length()} ${first} ${last} ${hash}",
            )
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g144(host.alloc)).ignore();
    .Ok(())
}
