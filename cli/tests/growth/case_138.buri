from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G138Acc {
    n: Int,
    items: [Int],
    tag: Int,
}

fn g138_step<C: Allocator>(ctx: C, acc: G138Acc, i: Int): G138Acc {
    if (acc.items.length() >= 462) {
        acc
    } else {
        let held = acc.items;
        G138Acc { ..acc, n: acc.n + 1, items: held.push(ctx, i * 1 + 3) }
    }
}

fn g138_run<C: Allocator>(ctx: C, acc: G138Acc, base: Int, count: Int): G138Acc {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g138_step(c, acc, i), acc)
}

fn g138_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g138<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 16)
        .mapCtx(ctx, fn(c, r) => {
            g138_run(c, G138Acc { n: 0, items: list.empty<Int>(), tag: 42 }, r * 50, 50)
        });
    let lengths = all.fold(fn(t, acc) => t + acc.items.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g138_hash(acc.items)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
