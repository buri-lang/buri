        },
    }
}

fn g048_step<C: Allocator>(ctx: C, acc: G048Outer, i: Int): Result<G048Outer, Str> {
    match (acc) {
        G048Outer { inner, k } => {
            let held = inner;
            .Ok(G048Outer { inner: g048_inner(ctx, held, i)?, k: k + 1 })
