from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g048_add<C: Allocator>(ctx: C, items: [Int], code: Int): [Int] {
    items.push(ctx, code)
}

fn g048_step<C: Allocator>(ctx: C, acc: (Int, [Int]), i: Int): (Int, [Int]) {
    let held = acc.1;
    let seen = held.length();
    (acc.0 + 1, g048_add(ctx, held, i * 3 + 5 + seen % 7))
}

fn g048_run<C: Allocator>(
    ctx: C,
    acc: (Int, [Int]),
    base: Int,
    count: Int,
): (Int, [Int]) {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g048_step(c, acc, i), acc)
}

fn g048_hash(items: [Int]): Int {
    items.fold(fn(h, x) => (h * 31 + x) % 1000003, 7)
}

fn g048<C: Allocator>(ctx: C): Str {
    let acc = g048_run(ctx, (0, list.empty<Int>()), 0, 400);
    let first = match (acc.1.first()) {
        .Some(x) => x,
        .None => -1,
    };
    let last = match (acc.1.last()) {
        .Some(x) => x,
        .None => -1,
    };
    let hash = g048_hash(acc.1);
    str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
}

