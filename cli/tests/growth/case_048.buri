            let seen = held.length();
            .Ok(G048Acc {
                n: n + 1,
                items: held
                    .push(ctx, g048_pick(i * 1 + 1 + seen % 7 + q))
                    .push(ctx, g048_pick(i * 1 + 1 + seen % 7 + q + 1)),
