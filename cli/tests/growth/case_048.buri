fn g048_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g048<C: Allocator>(ctx: C): Str {
    match (
        g048_rounds(
            ctx,
            G048Outer {
                inner: G048Acc { n: 0, items: list.empty<Str>(), tag: 42 },
                k: 0,
            },
            0,
            16,
        )
    ) {
        .Ok(acc) => {
            let first = match (acc.inner.items.first()) {
                .Some(x) => x,
                .None => "-",
