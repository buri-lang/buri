from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g233_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g233_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g233_pick(k)) }
}

fn g233_measure(items: Str): Int {
    items.length()
}

fn g233_gate(i: Int): Result<Int, Str> {
    if (i == 120) { .Err("bad") } else { .Ok(i % 5) }
}

fn g233_run<C: Allocator>(
    ctx: C,
    acc: (Int, Str),
    base: Int,
    count: Int,
): Result<(Int, Str), Str> {
    list
        .range(ctx, base, base + count)
        .foldResultCtx(
            ctx,
            fn(c, acc: (Int, Str), i) => {
                if (acc.1.length() >= 166) {
                    .Ok(acc)
                } else {
                    let q = g233_gate(i)?;
                    let (n, items) = acc;
                    let seen = g233_measure(items);
                    .Ok(
                        (
                            n + 1,
                            if (i % 2 == 0) {
                                g233_put(c, items, i * 3 + 1 + seen % 7 + q, 0)
                            } else {
                                g233_put(c, items, i * 3 + 1 + seen % 7 + q, 1)
                            },
                        ),
                    )
                }
            },
            acc,
        )
}

fn g233_hash(items: Str): Int {
    g233_walk(items, 0, 7)
}

fn g233_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g233_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g233<C: Allocator>(ctx: C): Str {
    match (g233_run(ctx, (0, ""), 0, 400)) {
        .Ok(acc) => {
            let size = acc.1.length();
            let first = acc.1.slice(0, 8);
            let last = acc.1.slice(size - 8, size);
            let hash = g233_hash(acc.1);
            str.format(ctx, "${acc.0} ${acc.1.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g233(host.alloc)).ignore();
