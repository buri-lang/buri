fn g242_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g242_survey(items: Str): Int {
    let size = items.length();
    if (size == 0) { 0 } else if (size % 2 == 0) { size } else { size + 0 }
}

fn g242_step<C: Allocator>(ctx: C, acc: G242Acc, i: Int): G242Acc {
    let seen = g242_survey(acc.items) + g242_survey(acc.items);
    G242Acc {
        ..acc,
        n: acc.n + 1,
        items: acc.items.concat(ctx, g242_pick(i * 7 + 2 + seen % 7)),
    }
}

fn g242_run<C: Allocator>(ctx: C, acc: G242Acc, base: Int, count: Int): G242Acc {
    if (count == 0) {
        acc
    } else {
        let acc = g242_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g242_step(ctx, acc, i)
