from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

struct G032Acc {
    n: Int,
    items: [Str],
    tag: Int,
}

fn g032_add<C: Allocator>(ctx: C, items: [Str], code: Int): [Str] {
    items.push(ctx, str.fromInt(ctx, code))
}

fn g032_measure(items: [Str]): Int {
    items.length()
}

fn g032_step<C: Allocator>(ctx: C, acc: G032Acc, i: Int): G032Acc {
    let G032Acc { n, items, tag } = acc;
    let held = items;
    let seen = g032_measure(held);
    G032Acc { n: n + 1, items: g032_add(ctx, held, i * 3 + 1 + seen % 7), tag }
}

fn g032_run<C: Allocator>(ctx: C, acc: G032Acc, base: Int, count: Int): G032Acc {
    g032_runLoop(ctx, acc, base, base + count)
}

fn g032_runLoop<C: Allocator>(ctx: C, acc: G032Acc, i: Int, end: Int): G032Acc {
    if (i == end) { acc } else { g032_runLoop(ctx, g032_step(ctx, acc, i), i + 1, end) }
}

fn g032_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g032<C: Allocator>(ctx: C): Str {
    let acc = g032_run(
        ctx,
        G032Acc { n: 0, items: list.empty<Str>(), tag: 42 },
        0,
        800,
