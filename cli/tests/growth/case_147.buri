from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g147_put<C: Allocator>(ctx: C, items: [Str], code: Int, salt: Int): [Str] {
    let k = code + salt;
    if (k < 0) { items } else { items.push(ctx, str.fromInt(ctx, k)) }
}

fn g147_step<C: Allocator>(ctx: C, acc: [Str], i: Int): [Str] {
    let items = acc;
    if (i % 2 == 0) {
        g147_put(ctx, items, i * 1 + 5, 0)
    } else {
        g147_put(ctx, items, i * 1 + 5, 1)
    }
}

fn g147_run<C: Allocator>(ctx: C, acc: [Str], base: Int, count: Int): [Str] {
    list
        .range(ctx, base, base + count)
        .foldCtx(ctx, fn(c, acc, i) => g147_step(c, acc, i), acc)
}

fn g147_hash(items: [Str]): Int {
    items.fold(fn(h, x) => (h * 31 + x.length()) % 1000003, 7)
}

fn g147<C: Allocator>(ctx: C): Str {
    let acc = g147_run(ctx, list.empty<Str>(), 0, 800);
    let first = match (acc.first()) {
        .Some(x) => x,
        .None => "-",
    };
    let last = match (acc.last()) {
        .Some(x) => x,
        .None => "-",
    };
    let hash = g147_hash(acc);
    str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g147(host.alloc)).ignore();
    .Ok(())
