}

fn g150_run<C: Allocator>(
    ctx: C,
    acc: G150Acc,
    base: Int,
    count: Int,
): Result<G150Acc, Str> {
    g150_runLoop(ctx, acc, base, base + count)
}

fn g150_runLoop<C: Allocator>(
    ctx: C,
    acc: G150Acc,
    i: Int,
    end: Int,
