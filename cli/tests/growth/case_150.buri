from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g150_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g150_put<C: Allocator>(ctx: C, items: Str, code: Int, salt: Int): Str {
    let k = code + salt;
    if (k < 0) { items } else { items.concat(ctx, g150_pick(k)) }
}

fn g150_step<C: Allocator>(ctx: C, acc: Str, i: Int): Str {
    let held = acc;
    let seen = held.length();
    match (i % 2) {
        0 => {
            if (i % 2 == 0) {
                g150_put(ctx, held, i * 1 + 3 + seen % 7, 0)
            } else {
                g150_put(ctx, held, i * 1 + 3 + seen % 7, 1)
            }
        },
        _ => {
            if (i % 2 == 0) {
                g150_put(ctx, held, i * 1 + 3 + seen % 7 + 1, 0)
            } else {
                g150_put(ctx, held, i * 1 + 3 + seen % 7 + 1, 1)
            }
        },
    }
}

fn g150_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Str {
    if (count == 0) {
        acc
    } else {
        let acc = g150_run(ctx, acc, base, count - 1);
        let i = base + count - 1;
        g150_step(ctx, acc, i)
    }
}

fn g150_hash(items: Str): Int {
    g150_walk(items, 0, 7)
}

fn g150_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g150_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g150<C: Allocator>(ctx: C): Str {
    let all = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, r) => g150_run(c, "", r * 150, 150));
    let lengths = all.fold(fn(t, acc) => t + acc.length(), 0);
    let hashes = all.fold(fn(t, acc) => (t + g150_hash(acc)) % 1000003, 0);
    str.format(ctx, "${all.length()} ${lengths} ${hashes}")
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g150(host.alloc)).ignore();
    .Ok(())
