from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn g150_pick(code: Int): Str {
    if (code % 3 == 0) { "a" } else if (code % 3 == 1) { "bb" } else { "ccc" }
}

fn g150_measure(items: Str): Int {
    items.length()
}

fn g150_gate(i: Int): Result<Int, Str> {
    if (i == 391) { .Err("bad") } else { .Ok(i % 5) }
}

fn g150_step<C: Allocator>(ctx: C, acc: Str, i: Int): Result<Str, Str> {
    let q = g150_gate(i)?;
    let held = acc;
    let seen = g150_measure(held);
    .Ok(match (i % 2) {
        0 => held.concat(ctx, g150_pick(i * 3 + 4 + seen % 7 + q)),
        _ => held.concat(ctx, g150_pick(i * 3 + 4 + seen % 7 + q + 1)),
    })
}

fn g150_run<C: Allocator>(ctx: C, acc: Str, base: Int, count: Int): Result<Str, Str> {
    g150_runLoop(ctx, acc, base, base + count)
}

fn g150_runLoop<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Result<Str, Str> {
    if (i == end) {
        .Ok(acc)
    } else {
        g150_runLoop(ctx, g150_step(ctx, acc, i)?, i + 1, end)
    }
}

fn g150_hash(items: Str): Int {
    g150_walk(items, 0, 7)
}

fn g150_walk(text: Str, at: Int, h: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => {
            g150_walk(
                text,
                at + 1,
                (h * 31 + if (c == 'a') { 1 } else if (c == 'b') { 2 } else { 3 })
                    % 1000003,
            )
        },
        .None => h,
    }
}

fn g150<C: Allocator>(ctx: C): Str {
    match (g150_run(ctx, "", 0, 800)) {
        .Ok(acc) => {
            let size = acc.length();
            let first = acc.slice(0, 8);
            let last = acc.slice(size - 8, size);
            let hash = g150_hash(acc);
            str.format(ctx, "${acc.length()} ${first} ${last} ${hash}")
        },
        .Err(e) => str.format(ctx, "stopped ${e}"),
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, g150(host.alloc)).ignore();
    .Ok(())
