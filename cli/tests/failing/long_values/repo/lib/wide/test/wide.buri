// Nothing in the report is truncated and nothing is wrapped. A long value is
// printed whole, a value holding a newline is printed with the newline in it,
// and a message is printed under the `FAIL` line it belongs to. All three are
// worth recording because the alternative — an eliding renderer — is the kind
// of thing that gets added without a test noticing.

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

test "a string far past a terminal's width" {
    assert.eq(
        "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
        "short",
    );
}

test "a list of forty elements" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(list.range(ctx, 1, 41), []);
}

test "a string holding newlines" {
    assert.eq("first\nsecond\nthird", "one line");
}

// The one assertion that reports a sentence rather than a diff. It used to be
// `assert.fail`, whose message a test wrote itself and which was three lines
// long here; `fail` is gone, and nothing a program can write produces a
// message with a newline in it any more. `commands/test.rs`'s
// `every_line_of_a_message_is_indented` is what pins the multi-line rule now.
test "a message rather than a diff" {
    assert.notEmpty(list.empty<Int>());
}
