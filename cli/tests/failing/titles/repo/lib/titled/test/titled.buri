// A test's title is arbitrary text and the report puts it in quotes, so every
// character that means something to a quoting scheme belongs here.
//
// The colon is the reason this file exists: a title carrying one used to break
// codegen, and a corpus that never wrote one would not have said so.

from "core/testing/assert" import * as assert;

test "a title with: a colon" {
    assert.eq(1, 2);
}

test "a title with \"quotes\" in it" {
    assert.eq(1, 2);
}

test "a title with a backslash \\ and a tab \t" {
    assert.eq(1, 2);
}

test "a título with ünïcödé — 日本語 🎉" {
    assert.eq(1, 2);
}

test "" {
    assert.eq(1, 2);
}

test "braces { } brackets [ ] and a comma , " {
    assert.eq(1, 2);
}

test "a title with a newline \n in it" {
    assert.eq(1, 2);
}
