# A failure report renders each value through its `Show`, and a hand-written
# `impl Show` is the one it uses: a type whose `show` hides its value keeps it
# hidden in a report too (#258's root cause, in the runner).
#
# `assert.equal` still carries no `Show` bound. A type with none is rendered
# field by field, so a type is assertable as soon as it is comparable.
#
# The two tests print the same text: the first through the report, the second
# through the program's own call to `show`.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a failure report renders both sides through a hand-written impl Show"

run {
  args: ["test", "//lib/money", "--force", "--output=js"]
  exit: 1
  golden: "fail.txt"
  stream: OUT
}
