// `assert.eq` requires `Show`, and does not use it. The runner renders both
// sides from a structural type descriptor, so a hand-written `impl Show` is
// invisible in a failure report even though the same value printed by the
// program goes through it.
//
// The two tests below are that pair: the first fails on the values and shows
// the structural rendering, the second fails on `render`'s answer and shows
// what `Show` actually produces.

from "core/testing/assert/lib.buri" import * as assert;
from "core/host/testing/lib.buri" import { alloc };
from "core/effect/lib.buri" import { Alloc };
from "//lib/money/lib.buri" import { Money, render };

test "the report renders the value structurally" {
    assert.eq(Money { cents: 1 }, Money { cents: 2 });
}

test "the program's own Show says something else" {
    let ctx = context { Alloc: alloc() };
    assert.eq(render(ctx, Money { cents: 1 }), "not this");
}
