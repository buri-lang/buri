// A failure report renders both values through `Money`'s hand-written `Show`,
// the same text the program prints when it calls `show` itself.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/money" import { Money, render };

test "the report renders the value through its Show" {
    assert.equal(Money { cents: 1 }, Money { cents: 2 });
}

test "the program's own Show says the same" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(render(ctx, Money { cents: 1 }), "not this");
}
