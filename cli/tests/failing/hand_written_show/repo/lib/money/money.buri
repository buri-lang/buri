from "core/effect/lib.buri" import { Alloc };
from "core/order/lib.buri" import { Show };

derive Eq for Money;
/// `Eq` is derived and `Show` is written by hand, so the two sides of a failure
/// can be compared against what the program itself would print.
export struct Money {
    export cents: Int,
}

/// The signature is `Show`'s: rendering allocates, so `show` takes an `Alloc`
/// context whether the body uses it or not. An `impl` supplies the signature
/// its trait declares.
impl Show for Money {
    fn show<C: Alloc>(self, ctx: C): Str {
        "Money(hand written)"
    }
}

export fn render<C: Alloc>(ctx: C, m: Money): Str {
    m.show(ctx)
}
