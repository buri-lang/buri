// A failure inside generic code. The value in the report is the monomorphised
// one — an `Int`, a `Str`, a struct — rather than anything about `T`, because
// `monomorphize` hands the renderer a descriptor per instantiation.

from "core/testing/assert" import * as assert;
from "//lib/generic" import { firstOr, twice };

test "instantiated at Int" {
    assert.equal(firstOr([1, 2], 0), 1);
}

test "instantiated at Str" {
    assert.equal(firstOr(["a", "b"], "z"), "a");
}

test "instantiated at Char" {
    assert.equal(firstOr(['a', 'b'], 'z'), 'a');
}

test "instantiated at a list" {
    assert.equal(firstOr([[1], [2]], []), [1]);
}

test "a generic answering a tuple" {
    assert.equal(twice(7), (7, 8));
}

test "a generic answering a tuple of strings" {
    assert.equal(twice("s"), ("s", "t"));
}
