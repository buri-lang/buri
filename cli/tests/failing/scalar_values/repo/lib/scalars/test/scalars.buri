// One failing `assert.equal` per scalar shape `$show` renders, so that a change
// to any one rendering is a one-line diff rather than a suite that still
// passes.

from "core/testing/assert" import * as assert;

test "Int" {
    assert.equal(1, 2);
}

test "a negative Int" {
    assert.equal(-7, 7);
}

test "Float" {
    assert.equal(1.5, 2.25);
}

test "a Float that is a whole number" {
    assert.equal(3.0, 4.0);
}

test "NaN" {
    assert.equal(0.0 / 0.0, 1.0);
}

test "negative zero" {
    assert.equal(-0.0, 0.5);
}

test "a Float infinity" {
    assert.equal(1.0 / 0.0, 0.5);
}

test "Str" {
    assert.equal("left", "right");
}

test "a Str holding the escapes JSON spells" {
    assert.equal("a\tb\nc\"d\\e", "z");
}

test "a Str holding characters outside ASCII" {
    assert.equal("héllo — 日本語 🎉", "z");
}

test "an empty Str" {
    assert.equal("", "z");
}

test "Char" {
    assert.equal('a', 'b');
}

test "Bool" {
    assert.equal(true, false);
}

test "unit" {
    assert.notEqual((), ());
}
