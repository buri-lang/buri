from "core/effect" import { Alloc, IoError };
from "core/fs" import * as fs;
from "core/fs" import { FsWrite, Path };

/// Writes one entry, and reports whether the filesystem took it.
export fn record<C: Alloc + FsWrite>(
    ctx: C,
    path: Path,
    entry: Str,
): Result<(), IoError> {
    fs.writeText(ctx, path, entry)
}
