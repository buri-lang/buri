from "core/fs" import * as fs;
from "core/fs" import { FileSystemWrite, Path };
from "platform/effect" import { Allocator, IoError };

/// Writes one entry, and reports whether the filesystem took it.
export fn record<C: Allocator + FileSystemWrite>(
    ctx: C,
    path: Path,
    entry: Str,
): Result<(), IoError> {
    fs.writeText(ctx, path, entry)
}
