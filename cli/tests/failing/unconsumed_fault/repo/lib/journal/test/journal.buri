// A fault plan is a fixture and a promise. The first block keeps its promise
// and passes; the second names a call the code under test never makes, and the
// runner fails it on the way out of the block with the fault's own spelling.

from "core/effect" import { Alloc, Fs };
from "core/testing/assert" import * as assert;
from "core/host/testing" import { alloc, fs, readFile, writeFile };
from "//lib/journal" import { record };

test "a fault the code under test reaches is a fault that fired" {
    let disk = fs().faults([writeFile("log", "one").fails(.PermissionDenied)]);
    let ctx = context { Alloc: alloc(), Fs: disk };
    assert.isTrue(record(ctx, "log", "one").isErr());
}

test "a fault whose call never happens fails the test" {
    let disk = fs().faults([readFile("log").fails(.NotFound)]);
    let ctx = context { Alloc: alloc(), Fs: disk };
    assert.ok(record(ctx, "log", "one"));
}
