// Every entry point `core/testing/assert` exports, failing, in the order the
// module declares them. Seventeen functions, seventeen reports: `eq`, `notEq`,
// `isTrue`, `isFalse`, `contains`, `isEmpty`, `len`, `gt`, `ge`, `lt`, `le` and
// `approxEq` go through `report`, `notEmpty` through `failWith`, and `ok`,
// `err`, `some` and `none` through `failExpected`, which renders the *expected*
// side as a variant name rather than as a value.

from "core/list" import * as list;
from "core/testing/assert" import * as assert;

test "eq" {
    assert.eq(1, 2);
}

test "notEq" {
    assert.notEq(5, 5);
}

test "isTrue" {
    assert.isTrue(false);
}

test "isFalse" {
    assert.isFalse(true);
}

test "contains" {
    assert.contains([1, 2, 3], 9);
}

test "isEmpty" {
    assert.isEmpty([1, 2]);
}

test "notEmpty" {
    assert.notEmpty(list.empty<Int>());
}

test "len" {
    assert.len([1, 2, 3], 2);
}

test "gt" {
    assert.gt(3, 5);
}

test "ge" {
    assert.ge(3, 5);
}

test "lt" {
    assert.lt(5, 3);
}

test "le" {
    assert.le(5, 3);
}

test "approxEq" {
    assert.approxEq(1.0, 1.5, 0.25);
}

test "ok" {
    let _ = assert.ok(Result.Err("boom"));
}

test "err" {
    let _ = assert.err(Result.Ok(7));
}

test "some" {
    let _ = assert.some(Option.None);
}

test "none" {
    assert.none(Option.Some(3));
}

test "eq on an Option" {
    assert.eq(Option.Some(1), Option.None);
}

test "eq on a Result" {
    assert.eq(Result.Ok(1), Result.Err("no"));
}
