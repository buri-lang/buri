// Five properties that do not hold, one per shape `core/testing/check` can
// report: a scalar case, a list case, a property that fails on the very first
// draw, one that holds for a while first, and one that holds for ninety-nine
// draws and breaks on the hundredth — which is what says the runner draws every
// case it promised rather than stopping early.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/check" import * as check;

test "a draw under a hundred is under fifty" {
    check.forAll(check.int(0, 100), fn(n) => n < 50);
}

test "nothing is ever drawn" {
    check.forAll(check.int(0, 100), fn(_n) => false);
}

test "a drawn list is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 9), 4), fn(_c, xs) => {
        xs.isEmpty()
    });
}

test "a drawn list is sorted already" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 9), 4), fn(_c, xs) => {
        xs.isSortedBy(fn(a, b) => a.compare(b))
    });
}

test "a draw under a hundred is never the hundredth one" {
    // 94 is what the hundredth draw from the fixed first seed gives, and it is
    // drawn only there — so this property holds for the first ninety-nine cases
    // and fails on the last.
    check.forAll(check.int(0, 100), fn(n) => n != 94);
}
