// An abort is not an assertion. SPEC 6.9 says there is nothing to catch, and
// the JavaScript runner catches the exception the runtime throws anyway — so a
// test that aborts is reported with the abort's own words and no diff, and the
// tests after it still run. That last claim is the one a native run cannot
// make, and it is why the passing test sits at the bottom of this file.

from "core/alloc" import * as alloc;
from "core/effect" import { Allocator };
from "core/testing/assert" import * as assert;
from "//lib/arith" import { leftover, push, ratio };

test "division by zero" {
    assert.equal(ratio(1, 0), 0);
}

test "remainder by zero" {
    assert.equal(leftover(1, 0), 0);
}

test "a shift as wide as the type" {
    assert.equal(push(1, 64), 0);
}

test "an allocation past a fixed budget" {
    let buffer = alloc.fixedBuffer(64);
    let ctx = context {
        Allocator: buffer,
    };
    let _ = alloc.allocate(ctx, 32);
    let _ = alloc.allocate(ctx, 40);
    assert.equal(1, 1);
}

test "the test after four aborts still runs" {
    assert.equal(1, 1);
}
