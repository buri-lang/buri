// EXPECT: unterminated string literal
// ISSUE: recorded as it reads today; filed as https://github.com/buri-lang/buri/issues/116
from "core/effect" import { Allocator };
from "core/str" import * as str;

export fn line<C: Allocator>(ctx: C, name: Str, place: Str): Str {
  str.format(ctx, "${name} of ${place})
}
