// EXPECT: this `match` does not cover `.Point(_, _)`
// ISSUE: recorded as it reads today; filed as https://github.com/buri-lang/buri/issues/110
export enum Shape {
  Point(Int, Int),
  Empty,
}

export fn size(shape: Shape): Int {
  match (shape) {
    Point.(x, y) => x + y,
    .Empty => 0,
  }
}
