// EXPECT: expected a declaration, found a string literal
// ISSUE: recorded as it reads today; filed as https://github.com/buri-lang/buri/issues/115
"core/order" from import { Order as Ranking };

export fn least(a: Int, b: Int): Int {
  match (a.compare(b)) {
    Ranking.Less => a,
    _ => b,
  }
}
