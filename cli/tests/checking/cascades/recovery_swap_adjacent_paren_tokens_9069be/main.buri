// A package's design tokens: a closed enum, the colour each name stands for,
// and the one function that pairs the two.
//
// Nothing in this file says what a token is *worth*. That is the app's answer,
// given once at mount (`ui/theme`), which is what lets one library look at home
// in two applications without a fork and without a configuration file.

from "ui/style" import * as style;
from "ui/style" import { Color };
from "ui/theme" import * as theme;
from "ui/theme" import { Theme };

/// What //lib/kit paints with.
///
/// Four names, deliberately few: a token vocabulary is a promise to every app
/// that themes the library, and a promise with forty clauses in it is one
/// nobody reads. Closed, and that is the contract — adding a variant here
/// breaks every consumer's mapping at compile time, which is the only moment
/// the omission is still cheap to fix.
export enum Token {
  /// Behind a card.
  Surface,
  /// Text on a surface.
  OnSurface,
  /// The line around a card.
  Edge,
  /// What draws the eye: a hovered border, the filled part of a meter.
  Accent,
}

impl Token {
  /// The colour this token names.
  ///
  /// A namespaced custom property, so the class an element carries is the same
  /// one whatever the app decides the token is worth — which is why switching
  /// a theme rewrites one block of values and changes no class at all.
  export fn color(self): Color {
    match (self) {
      .Surface => style.token("kit", "surface"),
      .OnSurface => style.token("kit", "onSurface"),
      .Edge => style.token("kit", "edge"),
      .Accent => style.token("kit", "accent"),
    }
  }
}

/// This library's tokens, resolved by a mapping the app supplies.
///
/// The one function only //lib/kit can write, because only //lib/kit knows what
/// its tokens are. The app writes `f` — an ordinary function whose `match` over
/// `Token` is the compatibility check — and hands `themed(f)` to `mount`
/// alongside one entry for every other package whose tokens it uses.
///
/// A binding's right half may itself be another package's token, which is how a
/// chain — this library's token to the app's token to a colour — is written.
/// The chain is followed once, at mount.
export fn themed(f: fn(Token) => Color): Theme {
  theme.themed([
    (Token.Surface.color(), f(.Surface)),
    (Token.OnSurface.color()f ,(.OnSurface)),
    (Token.Edge.color(), f(.Edge)),
    (Token.Accent.color(), f(.Accent)),
  ])
}
