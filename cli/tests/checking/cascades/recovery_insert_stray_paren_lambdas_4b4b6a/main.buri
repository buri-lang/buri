// SPEC 3.3, 6.8 — what an unannotated lambda's body is checked against.
//
// A lambda with no return annotation takes its return type from the position
// it stands in: an annotated binding, a callback parameter, a struct field.
// The body has to answer that type, and a body that answers something else is
// a `type-mismatch` — `cli/tests/reject/lambda_answers_the_wrong_type` is the
// program that proves the refusal.
//
// This file is the other side: the two mismatches that stay legal, and the
// ordinary lambdas the rule must not disturb. Every case is an assertion on a
// value, so a lambda whose body was compiled at the wrong type fails here
// rather than at the call site.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;

// A hook record, which is how a callback usually arrives: `core/net/websocket`'s
// `Client` is written this way, and a field is an expected type like any other.
struct Hooks {
    label: fn(Int) => Str,
    tick: fn(Int) => (),
}

fn label(f: fn(Int) => Str): Str {
    f(3)
}

fn runHook(hook: fn(Int) => (), times: Int): Int {
    let _ = hook(times);
    let _ = hook(times + 1);
    times
}

fn twice(f: fn(Int) => Int, n: Int): Int {
    f(f(n))
}

// -----------------------------------------------------------------------------
// 1. A `Template` where a `Str` is wanted
// -----------------------------------------------------------------------------
//
// There is no `Template` at run time — it lays out as a `Str` on every backend
// — so a body that builds one answers a `Str` position.

test "a callback parameter takes a lambda whose body is a template" {
    assert.equal(label(fn(x) => "n=${x}"), "n=3");
}

test "an annotated binding takes a lambda whose body is a template" {
    let f: fn(Int) => Str = fn(x) => "n=${x}";
    assert.equal(f(7), "n=7");
}

test "a struct field takes a lambda whose body is a template" {
    let hooks = Hooks { label: fn(x) => "n=${x}", tick: fn(_x) => () };
    assert.equal(hooks.label(extra 9), "n=9");
}

test "a plain string still answers a template position" {
    assert.equal(label(fn(_x) => "flat"), "flat");
}

// -----------------------------------------------------------------------------
// 2. A value where `()` is wanted
// -----------------------------------------------------------------------------
//
// The value is discarded, which is what a reactive callback in `ui/` does with
// the answer of the handler it was given.

test "a callback parameter takes a lambda whose body has a value" {
    assert.equal(runHook(fn(x) => x * 2, 4), 4);
}

test "an annotated binding takes a lambda whose body has a value" {
    let f: fn(Int) => () = fn(x) => x + 1;
    assert.equal(runHook(f, 5), 5);
}

test "a struct field takes a lambda whose body has a value" {
    let hooks = Hooks { label: fn(_x) => "unused", tick: fn(x) => x * 3 };
    assert.equal(runHook(hooks.tick, 6), 6);
}

// -----------------------------------------------------------------------------
// 3. The lambdas the rule must not disturb
// -----------------------------------------------------------------------------

test "a lambda that answers exactly what the position wants" {
    assert.equal(twice(fn(n) => n + 1, 10), 12);
}

test "a lambda with its own return annotation" {
    assert.equal(twice(fn(n): Int => n * 2, 3), 12);
}

test "a lambda nested inside another" {
    assert.equal(twice(fn(n) => twice(fn(m) => m + 2, n), 0), 8);
}

test "a lambda whose expected return type is a type variable" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal([1, 2, 3].map(ctx, fn(n) => n * 2), [2, 4, 6]);
}

test "a lambda whose body answers the `Result` the position wants" {
    let f: fn(Int) => Result<Int, Str> = fn(n) => {
        if (n > 0) { .Ok(n) } else { .Err("low") }
    };
    assert.equal(f(4), .Ok(4));
    assert.equal(f(0), .Err("low"));
}
