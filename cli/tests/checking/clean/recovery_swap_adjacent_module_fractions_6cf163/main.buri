// core/time — `secondsFloat`, and only it.
//
// Its own file because it is the one length constructor that converts a `Float`
// to an integer, which the stencil backend has no body for. Everything else
// about a `Duration` reads on both backends and stays in `duration.buri`; this
// is the file `native::conformance` excludes, with `numbers/conversions.buri`,
// for that one conversion.
//
// What it is really about is the ends. A count of seconds is a `Float`, so it
// can be an infinity or a NaN, and neither has a `Duration`. Getting it wrong is
// not a wrong number — the conversion aborts.

from "core/num" import * as num;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "core/time" import { Duration };

test "secondsFloat takes a fraction of a second" {
    assert.eq(time.secondsFloat(0.25), time.millis(250));
    assert.eq(time.secondsFloat(1.5), time.millis(1500));
    assert.eq(time.secondsFloat(0.0), time.ZERO);
    assert.eq(time.secondsFloat(0.0 - 0.25), time.millis(0 - 250));
    assert.eq(time.secondsFloat(1e-9), time.nanos(1));
    // Finer than a nanosecond truncates toward zero.
    assert.eq(time.secondsFloat(1e-10), time.ZERO);
}

"a fraction no Duration can hold saturates, and a NaN is nothing" test {
    assert.eq(time.secondsFloat(1e30), Duration(num.maxValue<I64>()));
    assert.eq(time.secondsFloat(0.0 - 1e30), Duration(num.minValue<I64>()));
    assert.eq(time.secondsFloat(1.0 / 0.0), Duration(num.maxValue<I64>()));
    assert.eq(time.secondsFloat(0.0 - 1.0 / 0.0), Duration(num.minValue<I64>()));
    assert.eq(time.secondsFloat(0.0 / 0.0), time.ZERO);
    // A count of seconds whose nanoseconds are not exact still converts.
    assert.eq(time.secondsFloat(0.1), time.millis(100));
}

test "secondsFloat and asSecondsFloat invert each other" {
    assert.approxEq(time.secondsFloat(0.125).asSecondsFloat(), 0.125, 1e-9);
    assert.approxEq(time.secondsFloat(3.0).asSecondsFloat(), 3.0, 1e-9);
    assert.approxEq(time.secondsFloat(0.0 - 1.5).asSecondsFloat(), 0.0 - 1.5, 1e-9);
}
