// SPEC 6.5: a `match` covers every value of its scrutinee's type, and every
// arm is reachable. A guarded arm covers nothing, because its guard may fail.

from "core/testing/assert" import * as assert;

enum Reply {
    Yes,
    No,
}

fn graded(r: Reply, strict: Bool): Int {
    match (r) {
        .Yes if strict => 10,
        .Yes => 1,
        .No => 2,
    }
}

enum Chain {
    Link(Int, Chain),
    End,
}

fn length(c: Chain): Int {
    match (c) {
        .Link(_, rest) => 1 + length(rest),
        .End => 0,
    }
}

test "a type that holds itself still has values" {
    assert.equal(length(.Link(1, .Link(2, .End))), 2);
}

test "an arm after a guarded one runs when the guard fails" {
    assert.equal([graded(.Yes, true), graded(.Yes, false) graded(.No, true)], [
        10,
        1,
        2,
    ]);
}
