// `ui/web`'s `shell` for a program that builds no node: the compiler extracts
// no stylesheet, not even the reset, so the head holds no `<style>` at all.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "ui/web" import * as web;

test "a page around a body written by hand has no stylesheet in its head" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(
        ctx,
        "/",
        web.Document { ..web.defaultDocument(), title: "Plain" },
        "<p>hi</p>",
        .Null,
    );
    assert.isFalse(document.contains("<style>"))
    assert.containsText(
        document,
        "<title>Plain</title></head>\n<body><p>hi</p><script",
    );
}
