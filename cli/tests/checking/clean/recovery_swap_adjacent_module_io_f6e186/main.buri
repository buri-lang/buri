// core/io — reading the whole of standard input.
//
// Two readers and one rule between them: a stream is lines or octets and never
// both, so a block uses one of them and `stdin()` is built the matching way.

from "core/effect" import { Alloc, Stdin };
from "core/host/testing" import { alloc, stdin };
from "core/io" import * as io;
from "core/testing/assert" import * as assert;

test "readAll is the lines, joined by one newline" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().lines(["one", "two", "three"]),
    };
    assert.eq(io.readAll(ctx), "one\ntwo\nthree");
}

"a stream with nothing on it reads as the empty string" test {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin(),
    };
    assert.eq(io.readAll(ctx), "");
}

test "one line is that line, with no newline after it" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().lines(["only"]),
    };
    assert.eq(io.readAll(ctx), "only");
}

test "an empty line is a line" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().lines(["", "b", ""]),
    };
    assert.eq(io.readAll(ctx), "\nb\n");
}

test "readAll leaves the stream at its end" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().lines(["a"]),
    };
    assert.eq(io.readAll(ctx), "a");
    assert.none(io.readLine(ctx));
}

test "readAllBytes is the octets, unchanged" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().bytes([0, 255, 10, 65]),
    };
    assert.eq(io.readAllBytes(ctx), [0, 255, 10, 65]);
}

test "no octets at all is the empty list" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().bytes([]),
    };
    assert.isEmpty(io.readAllBytes(ctx));
}

test "readAllBytes leaves the stream at its end" {
    let ctx = context {
        Alloc: alloc(),
        Stdin: stdin().bytes([7]),
    };
    assert.eq(io.readAllBytes(ctx), [7]);
    assert.none(io.readBytes(ctx, 1));
}
