// `ui/web`'s router: what a page does instead of following a link.
//
//   - `navigate` writes the address, so `path` reads it back and every prop
//     built out of `route` answers the new one;
//   - what read the route re-runs, once per navigation, which is what makes a
//     navigation re-render the smallest thing that read the path;
//   - `replace` writes the same address. What it does not do is add a history
//     entry, and only a browser has one:
//     `language::a_resumed_page_takes_the_markup_a_browser_would_have_handed_it`
//     is where that half is asserted;
//   - a signal made before a navigation still holds its value after one. An
//     in-memory store surviving the address changing is the whole reason to
//     navigate rather than link.

from "core/testing/assert" import * as assert;
from "ui/effect" import { Location, Ui, Watch };
from "ui/signal" import { signal, watch };
from "ui/testing" import { address, headless, observer, recorder };
from "ui/web" import * as web;

/// Routing, as the guide teaches it: an ordinary match on the path.
fn page(path: Str): Str {
    match (path) {
        "/" => "home",
        "/about" => "about",
        _other => "nowhere",
    }


test "navigate writes the address the page reads back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    assert.equal(web.path(ctx), "/");
    web.navigate(ctx, "/guide/routing");
    assert.equal(web.path(ctx), "/guide/routing");
}

test "replace writes the address too" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/signin"),
    };
    web.replace(ctx, "/dashboard");
    assert.equal(web.path(ctx), "/dashboard");
}

test "what read the route re-runs when the page navigates" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let log = recorder();
    let route = web.route(ctx);
    let _ = watch(ctx, fn(s) => log.record(page(route.read(s))));
    assert.equal(log.recorded(), ["home"]);
    web.navigate(ctx, "/about");
    assert.equal(log.recorded(), ["home", "about"]);
    web.replace(ctx, "/elsewhere");
    assert.equal(log.recorded(), ["home", "about", "nowhere"]);
}

test "a signal keeps its value across a navigation" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let store = signal(ctx, "ada");
    web.navigate(ctx, "/about");
    assert.equal(store.get(ctx), "ada");
    web.replace(ctx, "/");
    assert.equal(store.get(ctx), "ada");
}
