// EXPECT: `Box<T>` does not implement `Show`
//
// Inside a generic function `T` is any type at all, so `Box<T>` is not covered
// by an `impl` for `Box<Int>`. A `derive` is different: it is checked before
// its type arguments are known, so `Holder` derives `Show` and each instance
// answers for itself where it is used.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Box<T> {
  v: T,
}

impl Show for Box<Int> {
  fn show<C: Allocator>(self, ctx: C): Str {
    "box"
  }
}

struct Holder<T> {
  b: Box<T>,
}

derive Show for Holder;

fn shown<C: Allocator, T: Show>(ctx: C, x: T): Str {
  x.show(ctx)
}

fn boxed<C: Allocator, T>(ctx: C, b: Box<T>): Str {
  shown(ctx, b)
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let a = shown(ctx, Holder { b: Box { v: 1 } });
  let b = boxed(ctx, Box { v: 2 });
  let _ = io.println(ctx, "${a} ${b}").ignore();
  .Ok(())
}
