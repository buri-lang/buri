// EXPECT: "core/fs" does not export `appendBytes`
// The same missing member as `namespace_member_missing`, written where a value
// goes rather than in front of an argument list: nothing about the answer
// depends on the call, so neither does the diagnostic.
from "platform/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemWrite };
from "node" import { NodeHost };
from "core/fs" import * as fs;

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, FileSystemWrite: host.fs };
  let append = fs.appendBytes;
  .Ok(())
}
