// EXPECT: `buri docs core/result`
// A user can never write `impl Result<I64, Str>`, so the fix may not ask for
// one: a type the toolchain ships is pointed at its own documentation instead.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn addContext(value: Result<Int, Str>): Result<Int, Str> {
  value.mapErrContext(fn(e) => e)
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let r = addContext(.Ok(1));
  let _ = io.println(ctx, "${r.isOk()}").ignore();
  .Ok(())
}
