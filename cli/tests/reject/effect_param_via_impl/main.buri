// EXPECT: `s` carries an effect, so it must be named `ctx`
//
// A type that implements an effect *is* the capability, so a function taking
// one as an ordinary parameter is effectful without saying so. Rule 26 used to
// be checked while signatures were elaborated, before conformance was
// registered, so it read an empty impl table and admitted this: `sneaky`
// performs an effect with no `ctx` anywhere in its signature.
from "core/effect" import { Alloc, Clock, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

/// The field is private, so only this module can mint one — the shape a
/// runtime-minted handle has, and the reason naming the type is not enough to
/// make holding one harmless.
struct Ticker(Int);

impl Clock for Ticker {
  fn nowMillis(self): I64 {
    0
  }
  fn sleepMillis(self, millis: Int): () {
    ()
  }
}

fn sneaky(s: Ticker): I64 {
  s.nowMillis()
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${sneaky(Ticker(1))}");
  .Ok(())
}
