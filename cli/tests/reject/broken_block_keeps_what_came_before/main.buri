// EXPECT: expected `I64`, found `Str`
//
// The lambda's block never closes, so what's inside it is taken back. The
// mismatch on the line before it is outside the block, and it stays.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn apply(f: fn(Int) => Int): Int {
  f(1)
}

fn twice(): Int {
  let z: Int = "a";
  let y = apply(fn(x) => { x + 1 );
  y
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${twice()}").ignore();
  .Ok(())
}
