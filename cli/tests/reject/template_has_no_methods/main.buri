// EXPECT: tuples, function types, and `Template` have no defining module
//
// A `Template` has no methods (SPEC 6.7.3), so nothing suggests deriving one
// for it or reading its page.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn same<T>(x: T): T {
  x
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let inner = same("n is ${1}");
  let _ = io.println(ctx, inner.show(ctx)).ignore();
  .Ok(())
}
