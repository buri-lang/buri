// EXPECT: `held` carries an effect, so it must be named `ctx`
//
// The variance rule is not a weakening. `Boxed<C>` stores its `C`, so holding
// one hands the context over and the parameter is a second context under
// another name. Compare `//lib/semantics`'s `Widget<C>`, whose `C` occurs only
// as a handler's own first parameter and which is therefore ordinary data.
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

enum Boxed<C> {
  Held(C),
  Nothing,
}

fn peek<C: Alloc + Stdout>(ctx: C, held: Boxed<C>): Int {
  0
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${peek(ctx, .Nothing)}");
  .Ok(())
}
