// EXPECT: this arm is unreachable
// The alternation covers both of `Bool`'s constructors, so an arm naming one
// of them afterwards can never run.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn describe(x: Option<Bool>): Int {
  match (x) {
    .Some(true | false) => 1,
    .Some(true) => 2,
    .None => 0,
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${describe(.Some(true))}").ignore();
  .Ok(())
}
