// EXPECT: expected `Slot`, found `Seq`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/indexset" import * as indexSet;
from "core/indexset" import { Index, IndexSet };

derive Index for Slot;
struct Slot(U32);

derive Index for Seq;
struct Seq(U32);

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let live: IndexSet<Slot> = indexSet.of(ctx, [Slot(70)]);
  let _ = io.println(ctx, "${live.has(Seq(70))}").ignore();
  let seqs = indexSet.of(ctx, [Seq(1)]);
  let _ = io.println(ctx, "${live.union(ctx, seqs).count()}").ignore();
  .Ok(())
}
