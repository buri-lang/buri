// EXPECT: `NodeHost` has no field `ui`
//
// A platform's host type is the list of effects it offers, so a platform that
// has no document has no `ui` field, and asking for one is refused at the one
// line that asked. The note says which platform offers it instead: the same
// source written against `WebHost` and built for `platform: "web"` compiles,
// which `repositories/build-files/web_output` builds.
//
// No `// PLATFORM:` line, so the corpus builds this for node.
from "platform/effect" import { Allocator, Stdout };
from "core/io" import * as io;
from "node" import { NodeHost };
from "ui/effect" import { Ui, Watch };

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "this program has no page to mount into").ignore();
  .Ok(())
}
