// EXPECT: `ui` implements `Ui`, which is not allowed on the JS platform
//
// A platform *is* the set of effects its host exports, so a platform that does
// not grant one does not export the name for it, and asking is an ordinary
// unresolved name at the one line that asked. This is the direction the design
// states as "the same rule that makes `FsRead: host.fs` under `platform: JS` an
// unresolved name makes `Ui: host.ui` under `platform: LINUX` one", and it is
// checked per *output*: the same source under `platform: WEB` compiles, which
// `repositories/build-files/web_output` builds.
//
// No `// PLATFORM:` line, so the corpus builds this for JS.
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "ui/effect" import { Ui, Watch };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "this program has no page to mount into").ignore();
  .Ok(())
}
