// EXPECT: expected `Prop<Str>`
//
// A tooltip's bubble shows while its trigger is hovered or focused and goes
// as soon as the pointer moves to it on its way somewhere else, so nothing in
// it can be pressed. Its `text` is a string for that reason: a button put in
// it is a type error, and interactive content belongs in a `dialog`.
from "platform/effect" import { Allocator };
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "web" import { WebHost };
from "platform/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };

fn undo<C>(): Node<C> {
  ui.button({ label: .Const("Undo"), styles: [] })
}

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Ui: host.ui, Watch: host.watch };
  ui.mount(
    ctx,
    ui.tooltip({ text: undo(), styles: [], children: [ui.text({ content: .Const("Saved") })] }),
    [],
  )
}
