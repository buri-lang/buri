// EXPECT: `Flags` is derived, not implemented
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/flags" import * as flags;
from "core/flags" import { Flags };

struct Access {
    read: Bool,
}

impl Flags for Access {
    fn union(self, other: Access): Access { other }
    fn intersect(self, other: Access): Access { other }
    fn difference(self, other: Access): Access { other }
    fn symmetricDifference(self, other: Access): Access { other }
    fn complement(self): Access { self }
    fn isSubsetOf(self, other: Access): Bool { true }
    fn isEmpty(self): Bool { true }
    fn count(self): Int { 0 }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${flags.none<Access>().read}").ignore();
  .Ok(())
}
