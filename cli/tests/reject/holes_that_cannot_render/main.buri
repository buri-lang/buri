// EXPECT: `()` cannot be interpolated
//
// What a hole refuses, one of each: `()` on its own, a bare type parameter, a
// context, and a recursive type whose derived `Show` reaches a hand-written one.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Celsius {
  degrees: Int,
}

impl Show for Celsius {
  fn show<C: Allocator>(self, ctx: C): Str {
    "warm"
  }
}

enum Reading {
  Many([Reading]),
  One(Celsius),
}

derive Show for Reading;

fn param<C: Stdout, T>(ctx: C, x: T): () {
  let _ = io.println(ctx, "${x}").ignore();
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let u = ();
  let r = Reading.Many([Reading.One(Celsius { degrees: 20 })]);
  let _ = io.println(ctx, "${u} ${ctx} ${r}").ignore();
  .Ok(())
}
