// EXPECT: "core/math" has no member `sqrt`
// `sqrt` is `squareRoot` now. The diagnostic says so, rather than offering
// whatever is nearest by edit distance.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/math" import * as math;

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${math.sqrt(2.0)}").ignore();
  .Ok(())
}
