// EXPECT: variant `Text` of `Node` is private to its module
//
// `Node`'s variants are private to `ui/node`, so the constructors are the
// vocabulary: what a tree can be is fixed where the runtime that lowers it
// lives, rather than being open to whoever imports the type. A program that
// could build its own variant could build one no backend has a lowering for.
from "core/effect" import { Alloc };
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "core/host" import * as host;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };

fn forged<C>(): Node<C> {
  .Text(.Const("hello"))
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Ui: host.ui, Watch: host.watch };
  ui.mount(ctx, forged(), [])
}
