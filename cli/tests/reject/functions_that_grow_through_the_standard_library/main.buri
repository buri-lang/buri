// EXPECT: `Ring.equal` needs endless instantiations: `Ring.equal<T>` calls `Ring.equal<Ring<T>>` through `contains`, which calls `Ring.equal<Ring<Ring<T>>>`, and so on
//
// Growth counts through the standard library's functions and traits too:
// `[Ring<Ring<T>>].contains` compares its elements with `==`, which runs
// `Ring<Ring<T>>`'s `equal`. Calling it at the same type, or a smaller one, is
// fine.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Ring<T> {
  value: T,
}

impl<T: Equal> Equal for Ring<T> {
  fn equal(self, other: Ring<T>): Bool {
    [Ring { value: self }].contains(Ring { value: other })
  }
}

struct Tag<T> {
  value: T,
}

impl<T: Show> Show for Tag<T> {
  fn show<C: Allocator>(self, ctx: C): Str {
    render(ctx, Tag { value: self })
  }
}

fn render<T: Show, C: Allocator>(ctx: C, x: T): Str {
  x.show(ctx)
}

struct Plain<T> {
  value: T,
}

impl<T: Equal> Equal for Plain<T> {
  fn equal(self, other: Plain<T>): Bool {
    [self.value].contains(other.value)
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let same = Ring { value: 1 } == Ring { value: 1 };
  let plain = Plain { value: 1 } == Plain { value: 2 };
  let _ = io.println(ctx, "${same} ${plain} ${Tag { value: 1 }.show(ctx)}").ignore();
  .Ok(())
}
