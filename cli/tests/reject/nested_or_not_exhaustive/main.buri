// EXPECT: this `match` does not cover `.Empty`
// A nested alternation covers its own sub-type and nothing else. Splitting it
// must not make the rest of the scrutinee's type look covered too.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

enum Shape { Circle(Bool), Square(Int), Empty }

fn describe(s: Shape): Int {
  match (s) {
    .Circle(true | false) => 1,
    .Square(n) => n,
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${describe(Shape.Empty)}").ignore();
  .Ok(())
}
