// EXPECT: there is no `const` declaration
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

// `const` was the old spelling of a module-level binding. It is kept here, and
// only here, so that the error a file written against the old syntax gets —
// and the byte edit it carries, which is what `buri lint --fix` and an editor's
// quick fix apply — are pinned by something rather than described by nothing.
const MAX_RETRIES: Int = 3;

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${MAX_RETRIES}").ignore();
  .Ok(())
}
