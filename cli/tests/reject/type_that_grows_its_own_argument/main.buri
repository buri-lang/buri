// EXPECT: `Grow` needs endless instantiations: `Grow<T>` contains `Grow<Option<T>>`, which contains `Grow<Option<Option<T>>>`, and so on
//
// Each instantiation of a generic type is compiled on its own, so one that
// contains itself at a bigger argument is an error, not a build that never
// ends. Containing itself at the same arguments, or with them swapped, is fine.
// One that also can't be built is reported for that alone.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

enum Grow<T> {
  Deeper(Grow<Option<T>>),
  Here(T),
}

enum Chain<T> {
  Link(T, Chain<T>),
  End,
}

enum Swap<A, B> {
  Turn(Swap<B, A>),
  Stop(A, B),
}

enum Wrap {
  W(Option<Wrap>),
}

enum Spiral<T> {
  Twist(Spiral<Option<T>>),
}

struct Held<T> {
  inner: Option<Option<T>>,
}

fn depth(g: Grow<Int>): Int {
  match (g) {
    .Deeper(_) => 1,
    .Here(_) => 0,
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${depth(.Here(1))}").ignore();
  .Ok(())
}
