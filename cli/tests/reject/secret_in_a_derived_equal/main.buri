// EXPECT: `Login` cannot derive `Equal`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/secret" import * as secret;
from "core/secret" import { Secret };

// A derived `Equal` is a fold over the fields, and a `Secret` field has none to
// fold. Write `Equal` by hand, or leave the secret out of what is compared.

derive Equal for Login;
struct Login {
    user: Str,
    password: Secret<Str>,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let a = Login { user: "ada", password: secret.of("x") };
  let _ = io.println(ctx, "same: ${a == a}").ignore();
  .Ok(())
}
