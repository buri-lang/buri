// EXPECT: `Secret<Str>` does not implement `Equal`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/secret" import * as secret;
from "core/secret" import { Secret };

// A `Secret` has no `Equal`, so it cannot leak through a comparison report.
// Compare what `reveal` answers, or compare bytes with
// `crypto.equalsConstantTime`.

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let a = secret.of("hunter2");
  let b = secret.of("hunter2");
  let _ = io.println(ctx, "same: ${a == b}").ignore();
  .Ok(())
}
