// EXPECT: expected `F64`
//
// A slider runs between two numbers, and both are distances along the track
// rather than counts of anything — `0.0`, `100.0`. A bare `0` is the `Int`
// `Grow`, `Shrink` and `Span` take, and the two are not interchangeable: a
// slider from nought to a hundred is written with points in it.
from "core/effect" import { Allocator };
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "core/host" import * as host;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/signal" import { signal };

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Ui: host.ui, Watch: host.watch };
  let volume = signal(ctx, 40.0);
  ui.mount(ctx, ui.slider({ label: .Const("Volume"), value: volume, min: 0, max: 100, styles: [] }), [])
}
