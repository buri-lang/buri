// EXPECT: `nest` needs endless instantiations: `nest<T>` calls `nest<Option<T>>`, which calls `nest<Option<Option<T>>>`, and so on
//
// Each instantiation of a generic function is compiled on its own, so one that
// calls itself at a bigger type argument is an error, not a build that never
// ends. Calling itself at the same type arguments, or with them swapped, is
// fine.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn nest<T>(x: T, n: Int): Int {
  if (n == 0) { 0 } else { nest(Option.Some(x), n - 1) + 1 }
}

fn count<T>(x: T, n: Int): Int {
  if (n == 0) { 0 } else { count(x, n - 1) + 1 }
}

fn swap<A, B>(a: A, b: B, n: Int): Int {
  if (n == 0) { 0 } else { swap(b, a, n - 1) + 1 }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${nest(1, 3)} ${count(1, 3)} ${swap(1, true, 3)}").ignore();
  .Ok(())
}
