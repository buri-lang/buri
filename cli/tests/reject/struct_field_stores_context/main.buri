// EXPECT: carries an effect, so it must be named `ctx`
from "core/effect" import { Alloc, Fs, Stdout };
from "core/fs" import * as fs;
from "core/host" import * as host;
from "core/io" import * as io;

struct Holder<C> { export inner: C }

fn stash<C: Fs>(held: Holder<C>, path: Str): Bool {
  fs.exists(held.inner, path)
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Fs: host.fs, Stdout: host.stdout };
  let found = stash(Holder { inner: ctx }, "x");
  let _ = io.println(ctx, "${found}").ignore();
  .Ok(())
}
