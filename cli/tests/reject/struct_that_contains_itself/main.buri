// EXPECT: `Loop` can never be built: it always contains another `Loop` (through `next`)
//
// A struct that always holds another of itself is one error. A type that can't
// be built only because it holds one, and code that names one, say nothing more.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Loop {
  label: Int,
  tags: [Str],
  next: Loop,
}

struct Holder {
  held: Loop,
}

fn label(h: Holder): Int {
  h.held.label
}

fn missing(o: Option<Loop>): Int {
  match (o) {
    .None => 0,
  }
}

fn given(): Loop {
  5
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
