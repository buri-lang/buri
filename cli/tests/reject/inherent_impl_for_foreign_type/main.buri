// EXPECT: `Str` is not declared in this module
// Methods are not extensible. An `impl` block belongs to the module that
// declares its type, which is what keeps `x.f()` a single lookup with no
// import and no collision.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

impl Str {
  fn shout(self): Str { self }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
