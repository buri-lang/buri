// EXPECT: "ui/style/classify" is internal to the standard library
//
// `ui/style/classify` turns a style the compiler couldn't pin down into the
// stylesheet's classes at run time. The compiler calls it on a node's behalf;
// a program never does, so it can't import the module or call `classify`.
from "core/io" import * as io;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout };
from "ui/style/classify" import { classify };

export fn main(host: NativeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = classify;
  let _ = io.println(ctx, "no program calls classify").ignore();
  .Ok(())
}
