// EXPECT: `empty` is called at a type nothing determines: T
//
// `list.empty` is supplied by the runtime, which is compiled once against no
// Buri type at all: the type argument written at the call is the only record
// of what the list it answers holds, and it is what the compiler generates the
// value's layout and its release walk from. `T` appears nowhere but in the
// answer, so nothing but the body can determine it — and here the body never
// says what is in the list either.
//
// `list.empty<Int>()` is the edit, or a use that pins it.
from "core/effect" import { Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/list" import * as list;

export fn main(): Result<(), Str> {
    let ctx = context { Stdout: host.stdout };
    let nothing = list.empty();
    let _ = io.println(ctx, "len ${nothing.len()}").ignore();
    .Ok(())
}
