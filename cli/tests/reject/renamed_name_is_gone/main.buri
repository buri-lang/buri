// EXPECT: "core/time" has no member `sleepMs`
// `sleepMs` is not renamed, it is gone: a span is a `Duration` now.
from "core/effect" import { Allocator, Clock, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/time" import * as time;

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Clock: host.clock, Stdout: host.stdout };
  time.sleepMs(ctx, 5);
  let _ = io.println(ctx, "done").ignore();
  .Ok(())
}
