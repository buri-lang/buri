// EXPECT: `Alloc`
// The effect is `Allocator`, both where the import names it and where the
// bound does.
from "node" import { NodeHost };
from "platform/effect" import { Alloc, Stdout };
from "core/io" import * as io;

export fn greet<C: Alloc + Stdout>(ctx: C): () {
  io.println(ctx, "hi").ignore()
}

export fn main(host: NodeHost): Result<(), Str> {
  .Ok(())
}
