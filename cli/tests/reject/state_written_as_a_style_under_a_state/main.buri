// EXPECT: expected `Style`, found `State`
//
// A `State` where a style belongs is the one mistake, and isn't reported
// again as a style the stylesheet can't read.
// PLATFORM: WEB
from "platform/effect" import { Allocator, Ui, Watch };
from "web" import { WebHost };
from "ui/node" import * as ui;
from "ui/style" import { State, Style };

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Ui: host.ui, Watch: host.watch };
  let on: Style = .On(State.Hover, [State.Focus]);
  ui.mount(ctx, ui.stack({ styles: [on], children: [] }), [])
}
