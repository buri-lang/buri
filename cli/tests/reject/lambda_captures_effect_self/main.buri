// EXPECT: a lambda may not capture `self`, which carries an effect
// The capture rule is scoped to effect-carrying values, and an effect-carrying
// `self` is one: `Holder<C>` stores a `C` bounded by `FileSystemRead` (SPEC 10.6).
from "core/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemRead, Path };
from "core/fs" import * as fs;
from "core/host" import * as host;
from "core/io" import * as io;
from "core/list" import * as list;
from "core/path" import * as filepath;

struct Holder<C> { export inner: C }

impl<C: FileSystemRead> Holder<C> {
  export fn checkAll<A: Allocator>(self, ctx: A, paths: [Path]): [Bool] {
    paths.map(ctx, fn(p) => fs.exists(self.inner, p))
  }
}

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, FileSystemRead: host.fs, Stdout: host.stdout };
  let found = Holder { inner: ctx }.checkAll(ctx, [filepath.of(ctx, "a")]).length();
  let _ = io.println(ctx, "${found}").ignore();
  .Ok(())
}
