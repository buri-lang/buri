// EXPECT: expected a declaration, found `impl`
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/order/lib.buri" import { Eq };
from "core/host/lib.buri" import * as host;

export struct Version { export major: Int }

export impl Eq for Version {
  fn eq(self, other: Version): Bool { self.major == other.major }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("hi");
  .Ok(())
}
