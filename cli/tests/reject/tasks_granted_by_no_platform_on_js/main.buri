// EXPECT: `JS` does not grant `tasks`
//
// The third direction of the grant table, and the one the other two fixtures
// cannot show: an effect no platform grants at all. `Tasks` is declared in
// `core/effect` and implemented in `core/host`, and its row names an empty
// platform list — so this is refused here, under WEB, and under both native
// platforms, and the refusal says why rather than "no such name".
//
// The fix therefore stops after the one thing a reader can act on. There is no
// platform to be told to build for, and a sentence ending "build this for a
// platform that grants it:" with nothing after the colon would be a compiler
// bug wearing the clothes of advice.
//
// Both halves go together, as everywhere else: `HostTasks` is withheld with
// `tasks`, so `Tasks: host.HostTasks {}` is not the way round it.
from "core/effect/lib.buri" import { Alloc, Stdout, Tasks };
from "core/host/lib.buri" import * as host;

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Tasks: host.tasks,
  };
  let _ = ctx.println("no platform runs this");
  .Ok(())
}
