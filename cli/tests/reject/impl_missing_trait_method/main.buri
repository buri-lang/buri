// EXPECT: is missing `isEmptyThing`
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

trait Measurable {
  fn size(self): Int;
  fn isEmptyThing(self): Bool;
}

struct Bag { export count: Int }

impl Measurable for Bag {
  fn size(self): Int { self.count }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("${Bag { count: 1 }.size()}");
  .Ok(())
}
