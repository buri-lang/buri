// EXPECT: "core/fs" has no member `chmod`
// Not `appendBytes` and not `copy`: `core/fs` exports `append`, `readBytes` and
// now `copy` itself, and each of those draws a did-you-mean that stops this
// case pinning the no-suggestion branch. Permissions are the part of a
// filesystem this module has never had.
from "core/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemRead };
from "core/host" import * as host;
from "core/fs" import * as fs;
from "core/path" import * as filepath;

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout, FileSystemRead: host.fs };
  let _ = fs.chmod(ctx, filepath.of(ctx, "wal"));
  .Ok(())
}
