// EXPECT: this alternative is unreachable
// The arm is reachable and one of its alternatives is not: `Hello.World` gets
// there, and `Hello.Now(_)` was taken by the arm above. Asking the question of
// the arm as a whole cannot see this — one live alternative carries the dead
// one in with it — so it is asked of each alternative.
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

enum Hello { World, Now(Bool) }

fn greeting(hi: Hello): Str {
  match (hi) {
    Hello.Now(_) => "hello world",
    Hello.Now(_) | Hello.World => "now",
  }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println(greeting(Hello.World));
  .Ok(())
}
