// EXPECT: no type can contain itself
//
// `feed(k, k)` asks `k`'s parameter type to be `k`'s own type, which would
// contain itself. The occurs check refuses it, and the note says why.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn make<A>(): fn(A) => Int {
  fn(a) => 0
}

fn feed<T>(f: fn(T) => Int, x: T): Int {
  f(x)
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let k = make();
  let n = feed(k, k);
  let _ = io.println(ctx, "${n}").ignore();
  .Ok(())
}
