// EXPECT: `Ping` can never be built: every variant contains another `Ping`
//
// Types that always hold each other are each an error. One that can't be built
// only because it holds one of them is not: giving `Ping` a way out fixes it.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

enum Ping {
  Ping(Pong),
}

enum Pong {
  Pong(Ping),
}

struct Left {
  right: Right,
}

struct Right {
  left: Left,
}

enum Echo {
  Loud(Echo),
  Quiet(Ping),
}

enum Stuck {
  Again(Stuck, Pong),
  Still(Stuck),
}

fn missing(o: Option<Left>): Int {
  match (o) {
    .None => 0,
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
