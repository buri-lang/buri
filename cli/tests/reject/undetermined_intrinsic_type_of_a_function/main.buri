// EXPECT: `empty` is called at a type nothing determines
//
// The list holds functions, and nothing says what they take: `x` is never
// used, so `T` is `fn(?) => Int` with the `?` still open.
from "platform/effect" import { Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/list" import * as list;

fn early(): Bool {
  false
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Stdout: host.stdout };
  let handlers = if (early()) { list.empty() } else { [fn(x) => 0] };
  let _ = io.println(ctx, "${handlers.length()}").ignore();
  .Ok(())
}
