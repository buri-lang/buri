// EXPECT: this is a test-only module
//
// `platform/effect/testing` is the effects' test implementations, for a test
// source. Being the module that exports `main` earns this file nothing on the
// line below, where the `testing` segment in the path is the whole rule.
from "platform/effect" import { Allocator, Stdout };
from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect/testing" import * as testing;

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
