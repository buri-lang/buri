// EXPECT: `Config` cannot derive `ToJson`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/secret" import * as secret;
from "core/secret" import { Secret };
from "core/json" import * as json;
from "core/json" import { ToJson };

// A struct holding a `Secret` cannot derive `ToJson`, because the field cannot.

derive ToJson for Config;
struct Config {
    export region: Str,
    export apiKey: Secret<Str>,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let config = Config { region: "eu-west-1", apiKey: secret.of("hunter2") };
  let _ = io.println(ctx, json.stringify(ctx, json.encode(ctx, config))).ignore();
  .Ok(())
}
