// EXPECT: `grow` is ambiguous as a free function
//
// Three functions of one name, each on its own first parameter's type, are
// three methods. Named bare, the name doesn't say which.
fn grow(a: Int): Int {
  a
}

fn grow(a: Str): Int {
  0
}

fn grow(a: Bool): Int {
  1
}

fn go(): Int {
  let f = grow;
  1
}
