// EXPECT: `Secret<Str>` cannot be interpolated
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/secret" import * as secret;
from "core/secret" import { Secret };

// A `Secret`'s `Show` is written by hand, to print `***`, so a hole refuses it
// the way it refuses any hand-written `Show`. `${key.show(ctx)}` prints the
// stars, and `${key.reveal()}` prints the value, on purpose.

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let key = secret.of("hunter2");
  let _ = io.println(ctx, "the key is ${key}").ignore();
  .Ok(())
}
