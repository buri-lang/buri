// EXPECT: cannot implement both the effect `Stdout` and the trait `Show`
//
// `type_implements_effect_and_trait` the other way round: the trait's `impl`
// comes first, and the message still names the effect as the effect.
from "platform/effect" import { Allocator, IoError, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/order" import { Show };

struct SilentOut {}

impl Show for SilentOut {
  fn show<C: Allocator>(self, ctx: C): Str { "silent" }
}

impl Stdout for SilentOut {
  fn print(self, text: Template): Result<(), IoError> { .Ok(()) }
  fn println(self, text: Template): Result<(), IoError> { .Ok(()) }
  fn writeBytes(self, b: [U8]): Result<(), IoError> { .Ok(()) }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
