// EXPECT: field `0` of `Scope` is private to its module
//
// A `Scope` is the authority to spawn, not the number that authority is spelled
// with. The handle is how `core/tasks` reaches the runtime — `spawn` and the
// drain both pass it back — and it is private to that module, so a program
// cannot read it out and cannot mint a scope of its own around one. What
// crosses is the scope `tasks.scope` handed the body, and every spawn goes
// through it.
//
// The negative twin of "a lambda may capture a `Scope`": a value inert enough to
// be captured would be a value inert enough to forge, if the field were not
// private.
from "core/effect" import { Alloc, Stdout, Tasks };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/tasks" import * as tasks;
from "core/tasks" import { Scope };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout, Tasks: host.tasks };
  let _ = tasks.spawn(ctx, Scope(0), fn(c) => io.println(c, "smuggled").ignore());
  .Ok(())
}
