// EXPECT: would propagate `IoError`
from "core/effect" import { Allocator, Stdout, IoError };
from "core/fs" import { FileSystemRead };
from "core/fs" import * as fs;
from "core/host" import * as host;
from "core/io" import * as io;
from "core/path" import * as filepath;

fn load<C: Allocator + FileSystemRead>(ctx: C, at: Str): Result<Str, Str> {
  let text = fs.readText(ctx, filepath.of(ctx, at))?;
  .Ok(text)
}

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, FileSystemRead: host.fs, Stdout: host.stdout };
  let _ = match (load(ctx, "x")) {
    .Ok(t) => io.println(ctx, "${t}").ignore(),
    .Err(e) => io.println(ctx, "${e}").ignore(),
  };
  .Ok(())
}
