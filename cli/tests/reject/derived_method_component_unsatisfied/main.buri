// EXPECT: `Wrap<Plain>` does not implement `Hash`
//
// A method call needs the trait as much as `==` does. `Wrap<T>`'s derived
// `Hash` holds only where `T` has one, and `Plain` holds a function (#270).
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

derive Hash for Wrap;
struct Wrap<T> {
    weight: Int,
    inner: T,
}

struct Plain {
    run: fn(Int) => Int,
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
    let w = Wrap { weight: 1, inner: Plain { run: fn(x) => x } };
    let _ = io.println(ctx, "${w.hash()}").ignore();
    .Ok(())
}
