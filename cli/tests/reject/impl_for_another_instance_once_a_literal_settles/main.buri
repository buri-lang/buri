// EXPECT: the `impl Equal` is for `Box<Str>`, and `Box<I64>` isn't one
//
// A literal's type settles after the expression that holds it. `==` and a
// context binding still meet an `impl` only at an instance its head covers.
from "platform/effect" import { Allocator, Stdout, IoError };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Box<T> {
  v: T,
}

impl Equal for Box<Str> {
  fn equal(self, other: Self): Bool {
    self.v == other.v
  }
}

struct Out<T> {
  t: T,
}

impl Stdout for Out<Str> {
  fn print(self, text: Template): Result<(), IoError> { .Ok(()) }
  fn println(self, text: Template): Result<(), IoError> { .Ok(()) }
  fn writeBytes(self, bytes: [U8]): Result<(), IoError> { .Ok(()) }
}

export fn main(host: NodeHost): Result<(), Str> {
  let same = Box { v: 1 } == Box { v: 2 };
  let ctx = context { Allocator: host.alloc, Stdout: Out { t: 1 } };
  let _ = io.println(ctx, "${same}").ignore();
  .Ok(())
}
