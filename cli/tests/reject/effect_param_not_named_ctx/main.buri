// EXPECT: carries an effect, so it must be named `ctx`
from "core/effect" import { Alloc, Fs, Stdout };
from "core/fs" import * as fs;
from "core/host" import * as host;
from "core/io" import * as io;

fn sneaky<C: Fs>(a: Int, handle: C): Bool {
  fs.exists(handle, "x")
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Fs: host.fs, Stdout: host.stdout };
  let _ = io.println(ctx, "${sneaky(1, ctx)}").ignore();
  .Ok(())
}
