// EXPECT: turn it into a `Str` first
//
// `same`'s `T` is settled by its argument, so `inner` is the `Template` the
// literal builds, not a `Str` (SPEC 3.6). A hole won't hold one, and a
// `Template` has no `show`, so the fix names `str.format`, which works.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn same<T>(x: T): T {
  x
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let n = 3;
  let inner = same("n is ${n}");
  let _ = io.println(ctx, "${inner}!").ignore();
  .Ok(())
}
