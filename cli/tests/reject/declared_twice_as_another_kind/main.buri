// EXPECT: `Shape` is declared twice
//
// A name is one declaration, whatever kind each one is. The second of any two
// is refused, points at the first, and the first keeps the name.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn Shape(): I64 { 1 }

struct Shape { n: I64 }

fn Color(): I64 { 2 }

enum Color { Red, Blue }

struct Named { n: I64 }

trait Named {
  fn name(self): Str;
}

struct Limit { n: I64 }

let Limit: I64 = 3;

trait Sized {
  fn size(self): I64;
}

fn Sized(): I64 { 4 }

let Speed: I64 = 5;

fn Speed(): I64 { 6 }

type Meters = I64;

fn Meters(): I64 { 7 }

context Console {}

fn Console(): I64 { 8 }

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${Shape() + Color() + Named { n: 1 }.n + Limit { n: 2 }.n}").ignore();
  .Ok(())
}
