// EXPECT: `Login` cannot derive `Hash`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/secret" import * as secret;
from "core/secret" import { Secret };

// No `Hash`: a hash of a secret is as good as the secret to anyone who can
// guess it.

derive Hash for Login;
struct Login {
    user: Str,
    password: Secret<Str>,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let a = Login { user: "ada", password: secret.of("x") };
  let _ = io.println(ctx, "hash: ${a.hash()}").ignore();
  .Ok(())
}
