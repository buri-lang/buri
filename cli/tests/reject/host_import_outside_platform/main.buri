// EXPECT: "platform/host" is importable only by a platform
//
// The backends' production structs are authority, and a program receives them
// through its host rather than naming them: a page that could import
// `HostFileSystem` could build itself a filesystem its host does not have.
//
// PLATFORM: WEB — a page has no filesystem, so this is the authority it would
// be minting.
from "platform/effect" import { Allocator, Stdout };
from "core/io" import * as io;
from "platform/host" import { HostFileSystem };
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "a page does not read files").ignore();
  .Ok(())
}
