// EXPECT: `Pool` cannot derive `ToJson`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/indexset" import * as indexSet;
from "core/indexset" import { Index, IndexSet };
from "core/json" import * as json;
from "core/json" import { ToJson };

// A set is written as its members, so it has `ToJson` where they do.
derive Index for Slot;
struct Slot(U32);

derive ToJson for Pool;
struct Pool {
    live: IndexSet<Slot>,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let live = indexSet.of(ctx, [Slot(70)]);
  let _ = io.println(ctx, json.stringify(ctx, json.encode(ctx, live))).ignore();
  .Ok(())
}
