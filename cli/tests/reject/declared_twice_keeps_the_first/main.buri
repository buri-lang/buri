// EXPECT: `Point` is declared twice
//
// A name declared twice keeps its first declaration, and uses of it check
// against that one. The second is refused once, and draws nothing else. A
// method's name isn't a declaration, so a private `fn size` beside `Box.size`
// is fine.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Point { x: I64, y: I64 }

struct Point { name: Str }

enum Shape { Dot, Line(I64) }

enum Shape { Square }

let Limit: I64 = 3;

let Limit: Str = "three";

trait Named {
  fn first(self): Str;
  fn second(self): Str;
  fn third(self): Str;
}

trait Named {
  fn only(self): Str;
}

struct Box { n: I64 }

impl Box {
  fn size(self): I64 { self.n }
}

fn size(b: Box): I64 { b.size() + 1 }

impl Named for Box {
  fn first(self): Str { "a" }
  fn second(self): Str { "b" }
  fn third(self): Str { "c" }
}

fn length(s: Shape): I64 {
  match (s) {
    .Dot => 0,
    .Line(n) => n,
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let p = Point { x: 1, y: 2 };
  let b = Box { n: 2 };
  let _ = io.println(ctx, "${p.x + Limit + length(.Line(4)) + size(b)} ${b.first()}").ignore();
  .Ok(())
}
