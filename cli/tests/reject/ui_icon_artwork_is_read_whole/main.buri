// EXPECT: an icon's artwork has to be an `<svg>`, and this one holds no tag at all
//
// Each picture below is read as written. The first three are drawings,
// spelled the loose ways an icon set writes them: an attribute with no value,
// an unquoted value, a single-quoted one, a space before `=`, a slash straight
// after a name. The rest each break the rule a different way, and each is
// reported once.
from "platform/effect" import { Allocator };
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "web" import { WebHost };
from "platform/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };

fn icon<C>(art: Str): Node<C> {
  ui.image({ source: .Const(art), alt: .Decorative, styles: [] })
}

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Ui: host.ui, Watch: host.watch };
  let picture = { source: .Const("<svg></svg>"), alt: .Decorative, styles: [] };
  ui.mount(
    ctx,
    ui.stack({
      styles: [],
      children: [
        ui.image({ source: .Const("<svg fill viewBox='0 0 24 24'><path d='M0 0'/></svg>"), alt: .Decorative, styles: [] }),
        ui.image({ source: .Const("<svg width =24 height= \"24\"><g/><rect x/></svg>"), alt: .Decorative, styles: [] }),
        ui.image({ source: .Const("<svg width=24"), alt: .Decorative, styles: [] }),
        ui.image({ source: .Const("a check mark"), alt: .Decorative, styles: [] }),
        ui.image(picture),
        ui.image({ alt: .Decorative, styles: [] }),
        ui.image({ source: .Cell(1), alt: .Decorative, styles: [] }),
        ui.image(),
        icon("<svg></svg>"),
      ],
    }),
    [],
  )
}
