// EXPECT: the trait `Measurable` is not an effect
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

trait Measurable {
  fn size(self): Int;
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Measurable: host.stdout };
  .Ok(())
}
