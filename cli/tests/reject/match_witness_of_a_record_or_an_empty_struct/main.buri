// EXPECT: this `match` does not cover `P { a: false, b: false }`
//
// A missing case is spelled the way it would be written: a record struct with
// its field names, and a struct with no fields by its name alone.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct P { a: Bool, b: Bool }
struct E {}

fn first(p: P): Str {
  match (p) {
    P { a: true, b: _ } => "a",
  }
}

fn second(p: (E, Bool)): Str {
  match (p) {
    (E {}, true) => "e",
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${first(P { a: true, b: true })} ${second((E {}, true))}").ignore();
  .Ok(())
}
