// EXPECT: expected `World`, found `Str`
//
// The seam the grammar's scope leaves behind, pinned so that it shows as a
// diff if it ever moves. `{ hi }` is one of the two strings both readings
// accept, and the block wins it (design/grammar-rationale.md 12.3) — so this
// is a block whose result is the parameter, and the diagnostic is an ordinary
// mismatch rather than anything about literals. `{ hi, }`, `{ hi: hi }` and
// `World { hi }` all build the struct.
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

struct World { export hi: Str, export hello: Option<Str> }

fn build(hi: Str): World {
  { hi }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, build("hi").hi).ignore();
  .Ok(())
}
