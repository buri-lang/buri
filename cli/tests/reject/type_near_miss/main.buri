// EXPECT: there is no type `Poimt`
// A near miss on a type name: the fix names the candidate and says where the
// names in scope come from.
from "core/effect" import { Allocator, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

struct Point { export x: Int }

fn readX(p: Poimt): Int {
  p.x
}

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${readX(Point { x: 1 })}").ignore();
  .Ok(())
}
