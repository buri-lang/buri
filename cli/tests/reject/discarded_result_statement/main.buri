// EXPECT: this statement has type `Result<I64, Str>`, not `()`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn parse(text: Str): Result<Int, Str> {
  if (text == "") { .Err("empty") } else { .Ok(1) }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  // Dropping a `Result` in statement position. Neither diagnostic may answer
  // it with `let _ = ...`, which is the other half of the same rule.
  parse("hi");
  let _ = io.println(ctx, "done").ignore();
  .Ok(())
}
