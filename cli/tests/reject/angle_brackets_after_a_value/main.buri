// EXPECT: explicit type arguments qualify a function or a call
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

// `x < T > (y)` is the one shape both readings of `<` parse, and it is read as
// type arguments applied to `x`. That is not a coin toss: comparison does not
// chain, so the comparison reading of it is not a program either, and only one
// of the two is worth a message. Here `a` is a parameter rather than a generic
// function, and what comes back says so — rather than the call going through
// on something that is not one.
fn f(a: Int, c: Int): Bool {
  a < Int > (c)
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${f(1, 3)}").ignore();
  .Ok(())
}
