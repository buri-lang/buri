// EXPECT: `listen` implements `Listen`, which is not allowed on the JS platform
//
// Accepting a connection, refused on a platform that cannot. `Listen` is
// declared in `core/effect`, implemented in `core/host`, granted on the two
// native platforms and withheld from both JavaScript ones — so this is refused
// here and under WEB, and each refusal says why rather than "no such name".
//
// **`Sockets` and `WebSocketClient` are bound beside it and are not refused.**
// They used to be: `Sockets` was granted with `Listen` and only with it, on the
// ground that a page neither accepts connections nor holds one to push on. A
// page can dial one now, so the ground moved and the row widened to every
// platform. Writing them here is what makes this fixture fail on the day
// somebody takes that back by accident — half of a rule cannot be pinned by a
// fixture that only names the other half.
//
// The fix names the two platforms that *would* answer, which is the ordinary
// shape of this diagnostic and not the shape this fixture was written for:
// `Listen`'s row was empty when it landed, and the clause after the colon was
// empty with it. What it pins now is that "a page is served rather than
// serving" stayed a refusal when the runtime arrived — an empty row filling is
// not the same event as a withheld platform changing its mind.
from "core/effect" import { Allocator, Listen, Sockets, Stdout, WebSocketClient };
from "core/host" import * as host;
from "core/io" import * as io;

export fn main(): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    Listen: host.listen,
    Sockets: host.sockets,
    WebSocketClient: host.websocketClient,
  };
  let _ = io.println(ctx, "a page is served rather than serving").ignore();
  .Ok(())
}
