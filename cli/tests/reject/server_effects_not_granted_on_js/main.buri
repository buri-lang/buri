// EXPECT: `NodeHost` has no field `listen`
//
// Accepting a connection, refused on a platform that cannot. `Listen` is
// declared in `platform/effect` and offered by `native` alone, so `NodeHost`
// has no `listen` and the note names the platform that does.
//
// **`Sockets` and `WebSocketClient` are bound beside it and are not refused.**
// A program can dial a socket on every platform, so writing on one belongs on
// every platform too. Writing them here is what makes this fixture fail on the
// day somebody takes that back by accident — half of a rule cannot be pinned
// by a fixture that only names the other half.
from "platform/effect" import { Allocator, Listen, Sockets, Stdout, WebSocketClient };
from "core/io" import * as io;
from "node" import { NodeHost };

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    Listen: host.listen,
    Sockets: host.sockets,
    WebSocketClient: host.websocketClient,
  };
  let _ = io.println(ctx, "a program on node is served rather than serving").ignore();
  .Ok(())
}
