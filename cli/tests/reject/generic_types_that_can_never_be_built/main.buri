// EXPECT: `Twice` can never be built: every variant contains another `Twice`
//
// A generic argument counts where the constructor's own fields need it:
// `Result<Twice, Twice>` holds a `Twice` either way, and `Holder<Held>` always
// does. `Option<T>` never needs its argument, so `enum W { W(Option<W>) }` is
// fine.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Holder<T> {
  item: T,
  count: Int,
}

enum Chain<T> {
  One(T),
  More(Chain<T>),
}

enum Twice {
  T(Result<Twice, Twice>),
}

enum Held {
  H(Holder<Held>),
}

enum Looped {
  L(Chain<Looped>),
}

struct Twin {
  pair: (Int, Twin),
}

struct Cycle<T> {
  item: T,
  next: Cycle<T>,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
