// EXPECT: `Index` cannot be derived
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

// A program's own trait named `Index` says nothing about positions, so it is
// not the one `derive` knows.
trait Index {
    fn at(self): Int;
}

derive Index for Slot;
struct Slot(U32);

// Implementing its own `Index` by hand is fine.
struct Page(U32);

impl Index for Page {
    fn at(self): Int {
        self.0.toI64()
    }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${Page(3).at()}").ignore();
  .Ok(())
}
