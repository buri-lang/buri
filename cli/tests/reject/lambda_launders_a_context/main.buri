// EXPECT: a lambda may not capture `x`, whose type `T` could be a context
// `formal/findings/cases/launder.buri`. The result type `fn() => ()` mentions
// nothing effectful, which is precisely what SPEC 10.6 says must not happen:
// "a value of type `fn(Str) => Str` could smuggle a file handle past a
// signature with no `ctx` parameter, and the purity theorem would be false."
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

fn wrap<T>(x: T, f: fn(T) => ()): fn() => () {
  fn() => f(x)
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let sneaky = wrap(ctx, fn(c) => io.println(c, "SMUGGLED: I/O from fn() => ()").ignore());
  let _ = sneaky();
  .Ok(())
}
