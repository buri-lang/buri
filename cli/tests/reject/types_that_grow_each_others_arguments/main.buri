// EXPECT: `Tree` needs endless instantiations: `Tree<T>` contains `Tree<(T, T)>`, which contains `Tree<((T, T), (T, T))>`, and so on
//
// Growth counts through other types, lists, tuples and functions alike. Types
// that grow through each other are one error, on the first of them, wherever
// in the cycle the growth is.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Tree<T> {
  kids: [Forest<(T, T)>],
}

enum Forest<T> {
  Grove(fn(Tree<T>) => Int),
  Bare,
}

struct Outer<T> {
  inner: Inner<T>,
}

enum Inner<T> {
  Wrapped(Outer<Option<T>>),
  Plain,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "hi").ignore();
  .Ok(())
}
