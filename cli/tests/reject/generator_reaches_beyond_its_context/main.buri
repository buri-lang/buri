// EXPECT: `a context` does not satisfy `Clock`
//
// What makes a generator deterministic. `codegen.run` hands `generate` the
// context `main` built, bounded by `Alloc + Stdin + Stdout` and nothing more —
// so a generator that reaches for the clock or for the disk does not compile,
// and what it writes stays a function of what it was handed.
//
// Both lines below are the same refusal, once per effect, and neither is a
// convention anybody has to remember.
from "core/buri/ast" import * as ast;
from "core/codegen" import * as codegen;
from "core/codegen" import { Response };
from "core/effect" import { Alloc, Stdin, Stdout };
from "core/fs" import * as fs;
from "core/host" import * as host;
from "core/path" import * as path;
from "core/time" import * as time;

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdin: host.stdin,
        Stdout: host.stdout,
    };
    codegen.run(ctx, fn(c, _request) => {
        let _ = time.now(c);
        let _ = fs.exists(c, path.of(c, "units.txt"));
        Response {
            modules: [("units", ast.Module { items: [], docs: [] })],
            diagnostics: [],
        }
    })
}
