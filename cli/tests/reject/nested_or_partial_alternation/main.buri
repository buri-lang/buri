// EXPECT: this `match` does not cover `.Some(false)`
// The alternation under `.Some` names one of `Bool`'s two constructors, so it
// completes nothing.
from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

fn describe(x: Option<Bool>): Int {
  match (x) {
    .Some(true) => 1,
    .None => 0,
  }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${describe(.Some(false))}").ignore();
  .Ok(())
}
