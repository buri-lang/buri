// EXPECT: `Slider` is missing `min` and `max`
//
// The bounds are what a reader is told a slider runs between, so by this
// module's own rule they are required fields rather than attributes somebody may
// remember to set. `min` and `max` are plain, non-`Option` fields, so a config
// that leaves them out is missing a required value rather than a slider with no
// range.
from "core/effect" import { Allocator };
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "core/host" import * as host;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/signal" import { signal };

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Ui: host.ui, Watch: host.watch };
  let volume = signal(ctx, 40.0);
  ui.mount(ctx, ui.slider({ label: .Const("Volume"), value: volume, styles: [] }), [])
}
