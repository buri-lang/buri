// EXPECT: `WEB` does not grant `HostListen`
//
// The same refusal on the one platform whose grant set is otherwise the odd
// one out. A page grants three effects nothing else does, so "WEB has it and
// the rest do not" is the shape a reader expects here — and a page is also the
// platform that will still be refused these two after `core/net/server` lands,
// because a document does not hold a port open. That is a permanent row rather
// than an empty one waiting to be filled.
//
// PLATFORM: WEB — and the forged structs are refused with the values, as
// everywhere else a grant is withheld: `Sockets: host.HostSockets {}` is not
// the way round it either.
from "core/effect" import { Alloc, Listen, Sockets, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "ui/effect" import { Ui, Watch };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Listen: host.HostListen {},
    Sockets: host.HostSockets {},
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "no page accepts one either").ignore();
  .Ok(())
}
