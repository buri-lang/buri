// EXPECT: `Bag` cannot derive `Show`
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/orderedmap" import * as ordmap;
from "core/orderedmap" import { OrderedMap };

// A map shows only where its values do, so the fix names `Item`, not the map.

struct Item { export weight: Int }

struct Bag { export items: OrderedMap<Int, Item> }

derive Show for Bag;

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let bag = Bag { items: ordmap.empty() };
  let _ = io.println(ctx, "${bag.items.length()}").ignore();
  .Ok(())
}
