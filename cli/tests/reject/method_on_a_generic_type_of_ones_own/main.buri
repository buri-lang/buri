// EXPECT: has no method `second`
// The receiver is the user's own type, so the impl-block advice stands — spelt
// in the form that is actually writable, with the parameters declared.
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

struct Pair<A, B> { export left: A, export right: B }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let p = Pair { left: 1, right: 2 };
  let _ = ctx.println("${p.second()}");
  .Ok(())
}
