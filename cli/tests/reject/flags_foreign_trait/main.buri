// EXPECT: `Flags` cannot be derived
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

/// A trait of the program's own, which happens to share the name.
trait Flags {
    fn count(self): Int;
}

// Implemented by hand, which is allowed: it is not `core/flags`'s.
impl Flags for Count {
    fn count(self): Int {
        self.n
    }
}

struct Count {
    n: Int,
}

derive Flags for Access;
struct Access {
    read: Bool,
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let a = Access { read: true };
  let _ = io.println(ctx, "${a.read}").ignore();
  .Ok(())
}
