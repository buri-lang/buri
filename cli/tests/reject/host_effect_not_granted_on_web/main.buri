// EXPECT: `WebHost` has no field `fs`
//
// A page has no filesystem under it, so `WebHost` has no `fs` field, and
// neither `FileSystemRead` nor `FileSystemWrite` is reachable from a browser —
// by construction rather than by convention. The note names the platform that
// lacks the effect and the ones that offer it.
//
// PLATFORM: WEB — a page's host has no filesystem.
from "platform/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemRead };
from "core/io" import * as io;
from "platform/effect" import { Ui, Watch };
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    FileSystemRead: host.fs,
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "a page does not read files").ignore();
  .Ok(())
}
