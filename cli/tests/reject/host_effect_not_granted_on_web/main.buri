// EXPECT: `fs` implements `FileSystemRead` or `FileSystemWrite`, which is not allowed on the WEB platform
//
// The other direction, and the one that makes the rule a rule rather than a
// list of things the browser happens to have: a page has no filesystem under
// it, so a page's host exports no filesystem at all and neither `FileSystemRead` nor
// `FileSystemWrite` is reachable from a browser — by construction rather than by
// convention.
//
// This case used to ask for `Network`, which WEB withheld while `Network.fetch` did
// not return until the answer arrived — a page whose one thread is waiting is
// a frozen page, so a browser granted a callback-shaped `Fetch` instead. A
// suspending call blocks nothing now, WEB grants `Network` like every other
// platform, and the filesystem is what is left on this side of the line.
//
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "core/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemRead };
from "core/host" import * as host;
from "core/io" import * as io;
from "ui/effect" import { Ui, Watch };

export fn main(): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    FileSystemRead: host.fs,
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "a page does not read files").ignore();
  .Ok(())
}
