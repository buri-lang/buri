// EXPECT: is missing `only`
//
// Elidability is judged on the declared field type, not on the substituted
// one. `only` is declared `T`, so it is required at every instantiation —
// `Holder<Option<Int>>` included — while `slot`, declared `Option<T>`, is not.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Holder<T> { export only: T, export slot: Option<T> }

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let h: Holder<Option<Int>> = Holder { };
  let _ = io.println(ctx, "${h.only.withDefault(0)}").ignore();
  .Ok(())
}
