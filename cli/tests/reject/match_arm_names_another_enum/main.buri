// EXPECT: expected `A`, found a `B` pattern
//
// Two enums can share variant names. An arm that qualifies a variant with the
// wrong one is refused, even though a variant of that name exists here.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

enum A { X, Y }
enum B { X, Y }

fn name(a: A): Str {
  match (a) {
    B.X => "x",
    _ => "other",
  }
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, name(A.X)).ignore();
  .Ok(())
}
