// EXPECT: variant `Extracted` of `Style` is private to its module
//
// `Style::Extracted` is the compiler's own variant: it holds the conflict slot
// and the class name a static style was extracted into, and every name in it is
// already a rule in the emitted stylesheet. It is private so that the only way
// a class reaches an element is by having been emitted — which is the whole of
// "nothing is generated at run time".
from "core/effect" import { Alloc };
// PLATFORM: WEB — a platform is the set of effects its host exports, and `JS` exports no `ui`.
from "core/host" import * as host;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/style" import { Style };

const forged: Style = .Extracted([(600, "p-8")]);

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Ui: host.ui, Watch: host.watch };
  ui.mount(ctx, ui.stack([forged], []), [])
}
