// EXPECT: a lambda may not capture `c`, which carries an effect
// The context a `*Ctx` combinator passes in is a binding like any other, so a
// lambda *inside* that lambda may not close over it either (SPEC 10.6).
from "platform/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemRead, Path };
from "core/fs" import * as fs;
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/list" import * as list;
from "core/path" import * as filepath;

fn checkAll<C: Allocator + FileSystemRead>(ctx: C, paths: [Path]): [Bool] {
  paths.mapCtx(ctx, fn(c, p) => {
    let inner = fn() => fs.exists(c, p);
    inner()
  })
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, FileSystemRead: host.fs, Stdout: host.stdout };
  let found = checkAll(ctx, [filepath.of(ctx, "a")]).length();
  let _ = io.println(ctx, "${found}").ignore();
  .Ok(())
}
