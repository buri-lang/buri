// EXPECT: `WEB` does not grant `HostTasks`
//
// The same refusal on the one platform whose grant set is otherwise the odd
// one out. A page grants three effects nothing else does, so "WEB has it and
// the rest do not" is the shape a reader expects here — and `Tasks` is refused
// on WEB too, because its row names no platform rather than a different one.
//
// PLATFORM: WEB — and the forged struct is refused with the value, as it is
// everywhere else a grant is withheld.
from "core/effect/lib.buri" import { Alloc, Stdout, Tasks };
from "core/host/lib.buri" import * as host;
from "ui/effect/lib.buri" import { Ui, Watch };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Tasks: host.HostTasks {},
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = ctx.println("no page runs this either");
  .Ok(())
}
