// EXPECT: expected `U8`, found `Result<U8, RangeError>`
from "core/effect" import { Allocator, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/list" import * as list;

// `n.toU8()` is a narrowing conversion, so its type is
// `Result<U8, RangeError>` rather than `U8` — and `map`'s callback has to
// answer the element type of the list it builds.
//
// The element type is pinned by the annotation on `probe`'s return before the
// callback is visited, which is exactly the shape that used to go through:
// the lambda claimed the type that was wanted rather than the one its body
// had, every `Result` was dropped, and `probe` answered `[0, 0]`.
fn probe<C: Allocator>(ctx: C): [U8] {
  let ns: [I64] = [200, 201];
  ns.map(ctx, fn(n) => n.toU8())
}

// `mapCtx` is the same hole through the context-carrying combinator.
fn probeCtx<C: Allocator>(ctx: C): [U8] {
  let ns: [I64] = [200, 201];
  ns.mapCtx(ctx, fn(_c, n) => n.toU8())
}

export fn main(): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let total = probe(ctx).length() + probeCtx(ctx).length();
  let _ = io.println(ctx, "${total}").ignore();
  .Ok(())
}
