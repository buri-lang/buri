// EXPECT: has no field `f1`
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;
from "core/str/lib.buri" import * as str;

struct Rec { export f0: Int }

impl Rec {
  fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec: ${self.f0}/${self.f1}")
  }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println(Rec { f0: 1 }.render(ctx));
  .Ok(())
}
