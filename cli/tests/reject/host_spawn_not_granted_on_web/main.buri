// EXPECT: `WebHost` has no field `spawn`
//
// Starting another program is the largest authority a context can carry, and a
// page has nowhere to put a child: no process table, no `fork`, no `exec`. So
// `WebHost` has no `spawn`, and what this fixture pins is the sentence a
// person reads when they try it.
//
// PLATFORM: WEB — a page has no process table, so nothing it binds may start one.
from "platform/effect" import { Allocator, Stdout };
from "core/io" import * as io;
from "core/process" import { Spawn };
from "platform/effect" import { Ui, Watch };
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    Spawn: host.spawn,
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "a page starts no programs").ignore();
  .Ok(())
}
