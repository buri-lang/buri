// EXPECT: is missing `y`
//
// `label` is declared `Option<Str>`, so leaving it out is writing `.None` for
// it and the diagnostic must not ask for it. `y` is declared `Int`, so it is
// still required — and it is the only field named here.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

struct Point { export x: Int, export y: Int, export label: Option<Str> }

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let p = Point { x: 1 };
  let _ = io.println(ctx, "${p.x}").ignore();
  .Ok(())
}
