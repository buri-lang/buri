// EXPECT: a context may not be constructed here
from "platform/effect" import { Allocator, Stdout };
from "core/io" import * as io;
from "node" import { NodeHost };

fn helper(host: NodeHost): Int {
  let inner = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(inner, "from a helper").ignore();
  1
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${helper(host)}").ignore();
  .Ok(())
}
