// EXPECT: `WebHost` has no field `listen`
//
// The same refusal on a page, which is still refused `Listen` now that
// `core/net/server` has an acceptor behind it, because a document does not
// hold a port open.
//
// **`Sockets` and `WebSocketClient` are bound here and are not refused**, and
// that is the other half of the case rather than an oversight. A page can dial
// a socket, so writing on one belongs on a page too. What a page still cannot
// do is *accept*, and that is the one line left with a caret under it.
//
// PLATFORM: WEB — and there is no way round it: `HostListen` is named only by
// `platform/host`, which no program may import.
from "platform/effect" import { Allocator, Listen, Sockets, Stdout, WebSocketClient };
from "core/io" import * as io;
from "platform/effect" import { Ui, Watch };
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    Stdout: host.stdout,
    Listen: host.listen,
    Sockets: host.sockets,
    WebSocketClient: host.websocketClient,
    Ui: host.ui,
    Watch: host.watch,
  };
  let _ = io.println(ctx, "no page accepts one either").ignore();
  .Ok(())
}
