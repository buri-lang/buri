// EXPECT: a lambda may not capture `x`, whose type `T` could be a context
// `formal/findings/cases/hide_generic.buri`. Nothing in `hide` mentions an
// effect, so a taint predicate that reads only the signature says the lambda
// is fine — and then `hide(ctx)` hands back a closure holding a capability.
from "platform/effect" import { Allocator, Stdout };
from "node" import { NodeHost };
from "core/io" import * as io;

fn hide<T>(x: T): fn() => T {
  fn() => x
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let smuggler = hide(ctx);
  let recovered = smuggler();
  let _ = io.println(recovered, "laundered").ignore();
  .Ok(())
}
