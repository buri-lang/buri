// EXPECT: carries an effect, so it must be named `ctx`
from "core/effect/lib.buri" import { Alloc, Fs, Net, Stdout };
from "core/host/lib.buri" import * as host;
from "core/fs/lib.buri" import * as fs;

fn twoWorlds<A: Fs, B: Net>(ctx: A, other: B): Bool {
  fs.exists(ctx, "x")
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Fs: host.fs, Net: host.net, Stdout: host.stdout };
  let _ = ctx.println("${twoWorlds(ctx, ctx)}");
  .Ok(())
}
