// EXPECT: carries an effect, so it must be named `ctx`
from "platform/effect" import { Allocator, Network, Stdout };
from "core/fs" import { FileSystemRead, Path };
from "core/fs" import * as fs;
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/path" import * as filepath;

fn twoWorlds<A: FileSystemRead, B: Network>(ctx: A, other: B, at: Path): Bool {
  fs.exists(ctx, at)
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context {
    Allocator: host.alloc,
    FileSystemRead: host.fs,
    Network: host.net,
    Stdout: host.stdout,
  };
  let at = filepath.of(ctx, "x");
  let _ = io.println(ctx, "${twoWorlds(ctx, ctx, at)}").ignore();
  .Ok(())
}
