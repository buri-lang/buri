// EXPECT: `JS` does not grant `listen`
//
// The two halves of being a server, refused together. `Listen` and `Sockets`
// are declared in `core/effect` and implemented in `core/host`, and both rows
// name an empty platform list — so this is refused here, under WEB, and under
// both native platforms, and each refusal says why rather than "no such name".
//
// Both bindings are written on purpose. The grant table's rule for this pair
// is that they move together, and a fixture naming only one would still pass
// on the day somebody granted the other by itself.
//
// The fix stops after the one thing a reader can act on. There is no platform
// to be told to build for, and a sentence ending "build this for a platform
// that grants it:" with nothing after the colon would be a compiler bug
// wearing the clothes of advice.
from "core/effect" import { Alloc, Listen, Sockets, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Listen: host.listen,
    Sockets: host.sockets,
  };
  let _ = io.println(ctx, "no platform accepts a connection").ignore();
  .Ok(())
}
