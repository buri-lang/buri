// EXPECT: does not implement `FileSystemRead`
from "platform/effect" import { Allocator, Stdout };
from "core/fs" import { FileSystemRead };
from "core/fs" import * as fs;
from "node" import { NodeHost };
from "core/io" import * as io;
from "core/path" import * as filepath;

fn check<C: Allocator + FileSystemRead>(ctx: C, at: Str): Bool {
  fs.exists(ctx, filepath.of(ctx, at))
}

export fn main(host: NodeHost): Result<(), Str> {
  let ctx = context { Allocator: host.alloc, Stdout: host.stdout };
  let ok = check(ctx, "x");
  let _ = io.println(ctx, "${ok}").ignore();
  .Ok(())
}
