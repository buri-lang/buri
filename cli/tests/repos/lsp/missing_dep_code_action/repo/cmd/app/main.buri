// Imports //lib/money, which `cmd/app/BUILD.buri` does not name in
// `dependencies`. The module resolves — the loader searches the workspace —
// so this builds, and the graph is a description of something other than the
// code until `buri lint` says so.

from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

from "//lib/money" import { fromCents };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("cents: ${fromCents(450).show(ctx)}");
  .Ok(())
}
