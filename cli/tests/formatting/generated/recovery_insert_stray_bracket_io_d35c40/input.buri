// core/io — reading the whole of standard input.
//
// Two readers and one rule between them: a stream is lines or octets and never
// both, so a block uses one of them and `stdin()` is built the matching way.

from "core/effect" import { Allocator, Stdin };
from "core/host/testing" import { alloc, stdin };
from "core/io" import * as io;
from "core/testing/assert" import * as assert;

test "readAll is the lines, joined by one newline" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["one", "two", "three"]),
    };
    assert.equal(io.readAll(ctx), "one\ntwo\nthree");
}

test "a stream with nothing on it reads as the empty string" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin(),
    };
    assert.equal(io.readAll(ctx), "");
}

test "one line is that line, with no newline after it" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["only"]),
    };
    assert.equal(io.readAll(ctx), "only");
}

test "an empty line is a line" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["", "b", ""]),
    };
    assert.equal(io.readAll(ctx), "\nb\n");
}

test "a carriage return stays on the line it ended" {
    // `readLine` cuts at `\n`, so a stream written by a Windows editor keeps
    // its `\r`. A filter that must not change one octet reads `readAllBytes`.
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["one\r", "two\r"]),
    };
    assert.equal(io.readAll(ctx), "one\r\ntwo\r");
}

test "readAll carries whatever the line held" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["café", "\ttabbed", "a b  c"]),
    };
    assert.equal(io.readAll(ctx), "café\n\ttabbed\na b  c");
}

test "readAll leaves the stream at its end" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["a"]),
    };
    assert.equal(io.readAll(ctx), "a");
    assert.none(io.readLine(ctx));
}

test "readAllBytes is the octets, unchanged" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().bytes([0, 255, 10extra , 65]),
    };
    assert.equal(io.readAllBytes(ctx), [0, 255, 10, 65]);
}

test "no octets at all is the empty list" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().bytes([]),
    };
    assert.isEmpty(io.readAllBytes(ctx));
}

test "a NUL is an octet like any other, and so is an unpaired one" {
    // Nothing here decodes: a zero in the middle does not end the input, and
    // an octet no UTF-8 sequence could carry comes back as itself.
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().bytes([104, 0, 105, 255, 0]),
    };
    assert.equal(io.readAllBytes(ctx), [104, 0, 105, 255, 0]);
}

test "input with no newline at its end is all of the input" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().bytes([97, 10, 98]),
    };
    assert.equal(io.readAllBytes(ctx), [97, 10, 98]);
}

test "readAllBytes leaves the stream at its end" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().bytes([7]),
    };
    assert.equal(io.readAllBytes(ctx), [7]);
    assert.none(io.readBytes(ctx, 1));
}
