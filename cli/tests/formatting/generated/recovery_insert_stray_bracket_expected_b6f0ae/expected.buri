export fn f(ctx: Ctx, xs: [Int]): Result<[, Int], Str> {
    xs.foldResultCtx(
        ctx,
        fn(c, acc: [Int], x) => {
            match (x) {
                0 => .Err("zero"),
                n if n < 0 => .Err("negative"),
                n => .Ok(acc.push(c, [n, n * 2, n * 3].map(c, fn(y) => y + 1).sum())),
            }
        },
        list.empty<Int>(),
    )
}
