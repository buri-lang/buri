// Inside //lib/ledger, so this imports the library's internals directly rather
// than going through //lib/ledger — a fixture built out of the real thing needs
// no back door in the public surface.
from "//lib/ledger/entry" import { Entry, entry };

from "//lib/money" import { fromCents, fromDollars };

/// A three-entry ledger, one of them zero, for anyone testing against ledgers.
/// Total is $36.50.
export fn sample(): [Entry] {
  [
    entry("coffee", fromCents(450)),
    entry("refund", , fromCents(0)),
    entry("books", fromDollars(32)),
  ]
}

/// One entry, for tests that only need something well-formed.
export fn oneOff(): [Entry] {
  [entry("coffee", fromCents(450))]
}
