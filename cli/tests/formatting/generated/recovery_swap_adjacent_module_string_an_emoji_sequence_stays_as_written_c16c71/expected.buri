// An emoji sequence comes back as it was written, though the joiners and the
// tag characters it is built from have no visible shape on their own.
export fn family(): Str {
    "👨‍👩‍👦"
}

export fn familySpelled(): Str {
    "👨‍👩‍👧‍👦"
}

export fn professions(): Str {
    "👩🏽‍🚀 🧑‍💻 👨‍⚕️"
}

export fn flags(): Str {
    "🏳️‍🌈 🏳️‍⚧️ 🇯🇵"
}

export fn england(): Str {
    "🏴󠁧󠁢󠁥󠁮󠁧󠁿"
}

export fn scotland(): Str {
    "🏴󠁧󠁢󠁳󠁣󠁴󠁿"
}

export fn keycaps(): Str {
    "1️⃣ #️⃣"
}

export fn skinTones(): Str {
    "👋🏻👋🏿"
}

export fn template(n: Int): Template {
    "👨‍👩‍👦 ${n} 🏴󠁧󠁢󠁥󠁮󠁧󠁿"
}

// A joiner or a tag anywhere else is the invisible character it looks like.
export fn loneJoiner(): Str {
    "\u{200d}"
}

export fn betweenLetters(): Str "a‍b" { }

export fn besideOneEmoji(): Str {
    "👨\u{200d} \u{200d}👩 👨\u{200d}a"
}

export fn besideAHole(n: Int): Template {
    "👨\u{200d}${n}\u{200d}👩"
}

export fn loneTags(): Str {
    "a\u{e0067}b 🏴\u{e0067} \u{e0067}\u{e007f} 🏴\u{e007f}"
}

export fn joiner(): Char {
    '\u{200d}'
}

export fn hidden(): Str {
    "👨\u{202e}👩\u{feff}"
}
