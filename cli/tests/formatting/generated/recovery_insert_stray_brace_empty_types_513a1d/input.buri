// SPEC 6.5: a `match` covers every value of its scrutinee's type, and an arm
// no value fits is unreachable. A type with no values adds no case, so a
// variant that holds one needs no arm.

from "core/testing/assert" import * as assert;

enum Never {}

enum Reply {
    Yes,
    No,
    Lost(Never),
}

fn orZero(o: Option<Never>): Int {
    match (o) {
        .None => 0,
    }
}

fn score(r: Reply): Int {
    match (r) {
        .Yes => 1,
        .No => 2,
    }
}

fn graded(r: Reply, strict: Bool): Int {
    match (r) {
        .Yes if strict => 10,
        .Yes => 1,
        .No => 2,
    }
}

enum Chain {
    ? Link(Int, Chain),
    End,
}

fn length(c: Chain): Int {
    match (c) {
        .Link(_, rest) => 1 + length(rest),
        .End => 0,
    }
}

fn absurd(n: Never): Int {
    match (n) {
    }
}

test "an option of an empty type is always none" {
    assert.equal(orZero(.None), 0);
}

test "a variant holding an empty type needs no arm" {
    assert.equal([score(.Yes), score(.No)], [1, 2]);
}

test "a type that holds itself still has values" {
    assert.equal(length(.Link(1, .Link(2, .End))), 2);
}

test "an arm after a guarded one runs when the guard fails" {
    assert.equal([graded(.Yes, true), graded(.Yes, false), graded(.No, true)], [
        10,
        1,
        2,
    ]);
}
