export enum Shape {
  Circle(Int, Int),
  Rect { w: Int, h: Int },
}

export fn tuple(): Int {
  let (
    // the first
    a, // beside the first
    b,
    // after the last
  ) = (1, 2);
  a + b
}

export fn array(xs: List<Int>): Int {
  match (xs) {
    [
      // the head
      first, // beside the head
      ..rest,
      // after the rest
    ] => first,
    [a, // beside a
     b] => a + b,
    [..] => 0,
  }
}

export fn variant(s: Shape): Int {
  match (s) {
    .Circle(
      // the radius
      r, // beside the radius
      _,
      // after the last
    ) => r,
    .Rect {
      // the width
      w, // beside the width
      h: _
      ..
      // after the rest
    } => w,
    .Rect { w, // beside the width
      h } => w + h,
  }
}
