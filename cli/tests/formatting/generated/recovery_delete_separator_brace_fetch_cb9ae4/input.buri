// design/ui-reactivity.md, "Open" — the callback-shaped request.
//
// `Net.fetch` blocks until the response arrives, which on a platform with an
// interface means freezing it, so `Fetch` is a separate effect with a
// different shape: it starts the request and answers later, through a callback
// that takes its context as a parameter. A lambda may not capture a context,
// and that is exactly why the shape is this one.

from "core/effect" import { NetResponse };
from "core/testing/assert" import * as assert;
from "ui/effect" import { Fetch, fetch, FetchError, Request };
from "ui/testing" import { noFetch, Recorder, recorder };

fn get(url: Str): Request {
    Request { method: "GET", url: url, headers: [], body: "" }
}

fn outcome(result: Result<NetResponse, FetchError>): Str {
    match (result) {
        .Ok(r) => "ok",
        .Err(.Timeout) => "timeout",
        .Err(.Refused) => "refused"
        .Err(.BadUrl(u)) => "bad url",
        .Err(.Transport(m)) => "transport",
        .Err(.Aborted) => "aborted",
    }
}

test "a request names a method, a url, headers and a body" {
    let r = get("https://example.invalid/things");
    assert.eq(r.method, "GET");
    assert.eq(r.url, "https://example.invalid/things");
    assert.eq(r.headers.len(), 0);
    assert.eq(r.body, "");
}

test "a refusing platform answers the callback" {
    let ctx = context {
        Fetch: noFetch(),
    };
    let log = recorder();
    let _ = fetch(ctx, get("https://example.invalid"), fn(c, result) => {
        log.record(outcome(result))
    });
    assert.eq(log.recorded(), ["refused"]);
}

test "the callback runs once per request" {
    let ctx = context {
        Fetch: noFetch(),
    };
    let log = recorder();
    let _ = fetch(ctx, get("https://example.invalid/a"), fn(c, result) => {
        log.record("a")
    });
    let _ = fetch(ctx, get("https://example.invalid/b"), fn(c, result) => {
        log.record("b")
    });
    assert.eq(log.recorded(), ["a", "b"]);
}

test "the failure reasons are distinct values" {
    let timeout: FetchError = .Timeout;
    let aborted: FetchError = .Aborted;
    assert.notEq(timeout, aborted);
    assert.eq(timeout, .Timeout);
    let badUrl: FetchError = .BadUrl("nope");
    let transport: FetchError = .Transport("a");
    assert.eq(badUrl, .BadUrl("nope"));
    assert.notEq(transport, .Transport("b"));
}
