fn patterns(x: Int, f: Float, xs: [Int], e: E): Int {
  let a = match (x) { -1 => 1, a @ b => b };
  let b = match (f) { -1.5 => 1, _ => 2 };
  let c = match (xs) { [first, ..] => first, [first, ..rest] => first, _ => 0 };
  let d = match (()) { () => 1 };
  match (e) { .A() => 1, .B {} => 2, .B { x .. } => x, .C { x: y, .. } => y, _ => 3 }
}
