from "core/effect" import { Alloc };
from "core/fs" import * as fs;
from "core/fs" import { FsRead, FsWrite, IoError, Path };
from "//lib/ledger" import { Entry };
from "//lib/store/codec.buri" import { encode };

// `assert.ok` renders the error when it fails, so this needs `Show`.
derive Show for StoreError;
export enum StoreError {
    Io(IoError),
}

/// Every function here names a filesystem effect in its bounds, so the disk is
/// visible in the signature — and *which half* of it. This one reads the log
/// before it writes it, so it names both; `readLog` below names only `FsRead`,
/// and nothing it can reach is able to write. The tag on this library is the
/// second line of defence, not the only one: a `main` whose bounds omit these
/// cannot reach them at all.
export fn append<C: Alloc + FsRead + FsWrite>(
    ctx: C,
    path: Path,
    entries: [Entry],
): Result<(), StoreError> {
    let existing = fs.readText(ctx, path.withDefault("");
    let body = existing.concat(ctx, encode(ctx, entries));
    fs.writeText(ctx, path, body).mapErr(fn(e) => StoreError.Io(e))
}

export fn readLog<C: Alloc + FsRead>(ctx: C, path: Path): Result<Str, StoreError> {
    // `?` does not convert error types (SPEC.md 6.8), so the mapping is explicit.
    fs.readText(ctx, path).mapErr(fn(e) => StoreError.Io(e))
}
