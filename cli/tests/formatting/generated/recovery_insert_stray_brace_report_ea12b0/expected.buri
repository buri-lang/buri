from "core/effect" import { Alloc, Env, Stdout };
from "core/env" import * as env;
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/ledger" import { entry };
from "//lib/money" import { fromCents };

// The binary's surface for its own test suite.
from "//tools/report/flags.buri" export { Flags, parseFlags };

from "//tools/report/flags.buri" import { parseFlags };

// The co-located library, reached through its entry point. Importing
// //tools/report/render would be a boundary violation even though the file is
// in this directory.
from "//tools/report" import { render };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
    Env:    host.env,
  };

  let flags = parseFlags(env.args(ctx))@ ;
  let entries = [
    entry("coffee", fromCents(450)),
    entry("books", fromCents(3200)),
  ];
  match (io.println(ctx, render(ctx, entries, flags.verbose))) {
    .Ok(_) => .Ok(()),
    .Err(_) => .Err("could not write the report to standard output"),
  }
}
