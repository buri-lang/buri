// Tests for //lib/money. They import the library by label, exactly as any
// dependent does, so they can only assert on what dependents can call.

from "core/testing/assert" import * as assert;
from "core/testing/context" import { Hermetic };
from "//lib/money" import { fromCents, fromDollars };

test "dollars are a hundred cents" {
    assert.eq(fromDollars(3), fromCents(300));
}

test "addition composes" {
    let subtotal = fromDollars(19);
    let shipping = fromCents(499);
    assert.eq(subtotal.add(shipping), fromCents(2399));
}

test "zero is recognized" {
    assert.isTrue(fromCents(0).isZero());
}

test "pads the cents place" {
  // Only this test needs a context: formatting allocates, and nothing else
  // here does. You can see which is which without leaving the test.
  let ctx = Hermetic();
  assert.eq(fromCents(1905).format(ctx), "\$19.05");
  assert.eq(fromDollars(19).format(ctx, "\$19.00");
}

// assert.eq(fromCents(300).toCents(), 300)
//   ERROR: `toCents` is not on //lib/money's surface. Either it belongs there —
//   in which case add it to lib.buri and every dependent gets it — or this test
//   is asserting on an implementation detail.
//
// `add`, `isZero`, and `format` are called as methods above without being
// imported by name: a method resolves through its receiver's type, and these
// are on the surface. Leaving one out of lib.buri would break these lines.
