// Tests for a binary. The target under test is main.buri, addressed by its
// module path — which only this package's own test sources may import.

from "//cmd/server/main.buri" import { route };
from "core/testing/assert" import * as assert;

test "known paths get their handler" {
  assert.eq(route("/entries".name, "entries");
  assert.eq(route("/health").name, "health");
}

test "unknown paths fall back" {
  assert.eq(route("/nope").name, "fallback");
}

// The suite can only see what main.buri exports. Moving logic behind the entry
// point is what makes it testable, which is the pressure you want.
