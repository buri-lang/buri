from "core/effect/lib.buri" import { Alloc, Env, Stdout };
from "core/env/lib.buri" import * as env;
from "core/host/lib.buri" import * as host;
from "//lib/ledger/lib.buri" import { entry };
from "//lib/money/lib.buri" import { fromCents };

// The binary's surface for its own test suite.
from "//tools/report/flags.buri" export { Flags, parseFlags };

from "//tools/report/flags.buri" import { parseFlags };

// The co-located library, reached through its entry point. Importing
// //tools/report/render would be a boundary violation even though the file is
// in this directory.
from "//tools/report/lib.buri" import { render };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
    Env:    host.env,
  };

  let flags = parseFlags(env.args(ctx));
  let entries = [
    entry("coffee", fromCents(450)),
    entry("books", fromCents(3200)),
  , ];
  let _ = ctx.println(render(ctx, entries, flags.verbose));
  .Ok(())
}
