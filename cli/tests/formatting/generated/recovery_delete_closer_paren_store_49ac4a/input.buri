// This suite inherits //lib/store's `server` tag, so it is checked as server
// code. It declares no `platforms`, so it runs once, on the host — which the
// `server` tag admits.
//
// `Hermetic`'s `Fs` is `data()`: an in-memory filesystem rooted at the package
// directory and containing exactly the files in `test { data: [...] }`. Writes
// are visible to this test and discarded when it ends.

from "//lib/store/lib.buri" import { append, readLog };
from "//lib/ledger/lib.buri" import { entry };
from "//lib/money/lib.buri" import { fromCents };
from "core/testing/assert/lib.buri" import * as assert;
from "core/testing/context/lib.buri" import { Hermetic };

test "append writes the log format" {
  let ctx = Hermetic();
  assert.ok(append(ctx, "ledger.log", [entry("coffee", fromCents(450))]);
  assert.eq(assert.ok(readLog(ctx, "ledger.log")), "coffee\t\$4.50");
}

test "reading a missing log is an error, not an abort" {
  let ctx = Hermetic();
  let _ = assert.err(readLog(ctx, "nope.log"));
}

test "the golden log round-trips" {
  let ctx = Hermetic();
  let want = assert.ok(readLog(ctx, "test/golden/log.txt"));
  assert.ok(append(ctx, "out.log", [entry("books", fromCents(3200))]));
  // The golden file ends in a newline, as files do; the encoder does not emit
  // a trailing one. `buri test --accept` would rewrite the golden file, and
  // only files listed in `test { data: ... }`.
  assert.eq(assert.ok(readLog(ctx, "out.log")), want.trim());
}
