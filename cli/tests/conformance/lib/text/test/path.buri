// core/path — a filesystem path as a type rather than as a `Str`.
//
// Everything here is pure string work over a value the module normalized once,
// so the whole file runs on both backends and needs no filesystem at all —
// which is the point of `core/path` sitting below `core/fs` rather than
// inside it.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/path" import * as path;
from "core/path" import { Path };
from "core/testing/assert" import * as assert;

// -----------------------------------------------------------------------------
// Normalizing: one spelling per path
// -----------------------------------------------------------------------------

test "repeated and trailing separators are dropped" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "logs//app/").text(), "logs/app");
    assert.eq(path.of(ctx, "/var///log//").text(), "/var/log");
    assert.eq(path.of(ctx, "a/b").text(), "a/b");
}

test "a `.` component names nothing and is dropped" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "./a/./b").text(), "a/b");
    assert.eq(path.of(ctx, "/./a").text(), "/a");
}

test "the empty path is the current directory" {
    // `""` names nothing on any platform, and `"."` is what a program that
    // built one out of an empty interpolation meant.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "").text(), ".");
    assert.eq(path.of(ctx, ".").text(), ".");
    assert.eq(path.of(ctx, "./.").text(), ".");
}

test "the root survives normalizing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "/").text(), "/");
    assert.eq(path.of(ctx, "///").text(), "/");
}

test "`..` is a component and is NOT resolved" {
    // Removing `a/..` would rewrite the path through a symbolic link into a
    // different file. The module header states the rule; this is it.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "a/../b").text(), "a/../b");
    assert.eq(path.of(ctx, "..").text(), "..");
    assert.eq(path.of(ctx, "/a/..").text(), "/a/..");
}

test "two spellings of one path are one value" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "logs//app"), path.of(ctx, "./logs/app/"));
    assert.isFalse(path.of(ctx, "a/b") == path.of(ctx, "a/../b"));
}

// -----------------------------------------------------------------------------
// Joining
// -----------------------------------------------------------------------------

test "join puts exactly one separator between the two" {
    let ctx = context {
        Allocator: alloc(),
    };
    let dir = path.of(ctx, "var/log");
    assert.eq(dir.join(ctx, "app.log").text(), "var/log/app.log");
    assert.eq(dir.join(ctx, "a/b").text(), "var/log/a/b");
    assert.eq(dir.join(ctx, "").text(), "var/log");
}

test "join NEVER replaces the receiver's root" {
    // The other behaviour — an absolute argument substituting itself — is how
    // a program that joined a user's string onto its own directory ends up
    // reading `/etc/passwd`.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(
        path.of(ctx, "/srv/app").join(ctx, "/etc/passwd").text(),
        "/srv/app/etc/passwd",
    );
    assert.eq(path.of(ctx, "srv").join(ctx, "//x").text(), "srv/x");
}

test "joining onto the current directory drops it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, ".").join(ctx, "a").text(), "a");
    assert.eq(path.of(ctx, "/").join(ctx, "a").text(), "/a");
}

// -----------------------------------------------------------------------------
// Reading a path apart — every one of these is a view, and pure
// -----------------------------------------------------------------------------

test "parent is the directory the path is in" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(parentText(path.of(ctx, "/var/log/app.log")), .Some("/var/log"));
    assert.eq(parentText(path.of(ctx, "/var")), .Some("/"));
    assert.eq(parentText(path.of(ctx, "a/b")), .Some("a"));
    // A relative name of one component is in the directory a relative path is
    // relative to, and `.` is the path that names it.
    assert.eq(parentText(path.of(ctx, "app.log")), .Some("."));
}

test "the root and the current directory have no parent" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/").parent().isNone());
    assert.isTrue(path.of(ctx, ".").parent().isNone());
}

test "parent is lexical, so a trailing `..` is dropped like any component" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(parentText(path.of(ctx, "a/..")), .Some("a"));
}

test "fileName is the last component, where it names a file" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "/var/log/app.log").fileName(), .Some("app.log"));
    assert.eq(path.of(ctx, "app.log").fileName(), .Some("app.log"));
    assert.isTrue(path.of(ctx, "/").fileName().isNone());
    assert.isTrue(path.of(ctx, ".").fileName().isNone());
    // `..` names a directory by where it is resolved from, not by itself.
    assert.isTrue(path.of(ctx, "a/..").fileName().isNone());
}

test "extension is what follows the last dot" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "a/report.tar.gz").extension(), .Some("gz"));
    assert.eq(path.of(ctx, "a/report.tar.gz").stem(), .Some("report.tar"));
}

test "three names have no extension, and each for its own reason" {
    let ctx = context {
        Allocator: alloc(),
    };
    // No dot at all.
    assert.isTrue(path.of(ctx, "README").extension().isNone());
    assert.eq(path.of(ctx, "README").stem(), .Some("README"));
    // A dot that begins the name is part of the name.
    assert.isTrue(path.of(ctx, ".gitignore").extension().isNone());
    assert.eq(path.of(ctx, ".gitignore").stem(), .Some(".gitignore"));
    // A dot that ends it separates nothing.
    assert.isTrue(path.of(ctx, "archive.").extension().isNone());
    assert.eq(path.of(ctx, "archive.").stem(), .Some("archive."));
}

test "a path with no file name has neither stem nor extension" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/").stem().isNone());
    assert.isTrue(path.of(ctx, "/").extension().isNone());
}

test "isAbsolute is the half components does not answer" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/a/b").isAbsolute());
    assert.isFalse(path.of(ctx, "a/b").isAbsolute());
    assert.isTrue(path.of(ctx, "/").isAbsolute());
    assert.isFalse(path.of(ctx, ".").isAbsolute());
    assert.eq(
        path.of(ctx, "/a/b").components(ctx),
        path.of(ctx, "a/b").components(ctx),
    );
}

test "components are the names, without the root" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "/var/log/app.log").components(ctx), [
        "var",
        "log",
        "app.log",
    ]);
    assert.eq(path.of(ctx, "a/../b").components(ctx), ["a", "..", "b"]);
    assert.isTrue(path.of(ctx, "/").components(ctx).isEmpty());
    assert.isTrue(path.of(ctx, ".").components(ctx).isEmpty());
}

// -----------------------------------------------------------------------------
// withSuffix — how a sibling temporary is named
// -----------------------------------------------------------------------------

test "withSuffix appends to the whole name, not to the stem" {
    // `data.db` and `data.log` want two different temporaries, which is what
    // replacing the extension would not give them.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(suffixText(ctx, path.of(ctx, "a/data.db")), .Some("a/data.db.tmp"));
    assert.eq(suffixText(ctx, path.of(ctx, "a/data.log")), .Some("a/data.log.tmp"));
    assert.eq(suffixText(ctx, path.of(ctx, "plain")), .Some("plain.tmp"));
}

test "a path with no last component has nothing to append to" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/").withSuffix(ctx, ".tmp").isNone());
    assert.isTrue(path.of(ctx, ".").withSuffix(ctx, ".tmp").isNone());
}

test "the result of withSuffix is normalized like anything else" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(suffixText(ctx, path.of(ctx, "a/b")), .Some("a/b.tmp"));
    assert.eq(
        path.of(ctx, "a/b").withSuffix(ctx, "/c").map(fn(p) => p.text()),
        .Some("a/b/c"),
    );
}

// -----------------------------------------------------------------------------
// Containment, and writing a path from another
// -----------------------------------------------------------------------------

test "startsWith is component-wise, so a longer name is not a longer path" {
    let ctx = context {
        Allocator: alloc(),
    };
    let base = path.of(ctx, "/srv/a");
    assert.isTrue(path.of(ctx, "/srv/a").startsWith(base));
    assert.isTrue(path.of(ctx, "/srv/a/b/c").startsWith(base));
    assert.isFalse(path.of(ctx, "/srv/ab").startsWith(base));
    assert.isFalse(path.of(ctx, "/srv").startsWith(base));
}

test "an absolute path never starts with a relative one" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isFalse(path.of(ctx, "/srv/a").startsWith(path.of(ctx, "srv")));
    assert.isFalse(path.of(ctx, "srv/a").startsWith(path.of(ctx, "/srv")));
}

test "the root starts every absolute path and `.` every relative one" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/srv/a").startsWith(path.of(ctx, "/")));
    assert.isTrue(path.of(ctx, "/").startsWith(path.of(ctx, "/")));
    assert.isTrue(path.of(ctx, "a/b").startsWith(path.of(ctx, ".")));
    assert.isFalse(path.of(ctx, "/a").startsWith(path.of(ctx, ".")));
}

test "relativeTo writes a path from a directory above it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let root = path.of(ctx, "/srv/app");
    assert.eq(relative(ctx, "/srv/app/log/today", root), .Some("log/today"));
    assert.eq(relative(ctx, "/srv/app", root), .Some("."));
    assert.eq(relative(ctx, "/etc", root), .None);
    assert.eq(relative(ctx, "/srv/application", root), .None);
}

test "relativeTo is lexical, so a `..` is a component like any other" {
    // `a/../b` starts with `a` component by component, and what is left of it
    // after `a` is `../b`. The filesystem is the only thing that can say where
    // that really lands, which is what `fs.canonicalize` is for.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(relative(ctx, "a/../b", path.of(ctx, "a")), .Some("../b"));
    assert.eq(relative(ctx, "a/../b", path.of(ctx, "a/..")), .Some("b"));
    assert.eq(relative(ctx, "a/b", path.of(ctx, "a/..")), .None);
    // A base below the path is not a base at all, however the two are spelled.
    assert.eq(relative(ctx, "/srv", path.of(ctx, "/srv/app")), .None);
    assert.eq(relative(ctx, "srv/app", path.of(ctx, "/srv")), .None);
}

test "relativeTo from the root and from `.` keeps the rest" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(relative(ctx, "/var/log", path.of(ctx, "/")), .Some("var/log"));
    assert.eq(relative(ctx, "var/log", path.of(ctx, ".")), .Some("var/log"));
    assert.eq(relative(ctx, "/", path.of(ctx, "/")), .Some("."));
}

// -----------------------------------------------------------------------------
// Extensions
// -----------------------------------------------------------------------------

test "withExtension replaces the extension rather than appending to the name" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(extended(ctx, "/var/log/app.log", "gz"), .Some("/var/log/app.gz"));
    assert.eq(extended(ctx, "a/report.tar.gz", "txt"), .Some("a/report.tar.txt"));
    assert.eq(extended(ctx, "README", "md"), .Some("README.md"));
    assert.eq(extended(ctx, "a/.gitignore", "txt"), .Some("a/.gitignore.txt"));
}

test "an empty extension drops the one that was there" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(extended(ctx, "a/b.log", ""), .Some("a/b"));
    assert.eq(path.of(ctx, "a/b.log").withoutExtension(ctx).text(), "a/b");
    assert.eq(
        path.of(ctx, "a/report.tar.gz").withoutExtension(ctx).text(),
        "a/report.tar",
    );
    assert.eq(path.of(ctx, "README").withoutExtension(ctx).text(), "README");
}

test "a name that ends in a dot separates nothing, so the new dot is a second one" {
    // `archive.` has no extension — its dot ends the name rather than
    // separating one — so replacing what is not there appends.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(extended(ctx, "archive.", "txt"), .Some("archive..txt"));
    assert.eq(path.of(ctx, "archive.").withoutExtension(ctx).text(), "archive.");
}

test "an extension with a dot in it is written as it is given" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(extended(ctx, "a/data.db", "tar.gz"), .Some("a/data.tar.gz"));
    assert.eq(extended(ctx, "a/.gitignore", ""), .Some("a/.gitignore"));
}

test "a dotfile keeps its whole name, and a second dot is the extension" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(path.of(ctx, "a/.env.local").extension(), .Some("local"));
    assert.eq(path.of(ctx, "a/.env.local").stem(), .Some(".env"));
    assert.eq(extended(ctx, "a/.env.local", "prod"), .Some("a/.env.prod"));
    assert.eq(path.of(ctx, "a/.env.local").withoutExtension(ctx).text(), "a/.env");
}

test "a path with no last component has no extension to replace" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(extended(ctx, "/", "txt"), .None);
    assert.eq(extended(ctx, ".", "txt"), .None);
    assert.eq(path.of(ctx, "/").withoutExtension(ctx).text(), "/");
}

// -----------------------------------------------------------------------------
// Joining a path
// -----------------------------------------------------------------------------

test "joinPath is join for a path, and still appends an absolute one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let dir = path.of(ctx, "var/log");
    assert.eq(dir.joinPath(ctx, path.of(ctx, "app.log")).text(), "var/log/app.log");
    assert.eq(dir.joinPath(ctx, path.of(ctx, "/etc")).text(), "var/log/etc");
    assert.eq(dir.joinPath(ctx, path.of(ctx, ".")).text(), "var/log");
}

// -----------------------------------------------------------------------------
// Globbing
// -----------------------------------------------------------------------------

test "a pattern with no metacharacter is an equality test" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "a/b").matchesGlob("a/b"));
    assert.isFalse(path.of(ctx, "a/b").matchesGlob("a/c"));
    assert.isFalse(path.of(ctx, "a/b").matchesGlob("a"));
    assert.isFalse(path.of(ctx, "a").matchesGlob("a/b"));
}

test "`*` stays inside one component" {
    let ctx = context {
        Allocator: alloc(),
    };
    let file = path.of(ctx, "src/net/http.buri");
    assert.isTrue(file.matchesGlob("src/net/*.buri"));
    assert.isTrue(file.matchesGlob("src/*/http.buri"));
    assert.isFalse(file.matchesGlob("src/*.buri"));
    assert.isTrue(path.of(ctx, "a.buri").matchesGlob("*"));
    assert.isTrue(path.of(ctx, "a.buri").matchesGlob("*.buri"));
}

test "`?` is exactly one character" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "a1").matchesGlob("a?"));
    assert.isFalse(path.of(ctx, "a").matchesGlob("a?"));
    assert.isFalse(path.of(ctx, "a12").matchesGlob("a?"));
}

test "a set matches one of its members, and `!` turns it round" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "b").matchesGlob("[abc]"));
    assert.isFalse(path.of(ctx, "d").matchesGlob("[abc]"));
    assert.isTrue(path.of(ctx, "q7").matchesGlob("q[0-9]"));
    assert.isFalse(path.of(ctx, "qx").matchesGlob("q[0-9]"));
    assert.isTrue(path.of(ctx, "d").matchesGlob("[!abc]"));
    assert.isTrue(path.of(ctx, "d").matchesGlob("[^abc]"));
    assert.isFalse(path.of(ctx, "a").matchesGlob("[!abc]"));
    // A set nothing closes matches nothing.
    assert.isFalse(path.of(ctx, "a").matchesGlob("[abc"));
}

test "`**` matches any number of whole components, none included" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "src/net/http.buri").matchesGlob("src/**/*.buri"));
    assert.isTrue(path.of(ctx, "src/http.buri").matchesGlob("src/**/*.buri"));
    assert.isTrue(path.of(ctx, "src/a/b/c/http.buri").matchesGlob("src/**/*.buri"));
    assert.isTrue(path.of(ctx, "src/a/b").matchesGlob("src/**"));
    assert.isTrue(path.of(ctx, "src").matchesGlob("src/**"));
    assert.isFalse(path.of(ctx, "lib/a.buri").matchesGlob("src/**/*.buri"));
}

test "`**` matches at the front of a pattern and on its own" {
    let ctx = context {
        Allocator: alloc(),
    };
    let deep = path.of(ctx, "src/net/http.buri");
    assert.isTrue(deep.matchesGlob("**/http.buri"));
    assert.isTrue(deep.matchesGlob("**/*.buri"));
    assert.isTrue(deep.matchesGlob("**"));
    assert.isTrue(path.of(ctx, "http.buri").matchesGlob("**/http.buri"));
    assert.isFalse(deep.matchesGlob("**/lib.buri"));
    // Two of them, each matching a different number of components.
    assert.isTrue(path.of(ctx, "a/b/c/d/e").matchesGlob("a/**/c/**/e"));
    assert.isTrue(path.of(ctx, "a/c/e").matchesGlob("a/**/c/**/e"));
    assert.isFalse(path.of(ctx, "a/c/x").matchesGlob("a/**/c/**/e"));
}

test "an empty pattern names the current directory and nothing else" {
    // A pattern of no components matches a path of no components: `.` is that
    // path, and every name is one component more than the pattern has.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, ".").matchesGlob(""));
    assert.isFalse(path.of(ctx, "a").matchesGlob(""));
    assert.isFalse(path.of(ctx, "/").matchesGlob(""));
    assert.isTrue(path.of(ctx, "/").matchesGlob("/"));
}

test "nothing escapes, so a `\\` is a character and a `*` is always a wildcard" {
    // The pattern language is `*`, `?`, `[...]` and `**` — there is no escape,
    // which means a name holding a `*` cannot be asked for literally.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "a-b").matchesGlob("a*b"));
    assert.isTrue(path.of(ctx, "a*b").matchesGlob("a*b"));
    assert.isFalse(path.of(ctx, "a*b").matchesGlob("a\\*b"));
    assert.isTrue(path.of(ctx, "a\\zb").matchesGlob("a\\*b"));
    assert.isFalse(path.of(ctx, "a\\b").matchesGlob("a\\?b"));
    assert.isTrue(path.of(ctx, "a\\xb").matchesGlob("a\\?b"));
}

test "a `?` is one scalar, whatever it takes to write it down" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "é").matchesGlob("?"));
    assert.isTrue(path.of(ctx, "café").matchesGlob("caf?"));
    assert.isFalse(path.of(ctx, "café").matchesGlob("caf??"));
    assert.isTrue(path.of(ctx, "café").matchesGlob("caf[é]"));
}

test "a `]` closes a set rather than joining one" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isFalse(path.of(ctx, "]").matchesGlob("[]]"));
    assert.isTrue(path.of(ctx, "a").matchesGlob("[a]"));
    // An empty set closes immediately and matches nothing.
    assert.isFalse(path.of(ctx, "a").matchesGlob("[]"));
}

test "an absolute path matches only an absolute pattern" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/var/log").matchesGlob("/var/*"));
    assert.isFalse(path.of(ctx, "/var/log").matchesGlob("var/*"));
    assert.isFalse(path.of(ctx, "var/log").matchesGlob("/var/*"));
}

test "the root and `.` have no components to match" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(path.of(ctx, "/").matchesGlob("/**"));
    assert.isFalse(path.of(ctx, "/").matchesGlob("/*"));
    assert.isTrue(path.of(ctx, ".").matchesGlob("**"));
    assert.isFalse(path.of(ctx, ".").matchesGlob("*"));
}

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------

/// `parent` as text, so an assertion can name what it expects.
fn parentText(p: Path): Option<Str> {
    p.parent().map(fn(up) => up.text())
}

fn suffixText<C: Allocator>(ctx: C, p: Path): Option<Str> {
    p.withSuffix(ctx, ".tmp").map(fn(t) => t.text())
}

/// `relativeTo` as text, so an assertion can name what it expects.
fn relative<C: Allocator>(ctx: C, text: Str, base: Path): Option<Str> {
    path.of(ctx, text).relativeTo(ctx, base).map(fn(p) => p.text())
}

fn extended<C: Allocator>(ctx: C, text: Str, extension: Str): Option<Str> {
    path.of(ctx, text).withExtension(ctx, extension).map(fn(p) => p.text())
}
