// core/bytes — UTF-8, hex, and base64.
//
// The round trip is the property; the cases that are not round trips are the
// ones where a decoder must refuse. UTF-8 in particular: an overlong encoding
// and a lone surrogate are both byte sequences a lenient decoder would turn
// into something, and both are wrong.

from "core/bytes" import * as bytes;
from "core/bytes" import { DecodeError, Utf8Error };
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// --- UTF-8 ----------------------------------------------------------------------

test "ASCII is one byte per character" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toUtf8(ctx, "abc"), [97, 98, 99]);
    assert.equal(bytes.toUtf8(ctx, "").length(), 0);
}

test "the encoding widths" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toUtf8(ctx, "é"), [195, 169]);
    assert.equal(bytes.toUtf8(ctx, "€"), [226, 130, 172]);
    assert.equal(bytes.toUtf8(ctx, "😀"), [240, 159, 152, 128]);
}

test "text round trips through its bytes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let cases = ["", "abc", "héllo", "€1", "😀 and ☃", "tab\there"];
    let back = cases.mapCtx(ctx, fn(c, s) => bytes.fromUtf8(c, bytes.toUtf8(c, s)));
    assert.equal(back, cases.mapCtx(ctx, fn(_c, s) => .Ok(s)));
}

test "decoding says where the bytes stopped being text" {
    let ctx = context {
        Allocator: alloc(),
    };
    // A continuation byte with nothing to continue.
    assert.equal(assert.err(bytes.fromUtf8(ctx, [0x80])), Utf8Error(0));
    // A two-byte lead with no continuation.
    assert.equal(assert.err(bytes.fromUtf8(ctx, [0xc3])), Utf8Error(0));
    // A valid character, then a bad byte: the index is the bad one.
    assert.equal(assert.err(bytes.fromUtf8(ctx, [97, 0xff])), Utf8Error(1));
}

test "an overlong encoding is refused rather than accepted" {
    let ctx = context {
        Allocator: alloc(),
    };
    // 0xC0 0x80 is a two-byte encoding of NUL, which must be one byte.
    assert.equal(assert.err(bytes.fromUtf8(ctx, [0xc0, 0x80])), Utf8Error(0));
}

test "a surrogate is not a character" {
    let ctx = context {
        Allocator: alloc(),
    };
    // 0xED 0xA0 0x80 is U+D800, which UTF-8 does not encode.
    assert.equal(assert.err(bytes.fromUtf8(ctx, [0xed, 0xa0, 0x80])), Utf8Error(0));
}

test "the empty byte string decodes to the empty string" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.ok(bytes.fromUtf8(ctx, list.empty<U8>())), "");
}

// --- Hex ---------------------------------------------------------------------------

test "hex is lowercase and two characters per byte" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toHex(ctx, [0, 15, 16, 255]), "000f10ff");
    assert.equal(bytes.toHex(ctx, list.empty<U8>()), "");
}

test "hex round trips, and reads either case" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.ok(bytes.fromHex(ctx, "000f10ff")), [0, 15, 16, 255]);
    assert.equal(assert.ok(bytes.fromHex(ctx, "000F10FF")), [0, 15, 16, 255]);
    assert.equal(assert.ok(bytes.fromHex(ctx, "")).length(), 0);
}

test "hex refuses an odd length or a character that is not a digit" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.err(bytes.fromHex(ctx, "abc")), DecodeError(3));
    assert.equal(assert.err(bytes.fromHex(ctx, "zz")), DecodeError(0));
    assert.equal(assert.err(bytes.fromHex(ctx, "00zz")), DecodeError(2));
}

// --- Base64 ------------------------------------------------------------------------

// The RFC 4648 vectors, which pin the padding of every remainder.
test "the standard base64 vectors" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "")), "");
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "f")), "Zg==");
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "fo")), "Zm8=");
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "foo")), "Zm9v");
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "foob")), "Zm9vYg==");
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "fooba")), "Zm9vYmE=");
    assert.equal(bytes.toBase64(ctx, bytes.toUtf8(ctx, "foobar")), "Zm9vYmFy");
}

test "the same vectors, decoded" {
    let ctx = context {
        Allocator: alloc(),
    };
    let texts = ["", "f", "fo", "foo", "foob", "fooba", "foobar"];
    let back = texts.mapCtx(ctx, fn(c, s) => {
        bytes.fromBase64(c, bytes.toBase64(c, bytes.toUtf8(c, s)))
    });
    assert.equal(back, texts.mapCtx(ctx, fn(c, s) => .Ok(bytes.toUtf8(c, s))));
}

test "base64 carries bytes that are not text" {
    let ctx = context {
        Allocator: alloc(),
    };
    let raw: [U8] = [0, 1, 254, 255, 128];
    assert.equal(assert.ok(bytes.fromBase64(ctx, bytes.toBase64(ctx, raw))), raw);
}

test "base64 refuses a bad length or a character outside the alphabet" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.err(bytes.fromBase64(ctx, "Zg=")), DecodeError(3));
    assert.equal(assert.err(bytes.fromBase64(ctx, "Zg$=")), DecodeError(2));
    // Padding in the middle is not padding.
    assert.equal(assert.err(bytes.fromBase64(ctx, "Z=g=")), DecodeError(1));
}

// --- IEEE 754 byte patterns -----------------------------------------------------

test "a float round-trips through its eight bytes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values = [1.0, 0.0 - 2.5, 0.1 + 0.2, 1e21];
    let back = values.mapCtx(ctx, fn(c, x) => {
        bytes.f64FromBytes(bytes.f64ToBytes(c, x), 0)
    });
    assert.equal(back, values.mapCtx(ctx, fn(c, x) => Option.Some(x)));
}

test "a NaN payload does not survive the round trip" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Two quiet NaNs differing only in the payload, and a negative signalling
    // one. All three decode to the canonical quiet NaN on every backend.
    let first = assert.some(bytes.f64FromBytes([1, 0, 0, 0, 0, 0, 248, 127], 0));
    let second = assert.some(bytes.f64FromBytes([2, 0, 0, 0, 0, 0, 248, 127], 0));
    let signalling = assert.some(bytes.f64FromBytes([1, 0, 0, 0, 0, 0, 240, 255], 0));
    let canonical: [U8] = [0, 0, 0, 0, 0, 0, 248, 127];
    assert.equal(bytes.f64ToBytes(ctx, first), canonical);
    assert.equal(bytes.f64ToBytes(ctx, second), canonical);
    assert.equal(bytes.f64ToBytes(ctx, signalling), canonical);
}

test "four octets canonicalize a NaN as eight do" {
    let ctx = context {
        Allocator: alloc(),
    };
    let payload = assert.some(bytes.f32FromBytes([1, 0, 192, 127], 0));
    assert.equal(bytes.f32ToBytes(ctx, payload), [0, 0, 192, 127]);
    assert.equal(bytes.f64ToBytes(ctx, payload), [0, 0, 0, 0, 0, 0, 248, 127]);
}

test "the sign of a zero is preserved, which the NaN rule does not touch" {
    let ctx = context {
        Allocator: alloc(),
    };
    let positive = assert.some(bytes.f64FromBytes([0, 0, 0, 0, 0, 0, 0, 0], 0));
    let negative = assert.some(bytes.f64FromBytes([0, 0, 0, 0, 0, 0, 0, 128], 0));
    assert.equal(bytes.f64ToBytes(ctx, positive), [0, 0, 0, 0, 0, 0, 0, 0]);
    assert.equal(bytes.f64ToBytes(ctx, negative), [0, 0, 0, 0, 0, 0, 0, 128]);
    // Numerically equal all the same, which is why the bytes are the question.
    assert.equal(positive, negative);
}

// --- Fixed-width integers ------------------------------------------------------

test "eight octets, both ends first" {
    let x: U64 = 0x0123456789abcdef;
    assert.equal(bytes.fromU64BigEndian(x), [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef]);
    assert.equal(bytes.fromU64LittleEndian(x), [0xef, 0xcd, 0xab, 0x89, 0x67, 0x45, 0x23, 0x01]);
}

test "four octets, both ends first" {
    let x: U32 = 0xdeadbeef;
    assert.equal(bytes.fromU32BigEndian(x), [0xde, 0xad, 0xbe, 0xef]);
    assert.equal(bytes.fromU32LittleEndian(x), [0xef, 0xbe, 0xad, 0xde]);
}

// The top bit set is where a signed reading would go wrong, and where a
// JavaScript backend holding a U64 as a BigInt has to agree with a native one
// holding it as a machine word.
test "the whole width round-trips, including the top bit" {
    let values: [U64] = [
        0,
        1,
        0x7fffffffffffffff,
        0x8000000000000000,
        0xffffffffffffffff,
    ];
    let ctx = context {
        Allocator: alloc(),
    };
    let back = values.mapCtx(ctx, fn(_c, x) => bytes.toU64BigEndian(bytes.fromU64BigEndian(x), 0));
    assert.equal(back, values.mapCtx(ctx, fn(_c, x) => Option.Some(x)));
    let backLe = values.mapCtx(ctx, fn(_c, x) => bytes.toU64LittleEndian(bytes.fromU64LittleEndian(x), 0));
    assert.equal(backLe, values.mapCtx(ctx, fn(_c, x) => Option.Some(x)));
}

test "thirty-two bits round-trip the same way" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values: [U32] = [0, 1, 0x7fffffff, 0x80000000, 0xffffffff];
    let back = values.mapCtx(ctx, fn(_c, x) => bytes.toU32LittleEndian(bytes.fromU32LittleEndian(x), 0));
    assert.equal(back, values.mapCtx(ctx, fn(_c, x) => Option.Some(x)));
}

test "reading past the end is .None rather than a short number" {
    assert.none(bytes.toU64BigEndian([1, 2, 3], 0));
    assert.none(bytes.toU64LittleEndian([1, 2, 3, 4, 5, 6, 7], 0));
    assert.none(bytes.toU32BigEndian([1, 2, 3, 4], 1));
    assert.none(bytes.toU32LittleEndian([1, 2, 3, 4], 0 - 1));
}

test "an offset reads from where it points" {
    let raw: [U8] = [0xff, 0xff, 0x00, 0x00, 0x01, 0x00];
    assert.equal(assert.some(bytes.toU32BigEndian(raw, 2)), 0x00000100);
    assert.equal(assert.some(bytes.toU32LittleEndian(raw, 2)), 0x00010000);
}

// --- The reader ------------------------------------------------------------------

test "a reader starts at the first octet and knows when it is done" {
    let r = bytes.reader([1, 2]);
    assert.isFalse(r.isDone());
    assert.equal(r.at, 0);
    assert.isTrue(bytes.reader(list.empty<U8>()).isDone());
    // `readerAt` is the same reader wound forward, for a frame whose header
    // somebody else read.
    assert.isTrue(bytes.readerAt([1, 2], 2).isDone());
}

test "taking answers the next reader rather than advancing this one" {
    let r = bytes.reader([7, 8]);
    let (first, next) = assert.ok(r.takeByte());
    assert.equal(first, 7);
    assert.equal(next.at, 1);
    // The reader it was taken from is unchanged, so a decoder that looks ahead
    // and changes its mind keeps the one it started with.
    assert.equal(r.at, 0);
    assert.equal(assert.ok(r.takeByte()).0, 7);
}

test "a reader walks a sequence of varints" {
    // 1, 300, 0: 300 is two octets, which is what makes this a walk rather than
    // an index.
    let r = bytes.reader([1, 0xac, 0x02, 0]);
    let (a, afterA) = assert.ok(r.takeVarint());
    let (b, afterB) = assert.ok(afterA.takeVarint());
    let (c, afterC) = assert.ok(afterB.takeVarint());
    assert.equal([a, b, c], [1, 300, 0]);
    assert.isTrue(afterC.isDone());
}

test "a slice is copied out and the reader moves past it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = bytes.reader([1, 2, 3, 4]);
    let (head, rest) = assert.ok(r.takeSlice(ctx, 3));
    assert.equal(head, [1, 2, 3]);
    assert.equal(rest.at, 3);
    // Zero octets is a slice, not an error.
    assert.equal(assert.ok(rest.takeSlice(ctx, 0)).0, list.empty<U8>());
}

test "a length-prefixed frame is one call" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Two frames back to back: "hi" and the empty one.
    let r = bytes.reader([2, 104, 105, 0]);
    let (body, rest) = assert.ok(r.takeFramed(ctx));
    assert.equal(assert.ok(bytes.fromUtf8(ctx, body)), "hi");
    let (empty, end) = assert.ok(rest.takeFramed(ctx));
    assert.equal(empty, list.empty<U8>());
    assert.isTrue(end.isDone());
}

test "a truncated read reports the index it began at" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Off the end entirely.
    assert.equal(assert.err(bytes.readerAt([1, 2], 2).takeByte()), DecodeError(2));
    // A slice longer than what is left, and a negative one.
    assert.equal(
        assert.err(bytes.readerAt([1, 2, 3], 1).takeSlice(ctx, 3)),
        DecodeError(1),
    );
    assert.equal(
        assert.err(bytes.reader([1, 2, 3]).takeSlice(ctx, 0 - 1)),
        DecodeError(0),
    );
    // A frame whose length is longer than its body: the index is where the
    // frame began, not where its body did.
    assert.equal(
        assert.err(bytes.readerAt([0, 9, 1, 2], 1).takeFramed(ctx)),
        DecodeError(1),
    );
    // A frame whose length is not there at all.
    assert.equal(assert.err(bytes.readerAt([0, 0x80], 1).takeFramed(ctx)), DecodeError(1));
}

test "a reader is a value, so two of them compare" {
    assert.equal(bytes.reader([1, 2]), bytes.readerAt([1, 2], 0));
    assert.notEqual(bytes.reader([1, 2]), bytes.readerAt([1, 2], 1));
}

// --- base64url ---------------------------------------------------------------------
//
// The URL-safe alphabet and no padding, which is what a JWT, a signed cookie and
// a URL-safe id all use. The pairs below are the ones where the two alphabets
// actually differ: bytes that produce a `+` or a `/`, and lengths that produce a
// `=`.

test "the URL-safe alphabet writes - and _ where the standard one writes + and /" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toBase64(ctx, [251, 255]), "+/8=");
    assert.equal(bytes.toBase64Url(ctx, [251, 255]), "-_8");
    assert.equal(bytes.toBase64(ctx, [251, 255, 190]), "+/++");
    assert.equal(bytes.toBase64Url(ctx, [251, 255, 190]), "-_--");
    assert.equal(bytes.toBase64(ctx, [251, 239, 190, 0]), "++++AA==");
    assert.equal(bytes.toBase64Url(ctx, [251, 239, 190, 0]), "----AA");
}

test "base64url drops the padding at every remainder" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toBase64Url(ctx, list.empty<U8>()), "");
    assert.equal(bytes.toBase64Url(ctx, [251]), "-w");
    assert.equal(bytes.toBase64Url(ctx, [251, 255]), "-_8");
    assert.equal(bytes.toBase64Url(ctx, [251, 255, 190]), "-_--");
}

test "text and bytes both round-trip through base64url" {
    let ctx = context {
        Allocator: alloc(),
    };
    let raw = bytes.toUtf8(ctx, "hi €");
    assert.equal(assert.ok(bytes.fromBase64Url(ctx, bytes.toBase64Url(ctx, raw))), raw);
    assert.equal(
        assert.ok(bytes.fromBase64Url(ctx, bytes.toBase64Url(ctx, [251, 239, 190, 0]))),
        [251, 239, 190, 0],
    );
    assert.equal(assert.ok(bytes.fromBase64Url(ctx, "")), list.empty<U8>());
}

test "base64url reads a padded spelling too, and refuses an impossible length" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.ok(bytes.fromBase64Url(ctx, "-_8=")), [251, 255]);
    assert.equal(assert.ok(bytes.fromBase64Url(ctx, "-_8")), [251, 255]);
    // One character past a group of four is a length no base64 has.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-_8-_")), DecodeError(5));
    // The two alphabets do not read each other.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "+/8=")), DecodeError(0));
    assert.equal(assert.err(bytes.fromBase64(ctx, "-_8=")), DecodeError(0));
}

// --- lossy UTF-8 -----------------------------------------------------------------
//
// One replacement character per maximal subpart, which is the rule `fromUtf8`
// refuses to guess at and the one every browser follows.

test "valid text is unchanged, and the empty input is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.fromUtf8Lossy(ctx, bytes.toUtf8(ctx, "hi €")), "hi €");
    assert.equal(bytes.fromUtf8Lossy(ctx, list.empty<U8>()), "");
}

test "a truncated sequence costs one replacement, not one per byte" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The euro sign is e2 82 ac; two thirds of it is one bad character.
    assert.equal(bytes.fromUtf8Lossy(ctx, [104, 105, 226, 130]).length(), 3);
    assert.equal(bytes.fromUtf8Lossy(ctx, [226, 130]).length(), 1);
    // And what follows it is read normally.
    assert.equal(bytes.fromUtf8Lossy(ctx, [226, 130, 33]).length(), 2);
}

test "an overlong encoding, a surrogate and a stray continuation each replace" {
    let ctx = context {
        Allocator: alloc(),
    };
    // c0 af is an overlong `/`: the lead byte leads nothing at all.
    assert.equal(bytes.fromUtf8Lossy(ctx, [192, 175]).length(), 2);
    // ed a0 80 is a lone surrogate: the second byte is out of range for ed, so
    // all three bytes replace separately.
    assert.equal(bytes.fromUtf8Lossy(ctx, [237, 160, 128]).length(), 3);
    // A continuation byte with no lead.
    assert.equal(bytes.fromUtf8Lossy(ctx, [128]).length(), 1);
    // f5 and up is past U+10FFFF.
    assert.equal(bytes.fromUtf8Lossy(ctx, [245, 128, 128, 128]).length(), 4);
}

test "lossy and strict agree on every input strict accepts" {
    let ctx = context {
        Allocator: alloc(),
    };
    let cases = ["", "a", "é", "€", "😀", "mixed: a é € 😀"];
    let same = cases.mapCtx(ctx, fn(c, text) => {
        bytes.fromUtf8Lossy(c, bytes.toUtf8(c, text)) == text
    });
    assert.isTrue(same.all(fn(ok) => ok));
    // A four-byte sequence, byte for byte.
    assert.equal(bytes.fromUtf8Lossy(ctx, [240, 159, 152, 128]), "😀");
}

// --- searching, splitting and joining --------------------------------------------

test "indexOf finds the first match, and nothing when there is none" {
    assert.equal(bytes.indexOf([1, 2, 3, 2, 3], [2, 3]), .Some(1));
    assert.equal(bytes.indexOf([1, 2, 3], [3]), .Some(2));
    assert.equal(bytes.indexOf([1, 2, 3], [4]), .None);
    // A needle longer than the haystack cannot be in it.
    assert.equal(bytes.indexOf([1], [1, 2]), .None);
    // The empty needle is at the start.
    assert.equal(bytes.indexOf([1, 2], list.empty<U8>()), .Some(0));
    assert.equal(bytes.indexOf(list.empty<U8>(), list.empty<U8>()), .Some(0));
    assert.equal(bytes.indexOf(list.empty<U8>(), [1]), .None);
}

test "indexOfFrom starts where it is told" {
    assert.equal(bytes.indexOfFrom([1, 2, 3, 2, 3], [2, 3], 2), .Some(3));
    assert.equal(bytes.indexOfFrom([1, 2, 3, 2, 3], [2, 3], 4), .None);
    // A negative start reads as zero rather than indexing backwards.
    assert.equal(bytes.indexOfFrom([1, 2, 3], [1], 0 - 5), .Some(0));
    // Past the end: nothing, except an empty needle, which is everywhere.
    assert.equal(bytes.indexOfFrom([1, 2, 3], [1], 99), .None);
    assert.equal(bytes.indexOfFrom([1, 2, 3], list.empty<U8>(), 3), .Some(3));
}

test "startsWith and endsWith, including the empty and equal cases" {
    assert.isTrue(bytes.startsWith([1, 2, 3], [1, 2]));
    assert.isFalse(bytes.startsWith([1, 2, 3], [2]));
    assert.isTrue(bytes.startsWith([1, 2, 3], list.empty<U8>()));
    assert.isTrue(bytes.startsWith([1, 2, 3], [1, 2, 3]));
    assert.isFalse(bytes.startsWith([1], [1, 2]));
    assert.isTrue(bytes.endsWith([1, 2, 3], [2, 3]));
    assert.isFalse(bytes.endsWith([1, 2, 3], [2]));
    assert.isTrue(bytes.endsWith([1, 2, 3], list.empty<U8>()));
    assert.isTrue(bytes.endsWith(list.empty<U8>(), list.empty<U8>()));
    assert.isFalse(bytes.endsWith(list.empty<U8>(), [1]));
}

test "split gives one more piece than there are separators" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.split(ctx, [1, 0, 2, 0, 3], [0]), [[1], [2], [3]]);
    // Empty pieces are pieces: a leading and a trailing separator each make one.
    assert.equal(bytes.split(ctx, [0, 1, 0], [0]), [
        list.empty<U8>(),
        [1],
        list.empty<U8>(),
    ]);
    // No separator at all is one piece, which is the whole input.
    assert.equal(bytes.split(ctx, [1, 2], [9]), [[1, 2]]);
    assert.equal(bytes.split(ctx, list.empty<U8>(), [0]), [list.empty<U8>()]);
    // An empty separator would cut everywhere, so it cuts nowhere.
    assert.equal(bytes.split(ctx, [1, 2], list.empty<U8>()), [[1, 2]]);
    // A multi-byte separator, which is what a multipart boundary is.
    assert.equal(bytes.split(ctx, [1, 13, 10, 2], [13, 10]), [[1], [2]]);
}

test "join puts the separator between and not around" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.join(ctx, [[1], [2], [3]], [0]), [1, 0, 2, 0, 3]);
    assert.equal(bytes.join(ctx, [[1, 2]], [0]), [1, 2]);
    assert.equal(bytes.join(ctx, list.empty<[U8]>(), [0]), list.empty<U8>());
    // An empty first piece must not swallow its separator.
    assert.equal(bytes.join(ctx, [list.empty<U8>(), [1]], [0]), [0, 1]);
    assert.equal(bytes.join(ctx, [[1], [2]], list.empty<U8>()), [1, 2]);
}

test "join inverts split when no piece holds the separator" {
    let ctx = context {
        Allocator: alloc(),
    };
    let original: [U8] = [1, 13, 10, 2, 3, 13, 10, 4];
    let separator: [U8] = [13, 10];
    assert.equal(
        bytes.join(ctx, bytes.split(ctx, original, separator), separator),
        original,
    );
}

// --- sixteen bits ------------------------------------------------------------------

test "two octets, both ends first" {
    assert.equal(bytes.fromU16BigEndian(258), [1, 2]);
    assert.equal(bytes.fromU16LittleEndian(258), [2, 1]);
    assert.equal(bytes.fromU16BigEndian(0), [0, 0]);
    // The whole width, including the top bit.
    assert.equal(bytes.fromU16BigEndian(65535), [255, 255]);
    assert.equal(bytes.fromU16BigEndian(32768), [128, 0]);
    assert.equal(bytes.fromU16LittleEndian(32768), [0, 128]);
}

test "sixteen bits round-trip in both orders" {
    assert.equal(bytes.toU16BigEndian(bytes.fromU16BigEndian(65535), 0), .Some(65535));
    assert.equal(
        bytes.toU16LittleEndian(bytes.fromU16LittleEndian(65535), 0),
        .Some(65535),
    );
    assert.equal(bytes.toU16BigEndian([1, 2], 0), .Some(258));
    assert.equal(bytes.toU16LittleEndian([1, 2], 0), .Some(513));
}

test "reading sixteen bits past the end is .None rather than a short number" {
    assert.equal(bytes.toU16BigEndian([1], 0), .None);
    assert.equal(bytes.toU16BigEndian([1, 2], 1), .None);
    assert.equal(bytes.toU16LittleEndian([1, 2], 0 - 1), .None);
    assert.equal(bytes.toU16BigEndian(list.empty<U8>(), 0), .None);
    // An offset reads from where it points.
    assert.equal(bytes.toU16BigEndian([9, 1, 2], 1), .Some(258));
}

// --- base64url, length by length ---------------------------------------------------

/// Twelve octets whose base64 lands on the two characters the alphabets spell
/// differently, so every prefix of it is a case where `-` and `_` matter.
let SAMPLE: [U8] = [251, 239, 190, 0, 255, 1, 128, 127, 64, 200, 15, 240];

test "base64url writes every length from nothing to twelve octets" {
    let ctx = context {
        Allocator: alloc(),
    };
    let written = list
        .range(ctx, 0, 13)
        .mapCtx(ctx, fn(c, n) => bytes.toBase64Url(c, SAMPLE.take(c, n)));
    assert.equal(written, [
        "",
        "-w",
        "--8",
        "----",
        "----AA",
        "----AP8",
        "----AP8B",
        "----AP8BgA",
        "----AP8BgH8",
        "----AP8BgH9A",
        "----AP8BgH9AyA",
        "----AP8BgH9AyA8",
        "----AP8BgH9AyA_w",
    ]);
    // Three octets to four characters, and no `=` at any remainder.
    let widths = written.map(ctx, fn(text) => text.length());
    assert.equal(widths, [0, 2, 3, 4, 6, 7, 8, 10, 11, 12, 14, 15, 16]);
    assert.isTrue(written.all(fn(text) => !text.contains("=")));
}

test "base64url reads every length back, padded or not" {
    let ctx = context {
        Allocator: alloc(),
    };
    let ok = list
        .range(ctx, 0, 13)
        .mapCtx(ctx, fn(c, n) => {
            let raw = SAMPLE.take(c, n);
            let unpadded = bytes.toBase64Url(c, raw);
            // The padded spelling of the same thing: `=` up to a group of four.
            let short = unpadded.length() % 4;
            let padded = if (short == 0) {
                unpadded
            } else {
                unpadded.concat(c, "=".repeat(c, 4 - short))
            };
            bytes.fromBase64Url(c, unpadded) == .Ok(raw)
                && bytes.fromBase64Url(c, padded) == .Ok(raw)
        });
    assert.isTrue(ok.all(fn(good) => good));
}

test "base64url refuses every character outside its alphabet" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The two the standard alphabet has and this one does not, at the front and
    // in the middle.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "+---")), DecodeError(0));
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "--+-")), DecodeError(2));
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "--/-")), DecodeError(2));
    // Whitespace is not skipped: this reads one spelling.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-- 8")), DecodeError(2));
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-\n-8")), DecodeError(1));
    // A character outside ASCII entirely.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-é-8")), DecodeError(1));
    // Padding is only ever the last one or two characters.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-=-8")), DecodeError(1));
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "=---")), DecodeError(0));
    // And one character past a group of four is a length no base64 has, which
    // is reported at the end of the input rather than at a character.
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-")), DecodeError(1));
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "-----")), DecodeError(5));
    assert.equal(assert.err(bytes.fromBase64Url(ctx, "---------")), DecodeError(9));
}

// --- searching over octets that repeat -----------------------------------------------

test "a needle that overlaps itself is found at every start it has" {
    // Three ones hold two overlapping pairs, and the scan answers the first.
    assert.equal(bytes.indexOf([1, 1, 1], [1, 1]), .Some(0));
    assert.equal(bytes.indexOfFrom([1, 1, 1], [1, 1], 1), .Some(1));
    assert.equal(bytes.indexOfFrom([1, 1, 1], [1, 1], 2), .None);
    // `aaa` inside `aaaaa` starts at 0, 1 and 2.
    assert.equal(bytes.indexOfFrom([1, 1, 1, 1, 1], [1, 1, 1], 0), .Some(0));
    assert.equal(bytes.indexOfFrom([1, 1, 1, 1, 1], [1, 1, 1], 1), .Some(1));
    assert.equal(bytes.indexOfFrom([1, 1, 1, 1, 1], [1, 1, 1], 2), .Some(2));
    assert.equal(bytes.indexOfFrom([1, 1, 1, 1, 1], [1, 1, 1], 3), .None);
    // A needle exactly as long as the haystack fits at 0 and nowhere else.
    assert.equal(bytes.indexOf([1, 2, 3], [1, 2, 3]), .Some(0));
    assert.equal(bytes.indexOfFrom([1, 2, 3], [1, 2, 3], 1), .None);
    // One octet longer than the haystack never fits, wherever it starts.
    assert.equal(bytes.indexOf([1, 2, 3], [1, 2, 3, 4]), .None);
    assert.equal(bytes.indexOfFrom([1, 2, 3], [1, 2, 3, 4], 0), .None);
    // `split` cuts past each match rather than inside it, so overlapping
    // occurrences give the pieces between the ones it took.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.split(ctx, [1, 1, 1, 1], [1, 1]), [
        list.empty<U8>(),
        list.empty<U8>(),
        list.empty<U8>(),
    ]);
    assert.equal(bytes.split(ctx, [1, 1, 1], [1, 1]), [list.empty<U8>(), [1]]);
}

// --- every shape of octet that is not UTF-8 ---------------------------------------

/// U+FFFD, which is what a sequence that is not one becomes.
let BAD: Str = "�";

test "the widest and narrowest sequence of every width decodes whole" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The first and last code point each width encodes, which is where the
    // narrowed second-byte ranges that reject an overlong sit.
    let edges: [[U8]] = [
        [0x00],
        [0x7f],
        [0xc2, 0x80],
        [0xdf, 0xbf],
        [0xe0, 0xa0, 0x80],
        [0xed, 0x9f, 0xbf],
        [0xee, 0x80, 0x80],
        [0xef, 0xbf, 0xbf],
        [0xf0, 0x90, 0x80, 0x80],
        [0xf4, 0x8f, 0xbf, 0xbf],
    ];
    let lengths = edges.mapCtx(ctx, fn(c, raw) => bytes.fromUtf8Lossy(c, raw).length());
    assert.equal(lengths, list.repeat(ctx, 1, 10));
    // None of them replaced anything, so lossy and strict agree on all ten.
    let same = edges.mapCtx(ctx, fn(c, raw) => {
        bytes.fromUtf8Lossy(c, raw) == assert.ok(bytes.fromUtf8(c, raw))
    });
    assert.isTrue(same.all(fn(ok) => ok));
}

test "an overlong encoding replaces one character per byte" {
    let ctx = context {
        Allocator: alloc(),
    };
    // A lead byte that can only ever begin an overlong leads nothing at all, so
    // it and each byte after it replace on their own.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xc0, 0x80]), str.format(ctx, "${BAD}${BAD}"));
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xc1, 0xbf]), str.format(ctx, "${BAD}${BAD}"));
    // The three- and four-byte overlongs are caught by the narrowed range for
    // the *second* byte, before a code point is ever assembled.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xe0, 0x80, 0xaf]).length(), 3);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xe0, 0x9f, 0xbf]).length(), 3);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xf0, 0x80, 0x80, 0xaf]).length(), 4);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xf0, 0x8f, 0xbf, 0xbf]).length(), 4);
    // And `fromUtf8` refuses every one of them rather than reading a character.
    let overlongs: [[U8]] = [
        [0xc0, 0x80],
        [0xc1, 0xbf],
        [0xe0, 0x80, 0xaf],
        [0xe0, 0x9f, 0xbf],
        [0xf0, 0x80, 0x80, 0xaf],
        [0xf0, 0x8f, 0xbf, 0xbf],
    ];
    assert.isTrue(
        overlongs
            .mapCtx(ctx, fn(c, raw) => bytes.fromUtf8(c, raw).isErr())
            .all(fn(bad) => bad),
    );
}

test "a surrogate and a code point past the end each replace" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The whole surrogate range: `ed` may lead, but not with a second byte
    // above `9f`.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xed, 0xa0, 0x80]).length(), 3);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xed, 0xbf, 0xbf]).length(), 3);
    // A surrogate *pair* written as two sequences is six replacements, not one
    // character.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xed, 0xa0, 0xbd, 0xed, 0xb8, 0x80]).length(), 6);
    // One past U+10FFFF, caught by `f4`'s narrowed second byte.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xf4, 0x90, 0x80, 0x80]).length(), 4);
    // And the lead bytes that lead nothing at all.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xf5, 0x80, 0x80, 0x80]).length(), 4);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xf8]), BAD);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xfe]), BAD);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xff]), BAD);
    // A run of continuation bytes with nothing leading them.
    assert.equal(bytes.fromUtf8Lossy(ctx, [0x80, 0x80, 0x80]).length(), 3);
    assert.equal(bytes.fromUtf8Lossy(ctx, [0xbf]), BAD);
}

test "a sequence cut short costs one replacement wherever it was cut" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Every truncation of a two-, three- and four-byte sequence, at the end of
    // the input: one maximal subpart, so one replacement each.
    let cut: [[U8]] = [
        [0xc2],
        [0xe2],
        [0xe2, 0x82],
        [0xf0],
        [0xf0, 0x9f],
        [0xf0, 0x9f, 0x98],
    ];
    let lengths = cut.mapCtx(ctx, fn(c, raw) => bytes.fromUtf8Lossy(c, raw).length());
    assert.equal(lengths, list.repeat(ctx, 1, 6));
    // The same cuts with a plain letter after them: one replacement, then the
    // letter, because the byte that ended the subpart is read on its own terms.
    let followed = cut.mapCtx(ctx, fn(c, raw) => {
        bytes.fromUtf8Lossy(c, raw.push(c, 0x41))
    });
    assert.equal(followed, list.repeat(ctx, str.format(ctx, "${BAD}A"), 6));
    // And a good character on either side of a bad one survives.
    assert.equal(
        bytes.fromUtf8Lossy(ctx, [0x41, 0xe2, 0x82, 0x42]),
        str.format(ctx, "A${BAD}B"),
    );
}
