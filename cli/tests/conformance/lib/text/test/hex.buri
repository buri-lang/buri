// Hexadecimal, and the general radix underneath it: `character.fromDigit` and
// `character.isHexDigit`, `number.toHex`, `str.toRadix`, and `core/bytes`' pair.
//
// One file, because these are four modules answering one question and the
// interesting assertions are the ones that cross between them: a number
// rendered by `number.toHex` and read back by `str.toRadix`, and a byte string
// rendered by `bytes.toHex` two digits at a time that has to agree with
// `number.toHex` at a width of two.

from "core/bytes" import * as bytes;
from "core/character" import * as character;
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/number" import * as number;
from "core/testing/assert" import * as assert;

// --- character.fromDigit -----------------------------------------------------

test "fromDigit is the digit's character, lowercase" {
    assert.equal(assert.some(character.fromDigit(0, 16)), '0');
    assert.equal(assert.some(character.fromDigit(9, 16)), '9');
    assert.equal(assert.some(character.fromDigit(10, 16)), 'a');
    assert.equal(assert.some(character.fromDigit(15, 16)), 'f');
}

test "fromDigit reaches base 36" {
    assert.equal(assert.some(character.fromDigit(35, 36)), 'z');
    assert.equal(assert.some(character.fromDigit(1, 2)), '1');
}

test "fromDigit refuses a digit the radix does not have" {
    assert.none(character.fromDigit(16, 16));
    assert.none(character.fromDigit(2, 2));
    assert.none(character.fromDigit(-1, 16));
}

test "fromDigit refuses a radix outside 2 to 36" {
    assert.none(character.fromDigit(0, 1));
    assert.none(character.fromDigit(0, 37));
    assert.none(character.fromDigit(0, 0));
}

test "fromDigit inverts toDigit over every base-36 digit" {
    let ctx = context {
        Allocator: alloc(),
    };
    let mismatched = list
        .range(ctx, 0, 36)
        .filter(ctx, fn(n) => {
            match (character.fromDigit(n, 36)) {
                .None => true,
                .Some(c) => c.toDigit(36) != .Some(n),
            }
        });
    assert.equal(mismatched.length(), 0);
}

// --- character.isHexDigit ----------------------------------------------------

test "isHexDigit accepts both cases" {
    assert.isTrue('0'.isHexDigit());
    assert.isTrue('9'.isHexDigit());
    assert.isTrue('a'.isHexDigit());
    assert.isTrue('f'.isHexDigit());
    assert.isTrue('A'.isHexDigit());
    assert.isTrue('F'.isHexDigit());
}

test "isHexDigit refuses what is not a hexadecimal digit" {
    assert.isFalse('g'.isHexDigit());
    assert.isFalse('G'.isHexDigit());
    assert.isFalse('z'.isHexDigit());
    assert.isFalse(' '.isHexDigit());
    assert.isFalse('-'.isHexDigit());
}

// --- number.toHex ----------------------------------------------------------------

test "toHex renders the shortest form when no width is asked for" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toHex(ctx, 0, 0), "0");
    assert.equal(number.toHex(ctx, 15, 0), "f");
    assert.equal(number.toHex(ctx, 255, 0), "ff");
    assert.equal(number.toHex(ctx, 4886718345, 0), "123456789");
}

test "toHex pads to the width and never truncates past it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toHex(ctx, 255, 4), "00ff");
    assert.equal(number.toHex(ctx, 0, 8), "00000000");
    // The width is a floor: nine digits of value do not fit in four.
    assert.equal(number.toHex(ctx, 4886718345, 4), "123456789");
    assert.equal(number.toHex(ctx, 255, -3), "ff");
}

test "toHex renders a negative number as its two's complement" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toHex(ctx, -1, 0), "ffffffffffffffff");
    assert.equal(number.toHex(ctx, -1, 4), "ffffffffffffffff");
    assert.equal(number.toHex(ctx, -256, 0), "ffffffffffffff00");
}

test "toHex reaches both ends of the range" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toHex(ctx, number.maxValue<I64>(), 16), "7fffffffffffffff");
    assert.equal(number.toHex(ctx, number.minValue<I64>(), 16), "8000000000000000");
}

test "toHex pads wider than the type is" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toHex(ctx, 255, 20), "000000000000000000ff");
}

test "sixteen digits of a U64 is toHex at a width of sixteen" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The shape a program writes out as a sixteen-call unrolled `nibble`: one
    // 64-bit value, sixteen lowercase digits. A `U64` past the signed maximum
    // wraps to a negative `Int` and renders as the same bit pattern, which is
    // what lets one function cover the whole unsigned range.
    let big: U64 = 18446744073709551615;
    let half: U64 = 9223372036854775808;
    let small: U64 = 291;
    assert.equal(number.toHex(ctx, big.wrapToI64(), 16), "ffffffffffffffff");
    assert.equal(number.toHex(ctx, half.wrapToI64(), 16), "8000000000000000");
    assert.equal(number.toHex(ctx, small.wrapToI64(), 16), "0000000000000123");
}

// --- str.toRadix --------------------------------------------------------------

test "toRadix reads hexadecimal in either case" {
    assert.equal(assert.some("ff".toRadix(16)), 255);
    assert.equal(assert.some("FF".toRadix(16)), 255);
    assert.equal(assert.some("dEaDbEeF".toRadix(16)), 3735928559);
    assert.equal(assert.some("0".toRadix(16)), 0);
}

test "toRadix reads the other bases" {
    assert.equal(assert.some("101".toRadix(2)), 5);
    assert.equal(assert.some("777".toRadix(8)), 511);
    assert.equal(assert.some("42".toRadix(10)), 42);
    assert.equal(assert.some("z".toRadix(36)), 35);
    assert.equal(assert.some("zz".toRadix(36)), 1295);
}

test "toRadix reads a leading minus and nothing else" {
    assert.equal(assert.some("-ff".toRadix(16)), -255);
    assert.equal(assert.some("-1".toRadix(2)), -1);
    assert.none("+1".toRadix(10));
    assert.none("-".toRadix(10));
    assert.none("--1".toRadix(10));
}

test "toRadix refuses a digit the radix does not have" {
    assert.none("8".toRadix(8));
    assert.none("2".toRadix(2));
    assert.none("g".toRadix(16));
    assert.none("0x1f".toRadix(16));
}

test "toRadix refuses anything that is not only digits" {
    assert.none("".toRadix(10));
    assert.none(" 1".toRadix(10));
    assert.none("1 ".toRadix(10));
    assert.none("1.0".toRadix(10));
    assert.none("1_000".toRadix(10));
}

test "toRadix refuses a radix outside 2 to 36" {
    assert.none("1".toRadix(1));
    assert.none("1".toRadix(37));
    assert.none("1".toRadix(0));
    assert.none("1".toRadix(-16));
}

test "toRadix answers None rather than a value Int cannot hold" {
    assert.equal(assert.some("7fffffffffffffff".toRadix(16)), number.maxValue<I64>());
    assert.equal(assert.some("-8000000000000000".toRadix(16)), number.minValue<I64>());
    assert.none("8000000000000000".toRadix(16));
    assert.none("-8000000000000001".toRadix(16));
    assert.none("ffffffffffffffff".toRadix(16));
}

test "toRadix in base ten agrees with toInt" {
    assert.equal("42".toRadix(10), "42".toInt());
    assert.equal("-42".toRadix(10), "-42".toInt());
    assert.equal("0".toRadix(10), "0".toInt());
    assert.equal("abc".toRadix(10), "abc".toInt());
    assert.equal("".toRadix(10), "".toInt());
}

// --- the two directions meet ---------------------------------------------------

test "toRadix reads back what toHex wrote" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values = [0, 1, 15, 16, 255, 4886718345, number.maxValue<I64>()];
    let broken = values.filterCtx(ctx, fn(c, v) => {
        number.toHex(c, v, 0).toRadix(16) != .Some(v)
    });
    assert.equal(broken.length(), 0);
}

// --- bytes.toHex and bytes.fromHex ----------------------------------------------

test "toHex is two lowercase digits a byte" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bytes.toHex(ctx, [0, 1, 15, 16, 255]), "00010f10ff");
    assert.equal(bytes.toHex(ctx, []), "");
    assert.equal(bytes.toHex(ctx, [171]), "ab");
}

test "toHex of one byte is toHex of the number at width two" {
    let ctx = context {
        Allocator: alloc(),
    };
    let disagreed = list
        .range(ctx, 0, 256)
        .filterCtx(ctx, fn(c, n) => {
            bytes.toHex(c, [n.wrapToU8()]) != number.toHex(c, n, 2)
        });
    assert.equal(disagreed.length(), 0);
}

test "fromHex reads back every byte toHex wrote" {
    let ctx = context {
        Allocator: alloc(),
    };
    let all = list.range(ctx, 0, 256).map(ctx, fn(n) => n.wrapToU8());
    assert.equal(assert.ok(bytes.fromHex(ctx, bytes.toHex(ctx, all))), all);
}

test "fromHex reads uppercase too" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.ok(bytes.fromHex(ctx, "ABCD")), [171, 205]);
}

// --- number.toRadix -------------------------------------------------------------------
//
// `toHex` renders a bit pattern; this renders a signed numeral, in any base
// from 2 to 36. `str.toRadix` reads back exactly what it writes, which is the
// round trip the two assertions below are for.

test "toRadix writes the digits of a base" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toRadix(ctx, 0, 10), "0");
    assert.equal(number.toRadix(ctx, 255, 16), "ff");
    assert.equal(number.toRadix(ctx, 255, 2), "11111111");
    assert.equal(number.toRadix(ctx, 8, 8), "10");
    assert.equal(number.toRadix(ctx, 1234567890, 10), "1234567890");
    assert.equal(number.toRadix(ctx, 35, 36), "z");
    assert.equal(number.toRadix(ctx, 1295, 36), "zz");
}

test "toRadix writes a sign rather than a two's complement" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(number.toRadix(ctx, -5, 2), "-101");
    assert.equal(number.toRadix(ctx, -255, 16), "-ff");
    assert.equal(number.toRadix(ctx, -1, 10), "-1");
    // Where `toHex` says the whole sixty-four-bit pattern.
    assert.equal(number.toHex(ctx, -1, 0), "ffffffffffffffff");
}

test "toRadix reaches both ends of Int" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        number.toRadix(ctx, number.maxValue<I64>(), 10),
        "9223372036854775807",
    );
    assert.equal(
        number.toRadix(ctx, number.minValue<I64>(), 10),
        "-9223372036854775808",
    );
    assert.equal(number.toRadix(ctx, number.minValue<I64>(), 16), "-8000000000000000");
}

test "toRadix clamps a radix it has no alphabet for" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Below two is read as two, above thirty-six as thirty-six.
    assert.equal(number.toRadix(ctx, 5, 1), "101");
    assert.equal(number.toRadix(ctx, 5, 1), number.toRadix(ctx, 5, 2));
    assert.equal(number.toRadix(ctx, 5, 0), number.toRadix(ctx, 5, 2));
    assert.equal(number.toRadix(ctx, 5, -10), number.toRadix(ctx, 5, 2));
    assert.equal(
        number.toRadix(ctx, 5, number.minValue<I64>()),
        number.toRadix(ctx, 5, 2),
    );
    // Thirty-six is the last base there is an alphabet for; thirty-seven is the
    // first one there is not.
    assert.equal(number.toRadix(ctx, 40, 36), "14");
    assert.equal(number.toRadix(ctx, 40, 37), number.toRadix(ctx, 40, 36));
    assert.equal(number.toRadix(ctx, 40, 99), number.toRadix(ctx, 40, 36));
    assert.equal(
        number.toRadix(ctx, 40, number.maxValue<I64>()),
        number.toRadix(ctx, 40, 36),
    );
    // A negative value keeps its sign at either end of the clamp.
    assert.equal(number.toRadix(ctx, -5, 1), "-101");
    assert.equal(number.toRadix(ctx, -40, 37), "-14");
    // And zero is one digit in every base, clamped or not.
    assert.equal(number.toRadix(ctx, 0, 1), "0");
    assert.equal(number.toRadix(ctx, 0, 37), "0");
    assert.equal(number.toRadix(ctx, 0, -3), "0");
}

test "str.toRadix reads back what number.toRadix wrote" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values = [0, 1, -1, 7, -7, 255, -256, 1234567890, number.maxValue<I64>()];
    let broken = values.filterCtx(ctx, fn(c, v) => {
        let written = number.toRadix(c, v, 7);
        written.toRadix(7) != .Some(v)
    });
    assert.isEmpty(broken);
}
