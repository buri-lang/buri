// core/hash — FNV-1a, CRC-32C and SipHash-2-4, against their published vectors.
//
// Every expected value here was published by somebody else. The hex spelling is
// deliberate: a checksum is compared against a number written in a
// specification, and a decimal `U32` in an assertion is a number nobody can
// look up.

from "core/bits" import * as bits;
from "core/bytes" import * as bytes;
from "core/hash" import * as hash;
from "core/list" import * as list;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

// The eight hex digits of a 32-bit answer, and the sixteen of a 64-bit one.
fn hex32(x: U32): Str {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.toHex(ctx, bytes.fromU32BigEndian(x))
}

fn hex64(x: U64): Str {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.toHex(ctx, bytes.fromU64BigEndian(x))
}

fn octets(text: Str): [U8] {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.toUtf8(ctx, text)
}

// --- FNV-1a -------------------------------------------------------------------------
//
// Landon Curt Noll's reference vectors for FNV-1a, the ones every
// reimplementation is checked against.

test "FNV-1a at 32 bits" {
    assert.equal(hex32(hash.fnv1a32(list.empty<U8>())), "811c9dc5");
    assert.equal(hex32(hash.fnv1a32(octets("a"))), "e40c292c");
    assert.equal(hex32(hash.fnv1a32(octets("foobar"))), "bf9cf968");
}

test "FNV-1a at 64 bits" {
    assert.equal(hex64(hash.fnv1a64(list.empty<U8>())), "cbf29ce484222325");
    assert.equal(hex64(hash.fnv1a64(octets("a"))), "af63dc4c8601ec8c");
    assert.equal(hex64(hash.fnv1a64(octets("foobar"))), "85944171f73967e8");
}

// The empty input is the offset basis rather than a special case, which is what
// lets a caller start a rolling hash from the exported constant and get the
// same answers.
test "the offset basis is where the fold starts" {
    assert.equal(hash.fnv1a32(list.empty<U8>()), hash.FNV1A32_OFFSET);
    assert.equal(hash.fnv1a64(list.empty<U8>()), hash.FNV1A64_OFFSET);
}

test "stepping one octet at a time is the same hash" {
    let ctx = context {
        Allocator: alloc(),
    };
    let body = octets("foobar");
    let stepped32 = body.fold(fn(h, o) => hash.fnv1a32Step(h, o), hash.FNV1A32_OFFSET);
    let stepped64 = body.fold(fn(h, o) => hash.fnv1a64Step(h, o), hash.FNV1A64_OFFSET);
    assert.equal(stepped32, hash.fnv1a32(body));
    assert.equal(stepped64, hash.fnv1a64(body));
    // And splitting the input anywhere gives the same answer, which is the
    // whole property a rolling checksum is used for.
    let head = body.take(ctx, 2);
    let tail = body.drop(ctx, 2);
    let split = tail.fold(
        fn(h, o) => hash.fnv1a64Step(h, o),
        head.fold(fn(h, o) => hash.fnv1a64Step(h, o), hash.FNV1A64_OFFSET),
    );
    assert.equal(split, hash.fnv1a64(body));
}

// A hash that ignored an octet, or folded them in the wrong order, would still
// pass every vector above if the vectors were all it had.
test "order and content both matter" {
    assert.notEqual(hash.fnv1a32(octets("ab")), hash.fnv1a32(octets("ba")));
    assert.notEqual(hash.fnv1a64(octets("ab")), hash.fnv1a64(octets("ba")));
}

// --- CRC-32C ------------------------------------------------------------------------

// The check value every catalogue of CRC parameters publishes: the CRC of the
// nine ASCII digits.
test "the CRC-32C check value" {
    assert.equal(hex32(hash.crc32c(octets("123456789"))), "e3069283");
}

test "the empty input is zero" {
    // All-ones in, all-ones out: the two cancel.
    assert.equal(hash.crc32c(list.empty<U8>()), 0);
}

// RFC 3720 appendix B.4 — the iSCSI CRC examples.
test "the RFC 3720 vectors" {
    let ctx = context {
        Allocator: alloc(),
    };
    let zeros: [U8] = list.repeat(ctx, 0, 32);
    assert.equal(hex32(hash.crc32c(zeros)), "8a9136aa");

    let ascending = list.range(ctx, 0, 32).map(ctx, fn(i) => i.wrapToU8());
    assert.equal(hex32(hash.crc32c(ascending)), "46dd794e");

    let descending = ascending.reverse(ctx);
    assert.equal(hex32(hash.crc32c(descending)), "113fdb5c");
}

// Every width the inner loop of a fast CRC handles differently: one octet,
// a word short, a word, a word and the octets after it, and the long runs.
// The expected values come from a bitwise implementation outside this
// repository, over the octets `(31 * i + 7) mod 256`.
fn sloped<C: Allocator>(ctx: C, n: Int, step: Int, start: Int): [U8] {
    list.range(ctx, 0, n).map(ctx, fn(i) => (i * step + start).wrapToU8())
}

fn crcOfSloped(n: Int): Str {
    let ctx = context {
        Allocator: alloc(),
    };
    hex32(hash.crc32c(sloped(ctx, n, 31, 7)))
}

test "every length from one octet to seventeen" {
    assert.equal(crcOfSloped(1), "86b737ba");
    assert.equal(crcOfSloped(2), "8d10d7a1");
    assert.equal(crcOfSloped(3), "765a7c83");
    assert.equal(crcOfSloped(4), "65f1c5dc");
    assert.equal(crcOfSloped(5), "5d2e4463");
    assert.equal(crcOfSloped(6), "63c6d8d2");
    assert.equal(crcOfSloped(7), "5110a112");
    assert.equal(crcOfSloped(8), "40795c72");
    assert.equal(crcOfSloped(9), "6fe35da6");
    assert.equal(crcOfSloped(10), "6ade9a0a");
    assert.equal(crcOfSloped(11), "b63ea091");
    assert.equal(crcOfSloped(12), "2e6e07e6");
    assert.equal(crcOfSloped(13), "7fd38d92");
    assert.equal(crcOfSloped(14), "d8dbd813");
    assert.equal(crcOfSloped(15), "9b0c1517");
    assert.equal(crcOfSloped(16), "cf7845a4");
    assert.equal(crcOfSloped(17), "10c70233");
}

test "four kilobytes and the lengths just past them" {
    assert.equal(crcOfSloped(4096), "e1c2f7e8");
    assert.equal(crcOfSloped(4097), "efbf0598");
    assert.equal(crcOfSloped(4103), "a6b5a810");
}

test "all zeros and all ones" {
    let ctx = context {
        Allocator: alloc(),
    };
    // RFC 3720 B.4 gives both at 32 octets.
    assert.equal(hex32(hash.crc32c(list.repeat(ctx, 0, 32))), "8a9136aa");
    assert.equal(hex32(hash.crc32c(list.repeat(ctx, 255, 32))), "62a8ab43");
    assert.equal(hex32(hash.crc32c(list.repeat(ctx, 0, 4096))), "98f94189");
    assert.equal(hex32(hash.crc32c(list.repeat(ctx, 255, 4096))), "25c1fe13");
}

// CRC-32C one bit at a time, straight from the definition: shift right, and
// fold the reflected polynomial in whenever a one falls off the end.
fn referenceCrc32c(b: [U8]): U32 {
    b.fold(fn(crc, octet) => referenceShifts(crc ^ octet.toU32(), 8), 0xffffffff)
        ^ 0xffffffff
}

fn referenceShifts(crc: U32, left: Int): U32 {
    if (left == 0) {
        crc
    } else {
        let shifted = bits.shiftRightU32(crc, 1);
        let next = if (crc & 1 == 1) { shifted ^ 0x82f63b78 } else { shifted };
        referenceShifts(next, left - 1)
    }
}

// The lengths `crc32c` gives a different answer from the definition at, for
// windows starting `offset` octets into `source`.
fn disagreements<C: Allocator>(
    ctx: C,
    source: [U8],
    offset: Int,
    lengths: [Int],
): [Int] {
    lengths
        .mapCtx(ctx, fn(c, n) => {
            let window = source.slice(c, offset, offset + n);
            if (hash.crc32c(window) == referenceCrc32c(window)) { -1 } else { n }
        })
        .filter(ctx, fn(n) => n >= 0)
}

test "the definition agrees at every length and starting offset" {
    let ctx = context {
        Allocator: alloc(),
    };
    let source = sloped(ctx, 4200, 167, 13);
    let lengths = list
        .range(ctx, 0, 41)
        .concat(ctx, [63, 64, 65, 255, 256, 257, 1000, 4095, 4096, 4097]);
    let offsets = list.range(ctx, 0, 9);
    let wrong = offsets.mapCtx(ctx, fn(c, offset) => {
        disagreements(c, source, offset, lengths)
    });
    assert.equal(wrong, list.repeat(ctx, list.empty<Int>(), 9));
}

// --- SipHash-2-4 --------------------------------------------------------------------
//
// The reference implementation's key — the sixteen octets 00..0f, read as two
// little-endian words — and its table of answers for the inputs 00, 00 01,
// 00 01 02, and so on. The lengths chosen here are the ones where the
// implementation can go wrong: none, one short of a word, exactly a word, one
// short of two words, exactly two, and four.

let K0: U64 = 0x0706050403020100;

let K1: U64 = 0x0f0e0d0c0b0a0908;

fn vector(n: Int): Str {
    let ctx = context {
        Allocator: alloc(),
    };
    hex64(hash.siphash24(K0, K1, list.range(ctx, 0, n).map(ctx, fn(i) => i.wrapToU8())))
}

test "the SipHash-2-4 reference vectors" {
    assert.equal(vector(0), "726fdb47dd0e0e31");
    assert.equal(vector(1), "74f839c593dc67fd");
    assert.equal(vector(7), "ab0200f58b01d137");
    assert.equal(vector(8), "93f5f5799a932462");
    assert.equal(vector(15), "a129ca6149be45e5");
    assert.equal(vector(16), "3f2acc7f57c29bdb");
    assert.equal(vector(32), "7127512f72f27cce");
}

// The length goes into the top octet of the final word, so an input and the
// same input with a zero on the end are not the same hash. Without that byte
// they would be.
test "trailing zeros are not free" {
    assert.notEqual(hash.siphash24(K0, K1, [0]), hash.siphash24(K0, K1, [0, 0]));
}

test "the key is part of the answer" {
    let body = octets("foobar");
    assert.notEqual(hash.siphash24(K0, K1, body), hash.siphash24(K1, K0, body));
    assert.notEqual(hash.siphash24(K0, K1, body), hash.siphash24(0, 0, body));
}

// --- Nothing here is a digest -------------------------------------------------------

// Not a security property, just the arithmetic: a 32-bit checksum has 2^32
// values, so two inputs sharing one is a coincidence rather than a scandal.
// This is the test that says the module knows what it is.
test "a checksum is four octets wide and says so" {
    assert.equal(bytes.fromU32BigEndian(hash.crc32c(octets("x"))).length(), 4);
    assert.equal(bytes.fromU64BigEndian(hash.fnv1a64(octets("x"))).length(), 8);
}
