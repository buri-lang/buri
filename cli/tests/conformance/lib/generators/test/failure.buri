// The signature failure: `run` answers `.Err` and writes nothing.

from "core/codegen" import * as codegen;
from "core/codegen" import { Response };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, IoError, Stdin, Stdout };
from "platform/effect/testing" import { alloc, stdin, stdout };

test "no input at all is an error, and nothing is written" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin(),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: standard input held no request",
    );
    assert.equal(out.captured(), "");
}

test "a line that is not JSON is an error" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["not a document"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: the request is not JSON: .Unexpected(0)",
    );
    assert.equal(out.captured(), "");
}

test "a JSON document that is not an object is an error" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["[1,2]"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: the request is not an object",
    );
    assert.equal(out.captured(), "");
}

test "an inputs that is not a list is an error" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["{\"inputs\":\"lib/wire/p.proto\"}"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: `inputs` is not a list",
    );
    assert.equal(out.captured(), "");
}

test "an input that is not a (path, text) pair is an error" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["{\"inputs\":[[\"lib/wire/p.proto\"]]}"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: `inputs` holds something that is not a (path, text) pair",
    );
    assert.equal(out.captured(), "");
}

test "a dependency that is not a pair of strings is an error" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["{\"inputs\":[],\"dependencies\":[[\"a\",7]]}"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: `dependencies` holds something that is not a (path, text) pair",
    );
    assert.equal(out.captured(), "");
}

test "an input that is not a list at all is not a pair" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["{\"inputs\":[\"lib/wire/p.proto\"]}"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: `inputs` holds something that is not a (path, text) pair",
    );
    assert.equal(out.captured(), "");
}

/// A standard output whose reader has gone: every write fails with `why`.
struct Gone {
    why: Str,
}

impl Stdout for Gone {
    fn print(self, _text: Template): Result<(), IoError> {
        .Err(.Other(self.why))
    }

    fn println(self, _text: Template): Result<(), IoError> {
        .Err(.Other(self.why))
    }

    fn writeBytes(self, _bytes: [U8]): Result<(), IoError> {
        .Err(.Other(self.why))
    }
}

test "a response that can't be written is an error that says why" {
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["{\"inputs\":[],\"dependencies\":[]}"]),
        Stdout: Gone { why: "pipe closed" },
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: the response could not be written: .Other(\"pipe closed\")",
    );
}

test "an input whose path is not a string is not a pair" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdin: stdin().lines(["{\"inputs\":[[7,\"syntax = 3;\"]]}"]),
        Stdout: out,
    };
    let silent = fn(_c, _r) => Response { modules: [], diagnostics: [] };
    assert.equal(
        assert.err(codegen.run(ctx, silent)),
        "codegen: `inputs` holds something that is not a (path, text) pair",
    );
    assert.equal(out.captured(), "");
}
