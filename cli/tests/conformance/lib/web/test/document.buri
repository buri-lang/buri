// `ui/web`: what a worker sends, asserted on the bytes it sends.
//
//   - the HTML a tree renders to is the markup the page's own renderer builds,
//     which is the claim that there is one renderer and not two;
//   - the document carries the body and the state, and the state survives a
//     string that looks like the end of the script it sits in;
//   - `http.html` says what the body is.
//
// The page's half — `resume`, `state`, `path` and `route` — needs a document
// the browser parsed and an address bar over it, and neither exists here. A
// resume renders the tree against the markup that arrived, so what it wants is
// exactly the markup below, parsed. It is asserted where that can be had:
// `language::a_website_is_rendered_by_its_worker_and_resumed_by_its_page`
// drives a built artifact against a document holding what the worker sent, and
// presses the button.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/json" import * as json;
from "core/json" import { DecodeError, FromJson, Json, ToJson };
from "core/net/http" import * as http;
from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/testing" import { headless, render };
from "ui/web" import * as web;

derive FromJson, ToJson for Reading;
/// A state with a title a page would show and a string that closes a script.
struct Reading {
    title: Str,
    note: Str,
}

/// The one tree these tests render, built where both renderers can reach it.
fn tree<C>(): Node<C> {
    ui.region(.Main, [], [
        ui.heading(1, [], .Const("Titles")),
        ui.text(.Const("and text")),
    ])
}

/// A document named `title`, which is all the tests below say about their head.
fn named(title: Str): web.Document {
    web.Document { ..web.defaultDocument(), title }
}

/// The head a document opens with, up to the stylesheet the compiler extracted
/// — which is this artifact's own and not this package's to pin.
fn head(document: Str): Str {
    match (document.splitOnce("<style>")) {
        .Some(pair) => pair.0,
        .None => {
            match (document.splitOnce("</head>")) {
                .None => "",
                .Some(pair) => pair.0,
            }
        },
    }
}

/// The body of a document, without the state the page resumes from.
fn body(document: Str): Str {
    match (document.splitOnce("<body>")) {
        .None => "",
        .Some(pair) => {
            match (pair.1.splitOnce("<script")) {
                .None => "",
                .Some(inner) => inner.0,
            }
        },
    }
}

/// The state a document embedded, as the text the page reads back.
fn embedded(document: Str): Str {
    match (afterTheScriptTag(document).splitOnce("</script>")) {
        .None => "",
        .Some(inner) => inner.0,
    }
}

/// The path a document says it was rendered at, which is what `resume` compares
/// the address against.
fn renderedAt(document: Str): Str {
    match (document.splitOnce("data-path=\"")) {
        .None => "",
        .Some(pair) => {
            match (pair.1.splitOnce("\">")) {
                .None => "",
                .Some(inner) => inner.0,
            }
        },
    }
}

fn afterTheScriptTag(document: Str): Str {
    match (document.splitOnce("data-path=\"")) {
        .None => "",
        .Some(pair) => {
            match (pair.1.splitOnce("\">")) {
                .None => "",
                .Some(rest) => rest.1,
            }
        },
    }
}

test "a tree renders to HTML" {
    assert.equal(web.render(tree()), "<main><h1>Titles</h1>and text</main>");
}

test "what a worker renders is what the page would have built" {
    let ctx = context {
        Ui: headless(),
    };
    // The same tree, through the two renderers. They are one renderer, and
    // this is what says so.
    assert.equal(web.render(tree()), render(ctx, tree()).markup());
}

test "an empty tree renders to nothing at all" {
    assert.equal(web.render(ui.nothing()), "");
    // A region with no children is an element that holds nothing, which is not
    // the same as no element.
    assert.equal(web.render(ui.column([], [])), "<div class=\"lay-col\"></div>");
}

test "an element that holds nothing still writes its closing tag" {
    // An HTML parser reads `<div />` as an *opening* `<div>` and puts
    // everything after it inside, so an empty region written that way swallows
    // the rest of the page — and a page resuming on it sees a tree it does not
    // match. Every element that is not one of HTML's own empty ones closes.
    assert.equal(web.render(ui.region(.Main, [], [])), "<main></main>");
    assert.equal(
        web.render(ui.button(.Const(""), [], fn(_c, _e) => (), .Const(false))),
        "<button type=\"button\"></button>",
    );
    assert.equal(web.render(ui.form(fn(_c, _e) => (), [], [])), "<form></form>");
    assert.equal(web.render(ui.spacer()), "<div class=\"grow-1\"></div>");
    // And the ones HTML says hold nothing close themselves, because a closing
    // tag for one of those is markup a browser refuses to nest.
    assert.equal(web.render(ui.region(.Separator, [], [])), "<hr />");
    assert.equal(
        web.render(ui.image(.Const("/cat.png"), .Const(""), [])),
        "<img src=\"/cat.png\" alt=\"\" />",
    );
}

test "every kind of node renders" {
    let ctx = context {
        Ui: headless(),
    };
    let typed = signal(ctx, "ada");
    let ticked = signal(ctx, true);
    assert.equal(web.render(ui.text(.Const("plain"))), "plain");
    assert.equal(web.render(ui.stack([], [ui.text(.Const("in"))])), "<div>in</div>");
    assert.equal(web.render(ui.row([], [])), "<div class=\"lay-row\"></div>");
    assert.equal(web.render(ui.heading(2, [], .Const("two"))), "<h2>two</h2>");
    assert.equal(
        web.render(ui.link(.Const("/there"), [], [ui.text(.Const("go"))])),
        "<a href=\"/there\">go</a>",
    );
    assert.equal(
        web.render(ui.field(.Const("name"), .Text, [], typed, .Const(false))),
        "<label><span>name</span><input type=\"text\" value=\"ada\" /></label>",
    );
    // What is typed into a `textarea` is its text rather than an attribute.
    assert.equal(
        web.render(ui.field(.Const("story"), .Multiline, [], typed, .Const(false))),
        "<label><span>story</span><textarea>ada</textarea></label>",
    );
    // `checked` is a boolean attribute: it is written with no value at all,
    // which is how HTML spells one.
    assert.equal(
        web.render(ui.toggle(.Const("done"), [], ticked, .Const(false))),
        "<label><input type=\"checkbox\" checked /><span>done</span></label>",
    );
    // `disabled` is the other boolean attribute this vocabulary writes, and it
    // has to cross: a page that resumes on markup without it hands the reader a
    // control the server said was unavailable.
    assert.equal(
        web.render(ui.button(.Const("save"), [], fn(_c, _e) => (), .Const(true))),
        "<button type=\"button\" disabled>save</button>",
    );
    assert.equal(
        web.render(ui.field(.Const("name"), .Text, [], typed, .Const(true))),
        "<label><span>name</span><input type=\"text\" value=\"ada\" disabled /></label>",
    );
    assert.equal(
        web.render(ui.toggle(.Const("done"), [], ticked, .Const(true))),
        "<label><input type=\"checkbox\" checked disabled /><span>done</span></label>",
    );
    // A picture's styles are the picture's, so they cross as a class on the
    // `<img>` itself rather than on anything around it.
    assert.equal(
        web.render(ui.image(.Const("/cat.png"), .Const("a cat"), [.Width(.Full)])),
        "<img src=\"/cat.png\" alt=\"a cat\" class=\"w-full\" />",
    );
    // The three that decide what to render resolve rather than register: a
    // condition is read once, a computation is run once, and a list renders the
    // rows it has.
    assert.equal(
        web.render(
            ui.choose(.Const(true), ui.text(.Const("yes")), ui.text(.Const("no"))),
        ),
        "yes",
    );
    assert.equal(
        web.render(
            ui.choose(.Const(false), ui.text(.Const("yes")), ui.text(.Const("no"))),
        ),
        "no",
    );
    assert.equal(
        web.render(ui.computed(fn(_scope) => ui.text(.Const("built")))),
        "built",
    );
    assert.equal(
        web.render(
            ui.each(.Const(["a", "b"]), fn(item) => item, fn(_c, item, _i) => {
                ui.text(.Const(item))
            }),
        ),
        "ab",
    );
    // A list with no rows renders nothing, and the markers that hold its place
    // are the runtime's own bookkeeping rather than something a reader sees.
    let none: [Str] = [];
    assert.equal(
        web.render(
            ui.each(.Const(none), fn(item) => item, fn(_c, item, _i) => {
                ui.text(.Const(item))
            }),
        ),
        "",
    );
}

test "a heading's level clamps to the range a document has" {
    assert.equal(web.render(ui.heading(0, [], .Const("low"))), "<h1>low</h1>");
    assert.equal(web.render(ui.heading(-4, [], .Const("lower"))), "<h1>lower</h1>");
    assert.equal(web.render(ui.heading(7, [], .Const("high"))), "<h6>high</h6>");
}

test "a heading the worker sent carries the classes its styles chose" {
    // The level picks the element and the styles paint it, on the server as in
    // the browser. Without them the user agent's own sheet decides the type.
    assert.equal(
        web.render(
            ui.heading(2, [.FontSize(.Px(28)), .FontWeight(.Bold)], .Const("Prices")),
        ),
        "<h2 class=\"fs-28 fw-bold\">Prices</h2>",
    );
}

test "a bleed crosses the worker as the class the compiler wrote" {
    let ctx = context {
        Ui: headless(),
    };
    // The full-bleed separator inside a padded menu, rendered on the server and
    // in the browser. One renderer, so one answer.
    let menu = ui.stack([.Padding(.Px(4))], [
        ui.region(
            .Separator,
            [.Height(.Px(1)), .Bleed(.Start, .Px(4)), .Bleed(.End, .Px(4))],
            [],
        ),
    ]);
    assert.equal(
        web.render(menu),
        "<div class=\"p-4\"><hr class=\"h-1 bleed-start-4 bleed-end-4\" /></div>",
    );
    assert.equal(web.render(menu), render(ctx, menu).markup());
}

test "text is escaped, so a title cannot write markup" {
    assert.equal(
        web.render(ui.text(.Const("<b>& later</b>"))),
        "&lt;b&gt;&amp; later&lt;/b&gt;",
    );
    // The three that end a run of text, and the two that do not: a quote and an
    // apostrophe mean nothing between tags, so they are written as they were.
    assert.equal(
        web.render(ui.text(.Const("a & b < c > d \" e ' f"))),
        "a &amp; b &lt; c &gt; d \" e ' f",
    );
    // An ampersand already spelled as an entity is escaped again, because what
    // a page shows is the characters the state holds.
    assert.equal(web.render(ui.text(.Const("&amp;"))), "&amp;amp;");
}

test "an attribute is escaped too, quotes included" {
    assert.equal(
        web.render(ui.image(.Const("/a&b.png"), .Const("\"q\" <x>"), [])),
        "<img src=\"/a&amp;b.png\" alt=\"&quot;q&quot; &lt;x&gt;\" />",
    );
    assert.equal(
        web.render(ui.link(.Const("/a?x=1&y=2"), [], [])),
        "<a href=\"/a?x=1&amp;y=2\"></a>",
    );
}

test "the document carries the body and the state beside it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let state = Reading { title: "Titles", note: "plain" };
    let document = web.shell(
        ctx,
        "/",
        named("Titles"),
        web.render(tree()),
        state.toJson(ctx),
    );
    assert.isTrue(document.startsWith("<!doctype html>"));
    assert.equal(body(document), "<main><h1>Titles</h1>and text</main>");
    assert.equal(embedded(document), "{\"title\":\"Titles\",\"note\":\"plain\"}");
}

test "the document names the tab and the language it is in" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(
        ctx,
        "/",
        web.Document { ..web.defaultDocument(), title: "Buri Design" },
        "",
        .Null,
    );
    assert.equal(
        head(document),
        "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><title>Buri Design</title>",
    );
}

test "a title cannot write markup, and a lang cannot end the attribute" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(
        ctx,
        "/",
        web.Document { title: "<b>Tom & Jerry</b>", lang: "en\"><script>" },
        "",
        .Null,
    );
    assert.equal(
        head(document),
        "<!doctype html>\n<html lang=\"en&quot;&gt;&lt;script&gt;\">\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><title>&lt;b&gt;Tom &amp; Jerry&lt;/b&gt;</title>",
    );
}

test "a state that ends the script it sits in closes nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let state = Reading { title: "Titles", note: "</script><b>" };
    let document = web.shell(ctx, "/", named("Titles"), "", state.toJson(ctx));
    assert.isFalse(embedded(document).contains("</script>"));
    // And it is still the state, because a JSON reader reads the escape back.
    let read: Result<Reading, DecodeError> = json.decode(
        ctx,
        json.parse(ctx, embedded(document)).withDefault(.Null),
    );
    assert.equal(
        read.withDefault(Reading { title: "", note: "" }).note,
        "</script><b>",
    );
}

test "the state crosses as every shape JSON has" {
    let ctx = context {
        Allocator: alloc(),
    };
    let shapes: Json = .Object([
        ("nothing", .Null),
        ("yes", .Bool(true)),
        ("no", .Bool(false)),
        ("whole", .Num(7.0)),
        ("fraction", .Num(0.5)),
        ("negative", .Num(-2.0)),
        ("text", .Str("héllo ✓ 𝄞")),
        ("no fields", .Object([])),
        ("no items", .Array([])),
        ("items", .Array([.Num(1.0), .Str("two"), .Object([("deep", .Bool(true))])])),
    ]);
    let document = web.shell(ctx, "/", named("Titles"), "", shapes);
    assert.equal(
        embedded(document),
        "{\"nothing\":null,\"yes\":true,\"no\":false,\"whole\":7,\"fraction\":0.5,\"negative\":-2,\"text\":\"héllo ✓ 𝄞\",\"no fields\":{},\"no items\":[],\"items\":[1,\"two\",{\"deep\":true}]}",
    );
    // And it reads back as the same document, which is what the page does with
    // it.
    assert.equal(json.parse(ctx, embedded(document)).withDefault(.Null), shapes);
}

test "a state with no fields at all still crosses" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(embedded(web.shell(ctx, "/", named("Titles"), "", .Object([]))), "{}");
    assert.equal(embedded(web.shell(ctx, "/", named("Titles"), "", .Null)), "null");
}

test "an empty body is still a whole document" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(ctx, "/", named("Titles"), "", .Object([]));
    assert.isTrue(document.startsWith("<!doctype html>"));
    assert.equal(body(document), "");
    assert.isTrue(document.endsWith("</body>\n</html>\n"));
}

test "the document says which address it was rendered for" {
    let ctx = context {
        Allocator: alloc(),
    };
    let state = Reading { title: "Titles", note: "plain" };
    let document = web.shell(
        ctx,
        "/guide/routing",
        named("Titles"),
        web.render(tree()),
        state.toJson(ctx),
    );
    assert.equal(renderedAt(document), "/guide/routing");
    // The body and the state are where they were: the path rides on the script
    // rather than displacing anything.
    assert.equal(body(document), "<main><h1>Titles</h1>and text</main>");
    assert.equal(embedded(document), "{\"title\":\"Titles\",\"note\":\"plain\"}");
}

test "a path that could end the attribute it sits in ends nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(ctx, "/a\"><b>&x", named("Titles"), "", .Object([]));
    assert.equal(renderedAt(document), "/a&quot;&gt;&lt;b&gt;&amp;x");
    // And the state after it is still the state, so the tag was not cut short.
    assert.equal(embedded(document), "{}");
}

test "a document is answered as HTML" {
    let ctx = context {
        Allocator: alloc(),
    };
    let answer = http.html(ctx, "<p>hello</p>");
    assert.equal(answer.status, 200);
    assert.equal(
        answer.header("content-type").withDefault("none"),
        "text/html; charset=utf-8",
    );
    assert.equal(http.bodyText(ctx, answer.body).withDefault(""), "<p>hello</p>");
}
