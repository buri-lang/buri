// `ui/web`: what a worker sends, asserted on the bytes it sends.
//
//   - the HTML a tree renders to is the markup the page's own renderer builds,
//     which is the claim that there is one renderer and not two;
//   - the document carries the body and the state, and the state survives a
//     string that looks like the end of the script it sits in;
//   - `http.html` says what the body is.
//
// The page's half — `resume`, `state`, `path` and `route` — needs a document
// the browser parsed and an address bar over it, and neither exists here. A
// resume renders the tree against the markup that arrived, so what it wants is
// exactly the markup below, parsed. It is asserted where that can be had:
// `language::a_website_is_rendered_by_its_worker_and_resumed_by_its_page`
// drives a built artifact against a document holding what the worker sent, and
// presses the button.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/json" import * as json;
from "core/json" import { DecodeError, FromJson, Json, ToJson };
from "core/net/http" import * as http;
from "core/testing/assert" import * as assert;
from "ui/effect" import { Location, Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/testing" import { address, headless, observer, render };
from "ui/web" import * as web;

derive FromJson, ToJson for Reading;
/// A state with a title a page would show and a string that closes a script.
struct Reading {
    title: Str,
    note: Str,
}

/// The one tree these tests render, built where both renderers can reach it.
fn tree<C>(): Node<C> {
    ui.stack({
        styles: [],
        children: [
            ui.text({ content: .Const("Titles"), headingLevel: .Some(1) }),
            ui.text({ content: .Const("and text") }),
        ],
        role: .Some(.Main),
    })
}

/// A document named `title`, which is all the tests below say about their head.
fn named(title: Str): web.Document {
    web.Document { ..web.defaultDocument(), title }
}

/// The head a document opens with, up to the stylesheet the compiler extracted
/// — which is this artifact's own and not this package's to pin.
fn head(document: Str): Str {
    match (document.splitOnce("<style>")) {
        .Some(pair) => pair.0,
        .None => {
            match (document.splitOnce("</head>")) {
                .None => "",
                .Some(pair) => pair.0,
            }
        },
    }
}

/// The body of a document, without the state the page resumes from.
fn body(document: Str): Str {
    match (document.splitOnce("<body>")) {
        .None => "",
        .Some(pair) => {
            match (pair.1.splitOnce("<script")) {
                .None => "",
                .Some(inner) => inner.0,
            }
        },
    }
}

/// The state a document embedded, as the text the page reads back.
fn embedded(document: Str): Str {
    match (afterTheScriptTag(document).splitOnce("</script>")) {
        .None => "",
        .Some(inner) => inner.0,
    }
}

/// The path a document says it was rendered at, which is what `resume` compares
/// the address against.
fn renderedAt(document: Str): Str {
    match (document.splitOnce("data-path=\"")) {
        .None => "",
        .Some(pair) => {
            match (pair.1.splitOnce("\">")) {
                .None => "",
                .Some(inner) => inner.0,
            }
        },
    }
}

fn afterTheScriptTag(document: Str): Str {
    match (document.splitOnce("data-path=\"")) {
        .None => "",
        .Some(pair) => {
            match (pair.1.splitOnce("\">")) {
                .None => "",
                .Some(rest) => rest.1,
            }
        },
    }
}

test "a tree renders to HTML" {
    assert.equal(web.render<()>(tree()), "<main><h1>Titles</h1>and text</main>");
}

test "what a worker renders is what the page would have built" {
    let ctx = context {
        Ui: headless(),
    };
    // One reconciled tree, two serialisations: the worker writes HTML and the
    // test renderer writes the headerless scene. They agree on the tree — its
    // text and its shape — while each writes its own format.
    let page = render(ctx, tree());
    assert.equal(web.render<()>(tree()), "<main><h1>Titles</h1>and text</main>");
    assert.equal(page.text(), "Titles and text");
    assert.equal(page.count("h1"), 1);
    assert.equal(page.count("main"), 1);
}

test "an empty tree renders to nothing at all" {
    assert.equal(web.render<()>(ui.empty()), "");
    // A region with no children is an element that holds nothing, which is not
    // the same as no element.
    assert.equal(
        web.render<()>(
            ui.stack({ styles: [.Layout(.Column), .Group([])], children: [] }),
        ),
        "<div class=\"lay-col\"></div>",
    );
}

test "an element that holds nothing still writes its closing tag" {
    // An HTML parser reads `<div />` as an *opening* `<div>` and puts
    // everything after it inside, so an empty region written that way swallows
    // the rest of the page — and a page resuming on it sees a tree it does not
    // match. Every element that is not one of HTML's own empty ones closes.
    assert.equal(
        web.render<()>(ui.stack({ styles: [], children: [], role: .Some(.Main) })),
        "<main></main>",
    );
    assert.equal(
        web.render<()>(ui.button({ label: .Const(""), styles: [] })),
        "<button type=\"button\" aria-label=\"\"></button>",
    );
    assert.equal(
        web.render<()>(ui.form({ onSubmit: fn(_c) => (), children: [], styles: [] })),
        "<form></form>",
    );
    assert.equal(
        web.render<()>(ui.spacer({ size: .None })),
        "<div class=\"grow-1\"></div>",
    );
    // And the ones HTML says hold nothing close themselves, because a closing
    // tag for one of those is markup a browser refuses to nest.
    assert.equal(
        web.render<()>(ui.stack({ styles: [], children: [], role: .Some(.Separator) })),
        "<hr />",
    );
    assert.equal(
        web.render<()>(
            ui.image({
                source: .Const("/cat.png"),
                alt: .AccessibilityText(""),
                styles: [],
            }),
        ),
        "<img src=\"/cat.png\" alt=\"\" />",
    );
}

test "every kind of node renders" {
    let ctx = context {
        Ui: headless(),
    };
    let typed = signal(ctx, "ada");
    let ticked = signal(ctx, true);
    assert.equal(web.render<()>(ui.text({ content: .Const("plain") })), "plain");
    assert.equal(
        web.render<()>(
            ui.stack({ styles: [], children: [ui.text({ content: .Const("in") })] }),
        ),
        "<div>in</div>",
    );
    assert.equal(
        web.render<()>(ui.stack({ styles: [.Layout(.Row), .Group([])], children: [] })),
        "<div class=\"lay-row\"></div>",
    );
    assert.equal(
        web.render<()>(ui.text({ content: .Const("two"), headingLevel: .Some(2) })),
        "<h2>two</h2>",
    );
    assert.equal(
        web.render<()>(
            ui.link({
                dest: .Const("/there"),
                children: [ui.text({ content: .Const("go") })],
                styles: [],
            }),
        ),
        "<a href=\"/there\">go</a>",
    );
    assert.equal(
        web.render<()>(
            ui.field({ label: .Const("name"), kind: .Text, value: typed, styles: [] }),
        ),
        "<label><span>name</span><input type=\"text\" value=\"ada\" /></label>",
    );
    // What is typed into a `textarea` is its text rather than an attribute.
    assert.equal(
        web.render<()>(
            ui.field({
                label: .Const("story"),
                kind: .Multiline,
                value: typed,
                styles: [],
            }),
        ),
        "<label><span>story</span><textarea>ada</textarea></label>",
    );
    // A range carries the three numbers a slider is, so the markup a worker
    // sends is a working slider before any of this program's code runs on the
    // page: the browser has the thumb, the keys and the announcement from the
    // attributes alone.
    assert.equal(
        web.render<()>(
            ui.slider({
                label: .Const("Volume"),
                value: signal(ctx, 40.0),
                min: 0.0,
                max: 100.0,
                styles: [],
                step: .Some(5.0),
            }),
        ),
        "<label><span>Volume</span><input type=\"range\" min=\"0.0\" max=\"100.0\" step=\"5.0\" value=\"40\" /></label>",
    );
    // A hint crosses as the attribute, so the search line a reader lands on
    // already says what goes in it before a byte of script has run — and the
    // label is still beside it, because a placeholder is not a name.
    assert.equal(
        web.render<()>(
            ui.field({
                label: .Const("Search"),
                kind: .Search,
                value: signal(ctx, ""),
                styles: [],
                hint: .Some(.Const("Type a command")),
            }),
        ),
        "<label><span>Search</span><input type=\"search\" placeholder=\"Type a command\" /></label>",
    );
    // `checked` is a boolean attribute: it is written with no value at all,
    // which is how HTML spells one.
    assert.equal(
        web.render<()>(
            ui.toggle({
                label: .Const("done"),
                kind: .Checkbox,
                isOn: ticked,
                styles: [],
            }),
        ),
        "<label><input type=\"checkbox\" checked /><span>done</span></label>",
    );
    // `disabled` is the other boolean attribute this vocabulary writes, and it
    // has to cross: a page that resumes on markup without it hands the reader a
    // control the server said was unavailable.
    assert.equal(
        web.render<()>(
            ui.toggle({
                label: .Const("done"),
                kind: .Checkbox,
                isOn: ticked,
                styles: [],
                isDisabled: .Some(.Const(true)),
            }),
        ),
        "<label><input type=\"checkbox\" checked disabled /><span>done</span></label>",
    );
    assert.equal(
        web.render<()>(
            ui.field({
                label: .Const("name"),
                kind: .Text,
                value: typed,
                styles: [],
                isDisabled: .Some(.Const(true)),
            }),
        ),
        "<label><span>name</span><input type=\"text\" value=\"ada\" disabled /></label>",
    );
    // A picture's styles are the picture's, so they cross as a class on the
    // `<img>` itself rather than on anything around it.
    assert.equal(
        web.render<()>(
            ui.image({
                source: .Const("/cat.png"),
                alt: .AccessibilityText("a cat"),
                styles: [.Width(.Full)],
            }),
        ),
        "<img src=\"/cat.png\" alt=\"a cat\" class=\"w-full\" />",
    );
    // A switch is the same control announced differently, and the mark it draws
    // is the sheet's rather than a child's.
    assert.equal(
        web.render<()>(
            ui.toggle({
                label: .Const("email"),
                kind: .Switch,
                isOn: ticked,
                styles: [],
            }),
        ),
        "<label><input type=\"checkbox\" role=\"switch\" checked /><span>email</span></label>",
    );
    // A radio group is a working radio group before a byte of this program's
    // code runs on the page: real `<input type="radio">` sharing one `name`
    // inside a `role="radiogroup"`, so the browser's roving tabindex, arrow
    // keys and `aria-checked` are the markup the worker sent. The checked one is
    // the input whose key is the signal.
    assert.equal(
        web.render<()>(
            ui.picker({
                label: .Const("Plan"),
                options: [
                    ("free", ui.text({ content: .Const("Free") })),
                    ("pro", ui.text({ content: .Const("Pro") })),
                ],
                value: signal(ctx, "pro"),
                styles: [],
            }),
        ),
        "<div role=\"radiogroup\" aria-label=\"Plan\"><label><input type=\"radio\" name=\"buri-radio-0\" value=\"free\" />Free</label><label><input type=\"radio\" name=\"buri-radio-0\" value=\"pro\" checked />Pro</label></div>",
    );
    // A button holding a mark and a word is one element, and the label the
    // markup carries is what a reader is announced rather than the glyphs.
    assert.equal(
        web.render<()>(
            ui.button({
                label: .Const("Overview"),
                styles: [],
                children: .Some([ui.text({ content: .Const("* Overview") })]),
            }),
        ),
        "<button type=\"button\" aria-label=\"Overview\">* Overview</button>",
    );
    // A form's action, and the one button in this vocabulary that carries
    // `type="submit"`. The markup is what makes Enter in a field submit the
    // form the worker sent, before any of this program's code has run on the
    // page.
    assert.equal(
        web.render<()>(
            ui.form({
                onSubmit: fn(_c) => (),
                children: [
                    ui.field({
                        label: .Const("Email"),
                        kind: .Email,
                        value: typed,
                        styles: [],
                    }),
                    ui.button({
                        label: .Const("Send"),
                        styles: [],
                        kind: .Some(.Submit),
                    }),
                ],
                styles: [],
            }),
        ),
        "<form><label><span>Email</span><input type=\"email\" value=\"ada\" /></label><button type=\"submit\" aria-label=\"Send\">Send</button></form>",
    );
    // The three that decide what to render resolve rather than register: a
    // condition is read once, a computation is run once, and a list renders the
    // rows it has.
    assert.equal(
        web.render<()>(
            ui.choose(
                .Const(true),
                ui.text({ content: .Const("yes") }),
                ui.text({ content: .Const("no") }),
            ),
        ),
        "yes",
    );
    assert.equal(
        web.render<()>(
            ui.choose(
                .Const(false),
                ui.text({ content: .Const("yes") }),
                ui.text({ content: .Const("no") }),
            ),
        ),
        "no",
    );
    assert.equal(
        web.render<()>(
            ui.computed(fn(_scope) => ui.text({ content: .Const("built") })),
        ),
        "built",
    );
    assert.equal(
        web.render<()>(
            ui.each(.Const(["a", "b"]), fn(item) => item, fn(_c, item, _i) => {
                ui.text({ content: .Const(item) })
            }),
        ),
        "ab",
    );
    // A list with no rows renders nothing, and the markers that hold its place
    // are the runtime's own bookkeeping rather than something a reader sees.
    let none: [Str] = [];
    assert.equal(
        web.render<()>(
            ui.each(.Const(none), fn(item) => item, fn(_c, item, _i) => {
                ui.text({ content: .Const(item) })
            }),
        ),
        "",
    );
    // An outside-press wrapper adds no visible element beyond its own wrapper:
    // it crosses the worker as the bare `<div>` a stack of the same styles and
    // children would. The document listener that dismisses the overlay is the
    // page's own, registered when the tree resumes rather than written into the
    // markup — there is no attribute a server could send for it.
    assert.equal(
        web.render<()>(
            ui.stack({
                styles: [.Padding(.Px(8))],
                children: [ui.text({ content: .Const("panel") })],
                onPressOutside: .Some(fn(_c) => ()),
            }),
        ),
        "<div class=\"p-8\">panel</div>",
    );
}

test "a route link the worker sends is a real anchor" {
    // Same markup as `link`: a route is an `<a href>` for the browser and for
    // the reader, so the page the worker sends already carries middle-click,
    // ⌘-click, the status-bar preview and the "link" announcement. What sets it
    // apart is what the page does with a plain left-click, which is a listener
    // rather than markup.
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // The scene names the anchor and its text; the `href` a browser follows is a
    // web attribute, which the navigate block below proves by where a click
    // lands rather than by the markup.
    assert.equal(
        render(
            ctx,
            web.routeLink(.Const("/next"), [], [ui.text({ content: .Const("go") })]),
        ).markup(),
        "e 0 \nt 1 go",
    );
}

test "a plain click on a route link navigates in place, keeping the tree" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // A signal a full document load would throw away — the whole reason to
    // navigate rather than follow a link.
    let kept = signal(ctx, "before");
    let page = render(
        ctx,
        web.routeLink(.Const("/next"), [], [ui.text({ content: .Const("go") })]),
    );
    // A plain left-click is the app's: the address changes, the signal is still
    // there, and the tree was left where it is.
    let _ = page.follow("go");
    assert.equal(web.path(ctx), "/next");
    assert.equal(kept.get(ctx), "before");
    assert.equal(page.markup(), "e 0 \nt 1 go");
}

test "a plain click follows a route link addressed by its joined text" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // A whole row is one link: a name, the line under it and a figure beside
    // them, drawn as many runs across boxes rather than one. A reader hears the
    // anchor's name as the text of its descendants joined, which is how this is
    // addressed — the runs together are not it, so "OneTwo" would not find it.
    let page = render(
        ctx,
        web.routeLink(.Const("/two"), [], [
            ui.stack({
                styles: [],
                children: [
                    ui.stack({ styles: [], children: [ui.text({ content: .Const("One") })] }),
                    ui.stack({ styles: [], children: [ui.text({ content: .Const("Two") })] }),
                ],
            }),
            ui.stack({ styles: [], children: [ui.text({ content: .Const("Three") })] }),
        ]),
    );
    let _ = page.follow("One Two Three");
    assert.equal(web.path(ctx), "/two");
}

test "a route link of a single run, nested in a box, still follows" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // One run however deep it sits is addressed by that run, unchanged.
    let page = render(
        ctx,
        web.routeLink(.Const("/nested"), [], [
            ui.stack({ styles: [], children: [ui.text({ content: .Const("Nested") })] }),
        ]),
    );
    let _ = page.follow("Nested");
    assert.equal(web.path(ctx), "/nested");
}

test "a modified click on a route link is left to the browser" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let page = render(
        ctx,
        web.routeLink(.Const("/next"), [], [ui.text({ content: .Const("go") })]),
    );
    // A ⌘/Ctrl-click, or the middle button, is how a reader opens a link beside
    // the page they are on. A route leaves that to the browser as an ordinary
    // anchor, so the address bar does not move.
    let _ = page.openInNewTab("go");
    assert.equal(web.path(ctx), "/");
}

test "a worker writes an icon's artwork into the page it sends" {
    // The artwork is in the tree, so it is in the markup: one `<svg>` the
    // browser paints in whatever colour the page's own rules give the element,
    // rather than an `<img>` whose source is a document of its own. The `xmlns`
    // is dropped — an `<svg>` in HTML is in that namespace already — and
    // `aria-hidden` says what an icon is, which is decoration.
    assert.equal(
        web.render<()>(
            ui.image({
                source: .Const(
                    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor'><path d='M20 6 9 17l-5-5'/></svg>",
                ),
                alt: .Decorative,
                styles: [.Width(.Px(16))],
            }),
        ),
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\" class=\"w-16\"><path d=\"M20 6 9 17l-5-5\"></path></svg>",
    );
}

test "a dialog crosses the worker open, and shut" {
    let ctx = context {
        Ui: headless(),
    };
    let open = signal(ctx, true);
    let shut = signal(ctx, false);
    // The panel the worker writes is the panel the page resumes on: one
    // `<dialog>` either way, and the flag says which. So a reader whose
    // JavaScript has not arrived is looking at the panel the program opened,
    // and the resume promotes it into the top layer rather than building it.
    assert.equal(
        web.render<()>(
            ui.dialog({
                isOpen: open,
                label: .Const("Confirm"),
                children: [ui.text({ content: .Const("sure?") })],
                styles: [],
            }),
        ),
        "<dialog aria-label=\"Confirm\" open>sure?</dialog>",
    );
    assert.equal(
        web.render<()>(
            ui.dialog({
                isOpen: shut,
                label: .Const("Confirm"),
                children: [ui.text({ content: .Const("sure?") })],
                styles: [],
            }),
        ),
        "<dialog aria-label=\"Confirm\">sure?</dialog>",
    );
    // The panel the worker writes carries its styles as classes — one answer,
    // rendered on the server the way the page would render it.
    assert.equal(
        web.render<()>(
            ui.dialog({
                isOpen: open,
                label: .Const("Confirm"),
                children: [],
                styles: [.Padding(.Px(8))],
            }),
        ),
        "<dialog aria-label=\"Confirm\" class=\"p-8\" open></dialog>",
    );
}

test "a heading's level clamps to the range a document has" {
    assert.equal(
        web.render<()>(ui.text({ content: .Const("low"), headingLevel: .Some(0) })),
        "<h1>low</h1>",
    );
    assert.equal(
        web.render<()>(ui.text({ content: .Const("lower"), headingLevel: .Some(-4) })),
        "<h1>lower</h1>",
    );
    assert.equal(
        web.render<()>(ui.text({ content: .Const("high"), headingLevel: .Some(7) })),
        "<h6>high</h6>",
    );
}

test "a heading the worker sent carries the classes its styles chose" {
    // The level picks the element and the styles paint it, on the server as in
    // the browser. Without them the user agent's own sheet decides the type.
    assert.equal(
        web.render<()>(
            ui.text({
                content: .Const("Prices"),
                headingLevel: .Some(2),
                styles: .Some([.FontSize(.Px(28)), .FontWeight(.Bold)]),
            }),
        ),
        "<h2 class=\"fs-28 fw-bold\">Prices</h2>",
    );
}

test "a bleed crosses the worker as the class the compiler wrote" {
    let ctx = context {
        Ui: headless(),
    };
    // The full-bleed separator inside a padded menu, rendered on the server and
    // in the browser. One renderer, so one answer.
    let menu: Node<()> = ui.stack({
        styles: [.Padding(.Px(4))],
        children: [
            ui.stack({
                styles: [.Height(.Px(1)), .Bleed(.Start, .Px(4)), .Bleed(.End, .Px(4))],
                children: [],
                role: .Some(.Separator),
            }),
        ],
    });
    assert.equal(
        web.render<()>(menu),
        "<div class=\"p-4\"><hr class=\"h-1 bleed-start-4 bleed-end-4\" /></div>",
    );
}

test "a clip and a pass-through cross the worker as the classes they are" {
    let ctx = context {
        Ui: headless(),
    };
    // The card with a full-bleed picture, and the dock that lets the page under
    // it answer a press. Rendered on the server and in the browser: one
    // renderer, so one answer.
    let page: Node<()> = ui.stack({
        styles: [.Position(.PinViewport), .Passthrough(true)],
        children: [
            ui.stack({
                styles: [.Radius(.Px(12)), .Clip(true), .Passthrough(false)],
                children: [
                    ui.image({
                        source: .Const("/banner.png"),
                        alt: .AccessibilityText(""),
                        styles: [],
                    }),
                ],
            }),
        ],
    });
    assert.equal(
        web.render<()>(page),
        "<div class=\"pos-viewport pass-none\"><div class=\"r-12 clip-clip pass-auto\"><img src=\"/banner.png\" alt=\"\" /></div></div>",
    );
}

test "a failing control crosses the worker already saying so" {
    let ctx = context {
        Ui: headless(),
    };
    let typed = signal(ctx, "ada");
    let ticked = signal(ctx, false);
    // The attribute is on the markup the server sent, so a reader is told the
    // field is failing before a single byte of script has run.
    let failing: Node<()> = ui.field({
        label: .Const("Email"),
        kind: .Email,
        value: typed,
        styles: [.On(.Invalid, [.BorderColor(.Rgb(220, 38, 38))])],
        isInvalid: .Some(.Const(true)),
    });
    assert.equal(
        web.render<()>(failing),
        "<label><span>Email</span><input type=\"email\" aria-invalid=\"true\" class=\"invalid_bc-dc2626\" value=\"ada\" /></label>",
    );
    // A control that is not failing writes no attribute, so the markup is the
    // markup every other test here asserts.
    assert.equal(
        web.render<()>(
            ui.toggle({
                label: .Const("done"),
                kind: .Checkbox,
                isOn: ticked,
                styles: [],
            }),
        ),
        "<label><input type=\"checkbox\" /><span>done</span></label>",
    );
}

test "text is escaped, so a title cannot write markup" {
    assert.equal(
        web.render<()>(ui.text({ content: .Const("<b>& later</b>") })),
        "&lt;b&gt;&amp; later&lt;/b&gt;",
    );
    // The three that end a run of text, and the two that do not: a quote and an
    // apostrophe mean nothing between tags, so they are written as they were.
    assert.equal(
        web.render<()>(ui.text({ content: .Const("a & b < c > d \" e ' f") })),
        "a &amp; b &lt; c &gt; d \" e ' f",
    );
    // An ampersand already spelled as an entity is escaped again, because what
    // a page shows is the characters the state holds.
    assert.equal(web.render<()>(ui.text({ content: .Const("&amp;") })), "&amp;amp;");
}

test "an attribute is escaped too, quotes included" {
    assert.equal(
        web.render<()>(
            ui.image({
                source: .Const("/a&b.png"),
                alt: .AccessibilityText("\"q\" <x>"),
                styles: [],
            }),
        ),
        "<img src=\"/a&amp;b.png\" alt=\"&quot;q&quot; &lt;x&gt;\" />",
    );
    assert.equal(
        web.render<()>(
            ui.link({ dest: .Const("/a?x=1&y=2"), children: [], styles: [] }),
        ),
        "<a href=\"/a?x=1&amp;y=2\"></a>",
    );
}

test "the document carries the body and the state beside it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let state = Reading { title: "Titles", note: "plain" };
    let document = web.shell(
        ctx,
        "/",
        named("Titles"),
        web.render<()>(tree()),
        state.toJson(ctx),
    );
    assert.isTrue(document.startsWith("<!doctype html>"));
    assert.equal(body(document), "<main><h1>Titles</h1>and text</main>");
    assert.equal(embedded(document), "{\"title\":\"Titles\",\"note\":\"plain\"}");
}

test "the document names the tab and the language it is in" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(
        ctx,
        "/",
        web.Document { ..web.defaultDocument(), title: "Buri Design" },
        "",
        .Null,
    );
    assert.equal(
        head(document),
        "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><title>Buri Design</title>",
    );
}

test "a title cannot write markup, and a lang cannot end the attribute" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(
        ctx,
        "/",
        web.Document { title: "<b>Tom & Jerry</b>", lang: "en\"><script>" },
        "",
        .Null,
    );
    assert.equal(
        head(document),
        "<!doctype html>\n<html lang=\"en&quot;&gt;&lt;script&gt;\">\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><title>&lt;b&gt;Tom &amp; Jerry&lt;/b&gt;</title>",
    );
}

test "a state that ends the script it sits in closes nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let state = Reading { title: "Titles", note: "</script><b>" };
    let document = web.shell(ctx, "/", named("Titles"), "", state.toJson(ctx));
    assert.isFalse(embedded(document).contains("</script>"));
    // And it is still the state, because a JSON reader reads the escape back.
    let read: Result<Reading, DecodeError> = json.decode(
        ctx,
        json.parse(ctx, embedded(document)).withDefault(.Null),
    );
    assert.equal(
        read.withDefault(Reading { title: "", note: "" }).note,
        "</script><b>",
    );
}

test "the state crosses as every shape JSON has" {
    let ctx = context {
        Allocator: alloc(),
    };
    let shapes: Json = .Object([
        ("nothing", .Null),
        ("yes", .Bool(true)),
        ("no", .Bool(false)),
        ("whole", .Num(7.0)),
        ("fraction", .Num(0.5)),
        ("negative", .Num(-2.0)),
        ("text", .Str("héllo ✓ 𝄞")),
        ("no fields", .Object([])),
        ("no items", .Array([])),
        ("items", .Array([.Num(1.0), .Str("two"), .Object([("deep", .Bool(true))])])),
    ]);
    let document = web.shell(ctx, "/", named("Titles"), "", shapes);
    assert.equal(
        embedded(document),
        "{\"nothing\":null,\"yes\":true,\"no\":false,\"whole\":7,\"fraction\":0.5,\"negative\":-2,\"text\":\"héllo ✓ 𝄞\",\"no fields\":{},\"no items\":[],\"items\":[1,\"two\",{\"deep\":true}]}",
    );
    // And it reads back as the same document, which is what the page does with
    // it.
    assert.equal(json.parse(ctx, embedded(document)).withDefault(.Null), shapes);
}

test "a state with no fields at all still crosses" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(embedded(web.shell(ctx, "/", named("Titles"), "", .Object([]))), "{}");
    assert.equal(embedded(web.shell(ctx, "/", named("Titles"), "", .Null)), "null");
}

test "an empty body is still a whole document" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(ctx, "/", named("Titles"), "", .Object([]));
    assert.isTrue(document.startsWith("<!doctype html>"));
    assert.equal(body(document), "");
    assert.isTrue(document.endsWith("</body>\n</html>\n"));
}

test "the document says which address it was rendered for" {
    let ctx = context {
        Allocator: alloc(),
    };
    let state = Reading { title: "Titles", note: "plain" };
    let document = web.shell(
        ctx,
        "/guide/routing",
        named("Titles"),
        web.render<()>(tree()),
        state.toJson(ctx),
    );
    assert.equal(renderedAt(document), "/guide/routing");
    // The body and the state are where they were: the path rides on the script
    // rather than displacing anything.
    assert.equal(body(document), "<main><h1>Titles</h1>and text</main>");
    assert.equal(embedded(document), "{\"title\":\"Titles\",\"note\":\"plain\"}");
}

test "a path that could end the attribute it sits in ends nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let document = web.shell(ctx, "/a\"><b>&x", named("Titles"), "", .Object([]));
    assert.equal(renderedAt(document), "/a&quot;&gt;&lt;b&gt;&amp;x");
    // And the state after it is still the state, so the tag was not cut short.
    assert.equal(embedded(document), "{}");
}

test "a document is answered as HTML" {
    let ctx = context {
        Allocator: alloc(),
    };
    let answer = http.html(ctx, "<p>hello</p>");
    assert.equal(answer.status, 200);
    assert.equal(
        answer.header("content-type").withDefault("none"),
        "text/html; charset=utf-8",
    );
    assert.equal(http.bodyText(ctx, answer.body).withDefault(""), "<p>hello</p>");
}

test "a progress bar the worker sends announces its value" {
    // The role and `aria-valuenow` a reader hears are in the markup the worker
    // sent: the scene carries the bar's own boxes, and this the announcement —
    // the two halves of one widget, each where it belongs. Nought is nought,
    // one is a hundred, and two thirds rounds to 67.
    assert.equal(
        web.render<()>(
            ui.progress({
                label: .Const("Loading"),
                value: .Some(.Const(0.0)),
                styles: [],
            }),
        ),
        "<div role=\"progressbar\" aria-label=\"Loading\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"0\"></div>",
    );
    assert.equal(
        web.render<()>(
            ui.progress({
                label: .Const("Loading"),
                value: .Some(.Const(0.666)),
                styles: [],
            }),
        ),
        "<div role=\"progressbar\" aria-label=\"Loading\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"67\"></div>",
    );
    assert.equal(
        web.render<()>(
            ui.progress({
                label: .Const("Loading"),
                value: .Some(.Const(1.0)),
                styles: [],
            }),
        ),
        "<div role=\"progressbar\" aria-label=\"Loading\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"100\"></div>",
    );
}

test "two radio groups the worker sends number their names apart" {
    let ctx = context {
        Ui: headless(),
    };
    // One shared `name` groups each set of radios, and two groups on one page
    // number apart — the HTML the scene does not carry and `ui/web` does.
    let two = web.render<()>(
        ui.stack({
            styles: [],
            children: [
                ui.picker({
                    label: .Const("A"),
                    options: [("x", ui.text({ content: .Const("X") }))],
                    value: signal(ctx, "x"),
                    styles: [],
                }),
                ui.picker({
                    label: .Const("B"),
                    options: [("y", ui.text({ content: .Const("Y") }))],
                    value: signal(ctx, "y"),
                    styles: [],
                }),
            ],
        }),
    );
    assert.isTrue(two.contains("name=\"buri-radio-0\""));
    assert.isTrue(two.contains("name=\"buri-radio-1\""));
}
