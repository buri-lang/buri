// A route link, followed: what a page does with a click on one.
//
//   - a plain left-click is the app's, so the address moves and the tree stays;
//   - a modified click is the browser's, so the address stays where it is;
//   - an `onFollow` of the link's own replaces `navigate` and hears where the
//     link goes.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Location, Ui, Watch };
from "platform/effect/testing" import { address, headless, observer, render };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/web" import * as web;

test "a plain click on a route link navigates in place, keeping the tree" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // A signal a full document load would throw away — the whole reason to
    // navigate rather than follow a link.
    let kept = signal(ctx, "before");
    let page = render(
        ctx,
        web.routeLink({
            dest: .Const("/next"),
            styles: [],
            children: [ui.text({ content: .Const("go") })],
        }),
    );
    // A plain left-click is the app's: the address changes, the signal is still
    // there, and the tree was left where it is.
    let _ = page.follow("go");
    assert.equal(web.path(ctx), "/next");
    assert.equal(kept.get(ctx), "before");
    assert.equal(page.markup(), "e 0 \nt 1 go");
}

test "a plain click follows a route link addressed by its joined text" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // A whole row is one link: a name, the line under it and a figure beside
    // them, drawn as many runs across boxes rather than one. A reader hears the
    // anchor's name as the text of its descendants joined, which is how this is
    // addressed — the runs together are not it, so "OneTwo" would not find it.
    let page = render(
        ctx,
        web.routeLink({
            dest: .Const("/two"),
            styles: [],
            children: [
                ui.stack({
                    styles: [],
                    children: [
                        ui.stack({
                            styles: [],
                            children: [ui.text({ content: .Const("One") })],
                        }),
                        ui.stack({
                            styles: [],
                            children: [ui.text({ content: .Const("Two") })],
                        }),
                    ],
                }),
                ui.stack({
                    styles: [],
                    children: [ui.text({ content: .Const("Three") })],
                }),
            ],
        }),
    );
    let _ = page.follow("One Two Three");
    assert.equal(web.path(ctx), "/two");
}

test "a route link of a single run, nested in a box, still follows" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    // One run however deep it sits is addressed by that run, unchanged.
    let page = render(
        ctx,
        web.routeLink({
            dest: .Const("/nested"),
            styles: [],
            children: [
                ui.stack({
                    styles: [],
                    children: [ui.text({ content: .Const("Nested") })],
                }),
            ],
        }),
    );
    let _ = page.follow("Nested");
    assert.equal(web.path(ctx), "/nested");
}

test "a modified click on a route link is left to the browser" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let page = render(
        ctx,
        web.routeLink({
            dest: .Const("/next"),
            styles: [],
            children: [ui.text({ content: .Const("go") })],
        }),
    );
    // A ⌘/Ctrl-click, or the middle button, is how a reader opens a link beside
    // the page they are on. A route leaves that to the browser as an ordinary
    // anchor, so the address bar does not move.
    let _ = page.openInNewTab("go");
    assert.equal(web.path(ctx), "/");
}

/// A navigation rail's entry for one page, current while the address is that
/// page's — the case a route link's `isCurrent` is for.
fn railEntry<C: Location + Ui>(ctx: C, to: Str, name: Str): Node<C> {
    let route = web.route(ctx);
    web.routeLink({
        dest: .Const(to),
        styles: [],
        children: [ui.text({ content: .Const(name) })],
        isCurrent: .Some(.Computed(fn(s) => route.read(s) == to)),
    })
}

test "a route link marks the page it is on, and follows the address" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                railEntry(ctx, "/", "Home"),
                railEntry(ctx, "/reports", "Reports"),
            ],
            role: .Some(.Navigation),
        }),
    );
    assert.isTrue(page.isCurrent("Home"));
    assert.isFalse(page.isCurrent("Reports"));
    // The plain click is still `navigate`, filled in because the config left
    // `onFollow` out, so the mark moves with the address.
    let _ = page.follow("Reports");
    assert.equal(web.path(ctx), "/reports");
    assert.isFalse(page.isCurrent("Home"));
    assert.isTrue(page.isCurrent("Reports"));
}

test "a route link keeps an onFollow of its own" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let followed = signal(ctx, "");
    let page = render(
        ctx,
        web.routeLink({
            dest: .Const("/next"),
            styles: [],
            children: [ui.text({ content: .Const("go") })],
            onFollow: .Some(fn(c, to) => followed.set(c, to)),
        }),
    );
    // A handler of its own replaces `navigate` rather than joining it, so the
    // address stays where it was and the handler hears where the link goes.
    let _ = page.follow("go");
    assert.equal(followed.get(ctx), "/next");
    assert.equal(web.path(ctx), "/");
}

test "following an ordinary link leaves the page where it is" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let page = render(
        ctx,
        ui.link({
            dest: .Const("/elsewhere"),
            styles: [],
            children: [ui.text({ content: .Const("away") })],
        }),
    );
    // A plain link is the browser's to follow, and a headless document cannot,
    // so the address and the tree both stay as they were.
    let _ = page.follow("away");
    assert.equal(web.path(ctx), "/");
    assert.equal(page.markup(), "e 0 \nt 1 away");
}
