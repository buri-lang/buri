// `ui/web`'s router: what a page does instead of following a link.
//
//   - `navigate` writes the address, so `path` reads it back and every prop
//     built out of `route` answers the new one;
//   - what read the route re-runs, which is what makes a navigation re-render
//     the smallest thing that read the path;
//   - `replace` writes the same address. What it does not do is add a history
//     entry, which `back` shows: it skips the entry `replace` took the place of;
//   - `back` returns to the entry before, adding none;
//   - a signal made before a navigation still holds its value after one. An
//     in-memory store surviving the address changing is the whole reason to
//     navigate rather than link.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Location, Ui, Watch };
from "platform/effect/testing" import { address, headless, observer, recorder };
from "ui/signal" import { signal, watch };
from "ui/web" import * as web;

/// Routing, as the guide teaches it: an ordinary match on the path.
fn page(path: Str): Str {
    match (path) {
        "/" => "home",
        "/about" => "about",
        _other => "nowhere",
    }
}

test "navigate writes the address the page reads back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    assert.equal(web.path(ctx), "/");
    web.navigate(ctx, "/guide/routing");
    assert.equal(web.path(ctx), "/guide/routing");
}

test "replace writes the address too" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/signin"),
    };
    web.replace(ctx, "/dashboard");
    assert.equal(web.path(ctx), "/dashboard");
}

test "what read the route re-runs when the page navigates" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let log = recorder();
    let route = web.route(ctx);
    let _ = watch(ctx, fn(s) => log.record(page(route.read(s))));
    assert.equal(log.recorded(), ["home"]);
    web.navigate(ctx, "/about");
    assert.equal(log.recorded(), ["home", "about"]);
    web.replace(ctx, "/elsewhere");
    assert.equal(log.recorded(), ["home", "about", "nowhere"]);
}

// buri-lang/buri#73. Navigating to the address already showing writes the same
// text into the cell the route wraps, and an equal write is not a change — so
// what read the path does not run again. It was seen the other way round while
// #49 was being implemented: natively the write compared the cell's bytes,
// which for a `Str` are a pointer, and every `navigate` to the address on
// screen re-rendered.
test "navigating to the address already showing re-renders nothing" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/about"),
    };
    let log = recorder();
    let route = web.route(ctx);
    let _ = watch(ctx, fn(s) => log.record(page(route.read(s))));
    assert.equal(log.recorded(), ["about"]);
    web.navigate(ctx, "/about");
    assert.equal(log.recorded(), ["about"]);
    web.replace(ctx, "/about");
    assert.equal(log.recorded(), ["about"]);
}

test "a signal keeps its value across a navigation" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let store = signal(ctx, "ada");
    web.navigate(ctx, "/about");
    assert.equal(store.get(ctx), "ada");
    web.replace(ctx, "/");
    assert.equal(store.get(ctx), "ada");
}

// buri-lang/buri#341. `back` is the reader's Back button, pressed by the page:
// the address returns to the entry before this one, and nothing is pushed —
// so a second `back` goes further back rather than forward again.
test "back returns to the page the reader came from, adding no entry" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    web.navigate(ctx, "/reports");
    web.navigate(ctx, "/reports/2026");
    web.back(ctx);
    assert.equal(web.path(ctx), "/reports");
    web.back(ctx);
    assert.equal(web.path(ctx), "/");
}

test "back from the first entry stays where it is" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    web.back(ctx);
    assert.equal(web.path(ctx), "/");
}

test "replace leaves the entry it replaced out of Back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    web.navigate(ctx, "/signin");
    web.replace(ctx, "/dashboard");
    web.back(ctx);
    assert.equal(web.path(ctx), "/");
}

test "navigating after back drops the entries ahead of it" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    web.navigate(ctx, "/a");
    web.navigate(ctx, "/b");
    web.back(ctx);
    web.navigate(ctx, "/c");
    web.back(ctx);
    assert.equal(web.path(ctx), "/a");
    web.back(ctx);
    assert.equal(web.path(ctx), "/");
}

test "what read the route re-runs when the page goes back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Location: address(headless(), "/"),
    };
    let log = recorder();
    let route = web.route(ctx);
    let _ = watch(ctx, fn(s) => log.record(page(route.read(s))));
    web.navigate(ctx, "/about");
    web.back(ctx);
    assert.equal(log.recorded(), ["home", "about", "home"]);
}
