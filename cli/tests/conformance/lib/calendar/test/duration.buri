// core/time — `Duration`, and the arithmetic between it and `Instant`.
//
// All of it is pure but the last section: a length of time is not a fact about
// when you ask, so every answer here is checkable against a number written out
// by hand. The clock appears only where the question is about reading one.
//
// The assertions that matter most are the saturating ones. Overflow is
// undefined behaviour, and a deadline is where a program can least afford it —
// so every one of these is a case where the hand-written `checkedMul`,
// `checkedSub`, decide-from-the-sign shape had to get the answer right.

from "core/effect" import { Alloc, Clock };
from "core/host/testing" import { alloc, clock };
from "core/math" import * as math;
from "core/num" import * as num;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "core/time" import { Duration, Instant, Monotonic };

// --- constructors --------------------------------------------------------------

test "each constructor names the unit it counts" {
    assert.eq(time.nanos(7).0, 7);
    assert.eq(time.micros(7).0, 7000);
    assert.eq(time.millis(7).0, 7000000);
    assert.eq(time.seconds(7).0, 7000000000);
    assert.eq(time.minutes(7).0, 420000000000);
    assert.eq(time.hours(7).0, 25200000000000);
}

test "the constructors agree with one another" {
    assert.eq(time.seconds(1), time.millis(1000));
    assert.eq(time.millis(1), time.micros(1000));
    assert.eq(time.micros(1), time.nanos(1000));
    assert.eq(time.minutes(1), time.seconds(60));
    assert.eq(time.hours(1), time.minutes(60));
}

test "a count no Duration can hold saturates rather than wrapping" {
    let biggest = Duration(num.maxValue<I64>());
    let smallest = Duration(num.minValue<I64>());
    assert.eq(time.hours(num.maxValue<I64>()), biggest);
    assert.eq(time.seconds(1000000000000), biggest);
    assert.eq(time.hours(num.minValue<I64>()), smallest);
    assert.eq(time.seconds(-1000000000000), smallest);
    // Saturating means the sign survives, which is the whole point: the shape
    // this replaces wrapped a timeout into the past.
    assert.isFalse(time.hours(num.maxValue<I64>()).isNegative());
}

// --- getters --------------------------------------------------------------------

test "every getter truncates towards zero" {
    let d = time.nanos(1999999);
    assert.eq(d.nanos(), 1999999);
    assert.eq(d.micros(), 1999);
    assert.eq(d.millis(), 1);
    assert.eq(d.seconds(), 0);
}

test "a negative length truncates towards zero too" {
    let d = time.nanos(-1999999);
    assert.eq(d.micros(), -1999);
    assert.eq(d.millis(), -1);
}

test "the larger units read what the constructors wrote" {
    assert.eq(time.hours(3).minutes(), 180);
    assert.eq(time.minutes(90).hours(), 1);
    assert.eq(time.hours(48).days(), 2);
    assert.eq(time.millis(86400000).days(), 1);
}

test "isZero and isNegative say what the sign is" {
    assert.isTrue(time.nanos(0).isZero());
    assert.isFalse(time.nanos(1).isZero());
    assert.isTrue(time.seconds(-1).isNegative());
    assert.isFalse(time.seconds(0).isNegative());
    assert.isFalse(time.seconds(1).isNegative());
}

// --- arithmetic ------------------------------------------------------------------

test "add, sub and mul are the arithmetic of lengths" {
    assert.eq(time.seconds(1).add(time.millis(500)), time.millis(1500));
    assert.eq(time.seconds(1).sub(time.millis(250)), time.millis(750));
    assert.eq(time.millis(250).mul(4), time.seconds(1));
    assert.eq(time.seconds(1).mul(0), time.nanos(0));
    assert.eq(time.seconds(1).mul(-2), time.seconds(-2));
}

test "arithmetic saturates at both ends" {
    let biggest = Duration(num.maxValue<I64>());
    let smallest = Duration(num.minValue<I64>());
    assert.eq(biggest.add(time.seconds(1)), biggest);
    assert.eq(smallest.sub(time.seconds(1)), smallest);
    assert.eq(biggest.mul(2), biggest);
    assert.eq(biggest.mul(-2), smallest);
}

test "negate and abs" {
    assert.eq(time.seconds(3).negate(), time.seconds(-3));
    assert.eq(time.seconds(-3).negate(), time.seconds(3));
    assert.eq(time.seconds(-3).abs(), time.seconds(3));
    assert.eq(time.seconds(3).abs(), time.seconds(3));
    assert.eq(time.nanos(0).negate(), time.nanos(0));
}

test "the most negative length negates to the most positive one" {
    // The one asymmetry in two's complement, answered by saturating rather
    // than by wrapping back to itself.
    let smallest = Duration(num.minValue<I64>());
    assert.eq(smallest.negate(), Duration(num.maxValue<I64>()));
    assert.eq(smallest.abs(), Duration(num.maxValue<I64>()));
}

test "durations compare as lengths" {
    assert.isTrue(time.seconds(1) > time.millis(999));
    assert.isTrue(time.millis(-1) < time.nanos(0));
    assert.eq(time.seconds(1), time.nanos(1000000000));
    assert.isTrue(time.seconds(1) != time.seconds(2));
}

// --- Show --------------------------------------------------------------------------

test "a length shows in the largest unit it reaches" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(time.millis(1500).show(ctx), "1.5s");
    assert.eq(time.millis(300).show(ctx), "300ms");
    assert.eq(time.micros(750).show(ctx), "750us");
    assert.eq(time.nanos(1).show(ctx), "1ns");
    assert.eq(time.nanos(0).show(ctx), "0s");
    assert.eq(time.minutes(2).show(ctx), "120s");
}

test "the fraction is exact and carries no trailing zeros" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(time.nanos(1000000001).show(ctx), "1.000000001s");
    assert.eq(time.nanos(999999999).show(ctx), "999.999999ms");
    assert.eq(time.nanos(1500).show(ctx), "1.5us");
    assert.eq(time.nanos(999).show(ctx), "999ns");
    assert.eq(time.nanos(1000).show(ctx), "1us");
}

test "the sign is in front of the number" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(time.millis(-1500).show(ctx), "-1.5s");
    assert.eq(time.nanos(-1).show(ctx), "-1ns");
    assert.eq(time.millis(-300).show(ctx), "-300ms");
}

// --- instants ------------------------------------------------------------------------

test "the difference between two points is a length" {
    let a = Instant(1000);
    let b = Instant(4000);
    assert.eq(b.duration(a), time.seconds(3));
    assert.eq(a.duration(b), time.seconds(-3));
    assert.eq(a.duration(a), time.nanos(0));
}

test "a point moved by a length is a point" {
    let a = Instant(1000);
    assert.eq(a.plus(time.seconds(3)), Instant(4000));
    assert.eq(a.minus(time.seconds(3)), Instant(-2000));
    // An `Instant` is milliseconds, so a length under one moves it nowhere.
    assert.eq(a.plus(time.nanos(999999)), a);
    assert.eq(a.plus(time.micros(1500)), Instant(1001));
}

test "hasPassed is the whole deadline check" {
    let started = Instant(1000);
    let deadline = started.plus(time.seconds(30));
    assert.isFalse(started.hasPassed(deadline));
    assert.isFalse(started.plus(time.millis(29999)).hasPassed(deadline));
    // At the deadline counts as passed: a timeout that has run out has run out.
    assert.isTrue(deadline.hasPassed(deadline));
    assert.isTrue(started.plus(time.minutes(2)).hasPassed(deadline));
}

test "a deadline built from a length that saturates has not passed" {
    // The overflow-guard dance this replaces: `checkedMul` a timeout out to
    // nanoseconds, `checkedSub` it from now, and decide from whichever answer
    // survived. Here the deadline saturates to the end of time and the check
    // is `>=`.
    let started = Instant(1000);
    let never = started.plus(time.hours(num.maxValue<I64>()));
    // The length saturated at the largest `Duration`, which is that many
    // nanoseconds; the instant then moves by the milliseconds in it.
    assert.eq(never.0, 1000 + num.maxValue<I64>() / 1000000);
    assert.isFalse(started.hasPassed(never));
    assert.isTrue(never.hasPassed(never));
}

test "moving a point past the end of time saturates too" {
    let end = Instant(num.maxValue<I64>());
    assert.eq(end.plus(time.seconds(1)), end);
    let start = Instant(num.minValue<I64>());
    assert.eq(start.minus(time.seconds(1)), start);
}

test "instants compare as points" {
    assert.isTrue(Instant(1) < Instant(2));
    assert.isTrue(Instant(2) > Instant(1));
    assert.eq(Instant(1), Instant(1));
}

// --- the clock ---------------------------------------------------------------------

test "since answers a length rather than a count" {
    let dial = clock().at(500);
    let ctx = context {
        Alloc: alloc(),
        Clock: dial,
    };
    let start = time.now(ctx);
    time.sleepMs(dial, 250);
    let waited: Duration = time.since(ctx, start);
    assert.eq(waited, time.millis(250));
    assert.eq(waited.show(ctx), "250ms");
}

test "sleep takes a length and moves the clock by it" {
    let dial = clock().at(0);
    let ctx = context {
        Clock: dial,
    };
    time.sleep(dial, time.millis(250));
    assert.eq(time.now(ctx), Instant(250));
    // Under a millisecond the clock cannot move, and says so by not moving.
    time.sleep(dial, time.micros(999));
    assert.eq(time.now(ctx), Instant(250));
}

test "a deadline read off the clock" {
    let dial = clock().at(0);
    let ctx = context {
        Clock: dial,
    };
    let deadline = time.now(ctx).plus(time.seconds(1));
    assert.isFalse(time.now(ctx).hasPassed(deadline));
    time.sleep(dial, time.millis(999));
    assert.isFalse(time.now(ctx).hasPassed(deadline));
    time.sleep(dial, time.millis(1));
    assert.isTrue(time.now(ctx).hasPassed(deadline));
}

// --- ZERO, and the fractional constructor -------------------------------------------

test "ZERO is no length at all, and the identity for adding" {
    assert.eq(time.ZERO.0, 0);
    assert.isTrue(time.ZERO.isZero());
    assert.isFalse(time.ZERO.isNegative());
    assert.eq(time.ZERO.add(time.seconds(3)), time.seconds(3));
    assert.eq(time.seconds(3).sub(time.seconds(3)), time.ZERO);
    assert.eq(time.nanos(0), time.ZERO);
}

test "secondsFloat takes a fraction of a second" {
    assert.eq(time.secondsFloat(0.25), time.millis(250));
    assert.eq(time.secondsFloat(1.5), time.millis(1500));
    assert.eq(time.secondsFloat(0.0), time.ZERO);
    assert.eq(time.secondsFloat(0.0 - 0.25), time.millis(0 - 250));
    assert.eq(time.secondsFloat(1e-9), time.nanos(1));
    // Finer than a nanosecond truncates toward zero.
    assert.eq(time.secondsFloat(1e-10), time.ZERO);
}


test "a fraction no Duration can hold saturates, and a NaN is nothing" {
    assert.eq(time.secondsFloat(1e30), Duration(num.maxValue<I64>()));
    assert.eq(time.secondsFloat(0.0 - 1e30), Duration(num.minValue<I64>()));
    assert.eq(time.secondsFloat(1.0 / 0.0), Duration(num.maxValue<I64>()));
    assert.eq(time.secondsFloat(0.0 - 1.0 / 0.0), Duration(num.minValue<I64>()));
    assert.eq(time.secondsFloat(0.0 / 0.0), time.ZERO);
    // A count of seconds whose nanoseconds are not exact still converts.
    assert.eq(time.secondsFloat(0.1), time.millis(100));
}


test "asSecondsFloat inverts secondsFloat" {
    assert.approxEq(time.seconds(3).asSecondsFloat(), 3.0, 1e-9);
    assert.approxEq(time.millis(250).asSecondsFloat(), 0.25, 1e-9);
    assert.approxEq(time.ZERO.asSecondsFloat(), 0.0, 1e-9);
    assert.approxEq(time.millis(0 - 1500).asSecondsFloat(), 0.0 - 1.5, 1e-9);
    assert.approxEq(time.secondsFloat(0.125).asSecondsFloat(), 0.125, 1e-9);
}

// --- dividing, and the ratio between two lengths ----------------------------------

test "divide is mul's inverse and truncates toward zero" {
    assert.eq(time.seconds(6).divide(2), time.seconds(3));
    assert.eq(time.seconds(3).mul(4).divide(4), time.seconds(3));
    assert.eq(time.nanos(7).divide(2), time.nanos(3));
    assert.eq(time.nanos(0 - 7).divide(2), time.nanos(0 - 3));
    assert.eq(time.nanos(7).divide(0 - 2), time.nanos(0 - 3));
    assert.eq(time.ZERO.divide(5), time.ZERO);
    assert.eq(time.seconds(3).divide(1), time.seconds(3));
}

test "a ratio is a number rather than a length" {
    assert.approxEq(time.seconds(3).ratio(time.seconds(1)), 3.0, 1e-9);
    assert.approxEq(time.millis(500).ratio(time.seconds(1)), 0.5, 1e-9);
    assert.approxEq(time.ZERO.ratio(time.seconds(1)), 0.0, 1e-9);
    assert.approxEq(time.seconds(0 - 3).ratio(time.seconds(1)), 0.0 - 3.0, 1e-9);
    // Nothing goes into no time at all a definite number of times.
    assert.isTrue(math.isInfinite(time.seconds(1).ratio(time.ZERO)));
    assert.isTrue(math.isNan(time.ZERO.ratio(time.ZERO)));
}

// --- the monotonic clock ------------------------------------------------------------

test "the test clock moves both its readings together" {
    let ctx = context {
        Clock: clock(),
    };
    let started = time.monotonic(ctx);
    assert.eq(started.0, 0);
    time.sleep(ctx, time.millis(250));
    assert.eq(time.elapsed(ctx, started), time.millis(250));
    // And the wall clock agrees, because it is the same reading.
    assert.eq(time.now(ctx).0, 250);
}

test "elapsed is the difference between two readings" {
    let ctx = context {
        Clock: clock(),
    };
    let first = time.monotonic(ctx);
    time.sleep(ctx, time.seconds(1));
    let second = time.monotonic(ctx);
    assert.eq(second.duration(first), time.seconds(1));
    // The other way round is the same length, negated.
    assert.eq(first.duration(second), time.seconds(0 - 1));
    assert.eq(first.duration(first), time.ZERO);
    // And a reading taken now is no time after itself.
    assert.eq(time.elapsed(ctx, time.monotonic(ctx)), time.ZERO);
}

test "a monotonic reading orders and compares" {
    let ctx = context {
        Clock: clock(),
    };
    let first = time.monotonic(ctx);
    time.sleep(ctx, time.millis(5));
    let second = time.monotonic(ctx);
    assert.gt(second, first);
    assert.notEq(first, second);
    assert.eq(first, Monotonic(0));
    assert.eq(second, Monotonic(5_000_000));
}

test "a clock the test moves by hand moves the monotonic reading too" {
    let ctx = context {
        Clock: clock().at(1_000),
    };
    assert.eq(time.now(ctx).0, 1_000);
    assert.eq(time.monotonic(ctx).0, 1_000_000_000);
    assert.eq(time.elapsed(ctx, Monotonic(0)), time.seconds(1));
}
