// core/time — `Duration`, and the arithmetic between it and `Instant`.
//
// All of it is pure but the last section: a length of time is not a fact about
// when you ask, so every answer here is checkable against a number written out
// by hand. The clock appears only where the question is about reading one.
//
// The assertions that matter most are the saturating ones. Overflow is
// undefined behaviour, and a deadline is where a program can least afford it —
// so every one of these is a case where the hand-written `checkedMultiply`,
// `checkedSubtract`, decide-from-the-sign shape had to get the answer right.

from "core/effect" import { Allocator, Clock };
from "core/host/testing" import { alloc, clock };
from "core/list" import * as list;
from "core/math" import * as math;
from "core/number" import * as number;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "core/time" import { Duration, Instant, Monotonic };

// --- constructors --------------------------------------------------------------

test "each constructor names the unit it counts" {
    assert.equal(time.nanoseconds(7).0, 7);
    assert.equal(time.microseconds(7).0, 7000);
    assert.equal(time.milliseconds(7).0, 7000000);
    assert.equal(time.seconds(7).0, 7000000000);
    assert.equal(time.minutes(7).0, 420000000000);
    assert.equal(time.hours(7).0, 25200000000000);
}

test "the constructors agree with one another" {
    assert.equal(time.seconds(1), time.milliseconds(1000));
    assert.equal(time.milliseconds(1), time.microseconds(1000));
    assert.equal(time.microseconds(1), time.nanoseconds(1000));
    assert.equal(time.minutes(1), time.seconds(60));
    assert.equal(time.hours(1), time.minutes(60));
}

test "a count no Duration can hold saturates rather than wrapping" {
    let biggest = Duration(number.maxValue<I64>());
    let smallest = Duration(number.minValue<I64>());
    assert.equal(time.hours(number.maxValue<I64>()), biggest);
    assert.equal(time.seconds(1000000000000), biggest);
    assert.equal(time.hours(number.minValue<I64>()), smallest);
    assert.equal(time.seconds(-1000000000000), smallest);
    // Saturating means the sign survives, which is the whole point: the shape
    // this replaces wrapped a timeout into the past.
    assert.isFalse(time.hours(number.maxValue<I64>()).isNegative());
}

// --- getters --------------------------------------------------------------------

test "every getter truncates towards zero" {
    let d = time.nanoseconds(1999999);
    assert.equal(d.nanoseconds(), 1999999);
    assert.equal(d.microseconds(), 1999);
    assert.equal(d.milliseconds(), 1);
    assert.equal(d.seconds(), 0);
}

test "a negative length truncates towards zero too" {
    let d = time.nanoseconds(-1999999);
    assert.equal(d.microseconds(), -1999);
    assert.equal(d.milliseconds(), -1);
}

test "the larger units read what the constructors wrote" {
    assert.equal(time.hours(3).minutes(), 180);
    assert.equal(time.minutes(90).hours(), 1);
    assert.equal(time.hours(48).days(), 2);
    assert.equal(time.milliseconds(86400000).days(), 1);
}

test "isZero and isNegative say what the sign is" {
    assert.isTrue(time.nanoseconds(0).isZero());
    assert.isFalse(time.nanoseconds(1).isZero());
    assert.isTrue(time.seconds(-1).isNegative());
    assert.isFalse(time.seconds(0).isNegative());
    assert.isFalse(time.seconds(1).isNegative());
}

// --- arithmetic ------------------------------------------------------------------

test "add, subtract and multiply are the arithmetic of lengths" {
    assert.equal(time.seconds(1).add(time.milliseconds(500)), time.milliseconds(1500));
    assert.equal(
        time.seconds(1).subtract(time.milliseconds(250)),
        time.milliseconds(750),
    );
    assert.equal(time.milliseconds(250).multiply(4), time.seconds(1));
    assert.equal(time.seconds(1).multiply(0), time.nanoseconds(0));
    assert.equal(time.seconds(1).multiply(-2), time.seconds(-2));
}

test "arithmetic saturates at both ends" {
    let biggest = Duration(number.maxValue<I64>());
    let smallest = Duration(number.minValue<I64>());
    assert.equal(biggest.add(time.seconds(1)), biggest);
    assert.equal(smallest.subtract(time.seconds(1)), smallest);
    assert.equal(biggest.multiply(2), biggest);
    assert.equal(biggest.multiply(-2), smallest);
}

test "negate and abs" {
    assert.equal(time.seconds(3).negate(), time.seconds(-3));
    assert.equal(time.seconds(-3).negate(), time.seconds(3));
    assert.equal(time.seconds(-3).abs(), time.seconds(3));
    assert.equal(time.seconds(3).abs(), time.seconds(3));
    assert.equal(time.nanoseconds(0).negate(), time.nanoseconds(0));
}

test "the most negative length negates to the most positive one" {
    // The one asymmetry in two's complement, answered by saturating rather
    // than by wrapping back to itself.
    let smallest = Duration(number.minValue<I64>());
    assert.equal(smallest.negate(), Duration(number.maxValue<I64>()));
    assert.equal(smallest.abs(), Duration(number.maxValue<I64>()));
}

test "durations compare as lengths" {
    assert.isTrue(time.seconds(1) > time.milliseconds(999));
    assert.isTrue(time.milliseconds(-1) < time.nanoseconds(0));
    assert.equal(time.seconds(1), time.nanoseconds(1000000000));
    assert.isTrue(time.seconds(1) != time.seconds(2));
}

// --- Show --------------------------------------------------------------------------

test "a length shows in the largest unit it reaches" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(time.milliseconds(1500).show(ctx), "1.5s");
    assert.equal(time.milliseconds(300).show(ctx), "300ms");
    assert.equal(time.microseconds(750).show(ctx), "750us");
    assert.equal(time.nanoseconds(1).show(ctx), "1ns");
    assert.equal(time.nanoseconds(0).show(ctx), "0s");
    assert.equal(time.minutes(2).show(ctx), "120s");
}

test "the fraction is exact and carries no trailing zeros" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(time.nanoseconds(1000000001).show(ctx), "1.000000001s");
    assert.equal(time.nanoseconds(999999999).show(ctx), "999.999999ms");
    assert.equal(time.nanoseconds(1500).show(ctx), "1.5us");
    assert.equal(time.nanoseconds(999).show(ctx), "999ns");
    assert.equal(time.nanoseconds(1000).show(ctx), "1us");
}

test "the sign is in front of the number" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(time.milliseconds(-1500).show(ctx), "-1.5s");
    assert.equal(time.nanoseconds(-1).show(ctx), "-1ns");
    assert.equal(time.milliseconds(-300).show(ctx), "-300ms");
}

// --- instants ------------------------------------------------------------------------

test "the difference between two points is a length" {
    let a = Instant(1000);
    let b = Instant(4000);
    assert.equal(b.duration(a), time.seconds(3));
    assert.equal(a.duration(b), time.seconds(-3));
    assert.equal(a.duration(a), time.nanoseconds(0));
}

test "a point moved by a length is a point" {
    let a = Instant(1000);
    assert.equal(a.plus(time.seconds(3)), Instant(4000));
    assert.equal(a.minus(time.seconds(3)), Instant(-2000));
    // An `Instant` is milliseconds, so a length under one moves it nowhere.
    assert.equal(a.plus(time.nanoseconds(999999)), a);
    assert.equal(a.plus(time.microseconds(1500)), Instant(1001));
}

test "hasPassed is the whole deadline check" {
    let started = Instant(1000);
    let deadline = started.plus(time.seconds(30));
    assert.isFalse(started.hasPassed(deadline));
    assert.isFalse(started.plus(time.milliseconds(29999)).hasPassed(deadline));
    // At the deadline counts as passed: a timeout that has run out has run out.
    assert.isTrue(deadline.hasPassed(deadline));
    assert.isTrue(started.plus(time.minutes(2)).hasPassed(deadline));
}

test "a deadline built from a length that saturates has not passed" {
    // The overflow-guard dance this replaces: `checkedMultiply` a timeout out to
    // nanoseconds, `checkedSubtract` it from now, and decide from whichever answer
    // survived. Here the deadline saturates to the end of time and the check
    // is `>=`.
    let started = Instant(1000);
    let never = started.plus(time.hours(number.maxValue<I64>()));
    // The length saturated at the largest `Duration`, which is that many
    // nanoseconds; the instant then moves by the milliseconds in it.
    assert.equal(never.0, 1000 + number.maxValue<I64>() / 1000000);
    assert.isFalse(started.hasPassed(never));
    assert.isTrue(never.hasPassed(never));
}

test "moving a point past the end of time saturates too" {
    let end = Instant(number.maxValue<I64>());
    assert.equal(end.plus(time.seconds(1)), end);
    let start = Instant(number.minValue<I64>());
    assert.equal(start.minus(time.seconds(1)), start);
}

test "instants compare as points" {
    assert.isTrue(Instant(1) < Instant(2));
    assert.isTrue(Instant(2) > Instant(1));
    assert.equal(Instant(1), Instant(1));
}

// --- the clock ---------------------------------------------------------------------

test "since answers a length rather than a count" {
    let dial = clock().at(500);
    let ctx = context {
        Allocator: alloc(),
        Clock: dial,
    };
    let start = time.now(ctx);
    time.sleep(dial, time.milliseconds(250));
    let waited: Duration = time.since(ctx, start);
    assert.equal(waited, time.milliseconds(250));
    assert.equal(waited.show(ctx), "250ms");
}

test "sleep takes a length and moves the clock by it" {
    let dial = clock().at(0);
    let ctx = context {
        Clock: dial,
    };
    time.sleep(dial, time.milliseconds(250));
    assert.equal(time.now(ctx), Instant(250));
    // Under a millisecond the clock cannot move, and says so by not moving.
    time.sleep(dial, time.microseconds(999));
    assert.equal(time.now(ctx), Instant(250));
}

test "a deadline read off the clock" {
    let dial = clock().at(0);
    let ctx = context {
        Clock: dial,
    };
    let deadline = time.now(ctx).plus(time.seconds(1));
    assert.isFalse(time.now(ctx).hasPassed(deadline));
    time.sleep(dial, time.milliseconds(999));
    assert.isFalse(time.now(ctx).hasPassed(deadline));
    time.sleep(dial, time.milliseconds(1));
    assert.isTrue(time.now(ctx).hasPassed(deadline));
}

// --- no time at all, and the fractional constructor ----------------------------------

test "no time at all is the identity for adding" {
    assert.equal(time.nanoseconds(0).nanoseconds(), 0);
    assert.isTrue(time.nanoseconds(0).isZero());
    assert.isFalse(time.nanoseconds(0).isNegative());
    assert.equal(time.nanoseconds(0).add(time.seconds(3)), time.seconds(3));
    assert.equal(time.seconds(3).subtract(time.seconds(3)), time.nanoseconds(0));
}

test "asSecondsFloat reads a length as a count of seconds" {
    assert.approximatelyEqual(time.seconds(3).asSecondsFloat(), 3.0, 1e-9);
    assert.approximatelyEqual(time.milliseconds(250).asSecondsFloat(), 0.25, 1e-9);
    assert.approximatelyEqual(time.nanoseconds(0).asSecondsFloat(), 0.0, 1e-9);
    assert.approximatelyEqual(
        time.milliseconds(0 - 1500).asSecondsFloat(),
        0.0 - 1.5,
        1e-9,
    );
}

// --- dividing, and the ratio between two lengths ----------------------------------

test "divide is multiply's inverse and truncates toward zero" {
    assert.equal(time.seconds(6).divide(2), time.seconds(3));
    assert.equal(time.seconds(3).multiply(4).divide(4), time.seconds(3));
    assert.equal(time.nanoseconds(7).divide(2), time.nanoseconds(3));
    assert.equal(time.nanoseconds(0 - 7).divide(2), time.nanoseconds(0 - 3));
    assert.equal(time.nanoseconds(7).divide(0 - 2), time.nanoseconds(0 - 3));
    assert.equal(time.nanoseconds(0).divide(5), time.nanoseconds(0));
    assert.equal(time.seconds(3).divide(1), time.seconds(3));
}

test "a ratio is a number rather than a length" {
    assert.approximatelyEqual(time.seconds(3).ratio(time.seconds(1)), 3.0, 1e-9);
    assert.approximatelyEqual(time.milliseconds(500).ratio(time.seconds(1)), 0.5, 1e-9);
    assert.approximatelyEqual(time.nanoseconds(0).ratio(time.seconds(1)), 0.0, 1e-9);
    assert.approximatelyEqual(
        time.seconds(0 - 3).ratio(time.seconds(1)),
        0.0 - 3.0,
        1e-9,
    );
    // Nothing goes into no time at all a definite number of times.
    assert.isTrue(math.isInfinite(time.seconds(1).ratio(time.nanoseconds(0))));
    assert.isTrue(math.isNan(time.nanoseconds(0).ratio(time.nanoseconds(0))));
}

// --- the monotonic clock ------------------------------------------------------------

test "the test clock moves both its readings together" {
    let ctx = context {
        Clock: clock(),
    };
    let started = time.monotonic(ctx);
    assert.equal(started.0, 0);
    time.sleep(ctx, time.milliseconds(250));
    assert.equal(time.elapsed(ctx, started), time.milliseconds(250));
    // And the wall clock agrees, because it is the same reading.
    assert.equal(time.now(ctx).0, 250);
}

test "elapsed is the difference between two readings" {
    let ctx = context {
        Clock: clock(),
    };
    let first = time.monotonic(ctx);
    time.sleep(ctx, time.seconds(1));
    let second = time.monotonic(ctx);
    assert.equal(second.duration(first), time.seconds(1));
    // The other way round is the same length, negated.
    assert.equal(first.duration(second), time.seconds(0 - 1));
    assert.equal(first.duration(first), time.nanoseconds(0));
    // And a reading taken now is no time after itself.
    assert.equal(time.elapsed(ctx, time.monotonic(ctx)), time.nanoseconds(0));
}

test "a monotonic reading orders and compares" {
    let ctx = context {
        Clock: clock(),
    };
    let first = time.monotonic(ctx);
    time.sleep(ctx, time.milliseconds(5));
    let second = time.monotonic(ctx);
    assert.greaterThan(second, first);
    assert.notEqual(first, second);
    assert.equal(first, Monotonic(0));
    assert.equal(second, Monotonic(5_000_000));
}

test "a clock the test moves by hand moves the monotonic reading too" {
    let ctx = context {
        Clock: clock().at(1_000),
    };
    assert.equal(time.now(ctx).0, 1_000);
    assert.equal(time.monotonic(ctx).0, 1_000_000_000);
    assert.equal(time.elapsed(ctx, Monotonic(0)), time.seconds(1));
}

test "a run of readings off one clock never goes backwards" {
    let ctx = context {
        Allocator: alloc(),
        Clock: clock(),
    };
    // Thirty readings, with a sleep of nothing between some pairs and a longer
    // one between others. A reading taken with no time in between is the same
    // reading, which is allowed; one that is *earlier* is not.
    let readings = list
        .range(ctx, 0, 30)
        .mapCtx(ctx, fn(c, i) => {
            let _ = time.sleep(c, time.milliseconds(i % 3));
            time.monotonic(c)
        });
    assert.isTrue(readings.isSortedBy(fn(a, b) => a.compare(b)));
    // The double moves by exactly what it was told to, so the whole run is
    // checkable rather than merely ordered.
    assert.equal(assert.some(readings.first()), Monotonic(0));
    assert.equal(assert.some(readings.last()), Monotonic(30_000_000));
    // And the difference between the ends is the sum of the sleeps.
    assert.equal(
        assert.some(readings.last()).duration(assert.some(readings.first())),
        time.milliseconds(30),
    );
}

test "elapsed measures from a reading taken before the work, not after" {
    let ctx = context {
        Allocator: alloc(),
        Clock: clock().at(1_000),
    };
    let started = time.monotonic(ctx);
    let _ = time.sleep(ctx, time.milliseconds(40));
    let middle = time.elapsed(ctx, started);
    let _ = time.sleep(ctx, time.milliseconds(60));
    // The same starting reading, measured twice: the second answer is the
    // longer one, and the difference is the second sleep.
    assert.equal(middle, time.milliseconds(40));
    assert.equal(time.elapsed(ctx, started), time.milliseconds(100));
    assert.equal(time.elapsed(ctx, started).subtract(middle), time.milliseconds(60));
    // A reading from the future measures backwards rather than saturating at
    // nothing, which is what makes `duration` usable in either order.
    let ahead = Monotonic(time.monotonic(ctx).0 + 5_000_000);
    assert.equal(time.elapsed(ctx, ahead), time.milliseconds(0 - 5));
    assert.isTrue(time.elapsed(ctx, ahead).isNegative());
}

test "dividing a length by a negative count turns it round" {
    assert.equal(time.seconds(6).divide(0 - 2), time.seconds(0 - 3));
    assert.equal(time.seconds(0 - 6).divide(0 - 2), time.seconds(3));
    assert.equal(time.seconds(6).divide(0 - 1), time.seconds(0 - 6));
    // Truncation is toward zero on both sides of it.
    assert.equal(time.nanoseconds(0 - 7).divide(0 - 2), time.nanoseconds(3));
    // A divisor larger than the length leaves nothing.
    assert.equal(time.seconds(1).divide(0 - 2_000_000_000), time.nanoseconds(0));
    assert.equal(time.nanoseconds(0).divide(0 - 5), time.nanoseconds(0));
}

test "a ratio against no time at all has a sign" {
    // +/- infinity, depending on which way the length points, and a NaN only
    // where there is no length on either side.
    assert.isTrue(time.seconds(1).ratio(time.nanoseconds(0)) > 0.0);
    assert.isTrue(time.seconds(0 - 1).ratio(time.nanoseconds(0)) < 0.0);
    assert.isTrue(math.isInfinite(time.seconds(0 - 1).ratio(time.nanoseconds(0))));
    assert.isTrue(math.isNan(time.nanoseconds(0).ratio(time.nanoseconds(0))));
    // No time at all goes into a length no times at all.
    assert.approximatelyEqual(time.nanoseconds(0).ratio(time.seconds(3)), 0.0, 1e-9);
}

// --- the units, read back through the type ------------------------------------------

// A `Duration` is the only way to name a span, so the counts the constructors
// are written out of are asserted through the constructors rather than by name.
// One of each unit, in nanoseconds, is the whole of what those counts say.
test "one of each unit is worth the nanoseconds it names" {
    assert.equal(time.microseconds(1).nanoseconds(), 1_000);
    assert.equal(time.milliseconds(1).nanoseconds(), 1_000_000);
    assert.equal(time.seconds(1).nanoseconds(), 1_000_000_000);
    assert.equal(time.minutes(1).nanoseconds(), 60_000_000_000);
    assert.equal(time.hours(1).nanoseconds(), 3_600_000_000_000);
    assert.equal(time.hours(24).nanoseconds(), 86_400_000_000_000);
}

// The other half: the units scale by the factors between them, so no two
// constructors can drift apart.
test "the units scale by the factors between them" {
    assert.equal(time.milliseconds(1), time.microseconds(1_000));
    assert.equal(time.minutes(1), time.seconds(60));
    assert.equal(time.hours(24), time.hours(1).multiply(24));
    assert.equal(time.milliseconds(1).microseconds(), 1_000);
    assert.equal(time.hours(24).days(), 1);
}
