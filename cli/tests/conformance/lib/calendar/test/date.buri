// core/date — the calendar.
//
// Every assertion here is against a date whose answer is known independently:
// leap years the rules disagree about, the epoch, a day either side of it, and
// the month-end clamping that date arithmetic has to choose an answer for.

from "core/date" import * as date;
from "core/date" import { Date, DateTime, Duration, Weekday };
from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "core/time" import { Instant };

fn d(y: Int, m: Int, day: Int): Date {
    assert.some(date.date(y, m, day))
}

// --- leap years -----------------------------------------------------------------

test "the three leap year rules" {
    // Divisible by four is a leap year...
    assert.isTrue(date.isLeapYear(2024));
    assert.isFalse(date.isLeapYear(2023));
    // ...unless by a hundred...
    assert.isFalse(date.isLeapYear(1900));
    assert.isFalse(date.isLeapYear(2100));
    // ...unless by four hundred.
    assert.isTrue(date.isLeapYear(2000));
    assert.isTrue(date.isLeapYear(1600));
}

test "February is the month that changes length" {
    assert.eq(date.daysInMonth(2024, 2), 29);
    assert.eq(date.daysInMonth(2023, 2), 28);
    assert.eq(date.daysInMonth(1900, 2), 28);
    assert.eq(date.daysInMonth(2023, 1), 31);
    assert.eq(date.daysInMonth(2023, 4), 30);
    assert.eq(date.daysInMonth(2023, 13), 0);
}

// --- construction is the validation ----------------------------------------------

test "a date the calendar does not have cannot be built" {
    assert.isTrue(date.date(2023, 2, 29).isNone());
    assert.isTrue(date.date(2023, 13, 1).isNone());
    assert.isTrue(date.date(2023, 0, 1).isNone());
    assert.isTrue(date.date(2023, 4, 31).isNone());
    assert.isTrue(date.date(2023, 1, 0).isNone());
    assert.isTrue(date.date(2024, 2, 29).isSome());
}

test "a time outside the clock cannot be built" {
    assert.isTrue(date.time(24, 0, 0, 0).isNone());
    assert.isTrue(date.time(0, 60, 0, 0).isNone());
    assert.isTrue(date.time(0, 0, 0, 1000).isNone());
    assert.isTrue(date.time(23, 59, 59, 999).isSome());
}

// --- days from civil ---------------------------------------------------------------

test "the epoch is day zero" {
    assert.eq(date.toDays(d(1970, 1, 1)), 0);
    assert.eq(date.fromDays(0), d(1970, 1, 1));
}

test "days either side of the epoch" {
    assert.eq(date.toDays(d(1969, 12, 31)), -1);
    assert.eq(date.toDays(d(1970, 1, 2)), 1);
    assert.eq(date.fromDays(-1), d(1969, 12, 31));
}

test "known day numbers" {
    assert.eq(date.toDays(d(2000, 1, 1)), 10957);
    assert.eq(date.toDays(d(2024, 2, 29)), 19782);
    assert.eq(date.fromDays(19782), d(2024, 2, 29));
}

// The property that matters more than any single number: the two directions
// are inverses, across leap years, century boundaries, and before the epoch.
test "toDays and fromDays are inverses" {
    let cases = [
        d(1600, 2, 29),
        d(1899, 12, 31),
        d(1900, 3, 1),
        d(1969, 7, 20),
        d(1970, 1, 1),
        d(2000, 2, 29),
        d(2024, 12, 31),
        d(2100, 3, 1),
    ];
    assert.isTrue(cases.all(fn(c) => date.fromDays(date.toDays(c)) == c));
}

// The era of Hinnant's algorithm is `number.divFloor(y, 400)`, and the branch that
// matters is the one below year zero: a truncating `/` there puts the date in
// the wrong era and every answer that follows it is wrong by a day or more. The
// calendar is proleptic Gregorian, so these years exist and have answers.
test "toDays and fromDays are inverses before year zero too" {
    let cases = [
        d(0, 1, 1),
        d(0, 3, 1),
        d(-1, 12, 31),
        d(-1, 1, 1),
        d(-4, 2, 29),
        d(-399, 6, 15),
        d(-400, 1, 1),
        d(-401, 12, 31),
        d(-1000, 7, 4),
    ];
    assert.isTrue(cases.all(fn(c) => date.fromDays(date.toDays(c)) == c));
}

test "the day before the first of January is the last of December, in every era" {
    assert.eq(date.fromDays(date.toDays(d(0, 1, 1)) - 1), d(-1, 12, 31));
    assert.eq(date.fromDays(date.toDays(d(-400, 1, 1)) - 1), d(-401, 12, 31));
    assert.eq(date.fromDays(date.toDays(d(1, 1, 1)) - 1), d(0, 12, 31));
}

// --- weekdays -------------------------------------------------------------------

test "the epoch was a Thursday" {
    assert.eq(date.weekday(d(1970, 1, 1)), Weekday.Thursday);
}

test "known weekdays, including before the epoch" {
    assert.eq(date.weekday(d(2024, 2, 29)), Weekday.Thursday);
    assert.eq(date.weekday(d(2000, 1, 1)), Weekday.Saturday);
    assert.eq(date.weekday(d(1969, 7, 20)), Weekday.Sunday);
    assert.eq(date.weekday(d(1900, 1, 1)), Weekday.Monday);
}

test "day of the year" {
    assert.eq(date.dayOfYear(d(2023, 1, 1)), 1);
    assert.eq(date.dayOfYear(d(2023, 12, 31)), 365);
    assert.eq(date.dayOfYear(d(2024, 12, 31)), 366);
    assert.eq(date.dayOfYear(d(2024, 3, 1)), 61);
}

// --- arithmetic ------------------------------------------------------------------

test "adding days crosses months and years" {
    assert.eq(d(2023, 1, 31).addDays(1), d(2023, 2, 1));
    assert.eq(d(2023, 12, 31).addDays(1), d(2024, 1, 1));
    assert.eq(d(2024, 2, 28).addDays(1), d(2024, 2, 29));
    assert.eq(d(2023, 2, 28).addDays(1), d(2023, 3, 1));
    assert.eq(d(2023, 1, 1).addDays(-1), d(2022, 12, 31));
}

test "daysUntil is signed" {
    assert.eq(d(2023, 1, 1).daysUntil(d(2023, 1, 31)), 30);
    assert.eq(d(2023, 1, 31).daysUntil(d(2023, 1, 1)), -30);
    assert.eq(d(2023, 1, 1).daysUntil(d(2023, 1, 1)), 0);
}

// The choice this module makes, written down as a test so it cannot drift:
// adding a month to the 31st clamps rather than overflowing into next month.
test "adding months clamps the day to the month it lands in" {
    assert.eq(d(2023, 1, 31).addMonths(1), d(2023, 2, 28));
    assert.eq(d(2024, 1, 31).addMonths(1), d(2024, 2, 29));
    assert.eq(d(2023, 3, 31).addMonths(1), d(2023, 4, 30));
    assert.eq(d(2023, 1, 15).addMonths(1), d(2023, 2, 15));
}

test "adding months crosses years in both directions" {
    assert.eq(d(2023, 12, 1).addMonths(1), d(2024, 1, 1));
    assert.eq(d(2023, 1, 1).addMonths(-1), d(2022, 12, 1));
    assert.eq(d(2023, 6, 1).addMonths(-18), d(2021, 12, 1));
    assert.eq(d(2024, 2, 29).addYears(1), d(2025, 2, 28));
}

// `addMonths` splits a month count into a year and a month with the same floor
// division `toDays` uses, so it has the same branch below zero — and there the
// months of the year have to keep running 1 to 12 rather than going negative.
test "adding months crosses year zero" {
    assert.eq(d(1, 1, 1).addMonths(-1), d(0, 12, 1));
    assert.eq(d(0, 12, 1).addMonths(1), d(1, 1, 1));
    assert.eq(d(0, 1, 1).addMonths(-1), d(-1, 12, 1));
    assert.eq(d(-1, 12, 1).addMonths(1), d(0, 1, 1));
    assert.eq(d(1, 1, 1).addMonths(-13), d(-1, 12, 1));
    assert.eq(d(1, 3, 1).addYears(-2), d(-1, 3, 1));
}

// --- instants ---------------------------------------------------------------------

// An instant more than a day before the epoch is where `fromInstant`'s floor
// division and its non-negative remainder are both load-bearing: a truncating
// pair gives a day that is too late and a negative time of day.
test "an instant well before the epoch lands on the right day and time" {
    let dayMillis = 86400000;
    assert.eq(date.fromInstant(Instant(-dayMillis)).date, d(1969, 12, 31));
    assert.eq(date.fromInstant(Instant(-dayMillis)).time.hour, 0);
    assert.eq(date.fromInstant(Instant(-dayMillis - 1)).date, d(1969, 12, 30));
    assert.eq(date.fromInstant(Instant(-dayMillis - 1)).time.hour, 23);
    assert.eq(date.fromInstant(Instant(-dayMillis - 1)).time.minute, 59);
    assert.eq(date.fromInstant(Instant(-dayMillis - 1)).time.second, 59);
    assert.eq(date.fromInstant(Instant(-dayMillis - 1)).time.milli, 999);
    // And the round trip, which is what the two of them together promise.
    let dt = DateTime { date: d(1900, 3, 1), time: assert.some(date.time(0, 0, 0, 1)) };
    assert.eq(date.fromInstant(date.toInstant(dt)), dt);
}

test "the epoch instant is the epoch date at midnight" {
    assert.eq(date.fromInstant(Instant(0)), date.midnight(d(1970, 1, 1)));
    assert.eq(date.toInstant(date.midnight(d(1970, 1, 1))), Instant(0));
}

test "an instant carries the time of day" {
    let dt = date.fromInstant(Instant(1000 * 60 * 60 * 13 + 1000 * 60 * 45 + 1500));
    assert.eq(dt.date, d(1970, 1, 1));
    assert.eq(dt.time.hour, 13);
    assert.eq(dt.time.minute, 45);
    assert.eq(dt.time.second, 1);
    assert.eq(dt.time.milli, 500);
}

// Before the epoch the division has to floor rather than truncate, or the date
// comes out a day late.
test "an instant before the epoch lands on the right day" {
    assert.eq(date.fromInstant(Instant(-1)).date, d(1969, 12, 31));
    assert.eq(date.fromInstant(Instant(-1)).time.hour, 23);
    assert.eq(date.fromInstant(Instant(-1)).time.milli, 999);
}

test "instants and date-times are inverses" {
    let dt = DateTime {
        date: d(2024, 2, 29),
        time: assert.some(date.time(13, 45, 1, 500)),
    };
    assert.eq(date.fromInstant(date.toInstant(dt)), dt);
}

test "durations are lengths and instants are points" {
    let a = Instant(1000);
    let b = Instant(1000 + 90 * 1000);
    assert.eq(date.between(a, b), time.seconds(90));
    assert.eq(date.between(a, b).seconds(), 90);
    assert.eq(date.between(a, b).minutes(), 1);
    assert.eq(date.between(b, a), time.seconds(-90));
    assert.eq(date.plus(a, time.seconds(90)), b);
    assert.eq(time.millis(date.MILLIS_PER_DAY).days(), 1);
    assert.eq(time.millis(date.MILLIS_PER_HOUR).hours(), 1);
}

test "the calendar's Duration is core/time's, re-exported and not a copy" {
    // Imported here from `core/date` and there from `core/time`: one type, so
    // a value built by one module's constructor is read by the other's getter.
    let borrowed: Duration = time.seconds(1);
    assert.eq(borrowed.millis(), 1000);
    assert.eq(date.between(Instant(0), Instant(1000)), borrowed);
}

// --- ISO 8601 ----------------------------------------------------------------------

test "dates format with fixed width" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(date.formatDate(ctx, d(2024, 2, 29)), "2024-02-29");
    assert.eq(date.formatDate(ctx, d(999, 1, 2)), "0999-01-02");
}

test "date-times format as UTC with milliseconds" {
    let ctx = context {
        Alloc: alloc(),
    };
    let dt = DateTime {
        date: d(2026, 8, 15),
        time: assert.some(date.time(13, 45, 0, 7)),
    };
    assert.eq(date.formatDateTime(ctx, dt), "2026-08-15T13:45:00.007Z");
}

test "parseDate reads what formatDate writes" {
    let ctx = context {
        Alloc: alloc(),
    };
    let cases = [d(1970, 1, 1), d(2024, 2, 29), d(2100, 12, 31)];
    // `mapCtx`, then check: a lambda may not capture a context, so the round
    // trip is done by a combinator that passes one in.
    let back = cases.mapCtx(ctx, fn(c, one) => {
        date.parseDate(c, date.formatDate(c, one))
    });
    assert.eq(back, cases.mapCtx(ctx, fn(_c, one) => .Some(one)));
}

test "parseDate is strict" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(date.parseDate(ctx, "2024-2-29").isSome());
    assert.isTrue(date.parseDate(ctx, "2023-02-29").isNone());
    assert.isTrue(date.parseDate(ctx, "2024-02").isNone());
    assert.isTrue(date.parseDate(ctx, "not a date").isNone());
    assert.isTrue(date.parseDate(ctx, "").isNone());
}

// --- ordering ------------------------------------------------------------------------

test "dates and times order chronologically" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(d(2023, 1, 1) < d(2023, 1, 2));
    assert.isTrue(d(2023, 1, 31) < d(2023, 2, 1));
    assert.isTrue(d(2022, 12, 31) < d(2023, 1, 1));
    assert.eq([d(2024, 1, 1), d(2023, 6, 1), d(2023, 1, 1)].sort(ctx), [
        d(2023, 1, 1),
        d(2023, 6, 1),
        d(2024, 1, 1),
    ]);
}

// --- ISO weeks -------------------------------------------------------------------
//
// The week-based year is not the calendar year, and the pairs below are where the
// two part company. A week belongs to the year its Thursday falls in.

test "the ISO week of an ordinary day" {
    assert.eq(date.isoWeek(d(2026, 8, 15)), (2026, 33));
    assert.eq(date.isoWeek(d(2024, 2, 29)), (2024, 9));
    assert.eq(date.isoWeek(d(1970, 1, 1)), (1970, 1));
}

test "a January day can belong to the previous year's last week" {
    // 2027-01-01 is a Friday, so its Thursday is in 2026.
    assert.eq(date.isoWeek(d(2027, 1, 1)), (2026, 53));
    assert.eq(date.isoWeek(d(2021, 1, 1)), (2020, 53));
    assert.eq(date.isoWeek(d(2005, 1, 2)), (2004, 53));
    // And the Monday that starts the new week-year starts week 1.
    assert.eq(date.isoWeek(d(2021, 1, 4)), (2021, 1));
    assert.eq(date.isoWeek(d(2026, 1, 1)), (2026, 1));
}

test "a December day can belong to the next year's first week" {
    assert.eq(date.isoWeek(d(2026, 12, 31)), (2026, 53));
    assert.eq(date.isoWeek(d(2020, 12, 31)), (2020, 53));
    assert.eq(date.isoWeek(d(2015, 12, 28)), (2015, 53));
    assert.eq(date.isoWeek(d(2016, 1, 3)), (2015, 53));
}

test "every day of one week has the same week number" {
    let ctx = context {
        Alloc: alloc(),
    };
    // 2026-08-10 is a Monday.
    let monday = d(2026, 8, 10);
    assert.eq(date.weekday(monday), Weekday.Monday);
    let weeks = list
        .range(ctx, 0, 7)
        .map(ctx, fn(offset) => date.isoWeek(monday.addDays(offset)));
    assert.eq(weeks, list.repeat(ctx, (2026, 33), 7));
    // And the next day starts the next one.
    assert.eq(date.isoWeek(monday.addDays(7)), (2026, 34));
}

// --- calendar-unit arithmetic -------------------------------------------------------

test "monthsUntil counts whole months in both directions" {
    let january = d(2026, 1, 15);
    assert.eq(january.monthsUntil(d(2026, 4, 15)), 3);
    assert.eq(january.monthsUntil(d(2027, 1, 15)), 12);
    assert.eq(january.monthsUntil(january), 0);
    assert.eq(january.monthsUntil(d(2025, 10, 15)), 0 - 3);
}

test "a month is not whole until the day of the month comes round" {
    let endOfJanuary = d(2026, 1, 31);
    // The 31st to the 28th of February is nearly a month, and nearly is zero.
    assert.eq(endOfJanuary.monthsUntil(d(2026, 2, 28)), 0);
    assert.eq(endOfJanuary.monthsUntil(d(2026, 3, 1)), 1);
    assert.eq(endOfJanuary.monthsUntil(d(2026, 3, 31)), 2);
    // Backwards, the same rule the other way up.
    let march = d(2026, 3, 31);
    assert.eq(march.monthsUntil(d(2026, 3, 1)), 0);
    assert.eq(march.monthsUntil(d(2026, 2, 28)), 0 - 1);
}

test "yearsUntil is monthsUntil over twelve" {
    let born = d(2000, 2, 29);
    // A birthday counts on the day, not the day before.
    assert.eq(born.yearsUntil(d(2001, 2, 28)), 0);
    assert.eq(born.yearsUntil(d(2001, 3, 1)), 1);
    assert.eq(born.yearsUntil(d(2026, 3, 1)), 26);
    assert.eq(born.yearsUntil(d(1999, 3, 1)), 0);
    assert.eq(born.yearsUntil(d(1998, 3, 1)), 0 - 1);
}

test "the first and last day of a month" {
    let middle = d(2026, 8, 15);
    assert.eq(middle.startOfMonth(), d(2026, 8, 1));
    assert.eq(middle.endOfMonth(), d(2026, 8, 31));
    // Thirty days has September.
    assert.eq(d(2026, 9, 30).endOfMonth(), d(2026, 9, 30));
    // February, both ways.
    assert.eq(d(2026, 2, 5).endOfMonth(), d(2026, 2, 28));
    assert.eq(d(2024, 2, 5).endOfMonth(), d(2024, 2, 29));
    // Both are idempotent.
    assert.eq(middle.startOfMonth().startOfMonth(), middle.startOfMonth());
    assert.eq(middle.endOfMonth().endOfMonth(), middle.endOfMonth());
}

test "the end of a month is the day before the start of the next" {
    let month = d(2026, 2, 10);
    assert.eq(month.endOfMonth().addDays(1), month.addMonths(1).startOfMonth());
    assert.eq(d(2026, 12, 3).endOfMonth().addDays(1), d(2027, 1, 1));
    assert.eq(d(2026, 1, 1).addDays(0 - 1), d(2025, 12, 1).endOfMonth());
}

// --- the ISO week at the turn of a year ------------------------------------------
//
// The six days either side of a New Year are where the week-based year and the
// calendar year come apart, and the answers below are ISO 8601's own for every
// New Year from 2016 to 2031. Between them the sixteen years cover all four
// shapes: a 53-week year on both sides, a 52-week year whose last days already
// belong to the next one, and both ways round in between.

test "the ISO week of every day from the 29th of December to the 3rd of January" {
    let ctx = context {
        Alloc: alloc(),
    };
    let expected: [(Int, Int)] = [
        (2015, 53),
        (2015, 53),
        (2015, 53),
        (2015, 53),
        (2015, 53),
        (2015, 53),
        (2016, 52),
        (2016, 52),
        (2016, 52),
        (2016, 52),
        (2017, 1),
        (2017, 1),
        (2017, 52),
        (2017, 52),
        (2017, 52),
        (2018, 1),
        (2018, 1),
        (2018, 1),
        (2018, 52),
        (2018, 52),
        (2019, 1),
        (2019, 1),
        (2019, 1),
        (2019, 1),
        (2019, 52),
        (2020, 1),
        (2020, 1),
        (2020, 1),
        (2020, 1),
        (2020, 1),
        (2020, 53),
        (2020, 53),
        (2020, 53),
        (2020, 53),
        (2020, 53),
        (2020, 53),
        (2021, 52),
        (2021, 52),
        (2021, 52),
        (2021, 52),
        (2021, 52),
        (2022, 1),
        (2022, 52),
        (2022, 52),
        (2022, 52),
        (2022, 52),
        (2023, 1),
        (2023, 1),
        (2023, 52),
        (2023, 52),
        (2023, 52),
        (2024, 1),
        (2024, 1),
        (2024, 1),
        (2024, 52),
        (2025, 1),
        (2025, 1),
        (2025, 1),
        (2025, 1),
        (2025, 1),
        (2026, 1),
        (2026, 1),
        (2026, 1),
        (2026, 1),
        (2026, 1),
        (2026, 1),
        (2026, 53),
        (2026, 53),
        (2026, 53),
        (2026, 53),
        (2026, 53),
        (2026, 53),
        (2027, 52),
        (2027, 52),
        (2027, 52),
        (2027, 52),
        (2027, 52),
        (2028, 1),
        (2028, 52),
        (2028, 52),
        (2028, 52),
        (2029, 1),
        (2029, 1),
        (2029, 1),
        (2029, 52),
        (2029, 52),
        (2030, 1),
        (2030, 1),
        (2030, 1),
        (2030, 1),
        (2030, 52),
        (2031, 1),
        (2031, 1),
        (2031, 1),
        (2031, 1),
        (2031, 1),
    ];
    // 2015-12-29 .. 2016-01-03
    // 2016-12-29 .. 2017-01-03
    // 2017-12-29 .. 2018-01-03
    // 2018-12-29 .. 2019-01-03
    // 2019-12-29 .. 2020-01-03
    // 2020-12-29 .. 2021-01-03
    // 2021-12-29 .. 2022-01-03
    // 2022-12-29 .. 2023-01-03
    // 2023-12-29 .. 2024-01-03
    // 2024-12-29 .. 2025-01-03
    // 2025-12-29 .. 2026-01-03
    // 2026-12-29 .. 2027-01-03
    // 2027-12-29 .. 2028-01-03
    // 2028-12-29 .. 2029-01-03
    // 2029-12-29 .. 2030-01-03
    // 2030-12-29 .. 2031-01-03
    let actual = list
        .range(ctx, 0, 16)
        .flatMapCtx(ctx, fn(c, i) => {
            let year = 2015 + i;
            [
                date.isoWeek(d(year, 12, 29)),
                date.isoWeek(d(year, 12, 30)),
                date.isoWeek(d(year, 12, 31)),
                date.isoWeek(d(year + 1, 1, 1)),
                date.isoWeek(d(year + 1, 1, 2)),
                date.isoWeek(d(year + 1, 1, 3)),
            ]
        });
    assert.eq(actual, expected);
}

test "a week number is between 1 and 53, and a whole week shares its Thursday's" {
    let ctx = context {
        Alloc: alloc(),
    };
    // Eight hundred consecutive days, which is two New Years with every weekday
    // in every position around them.
    let start = d(2019, 6, 1);
    let bad = list
        .range(ctx, 0, 800)
        .map(ctx, fn(offset) => start.addDays(offset))
        .filter(ctx, fn(day) => {
            let (year, week) = date.isoWeek(day);
            // The Thursday of this day's week decides both numbers, so every
            // day of the week has to answer what that Thursday answers.
            let thursday = day.addDays(4 - isoWeekday(day));
            week < 1 || week > 53 || date.isoWeek(thursday) != (year, week)
        });
    assert.isEmpty(bad);
}

/// Monday is 1 and Sunday is 7, written out here rather than read off the
/// library, so the check is not the same arithmetic checking itself.
fn isoWeekday(day: Date): Int {
    match (date.weekday(day)) {
        .Monday => 1,
        .Tuesday => 2,
        .Wednesday => 3,
        .Thursday => 4,
        .Friday => 5,
        .Saturday => 6,
        .Sunday => 7,
    }
}

// --- every month of a year ---------------------------------------------------------

test "the first and last day of every month in a leap year and a common one" {
    let ctx = context {
        Alloc: alloc(),
    };
    let leap = list
        .range(ctx, 1, 13)
        .map(ctx, fn(month) => d(2024, month, 15).endOfMonth().day);
    assert.eq(leap, [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]);
    // The same months in a year with no leap day.
    let common = list
        .range(ctx, 1, 13)
        .map(ctx, fn(month) => d(2023, month, 15).endOfMonth().day);
    assert.eq(common, [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]);
    // Every first is the 1st, and neither end moves the month or the year.
    let wrong = list
        .range(ctx, 1, 13)
        .map(ctx, fn(month) => d(2024, month, 15))
        .filter(ctx, fn(day) => {
            let first = day.startOfMonth();
            let last = day.endOfMonth();
            first.day != 1
                || first.year != day.year
                || first.month != day.month
                || last.year != day.year
                || last.month != day.month
        });
    assert.isEmpty(wrong);
}

test "the day after the end of every month is the first of the next" {
    let ctx = context {
        Alloc: alloc(),
    };
    let bad = list
        .range(ctx, 0, 24)
        .map(ctx, fn(i) => d(2024, 1, 1).addMonths(i))
        .filter(ctx, fn(month) => {
            month.endOfMonth().addDays(1) != month.addMonths(1).startOfMonth()
        });
    assert.isEmpty(bad);
}

test "addMonths of monthsUntil lands on or before the date it counted to" {
    let ctx = context {
        Alloc: alloc(),
    };
    // The clamping and the counting are two different rules, and the doc
    // comment claims they meet here. Month ends against month ends is where
    // they would not.
    let starts = [d(2024, 1, 31), d(2024, 2, 29), d(2023, 3, 31), d(2024, 8, 15)];
    let targets = list
        .range(ctx, 0, 40)
        .map(ctx, fn(i) => d(2023, 1, 1).addDays(i * 17));
    let bad = starts.flatMapCtx(ctx, fn(c, origin) => {
        targets.filter(c, fn(target) => {
            let landed = origin.addMonths(origin.monthsUntil(target));
            // On or before, in whichever direction the count went.
            if (origin.daysUntil(target) >= 0) {
                landed.daysUntil(target) < 0
            } else {
                landed.daysUntil(target) > 0
            }
        })
    });
    assert.isEmpty(bad);
}

test "a month end counts to the day of the month it started on" {
    // January the 31st to February the 29th is still not a whole month: the
    // 31st has not come round.
    assert.eq(d(2024, 1, 31).monthsUntil(d(2024, 2, 29)), 0);
    assert.eq(d(2024, 1, 29).monthsUntil(d(2024, 2, 29)), 1);
    // And the leap day itself, forwards and backwards.
    assert.eq(d(2024, 2, 29).monthsUntil(d(2025, 2, 28)), 11);
    assert.eq(d(2024, 2, 29).monthsUntil(d(2028, 2, 29)), 48);
    assert.eq(d(2024, 2, 29).yearsUntil(d(2025, 2, 28)), 0);
    assert.eq(d(2024, 2, 29).yearsUntil(d(2028, 2, 29)), 4);
    assert.eq(d(2024, 2, 29).monthsUntil(d(2023, 2, 28)), 0 - 12);
    assert.eq(d(2024, 2, 29).monthsUntil(d(2024, 1, 31)), 0);
}
