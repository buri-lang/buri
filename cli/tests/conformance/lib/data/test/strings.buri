// core/str and core/char — SPEC 3.5, 3.6, 11.1.
//
// The load-bearing claim here is that `Str` is measured in Unicode scalar
// values, not UTF-8 bytes and not UTF-16 code units, so every length, index,
// and slice test below uses a non-BMP character somewhere.

from "core/char" import * as char;
from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/order" import * as order;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// --- len ----------------------------------------------------------------------

test "len counts characters in ASCII" {
    assert.eq("hello".len(), 5);
}

test "len of the empty string is zero" {
    assert.eq("".len(), 0);
}

test "len counts scalar values, not UTF-8 bytes" {
    // "é" is two UTF-8 bytes and one scalar value.
    assert.eq("é".len(), 1);
}

test "len counts a non-BMP character as one, not two" {
    // U+1F600 is four UTF-8 bytes and two UTF-16 code units. It is one scalar.
    assert.eq("😀".len(), 1);
}

test "len of a mixed string counts scalar values" {
    assert.eq("a😀b".len(), 3);
}

test "len of a string of only non-BMP characters" {
    assert.eq("😀😁😂".len(), 3);
}

test "isEmpty is true only for the empty string" {
    assert.isTrue("".isEmpty());
    assert.isFalse(" ".isEmpty());
}

// --- charAt -------------------------------------------------------------------

test "charAt yields the character at an index" {
    assert.eq(assert.some("abc".charAt(1)), 'b');
}

test "charAt at zero yields the first character" {
    assert.eq(assert.some("abc".charAt(0)), 'a');
}

test "charAt past the end yields None" {
    assert.none("abc".charAt(3));
}

test "charAt at a negative index yields None" {
    assert.none("abc".charAt(-1));
}

test "charAt on the empty string yields None" {
    assert.none("".charAt(0));
}

test "charAt indexes by scalar value" {
    assert.eq(assert.some("a😀b".charAt(1)), '😀');
    assert.eq(assert.some("a😀b".charAt(2)), 'b');
}

test "charAt past a non-BMP string is None" {
    assert.none("😀".charAt(1));
}

// --- slice --------------------------------------------------------------------

test "slice takes a half-open range" {
    assert.eq("hello".slice(1, 3), "el");
}

test "slice with equal bounds is empty" {
    assert.eq("hello".slice(2, 2), "");
}

test "slice covering everything is the whole string" {
    assert.eq("hello".slice(0, 5), "hello");
}

test "slice clamps past the end" {
    assert.eq("hello".slice(3, 99), "lo");
}

test "slice with an inverted range is empty" {
    assert.eq("hello".slice(3, 1), "");
}

test "slice on the empty string is empty" {
    assert.eq("".slice(0, 3), "");
}

test "slice cuts on scalar boundaries" {
    assert.eq("a😀b".slice(1, 2), "😀");
    assert.eq("a😀b".slice(2, 3), "b");
}

// --- trim ---------------------------------------------------------------------

test "trim removes leading and trailing whitespace" {
    assert.eq("  hi  ".trim(), "hi");
}

test "trim leaves interior whitespace alone" {
    assert.eq("  a b  ".trim(), "a b");
}

test "trim of an all-whitespace string is empty" {
    assert.eq("   ".trim(), "");
}

test "trim of the empty string is empty" {
    assert.eq("".trim(), "");
}

test "trim handles tabs and newlines" {
    assert.eq("\t\nhi\n\t".trim(), "hi");
}

test "trimStart removes only leading whitespace" {
    assert.eq("  hi  ".trimStart(), "hi  ");
}

test "trimStart on a string with no leading space is the identity" {
    assert.eq("hi  ".trimStart(), "hi  ");
}

test "trimEnd removes only trailing whitespace" {
    assert.eq("  hi  ".trimEnd(), "  hi");
}

test "trimEnd on a string with no trailing space is the identity" {
    assert.eq("  hi".trimEnd(), "  hi");
}

// --- startsWith / endsWith / contains -----------------------------------------

test "startsWith accepts a prefix" {
    assert.isTrue("hello".startsWith("he"));
}

test "startsWith rejects a non-prefix" {
    assert.isFalse("hello".startsWith("lo"));
}

test "startsWith accepts the whole string" {
    assert.isTrue("hello".startsWith("hello"));
}

test "startsWith the empty prefix is true" {
    assert.isTrue("hello".startsWith(""));
    assert.isTrue("".startsWith(""));
}

test "startsWith a longer needle is false" {
    assert.isFalse("hi".startsWith("hiya"));
}

test "endsWith accepts a suffix" {
    assert.isTrue("hello".endsWith("lo"));
}

test "endsWith rejects a non-suffix" {
    assert.isFalse("hello".endsWith("he"));
}

test "endsWith the empty suffix is true" {
    assert.isTrue("hello".endsWith(""));
}

test "endsWith a longer needle is false" {
    assert.isFalse("hi".endsWith("ohi"));
}

test "contains finds an interior needle" {
    assert.isTrue("hello".contains("ell"));
}

test "contains rejects an absent needle" {
    assert.isFalse("hello".contains("xyz"));
}

test "contains the empty needle is true" {
    assert.isTrue("hello".contains(""));
    assert.isTrue("".contains(""));
}

test "contains on the empty string rejects a nonempty needle" {
    assert.isFalse("".contains("a"));
}

// --- indexOf ------------------------------------------------------------------

test "indexOf yields the first occurrence" {
    assert.eq(assert.some("banana".indexOf("na")), 2);
}

test "indexOf at the start is zero" {
    assert.eq(assert.some("banana".indexOf("ba")), 0);
}

test "indexOf an absent needle is None" {
    assert.none("banana".indexOf("xyz"));
}

test "indexOf on the empty string is None for a nonempty needle" {
    assert.none("".indexOf("a"));
}

test "indexOf counts in scalar values" {
    assert.eq(assert.some("😀ab".indexOf("b")), 2);
}

// --- splitOnce ----------------------------------------------------------------

test "splitOnce yields both halves when the separator is present" {
    let parts = assert.some("key=value".splitOnce("="));
    assert.eq(parts.0, "key");
    assert.eq(parts.1, "value");
}

test "splitOnce splits at the first occurrence only" {
    let parts = assert.some("a=b=c".splitOnce("="));
    assert.eq(parts.0, "a");
    assert.eq(parts.1, "b=c");
}

test "splitOnce with a leading separator yields an empty left half" {
    let parts = assert.some("=v".splitOnce("="));
    assert.eq(parts.0, "");
    assert.eq(parts.1, "v");
}

test "splitOnce with a trailing separator yields an empty right half" {
    let parts = assert.some("k=".splitOnce("="));
    assert.eq(parts.0, "k");
    assert.eq(parts.1, "");
}

test "splitOnce yields None when the separator is absent" {
    assert.none("keyvalue".splitOnce("="));
}

test "splitOnce on the empty string yields None" {
    assert.none("".splitOnce("="));
}

test "splitOnce with a multi-character separator" {
    let parts = assert.some("a::b".splitOnce("::"));
    assert.eq(parts.0, "a");
    assert.eq(parts.1, "b");
}

// --- compare ------------------------------------------------------------------

test "compare reports Less" {
    assert.isTrue("apple".compare("banana").isLess());
}

test "compare reports Equal" {
    assert.isTrue("apple".compare("apple").isEqual());
}

test "compare reports Greater" {
    assert.eq("banana".compare("apple"), Order.Greater);
}

test "compare orders a prefix before its extension" {
    assert.isTrue("app".compare("apple").isLess());
}

test "compare orders the empty string first" {
    assert.isTrue("".compare("a").isLess());
    assert.isTrue("".compare("").isEqual());
}

// The order is **Unicode scalar value**, which for a valid string is UTF-8 byte
// order — the unit `len` counts and `charAt` hands back. Every case above is
// ASCII, where all three candidate orders agree; these are the ones that
// discriminate, and they are the whole of what `core/str`'s `compare` promises
// beyond "lexicographic".
//
// A JavaScript string is UTF-16 and `<` on one orders code units, so an astral
// scalar — a surrogate pair beginning at U+D800 — sorts *below* U+E000..U+FFFF
// there. Buri says the opposite on both backends, so these cases are also what
// stops the JavaScript backend quietly reverting to `<`.
//
// U+FFFD (�) is the character from that band these use, because it is one a
// reader can see. buri-lang/buri#35 reports the same thing about U+E000, which
// is in the same band, sorts the same way, and is a private-use character with
// no glyph — and a test whose subject is invisible in its own source is a test
// nobody can check. The formatter writes a printable scalar as itself rather
// than as an escape, so `\u{e000}` is not available as a spelling.

test "compare orders an astral character above the top of the plane" {
    // U+FFFD is 65533 and U+1F600 is 128512, so the emoji sorts above it.
    // Every scalar in U+E000..U+FFFF answers the same way, and JavaScript's
    // `<` answers the opposite for all of them.
    assert.isTrue("�".compare("😀").isLess());
    assert.eq("😀".compare("�"), Order.Greater);
}

test "compare orders across the first astral scalar" {
    // U+10000 is the lowest scalar written as a surrogate pair, so this is the
    // pair the two candidate orders disagree about by the smallest margin
    // there is.
    assert.isTrue("�".compare("𐀀").isLess());
    assert.eq("𐀀".compare("�"), Order.Greater);
}

test "compare decides past a shared prefix" {
    assert.isTrue("x�y".compare("x😀y").isLess());
    assert.isTrue("😀a".compare("😀b").isLess());
}

test "compare orders a non-ASCII prefix before its extension" {
    assert.isTrue("😀".compare("😀a").isLess());
}

// --- toInt / toFloat ----------------------------------------------------------

test "toInt parses a decimal integer" {
    assert.eq(assert.some("42".toInt()), 42);
}

test "toInt parses a negative integer" {
    assert.eq(assert.some("-42".toInt()), -42);
}

test "toInt parses zero" {
    assert.eq(assert.some("0".toInt()), 0);
}

test "toInt rejects a non-numeric string" {
    assert.none("abc".toInt());
}

test "toInt rejects the empty string" {
    assert.none("".toInt());
}

test "toInt rejects trailing junk" {
    assert.none("42x".toInt());
}

test "toInt rejects a float" {
    assert.none("4.2".toInt());
}

test "toInt rejects a lone minus" {
    assert.none("-".toInt());
}

test "toInt parses a value on either side of zero" {
    assert.eq(assert.some("9007199254740991".toInt()), 9007199254740991);
    assert.eq(assert.some("-9007199254740991".toInt()), -9007199254740991);
}

test "toInt parses every I64, and refuses what is not one" {
    // `Int` is `I64` on every backend and holds its whole range, so the only
    // string refused here is one naming a number that is not an `I64` at all.
    assert.eq(assert.some("9007199254740992".toInt()), 9007199254740992);
    assert.eq(assert.some("9223372036854775807".toInt()), 9223372036854775807);
    assert.eq(assert.some("-9223372036854775808".toInt()), -9223372036854775808);
    assert.none("9223372036854775808".toInt());
}

test "toInt rejects a value far outside I64" {
    assert.none("99999999999999999999".toInt());
}

test "toFloat parses a decimal" {
    assert.eq(assert.some("3.5".toFloat()), 3.5);
}

test "toFloat parses a negative decimal" {
    assert.eq(assert.some("-3.5".toFloat()), -3.5);
}

test "toFloat parses an integer-shaped string" {
    assert.eq(assert.some("4".toFloat()), 4.0);
}

test "toFloat rejects a non-numeric string" {
    assert.none("abc".toFloat());
}

test "toFloat rejects the empty string" {
    assert.none("".toFloat());
}

// --- concat -------------------------------------------------------------------

test "concat joins two strings" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("foo".concat(ctx, "bar"), "foobar");
}

test "concat with the empty string is the identity" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("foo".concat(ctx, ""), "foo");
    assert.eq("".concat(ctx, "bar"), "bar");
}

test "concat of two empty strings is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".concat(ctx, ""), "");
}

// --- split / splitAny / lines -------------------------------------------------

test "split cuts on every occurrence" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a,b,c".split(ctx, ","), ["a", "b", "c"]);
}

test "split keeps empty pieces" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a,,b".split(ctx, ","), ["a", "", "b"]);
}

test "split keeps a leading and trailing empty piece" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(",a,".split(ctx, ","), ["", "a", ""]);
}

test "split with an absent separator yields the whole string" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".split(ctx, ","), ["abc"]);
}

test "split of the empty string yields one empty piece" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".split(ctx, ","), [""]);
}

test "split on a multi-character separator" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a::b::c".split(ctx, "::"), ["a", "b", "c"]);
}

test "splitAny cuts on any of the separator characters" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a,b;c".splitAny(ctx, ",;"), ["a", "b", "c"]);
}

test "splitAny drops empty pieces" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a,,b".splitAny(ctx, ","), ["a", "b"]);
}

test "splitAny drops leading and trailing empties" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(",a,".splitAny(ctx, ","), ["a"]);
}

test "splitAny of the empty string is the empty list" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".splitAny(ctx, ","), list.empty<Str>());
}

test "splitAny splits on whitespace" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("  a  b  ".splitAny(ctx, " "), ["a", "b"]);
}

test "lines splits on newlines" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a\nb\nc".lines(ctx), ["a", "b", "c"]);
}

test "lines of a single line is a singleton" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("only".lines(ctx), ["only"]);
}

test "lines keeps blank lines" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a\n\nb".lines(ctx), ["a", "", "b"]);
}

test "lines of a string ending in a newline yields a trailing empty piece" {
    // SPEC does not fix `lines`; this pins what the implementation does, which
    // is the `split`-like reading rather than the "drop the final empty" one.
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a\n".lines(ctx), ["a", ""]);
}

// --- replace ------------------------------------------------------------------

test "replace substitutes every occurrence" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("banana".replace(ctx, "a", "o"), "bonono");
}

test "replace with an absent needle is the identity" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("banana".replace(ctx, "z", "o"), "banana");
}

test "replace can delete" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("banana".replace(ctx, "na", ""), "ba");
}

test "replace can lengthen" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ab".replace(ctx, "b", "bbb"), "abbb");
}

test "replace on the empty string is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".replace(ctx, "a", "b"), "");
}

// --- repeat -------------------------------------------------------------------

test "repeat concatenates n copies" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ab".repeat(ctx, 3), "ababab");
}

test "repeat once is the identity" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ab".repeat(ctx, 1), "ab");
}

test "repeat zero times is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ab".repeat(ctx, 0), "");
}

test "repeat a negative number of times is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ab".repeat(ctx, -2), "");
}

test "repeating the empty string is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".repeat(ctx, 5), "");
}

// --- toUpper / toLower --------------------------------------------------------

test "toUpper uppercases ASCII" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("hello".toUpper(ctx), "HELLO");
}

test "toUpper leaves non-letters alone" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a1-b".toUpper(ctx), "A1-B");
}

test "toUpper of the empty string is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".toUpper(ctx), "");
}

test "toLower lowercases ASCII" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("HELLO".toLower(ctx), "hello");
}

test "toLower of the empty string is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".toLower(ctx), "");
}

test "toLower then toUpper round-trips ASCII" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("MiXeD".toLower(ctx).toUpper(ctx), "MIXED");
}

// --- chars / fromChars --------------------------------------------------------

test "chars explodes a string into scalar values" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".chars(ctx), ['a', 'b', 'c']);
}

test "chars of the empty string is the empty list" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".chars(ctx), list.empty<Char>());
}

test "chars yields one element per non-BMP character" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a😀".chars(ctx), ['a', '😀']);
}

test "chars length agrees with len" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a😀b".chars(ctx).len(), "a😀b".len());
}

test "fromChars rebuilds a string" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromChars(ctx, ['a', 'b', 'c']), "abc");
}

test "fromChars of the empty list is the empty string" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromChars(ctx, list.empty<Char>()), "");
}

test "fromChars round-trips chars" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromChars(ctx, "a😀b".chars(ctx)), "a😀b");
}

// --- fromInt / fromFloat ------------------------------------------------------

test "fromInt renders a positive integer" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromInt(ctx, 42), "42");
}

test "fromInt renders zero" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromInt(ctx, 0), "0");
}

test "fromInt renders a negative integer" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromInt(ctx, -7), "-7");
}

test "fromInt round-trips through toInt" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(assert.some(str.fromInt(ctx, -1234).toInt()), -1234);
}

test "fromFloat round-trips through toFloat" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(assert.some(str.fromFloat(ctx, 3.5).toFloat()), 3.5);
}

test "fromFloat renders a negative float" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(assert.some(str.fromFloat(ctx, -0.25).toFloat()), -0.25);
}

// --- padStart / padEnd --------------------------------------------------------

test "padStart pads on the left" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("7".padStart(ctx, 3, '0'), "007");
}

test "padStart leaves a long-enough string alone" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("12345".padStart(ctx, 3, '0'), "12345");
}

test "padStart to the exact width is the identity" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".padStart(ctx, 3, ' '), "abc");
}

test "padStart of the empty string fills entirely" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("".padStart(ctx, 2, 'x'), "xx");
}

test "padEnd pads on the right" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("7".padEnd(ctx, 3, '0'), "700");
}

test "padEnd leaves a long-enough string alone" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("12345".padEnd(ctx, 3, '0'), "12345");
}

test "padEnd measures the width in scalar values" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("😀".padEnd(ctx, 3, '.'), "😀..");
}

// --- format -------------------------------------------------------------------

test "format renders a template with no holes" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.format(ctx, "plain"), "plain");
}

test "format interpolates an Int" {
    let ctx = context {
        Alloc: alloc(),
    };
    let n = 7;
    assert.eq(str.format(ctx, "n = ${n}"), "n = 7");
}

test "format interpolates a Str" {
    let ctx = context {
        Alloc: alloc(),
    };
    let who = "world";
    assert.eq(str.format(ctx, "hello ${who}"), "hello world");
}

test "format interpolates a Bool" {
    let ctx = context {
        Alloc: alloc(),
    };
    let b = true;
    assert.eq(str.format(ctx, "${b}"), "true");
}

test "format interpolates a Char" {
    let ctx = context {
        Alloc: alloc(),
    };
    let c = 'x';
    assert.eq(str.format(ctx, "[${c}]"), "[x]");
}

test "format interpolates several holes" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a = 1;
    let b = 2;
    assert.eq(str.format(ctx, "${a}+${b}=${a + b}"), "1+2=3");
}

test "format evaluates an expression hole" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.format(ctx, "${2 * 21}"), "42");
}

test "format escapes a literal dollar sign" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.format(ctx, "$100"), "$100");
}

test "a ZWJ emoji sequence counts as its scalar values" {
    assert.eq("👨‍👩‍👦".len(), 5);
}

test "a combining mark is its own scalar value" {
    assert.eq("é".len(), 2);
}

test "chars reversed and rebuilt reverses by scalar value" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromChars(ctx, "a😀".chars(ctx).reverse(ctx)), "😀a");
}

test "split on a non-BMP separator" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a😀b".split(ctx, "😀"), ["a", "b"]);
}

test "padStart counts the width in scalar values" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("😀".padStart(ctx, 3, '.'), "..😀");
}

// --- core/char ----------------------------------------------------------------

test "isDigit accepts ASCII digits" {
    assert.isTrue('0'.isDigit());
    assert.isTrue('9'.isDigit());
}

test "isDigit rejects letters and punctuation" {
    assert.isFalse('a'.isDigit());
    assert.isFalse('-'.isDigit());
    assert.isFalse(' '.isDigit());
}

test "isAlpha accepts letters" {
    assert.isTrue('a'.isAlpha());
    assert.isTrue('Z'.isAlpha());
}

test "isAlpha rejects digits and punctuation" {
    assert.isFalse('0'.isAlpha());
    assert.isFalse('_'.isAlpha());
}

test "isAlphanumeric accepts both letters and digits" {
    assert.isTrue('a'.isAlphanumeric());
    assert.isTrue('7'.isAlphanumeric());
    assert.isFalse('!'.isAlphanumeric());
}

test "isSpace accepts the whitespace characters" {
    assert.isTrue(' '.isSpace());
    assert.isTrue('\t'.isSpace());
    assert.isTrue('\n'.isSpace());
}

test "isSpace rejects a printing character" {
    assert.isFalse('a'.isSpace());
    assert.isFalse('_'.isSpace());
}

test "isUpper accepts uppercase letters only" {
    assert.isTrue('A'.isUpper());
    assert.isFalse('a'.isUpper());
    assert.isFalse('1'.isUpper());
}

test "isLower accepts lowercase letters only" {
    assert.isTrue('a'.isLower());
    assert.isFalse('A'.isLower());
    assert.isFalse('1'.isLower());
}

test "char toLower lowercases a letter" {
    assert.eq('A'.toLower(), 'a');
}

test "char toLower leaves a non-letter alone" {
    assert.eq('1'.toLower(), '1');
    assert.eq('a'.toLower(), 'a');
}

test "char toUpper uppercases a letter" {
    assert.eq('a'.toUpper(), 'A');
}

test "char toUpper leaves a non-letter alone" {
    assert.eq('1'.toUpper(), '1');
    assert.eq('A'.toUpper(), 'A');
}

test "toU32 yields the code point" {
    assert.eq('A'.toU32(), 65);
    assert.eq('a'.toU32(), 97);
}

test "toU32 of a non-BMP character is its scalar value" {
    assert.eq('😀'.toU32(), 128512);
}

test "toDigit reads a decimal digit" {
    assert.eq(assert.some('7'.toDigit(10)), 7);
}

test "toDigit reads a hex digit" {
    assert.eq(assert.some('f'.toDigit(16)), 15);
    assert.eq(assert.some('F'.toDigit(16)), 15);
}

test "toDigit rejects a digit outside the radix" {
    assert.none('9'.toDigit(8));
}

test "toDigit rejects a non-digit" {
    assert.none('z'.toDigit(10));
}

test "toDigit reads a binary digit" {
    assert.eq(assert.some('1'.toDigit(2)), 1);
    assert.none('2'.toDigit(2));
}

// --- Char ordering and equality -----------------------------------------------

test "chars compare by code point" {
    assert.isTrue('a' < 'b');
    assert.isTrue('A' < 'a');
    assert.eq('a', 'a');
    assert.notEq('a', 'b');
}

// A `Char` is a Unicode scalar value, so `<` on one is its integer order —
// including above the basic multilingual plane, where a JavaScript `<` on the
// one-character string a `Char` is spelled as would answer the other way.
test "chars compare by code point above the basic multilingual plane" {
    assert.isTrue('�' < '😀');
    assert.isTrue('�' < '𐀀');
    assert.isTrue('😀' > '￿');
}

test "order.char compares characters" {
    assert.isTrue(order.char('a', 'b').isLess());
    assert.isTrue(order.char('b', 'b').isEqual());
}

// `order.char` is written as an integer comparison on `toU32`, and `<` is the
// `Ord` conformance. They are two spellings of one order, which is only
// observable where the two candidate orders differ.
test "order.char agrees with the relational operators on astral input" {
    assert.isTrue(order.char('�', '😀').isLess());
    assert.eq(order.char('😀', '�'), Order.Greater);
}

// --- structural equality on strings -------------------------------------------

test "two separately built strings with equal contents are equal" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc", "ab".concat(ctx, "c"));
}

test "string equality is case sensitive" {
    assert.notEq("abc", "ABC");
}

test "strings compare with the relational operators" {
    assert.isTrue("apple" < "banana");
    assert.isTrue("banana" > "apple");
    assert.isTrue("a" <= "a");
    assert.isTrue("a" >= "a");
    // buri-lang/buri#35's own line, and the one that fails if `<` on a `Str`
    // ever goes back to being JavaScript's: there a surrogate pair beginning
    // at U+D800 puts the emoji first.
    assert.isFalse("😀" < "�");
    assert.isTrue("�" < "😀");
}

// --- stripPrefix / stripSuffix --------------------------------------------------

test "stripPrefix takes the prefix off" {
    assert.eq(assert.some("hello".stripPrefix("he")), "llo");
    assert.eq(assert.some("hello".stripPrefix("")), "hello");
    assert.eq(assert.some("hello".stripPrefix("hello")), "");
}

test "stripPrefix refuses a prefix that is not there" {
    assert.none("hello".stripPrefix("x"));
    assert.none("hello".stripPrefix("hello!"));
    assert.none("".stripPrefix("x"));
}

test "stripSuffix takes the suffix off" {
    assert.eq(assert.some("hello".stripSuffix("lo")), "hel");
    assert.eq(assert.some("hello".stripSuffix("")), "hello");
    assert.eq(assert.some("hello".stripSuffix("hello")), "");
    assert.none("hello".stripSuffix("x"));
}

test "stripPrefix and stripSuffix measure in scalars" {
    assert.eq(assert.some("😀ok".stripPrefix("😀")), "ok");
    assert.eq(assert.some("ok😀".stripSuffix("😀")), "ok");
}

// --- lastIndexOf / splitOnceFromEnd / indexOfFrom -------------------------------

test "lastIndexOf finds the last occurrence" {
    assert.eq(assert.some("a.b.c".lastIndexOf(".")), 3);
    assert.eq(assert.some("a.b.c".lastIndexOf("a")), 0);
    assert.none("abc".lastIndexOf("."));
    assert.none("".lastIndexOf("."));
}

test "the empty needle is found at the end" {
    assert.eq(assert.some("abc".lastIndexOf("")), 3);
    assert.eq(assert.some("".lastIndexOf("")), 0);
}

test "lastIndexOf counts scalars, not bytes" {
    assert.eq(assert.some("😀.x".lastIndexOf(".")), 1);
}

test "splitOnceFromEnd splits at the last separator" {
    let tail = assert.some("a.b.c".splitOnceFromEnd("."));
    assert.eq(tail.0, "a.b");
    assert.eq(tail.1, "c");
    let edge = assert.some("a.".splitOnceFromEnd("."));
    assert.eq(edge.0, "a");
    assert.eq(edge.1, "");
    assert.none("abc".splitOnceFromEnd("."));
}

test "indexOfFrom starts the search where it is told" {
    assert.eq(assert.some("abcabc".indexOfFrom("b", 0)), 1);
    assert.eq(assert.some("abcabc".indexOfFrom("b", 2)), 4);
    assert.none("abcabc".indexOfFrom("b", 5));
}

test "indexOfFrom clamps a start below zero and past the end" {
    assert.eq(assert.some("abc".indexOfFrom("a", -3)), 0);
    assert.none("abc".indexOfFrom("a", 99));
}

// --- count ----------------------------------------------------------------------

test "count counts occurrences without overlapping them" {
    assert.eq("aaaa".count("aa"), 2);
    assert.eq("abcabc".count("abc"), 2);
    assert.eq("abc".count("z"), 0);
    assert.eq("".count("a"), 0);
}

test "count of the empty needle is zero" {
    assert.eq("abc".count(""), 0);
    assert.eq("".count(""), 0);
}

// --- trimAny --------------------------------------------------------------------

test "trimAny removes the characters it is given" {
    assert.eq("xxaxx".trimAny("x"), "a");
    assert.eq("xxaxx".trimStartAny("x"), "axx");
    assert.eq("xxaxx".trimEndAny("x"), "xxa");
    assert.eq("--a-b--".trimAny("-"), "a-b");
}

test "trimAny with more than one character removes any of them" {
    assert.eq("[a]".trimAny("[]"), "a");
    assert.eq("0012300".trimAny("0"), "123");
}

test "trimAny removes nothing when it matches nothing" {
    assert.eq("abc".trimAny("xyz"), "abc");
    assert.eq("abc".trimAny(""), "abc");
    assert.eq("".trimAny("x"), "");
}

test "trimAny of a string that is all of them is empty" {
    assert.eq("xxx".trimAny("x"), "");
    assert.eq("xxx".trimStartAny("x"), "");
    assert.eq("xxx".trimEndAny("x"), "");
}

// --- indexOfAny / indexWhere / isBlank ------------------------------------------

test "indexOfAny finds the first of any of them" {
    assert.eq(assert.some("abc".indexOfAny("cb")), 1);
    assert.eq(assert.some("abc".indexOfAny("a")), 0);
    assert.none("abc".indexOfAny("xyz"));
    assert.none("abc".indexOfAny(""));
    assert.none("".indexOfAny("a"));
}

test "indexWhere finds the first scalar the predicate accepts" {
    assert.eq(assert.some("a1b".indexWhere(fn(c) => c.isDigit())), 1);
    assert.none("abc".indexWhere(fn(c) => c.isDigit()));
    assert.none("".indexWhere(fn(c) => c.isDigit()));
}

test "isBlank is empty or whitespace" {
    assert.isTrue("".isBlank());
    assert.isTrue("   ".isBlank());
    assert.isTrue(" \t\n ".isBlank());
    assert.isFalse(" a ".isBlank());
}

// --- equalsIgnoreCase / startsWithIgnoreCase -------------------------------------

test "equalsIgnoreCase ignores case" {
    assert.isTrue("HeLLo".equalsIgnoreCase("hello"));
    assert.isTrue("".equalsIgnoreCase(""));
    assert.isFalse("hello".equalsIgnoreCase("hell"));
    assert.isFalse("hello".equalsIgnoreCase("world"));
}

// Simple folding is one scalar for one, so the German sharp s is not "ss" here.
// `caseFold` is the full folding that says it is.
test "equalsIgnoreCase is simple folding, not full" {
    assert.isFalse("straße".equalsIgnoreCase("strasse"));
    assert.isTrue("STRASSE".equalsIgnoreCase("strasse"));
}

test "startsWithIgnoreCase folds the prefix too" {
    assert.isTrue("HeLLo".startsWithIgnoreCase("hel"));
    assert.isTrue("hello".startsWithIgnoreCase(""));
    assert.isFalse("hi".startsWithIgnoreCase("hello"));
    assert.isFalse("hello".startsWithIgnoreCase("x"));
}

// --- splitLimit -----------------------------------------------------------------

test "splitLimit stops at the limit and keeps the rest whole" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a:b:c".splitLimit(ctx, ":", 2), ["a", "b:c"]);
    assert.eq("a:b:c".splitLimit(ctx, ":", 1), ["a:b:c"]);
    assert.eq("a:b:c".splitLimit(ctx, ":", 9), ["a", "b", "c"]);
}

test "splitLimit at or below zero has no pieces" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isEmpty("a:b".splitLimit(ctx, ":", 0));
    assert.isEmpty("a:b".splitLimit(ctx, ":", -1));
}

test "splitLimit of a string without the separator is the whole of it" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".splitLimit(ctx, ":", 3), ["abc"]);
    assert.eq("".splitLimit(ctx, ":", 3), [""]);
}

// --- replaceFirst / reverse ------------------------------------------------------

test "replaceFirst replaces one occurrence" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("aba".replaceFirst(ctx, "a", "z"), "zba");
    assert.eq("aba".replaceFirst(ctx, "b", "z"), "aza");
    assert.eq("aba".replaceFirst(ctx, "x", "z"), "aba");
    assert.eq("aba".replaceFirst(ctx, "a", ""), "ba");
}

test "replaceFirst with an empty needle changes nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".replaceFirst(ctx, "", "z"), "abc");
    assert.eq("".replaceFirst(ctx, "a", "z"), "");
}

test "reverse turns the scalars around" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".reverse(ctx), "cba");
    assert.eq("a".reverse(ctx), "a");
    assert.eq("".reverse(ctx), "");
    assert.eq("a😀b".reverse(ctx), "b😀a");
}

// --- words ----------------------------------------------------------------------

test "words drops every empty piece" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("  one  two ".words(ctx), ["one", "two"]);
    assert.eq("one".words(ctx), ["one"]);
    assert.eq("a\tb\nc".words(ctx), ["a", "b", "c"]);
}

test "words of blank text is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isEmpty("".words(ctx));
    assert.isEmpty("   ".words(ctx));
}

// --- utf8Length / utf16Length ----------------------------------------------------

test "utf8Length counts the bytes UTF-8 would write" {
    assert.eq("abc".utf8Length(), 3);
    assert.eq("héllo".utf8Length(), 6);
    assert.eq("あ".utf8Length(), 3);
    assert.eq("😀".utf8Length(), 4);
    assert.eq("".utf8Length(), 0);
}

test "utf16Length counts code units, and len counts scalars" {
    assert.eq("abc".utf16Length(), 3);
    assert.eq("😀".utf16Length(), 2);
    assert.eq("😀".len(), 1);
    assert.eq("a😀b".utf16Length(), 4);
    assert.eq("".utf16Length(), 0);
}

// --- dedent / indent / wrap -------------------------------------------------------

test "dedent removes the common margin" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("    one\n      two".dedent(ctx), "one\n  two");
    assert.eq("one\n  two".dedent(ctx), "one\n  two");
    assert.eq("".dedent(ctx), "");
}

test "dedent ignores a blank line and empties it" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("  a\n\n  b".dedent(ctx), "a\n\nb");
    assert.eq("  a\n   \n  b".dedent(ctx), "a\n\nb");
}

test "indent puts the prefix on every line that has anything on it" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a\nb".indent(ctx, "> "), "> a\n> b");
    assert.eq("a\n\nb".indent(ctx, "> "), "> a\n\n> b");
    assert.eq("".indent(ctx, "> "), "");
}

test "wrap fills lines greedily" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("a bb ccc".wrap(ctx, 5), ["a bb", "ccc"]);
    assert.eq("a b c".wrap(ctx, 99), ["a b c"]);
    assert.isEmpty("".wrap(ctx, 5));
}

test "wrap gives a word longer than the width a line of its own" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("aa bbbbbb cc".wrap(ctx, 4), ["aa", "bbbbbb", "cc"]);
    assert.eq("aa bb".wrap(ctx, 0), ["aa", "bb"]);
}

// --- fromIntGrouped ---------------------------------------------------------------

test "fromIntGrouped groups three digits at a time" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromIntGrouped(ctx, 1234567, ","), "1,234,567");
    assert.eq(str.fromIntGrouped(ctx, 1000, ","), "1,000");
    assert.eq(str.fromIntGrouped(ctx, 100, ","), "100");
    assert.eq(str.fromIntGrouped(ctx, 0, ","), "0");
}

test "fromIntGrouped keeps the sign outside the groups" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromIntGrouped(ctx, -1234, ","), "-1,234");
    assert.eq(str.fromIntGrouped(ctx, -1, ","), "-1");
}

test "fromIntGrouped takes any separator" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromIntGrouped(ctx, 1234, " "), "1 234");
    assert.eq(str.fromIntGrouped(ctx, 1234, ""), "1234");
}

// --- fromFloatFixed ---------------------------------------------------------------

test "fromFloatFixed keeps the number of digits asked for" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloatFixed(ctx, 3.14159, 2), "3.14");
    assert.eq(str.fromFloatFixed(ctx, 2.0, 3), "2.000");
    assert.eq(str.fromFloatFixed(ctx, 0.5, 0), "1");
    assert.eq(str.fromFloatFixed(ctx, 0.0, 2), "0.00");
}

test "fromFloatFixed rounds half away from zero" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloatFixed(ctx, 2.5, 0), "3");
    assert.eq(str.fromFloatFixed(ctx, -2.5, 0), "-3");
    assert.eq(str.fromFloatFixed(ctx, 0.06, 1), "0.1");
    assert.eq(str.fromFloatFixed(ctx, -1.25, 1), "-1.3");
}

test "fromFloatFixed carries a nine off the front" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloatFixed(ctx, 9.99, 1), "10.0");
    assert.eq(str.fromFloatFixed(ctx, 0.999, 2), "1.00");
    assert.eq(str.fromFloatFixed(ctx, 9.9, 0), "10");
}

test "fromFloatFixed expands what fromFloat writes with an exponent" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloatFixed(ctx, 0.0000006, 8), "0.00000060");
    assert.eq(str.fromFloatFixed(ctx, 0.0000006, 2), "0.00");
    assert.eq(str.fromFloatFixed(ctx, 1e21, 0), "1000000000000000000000");
}

test "fromFloatFixed treats a negative count of decimals as none" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloatFixed(ctx, 3.7, -1), "4");
}

test "fromFloatFixed hands back what has no digits" {
    let ctx = context {
        Alloc: alloc(),
    };
    let nan = 0.0 / 0.0;
    let up = 1.0 / 0.0;
    assert.eq(str.fromFloatFixed(ctx, nan, 2), str.fromFloat(ctx, nan));
    assert.eq(str.fromFloatFixed(ctx, up, 2), str.fromFloat(ctx, up));
    assert.eq(str.fromFloatFixed(ctx, -up, 2), str.fromFloat(ctx, -up));
}
