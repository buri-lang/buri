// core/str and core/character — SPEC 3.5, 3.6, 11.1.
//
// The load-bearing claim here is that `Str` is measured in Unicode scalar
// values, not UTF-8 bytes and not UTF-16 code units, so every length, index,
// and slice test below uses a non-BMP character somewhere.

from "core/character" import * as character;
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/order" import * as order;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// --- length ----------------------------------------------------------------------

test "length counts characters in ASCII" {
    assert.equal("hello".length(), 5);
}

test "length of the empty string is zero" {
    assert.equal("".length(), 0);
}

test "length counts scalar values, not UTF-8 bytes" {
    // "é" is two UTF-8 bytes and one scalar value.
    assert.equal("é".length(), 1);
}

test "length counts a non-BMP character as one, not two" {
    // U+1F600 is four UTF-8 bytes and two UTF-16 code units. It is one scalar.
    assert.equal("😀".length(), 1);
}

test "length of a mixed string counts scalar values" {
    assert.equal("a😀b".length(), 3);
}

test "length of a string of only non-BMP characters" {
    assert.equal("😀😁😂".length(), 3);
}

test "isEmpty is true only for the empty string" {
    assert.isTrue("".isEmpty());
    assert.isFalse(" ".isEmpty());
}

// --- charAt -------------------------------------------------------------------

test "charAt yields the character at an index" {
    assert.equal(assert.some("abc".charAt(1)), 'b');
}

test "charAt at zero yields the first character" {
    assert.equal(assert.some("abc".charAt(0)), 'a');
}

test "charAt past the end yields None" {
    assert.none("abc".charAt(3));
}

test "charAt at a negative index yields None" {
    assert.none("abc".charAt(-1));
}

test "charAt on the empty string yields None" {
    assert.none("".charAt(0));
}

test "charAt indexes by scalar value" {
    assert.equal(assert.some("a😀b".charAt(1)), '😀');
    assert.equal(assert.some("a😀b".charAt(2)), 'b');
}

test "charAt past a non-BMP string is None" {
    assert.none("😀".charAt(1));
}

// --- slice --------------------------------------------------------------------

test "slice takes a half-open range" {
    assert.equal("hello".slice(1, 3), "el");
}

test "slice with equal bounds is empty" {
    assert.equal("hello".slice(2, 2), "");
}

test "slice covering everything is the whole string" {
    assert.equal("hello".slice(0, 5), "hello");
}

test "slice clamps past the end" {
    assert.equal("hello".slice(3, 99), "lo");
}

test "slice with an inverted range is empty" {
    assert.equal("hello".slice(3, 1), "");
}

test "slice on the empty string is empty" {
    assert.equal("".slice(0, 3), "");
}

test "slice cuts on scalar boundaries" {
    assert.equal("a😀b".slice(1, 2), "😀");
    assert.equal("a😀b".slice(2, 3), "b");
}

// --- trim ---------------------------------------------------------------------

test "trim removes leading and trailing whitespace" {
    assert.equal("  hi  ".trim(), "hi");
}

test "trim leaves interior whitespace alone" {
    assert.equal("  a b  ".trim(), "a b");
}

test "trim of an all-whitespace string is empty" {
    assert.equal("   ".trim(), "");
}

test "trim of the empty string is empty" {
    assert.equal("".trim(), "");
}

test "trim handles tabs and newlines" {
    assert.equal("\t\nhi\n\t".trim(), "hi");
}

test "trimStart removes only leading whitespace" {
    assert.equal("  hi  ".trimStart(), "hi  ");
}

test "trimStart on a string with no leading space is the identity" {
    assert.equal("hi  ".trimStart(), "hi  ");
}

test "trimEnd removes only trailing whitespace" {
    assert.equal("  hi  ".trimEnd(), "  hi");
}

test "trimEnd on a string with no trailing space is the identity" {
    assert.equal("  hi".trimEnd(), "  hi");
}

// --- startsWith / endsWith / contains -----------------------------------------

test "startsWith accepts a prefix" {
    assert.isTrue("hello".startsWith("he"));
}

test "startsWith rejects a non-prefix" {
    assert.isFalse("hello".startsWith("lo"));
}

test "startsWith accepts the whole string" {
    assert.isTrue("hello".startsWith("hello"));
}

test "startsWith the empty prefix is true" {
    assert.isTrue("hello".startsWith(""));
    assert.isTrue("".startsWith(""));
}

test "startsWith a longer needle is false" {
    assert.isFalse("hi".startsWith("hiya"));
}

test "endsWith accepts a suffix" {
    assert.isTrue("hello".endsWith("lo"));
}

test "endsWith rejects a non-suffix" {
    assert.isFalse("hello".endsWith("he"));
}

test "endsWith the empty suffix is true" {
    assert.isTrue("hello".endsWith(""));
}

test "endsWith a longer needle is false" {
    assert.isFalse("hi".endsWith("ohi"));
}

test "contains finds an interior needle" {
    assert.isTrue("hello".contains("ell"));
}

test "contains rejects an absent needle" {
    assert.isFalse("hello".contains("xyz"));
}

test "contains the empty needle is true" {
    assert.isTrue("hello".contains(""));
    assert.isTrue("".contains(""));
}

test "contains on the empty string rejects a nonempty needle" {
    assert.isFalse("".contains("a"));
}

// --- indexOf ------------------------------------------------------------------

test "indexOf yields the first occurrence" {
    assert.equal(assert.some("banana".indexOf("na")), 2);
}

test "indexOf at the start is zero" {
    assert.equal(assert.some("banana".indexOf("ba")), 0);
}

test "indexOf an absent needle is None" {
    assert.none("banana".indexOf("xyz"));
}

test "indexOf on the empty string is None for a nonempty needle" {
    assert.none("".indexOf("a"));
}

test "indexOf counts in scalar values" {
    assert.equal(assert.some("😀ab".indexOf("b")), 2);
}

// --- splitOnce ----------------------------------------------------------------

test "splitOnce yields both halves when the separator is present" {
    let parts = assert.some("key=value".splitOnce("="));
    assert.equal(parts.0, "key");
    assert.equal(parts.1, "value");
}

test "splitOnce splits at the first occurrence only" {
    let parts = assert.some("a=b=c".splitOnce("="));
    assert.equal(parts.0, "a");
    assert.equal(parts.1, "b=c");
}

test "splitOnce with a leading separator yields an empty left half" {
    let parts = assert.some("=v".splitOnce("="));
    assert.equal(parts.0, "");
    assert.equal(parts.1, "v");
}

test "splitOnce with a trailing separator yields an empty right half" {
    let parts = assert.some("k=".splitOnce("="));
    assert.equal(parts.0, "k");
    assert.equal(parts.1, "");
}

test "splitOnce yields None when the separator is absent" {
    assert.none("keyvalue".splitOnce("="));
}

test "splitOnce on the empty string yields None" {
    assert.none("".splitOnce("="));
}

test "splitOnce with a multi-character separator" {
    let parts = assert.some("a::b".splitOnce("::"));
    assert.equal(parts.0, "a");
    assert.equal(parts.1, "b");
}

// --- compare ------------------------------------------------------------------

test "compare reports Less" {
    assert.isTrue("apple".compare("banana").isLess());
}

test "compare reports Equal" {
    assert.isTrue("apple".compare("apple").isEqual());
}

test "compare reports Greater" {
    assert.equal("banana".compare("apple"), Order.Greater);
}

test "compare orders a prefix before its extension" {
    assert.isTrue("app".compare("apple").isLess());
}

test "compare orders the empty string first" {
    assert.isTrue("".compare("a").isLess());
    assert.isTrue("".compare("").isEqual());
}

// The order is **Unicode scalar value**, which for a valid string is UTF-8 byte
// order — the unit `length` counts and `charAt` hands back. Every case above is
// ASCII, where all three candidate orders agree; these are the ones that
// discriminate, and they are the whole of what `core/str`'s `compare` promises
// beyond "lexicographic".
//
// A JavaScript string is UTF-16 and `<` on one orders code units, so an astral
// scalar — a surrogate pair beginning at U+D800 — sorts *below* U+E000..U+FFFF
// there. Buri says the opposite on both backends, so these cases are also what
// stops the JavaScript backend quietly reverting to `<`.
//
// U+FFFD (�) is the character from that band these use, because it is one a
// reader can see. buri-lang/buri#35 reports the same thing about U+E000, which
// is in the same band, sorts the same way, and is a private-use character with
// no glyph — and a test whose subject is invisible in its own source is a test
// nobody can check. The formatter writes a printable scalar as itself rather
// than as an escape, so `\u{e000}` is not available as a spelling.

test "compare orders an astral character above the top of the plane" {
    // U+FFFD is 65533 and U+1F600 is 128512, so the emoji sorts above it.
    // Every scalar in U+E000..U+FFFF answers the same way, and JavaScript's
    // `<` answers the opposite for all of them.
    assert.isTrue("�".compare("😀").isLess());
    assert.equal("😀".compare("�"), Order.Greater);
}

test "compare orders across the first astral scalar" {
    // U+10000 is the lowest scalar written as a surrogate pair, so this is the
    // pair the two candidate orders disagree about by the smallest margin
    // there is.
    assert.isTrue("�".compare("𐀀").isLess());
    assert.equal("𐀀".compare("�"), Order.Greater);
}

test "compare decides past a shared prefix" {
    assert.isTrue("x�y".compare("x😀y").isLess());
    assert.isTrue("😀a".compare("😀b").isLess());
}

test "compare orders a non-ASCII prefix before its extension" {
    assert.isTrue("😀".compare("😀a").isLess());
}

// --- toInt / toFloat ----------------------------------------------------------

test "toInt parses a decimal integer" {
    assert.equal(assert.some("42".toInt()), 42);
}

test "toInt parses a negative integer" {
    assert.equal(assert.some("-42".toInt()), -42);
}

test "toInt parses zero" {
    assert.equal(assert.some("0".toInt()), 0);
}

test "toInt rejects a non-numeric string" {
    assert.none("abc".toInt());
}

test "toInt rejects the empty string" {
    assert.none("".toInt());
}

test "toInt rejects trailing junk" {
    assert.none("42x".toInt());
}

test "toInt rejects a float" {
    assert.none("4.2".toInt());
}

test "toInt rejects a lone minus" {
    assert.none("-".toInt());
}

test "toInt parses a value on either side of zero" {
    assert.equal(assert.some("9007199254740991".toInt()), 9007199254740991);
    assert.equal(assert.some("-9007199254740991".toInt()), -9007199254740991);
}

test "toInt parses every I64, and refuses what is not one" {
    // `Int` is `I64` on every backend and holds its whole range, so the only
    // string refused here is one naming a number that is not an `I64` at all.
    assert.equal(assert.some("9007199254740992".toInt()), 9007199254740992);
    assert.equal(assert.some("9223372036854775807".toInt()), 9223372036854775807);
    assert.equal(assert.some("-9223372036854775808".toInt()), -9223372036854775808);
    assert.none("9223372036854775808".toInt());
}

test "toInt rejects a value far outside I64" {
    assert.none("99999999999999999999".toInt());
}

test "toFloat parses a decimal" {
    assert.equal(assert.some("3.5".toFloat()), 3.5);
}

test "toFloat parses a negative decimal" {
    assert.equal(assert.some("-3.5".toFloat()), -3.5);
}

test "toFloat parses an integer-shaped string" {
    assert.equal(assert.some("4".toFloat()), 4.0);
}

test "toFloat rejects a non-numeric string" {
    assert.none("abc".toFloat());
}

test "toFloat rejects the empty string" {
    assert.none("".toFloat());
}

// --- concat -------------------------------------------------------------------

test "concat joins two strings" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("foo".concat(ctx, "bar"), "foobar");
}

test "concat with the empty string is the identity" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("foo".concat(ctx, ""), "foo");
    assert.equal("".concat(ctx, "bar"), "bar");
}

test "concat of two empty strings is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".concat(ctx, ""), "");
}

// --- split / splitAny / lines -------------------------------------------------

test "split cuts on every occurrence" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a,b,c".split(ctx, ","), ["a", "b", "c"]);
}

test "split keeps empty pieces" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a,,b".split(ctx, ","), ["a", "", "b"]);
}

test "split keeps a leading and trailing empty piece" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(",a,".split(ctx, ","), ["", "a", ""]);
}

test "split with an absent separator yields the whole string" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".split(ctx, ","), ["abc"]);
}

test "split of the empty string yields one empty piece" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".split(ctx, ","), [""]);
}

test "split on a multi-character separator" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a::b::c".split(ctx, "::"), ["a", "b", "c"]);
}

test "splitAny cuts on any of the separator characters" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a,b;c".splitAny(ctx, ",;"), ["a", "b", "c"]);
}

test "splitAny drops empty pieces" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a,,b".splitAny(ctx, ","), ["a", "b"]);
}

test "splitAny drops leading and trailing empties" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(",a,".splitAny(ctx, ","), ["a"]);
}

test "splitAny of the empty string is the empty list" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".splitAny(ctx, ","), list.empty<Str>());
}

test "splitAny splits on whitespace" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("  a  b  ".splitAny(ctx, " "), ["a", "b"]);
}

test "lines splits on newlines" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a\nb\nc".lines(ctx), ["a", "b", "c"]);
}

test "lines of a single line is a singleton" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("only".lines(ctx), ["only"]);
}

test "lines keeps blank lines" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a\n\nb".lines(ctx), ["a", "", "b"]);
}

test "lines of a string ending in a newline yields a trailing empty piece" {
    // SPEC does not fix `lines`; this pins what the implementation does, which
    // is the `split`-like reading rather than the "drop the final empty" one.
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a\n".lines(ctx), ["a", ""]);
}

// --- replace ------------------------------------------------------------------

test "replace substitutes every occurrence" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("banana".replace(ctx, "a", "o"), "bonono");
}

test "replace with an absent needle is the identity" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("banana".replace(ctx, "z", "o"), "banana");
}

test "replace can delete" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("banana".replace(ctx, "na", ""), "ba");
}

test "replace can lengthen" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ab".replace(ctx, "b", "bbb"), "abbb");
}

test "replace on the empty string is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".replace(ctx, "a", "b"), "");
}

// --- repeat -------------------------------------------------------------------

test "repeat concatenates n copies" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ab".repeat(ctx, 3), "ababab");
}

test "repeat once is the identity" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ab".repeat(ctx, 1), "ab");
}

test "repeat zero times is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ab".repeat(ctx, 0), "");
}

test "repeat a negative number of times is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ab".repeat(ctx, -2), "");
}

test "repeating the empty string is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".repeat(ctx, 5), "");
}

// --- toUpper / toLower --------------------------------------------------------

test "toUpper uppercases ASCII" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("hello".toUpper(ctx), "HELLO");
}

test "toUpper leaves non-letters alone" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a1-b".toUpper(ctx), "A1-B");
}

test "toUpper of the empty string is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".toUpper(ctx), "");
}

test "toLower lowercases ASCII" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("HELLO".toLower(ctx), "hello");
}

test "toLower of the empty string is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".toLower(ctx), "");
}

test "toLower then toUpper round-trips ASCII" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("MiXeD".toLower(ctx).toUpper(ctx), "MIXED");
}

// --- chars / fromChars --------------------------------------------------------

test "chars explodes a string into scalar values" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".chars(ctx), ['a', 'b', 'c']);
}

test "chars of the empty string is the empty list" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".chars(ctx), list.empty<Char>());
}

test "chars yields one element per non-BMP character" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a😀".chars(ctx), ['a', '😀']);
}

test "chars length agrees with length" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a😀b".chars(ctx).length(), "a😀b".length());
}

test "fromChars rebuilds a string" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromChars(ctx, ['a', 'b', 'c']), "abc");
}

test "fromChars of the empty list is the empty string" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromChars(ctx, list.empty<Char>()), "");
}

test "fromChars round-trips chars" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromChars(ctx, "a😀b".chars(ctx)), "a😀b");
}

// --- fromInt / fromFloat ------------------------------------------------------

test "fromInt renders a positive integer" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromInt(ctx, 42), "42");
}

test "fromInt renders zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromInt(ctx, 0), "0");
}

test "fromInt renders a negative integer" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromInt(ctx, -7), "-7");
}

test "fromInt round-trips through toInt" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.some(str.fromInt(ctx, -1234).toInt()), -1234);
}

test "fromFloat round-trips through toFloat" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.some(str.fromFloat(ctx, 3.5).toFloat()), 3.5);
}

test "fromFloat renders a negative float" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.some(str.fromFloat(ctx, -0.25).toFloat()), -0.25);
}

// --- padStart / padEnd --------------------------------------------------------

test "padStart pads on the left" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("7".padStart(ctx, 3, '0'), "007");
}

test "padStart leaves a long-enough string alone" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("12345".padStart(ctx, 3, '0'), "12345");
}

test "padStart to the exact width is the identity" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".padStart(ctx, 3, ' '), "abc");
}

test "padStart of the empty string fills entirely" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".padStart(ctx, 2, 'x'), "xx");
}

test "padEnd pads on the right" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("7".padEnd(ctx, 3, '0'), "700");
}

test "padEnd leaves a long-enough string alone" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("12345".padEnd(ctx, 3, '0'), "12345");
}

test "padEnd measures the width in scalar values" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("😀".padEnd(ctx, 3, '.'), "😀..");
}

// --- format -------------------------------------------------------------------

test "format renders a template with no holes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.format(ctx, "plain"), "plain");
}

test "format interpolates an Int" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 7;
    assert.equal(str.format(ctx, "n = ${n}"), "n = 7");
}

test "format interpolates a Str" {
    let ctx = context {
        Allocator: alloc(),
    };
    let who = "world";
    assert.equal(str.format(ctx, "hello ${who}"), "hello world");
}

test "format interpolates a Bool" {
    let ctx = context {
        Allocator: alloc(),
    };
    let b = true;
    assert.equal(str.format(ctx, "${b}"), "true");
}

// `Bool.toStr` is what a hole writes, and there are exactly two answers.
test "a Bool spells itself the way interpolation does" {
    let ctx = context {
        Allocator: alloc(),
    };
    let yes = true;
    let no = false;
    assert.equal(yes.toStr(), "true");
    assert.equal(no.toStr(), "false");
    assert.equal(str.format(ctx, "${no}"), no.toStr());
}

test "format interpolates a Char" {
    let ctx = context {
        Allocator: alloc(),
    };
    let c = 'x';
    assert.equal(str.format(ctx, "[${c}]"), "[x]");
}

test "format interpolates several holes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = 1;
    let b = 2;
    assert.equal(str.format(ctx, "${a}+${b}=${a + b}"), "1+2=3");
}

test "format evaluates an expression hole" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.format(ctx, "${2 * 21}"), "42");
}

test "format escapes a literal dollar sign" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.format(ctx, "$100"), "$100");
}

test "a ZWJ emoji sequence counts as its scalar values" {
    assert.equal("👨‍👩‍👦".length(), 5);
}

test "a combining mark is its own scalar value" {
    assert.equal("é".length(), 2);
}

test "chars reversed and rebuilt reverses by scalar value" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromChars(ctx, "a😀".chars(ctx).reverse(ctx)), "😀a");
}

test "split on a non-BMP separator" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a😀b".split(ctx, "😀"), ["a", "b"]);
}

test "padStart counts the width in scalar values" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("😀".padStart(ctx, 3, '.'), "..😀");
}

// --- core/character ----------------------------------------------------------

test "isDigit accepts ASCII digits" {
    assert.isTrue('0'.isDigit());
    assert.isTrue('9'.isDigit());
}

test "isDigit rejects letters and punctuation" {
    assert.isFalse('a'.isDigit());
    assert.isFalse('-'.isDigit());
    assert.isFalse(' '.isDigit());
}

test "isAlpha accepts letters" {
    assert.isTrue('a'.isAlpha());
    assert.isTrue('Z'.isAlpha());
}

test "isAlpha rejects digits and punctuation" {
    assert.isFalse('0'.isAlpha());
    assert.isFalse('_'.isAlpha());
}

test "isAlphanumeric accepts both letters and digits" {
    assert.isTrue('a'.isAlphanumeric());
    assert.isTrue('7'.isAlphanumeric());
    assert.isFalse('!'.isAlphanumeric());
}

test "isSpace accepts the whitespace characters" {
    assert.isTrue(' '.isSpace());
    assert.isTrue('\t'.isSpace());
    assert.isTrue('\n'.isSpace());
}

test "isSpace rejects a printing character" {
    assert.isFalse('a'.isSpace());
    assert.isFalse('_'.isSpace());
}

test "isUpper accepts uppercase letters only" {
    assert.isTrue('A'.isUpper());
    assert.isFalse('a'.isUpper());
    assert.isFalse('1'.isUpper());
}

test "isLower accepts lowercase letters only" {
    assert.isTrue('a'.isLower());
    assert.isFalse('A'.isLower());
    assert.isFalse('1'.isLower());
}

test "char toLower lowercases a letter" {
    assert.equal('A'.toLower(), 'a');
}

test "char toLower leaves a non-letter alone" {
    assert.equal('1'.toLower(), '1');
    assert.equal('a'.toLower(), 'a');
}

test "char toUpper uppercases a letter" {
    assert.equal('a'.toUpper(), 'A');
}

test "char toUpper leaves a non-letter alone" {
    assert.equal('1'.toUpper(), '1');
    assert.equal('A'.toUpper(), 'A');
}

test "toU32 yields the code point" {
    assert.equal('A'.toU32(), 65);
    assert.equal('a'.toU32(), 97);
}

test "toU32 of a non-BMP character is its scalar value" {
    assert.equal('😀'.toU32(), 128512);
}

test "toDigit reads a decimal digit" {
    assert.equal(assert.some('7'.toDigit(10)), 7);
}

test "toDigit reads a hex digit" {
    assert.equal(assert.some('f'.toDigit(16)), 15);
    assert.equal(assert.some('F'.toDigit(16)), 15);
}

test "toDigit rejects a digit outside the radix" {
    assert.none('9'.toDigit(8));
}

test "toDigit rejects a non-digit" {
    assert.none('z'.toDigit(10));
}

test "toDigit reads a binary digit" {
    assert.equal(assert.some('1'.toDigit(2)), 1);
    assert.none('2'.toDigit(2));
}

// --- Char ordering and equality -----------------------------------------------

test "chars compare by code point" {
    assert.isTrue('a' < 'b');
    assert.isTrue('A' < 'a');
    assert.equal('a', 'a');
    assert.notEqual('a', 'b');
}

// A `Char` is a Unicode scalar value, so `<` on one is its integer order —
// including above the basic multilingual plane, where a JavaScript `<` on the
// one-character string a `Char` is spelled as would answer the other way.
test "chars compare by code point above the basic multilingual plane" {
    assert.isTrue('�' < '😀');
    assert.isTrue('�' < '𐀀');
    assert.isTrue('😀' > '￿');
}

test "order.char compares characters" {
    assert.isTrue(order.char('a', 'b').isLess());
    assert.isTrue(order.char('b', 'b').isEqual());
}

// `order.char` is written as an integer comparison on `toU32`, and `<` is the
// `Ordered` conformance. They are two spellings of one order, which is only
// observable where the two candidate orders differ.
test "order.char agrees with the relational operators on astral input" {
    assert.isTrue(order.char('�', '😀').isLess());
    assert.equal(order.char('😀', '�'), Order.Greater);
}

// --- structural equality on strings -------------------------------------------

test "two separately built strings with equal contents are equal" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc", "ab".concat(ctx, "c"));
}

test "string equality is case sensitive" {
    assert.notEqual("abc", "ABC");
}

test "strings compare with the relational operators" {
    assert.isTrue("apple" < "banana");
    assert.isTrue("banana" > "apple");
    assert.isTrue("a" <= "a");
    assert.isTrue("a" >= "a");
    // buri-lang/buri#35's own line, and the one that fails if `<` on a `Str`
    // ever goes back to being JavaScript's: there a surrogate pair beginning
    // at U+D800 puts the emoji first.
    assert.isFalse("😀" < "�");
    assert.isTrue("�" < "😀");
}

// --- stripPrefix / stripSuffix --------------------------------------------------

test "stripPrefix takes the prefix off" {
    assert.equal(assert.some("hello".stripPrefix("he")), "llo");
    assert.equal(assert.some("hello".stripPrefix("")), "hello");
    assert.equal(assert.some("hello".stripPrefix("hello")), "");
}

test "stripPrefix refuses a prefix that is not there" {
    assert.none("hello".stripPrefix("x"));
    assert.none("hello".stripPrefix("hello!"));
    assert.none("".stripPrefix("x"));
}

test "stripSuffix takes the suffix off" {
    assert.equal(assert.some("hello".stripSuffix("lo")), "hel");
    assert.equal(assert.some("hello".stripSuffix("")), "hello");
    assert.equal(assert.some("hello".stripSuffix("hello")), "");
    assert.none("hello".stripSuffix("x"));
}

test "stripPrefix and stripSuffix measure in scalars" {
    assert.equal(assert.some("😀ok".stripPrefix("😀")), "ok");
    assert.equal(assert.some("ok😀".stripSuffix("😀")), "ok");
}

// --- lastIndexOf / splitOnceFromEnd / indexOfFrom -------------------------------

test "lastIndexOf finds the last occurrence" {
    assert.equal(assert.some("a.b.c".lastIndexOf(".")), 3);
    assert.equal(assert.some("a.b.c".lastIndexOf("a")), 0);
    assert.none("abc".lastIndexOf("."));
    assert.none("".lastIndexOf("."));
}

test "the empty needle is found at the end" {
    assert.equal(assert.some("abc".lastIndexOf("")), 3);
    assert.equal(assert.some("".lastIndexOf("")), 0);
}

test "lastIndexOf counts scalars, not bytes" {
    assert.equal(assert.some("😀.x".lastIndexOf(".")), 1);
}

test "splitOnceFromEnd splits at the last separator" {
    let tail = assert.some("a.b.c".splitOnceFromEnd("."));
    assert.equal(tail.0, "a.b");
    assert.equal(tail.1, "c");
    let edge = assert.some("a.".splitOnceFromEnd("."));
    assert.equal(edge.0, "a");
    assert.equal(edge.1, "");
    assert.none("abc".splitOnceFromEnd("."));
}

test "indexOfFrom starts the search where it is told" {
    assert.equal(assert.some("abcabc".indexOfFrom("b", 0)), 1);
    assert.equal(assert.some("abcabc".indexOfFrom("b", 2)), 4);
    assert.none("abcabc".indexOfFrom("b", 5));
}

test "indexOfFrom clamps a start below zero and past the end" {
    assert.equal(assert.some("abc".indexOfFrom("a", -3)), 0);
    assert.none("abc".indexOfFrom("a", 99));
}

// --- count ----------------------------------------------------------------------

test "count counts occurrences without overlapping them" {
    assert.equal("aaaa".count("aa"), 2);
    assert.equal("abcabc".count("abc"), 2);
    assert.equal("abc".count("z"), 0);
    assert.equal("".count("a"), 0);
}

test "count of the empty needle is zero" {
    assert.equal("abc".count(""), 0);
    assert.equal("".count(""), 0);
}

// --- trimAny --------------------------------------------------------------------

test "trimAny removes the characters it is given" {
    assert.equal("xxaxx".trimAny("x"), "a");
    assert.equal("xxaxx".trimStartAny("x"), "axx");
    assert.equal("xxaxx".trimEndAny("x"), "xxa");
    assert.equal("--a-b--".trimAny("-"), "a-b");
}

test "trimAny with more than one character removes any of them" {
    assert.equal("[a]".trimAny("[]"), "a");
    assert.equal("0012300".trimAny("0"), "123");
}

test "trimAny removes nothing when it matches nothing" {
    assert.equal("abc".trimAny("xyz"), "abc");
    assert.equal("abc".trimAny(""), "abc");
    assert.equal("".trimAny("x"), "");
}

test "trimAny of a string that is all of them is empty" {
    assert.equal("xxx".trimAny("x"), "");
    assert.equal("xxx".trimStartAny("x"), "");
    assert.equal("xxx".trimEndAny("x"), "");
}

// --- indexOfAny / indexWhere / isBlank ------------------------------------------

test "indexOfAny finds the first of any of them" {
    assert.equal(assert.some("abc".indexOfAny("cb")), 1);
    assert.equal(assert.some("abc".indexOfAny("a")), 0);
    assert.none("abc".indexOfAny("xyz"));
    assert.none("abc".indexOfAny(""));
    assert.none("".indexOfAny("a"));
}

test "indexWhere finds the first scalar the predicate accepts" {
    assert.equal(assert.some("a1b".indexWhere(fn(c) => c.isDigit())), 1);
    assert.none("abc".indexWhere(fn(c) => c.isDigit()));
    assert.none("".indexWhere(fn(c) => c.isDigit()));
}

test "isBlank is empty or whitespace" {
    assert.isTrue("".isBlank());
    assert.isTrue("   ".isBlank());
    assert.isTrue(" \t\n ".isBlank());
    assert.isFalse(" a ".isBlank());
}

// --- equalsIgnoreCase / startsWithIgnoreCase -------------------------------------

test "equalsIgnoreCase ignores case" {
    assert.isTrue("HeLLo".equalsIgnoreCase("hello"));
    assert.isTrue("".equalsIgnoreCase(""));
    assert.isFalse("hello".equalsIgnoreCase("hell"));
    assert.isFalse("hello".equalsIgnoreCase("world"));
}

// Simple folding is one scalar for one, so the German sharp s is not "ss" here.
// `caseFold` is the full folding that says it is.
test "equalsIgnoreCase is simple folding, not full" {
    assert.isFalse("straße".equalsIgnoreCase("strasse"));
    assert.isTrue("STRASSE".equalsIgnoreCase("strasse"));
}

test "startsWithIgnoreCase folds the prefix too" {
    assert.isTrue("HeLLo".startsWithIgnoreCase("hel"));
    assert.isTrue("hello".startsWithIgnoreCase(""));
    assert.isFalse("hi".startsWithIgnoreCase("hello"));
    assert.isFalse("hello".startsWithIgnoreCase("x"));
}

// --- splitLimit -----------------------------------------------------------------

test "splitLimit stops at the limit and keeps the rest whole" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a:b:c".splitLimit(ctx, ":", 2), ["a", "b:c"]);
    assert.equal("a:b:c".splitLimit(ctx, ":", 1), ["a:b:c"]);
    assert.equal("a:b:c".splitLimit(ctx, ":", 9), ["a", "b", "c"]);
}

test "splitLimit at or below zero has no pieces" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isEmpty("a:b".splitLimit(ctx, ":", 0));
    assert.isEmpty("a:b".splitLimit(ctx, ":", -1));
}

test "splitLimit of a string without the separator is the whole of it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".splitLimit(ctx, ":", 3), ["abc"]);
    assert.equal("".splitLimit(ctx, ":", 3), [""]);
}

// --- replaceFirst / reverse ------------------------------------------------------

test "replaceFirst replaces one occurrence" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("aba".replaceFirst(ctx, "a", "z"), "zba");
    assert.equal("aba".replaceFirst(ctx, "b", "z"), "aza");
    assert.equal("aba".replaceFirst(ctx, "x", "z"), "aba");
    assert.equal("aba".replaceFirst(ctx, "a", ""), "ba");
}

test "replaceFirst with an empty needle changes nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".replaceFirst(ctx, "", "z"), "abc");
    assert.equal("".replaceFirst(ctx, "a", "z"), "");
}

test "reverse turns the scalars around" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".reverse(ctx), "cba");
    assert.equal("a".reverse(ctx), "a");
    assert.equal("".reverse(ctx), "");
    assert.equal("a😀b".reverse(ctx), "b😀a");
}

// --- words ----------------------------------------------------------------------

test "words drops every empty piece" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("  one  two ".words(ctx), ["one", "two"]);
    assert.equal("one".words(ctx), ["one"]);
    assert.equal("a\tb\nc".words(ctx), ["a", "b", "c"]);
}

test "words of blank text is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isEmpty("".words(ctx));
    assert.isEmpty("   ".words(ctx));
}

// --- utf8Length / utf16Length ----------------------------------------------------

test "utf8Length counts the bytes UTF-8 would write" {
    assert.equal("abc".utf8Length(), 3);
    assert.equal("héllo".utf8Length(), 6);
    assert.equal("あ".utf8Length(), 3);
    assert.equal("😀".utf8Length(), 4);
    assert.equal("".utf8Length(), 0);
}

test "utf16Length counts code units, and length counts scalars" {
    assert.equal("abc".utf16Length(), 3);
    assert.equal("😀".utf16Length(), 2);
    assert.equal("😀".length(), 1);
    assert.equal("a😀b".utf16Length(), 4);
    assert.equal("".utf16Length(), 0);
}

// --- dedent / indent / wrap -------------------------------------------------------

test "dedent removes the common margin" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("    one\n      two".dedent(ctx), "one\n  two");
    assert.equal("one\n  two".dedent(ctx), "one\n  two");
    assert.equal("".dedent(ctx), "");
}

test "dedent ignores a blank line and empties it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("  a\n\n  b".dedent(ctx), "a\n\nb");
    assert.equal("  a\n   \n  b".dedent(ctx), "a\n\nb");
}

test "indent puts the prefix on every line that has anything on it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a\nb".indent(ctx, "> "), "> a\n> b");
    assert.equal("a\n\nb".indent(ctx, "> "), "> a\n\n> b");
    assert.equal("".indent(ctx, "> "), "");
}

test "wrap fills lines greedily" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a bb ccc".wrap(ctx, 5), ["a bb", "ccc"]);
    assert.equal("a b c".wrap(ctx, 99), ["a b c"]);
    assert.isEmpty("".wrap(ctx, 5));
}

test "wrap gives a word longer than the width a line of its own" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("aa bbbbbb cc".wrap(ctx, 4), ["aa", "bbbbbb", "cc"]);
    assert.equal("aa bb".wrap(ctx, 0), ["aa", "bb"]);
}

// --- fromIntGrouped ---------------------------------------------------------------

test "fromIntGrouped groups three digits at a time" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromIntGrouped(ctx, 1234567, ","), "1,234,567");
    assert.equal(str.fromIntGrouped(ctx, 1000, ","), "1,000");
    assert.equal(str.fromIntGrouped(ctx, 100, ","), "100");
    assert.equal(str.fromIntGrouped(ctx, 0, ","), "0");
}

test "fromIntGrouped keeps the sign outside the groups" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromIntGrouped(ctx, -1234, ","), "-1,234");
    assert.equal(str.fromIntGrouped(ctx, -1, ","), "-1");
}

test "fromIntGrouped takes any separator" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromIntGrouped(ctx, 1234, " "), "1 234");
    assert.equal(str.fromIntGrouped(ctx, 1234, ""), "1234");
}

// --- fromFloatFixed ---------------------------------------------------------------

test "fromFloatFixed keeps the number of digits asked for" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloatFixed(ctx, 3.14159, 2), "3.14");
    assert.equal(str.fromFloatFixed(ctx, 2.0, 3), "2.000");
    assert.equal(str.fromFloatFixed(ctx, 0.5, 0), "1");
    assert.equal(str.fromFloatFixed(ctx, 0.0, 2), "0.00");
}

test "fromFloatFixed rounds half away from zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloatFixed(ctx, 2.5, 0), "3");
    assert.equal(str.fromFloatFixed(ctx, -2.5, 0), "-3");
    assert.equal(str.fromFloatFixed(ctx, 0.06, 1), "0.1");
    assert.equal(str.fromFloatFixed(ctx, -1.25, 1), "-1.3");
}

test "fromFloatFixed carries a nine off the front" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloatFixed(ctx, 9.99, 1), "10.0");
    assert.equal(str.fromFloatFixed(ctx, 0.999, 2), "1.00");
    assert.equal(str.fromFloatFixed(ctx, 9.9, 0), "10");
}

test "fromFloatFixed expands what fromFloat writes with an exponent" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloatFixed(ctx, 0.0000006, 8), "0.00000060");
    assert.equal(str.fromFloatFixed(ctx, 0.0000006, 2), "0.00");
    assert.equal(str.fromFloatFixed(ctx, 1e21, 0), "1000000000000000000000");
}

test "fromFloatFixed treats a negative count of decimals as none" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloatFixed(ctx, 3.7, -1), "4");
}

test "fromFloatFixed hands back what has no digits" {
    let ctx = context {
        Allocator: alloc(),
    };
    let nan = 0.0 / 0.0;
    let up = 1.0 / 0.0;
    assert.equal(str.fromFloatFixed(ctx, nan, 2), str.fromFloat(ctx, nan));
    assert.equal(str.fromFloatFixed(ctx, up, 2), str.fromFloat(ctx, up));
    assert.equal(str.fromFloatFixed(ctx, -up, 2), str.fromFloat(ctx, -up));
}

// --- wrap at the widths that have no room ----------------------------------------

// A width of one leaves no room for a gap, so no two words ever share a line —
// and a word of one character still gets its own line rather than being
// packed. `line.length() + 1 + word.length() <= width` is the sum that decides it,
// and one is the smallest width where the `+ 1` is the whole of the answer.
test "wrap at a width of one is one word per line" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a b c".wrap(ctx, 1), ["a", "b", "c"]);
    assert.equal("ab c".wrap(ctx, 1), ["ab", "c"]);
    assert.equal("a".wrap(ctx, 1), ["a"]);
    assert.isEmpty("".wrap(ctx, 1));
}

test "wrap at a width of zero or less is one word per line too" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a b c".wrap(ctx, 0), ["a", "b", "c"]);
    assert.equal("a b c".wrap(ctx, -10), ["a", "b", "c"]);
    assert.isEmpty("".wrap(ctx, 0));
    assert.isEmpty("   ".wrap(ctx, 0));
}

// A word wider than the line overflows rather than being cut, and it does not
// drag its neighbours with it: the line before it closes and the line after it
// starts fresh.
test "wrap overflows a long word without cutting it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("aaaaaaaa".wrap(ctx, 3), ["aaaaaaaa"]);
    assert.equal("x aaaaaaaa y".wrap(ctx, 3), ["x", "aaaaaaaa", "y"]);
    assert.equal("aaaaaaaa bb".wrap(ctx, 3), ["aaaaaaaa", "bb"]);
    // A word exactly the width still fits, and one a scalar wider does not.
    assert.equal("abc de".wrap(ctx, 3), ["abc", "de"]);
    assert.equal("ab cd".wrap(ctx, 5), ["ab cd"]);
    assert.equal("ab cde".wrap(ctx, 5), ["ab", "cde"]);
}

// The input's own whitespace is not kept: `wrap` is `words` and a fill, so
// every gap comes back as one space whatever it was.
test "wrap keeps no whitespace of its own" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("  a\t\tb\n\nc  ".wrap(ctx, 99), ["a b c"]);
    assert.equal("a  b".wrap(ctx, 4), ["a b"]);
}

// --- dedent where the whitespace is not all one character -------------------------

// The margin is counted in characters, so a tab counts one and a space counts
// one. Two lines indented by a tab and by two spaces have margins of one and
// two, and the common margin is one — which cuts the tab off the first line and
// one of the two spaces off the second.
test "dedent counts the margin in characters, not in columns" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("\ta\n  b".dedent(ctx), "a\n b");
    assert.equal("  a\n\tb".dedent(ctx), " a\nb");
    // All tabs, so the answer is the one a column count would also give.
    assert.equal("\t\ta\n\t\t\tb".dedent(ctx), "a\n\tb");
    // A tab inside the margin is margin, and one past it is text.
    assert.equal("  \ta\n  \tb".dedent(ctx), "a\nb");
    assert.equal("  a\tb\n  c".dedent(ctx), "a\tb\nc");
}

test "dedent leaves text with no margin alone, and empties an all-blank block" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a\nb".dedent(ctx), "a\nb");
    assert.equal(" \n\t\n  ".dedent(ctx), "\n\n");
    assert.equal("   ".dedent(ctx), "");
    assert.equal("\t".dedent(ctx), "");
    // One line is a block too.
    assert.equal("    only".dedent(ctx), "only");
    assert.equal("only".dedent(ctx), "only");
}

test "indent takes an empty prefix and a prefix of its own" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a\nb".indent(ctx, ""), "a\nb");
    assert.equal("a".indent(ctx, "    "), "    a");
    // A line that is whitespace is not empty, so it takes the prefix.
    assert.equal("a\n \nb".indent(ctx, "> "), "> a\n>  \n> b");
    // Round trip: indenting and dedenting a block with one margin is identity.
    let block = "one\n  two\nthree";
    assert.equal(block.indent(ctx, "    ").dedent(ctx), block);
}

// --- The searches at their edges ---------------------------------------------------

test "the prefix and suffix verbs at the two degenerate arguments" {
    assert.equal(assert.some("abc".stripPrefix("")), "abc");
    assert.equal(assert.some("abc".stripSuffix("")), "abc");
    assert.equal(assert.some("abc".stripPrefix("abc")), "");
    assert.equal(assert.some("abc".stripSuffix("abc")), "");
    assert.none("abc".stripPrefix("abcd"));
    assert.none("abc".stripSuffix("abcd"));
    assert.equal(assert.some("".stripPrefix("")), "");
    assert.none("".stripPrefix("a"));
}

test "lastIndexOf and splitOnceFromEnd on what is not there" {
    assert.none("abc".lastIndexOf("z"));
    assert.none("abc".lastIndexOf("abcd"));
    assert.none("".lastIndexOf("a"));
    assert.equal(assert.some("".lastIndexOf("")), 0);
    assert.none("abc".splitOnceFromEnd("z"));
    let halves = assert.some("a.b.c".splitOnceFromEnd("."));
    assert.equal(halves.0, "a.b");
    assert.equal(halves.1, "c");
    // A separator at either end leaves an empty half.
    let leading = assert.some(".abc".splitOnceFromEnd("."));
    assert.equal(leading.0, "");
    assert.equal(leading.1, "abc");
    let trailing = assert.some("abc.".splitOnceFromEnd("."));
    assert.equal(trailing.0, "abc");
    assert.equal(trailing.1, "");
}

test "indexOfFrom past the end and at it" {
    assert.none("abcabc".indexOfFrom("a", 6));
    assert.none("abcabc".indexOfFrom("a", 1000));
    assert.equal(assert.some("abcabc".indexOfFrom("a", 3)), 3);
    assert.none("abcabc".indexOfFrom("a", 4));
    assert.none("abcabc".indexOfFrom("z", 0));
    // The empty needle is found where the search starts.
    assert.equal(assert.some("abc".indexOfFrom("", 2)), 2);
}

test "count on what cannot be counted" {
    assert.equal("abc".count("z"), 0);
    assert.equal("abc".count("abcd"), 0);
    assert.equal("".count("a"), 0);
    assert.equal("".count(""), 0);
    assert.equal("aaa".count("a"), 3);
    assert.equal("aaaa".count("aa"), 2);
    assert.equal("aaaaa".count("aa"), 2);
}

test "trimAny with nothing to trim by, and with everything" {
    assert.equal("abc".trimAny(""), "abc");
    assert.equal("".trimAny("ab"), "");
    assert.equal("aaa".trimAny("a"), "");
    assert.equal("aXa".trimStartAny("a"), "Xa");
    assert.equal("aXa".trimEndAny("a"), "aX");
    // The set is scalars, so a multi-scalar grapheme is not one member of it.
    assert.equal("😀a😀".trimAny("😀"), "a");
}

test "indexOfAny and indexWhere when nothing matches" {
    assert.none("abc".indexOfAny(""));
    assert.none("abc".indexOfAny("xyz"));
    assert.none("".indexOfAny("a"));
    assert.equal(assert.some("abc".indexOfAny("cb")), 1);
    assert.none("abc".indexWhere(fn(c) => c.isDigit()));
    assert.none("".indexWhere(fn(_c) => true));
    assert.equal(assert.some("ab1".indexWhere(fn(c) => c.isDigit())), 2);
}

test "isBlank over the whitespace that is not a space" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue("".isBlank());
    assert.isTrue(" \t\n".isBlank());
    assert.isTrue(str.fromChars(ctx, ['\r', '\n']).isBlank());
    assert.isFalse("a".isBlank());
    assert.isFalse(" a ".isBlank());
    // A non-breaking space is whitespace to `isSpace`, and so to `trim`.
    assert.isTrue(" ".isBlank());
}

test "equalsIgnoreCase and startsWithIgnoreCase at the lengths that decide" {
    assert.isTrue("".equalsIgnoreCase(""));
    assert.isFalse("a".equalsIgnoreCase(""));
    assert.isFalse("".equalsIgnoreCase("a"));
    assert.isFalse("abc".equalsIgnoreCase("abcd"));
    assert.isTrue("ÄÖÜ".equalsIgnoreCase("äöü"));
    assert.isTrue("abc".startsWithIgnoreCase(""));
    assert.isTrue("".startsWithIgnoreCase(""));
    assert.isFalse("".startsWithIgnoreCase("a"));
    assert.isFalse("ab".startsWithIgnoreCase("abc"));
    assert.isTrue("ABC".startsWithIgnoreCase("abc"));
}

test "splitLimit at one, at the number of pieces, and past it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("a,b,c".splitLimit(ctx, ",", 1), ["a,b,c"]);
    assert.equal("a,b,c".splitLimit(ctx, ",", 3), ["a", "b", "c"]);
    assert.equal("a,b,c".splitLimit(ctx, ",", 9), ["a", "b", "c"]);
    assert.equal("".splitLimit(ctx, ",", 3), [""]);
    assert.isEmpty("a,b".splitLimit(ctx, ",", 0));
    assert.isEmpty("a,b".splitLimit(ctx, ",", -1));
}

test "replaceFirst when the needle is the whole string, and when it is absent" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".replaceFirst(ctx, "abc", "z"), "z");
    assert.equal("abc".replaceFirst(ctx, "z", "y"), "abc");
    assert.equal("aaa".replaceFirst(ctx, "a", ""), "aa");
    assert.equal("".replaceFirst(ctx, "a", "b"), "");
    assert.equal("abc".replaceFirst(ctx, "", "z"), "abc");
}

test "reverse of nothing, of one, and of what is not on the plane" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("".reverse(ctx), "");
    assert.equal("a".reverse(ctx), "a");
    assert.equal("😀b".reverse(ctx), "b😀");
    assert.equal("abc".reverse(ctx).reverse(ctx), "abc");
}

test "words of one word, and of text that is all separators" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("one".words(ctx), ["one"]);
    assert.equal("  one  ".words(ctx), ["one"]);
    assert.isEmpty("".words(ctx));
    assert.isEmpty(" \t\n ".words(ctx));
    assert.equal("a\tb\nc".words(ctx), ["a", "b", "c"]);
}

// --- The whole of core/str over a long string ------------------------------------

// Eight hundred scalars, which is past every other string in this file and past
// the point where a search that walked the whole string per position would
// show.
test "the searching and counting verbs over eight hundred scalars" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = "ab".repeat(ctx, 400);
    assert.equal(text.length(), 800);
    assert.equal(text.count("ab"), 400);
    assert.equal(text.count("ba"), 399);
    assert.equal(assert.some(text.lastIndexOf("ab")), 798);
    assert.equal(assert.some(text.indexOfFrom("b", 700)), 701);
    assert.equal(assert.some(text.stripPrefix("ab")).length(), 798);
    assert.equal(assert.some(text.stripSuffix("ab")).length(), 798);
    assert.equal(text.utf8Length(), 800);
    assert.equal(text.utf16Length(), 800);
    assert.equal(text.reverse(ctx), "ba".repeat(ctx, 400));
    assert.equal(text.splitLimit(ctx, "a", 3).length(), 3);
    assert.equal(text.replaceFirst(ctx, "ab", "").length(), 798);
    assert.isFalse(text.isBlank());
    assert.equal(assert.some(text.indexWhere(fn(c) => c == 'b')), 1);
    // And a long block of lines through the layout verbs.
    let block = "  line\n".repeat(ctx, 200);
    assert.equal(block.dedent(ctx).lines(ctx).length(), 201);
    assert.equal(block.indent(ctx, "> ").lines(ctx).length(), 201);
    assert.equal("word ".repeat(ctx, 100).wrap(ctx, 9).length(), 50);
}

// --- fromIntGrouped and fromFloatFixed at their ends -------------------------------

test "fromIntGrouped over every group boundary" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromIntGrouped(ctx, 1, ","), "1");
    assert.equal(str.fromIntGrouped(ctx, 12, ","), "12");
    assert.equal(str.fromIntGrouped(ctx, 123, ","), "123");
    assert.equal(str.fromIntGrouped(ctx, 1234, ","), "1,234");
    assert.equal(str.fromIntGrouped(ctx, 12345, ","), "12,345");
    assert.equal(str.fromIntGrouped(ctx, 123456, ","), "123,456");
    assert.equal(str.fromIntGrouped(ctx, 1234567890, ","), "1,234,567,890");
    assert.equal(str.fromIntGrouped(ctx, -1000, ","), "-1,000");
    assert.equal(str.fromIntGrouped(ctx, 0, ""), "0");
    // A separator of more than one scalar goes in whole.
    assert.equal(str.fromIntGrouped(ctx, 1234567, " and "), "1 and 234 and 567");
}

test "fromFloatFixed asked for many digits, and for a whole number" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloatFixed(ctx, 1.5, 0), "2");
    assert.equal(str.fromFloatFixed(ctx, 1.0, 0), "1");
    assert.equal(str.fromFloatFixed(ctx, -1.0, 0), "-1");
    assert.equal(str.fromFloatFixed(ctx, 1.0, 10), "1.0000000000");
    assert.equal(str.fromFloatFixed(ctx, 0.0, 0), "0");
    assert.equal(str.fromFloatFixed(ctx, 100.0, 2), "100.00");
    assert.equal(str.fromFloatFixed(ctx, 0.001, 2), "0.00");
}
