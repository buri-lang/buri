    assert.eq("\u{378}\u{a03}".graphemeCount(), 1);
    assert.eq("\u{378}\u{308}\u{ac00}".graphemes(ctx), ["\u{378}\u{308}", "\u{ac00}"]);
    assert.eq("\u{378}\u{308}\u{ac00}".graphemeCount(), 2);
    assert.eq("\u{378}\u{915}".graphemes(ctx), ["\u{378}", "\u{915}"]);
    assert.eq("\u{378}\u{915}".graphemeCount(), 2);
    assert.eq("\u{378}\u{308}\u{94d}".graphemes(ctx), ["\u{378}\u{308}\u{94d}"]);
    assert.eq("\u{378}\u{308}\u{94d}".graphemeCount(), 1);
    assert.eq("\u{1100}\u{1100}".graphemes(ctx), ["\u{1100}\u{1100}"]);
    assert.eq("\u{1100}\u{1100}".graphemeCount(), 1);
    assert.eq("\u{61}\u{308}\u{62}".graphemes(ctx), ["\u{61}\u{308}", "\u{62}"]);
    assert.eq("\u{61}\u{308}\u{62}".graphemeCount(), 2);
    assert.eq("\u{2701}\u{200d}\u{2701}".graphemes(ctx), ["\u{2701}\u{200d}\u{2701}"]);
    assert.eq("\u{2701}\u{200d}\u{2701}".graphemeCount(), 1);
    assert.eq("\u{915}\u{94d}\u{61}".graphemes(ctx), ["\u{915}\u{94d}", "\u{61}"]);
    assert.eq("\u{915}\u{94d}\u{61}".graphemeCount(), 2);
}

// --- The UCD's own normalization vectors --------------------------------------
//
// Every 320th line of `NormalizationTest.txt`, the same way. Each row is one
// source and the four forms it takes.

test "normalization vectors, 0 to 20" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{1e0a}".normalize(ctx, .Nfc), "\u{1e0a}");
    assert.eq("\u{1e0a}".normalize(ctx, .Nfd), "\u{44}\u{307}");
    assert.eq("\u{1e0a}".normalize(ctx, .Nfkc), "\u{1e0a}");
    assert.eq("\u{1e0a}".normalize(ctx, .Nfkd), "\u{44}\u{307}");
    assert.eq("\u{22b}".normalize(ctx, .Nfc), "\u{22b}");
    assert.eq("\u{22b}".normalize(ctx, .Nfd), "\u{6f}\u{308}\u{304}");
    assert.eq("\u{22b}".normalize(ctx, .Nfkc), "\u{22b}");
    assert.eq("\u{22b}".normalize(ctx, .Nfkd), "\u{6f}\u{308}\u{304}");
    assert.eq("\u{1e04}".normalize(ctx, .Nfc), "\u{1e04}");
    assert.eq("\u{1e04}".normalize(ctx, .Nfd), "\u{42}\u{323}");
    assert.eq("\u{1e04}".normalize(ctx, .Nfkc), "\u{1e04}");
    assert.eq("\u{1e04}".normalize(ctx, .Nfkd), "\u{42}\u{323}");
    assert.eq("\u{1f56}".normalize(ctx, .Nfc), "\u{1f56}");
    assert.eq("\u{1f56}".normalize(ctx, .Nfd), "\u{3c5}\u{313}\u{342}");
    assert.eq("\u{1f56}".normalize(ctx, .Nfkc), "\u{1f56}");
    assert.eq("\u{1f56}".normalize(ctx, .Nfkd), "\u{3c5}\u{313}\u{342}");
    assert.eq("\u{2176}".normalize(ctx, .Nfc), "\u{2176}");
    assert.eq("\u{2176}".normalize(ctx, .Nfd), "\u{2176}");
    assert.eq("\u{2176}".normalize(ctx, .Nfkc), "\u{76}\u{69}\u{69}");
    assert.eq("\u{2176}".normalize(ctx, .Nfkd), "\u{76}\u{69}\u{69}");
    assert.eq("\u{2f6e}".normalize(ctx, .Nfc), "\u{2f6e}");
    assert.eq("\u{2f6e}".normalize(ctx, .Nfd), "\u{2f6e}");
