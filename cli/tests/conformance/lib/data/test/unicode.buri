    forms(ctx, "ᾀ", "ᾀ", "ᾀ", "ᾀ", "ᾀ");
    forms(ctx, "ᾃ", "ᾃ", "ᾃ", "ᾃ", "ᾃ");
    forms(ctx, "ᾅ", "ᾅ", "ᾅ", "ᾅ", "ᾅ");
    forms(ctx, "ᾊ", "ᾊ", "ᾊ", "ᾊ", "ᾊ");
    forms(ctx, "ᾌ", "ᾌ", "ᾌ", "ᾌ", "ᾌ");
    forms(ctx, "ᾎ", "ᾎ", "ᾎ", "ᾎ", "ᾎ");
    forms(ctx, "ᾒ", "ᾒ", "ᾒ", "ᾒ", "ᾒ");
    forms(ctx, "ᾔ", "ᾔ", "ᾔ", "ᾔ", "ᾔ");
    forms(ctx, "ᾖ", "ᾖ", "ᾖ", "ᾖ", "ᾖ");
    forms(ctx, "ᾚ", "ᾚ", "ᾚ", "ᾚ", "ᾚ");
    forms(ctx, "ᾜ", "ᾜ", "ᾜ", "ᾜ", "ᾜ");
    forms(ctx, "ᾟ", "ᾟ", "ᾟ", "ᾟ", "ᾟ");
    forms(ctx, "ᾣ", "ᾣ", "ᾣ", "ᾣ", "ᾣ");
    forms(ctx, "ᾥ", "ᾥ", "ᾥ", "ᾥ", "ᾥ");
    forms(ctx, "ᾨ", "ᾨ", "ᾨ", "ᾨ", "ᾨ");
    forms(ctx, "ᾫ", "ᾫ", "ᾫ", "ᾫ", "ᾫ");
    forms(ctx, "ᾭ", "ᾭ", "ᾭ", "ᾭ", "ᾭ");
    forms(ctx, "ᾴ", "ᾴ", "ᾴ", "ᾴ", "ᾴ");
    forms(ctx, "ῢ", "ῢ", "ῢ", "ῢ", "ῢ");
    forms(ctx, "𖄦", "𖄦", "𖄦", "𖄦", "𖄦");
    forms(ctx, "𑎎𑏇", "𑎎𑏇", "𑎎𑏇", "𑎎𑏇", "𑎎𑏇");
    forms(ctx, "𖄡𖄧", "𖄡𖄧", "𖄡𖄧", "𖄡𖄧", "𖄡𖄧");
}

test "a normalization form is equal only to itself" {
    assert.isTrue(Normalization.Nfc == Normalization.Nfc);
    assert.isTrue(Normalization.Nfd == Normalization.Nfd);
    assert.isTrue(Normalization.Nfkc == Normalization.Nfkc);
    assert.isTrue(Normalization.Nfkd == Normalization.Nfkd);
    assert.isFalse(Normalization.Nfc == Normalization.Nfd);
    assert.isFalse(Normalization.Nfd == Normalization.Nfkc);
    assert.isFalse(Normalization.Nfkc == Normalization.Nfkd);
    assert.isFalse(Normalization.Nfkd == Normalization.Nfc);
}

// --- the tables as a whole ------------------------------------------------------

/// How many scalars below U+30000, each on its own, `differs` is true of.
fn countedBelow<C: Allocator>(ctx: C, differs: fn(C, Str) => Bool): Int {
    list
        .range(ctx, 0, 0x30000)
        .foldCtx(
            ctx,
            fn(c, n, code) => {
                match (code.wrapToU32().toChar()) {
                    .Ok(ch) => {
                        if (differs(c, str.fromChars(c, [ch]))) { n + 1 } else { n }
                    },
                    .Err(_e) => n,
                }
            },
            0,
        )
}

// Every entry of a table changes one scalar, so a table that reads a key, an
// offset or a length wrong changes how many scalars change.
test "every scalar the decomposition tables name is one that decomposes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(countedBelow(ctx, fn(c, one) => one.normalize(c, .Nfd) != one), 13253);
    assert.equal(
        countedBelow(ctx, fn(c, one) => one.normalize(c, .Nfkd) != one),
        17086,
    );
}

test "every scalar the folding table names is one that folds" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(countedBelow(ctx, fn(c, one) => one.caseFold(c) != one), 1585);
}

test "every decomposition the composition table names composes back" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        countedBelow(ctx, fn(c, one) => {
            one.normalize(c, .Nfd).normalize(c, .Nfc) != one.normalize(c, .Nfd)
        }),
        12151,
    );
}

test "a scalar written twice is one cluster only where its class joins it to itself" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        countedBelow(ctx, fn(c, one) => one.concat(c, one).graphemeCount() == 1),
        2698,
    );
}
