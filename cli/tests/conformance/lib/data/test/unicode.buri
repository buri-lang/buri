// core/str beyond the scalar — grapheme clusters, the four normalization forms,
// and full case folding.
//
// The tables these read are generated at **Unicode 17.0** by
// `crates/stdlib/src/compiler/standard_library/unicode_tables.py`, so the two sets of
// cases below are the two things worth asserting: the rules, named one at a
// time, and the UCD's own vectors, sliced.

from "core/list" import * as list;
from "core/str" import * as str;
from "core/str" import { Normalization };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

// --- graphemes ------------------------------------------------------------------

test "graphemes of ASCII is one piece per character" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".graphemes(ctx), ["a", "b", "c"]);
    assert.equal("a b".graphemes(ctx), ["a", " ", "b"]);
}

test "graphemes of the empty string has no pieces" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isEmpty("".graphemes(ctx));
    assert.equal("".graphemeCount(), 0);
}

test "a combining mark stays with the letter it is on" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = "éa";
    assert.equal(text.graphemes(ctx), ["é", "a"]);
    assert.equal(text.graphemeCount(), 2);
    assert.equal(text.length(), 3);
}

// GB3: a carriage return and a line feed are one cluster, and everything else
// around them is not.
//
// The two are built with `fromChars` rather than written into a literal,
// because the formatter stores a string as the characters it denotes and a
// carriage return in a source file is worse than a line of setup.
test "CR LF is one cluster" {
    let ctx = context {
        Allocator: alloc(),
    };
    let crlf = str.fromChars(ctx, ['\r', '\n']);
    let lfcr = str.fromChars(ctx, ['\n', '\r']);
    let crcr = str.fromChars(ctx, ['\r', '\r']);
    let around = str.fromChars(ctx, ['a', '\r', '\n', 'b']);
    assert.equal(crlf.graphemes(ctx), [crlf]);
    assert.equal(crlf.graphemeCount(), 1);
    assert.equal(around.graphemeCount(), 3);
    assert.equal(lfcr.graphemeCount(), 2);
    assert.equal(crcr.graphemeCount(), 2);
}

// GB11: an emoji, any number of extenders, a zero-width joiner and another
// emoji are one cluster however long the chain.
test "a zero-width joiner sequence is one cluster" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("👨‍👩‍👦".graphemeCount(), 1);
    assert.equal("👍🏽".graphemeCount(), 1);
    assert.equal("👨👩".graphemeCount(), 2);
    // A joiner holds on to the pictograph before it, and joins only another.
    assert.equal("😀\u{200d}a".graphemes(ctx), ["😀\u{200d}", "a"]);
}

test "Hangul composes only the jamo the arithmetic covers" {
    let ctx = context {
        Allocator: alloc(),
    };
    // U+1176 is a vowel past the modern ones, and U+11C3 a final past them.
    assert.equal("ᄀᅶ".normalize(ctx, .Nfc), "ᄀᅶ");
    assert.equal("가ᇃ".normalize(ctx, .Nfc), "가ᇃ");
    assert.equal("기".normalize(ctx, .Nfc), "기");
    assert.equal("갛".normalize(ctx, .Nfc), "갛");
}

// GB12 and GB13: regional indicators pair up, so a flag is one cluster and an
// odd one left over is its own.
test "regional indicators pair into flags" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("🇬🇧".graphemeCount(), 1);
    assert.equal("🇬🇧🇫🇷".graphemeCount(), 2);
    assert.equal("🇬🇧🇫".graphemeCount(), 2);
    assert.equal("🇬".graphemeCount(), 1);
}

// GB9c, which arrived in Unicode 15.1: a consonant, a virama and a consonant
// are one cluster.
test "an Indic conjunct is one cluster" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("क्षि".graphemeCount(), 1);
    assert.equal("कष".graphemeCount(), 2);
}

// GB6 to GB8: a Hangul syllable written as jamo is one cluster.
test "Hangul jamo make one syllable" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("한".graphemeCount(), 1);
    assert.equal("한".graphemeCount(), 1);
    assert.equal("한글".graphemeCount(), 2);
}

test "graphemeCount agrees with graphemes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = "á🇬🇧👨‍👩z";
    assert.equal(text.graphemeCount(), text.graphemes(ctx).length());
    assert.equal(text.graphemeCount(), 4);
}

// --- normalize --------------------------------------------------------------------

test "Nfc composes and Nfd decomposes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("é".normalize(ctx, .Nfc), "é");
    assert.equal("é".normalize(ctx, .Nfd), "é");
    assert.equal("é".normalize(ctx, .Nfc), "é");
    assert.equal("é".normalize(ctx, .Nfd), "é");
}

test "text with nothing to normalize comes back as it was" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".normalize(ctx, .Nfc), "abc");
    assert.equal("abc".normalize(ctx, .Nfd), "abc");
    assert.equal("abc".normalize(ctx, .Nfkc), "abc");
    assert.equal("abc".normalize(ctx, .Nfkd), "abc");
    assert.equal("".normalize(ctx, .Nfc), "");
    assert.equal("".normalize(ctx, .Nfkd), "");
}

// The compatibility forms lose distinctions on purpose, and the canonical ones
// keep them: that is the whole difference between the two pairs.
test "the compatibility forms fold a ligature and a superscript" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ﬁ".normalize(ctx, .Nfkc), "fi");
    assert.equal("ﬁ".normalize(ctx, .Nfkd), "fi");
    assert.equal("ﬁ".normalize(ctx, .Nfc), "ﬁ");
    assert.equal("²".normalize(ctx, .Nfkc), "2");
    assert.equal("²".normalize(ctx, .Nfc), "²");
}

// Canonical ordering: two marks with different combining classes come out in
// class order whichever way round they were written.
test "combining marks are reordered by class" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("q̣̇".normalize(ctx, .Nfd), "q̣̇");
    assert.equal("q̣̇".normalize(ctx, .Nfd), "q̣̇");
    assert.equal("q̣̇".normalize(ctx, .Nfc), "q̣̇");
}

test "Hangul composes and decomposes by arithmetic" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("한".normalize(ctx, .Nfd), "한");
    assert.equal("한".normalize(ctx, .Nfc), "한");
    assert.equal("가".normalize(ctx, .Nfd), "가");
    assert.equal("가".normalize(ctx, .Nfc), "가");
    assert.equal("한글".normalize(ctx, .Nfc), "한글");
}

test "the last Hangul syllable decomposes into three jamo and composes back" {
    let ctx = context {
        Allocator: alloc(),
    };
    // U+D7A3 is the last syllable and U+AC00 the first.
    let last = "힣";
    let first = "가";
    assert.equal(codes(ctx, last.normalize(ctx, .Nfd)), [0x1112, 0x1175, 0x11c2]);
    assert.equal(codes(ctx, last.normalize(ctx, .Nfd).normalize(ctx, .Nfc)), [0xd7a3]);
    assert.equal(codes(ctx, first.normalize(ctx, .Nfd)), [0x1100, 0x1161]);
}

test "a character past the Basic Multilingual Plane decomposes from the table" {
    let ctx = context {
        Allocator: alloc(),
    };
    // U+1D15E MUSICAL SYMBOL HALF NOTE is a composition exclusion, so NFC
    // leaves it apart too.
    let note = "𝅗𝅥";
    assert.equal(codes(ctx, note.normalize(ctx, .Nfd)), [0x1d157, 0x1d165]);
    assert.equal(codes(ctx, note.normalize(ctx, .Nfc)), [0x1d157, 0x1d165]);
}

fn codes<C: Allocator>(ctx: C, text: Str): [U32] {
    text.chars(ctx).map(ctx, fn(c) => c.toU32())
}

// A composition exclusion is a character NFC will not put back together, and
// U+0344 is one of the ones a naive implementation gets wrong.
test "a composition exclusion is not recomposed" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ẛ̣".normalize(ctx, .Nfc), "ẛ̣");
    assert.equal("ẛ̣".normalize(ctx, .Nfd), "ẛ̣");
    assert.equal("ẛ̣".normalize(ctx, .Nfkc), "ṩ");
    assert.equal("ẛ̣".normalize(ctx, .Nfkd), "ṩ");
}

test "Normalization is a value that compares and renders" {
    let form: Normalization = .Nfc;
    assert.equal(form, .Nfc);
    assert.notEqual(form, .Nfd);
}

// --- caseFold ---------------------------------------------------------------------

test "caseFold lowercases the ASCII letters" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ABC".caseFold(ctx), "abc");
    assert.equal("abc".caseFold(ctx), "abc");
    assert.equal("A1b!".caseFold(ctx), "a1b!");
    assert.equal("".caseFold(ctx), "");
}

// Full folding, so a folding may be longer than what it folded — which is the
// whole difference from `equalsIgnoreCase`.
test "caseFold expands where the folding is more than one scalar" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("Straße".caseFold(ctx), "strasse");
    assert.equal("STRASSE".caseFold(ctx), "strasse");
    assert.equal("ﬁ".caseFold(ctx), "fi");
    assert.isFalse("straße".equalsIgnoreCase("strasse"));
}

test "caseFold brings both sigmas together" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("Σ".caseFold(ctx), "σ");
    assert.equal("σ".caseFold(ctx), "σ");
    assert.equal("ς".caseFold(ctx), "σ");
}

test "caseFold is idempotent" {
    let ctx = context {
        Allocator: alloc(),
    };
    let once = "Straße ΣΣ ﬁ".caseFold(ctx);
    assert.equal(once.caseFold(ctx), once);
}

// Folding has no locale. `İ` is the letter a Turkish keyboard writes, and its
// own language lowercases it to a plain `i`; full folding without a locale
// answers `i` and a combining dot instead, and this library has no door for the
// other answer.
test "caseFold has no locale, so the Turkish dotted capital keeps its dot" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("İ".caseFold(ctx), "i̇");
    assert.equal("İ".caseFold(ctx).length(), 2);
    assert.equal("I".caseFold(ctx), "i");
    // The dotless lowercase folds to itself, so `I` and `ı` stay apart.
    assert.equal("ı".caseFold(ctx), "ı");
    assert.notEqual("I".caseFold(ctx), "ı".caseFold(ctx));
}

// Cherokee is the script whose folding goes *up*: its lowercase letters were
// added long after its uppercase ones, so `CaseFolding.txt` maps the small
// letters onto the capitals rather than the other way round.
test "caseFold takes Cherokee to its uppercase letters" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ꭰ".caseFold(ctx), "Ꭰ");
    assert.equal("Ꭰ".caseFold(ctx), "Ꭰ");
    assert.equal("ᏸ".caseFold(ctx), "Ᏸ");
    assert.equal("Ᏸ".caseFold(ctx), "Ᏸ");
    assert.equal("ꭰꭱ".caseFold(ctx), "ᎠᎡ".caseFold(ctx));
}

// A folding may be longer than what it folded, or a different scalar
// altogether, and none of it is a lowercasing.
test "caseFold is not toLower" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("ﬄ".caseFold(ctx), "ffl");
    assert.equal("ẛ".caseFold(ctx), "ṡ");
    assert.equal("ΐ".caseFold(ctx), "ΐ");
    assert.equal("ΐ".caseFold(ctx).length(), 3);
    // The Kelvin sign and the ohm sign fold onto the ordinary letters.
    assert.equal("K".caseFold(ctx), "k");
    assert.equal("Ω".caseFold(ctx), "ω");
}

// --- The UCD's own break vectors ---------------------------------------------
//
// Every line of `GraphemeBreakTest.txt` at Unicode 17.0, which is the file
// `unicode_tables.py` names -- all 766 of them, so no rule the file states is
// left to the hand-written cases above.
//
// A case is spelled as its clusters, one list of scalars each. Scalars rather
// than text because a C0 control inside a string literal is stored raw, and a
// source holding a carriage return is not one the formatter can keep, while a
// `Char` literal below U+0020 keeps its escape.

/// Joined, the clusters have to come back cut in exactly those places.
fn breaks<C: Allocator>(ctx: C, clusters: [[Char]]): () {
    let want = clusters.mapCtx(ctx, fn(c, cs) => str.fromChars(c, cs));
    let text = want.join(ctx, "");
    assert.equal(text.graphemes(ctx), want);
    assert.equal(text.graphemeCount(), want.length());
}

test "grapheme break vectors, 0 to 60" {
    let ctx = context {
        Allocator: alloc(),
    };
    breaks(ctx, [['\r'], ['\r']]);
    breaks(ctx, [['\r'], ['̈'], ['\r']]);
    breaks(ctx, [['\r', '\n']]);
    breaks(ctx, [['\r'], ['̈'], ['\n']]);
    breaks(ctx, [['\r'], ['\0']]);
    breaks(ctx, [['\r'], ['̈'], ['\0']]);
    breaks(ctx, [['\r'], ['्']]);
    breaks(ctx, [['\r'], ['̈', '्']]);
    breaks(ctx, [['\r'], ['̀']]);
    breaks(ctx, [['\r'], ['̈', '̀']]);
    breaks(ctx, [['\r'], ['\u{200c}']]);
    breaks(ctx, [['\r'], ['̈', '\u{200c}']]);
    breaks(ctx, [['\r'], ['\u{200d}']]);
    breaks(ctx, [['\r'], ['̈', '\u{200d}']]);
    breaks(ctx, [['\r'], ['🇦']]);
    breaks(ctx, [['\r'], ['̈'], ['🇦']]);
    breaks(ctx, [['\r'], ['\u{6dd}']]);
    breaks(ctx, [['\r'], ['̈'], ['\u{6dd}']]);
    breaks(ctx, [['\r'], ['ः']]);
    breaks(ctx, [['\r'], ['̈', 'ः']]);
    breaks(ctx, [['\r'], ['ᄀ']]);
    breaks(ctx, [['\r'], ['̈'], ['ᄀ']]);
    breaks(ctx, [['\r'], ['ᅠ']]);
    breaks(ctx, [['\r'], ['̈'], ['ᅠ']]);
    breaks(ctx, [['\r'], ['ᆨ']]);
    breaks(ctx, [['\r'], ['̈'], ['ᆨ']]);
    breaks(ctx, [['\r'], ['가']]);
    breaks(ctx, [['\r'], ['̈'], ['가']]);
    breaks(ctx, [['\r'], ['각']]);
    breaks(ctx, [['\r'], ['̈'], ['각']]);
    breaks(ctx, [['\r'], ['क']]);
    breaks(ctx, [['\r'], ['̈'], ['क']]);
    breaks(ctx, [['\r'], ['©']]);
    breaks(ctx, [['\r'], ['̈'], ['©']]);
    breaks(ctx, [['\r'], [' ']]);
    breaks(ctx, [['\r'], ['̈'], [' ']]);
    breaks(ctx, [['\r'], ['\u{378}']]);
    breaks(ctx, [['\r'], ['̈'], ['\u{378}']]);
    breaks(ctx, [['\n'], ['\r']]);
    breaks(ctx, [['\n'], ['̈'], ['\r']]);
    breaks(ctx, [['\n'], ['\n']]);
    breaks(ctx, [['\n'], ['̈'], ['\n']]);
    breaks(ctx, [['\n'], ['\0']]);
    breaks(ctx, [['\n'], ['̈'], ['\0']]);
    breaks(ctx, [['\n'], ['्']]);
    breaks(ctx, [['\n'], ['̈', '्']]);
    breaks(ctx, [['\n'], ['̀']]);
    breaks(ctx, [['\n'], ['̈', '̀']]);
    breaks(ctx, [['\n'], ['\u{200c}']]);
    breaks(ctx, [['\n'], ['̈', '\u{200c}']]);
    breaks(ctx, [['\n'], ['\u{200d}']]);
    breaks(ctx, [['\n'], ['̈', '\u{200d}']]);
    breaks(ctx, [['\n'], ['🇦']]);
    breaks(ctx, [['\n'], ['̈'], ['🇦']]);
    breaks(ctx, [['\n'], ['\u{6dd}']]);
    breaks(ctx, [['\n'], ['̈'], ['\u{6dd}']]);
    breaks(ctx, [['\n'], ['ः']]);
    breaks(ctx, [['\n'], ['̈', 'ः']]);
    breaks(ctx, [['\n'], ['ᄀ']]);
    breaks(ctx, [['\n'], ['̈'], ['ᄀ']]);
}

test "grapheme break vectors, 60 to 120" {
    let ctx = context {
        Allocator: alloc(),
    };
    breaks(ctx, [['\n'], ['ᅠ']]);
    breaks(ctx, [['\n'], ['̈'], ['ᅠ']]);
    breaks(ctx, [['\n'], ['ᆨ']]);
    breaks(ctx, [['\n'], ['̈'], ['ᆨ']]);
    breaks(ctx, [['\n'], ['가']]);
    breaks(ctx, [['\n'], ['̈'], ['가']]);
    breaks(ctx, [['\n'], ['각']]);
    breaks(ctx, [['\n'], ['̈'], ['각']]);
    breaks(ctx, [['\n'], ['क']]);
    breaks(ctx, [['\n'], ['̈'], ['क']]);
    breaks(ctx, [['\n'], ['©']]);
    breaks(ctx, [['\n'], ['̈'], ['©']]);
    breaks(ctx, [['\n'], [' ']]);
    breaks(ctx, [['\n'], ['̈'], [' ']]);
    breaks(ctx, [['\n'], ['\u{378}']]);
    breaks(ctx, [['\n'], ['̈'], ['\u{378}']]);
    breaks(ctx, [['\0'], ['\r']]);
    breaks(ctx, [['\0'], ['̈'], ['\r']]);
    breaks(ctx, [['\0'], ['\n']]);
    breaks(ctx, [['\0'], ['̈'], ['\n']]);
    breaks(ctx, [['\0'], ['\0']]);
    breaks(ctx, [['\0'], ['̈'], ['\0']]);
    breaks(ctx, [['\0'], ['्']]);
    breaks(ctx, [['\0'], ['̈', '्']]);
    breaks(ctx, [['\0'], ['̀']]);
    breaks(ctx, [['\0'], ['̈', '̀']]);
    breaks(ctx, [['\0'], ['\u{200c}']]);
    breaks(ctx, [['\0'], ['̈', '\u{200c}']]);
    breaks(ctx, [['\0'], ['\u{200d}']]);
    breaks(ctx, [['\0'], ['̈', '\u{200d}']]);
    breaks(ctx, [['\0'], ['🇦']]);
    breaks(ctx, [['\0'], ['̈'], ['🇦']]);
    breaks(ctx, [['\0'], ['\u{6dd}']]);
    breaks(ctx, [['\0'], ['̈'], ['\u{6dd}']]);
    breaks(ctx, [['\0'], ['ः']]);
    breaks(ctx, [['\0'], ['̈', 'ः']]);
    breaks(ctx, [['\0'], ['ᄀ']]);
    breaks(ctx, [['\0'], ['̈'], ['ᄀ']]);
    breaks(ctx, [['\0'], ['ᅠ']]);
    breaks(ctx, [['\0'], ['̈'], ['ᅠ']]);
    breaks(ctx, [['\0'], ['ᆨ']]);
    breaks(ctx, [['\0'], ['̈'], ['ᆨ']]);
    breaks(ctx, [['\0'], ['가']]);
    breaks(ctx, [['\0'], ['̈'], ['가']]);
    breaks(ctx, [['\0'], ['각']]);
    breaks(ctx, [['\0'], ['̈'], ['각']]);
    breaks(ctx, [['\0'], ['क']]);
    breaks(ctx, [['\0'], ['̈'], ['क']]);
    breaks(ctx, [['\0'], ['©']]);
    breaks(ctx, [['\0'], ['̈'], ['©']]);
    breaks(ctx, [['\0'], [' ']]);
    breaks(ctx, [['\0'], ['̈'], [' ']]);
    breaks(ctx, [['\0'], ['\u{378}']]);
    breaks(ctx, [['\0'], ['̈'], ['\u{378}']]);
    breaks(ctx, [['्'], ['\r']]);
    breaks(ctx, [['्', '̈'], ['\r']]);
    breaks(ctx, [['्'], ['\n']]);
    breaks(ctx, [['्', '̈'], ['\n']]);
    breaks(ctx, [['्'], ['\0']]);
    breaks(ctx, [['्', '̈'], ['\0']]);
}

test "grapheme break vectors, 120 to 180" {
    let ctx = context {
        Allocator: alloc(),
    };
    breaks(ctx, [['्', '्']]);
    breaks(ctx, [['्', '̈', '्']]);
    breaks(ctx, [['्', '̀']]);
    breaks(ctx, [['्', '̈', '̀']]);
    breaks(ctx, [['्', '\u{200c}']]);
    breaks(ctx, [['्', '̈', '\u{200c}']]);
    breaks(ctx, [['्', '\u{200d}']]);
    breaks(ctx, [['्', '̈', '\u{200d}']]);
    breaks(ctx, [['्'], ['🇦']]);
    breaks(ctx, [['्', '̈'], ['🇦']]);
    breaks(ctx, [['्'], ['\u{6dd}']]);
    breaks(ctx, [['्', '̈'], ['\u{6dd}']]);
    breaks(ctx, [['्', 'ः']]);
    breaks(ctx, [['्', '̈', 'ः']]);
    breaks(ctx, [['्'], ['ᄀ']]);
    breaks(ctx, [['्', '̈'], ['ᄀ']]);
    breaks(ctx, [['्'], ['ᅠ']]);
    breaks(ctx, [['्', '̈'], ['ᅠ']]);
    breaks(ctx, [['्'], ['ᆨ']]);
    breaks(ctx, [['्', '̈'], ['ᆨ']]);
    breaks(ctx, [['्'], ['가']]);
    breaks(ctx, [['्', '̈'], ['가']]);
    breaks(ctx, [['्'], ['각']]);
    breaks(ctx, [['्', '̈'], ['각']]);
    breaks(ctx, [['्'], ['क']]);
    breaks(ctx, [['्', '̈'], ['क']]);
    breaks(ctx, [['्'], ['©']]);
    breaks(ctx, [['्', '̈'], ['©']]);
    breaks(ctx, [['्'], [' ']]);
    breaks(ctx, [['्', '̈'], [' ']]);
    breaks(ctx, [['्'], ['\u{378}']]);
    breaks(ctx, [['्', '̈'], ['\u{378}']]);
    breaks(ctx, [['̀'], ['\r']]);
    breaks(ctx, [['̀', '̈'], ['\r']]);
    breaks(ctx, [['̀'], ['\n']]);
    breaks(ctx, [['̀', '̈'], ['\n']]);
    breaks(ctx, [['̀'], ['\0']]);
    breaks(ctx, [['̀', '̈'], ['\0']]);
    breaks(ctx, [['̀', '्']]);
    breaks(ctx, [['̀', '̈', '्']]);
    breaks(ctx, [['̀', '̀']]);
    breaks(ctx, [['̀', '̈', '̀']]);
    breaks(ctx, [['̀', '\u{200c}']]);
    breaks(ctx, [['̀', '̈', '\u{200c}']]);
    breaks(ctx, [['̀', '\u{200d}']]);
    breaks(ctx, [['̀', '̈', '\u{200d}']]);
    breaks(ctx, [['̀'], ['🇦']]);
    breaks(ctx, [['̀', '̈'], ['🇦']]);
    breaks(ctx, [['̀'], ['\u{6dd}']]);
    breaks(ctx, [['̀', '̈'], ['\u{6dd}']]);
    breaks(ctx, [['̀', 'ः']]);
    breaks(ctx, [['̀', '̈', 'ः']]);
    breaks(ctx, [['̀'], ['ᄀ']]);
    breaks(ctx, [['̀', '̈'], ['ᄀ']]);
    breaks(ctx, [['̀'], ['ᅠ']]);
