    breaks(ctx, [['͸', 'ः']]);
    breaks(ctx, [['͸', '̈', 'ः']]);
    breaks(ctx, [['͸'], ['ऄ']]);
    breaks(ctx, [['͸', '̈'], ['ऄ']]);
    breaks(ctx, [['͸'], ['ൎ']]);
    breaks(ctx, [['͸', '̈'], ['ൎ']]);
    breaks(ctx, [['͸'], ['क']]);
    breaks(ctx, [['͸', '̈'], ['क']]);
    breaks(ctx, [['͸'], ['⌚']]);
    breaks(ctx, [['͸', '̈'], ['⌚']]);
    breaks(ctx, [['͸', '̀']]);
    breaks(ctx, [['͸', '̈', '̀']]);
    breaks(ctx, [['͸', 'ऀ']]);
    breaks(ctx, [['͸', '̈', 'ऀ']]);
    breaks(ctx, [['͸', '्']]);
    breaks(ctx, [['͸', '̈', '्']]);
    breaks(ctx, [['͸', '‍']]);
    breaks(ctx, [['͸', '̈', '‍']]);
    breaks(ctx, [['͸'], ['͸']]);
    breaks(ctx, [['͸', '̈'], ['͸']]);
    breaks(ctx, [['\r', '\n'], ['a'], ['\n'], ['̈']]);
    breaks(ctx, [['a', '̈']]);
    breaks(ctx, [[' ', '‍'], ['ن']]);
    breaks(ctx, [['ن', '‍'], [' ']]);
    breaks(ctx, [['ᄀ', 'ᄀ']]);
    breaks(ctx, [['가', 'ᆨ'], ['ᄀ']]);
    breaks(ctx, [['각', 'ᆨ'], ['ᄀ']]);
    breaks(ctx, [['🇦', '🇧'], ['🇨'], ['b']]);
    breaks(ctx, [['a'], ['🇦', '🇧'], ['🇨'], ['b']]);
    breaks(ctx, [['a'], ['🇦', '🇧', '‍'], ['🇨'], ['b']]);
    breaks(ctx, [['a'], ['🇦', '‍'], ['🇧', '🇨'], ['b']]);
    breaks(ctx, [['a'], ['🇦', '🇧'], ['🇨', '🇩'], ['b']]);
    breaks(ctx, [['a', '‍']]);
    breaks(ctx, [['a', '̈'], ['b']]);
    breaks(ctx, [['a', 'ः'], ['b']]);
    breaks(ctx, [['a'], ['؀', 'b']]);
    breaks(ctx, [['👶', '🏿'], ['👶']]);
    breaks(ctx, [['a', '🏿'], ['👶']]);
    breaks(ctx, [['a', '🏿'], ['👶', '‍', '🛑']]);
    breaks(ctx, [['👶', '🏿', '̈', '‍', '👶', '🏿']]);
    breaks(ctx, [['🛑', '‍', '🛑']]);
    breaks(ctx, [['a', '‍'], ['🛑']]);
}

test "grapheme break vectors, 1080 to 1093" {
    let ctx = context {
        Alloc: alloc(),
    };
    breaks(ctx, [['✁', '‍', '✁']]);
    breaks(ctx, [['a', '‍'], ['✁']]);
    breaks(ctx, [['क'], ['त']]);
    breaks(ctx, [['क', '्', 'त']]);
    breaks(ctx, [['क', '्', '्', 'त']]);
    breaks(ctx, [['क', '्', '‍', 'त']]);
    breaks(ctx, [['क', '़', '‍', '्', 'त']]);
    breaks(ctx, [['क', '़', '्', '‍', 'त']]);
    breaks(ctx, [['क', '्', 'त', '्', 'य']]);
    breaks(ctx, [['क', '्'], ['a']]);
    breaks(ctx, [['a', '्'], ['त']]);
    breaks(ctx, [['?', '्'], ['त']]);
    breaks(ctx, [['क', '्', '्', 'त']]);
}

// --- The UCD's own normalization vectors --------------------------------------
//
// Every 20th row of `NormalizationTest.txt`, which is 999 of its 19965. The whole
// file passes; the stride is what the suite's clock affords, and it is a stride
// rather than a selection so nothing flattering was picked.

/// One row: the source, then the four forms it takes.
fn forms<C: Alloc>(ctx: C, source: Str, nfc: Str, nfd: Str, nfkc: Str, nfkd: Str): () {
    assert.eq(source.normalize(ctx, .Nfc), nfc);
    assert.eq(source.normalize(ctx, .Nfd), nfd);
    assert.eq(source.normalize(ctx, .Nfkc), nfkc);
    assert.eq(source.normalize(ctx, .Nfkd), nfkd);
}

