    breaks(ctx, [['‍'], ['ऄ']]);
    breaks(ctx, [['‍', '̈'], ['ऄ']]);
    breaks(ctx, [['‍'], ['ൎ']]);
    breaks(ctx, [['‍', '̈'], ['ൎ']]);
    breaks(ctx, [['‍'], ['क']]);
    breaks(ctx, [['‍', '̈'], ['क']]);
    breaks(ctx, [['‍'], ['⌚']]);
    breaks(ctx, [['‍', '̈'], ['⌚']]);
    breaks(ctx, [['‍', '̀']]);
    breaks(ctx, [['‍', '̈', '̀']]);
    breaks(ctx, [['‍', 'ऀ']]);
    breaks(ctx, [['‍', '̈', 'ऀ']]);
    breaks(ctx, [['‍', '्']]);
    breaks(ctx, [['‍', '̈', '्']]);
    breaks(ctx, [['‍', '‍']]);
    breaks(ctx, [['‍', '̈', '‍']]);
    breaks(ctx, [['‍'], ['͸']]);
    breaks(ctx, [['‍', '̈'], ['͸']]);
    breaks(ctx, [['͸'], [' ']]);
    breaks(ctx, [['͸', '̈'], [' ']]);
    breaks(ctx, [['͸'], ['\r']]);
    breaks(ctx, [['͸', '̈'], ['\r']]);
    breaks(ctx, [['͸'], ['\n']]);
    breaks(ctx, [['͸', '̈'], ['\n']]);
    breaks(ctx, [['͸'], ['\u{1}']]);
    breaks(ctx, [['͸', '̈'], ['\u{1}']]);
}

