    assert.eq("\u{caa6}".normalize(ctx, .Nfc), "\u{caa6}");
    assert.eq("\u{caa6}".normalize(ctx, .Nfd), "\u{110d}\u{1168}\u{11ad}");
    assert.eq("\u{caa6}".normalize(ctx, .Nfkc), "\u{caa6}");
    assert.eq("\u{caa6}".normalize(ctx, .Nfkd), "\u{110d}\u{1168}\u{11ad}");
    assert.eq("\u{cbe6}".normalize(ctx, .Nfc), "\u{cbe6}");
    assert.eq("\u{cbe6}".normalize(ctx, .Nfd), "\u{110d}\u{1173}\u{11b9}");
    assert.eq("\u{cbe6}".normalize(ctx, .Nfkc), "\u{cbe6}");
    assert.eq("\u{cbe6}".normalize(ctx, .Nfkd), "\u{110d}\u{1173}\u{11b9}");
    assert.eq("\u{cd26}".normalize(ctx, .Nfc), "\u{cd26}");
    assert.eq("\u{cd26}".normalize(ctx, .Nfd), "\u{110e}\u{116a}\u{11a9}");
    assert.eq("\u{cd26}".normalize(ctx, .Nfkc), "\u{cd26}");
    assert.eq("\u{cd26}".normalize(ctx, .Nfkd), "\u{110e}\u{116a}\u{11a9}");
    assert.eq("\u{ce66}".normalize(ctx, .Nfc), "\u{ce66}");
    assert.eq("\u{ce66}".normalize(ctx, .Nfd), "\u{110e}\u{1175}\u{11b5}");
    assert.eq("\u{ce66}".normalize(ctx, .Nfkc), "\u{ce66}");
    assert.eq("\u{ce66}".normalize(ctx, .Nfkd), "\u{110e}\u{1175}\u{11b5}");
    assert.eq("\u{cfa6}".normalize(ctx, .Nfc), "\u{cfa6}");
    assert.eq("\u{cfa6}".normalize(ctx, .Nfd), "\u{110f}\u{116b}\u{11c1}");
    assert.eq("\u{cfa6}".normalize(ctx, .Nfkc), "\u{cfa6}");
    assert.eq("\u{cfa6}".normalize(ctx, .Nfkd), "\u{110f}\u{116b}\u{11c1}");
    assert.eq("\u{d0e6}".normalize(ctx, .Nfc), "\u{d0e6}");
    assert.eq("\u{d0e6}".normalize(ctx, .Nfd), "\u{1110}\u{1162}\u{11b1}");
    assert.eq("\u{d0e6}".normalize(ctx, .Nfkc), "\u{d0e6}");
    assert.eq("\u{d0e6}".normalize(ctx, .Nfkd), "\u{1110}\u{1162}\u{11b1}");
    assert.eq("\u{d226}".normalize(ctx, .Nfc), "\u{d226}");
    assert.eq("\u{d226}".normalize(ctx, .Nfd), "\u{1110}\u{116d}\u{11bd}");
    assert.eq("\u{d226}".normalize(ctx, .Nfkc), "\u{d226}");
    assert.eq("\u{d226}".normalize(ctx, .Nfkd), "\u{1110}\u{116d}\u{11bd}");
    assert.eq("\u{d366}".normalize(ctx, .Nfc), "\u{d366}");
    assert.eq("\u{d366}".normalize(ctx, .Nfd), "\u{1111}\u{1164}\u{11ad}");
    assert.eq("\u{d366}".normalize(ctx, .Nfkc), "\u{d366}");
    assert.eq("\u{d366}".normalize(ctx, .Nfkd), "\u{1111}\u{1164}\u{11ad}");
}

test "normalization vectors, 40 to 60" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{d4a6}".normalize(ctx, .Nfc), "\u{d4a6}");
    assert.eq("\u{d4a6}".normalize(ctx, .Nfd), "\u{1111}\u{116f}\u{11b9}");
    assert.eq("\u{d4a6}".normalize(ctx, .Nfkc), "\u{d4a6}");
    assert.eq("\u{d4a6}".normalize(ctx, .Nfkd), "\u{1111}\u{116f}\u{11b9}");
    assert.eq("\u{d5e6}".normalize(ctx, .Nfc), "\u{d5e6}");
    assert.eq("\u{d5e6}".normalize(ctx, .Nfd), "\u{1112}\u{1166}\u{11a9}");
    assert.eq("\u{d5e6}".normalize(ctx, .Nfkc), "\u{d5e6}");
    assert.eq("\u{d5e6}".normalize(ctx, .Nfkd), "\u{1112}\u{1166}\u{11a9}");
    assert.eq("\u{d726}".normalize(ctx, .Nfc), "\u{d726}");
    assert.eq("\u{d726}".normalize(ctx, .Nfd), "\u{1112}\u{1171}\u{11b5}");
    assert.eq("\u{d726}".normalize(ctx, .Nfkc), "\u{d726}");
    assert.eq("\u{d726}".normalize(ctx, .Nfkd), "\u{1112}\u{1171}\u{11b5}");
    assert.eq("\u{f9c2}".normalize(ctx, .Nfc), "\u{84fc}");
    assert.eq("\u{f9c2}".normalize(ctx, .Nfd), "\u{84fc}");
    assert.eq("\u{f9c2}".normalize(ctx, .Nfkc), "\u{84fc}");
    assert.eq("\u{f9c2}".normalize(ctx, .Nfkd), "\u{84fc}");
    assert.eq("\u{fb4d}".normalize(ctx, .Nfc), "\u{5db}\u{5bf}");
    assert.eq("\u{fb4d}".normalize(ctx, .Nfd), "\u{5db}\u{5bf}");
    assert.eq("\u{fb4d}".normalize(ctx, .Nfkc), "\u{5db}\u{5bf}");
    assert.eq("\u{fb4d}".normalize(ctx, .Nfkd), "\u{5db}\u{5bf}");
    assert.eq("\u{fcae}".normalize(ctx, .Nfc), "\u{fcae}");
    assert.eq("\u{fcae}".normalize(ctx, .Nfd), "\u{fcae}");
    assert.eq("\u{fcae}".normalize(ctx, .Nfkc), "\u{633}\u{62d}");
    assert.eq("\u{fcae}".normalize(ctx, .Nfkd), "\u{633}\u{62d}");
    assert.eq("\u{fe56}".normalize(ctx, .Nfc), "\u{fe56}");
    assert.eq("\u{fe56}".normalize(ctx, .Nfd), "\u{fe56}");
    assert.eq("\u{fe56}".normalize(ctx, .Nfkc), "\u{3f}");
    assert.eq("\u{fe56}".normalize(ctx, .Nfkd), "\u{3f}");
    assert.eq("\u{ffa1}".normalize(ctx, .Nfc), "\u{ffa1}");
    assert.eq("\u{ffa1}".normalize(ctx, .Nfd), "\u{ffa1}");
    assert.eq("\u{ffa1}".normalize(ctx, .Nfkc), "\u{1100}");
    assert.eq("\u{ffa1}".normalize(ctx, .Nfkd), "\u{1100}");
    assert.eq("\u{1d476}".normalize(ctx, .Nfc), "\u{1d476}");
    assert.eq("\u{1d476}".normalize(ctx, .Nfd), "\u{1d476}");
    assert.eq("\u{1d476}".normalize(ctx, .Nfkc), "\u{4f}");
    assert.eq("\u{1d476}".normalize(ctx, .Nfkd), "\u{4f}");
    assert.eq("\u{1d5cd}".normalize(ctx, .Nfc), "\u{1d5cd}");
    assert.eq("\u{1d5cd}".normalize(ctx, .Nfd), "\u{1d5cd}");
    assert.eq("\u{1d5cd}".normalize(ctx, .Nfkc), "\u{74}");
    assert.eq("\u{1d5cd}".normalize(ctx, .Nfkd), "\u{74}");
    assert.eq("\u{1d70f}".normalize(ctx, .Nfc), "\u{1d70f}");
    assert.eq("\u{1d70f}".normalize(ctx, .Nfd), "\u{1d70f}");
    assert.eq("\u{1d70f}".normalize(ctx, .Nfkc), "\u{3c4}");
    assert.eq("\u{1d70f}".normalize(ctx, .Nfkd), "\u{3c4}");
    assert.eq("\u{1ee14}".normalize(ctx, .Nfc), "\u{1ee14}");
    assert.eq("\u{1ee14}".normalize(ctx, .Nfd), "\u{1ee14}");
    assert.eq("\u{1ee14}".normalize(ctx, .Nfkc), "\u{634}");
    assert.eq("\u{1ee14}".normalize(ctx, .Nfkd), "\u{634}");
    assert.eq("\u{2f834}".normalize(ctx, .Nfc), "\u{20a2c}");
    assert.eq("\u{2f834}".normalize(ctx, .Nfd), "\u{20a2c}");
    assert.eq("\u{2f834}".normalize(ctx, .Nfkc), "\u{20a2c}");
    assert.eq("\u{2f834}".normalize(ctx, .Nfkd), "\u{20a2c}");
    assert.eq("\u{2f974}".normalize(ctx, .Nfc), "\u{4359}");
    assert.eq("\u{2f974}".normalize(ctx, .Nfd), "\u{4359}");
    assert.eq("\u{2f974}".normalize(ctx, .Nfkc), "\u{4359}");
    assert.eq("\u{2f974}".normalize(ctx, .Nfkd), "\u{4359}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{34b}\u{62}".normalize(ctx, .Nfc), "\u{e0}\u{5ae}\u{34b}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{34b}\u{62}".normalize(ctx, .Nfd), "\u{61}\u{5ae}\u{300}\u{34b}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{34b}\u{62}".normalize(ctx, .Nfkc), "\u{e0}\u{5ae}\u{34b}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{34b}\u{62}".normalize(ctx, .Nfkd), "\u{61}\u{5ae}\u{300}\u{34b}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{73f}\u{62}".normalize(ctx, .Nfc), "\u{e0}\u{5ae}\u{73f}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{73f}\u{62}".normalize(ctx, .Nfd), "\u{61}\u{5ae}\u{300}\u{73f}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{73f}\u{62}".normalize(ctx, .Nfkc), "\u{e0}\u{5ae}\u{73f}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{73f}\u{62}".normalize(ctx, .Nfkd), "\u{61}\u{5ae}\u{300}\u{73f}\u{315}\u{62}");
    assert.eq("\u{61}\u{f74}\u{f72}\u{f71}\u{f80}\u{62}".normalize(ctx, .Nfc), "\u{61}\u{f71}\u{f72}\u{f80}\u{f74}\u{62}");
    assert.eq("\u{61}\u{f74}\u{f72}\u{f71}\u{f80}\u{62}".normalize(ctx, .Nfd), "\u{61}\u{f71}\u{f72}\u{f80}\u{f74}\u{62}");
    assert.eq("\u{61}\u{f74}\u{f72}\u{f71}\u{f80}\u{62}".normalize(ctx, .Nfkc), "\u{61}\u{f71}\u{f72}\u{f80}\u{f74}\u{62}");
    assert.eq("\u{61}\u{f74}\u{f72}\u{f71}\u{f80}\u{62}".normalize(ctx, .Nfkd), "\u{61}\u{f71}\u{f72}\u{f80}\u{f74}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1df3}\u{62}".normalize(ctx, .Nfc), "\u{e0}\u{5ae}\u{1df3}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1df3}\u{62}".normalize(ctx, .Nfd), "\u{61}\u{5ae}\u{300}\u{1df3}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1df3}\u{62}".normalize(ctx, .Nfkc), "\u{e0}\u{5ae}\u{1df3}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1df3}\u{62}".normalize(ctx, .Nfkd), "\u{61}\u{5ae}\u{300}\u{1df3}\u{315}\u{62}");
    assert.eq("\u{61}\u{59a}\u{316}\u{1dfa}\u{10a0d}\u{62}".normalize(ctx, .Nfc), "\u{61}\u{1dfa}\u{316}\u{10a0d}\u{59a}\u{62}");
    assert.eq("\u{61}\u{59a}\u{316}\u{1dfa}\u{10a0d}\u{62}".normalize(ctx, .Nfd), "\u{61}\u{1dfa}\u{316}\u{10a0d}\u{59a}\u{62}");
    assert.eq("\u{61}\u{59a}\u{316}\u{1dfa}\u{10a0d}\u{62}".normalize(ctx, .Nfkc), "\u{61}\u{1dfa}\u{316}\u{10a0d}\u{59a}\u{62}");
    assert.eq("\u{61}\u{59a}\u{316}\u{1dfa}\u{10a0d}\u{62}".normalize(ctx, .Nfkd), "\u{61}\u{1dfa}\u{316}\u{10a0d}\u{59a}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1e00d}\u{62}".normalize(ctx, .Nfc), "\u{e0}\u{5ae}\u{1e00d}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1e00d}\u{62}".normalize(ctx, .Nfd), "\u{61}\u{5ae}\u{300}\u{1e00d}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1e00d}\u{62}".normalize(ctx, .Nfkc), "\u{e0}\u{5ae}\u{1e00d}\u{315}\u{62}");
    assert.eq("\u{61}\u{315}\u{300}\u{5ae}\u{1e00d}\u{62}".normalize(ctx, .Nfkd), "\u{61}\u{5ae}\u{300}\u{1e00d}\u{315}\u{62}");
}

test "normalization vectors, 60 to 63" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{dc}\u{30c}".normalize(ctx, .Nfc), "\u{1d9}");
    assert.eq("\u{dc}\u{30c}".normalize(ctx, .Nfd), "\u{55}\u{308}\u{30c}");
    assert.eq("\u{dc}\u{30c}".normalize(ctx, .Nfkc), "\u{1d9}");
    assert.eq("\u{dc}\u{30c}".normalize(ctx, .Nfkd), "\u{55}\u{308}\u{30c}");
    assert.eq("\u{1f68}\u{300}".normalize(ctx, .Nfc), "\u{1f6a}");
    assert.eq("\u{1f68}\u{300}".normalize(ctx, .Nfd), "\u{3a9}\u{313}\u{300}");
    assert.eq("\u{1f68}\u{300}".normalize(ctx, .Nfkc), "\u{1f6a}");
    assert.eq("\u{1f68}\u{300}".normalize(ctx, .Nfkd), "\u{3a9}\u{313}\u{300}");
    assert.eq("\u{1f68}\u{345}\u{301}".normalize(ctx, .Nfc), "\u{1fac}");
    assert.eq("\u{1f68}\u{345}\u{301}".normalize(ctx, .Nfd), "\u{3a9}\u{313}\u{301}\u{345}");
    assert.eq("\u{1f68}\u{345}\u{301}".normalize(ctx, .Nfkc), "\u{1fac}");
    assert.eq("\u{1f68}\u{345}\u{301}".normalize(ctx, .Nfkd), "\u{3a9}\u{313}\u{301}\u{345}");
}
