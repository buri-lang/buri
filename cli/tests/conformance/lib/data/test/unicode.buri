// core/str beyond the scalar — grapheme clusters, the four normalization forms,
// and full case folding.
//
// The tables these read are generated at **Unicode 16.0** by
// `cli/src/compiler/standard_library/unicode_tables.py`, so the two sets of
// cases below are the two things worth asserting: the rules, named one at a
// time, and the UCD's own vectors, sliced.

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/str" import { Normalization };
from "core/testing/assert" import * as assert;

// --- graphemes ------------------------------------------------------------------

test "graphemes of ASCII is one piece per character" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".graphemes(ctx), ["a", "b", "c"]);
    assert.eq("a b".graphemes(ctx), ["a", " ", "b"]);
}

test "graphemes of the empty string has no pieces" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isEmpty("".graphemes(ctx));
    assert.eq("".graphemeCount(), 0);
}

test "a combining mark stays with the letter it is on" {
    let ctx = context {
        Alloc: alloc(),
    };
    let text = "e\u{301}a";
    assert.eq(text.graphemes(ctx), ["e\u{301}", "a"]);
    assert.eq(text.graphemeCount(), 2);
    assert.eq(text.len(), 3);
}

// GB3: a carriage return and a line feed are one cluster, and everything else
// around them is not.
test "CR LF is one cluster" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\r\n".graphemes(ctx), ["\r\n"]);
    assert.eq("a\r\nb".graphemeCount(), 3);
    assert.eq("\n\r".graphemeCount(), 2);
    assert.eq("\r\r".graphemeCount(), 2);
}

// GB11: an emoji, any number of extenders, a zero-width joiner and another
// emoji are one cluster however long the chain.
test "a zero-width joiner sequence is one cluster" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f466}".graphemeCount(), 1);
    assert.eq("\u{1f44d}\u{1f3fd}".graphemeCount(), 1);
    assert.eq("\u{1f468}\u{1f469}".graphemeCount(), 2);
}

// GB12 and GB13: regional indicators pair up, so a flag is one cluster and an
// odd one left over is its own.
test "regional indicators pair into flags" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{1f1ec}\u{1f1e7}".graphemeCount(), 1);
    assert.eq("\u{1f1ec}\u{1f1e7}\u{1f1eb}\u{1f1f7}".graphemeCount(), 2);
    assert.eq("\u{1f1ec}\u{1f1e7}\u{1f1eb}".graphemeCount(), 2);
    assert.eq("\u{1f1ec}".graphemeCount(), 1);
}

// GB9c, which arrived in Unicode 15.1: a consonant, a virama and a consonant
// are one cluster.
test "an Indic conjunct is one cluster" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{915}\u{94d}\u{937}\u{93f}".graphemeCount(), 1);
    assert.eq("\u{915}\u{937}".graphemeCount(), 2);
}

// GB6 to GB8: a Hangul syllable written as jamo is one cluster.
test "Hangul jamo make one syllable" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{1112}\u{1161}\u{11ab}".graphemeCount(), 1);
    assert.eq("한".graphemeCount(), 1);
    assert.eq("한글".graphemeCount(), 2);
}

test "graphemeCount agrees with graphemes" {
    let ctx = context {
        Alloc: alloc(),
    };
    let text = "a\u{301}\r\n\u{1f1ec}\u{1f1e7}\u{1f468}\u{200d}\u{1f469}z";
    assert.eq(text.graphemeCount(), text.graphemes(ctx).len());
    assert.eq(text.graphemeCount(), 5);
}

// --- normalize --------------------------------------------------------------------

test "Nfc composes and Nfd decomposes" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("e\u{301}".normalize(ctx, .Nfc), "é");
    assert.eq("é".normalize(ctx, .Nfd), "e\u{301}");
    assert.eq("é".normalize(ctx, .Nfc), "é");
    assert.eq("e\u{301}".normalize(ctx, .Nfd), "e\u{301}");
}

test "text with nothing to normalize comes back as it was" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("abc".normalize(ctx, .Nfc), "abc");
    assert.eq("abc".normalize(ctx, .Nfd), "abc");
    assert.eq("abc".normalize(ctx, .Nfkc), "abc");
    assert.eq("abc".normalize(ctx, .Nfkd), "abc");
    assert.eq("".normalize(ctx, .Nfc), "");
    assert.eq("".normalize(ctx, .Nfkd), "");
}

// The compatibility forms lose distinctions on purpose, and the canonical ones
// keep them: that is the whole difference between the two pairs.
test "the compatibility forms fold a ligature and a superscript" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ﬁ".normalize(ctx, .Nfkc), "fi");
    assert.eq("ﬁ".normalize(ctx, .Nfkd), "fi");
    assert.eq("ﬁ".normalize(ctx, .Nfc), "ﬁ");
    assert.eq("²".normalize(ctx, .Nfkc), "2");
    assert.eq("²".normalize(ctx, .Nfc), "²");
}

// Canonical ordering: two marks with different combining classes come out in
// class order whichever way round they were written.
test "combining marks are reordered by class" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("q\u{307}\u{323}".normalize(ctx, .Nfd), "q\u{323}\u{307}");
    assert.eq("q\u{323}\u{307}".normalize(ctx, .Nfd), "q\u{323}\u{307}");
    assert.eq("q\u{307}\u{323}".normalize(ctx, .Nfc), "q\u{323}\u{307}");
}

test "Hangul composes and decomposes by arithmetic" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("한".normalize(ctx, .Nfd), "\u{1112}\u{1161}\u{11ab}");
    assert.eq("\u{1112}\u{1161}\u{11ab}".normalize(ctx, .Nfc), "한");
    assert.eq("가".normalize(ctx, .Nfd), "\u{1100}\u{1161}");
    assert.eq("\u{1100}\u{1161}".normalize(ctx, .Nfc), "가");
    assert.eq("한글".normalize(ctx, .Nfc), "한글");
}

// A composition exclusion is a character NFC will not put back together, and
// U+0344 is one of the ones a naive implementation gets wrong.
test "a composition exclusion is not recomposed" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{1e9b}\u{323}".normalize(ctx, .Nfc), "\u{1e9b}\u{323}");
    assert.eq("\u{1e9b}\u{323}".normalize(ctx, .Nfd), "\u{17f}\u{323}\u{307}");
    assert.eq("\u{1e9b}\u{323}".normalize(ctx, .Nfkc), "\u{1e69}");
    assert.eq("\u{1e9b}\u{323}".normalize(ctx, .Nfkd), "s\u{323}\u{307}");
}

test "Normalization is a value that compares and renders" {
    let form: Normalization = .Nfc;
    assert.eq(form, .Nfc);
    assert.notEq(form, .Nfd);
}

// --- caseFold ---------------------------------------------------------------------

test "caseFold lowercases the ASCII letters" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("ABC".caseFold(ctx), "abc");
    assert.eq("abc".caseFold(ctx), "abc");
    assert.eq("A1b!".caseFold(ctx), "a1b!");
    assert.eq("".caseFold(ctx), "");
}

// Full folding, so a folding may be longer than what it folded — which is the
// whole difference from `equalsIgnoreCase`.
test "caseFold expands where the folding is more than one scalar" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("Straße".caseFold(ctx), "strasse");
    assert.eq("STRASSE".caseFold(ctx), "strasse");
    assert.eq("ﬁ".caseFold(ctx), "fi");
    assert.isFalse("straße".equalsIgnoreCase("strasse"));
}

test "caseFold brings both sigmas together" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("Σ".caseFold(ctx), "σ");
    assert.eq("σ".caseFold(ctx), "σ");
    assert.eq("ς".caseFold(ctx), "σ");
}

test "caseFold is idempotent" {
    let ctx = context {
        Alloc: alloc(),
    };
    let once = "Straße ΣΣ ﬁ".caseFold(ctx);
    assert.eq(once.caseFold(ctx), once);
}

// --- The UCD's own break vectors ---------------------------------------------
//
// Every ninth line of `GraphemeBreakTest.txt` at Unicode 16.0, which is the
// file `unicode_tables.py` names. The whole file passes; this is the slice
// that is worth a suite's time, and it is a slice rather than a selection so
// nothing flattering was picked.

test "grapheme break vectors, 0 to 34" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{20}\u{20}".graphemes(ctx), ["\u{20}", "\u{20}"]);
    assert.eq("\u{20}\u{20}".graphemeCount(), 2);
    assert.eq("\u{20}\u{308}\u{200c}".graphemes(ctx), ["\u{20}\u{308}\u{200c}"]);
    assert.eq("\u{20}\u{308}\u{200c}".graphemeCount(), 1);
    assert.eq("\u{20}\u{1160}".graphemes(ctx), ["\u{20}", "\u{1160}"]);
    assert.eq("\u{20}\u{1160}".graphemeCount(), 2);
    assert.eq("\u{20}\u{308}\u{903}".graphemes(ctx), ["\u{20}\u{308}\u{903}"]);
    assert.eq("\u{20}\u{308}\u{903}".graphemeCount(), 1);
    assert.eq("\u{20}\u{300}".graphemes(ctx), ["\u{20}\u{300}"]);
    assert.eq("\u{20}\u{300}".graphemeCount(), 1);
    assert.eq("\u{20}\u{308}\u{378}".graphemes(ctx), ["\u{20}\u{308}", "\u{378}"]);
    assert.eq("\u{20}\u{308}\u{378}".graphemeCount(), 2);
    assert.eq("\u{d}\u{200c}".graphemes(ctx), ["\u{d}", "\u{200c}"]);
    assert.eq("\u{d}\u{200c}".graphemeCount(), 2);
    assert.eq("\u{d}\u{308}\u{1100}".graphemes(ctx), ["\u{d}", "\u{308}", "\u{1100}"]);
    assert.eq("\u{d}\u{308}\u{1100}".graphemeCount(), 3);
    assert.eq("\u{d}\u{903}".graphemes(ctx), ["\u{d}", "\u{903}"]);
    assert.eq("\u{d}\u{903}".graphemeCount(), 2);
    assert.eq("\u{d}\u{308}\u{231a}".graphemes(ctx), ["\u{d}", "\u{308}", "\u{231a}"]);
    assert.eq("\u{d}\u{308}\u{231a}".graphemeCount(), 3);
    assert.eq("\u{d}\u{378}".graphemes(ctx), ["\u{d}", "\u{378}"]);
    assert.eq("\u{d}\u{378}".graphemeCount(), 2);
    assert.eq("\u{a}\u{308}\u{1}".graphemes(ctx), ["\u{a}", "\u{308}", "\u{1}"]);
    assert.eq("\u{a}\u{308}\u{1}".graphemeCount(), 3);
    assert.eq("\u{a}\u{1100}".graphemes(ctx), ["\u{a}", "\u{1100}"]);
    assert.eq("\u{a}\u{1100}".graphemeCount(), 2);
    assert.eq("\u{a}\u{308}\u{ac01}".graphemes(ctx), ["\u{a}", "\u{308}", "\u{ac01}"]);
    assert.eq("\u{a}\u{308}\u{ac01}".graphemeCount(), 3);
    assert.eq("\u{a}\u{231a}".graphemes(ctx), ["\u{a}", "\u{231a}"]);
    assert.eq("\u{a}\u{231a}".graphemeCount(), 2);
    assert.eq("\u{a}\u{308}\u{200d}".graphemes(ctx), ["\u{a}", "\u{308}\u{200d}"]);
    assert.eq("\u{a}\u{308}\u{200d}".graphemeCount(), 2);
    assert.eq("\u{1}\u{1}".graphemes(ctx), ["\u{1}", "\u{1}"]);
    assert.eq("\u{1}\u{1}".graphemeCount(), 2);
    assert.eq("\u{1}\u{308}\u{a03}".graphemes(ctx), ["\u{1}", "\u{308}\u{a03}"]);
    assert.eq("\u{1}\u{308}\u{a03}".graphemeCount(), 2);
    assert.eq("\u{1}\u{ac01}".graphemes(ctx), ["\u{1}", "\u{ac01}"]);
    assert.eq("\u{1}\u{ac01}".graphemeCount(), 2);
    assert.eq("\u{1}\u{308}\u{915}".graphemes(ctx), ["\u{1}", "\u{308}", "\u{915}"]);
    assert.eq("\u{1}\u{308}\u{915}".graphemeCount(), 3);
    assert.eq("\u{1}\u{200d}".graphemes(ctx), ["\u{1}", "\u{200d}"]);
    assert.eq("\u{1}\u{200d}".graphemeCount(), 2);
    assert.eq("\u{200c}\u{308}\u{a}".graphemes(ctx), ["\u{200c}\u{308}", "\u{a}"]);
    assert.eq("\u{200c}\u{308}\u{a}".graphemeCount(), 2);
    assert.eq("\u{200c}\u{a03}".graphemes(ctx), ["\u{200c}\u{a03}"]);
    assert.eq("\u{200c}\u{a03}".graphemeCount(), 1);
    assert.eq("\u{200c}\u{308}\u{ac00}".graphemes(ctx), ["\u{200c}\u{308}", "\u{ac00}"]);
    assert.eq("\u{200c}\u{308}\u{ac00}".graphemeCount(), 2);
    assert.eq("\u{200c}\u{915}".graphemes(ctx), ["\u{200c}", "\u{915}"]);
    assert.eq("\u{200c}\u{915}".graphemeCount(), 2);
    assert.eq("\u{200c}\u{308}\u{94d}".graphemes(ctx), ["\u{200c}\u{308}\u{94d}"]);
    assert.eq("\u{200c}\u{308}\u{94d}".graphemeCount(), 1);
    assert.eq("\u{1f1e6}\u{a}".graphemes(ctx), ["\u{1f1e6}", "\u{a}"]);
    assert.eq("\u{1f1e6}\u{a}".graphemeCount(), 2);
    assert.eq("\u{1f1e6}\u{308}\u{600}".graphemes(ctx), ["\u{1f1e6}\u{308}", "\u{600}"]);
    assert.eq("\u{1f1e6}\u{308}\u{600}".graphemeCount(), 2);
    assert.eq("\u{1f1e6}\u{ac00}".graphemes(ctx), ["\u{1f1e6}", "\u{ac00}"]);
    assert.eq("\u{1f1e6}\u{ac00}".graphemeCount(), 2);
    assert.eq("\u{1f1e6}\u{308}\u{d4e}".graphemes(ctx), ["\u{1f1e6}\u{308}", "\u{d4e}"]);
    assert.eq("\u{1f1e6}\u{308}\u{d4e}".graphemeCount(), 2);
    assert.eq("\u{1f1e6}\u{94d}".graphemes(ctx), ["\u{1f1e6}\u{94d}"]);
    assert.eq("\u{1f1e6}\u{94d}".graphemeCount(), 1);
    assert.eq("\u{600}\u{308}\u{d}".graphemes(ctx), ["\u{600}\u{308}", "\u{d}"]);
    assert.eq("\u{600}\u{308}\u{d}".graphemeCount(), 2);
    assert.eq("\u{600}\u{600}".graphemes(ctx), ["\u{600}\u{600}"]);
    assert.eq("\u{600}\u{600}".graphemeCount(), 1);
    assert.eq("\u{600}\u{308}\u{11a8}".graphemes(ctx), ["\u{600}\u{308}", "\u{11a8}"]);
    assert.eq("\u{600}\u{308}\u{11a8}".graphemeCount(), 2);
}

test "grapheme break vectors, 34 to 68" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{600}\u{d4e}".graphemes(ctx), ["\u{600}\u{d4e}"]);
    assert.eq("\u{600}\u{d4e}".graphemeCount(), 1);
    assert.eq("\u{600}\u{308}\u{900}".graphemes(ctx), ["\u{600}\u{308}\u{900}"]);
    assert.eq("\u{600}\u{308}\u{900}".graphemeCount(), 1);
    assert.eq("\u{a03}\u{d}".graphemes(ctx), ["\u{a03}", "\u{d}"]);
    assert.eq("\u{a03}\u{d}".graphemeCount(), 2);
    assert.eq("\u{a03}\u{308}\u{1f1e6}".graphemes(ctx), ["\u{a03}\u{308}", "\u{1f1e6}"]);
    assert.eq("\u{a03}\u{308}\u{1f1e6}".graphemeCount(), 2);
    assert.eq("\u{a03}\u{11a8}".graphemes(ctx), ["\u{a03}", "\u{11a8}"]);
    assert.eq("\u{a03}\u{11a8}".graphemeCount(), 2);
    assert.eq("\u{a03}\u{308}\u{904}".graphemes(ctx), ["\u{a03}\u{308}", "\u{904}"]);
    assert.eq("\u{a03}\u{308}\u{904}".graphemeCount(), 2);
    assert.eq("\u{a03}\u{900}".graphemes(ctx), ["\u{a03}\u{900}"]);
    assert.eq("\u{a03}\u{900}".graphemeCount(), 1);
    assert.eq("\u{1100}\u{308}\u{20}".graphemes(ctx), ["\u{1100}\u{308}", "\u{20}"]);
    assert.eq("\u{1100}\u{308}\u{20}".graphemeCount(), 2);
    assert.eq("\u{1100}\u{1f1e6}".graphemes(ctx), ["\u{1100}", "\u{1f1e6}"]);
    assert.eq("\u{1100}\u{1f1e6}".graphemeCount(), 2);
    assert.eq("\u{1100}\u{308}\u{1160}".graphemes(ctx), ["\u{1100}\u{308}", "\u{1160}"]);
    assert.eq("\u{1100}\u{308}\u{1160}".graphemeCount(), 2);
    assert.eq("\u{1100}\u{904}".graphemes(ctx), ["\u{1100}", "\u{904}"]);
    assert.eq("\u{1100}\u{904}".graphemeCount(), 2);
    assert.eq("\u{1100}\u{308}\u{300}".graphemes(ctx), ["\u{1100}\u{308}\u{300}"]);
    assert.eq("\u{1100}\u{308}\u{300}".graphemeCount(), 1);
    assert.eq("\u{1160}\u{20}".graphemes(ctx), ["\u{1160}", "\u{20}"]);
    assert.eq("\u{1160}\u{20}".graphemeCount(), 2);
    assert.eq("\u{1160}\u{308}\u{200c}".graphemes(ctx), ["\u{1160}\u{308}\u{200c}"]);
    assert.eq("\u{1160}\u{308}\u{200c}".graphemeCount(), 1);
    assert.eq("\u{1160}\u{1160}".graphemes(ctx), ["\u{1160}\u{1160}"]);
    assert.eq("\u{1160}\u{1160}".graphemeCount(), 1);
    assert.eq("\u{1160}\u{308}\u{903}".graphemes(ctx), ["\u{1160}\u{308}\u{903}"]);
    assert.eq("\u{1160}\u{308}\u{903}".graphemeCount(), 1);
    assert.eq("\u{1160}\u{300}".graphemes(ctx), ["\u{1160}\u{300}"]);
    assert.eq("\u{1160}\u{300}".graphemeCount(), 1);
    assert.eq("\u{1160}\u{308}\u{378}".graphemes(ctx), ["\u{1160}\u{308}", "\u{378}"]);
    assert.eq("\u{1160}\u{308}\u{378}".graphemeCount(), 2);
    assert.eq("\u{11a8}\u{200c}".graphemes(ctx), ["\u{11a8}\u{200c}"]);
    assert.eq("\u{11a8}\u{200c}".graphemeCount(), 1);
    assert.eq("\u{11a8}\u{308}\u{1100}".graphemes(ctx), ["\u{11a8}\u{308}", "\u{1100}"]);
    assert.eq("\u{11a8}\u{308}\u{1100}".graphemeCount(), 2);
    assert.eq("\u{11a8}\u{903}".graphemes(ctx), ["\u{11a8}\u{903}"]);
    assert.eq("\u{11a8}\u{903}".graphemeCount(), 1);
    assert.eq("\u{11a8}\u{308}\u{231a}".graphemes(ctx), ["\u{11a8}\u{308}", "\u{231a}"]);
    assert.eq("\u{11a8}\u{308}\u{231a}".graphemeCount(), 2);
    assert.eq("\u{11a8}\u{378}".graphemes(ctx), ["\u{11a8}", "\u{378}"]);
    assert.eq("\u{11a8}\u{378}".graphemeCount(), 2);
    assert.eq("\u{ac00}\u{308}\u{1}".graphemes(ctx), ["\u{ac00}\u{308}", "\u{1}"]);
    assert.eq("\u{ac00}\u{308}\u{1}".graphemeCount(), 2);
    assert.eq("\u{ac00}\u{1100}".graphemes(ctx), ["\u{ac00}", "\u{1100}"]);
    assert.eq("\u{ac00}\u{1100}".graphemeCount(), 2);
    assert.eq("\u{ac00}\u{308}\u{ac01}".graphemes(ctx), ["\u{ac00}\u{308}", "\u{ac01}"]);
    assert.eq("\u{ac00}\u{308}\u{ac01}".graphemeCount(), 2);
    assert.eq("\u{ac00}\u{231a}".graphemes(ctx), ["\u{ac00}", "\u{231a}"]);
    assert.eq("\u{ac00}\u{231a}".graphemeCount(), 2);
    assert.eq("\u{ac00}\u{308}\u{200d}".graphemes(ctx), ["\u{ac00}\u{308}\u{200d}"]);
    assert.eq("\u{ac00}\u{308}\u{200d}".graphemeCount(), 1);
    assert.eq("\u{ac01}\u{1}".graphemes(ctx), ["\u{ac01}", "\u{1}"]);
    assert.eq("\u{ac01}\u{1}".graphemeCount(), 2);
    assert.eq("\u{ac01}\u{308}\u{a03}".graphemes(ctx), ["\u{ac01}\u{308}\u{a03}"]);
    assert.eq("\u{ac01}\u{308}\u{a03}".graphemeCount(), 1);
    assert.eq("\u{ac01}\u{ac01}".graphemes(ctx), ["\u{ac01}", "\u{ac01}"]);
    assert.eq("\u{ac01}\u{ac01}".graphemeCount(), 2);
    assert.eq("\u{ac01}\u{308}\u{915}".graphemes(ctx), ["\u{ac01}\u{308}", "\u{915}"]);
    assert.eq("\u{ac01}\u{308}\u{915}".graphemeCount(), 2);
    assert.eq("\u{ac01}\u{200d}".graphemes(ctx), ["\u{ac01}\u{200d}"]);
    assert.eq("\u{ac01}\u{200d}".graphemeCount(), 1);
    assert.eq("\u{903}\u{308}\u{a}".graphemes(ctx), ["\u{903}\u{308}", "\u{a}"]);
    assert.eq("\u{903}\u{308}\u{a}".graphemeCount(), 2);
}

test "grapheme break vectors, 68 to 102" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq("\u{903}\u{a03}".graphemes(ctx), ["\u{903}\u{a03}"]);
    assert.eq("\u{903}\u{a03}".graphemeCount(), 1);
    assert.eq("\u{903}\u{308}\u{ac00}".graphemes(ctx), ["\u{903}\u{308}", "\u{ac00}"]);
    assert.eq("\u{903}\u{308}\u{ac00}".graphemeCount(), 2);
    assert.eq("\u{903}\u{915}".graphemes(ctx), ["\u{903}", "\u{915}"]);
    assert.eq("\u{903}\u{915}".graphemeCount(), 2);
    assert.eq("\u{903}\u{308}\u{94d}".graphemes(ctx), ["\u{903}\u{308}\u{94d}"]);
    assert.eq("\u{903}\u{308}\u{94d}".graphemeCount(), 1);
    assert.eq("\u{904}\u{a}".graphemes(ctx), ["\u{904}", "\u{a}"]);
    assert.eq("\u{904}\u{a}".graphemeCount(), 2);
