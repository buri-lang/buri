// --- The UCD's own normalization vectors --------------------------------------
//
// Every 20th row of `NormalizationTest.txt`, which is 1002 of its 20034. The whole
// file passes; the stride is what the suite's clock affords, and it is a stride
// rather than a selection so nothing flattering was picked.
//
// A thousand rows cost about two and a half seconds of the
// conformance run. All 20034 would be twenty times that on each of the two
// backends the corpus goes through, which is most of the suite's five-minute
// bar for one file -- so the stride stays, and the break vectors above, which
// are cheaper per case, are complete instead.

/// One row: the source, then the four forms it takes.
fn forms<C: Allocator>(
    ctx: C,
    source: Str,
    nfc: Str,
    nfd: Str,
    nfkc: Str,
    nfkd: Str,
): () {
    assert.equal(source.normalize(ctx, .Nfc), nfc);
    assert.equal(source.normalize(ctx, .Nfd), nfd);
    assert.equal(source.normalize(ctx, .Nfkc), nfkc);
    assert.equal(source.normalize(ctx, .Nfkd), nfkd);
}

