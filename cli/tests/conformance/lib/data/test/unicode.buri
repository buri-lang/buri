    assert.eq("\u{b6a6}".normalize(ctx, .Nfd), "\u{1104}\u{116e}\u{11b1}");
    assert.eq("\u{b6a6}".normalize(ctx, .Nfkc), "\u{b6a6}");
    assert.eq("\u{b6a6}".normalize(ctx, .Nfkd), "\u{1104}\u{116e}\u{11b1}");
    assert.eq("\u{b7e6}".normalize(ctx, .Nfc), "\u{b7e6}");
    assert.eq("\u{b7e6}".normalize(ctx, .Nfd), "\u{1105}\u{1164}\u{11bd}");
    assert.eq("\u{b7e6}".normalize(ctx, .Nfkc), "\u{b7e6}");
    assert.eq("\u{b7e6}".normalize(ctx, .Nfkd), "\u{1105}\u{1164}\u{11bd}");
    assert.eq("\u{b926}".normalize(ctx, .Nfc), "\u{b926}");
    assert.eq("\u{b926}".normalize(ctx, .Nfd), "\u{1105}\u{1170}\u{11ad}");
    assert.eq("\u{b926}".normalize(ctx, .Nfkc), "\u{b926}");
    assert.eq("\u{b926}".normalize(ctx, .Nfkd), "\u{1105}\u{1170}\u{11ad}");
