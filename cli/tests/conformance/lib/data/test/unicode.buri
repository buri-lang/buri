test "grapheme break vectors, 180 to 240" {
    let ctx = context {
        Alloc: alloc(),
    };
    breaks(ctx, [['\u{1}'], ['‍']]);
    breaks(ctx, [['\u{1}'], ['̈', '‍']]);
    breaks(ctx, [['\u{1}'], ['͸']]);
    breaks(ctx, [['\u{1}'], ['̈'], ['͸']]);
    breaks(ctx, [['‌'], [' ']]);
    breaks(ctx, [['‌', '̈'], [' ']]);
    breaks(ctx, [['‌'], ['\r']]);
    breaks(ctx, [['‌', '̈'], ['\r']]);
    breaks(ctx, [['‌'], ['\n']]);
    breaks(ctx, [['‌', '̈'], ['\n']]);
    breaks(ctx, [['‌'], ['\u{1}']]);
    breaks(ctx, [['‌', '̈'], ['\u{1}']]);
    breaks(ctx, [['‌', '‌']]);
    breaks(ctx, [['‌', '̈', '‌']]);
    breaks(ctx, [['‌'], ['🇦']]);
    breaks(ctx, [['‌', '̈'], ['🇦']]);
    breaks(ctx, [['‌'], ['؀']]);
    breaks(ctx, [['‌', '̈'], ['؀']]);
    breaks(ctx, [['‌', 'ਃ']]);
    breaks(ctx, [['‌', '̈', 'ਃ']]);
    breaks(ctx, [['‌'], ['ᄀ']]);
    breaks(ctx, [['‌', '̈'], ['ᄀ']]);
    breaks(ctx, [['‌'], ['ᅠ']]);
    breaks(ctx, [['‌', '̈'], ['ᅠ']]);
    breaks(ctx, [['‌'], ['ᆨ']]);
    breaks(ctx, [['‌', '̈'], ['ᆨ']]);
    breaks(ctx, [['‌'], ['가']]);
    breaks(ctx, [['‌', '̈'], ['가']]);
