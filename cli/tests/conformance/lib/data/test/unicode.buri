    assert.eq("\u{ba66}".normalize(ctx, .Nfd), "\u{1106}\u{1166}\u{11b9}");
    assert.eq("\u{ba66}".normalize(ctx, .Nfkc), "\u{ba66}");
    assert.eq("\u{ba66}".normalize(ctx, .Nfkd), "\u{1106}\u{1166}\u{11b9}");
}

