// core/testing/assert — the assertions that pass.
//
// The other half is `cli/tests/failing/assertion_kinds`, which fails every one
// of them on purpose and records the message. Here is the half a conformance
// suite can make: an assertion that holds is a no-op on both backends, at the
// boundary as well as in the middle — an empty list, an element at either end,
// a bound that is met exactly.
//
// A passing assertion has no value to inspect, so what each test asserts is
// that the run *reaches the line after it*.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/map" import * as map;
from "core/orderedmap" import * as orderedmap;
from "core/queue" import * as queue;
from "core/set" import * as set;
from "core/testing/assert" import * as assert;

// --- contains ---------------------------------------------------------------------

test "contains finds an element at either end and in the middle" {
    assert.contains([1, 2, 3], 1);
    assert.contains([1, 2, 3], 2);
    assert.contains([1, 2, 3], 3);
    assert.equal([1, 2, 3].length(), 3);
}

test "contains works at any Equal element type" {
    assert.contains(["a", "b"], "b");
    assert.contains([true], true);
    assert.contains([[1, 2], [3]], [3]);
    assert.equal([[1, 2], [3]].length(), 2);
}

// --- isEmpty / notEmpty -------------------------------------------------------------

test "isEmpty holds for the empty list however it was built" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isEmpty(list.empty<Int>());
    assert.isEmpty([1].filter(ctx, fn(x) => x > 9));
    assert.equal(list.empty<Int>().length(), 0);
}

test "notEmpty holds for a list of one" {
    assert.notEmpty([1]);
    assert.notEmpty(["a", "b"]);
    assert.equal([1].length(), 1);
}

// --- length ------------------------------------------------------------------------

test "length holds at zero and at the length the list has" {
    assert.length(list.empty<Int>(), 0);
    assert.length([1], 1);
    assert.length([1, 2, 3], 3);
    assert.equal([1, 2, 3].length(), 3);
}

// --- gt / ge / lt / le --------------------------------------------------------------

test "the comparisons hold where the operators do" {
    assert.greaterThan(5, 3);
    assert.greaterOrEqual(5, 3);
    assert.greaterOrEqual(3, 3);
    assert.lessThan(3, 5);
    assert.lessOrEqual(3, 5);
    assert.lessOrEqual(3, 3);
    assert.equal(5 > 3, true);
}

test "the comparisons are the type's own Ordered" {
    assert.greaterThan("b", "a");
    assert.lessThan('a', 'b');
    assert.greaterThan(true, false);
    assert.greaterOrEqual(1.5, 1.5);
    assert.equal("b" > "a", true);
}

// --- approximatelyEqual ----------------------------------------------------------------------

test "approximatelyEqual holds within the tolerance, in both directions" {
    assert.approximatelyEqual(0.1 + 0.2, 0.3, 0.000001);
    assert.approximatelyEqual(1.0, 1.25, 0.25);
    assert.approximatelyEqual(1.25, 1.0, 0.25);
    assert.approximatelyEqual(1.0, 1.0, 0.0);
    assert.equal(1.0, 1.0);
}

// --- approximatelyEqualRelative -----------------------------------------------------------------

test "approximatelyEqualRelative scales the tolerance with the larger value" {
    // The same four significant figures at either size.
    assert.approximatelyEqualRelative(1000000.0, 1000050.0, 0.0001);
    assert.approximatelyEqualRelative(1.0, 1.00005, 0.0001);
    assert.approximatelyEqualRelative(1.00005, 1.0, 0.0001);
    assert.equal(1.0, 1.0);
}

test "approximatelyEqualRelative holds at zero, at equality and across signs" {
    assert.approximatelyEqualRelative(0.0, 0.0, 0.0);
    assert.approximatelyEqualRelative(2.5, 2.5, 0.0);
    assert.approximatelyEqualRelative(0.0 - 100.0, 0.0 - 100.01, 0.001);
    assert.equal(2.5, 2.5);
}

// --- equalWith ---------------------------------------------------------------------------

test "equalWith compares two maps built in different orders" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = map.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "b", 2);
    let two = map.empty<Str, Int>().insert(ctx, "b", 2).insert(ctx, "a", 1);
    assert.equalWith(ctx, one, two, fn(c, a, b) => a.equals(c, b));
    assert.equal(one.length(), 2);
}

test "equalWith holds for two empty maps and for two empty sets" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equalWith(ctx, map.empty<Str, Int>(), map.empty<Str, Int>(), fn(c, a, b) => {
        a.equals(c, b)
    });
    assert.equalWith(ctx, set.empty<Int>(), set.empty<Int>(), fn(c, a, b) => {
        a.equals(c, b)
    });
    assert.equal(map.empty<Str, Int>().length(), 0);
}

test "equalWith takes any comparison, not only a collection's equals" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Same last digit, different numbers: the comparison decides what equal is.
    assert.equalWith(ctx, 13, 33, fn(_c, a, b) => a % 10 == b % 10);
    assert.equal(13 % 10, 3);
}

// --- containsText ----------------------------------------------------------------------

test "containsText finds the needle at the start, the end and the middle" {
    assert.containsText("hello, world", "hello");
    assert.containsText("hello, world", ", w");
    assert.containsText("hello, world", "world");
    assert.equal("hello, world".length(), 12);
}

test "containsText holds for the empty needle and for the whole string" {
    assert.containsText("abc", "");
    assert.containsText("abc", "abc");
    assert.containsText("", "");
    assert.equal("".length(), 0);
}

// --- startsWith ------------------------------------------------------------------------

test "startsWith holds for a prefix, the whole string and the empty one" {
    assert.startsWith("main.buri:3: no such name", "main.buri:");
    assert.startsWith("abc", "abc");
    assert.startsWith("abc", "");
    assert.startsWith("", "");
    assert.equal("abc".length(), 3);
}

// --- unordered -------------------------------------------------------------------------

test "unordered holds however the two lists are arranged" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.unordered(ctx, [3, 1, 2], [1, 2, 3]);
    assert.unordered(ctx, [1, 2, 3], [1, 2, 3]);
    assert.unordered(ctx, [3, 2, 1], [1, 2, 3]);
    assert.equal([3, 1, 2].length(), 3);
}

test "unordered counts duplicates and holds for two empty lists" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.unordered(ctx, [1, 1, 2], [2, 1, 1]);
    assert.unordered(ctx, list.empty<Int>(), list.empty<Int>());
    assert.unordered(ctx, ["b", "a"], ["a", "b"]);
    assert.equal([1, 1, 2].length(), 3);
}

// --- equalWith over the collections that have no Equal of their own -------------------------

test "equalWith takes each collection that answers equals rather than deriving Equal" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sortedOne = orderedmap.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "b", 2);
    let sortedTwo = orderedmap.empty<Str, Int>().insert(ctx, "b", 2).insert(ctx, "a", 1);
    assert.equalWith(ctx, sortedOne, sortedTwo, fn(c, a, b) => a.equals(c, b));
    let setOne = set.empty<Int>().insert(ctx, 1).insert(ctx, 2);
    let setTwo = set.empty<Int>().insert(ctx, 2).insert(ctx, 1);
    assert.equalWith(ctx, setOne, setTwo, fn(c, a, b) => a.equals(c, b));
    let queued = queue.empty<Int>().push(ctx, 1).push(ctx, 2);
    assert.equalWith(ctx, queued, queued, fn(c, a, b) => a.equals(c, b));
    assert.equal(sortedOne.length(), 2);
}

test "equalWith holds for a value against itself whatever the comparison" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equalWith(ctx, "text", "text", fn(_c, a, b) => a == b);
    assert.equalWith(ctx, list.empty<Int>(), list.empty<Int>(), fn(_c, a, b) => {
        a.length() == b.length()
    });
    assert.equal("text".length(), 4);
}

// --- containsText and startsWith, where a scalar is more than one byte ----------------

test "containsText and startsWith measure in scalars, not bytes" {
    assert.containsText("a😀b", "😀");
    assert.containsText("héllo", "é");
    assert.startsWith("😀 first", "😀");
    assert.startsWith("héllo", "hé");
    assert.equal("a😀b".length(), 3);
}

test "a needle as long as the haystack, and one at the very end" {
    assert.containsText("abc", "c");
    assert.containsText("abc", "bc");
    assert.startsWith("abc", "a");
    assert.equal("abc".length(), 3);
}

// --- unordered, at its edges -----------------------------------------------------------

test "unordered holds for one element and for a list against itself" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.unordered(ctx, [7], [7]);
    let items = [5, 3, 5, 1];
    assert.unordered(ctx, items, items);
    assert.equal(items.length(), 4);
}

test "unordered is the type's own Ordered, so text and characters sort too" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.unordered(ctx, ["b", "a", "b"], ["b", "b", "a"]);
    assert.unordered(ctx, ['z', 'a'], ['a', 'z']);
    assert.unordered(ctx, [true, false], [false, true]);
    assert.equal(["b", "a", "b"].length(), 3);
}

// --- approximatelyEqualRelative at the tolerance exactly ---------------------------------------------

test "approximatelyEqualRelative holds when the gap is exactly the tolerance times the scale" {
    // 100.0 against 110.0 is a tenth of the larger, so a tolerance of a tenth
    // is the last one that holds.
    assert.approximatelyEqualRelative(100.0, 110.0, 0.1);
    assert.approximatelyEqual(100.0, 110.0, 10.0);
    assert.equal(110.0 - 100.0, 10.0);
}

test "approximatelyEqualRelative scales off the larger side, whichever side that is" {
    assert.approximatelyEqualRelative(110.0, 100.0, 0.1);
    assert.approximatelyEqualRelative(0.0 - 100.0, 0.0 - 110.0, 0.1);
    assert.equal(100.0 < 110.0, true);
}
