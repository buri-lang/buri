// core/testing/check — property testing over a seeded generator.
//
// A property that holds is a no-op, so what these assert is that the run
// reaches the line after it. The other half — a property that fails, and the
// counterexample the report names — is `cli/tests/failing/property_failure`,
// which cannot live here because a failing test is what it records.
//
// The draws themselves are checkable, though, and that is most of this file:
// `check.int` and `check.listOf` are ordinary functions over `core/random`'s
// `Gen`, so a test can call one and look at what came out. The seed is fixed,
// so every one of these answers the same on every backend.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/random" import * as random;
from "core/random" import { Gen };
from "core/testing/assert" import * as assert;
from "core/testing/check" import * as check;

// --- int ------------------------------------------------------------------------

test "int draws inside the half-open range" {
    check.forAll(check.int(1, 7), fn(face) => face >= 1 && face <= 6);
    check.forAll(check.int(0, 2), fn(bit) => bit == 0 || bit == 1);
    assert.equal(check.CASES, 100);
}

test "int over an empty range answers low and steps nothing" {
    let (value, next) = check.int(5, 5)(random.seeded(1));
    assert.equal(value, 5);
    assert.equal(next.0, random.seeded(1).0);
    let (below, _) = check.int(5, 1)(random.seeded(1));
    assert.equal(below, 5);
}

test "int over a range of one answers low every time" {
    check.forAll(check.int(9, 10), fn(only) => only == 9);
    let (only, _) = check.int(9, 10)(random.seeded(77));
    assert.equal(only, 9);
}

test "a negative range is drawn from as happily as a positive one" {
    check.forAll(check.int(0 - 5, 5), fn(n) => n >= 0 - 5 && n < 5);
    assert.equal(0 - 5 < 0, true);
}

// --- listOf ---------------------------------------------------------------------

test "listOf never draws past its bound" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 10), 5), fn(_c, items) => {
        items.length() <= 5
    });
    assert.equal(5 <= 5, true);
}

test "listOf holds every element to the item generator's range" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(3, 6), 4), fn(_c, items) => {
        items.all(fn(x) => x >= 3 && x < 6)
    });
    assert.equal([3, 4, 5].length(), 3);
}

test "listOf at zero and below draws the empty list" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 10), 0), fn(_c, xs) => {
        xs.isEmpty()
    });
    let (none, _) = check.listOf(ctx, check.int(0, 10), 0 - 3)(ctx, random.seeded(2));
    assert.isEmpty(none);
}

test "listOf draws a list of the length it said it would" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (drawn, _) = check.listOf(ctx, check.int(0, 100), 6)(ctx, random.seeded(11));
    assert.le(drawn.length(), 6);
    assert.ge(drawn.length(), 0);
    // Nothing outside the item generator's range got in.
    assert.isTrue(drawn.all(fn(x) => x >= 0 && x < 100));
}

// --- the seed a report names ------------------------------------------------------

test "a seed replays the case it was reported for" {
    let (first, afterFirst) = check.int(0, 1000)(random.seeded(4372));
    let (again, afterAgain) = check.int(0, 1000)(random.seeded(4372));
    assert.equal(first, again);
    // The generator it leaves behind replays too, so a whole run does.
    assert.equal(afterFirst.0, afterAgain.0);
}

test "two different seeds draw two different cases" {
    let (one, _) = check.int(0, 1000000)(random.seeded(1));
    let (two, _) = check.int(0, 1000000)(random.seeded(2));
    assert.notEq(one, two);
}

// --- the properties a suite would actually write -------------------------------------

test "reversing twice gives the list back" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 100), 8), fn(c, items) => {
        items.reverse(c).reverse(c).compare(items) == .Equal
    });
    assert.equal([1, 2].length(), 2);
}

test "sorting keeps the length and the elements" {
    let ctx = context {
        Allocator: alloc(),
    };
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 20), 6), fn(c, items) => {
        items.sort(c).length() == items.length()
    });
    check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 20), 6), fn(c, items) => {
        items.sort(c).isSortedBy(fn(a, b) => a.compare(b))
    });
    assert.equal([1, 2, 3].length(), 3);
}

// --- the hundredth case, and the seed a report would name -----------------------------

/// The generator's state and its draw, `skip` cases into a run from `g`.
fn drawAt(g: Gen, skip: Int): (Int, Int) {
    if (skip <= 0) {
        let (value, _next) = check.int(0, 100)(g);
        (g.0.wrapToI64(), value)
    } else {
        let (_value, next) = check.int(0, 100)(g);
        drawAt(next, skip - 1)
    }
}

test "the hundredth draw is the one the failing report names" {
    // `cli/tests/failing/property_failure` records a property that holds for
    // ninety-nine draws and breaks on this one. These are the two numbers its
    // report prints, so a change to the draw order fails here as well as there.
    let last = drawAt(random.seeded(0), check.CASES - 1);
    assert.equal(last.0, 3419378616714001439);
    assert.equal(last.1, 94);
}

test "the seed a report names replays the case beside it" {
    let (case, _) = check.int(0, 100)(random.seeded(3419378616714001439));
    assert.equal(case, 94);
    // And the very first case, which is the one a property that never holds
    // reports: seed zero, drawing 35.
    let (first, _) = check.int(0, 100)(random.seeded(0));
    assert.equal(first, 35);
}

test "a property that holds for every one of the hundred is a no-op" {
    check.forAll(check.int(0, 100), fn(n) => n >= 0 && n <= 99);
    assert.equal(check.CASES, 100);
}
