// `core/list`'s `*Ctx` combinators, with a step that **waits**.
//
// `test/lists.buri` next door says what each of these answers. This file says
// the other half, and it is the half a backend can get wrong on its own: a
// `*Ctx` combinator hands its step the caller's whole context, so the step may
// do anything the caller may — ask an actor, dial a socket, sleep on a clock,
// open a scope — and the combinator has to wait for it before it answers.
//
// On the JavaScript backend a step that waits is an `async` function and
// calling one hands back a promise, so a combinator that did not await its
// step answered a list of promises and the work never ran. That is not a slow
// program, it is a wrong one, and `main` returned before any of it happened.
// The natives never had the bug — there is nothing to await — which is exactly
// why it is worth asserting here: the corpus runs on both, so the two either
// agree or the difference is a failure rather than a footnote.
// `cli/tests/native/conformance.rs` runs this same file through the
// copy-and-patch backend, and `cli/tests/native/agreement.rs`'s
// `a_waiting_step_runs_under_every_ctx_combinator_on_every_backend` runs the
// same shape through the optimizing one.
//
// **An actor is the instrument.** `sendMessage` is one of the two `core/actor`
// operations that wait (`middle::rc::suspends`), it waits on the program
// rather than on the world, and its state is a *value* the test reads back —
// so each block asserts two things at once: the combinator's own answer is
// complete, and the step's effect really happened. The state folds each
// message in as `seen * 10 + n`, so it records the order the steps ran in and
// not merely how many there were.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Stepped, Stopped };
from "core/effect" import { Alloc, Tasks };
from "core/host/testing" import { alloc, tasks };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

enum Note {
    Saw(Int),
    Read,
}

derive Eq, Show for Heard;
enum Heard {
    Noted(Int),
    Log(Int),
}

/// The recorder. `Saw(n)` folds `n` into the state and answers `n` doubled;
/// `Read` answers the state without changing it.
fn recorder<C: Alloc + Tasks>(): Actor<C, Int, Note, Heard> {
    Actor {
        state: 0,
        step: fn(c, seen, note) => {
            match (note) {
                .Saw(n) => Stepped { state: seen * 10 + n, answer: .Noted(n * 2) },
                .Read => Stepped { state: seen, answer: .Log(seen) },
            }
        },
    }
}

/// What a `Saw` answered, or `-1` where the actor had already stopped.
fn noted(r: Result<Heard, Stopped>): Int {
    match (r) {
        .Ok(.Noted(n)) => n,
        _otherwise => -1,
    }
}

/// What the recorder has heard, in order.
fn heardSoFar(r: Result<Heard, Stopped>): Int {
    match (r) {
        .Ok(.Log(n)) => n,
        _otherwise => -1,
    }
}

// --- mapCtx -------------------------------------------------------------------

test "mapCtx waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let doubled = [1, 2, 3].mapCtx(ctx, fn(c, x) => {
        noted(heard.sendMessage(c, .Saw(x)))
    });
    assert.eq(doubled, [2, 4, 6]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

test "mapCtx over the empty list runs no waiting step" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let doubled = list
        .empty<Int>()
        .mapCtx(ctx, fn(c, x) => noted(heard.sendMessage(c, .Saw(x))));
    assert.eq(doubled, list.empty<Int>());
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 0);
    let _ = heard.stop(ctx).ignore();
}

// --- mapCtxStep ---------------------------------------------------------------

test "mapCtxStep waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let doubled = [4, 5, 6].mapCtxStep(ctx, fn(c, x) => {
        noted(heard.sendMessage(c, .Saw(x)))
    });
    assert.eq(doubled, [8, 10, 12]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 456);
    let _ = heard.stop(ctx).ignore();
}

// --- filterCtx ----------------------------------------------------------------

test "filterCtx waits for a predicate that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let even = [1, 2, 3, 4].filterCtx(ctx, fn(c, x) => {
        noted(heard.sendMessage(c, .Saw(x))) % 4 == 0
    });
    assert.eq(even, [2, 4]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 1234);
    let _ = heard.stop(ctx).ignore();
}

// --- foldCtx ------------------------------------------------------------------

test "foldCtx waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let total = [1, 2, 3].foldCtx(
        ctx,
        fn(c, acc: Int, x) => acc + noted(heard.sendMessage(c, .Saw(x))),
        0,
    );
    assert.eq(total, 12);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

// --- foldResultCtx ------------------------------------------------------------

test "foldResultCtx waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let total = [1, 2, 3].foldResultCtx(
        ctx,
        fn(c, acc: Int, x) => .Ok(acc + noted(heard.sendMessage(c, .Saw(x)))),
        0,
    );
    assert.eq(assert.ok(total), 12);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

test "foldResultCtx stops at the first failing waiting step" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let out: Result<Int, Str> = [1, 2, 3].foldResultCtx(
        ctx,
        fn(c, acc: Int, x) => {
            let seen = noted(heard.sendMessage(c, .Saw(x)));
            match (x == 2) {
                true => .Err("stopped"),
                false => .Ok(acc + seen),
            }
        },
        0,
    );
    assert.eq(assert.err(out), "stopped");
    // Two steps ran and the third did not, which the state says exactly.
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 12);
    let _ = heard.stop(ctx).ignore();
}

// --- the combinators written on top of those five -----------------------------
//
// `mapResultCtx`, `mapOptionCtx` and `filterMapCtx` are `core/list`'s own Buri
// over `foldResultCtx` and `foldCtx`, so a waiting step reaches them through
// the same five. They are here because "the family" is what the rule is about,
// and a family checked at its base only is a family with one member checked.

test "mapResultCtx waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let out: Result<[Int], Str> = [1, 2, 3].mapResultCtx(ctx, fn(c, x) => {
        .Ok(noted(heard.sendMessage(c, .Saw(x))))
    });
    assert.eq(assert.ok(out), [2, 4, 6]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

test "mapOptionCtx waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let out = [1, 2, 3].mapOptionCtx(ctx, fn(c, x) => {
        .Some(noted(heard.sendMessage(c, .Saw(x))))
    });
    assert.eq(assert.some(out), [2, 4, 6]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

test "filterMapCtx waits for a step that waits" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let out = [1, 2, 3].filterMapCtx(ctx, fn(c, x) => {
        let seen = noted(heard.sendMessage(c, .Saw(x)));
        match (x == 2) {
            true => .None,
            false => .Some(seen),
        }
    });
    assert.eq(out, [2, 6]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

// --- one combinator inside another --------------------------------------------

test "a waiting step nested two combinators deep still runs" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let heard = actor.start(ctx, recorder());
    let out = [[1, 2], [3]].mapCtx(ctx, fn(c, xs: [Int]) => {
        xs.mapCtx(c, fn(d, x) => noted(heard.sendMessage(d, .Saw(x))))
    });
    assert.eq(out, [[2, 4], [6]]);
    assert.eq(heardSoFar(heard.sendMessage(ctx, .Read)), 123);
    let _ = heard.stop(ctx).ignore();
}

// --- and the step that does not wait ------------------------------------------
//
// The rule has two halves and this is the second: a step that never waits
// leaves its combinator alone. Nothing here can *see* the difference — that is
// what `language/golden_javascript.rs` is for, where the emitted wrapper is
// still a plain `function` — so what this block holds is the answer, on the
// same combinators, with no actor in sight.

test "a step that does not wait still answers" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq([1, 2, 3].mapCtx(ctx, fn(c, x) => x * 2), [2, 4, 6]);
    assert.eq([1, 2, 3].mapCtxStep(ctx, fn(c, x) => x * 2), [2, 4, 6]);
    assert.eq([1, 2, 3, 4].filterCtx(ctx, fn(c, x) => x % 2 == 0), [2, 4]);
    assert.eq([1, 2, 3].foldCtx(ctx, fn(c, acc: Int, x) => acc + x, 0), 6);
}
