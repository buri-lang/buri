// The function shapes the backend's tail-call elimination rewrites.
//
// Each of these is written so that eliminating its tail call *incorrectly*
// changes the answer rather than merely the speed, which is what makes the
// assertions in `test/` worth making.

from "core/effect" import { Alloc };
from "core/list" import * as list;

// -----------------------------------------------------------------------------
// Closures built inside a tail loop
// -----------------------------------------------------------------------------
//
// A tail loop rebinds its parameters in place. A closure made in the body
// therefore has to capture the *value* its iteration held, not the slot: by the
// time it is called the loop has finished and the slot holds whatever the loop
// stopped at. Compilers that rebind the parameter itself and never give the
// iteration its own binding return the final value from every closure — Elm has
// had exactly that miscompile open since 2016 (elm/compiler#2268).
//
// `adders(ctx, 0, [])` must hold `+0`, `+1`, `+2` and `+3`, in that order.

export fn adders<C: Alloc>(ctx: C, i: Int, acc: [fn(Int) => Int]): [fn(Int) => Int] {
    if (i >= 4) { acc } else { adders(ctx, i + 1, acc.push(ctx, fn(x) => x + i)) }
}

/// The same, in a mutually recursive pair, which the backend merges into one
/// dispatch loop over shared slots — so the slots have the same hazard.
///
/// The two members build different closures, so the answers say which member
/// ran as well as which value it captured.
export fn addersEven<C: Alloc>(
    ctx: C,
    i: Int,
    acc: [fn(Int) => Int],
): [fn(Int) => Int] {
    if (i >= 4) { acc } else { addersOdd(ctx, i + 1, acc.push(ctx, fn(x) => x + i)) }
}

export fn addersOdd<C: Alloc>(ctx: C, i: Int, acc: [fn(Int) => Int]): [fn(Int) => Int] {
    if (i >= 4) { acc } else { addersEven(ctx, i + 1, acc.push(ctx, fn(x) => x * i)) }
}

/// A closure over a parameter the loop *never* rebinds. Nothing can go stale
/// here, so this is the case a fix must leave alone.
export fn scalers<C: Alloc>(
    ctx: C,
    k: Int,
    i: Int,
    acc: [fn(Int) => Int],
): [fn(Int) => Int] {
    if (i >= 3) { acc } else { scalers(ctx, k, i + 1, acc.push(ctx, fn(x) => x * k)) }
}

/// Two closures per iteration over the same parameter, so a fix that gave the
/// iteration one binding too few would show up as the two disagreeing.
export fn pairs<C: Alloc>(ctx: C, i: Int, acc: [fn(Int) => Int]): [fn(Int) => Int] {
    if (i >= 3) {
        acc
    } else {
        pairs(ctx, i + 1, acc.push(ctx, fn(x) => x + i).push(ctx, fn(x) => x - i))
    }
}

// -----------------------------------------------------------------------------
// Tail position under the short-circuiting operators
// -----------------------------------------------------------------------------
//
// `a && f(x)` is `f(x)` whenever `a` holds, so `f(x)` is in tail position and
// must run in constant stack (SPEC 8.3). The same goes for `a || f(x)`. These
// are the shapes of `all` and `any`, so they are exactly the functions an
// immutable language recurses through.
//
// The depths below are past what a JavaScript engine gives a recursive
// function, so a compiler that leaves the call on the stack crashes here rather
// than returning a wrong answer.

/// `&&`: recurses while the guard holds, and the answer says how it left.
export fn allBelow(xs: [Int], limit: Int, i: Int): Bool {
    if (i >= xs.len()) {
        true
    } else {
        xs.get(i).withDefault(0) < limit && allBelow(xs, limit, i + 1)
    }
}

/// `&&` with nothing but the counter, so the depth is the parameter.
export fn countDownAnd(i: Int): Bool {
    if (i <= 0) { true } else { i > -1 && countDownAnd(i - 1) }
}

/// `||`: the mirror image — recursion is what happens when the test fails.
export fn countDownOr(i: Int): Bool {
    if (i <= 0) { true } else { i < 0 || countDownOr(i - 1) }
}

/// `&&` under a mutually recursive pair, so the merged dispatch loop is
/// covered too.
export fn evenAnd(i: Int): Bool {
    if (i <= 0) { true } else { i > -1 && oddAnd(i - 1) }
}

export fn oddAnd(i: Int): Bool {
    if (i <= 0) { true } else { i > -1 && evenAnd(i - 1) }
}

derive Eq, Show for Pair;
// -----------------------------------------------------------------------------
// Derived structural equality
// -----------------------------------------------------------------------------
//
// `derive Eq` can be answered two ways: by a runtime walker that rediscovers
// the shape of the value as it goes, or by code compiled at the type. The two
// have to agree on every value, and the interesting cases are the ones where
// "structural" and "identical" come apart — `NaN`, `-0.0`, an `Option` whose
// nesting is boxed, and an enum whose variants carry different numbers of
// fields.
//
// The constructors are functions so that two equal values are two *objects*:
// written as literals the compiler is free to share one, and then every
// comparison would be answered by identity and prove nothing.

export struct Pair {
    a: Int,
    b: Str,
}

derive Eq for Floaty;
export struct Floaty {
    x: Float,
}

derive Eq for Nest;
export struct Nest {
    p: Pair,
    q: Floaty,
}

derive Eq for Holder;
export struct Holder {
    o: Option<Int>,
}

derive Eq for Deep;
export struct Deep {
    o: Option<Option<Int>>,
}

derive Eq for Listy;
export struct Listy {
    xs: [Int],
}

derive Eq for Hollow;
export struct Hollow {}

derive Eq for Flat;
export enum Flat {
    A,
    B,
    C,
}

derive Eq for Wide;
/// Three variants with three different arities, so a comparison that assumed
/// one shape per enum would be caught.
export enum Wide {
    None0,
    One(Int),
    Two(Int, Str),
}

export fn mkPair(a: Int, b: Str): Pair {
    Pair { a: a, b: b }
}

export fn mkFloaty(x: Float): Floaty {
    Floaty { x: x }
}

export fn mkNest(p: Pair, q: Floaty): Nest {
    Nest { p: p, q: q }
}

export fn mkHolder(o: Option<Int>): Holder {
    Holder { o: o }
}

export fn mkDeep(o: Option<Option<Int>>): Deep {
    Deep { o: o }
}

export fn mkListy(xs: [Int]): Listy {
    Listy { xs: xs }
}

export fn mkHollow(): Hollow {
    Hollow { }
}

/// `0.0 / 0.0`, because there is no NaN literal and a folded constant would
/// not be one either.
export fn notANumber(): Float {
    zeroF() / zeroF()
}

fn zeroF(): Float {
    0.0
}

// -----------------------------------------------------------------------------
// Float equality in every position a comparison can be read from
// -----------------------------------------------------------------------------
//
// SPEC 7.2 makes `==` on floats an equivalence relation, so `NaN == NaN` is
// true; `<` and friends stay IEEE-754 and disagree with it there. That is one
// answer, and a backend has more than one place to spell it: the boolean a
// comparison *materialises*, and the fused compare-and-branch a terminator
// absorbs it into. The stencil backend spelled the first as the equivalence and
// the second as C's `==`, so one program held both — `asValue(nan, nan)` was
// true while `if (a == b)` took the false edge (buri-lang/buri#40), and a
// `compare` written the obvious way stopped being a total order.
//
// Each of these is a function so that the comparison is a *compiled* one: a
// constant fold would answer them all without a comparison being emitted.

/// The comparison as a value, which is the position that was already right.
export fn floatEqAsValue(a: Float, b: Float): Bool {
    a == b
}

/// The same comparison as the condition of an `if`, which is the fusion.
export fn floatEqAsCondition(a: Float, b: Float): Bool {
    if (a == b) { true } else { false }
}

/// Bound first and tested after, which the optimiser puts back together.
export fn floatEqBoundThenCondition(a: Float, b: Float): Bool {
    let equal = a == b;
    if (equal) { true } else { false }
}

/// As a `match` guard, which is a branch by another spelling.
export fn floatEqAsGuard(a: Float, b: Float): Bool {
    match (a) {
        _ if a == b => true,
        _ => false,
    }
}

/// Negated, which puts a `not` between the comparison and the branch — so this
/// is the one position that was right for the wrong reason.
export fn floatEqNegatedCondition(a: Float, b: Float): Bool {
    if (!(a == b)) { false } else { true }
}

/// `!=` in the same position, which is the equivalence's complement.
export fn floatNeAsCondition(a: Float, b: Float): Bool {
    if (a != b) { true } else { false }
}

/// `<` in the same position. It stays IEEE-754, so it is the arm of the fix
/// that must *not* move: a `NaN` is neither below nor above anything.
export fn floatLtAsCondition(a: Float, b: Float): Bool {
    if (a < b) { true } else { false }
}

/// `<=` likewise, because a fix that made every float comparison an
/// equivalence would show up here rather than at `<`.
export fn floatLeAsCondition(a: Float, b: Float): Bool {
    if (a <= b) { true } else { false }
}

// -----------------------------------------------------------------------------
// Derived ordering over a `[T]`
// -----------------------------------------------------------------------------
//
// `derive Ord` bottoms out at one helper per container, and the array one —
// `deriveArrayCompare`, `([T], [T], fn(T, T) -> Order) -> Order` — had no body
// on the stencil backend, so a type holding an array could not be built for a
// native target at all (buri-lang/buri#27). The order it answers is
// lexicographic: the first `min(m, n)` elements decide it, and where every one
// of them is `Equal` the lengths do, so a prefix sorts below what extends it.
//
// The element types below are the three that reach different leaves — a scalar,
// a `Str` (a runtime call), and a struct (a generated function) — and the enum
// is the shape whose payloads are arrays rather than whose fields are.

derive Eq, Ord, Show for Octets;
export struct Octets {
    xs: [U8],
}

derive Eq, Ord, Show for Words;
export struct Words {
    ss: [Str],
}

derive Eq, Ord, Show for Leaf;
/// Two fields, so an element comparison that stopped at the first would show up
/// as `Leaf { a: 1, b: "y" }` and `Leaf { a: 1, b: "x" }` comparing equal.
export struct Leaf {
    a: Int,
    b: Str,
}

derive Eq, Ord, Show for Leaves;
export struct Leaves {
    xs: [Leaf],
}

derive Eq, Ord, Show for Tagged;
/// An enum whose payloads are arrays: the variant decides first, and only
/// within one variant does the array.
export enum Tagged {
    Empty,
    Bytes([U8]),
    Words([Str]),
}

export fn mkOctets(xs: [U8]): Octets {
    Octets { xs: xs }
}

export fn mkWords(ss: [Str]): Words {
    Words { ss: ss }
}

export fn mkLeaf(a: Int, b: Str): Leaf {
    Leaf { a: a, b: b }
}

export fn mkLeaves(xs: [Leaf]): Leaves {
    Leaves { xs: xs }
}
