// SPEC 7.2 — what `derive Eq` means, at every shape a value can have.
//
// The backend compiles a derived `==` at the type rather than calling a runtime
// walker that rediscovers the shape as it goes. The two have to agree on every
// value, and the cases that could tell them apart are the ones where
// "structural" and "identical" come apart:
//
//   * `NaN`, which IEEE-754 denies is itself and SPEC 7.2 rules equal, so a
//     struct holding one is equal to itself *and* to a separately built copy;
//   * `-0.0` and `0.0`, which are equal;
//   * an `Option`, whose nesting the runtime carries in a box;
//   * an enum whose variants hold different numbers of fields;
//   * an empty struct and an empty list, which have nothing to compare.
//
// Every value here is built by a function, so two equal values are two objects.
// Written as literals the compiler is free to share one, and then a comparison
// would be answered by identity and would prove nothing.

from "core/testing/assert" import * as assert;
from "//lib/codegen" import {
    Deep, Flat, floatEqAsCondition, floatEqAsGuard, floatEqAsValue,
    floatEqBoundThenCondition, floatEqNegatedCondition, floatLeAsCondition,
    floatLtAsCondition, floatNeAsCondition, Floaty, Holder, Hollow, Listy, mkDeep,
    mkFloaty, mkHolder, mkHollow, mkListy, mkNest, mkPair, Nest, notANumber, Pair, Wide,
};

// --- structs -------------------------------------------------------------------------

test "a struct is equal field by field" {
    assert.isTrue(mkPair(1, "x") == mkPair(1, "x"));
    assert.isFalse(mkPair(1, "x") == mkPair(1, "y"));
    assert.isFalse(mkPair(2, "x") == mkPair(1, "x"));
}

test "a struct with nothing in it is equal to another" {
    assert.isTrue(mkHollow() == mkHollow());
}

test "a struct nests" {
    let a = mkNest(mkPair(1, "x"), mkFloaty(0.0));
    let b = mkNest(mkPair(1, "x"), mkFloaty(0.0));
    let c = mkNest(mkPair(1, "y"), mkFloaty(0.0));
    assert.isTrue(a == b);
    assert.isFalse(a == c);
}

// --- floats --------------------------------------------------------------------------

test "a struct holding NaN is equal to a separately built one" {
    // SPEC 7.2: `==` is an equivalence relation, so the float leaf answers
    // `true` for two NaNs and the struct inherits that.
    assert.isTrue(mkFloaty(notANumber()) == mkFloaty(notANumber()));
    assert.isFalse(mkFloaty(notANumber()) == mkFloaty(0.0));
    assert.isFalse(mkFloaty(0.0) == mkFloaty(notANumber()));
}

test "a value is equal to itself even when it holds NaN" {
    // The same value, not a copy. Reflexivity holds of every value there is,
    // and after SPEC 7.2's ruling it holds for the same reason as the case
    // above rather than as a separate accident of identity.
    let f = mkFloaty(notANumber());
    assert.isTrue(f == f);
}

test "negative zero equals zero" {
    assert.isTrue(mkFloaty(0.0) == mkFloaty(-0.0));
    assert.isTrue(mkFloaty(-0.0) == mkFloaty(0.0));
}

// --- options -------------------------------------------------------------------------

test "a struct holding an Option compares the payload" {
    assert.isTrue(mkHolder(.Some(1)) == mkHolder(.Some(1)));
    assert.isFalse(mkHolder(.Some(1)) == mkHolder(.Some(2)));
    assert.isFalse(mkHolder(.Some(1)) == mkHolder(.None));
    assert.isTrue(mkHolder(.None) == mkHolder(.None));
}

test "a nested Option keeps its depth" {
    // `Some(None)` and `None` are different values, and telling them apart is
    // the whole reason the runtime boxes the nesting.
    assert.isFalse(mkDeep(.Some(.None)) == mkDeep(.None));
    assert.isFalse(mkDeep(.Some(.None)) == mkDeep(.Some(.Some(1))));
    assert.isTrue(mkDeep(.Some(.None)) == mkDeep(.Some(.None)));
    assert.isTrue(mkDeep(.None) == mkDeep(.None));
    assert.isTrue(mkDeep(.Some(.Some(1))) == mkDeep(.Some(.Some(1))));
}

// --- lists ---------------------------------------------------------------------------

test "a struct holding a list compares element by element" {
    assert.isTrue(mkListy([1, 2]) == mkListy([1, 2]));
    assert.isFalse(mkListy([1, 2]) == mkListy([1, 2, 3]));
    assert.isFalse(mkListy([1, 2]) == mkListy([2, 1]));
    assert.isTrue(mkListy([]) == mkListy([]));
    assert.isFalse(mkListy([1]) == mkListy([]));
}

test "lists compare directly too" {
    let a: [Int] = [1, 2];
    let b: [Int] = [1, 2];
    let c: [Int] = [1, 3];
    assert.isTrue(a == b);
    assert.isFalse(a == c);
}

test "an empty list is not a list holding an empty list" {
    let a: [[Int]] = [];
    let b: [[Int]] = [[]];
    assert.isFalse(a == b);
    assert.isTrue(b == b);
}

// --- enums ---------------------------------------------------------------------------

test "an enum with no payload is equal by variant" {
    assert.isTrue(Flat.A == Flat.A);
    assert.isFalse(Flat.A == Flat.B);
    assert.isFalse(Flat.B == Flat.C);
}

test "variants of different arity are never equal" {
    assert.isFalse(Wide.None0 == Wide.One(1));
    assert.isFalse(Wide.One(1) == Wide.Two(1, "a"));
    assert.isFalse(Wide.None0 == Wide.Two(1, "a"));
}

test "an enum with a payload compares the payload" {
    assert.isTrue(Wide.None0 == Wide.None0);
    assert.isTrue(Wide.One(1) == Wide.One(1));
    assert.isFalse(Wide.One(1) == Wide.One(2));
    assert.isTrue(Wide.Two(1, "a") == Wide.Two(1, "a"));
    assert.isFalse(Wide.Two(1, "a") == Wide.Two(1, "b"));
    assert.isFalse(Wide.Two(1, "a") == Wide.Two(2, "a"));
}

// --- tuples --------------------------------------------------------------------------

test "a tuple is equal component by component" {
    let a = (1, "a");
    let b = (1, "a");
    let c = (1, "b");
    assert.isTrue(a == b);
    assert.isFalse(a == c);
}

// --- != ------------------------------------------------------------------------------

test "!= is the negation of ==" {
    assert.isFalse(mkPair(1, "x") != mkPair(1, "x"));
    assert.isTrue(mkPair(1, "x") != mkPair(1, "y"));
    assert.isTrue(Wide.One(1) != Wide.Two(1, "a"));
    assert.isFalse(mkListy([]) != mkListy([]));
}

// --- the same comparison, read from every position ------------------------------------
//
// SPEC 7.2's equivalence is one answer, and a backend has more than one place
// to spell it: the boolean a comparison materialises, and the fused
// compare-and-branch a terminator absorbs it into. The stencil backend had the
// first and not the second, so `floatEqAsValue(nan, nan)` was true while
// `floatEqAsCondition(nan, nan)` was false in the same program
// (buri-lang/buri#40). Every position below is the identical source comparison.

test "float equality means the same thing wherever it is read" {
    let n = notANumber();
    assert.isTrue(floatEqAsValue(n, n));
    assert.isTrue(floatEqAsCondition(n, n));
    assert.isTrue(floatEqBoundThenCondition(n, n));
    assert.isTrue(floatEqAsGuard(n, n));
    assert.isTrue(floatEqNegatedCondition(n, n));
}

test "two separately made NaNs are equal in every position too" {
    // Reflexivity above, and here two values that are not the same value —
    // which is what makes this a question about the comparison rather than
    // about identity.
    assert.isTrue(floatEqAsValue(notANumber(), notANumber()));
    assert.isTrue(floatEqAsCondition(notANumber(), notANumber()));
    assert.isTrue(floatEqBoundThenCondition(notANumber(), notANumber()));
    assert.isTrue(floatEqAsGuard(notANumber(), notANumber()));
    assert.isTrue(floatEqNegatedCondition(notANumber(), notANumber()));
}

test "ordinary floats are unmoved by the equivalence" {
    // The half a fix breaks if it reaches for the equivalence and drops the
    // comparison it was meant to keep.
    assert.isTrue(floatEqAsCondition(1.5, 1.5));
    assert.isFalse(floatEqAsCondition(1.5, 2.5));
    assert.isTrue(floatEqAsCondition(0.0, -0.0));
    assert.isTrue(floatEqBoundThenCondition(1.5, 1.5));
    assert.isFalse(floatEqBoundThenCondition(1.5, 2.5));
    assert.isTrue(floatEqAsGuard(1.5, 1.5));
    assert.isFalse(floatEqAsGuard(1.5, 2.5));
}

test "!= in a condition is the equivalence's complement" {
    let n = notANumber();
    assert.isFalse(floatNeAsCondition(n, n));
    assert.isFalse(floatNeAsCondition(1.5, 1.5));
    assert.isTrue(floatNeAsCondition(1.5, 2.5));
}

test "the ordering comparisons stay IEEE-754 at NaN" {
    // `<` and friends disagree with `==` at a NaN, and that disagreement is the
    // language's — so a fix that made every float comparison an equivalence
    // would be caught here rather than by the cases above.
    let n = notANumber();
    assert.isFalse(floatLtAsCondition(n, n));
    assert.isFalse(floatLeAsCondition(n, n));
    assert.isFalse(floatLtAsCondition(n, 1.0));
    assert.isFalse(floatLtAsCondition(1.0, n));
    assert.isFalse(floatLeAsCondition(n, 1.0));
    assert.isTrue(floatLtAsCondition(1.0, 2.0));
    assert.isTrue(floatLeAsCondition(1.0, 1.0));
}
