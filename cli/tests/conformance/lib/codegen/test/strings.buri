// SPEC 5.1.1 — `Str` indexes and counts *Unicode scalar values*, across the
// whole range of things a UTF-16 host string can hold.
//
// The runtime answers these without materialising an array whenever the string
// holds no surrogate code unit, because then one code unit is one scalar. Every
// string below is chosen for which side of that it lands on:
//
//   * pure ASCII, and Latin-1 with precomposed accents — one code unit each;
//   * CJK — three bytes in UTF-8, but still one UTF-16 code unit each;
//   * emoji — astral, so a surrogate *pair* per scalar;
//   * a combining mark — two scalars that render as one glyph, and must count
//     as two;
//   * a string mixing all of them, where the fast path must not be taken.
//
// The answers here are what `length` meant before there was a fast path, so this
// is the test that the two agree.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// --- length ---------------------------------------------------------------------------

test "length counts scalars in strings with no surrogate" {
    assert.equal("".length(), 0);
    assert.equal("abc".length(), 3);
    assert.equal("héllo".length(), 5);
    assert.equal("日本語".length(), 3);
    assert.equal("  spaced  ".length(), 10);
}

test "length counts an astral scalar once, not twice" {
    // A surrogate pair is one scalar. Counting UTF-16 code units would say 2.
    assert.equal("😀".length(), 1);
    assert.equal("😀😁😂".length(), 3);
    assert.equal("a😀b".length(), 3);
}

test "length counts a combining mark as its own scalar" {
    // `e` followed by U+0301, which renders as one glyph and is two scalars.
    assert.equal("é".length(), 2);
    assert.equal("é".length(), 1);
}

test "length counts a mixed string one scalar at a time" {
    assert.equal("mix日😀éd".length(), 7);
}

// --- charAt ------------------------------------------------------------------------

test "charAt indexes by scalar in a string with no surrogate" {
    assert.equal("abc".charAt(0), .Some('a'));
    assert.equal("abc".charAt(2), .Some('c'));
    assert.equal("abc".charAt(3), .None);
    assert.equal("abc".charAt(-1), .None);
    assert.equal("日本語".charAt(1), .Some('本'));
}

test "charAt indexes by scalar past an astral scalar" {
    // Index 1 is `b`, not the low surrogate half of the emoji.
    assert.equal("a😀b".charAt(0), .Some('a'));
    assert.equal("a😀b".charAt(1), .Some('😀'));
    assert.equal("a😀b".charAt(2), .Some('b'));
    assert.equal("a😀b".charAt(3), .None);
    assert.equal("😀😁😂".charAt(2), .Some('😂'));
}

// --- slice -------------------------------------------------------------------------

test "slice cuts on scalar boundaries with no surrogate" {
    assert.equal("abcdef".slice(0, 3), "abc");
    assert.equal("abcdef".slice(2, 4), "cd");
    assert.equal("abcdef".slice(0, 99), "abcdef");
    assert.equal("abcdef".slice(4, 2), "");
    assert.equal("abcdef".slice(9, 12), "");
    assert.equal("日本語".slice(1, 3), "本語");
}

test "slice never cuts an astral scalar in half" {
    assert.equal("a😀b".slice(0, 2), "a😀");
    assert.equal("a😀b".slice(1, 3), "😀b");
    assert.equal("😀😁😂".slice(1, 2), "😁");
    assert.equal("😀😁😂".slice(2, 1), "");
    assert.equal("mix日😀éd".slice(3, 5), "日😀");
}

// --- indexOf -----------------------------------------------------------------------

test "indexOf answers a scalar index with no surrogate" {
    assert.equal("abcdef".indexOf("a"), .Some(0));
    assert.equal("abcdef".indexOf("cd"), .Some(2));
    assert.equal("abcdef".indexOf("zz"), .None);
    assert.equal("abcdef".indexOf(""), .Some(0));
    assert.equal("日本語".indexOf("語"), .Some(2));
}

test "indexOf counts an astral scalar in the prefix once" {
    // Code-unit counting would say 2 for `b`, because the emoji is a pair.
    assert.equal("a😀b".indexOf("b"), .Some(2));
    assert.equal("a😀b".indexOf("😀"), .Some(1));
    assert.equal("😀😁😂".indexOf("😂"), .Some(2));
    assert.equal("mix日😀éd".indexOf("d"), .Some(6));
}

// --- padStart / padEnd -------------------------------------------------------------

test "padding measures the width in scalars" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal("abc".padStart(ctx, 5, '.'), "..abc");
    assert.equal("abc".padEnd(ctx, 5, '.'), "abc..");
    assert.equal("abc".padStart(ctx, 3, '.'), "abc");
    assert.equal("abc".padStart(ctx, 0, '.'), "abc");
}

test "padding counts an astral scalar as one wide" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `😀` is one scalar, so it needs four more to reach five.
    assert.equal("😀".padStart(ctx, 5, '.'), "....😀");
    assert.equal("😀".padEnd(ctx, 5, '.'), "😀....");
    assert.equal("a😀b".padStart(ctx, 5, '.'), "..a😀b");
}

// --- chars -------------------------------------------------------------------------

test "chars agrees with length and charAt" {
    let ctx = context {
        Allocator: alloc(),
    };
    let mixed = "mix日😀éd";
    assert.equal(mixed.chars(ctx).length(), mixed.length());
    assert.equal(mixed.chars(ctx).get(3), mixed.charAt(3));
    assert.equal(mixed.chars(ctx).get(4), mixed.charAt(4));
    assert.equal("".chars(ctx).length(), 0);
}
