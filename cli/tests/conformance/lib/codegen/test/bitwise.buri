    assert.equal(v6 | v3, -2147418113);
    assert.equal(v6 | v4, -1);
    assert.equal(v6 | v5, -2147483648);
    assert.equal(v6 | v6, -2147483648);
    assert.equal(v6 | v7, -2147483648);
