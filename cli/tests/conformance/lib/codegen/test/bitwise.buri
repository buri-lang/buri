    assert.equal(v7 | v7, 1099511627776);
    assert.equal(v7 | v8, 9007199254740991);
    assert.equal(v7 | v9, -9006099743113215);
    assert.equal(v8 | v0, 9007199254740991);
    assert.equal(v8 | v1, 9007199254740991);
    assert.equal(v8 | v2, -1);
