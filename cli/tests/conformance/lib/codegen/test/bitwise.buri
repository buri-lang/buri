}

test "^ agrees with the 64-bit answer at every boundary" {
    let v0: Int = 0;
    let v1: Int = 1;
    let v2: Int = -1;
    let v3: Int = 65535;
    let v4: Int = 2147483647;
    let v5: Int = 2147483648;
    let v6: Int = -2147483648;
    let v7: Int = 1099511627776;
    let v8: Int = 9007199254740991;
    let v9: Int = -9007199254740991;
    assert.equal(v0 ^ v0, 0);
    assert.equal(v0 ^ v1, 1);
    assert.equal(v0 ^ v2, -1);
    assert.equal(v0 ^ v3, 65535);
    assert.equal(v0 ^ v4, 2147483647);
    assert.equal(v0 ^ v5, 2147483648);
    assert.equal(v0 ^ v6, -2147483648);
    assert.equal(v0 ^ v7, 1099511627776);
    assert.equal(v0 ^ v8, 9007199254740991);
    assert.equal(v0 ^ v9, -9007199254740991);
    assert.equal(v1 ^ v0, 1);
    assert.equal(v1 ^ v1, 0);
    assert.equal(v1 ^ v2, -2);
    assert.equal(v1 ^ v3, 65534);
    assert.equal(v1 ^ v4, 2147483646);
    assert.equal(v1 ^ v5, 2147483649);
    assert.equal(v1 ^ v6, -2147483647);
    assert.equal(v1 ^ v7, 1099511627777);
    assert.equal(v1 ^ v8, 9007199254740990);
    assert.equal(v1 ^ v9, -9007199254740992);
    assert.equal(v2 ^ v0, -1);
    assert.equal(v2 ^ v1, -2);
    assert.equal(v2 ^ v2, 0);
    assert.equal(v2 ^ v3, -65536);
    assert.equal(v2 ^ v4, -2147483648);
    assert.equal(v2 ^ v5, -2147483649);
    assert.equal(v2 ^ v6, 2147483647);
    assert.equal(v2 ^ v7, -1099511627777);
    assert.equal(v2 ^ v8, -9007199254740992);
    assert.equal(v2 ^ v9, 9007199254740990);
    assert.equal(v3 ^ v0, 65535);
    assert.equal(v3 ^ v1, 65534);
    assert.equal(v3 ^ v2, -65536);
    assert.equal(v3 ^ v3, 0);
    assert.equal(v3 ^ v4, 2147418112);
    assert.equal(v3 ^ v5, 2147549183);
    assert.equal(v3 ^ v6, -2147418113);
    assert.equal(v3 ^ v7, 1099511693311);
    assert.equal(v3 ^ v8, 9007199254675456);
    assert.equal(v3 ^ v9, -9007199254675458);
    assert.equal(v4 ^ v0, 2147483647);
    assert.equal(v4 ^ v1, 2147483646);
    assert.equal(v4 ^ v2, -2147483648);
    assert.equal(v4 ^ v3, 2147418112);
    assert.equal(v4 ^ v4, 0);
    assert.equal(v4 ^ v5, 4294967295);
    assert.equal(v4 ^ v6, -1);
    assert.equal(v4 ^ v7, 1101659111423);
    assert.equal(v4 ^ v8, 9007197107257344);
    assert.equal(v4 ^ v9, -9007197107257346);
    assert.equal(v5 ^ v0, 2147483648);
    assert.equal(v5 ^ v1, 2147483649);
    assert.equal(v5 ^ v2, -2147483649);
    assert.equal(v5 ^ v3, 2147549183);
    assert.equal(v5 ^ v4, 4294967295);
    assert.equal(v5 ^ v5, 0);
    assert.equal(v5 ^ v6, -4294967296);
    assert.equal(v5 ^ v7, 1101659111424);
    assert.equal(v5 ^ v8, 9007197107257343);
    assert.equal(v5 ^ v9, -9007197107257343);
    assert.equal(v6 ^ v0, -2147483648);
    assert.equal(v6 ^ v1, -2147483647);
    assert.equal(v6 ^ v2, 2147483647);
    assert.equal(v6 ^ v3, -2147418113);
    assert.equal(v6 ^ v4, -1);
    assert.equal(v6 ^ v5, -4294967296);
    assert.equal(v6 ^ v6, 0);
    assert.equal(v6 ^ v7, -1101659111424);
    assert.equal(v6 ^ v8, -9007197107257345);
    assert.equal(v6 ^ v9, 9007197107257345);
    assert.equal(v7 ^ v0, 1099511627776);
    assert.equal(v7 ^ v1, 1099511627777);
    assert.equal(v7 ^ v2, -1099511627777);
    assert.equal(v7 ^ v3, 1099511693311);
    assert.equal(v7 ^ v4, 1101659111423);
    assert.equal(v7 ^ v5, 1101659111424);
    assert.equal(v7 ^ v6, -1101659111424);
    assert.equal(v7 ^ v7, 0);
    assert.equal(v7 ^ v8, 9006099743113215);
    assert.equal(v7 ^ v9, -9006099743113215);
    assert.equal(v8 ^ v0, 9007199254740991);
    assert.equal(v8 ^ v1, 9007199254740990);
    assert.equal(v8 ^ v2, -9007199254740992);
    assert.equal(v8 ^ v3, 9007199254675456);
    assert.equal(v8 ^ v4, 9007197107257344);
    assert.equal(v8 ^ v5, 9007197107257343);
    assert.equal(v8 ^ v6, -9007197107257345);
    assert.equal(v8 ^ v7, 9006099743113215);
    assert.equal(v8 ^ v8, 0);
    assert.equal(v8 ^ v9, -2);
    assert.equal(v9 ^ v0, -9007199254740991);
    assert.equal(v9 ^ v1, -9007199254740992);
    assert.equal(v9 ^ v2, 9007199254740990);
    assert.equal(v9 ^ v3, -9007199254675458);
    assert.equal(v9 ^ v4, -9007197107257346);
    assert.equal(v9 ^ v5, -9007197107257343);
    assert.equal(v9 ^ v6, 9007197107257345);
    assert.equal(v9 ^ v7, -9006099743113215);
    assert.equal(v9 ^ v8, -2);
    assert.equal(v9 ^ v9, 0);
}

test "~ agrees with the 64-bit answer at every boundary" {
    let v0: Int = 0;
    let v1: Int = 1;
    let v2: Int = -1;
    let v3: Int = 65535;
    let v4: Int = 2147483647;
    let v5: Int = 2147483648;
    let v6: Int = -2147483648;
    let v7: Int = 1099511627776;
    let v8: Int = 9007199254740991;
    let v9: Int = -9007199254740991;
    assert.equal(~v0, -1);
    assert.equal(~v1, -2);
    assert.equal(~v2, 0);
    assert.equal(~v3, -65536);
    assert.equal(~v4, -2147483648);
    assert.equal(~v5, -2147483649);
    assert.equal(~v6, 2147483647);
    assert.equal(~v7, -1099511627777);
    assert.equal(~v8, -9007199254740992);
    assert.equal(~v9, 9007199254740990);
}

// --- identities ----------------------------------------------------------------------
//
// `x | 0`, `x ^ 0`, `x & 0`, `x & x`, `x | x` and `x ^ x` all have answers that
// follow from `x` alone, and the backend takes them before the width dispatch —
// above 32 bits each would otherwise be a call into the runtime. The answers
// have to be the same either way, including at the values where a 32-bit
// operator would have been wrong.

test "the bitwise identities hold above 32 bits" {
    let big: Int = 1099511627776;
    let huge: Int = 9007199254740991;
    let negative: Int = -9007199254740991;
    assert.equal(big | 0, big);
    assert.equal(big ^ 0, big);
    assert.equal(big & 0, 0);
    assert.equal(big & big, big);
    assert.equal(big | big, big);
    assert.equal(big ^ big, 0);
    assert.equal(huge | 0, huge);
    assert.equal(huge & huge, huge);
    assert.equal(huge ^ huge, 0);
    assert.equal(negative | 0, negative);
    assert.equal(negative & negative, negative);
    assert.equal(negative ^ negative, 0);
    assert.equal(negative & 0, 0);
}

test "the bitwise identities hold with zero on the left" {
    let big: Int = 1099511627776;
    assert.equal(0 | big, big);
    assert.equal(0 ^ big, big);
    assert.equal(0 & big, 0);
}
