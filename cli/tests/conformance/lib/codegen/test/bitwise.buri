    assert.equal(v4 | v5, 4294967295);
    assert.equal(v4 | v6, -1);
    assert.equal(v4 | v7, 1101659111423);
    assert.equal(v4 | v8, 9007199254740991);
    assert.equal(v4 | v9, -9007197107257345);
    assert.equal(v5 | v0, 2147483648);
    assert.equal(v5 | v1, 2147483649);
    assert.equal(v5 | v2, -1);
    assert.equal(v5 | v3, 2147549183);
    assert.equal(v5 | v4, 4294967295);
    assert.equal(v5 | v5, 2147483648);
    assert.equal(v5 | v6, -2147483648);
    assert.equal(v5 | v7, 1101659111424);
    assert.equal(v5 | v8, 9007199254740991);
    assert.equal(v5 | v9, -9007197107257343);
    assert.equal(v6 | v0, -2147483648);
    assert.equal(v6 | v1, -2147483647);
