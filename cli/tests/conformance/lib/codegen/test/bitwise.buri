// SPEC 6.2.1 — the bitwise operators at `Int`, which is `I64`, across the
// boundaries where a 32-bit implementation stops being the right answer.
//
// `Int` is 64 bits and JavaScript's own `&`, `|`, `^` and `~` coerce to 32-bit
// signed, so the runtime takes a 32-bit path only where it is *exact* — both
// operands already inside signed 32-bit, where the operators distribute over
// sign extension — and builds BigInts otherwise. The two paths must be
// indistinguishable, and the values below are chosen to land on both sides of
// that boundary and on the edges of each: zero, one, all-ones, 2^16-1, 2^31-1,
// 2^31 (just past the fast path), -2^31, 2^40, and ±(2^53-1), the largest
// integers a double holds exactly.
//
// The expected answers are 64-bit two's complement, so they hold whether the
// operation is folded at compile time or run by the runtime helper. The
// operands are bound rather than written inline because a bare integer literal
// has no width yet, and these operators are defined on a width.

from "core/testing/assert" import * as assert;

test "& agrees with the 64-bit answer at every boundary" {
    let v0: Int = 0;
    let v1: Int = 1;
    let v2: Int = -1;
    let v3: Int = 65535;
    let v4: Int = 2147483647;
    let v5: Int = 2147483648;
    let v6: Int = -2147483648;
    let v7: Int = 1099511627776;
    let v8: Int = 9007199254740991;
    let v9: Int = -9007199254740991;
    assert.equal(v0 & v0, 0);
    assert.equal(v0 & v1, 0);
    assert.equal(v0 & v2, 0);
    assert.equal(v0 & v3, 0);
    assert.equal(v0 & v4, 0);
    assert.equal(v0 & v5, 0);
    assert.equal(v0 & v6, 0);
    assert.equal(v0 & v7, 0);
    assert.equal(v0 & v8, 0);
    assert.equal(v0 & v9, 0);
    assert.equal(v1 & v0, 0);
    assert.equal(v1 & v1, 1);
    assert.equal(v1 & v2, 1);
    assert.equal(v1 & v3, 1);
    assert.equal(v1 & v4, 1);
    assert.equal(v1 & v5, 0);
    assert.equal(v1 & v6, 0);
    assert.equal(v1 & v7, 0);
    assert.equal(v1 & v8, 1);
    assert.equal(v1 & v9, 1);
    assert.equal(v2 & v0, 0);
    assert.equal(v2 & v1, 1);
    assert.equal(v2 & v2, -1);
    assert.equal(v2 & v3, 65535);
    assert.equal(v2 & v4, 2147483647);
    assert.equal(v2 & v5, 2147483648);
    assert.equal(v2 & v6, -2147483648);
    assert.equal(v2 & v7, 1099511627776);
    assert.equal(v2 & v8, 9007199254740991);
    assert.equal(v2 & v9, -9007199254740991);
    assert.equal(v3 & v0, 0);
    assert.equal(v3 & v1, 1);
    assert.equal(v3 & v2, 65535);
    assert.equal(v3 & v3, 65535);
    assert.equal(v3 & v4, 65535);
    assert.equal(v3 & v5, 0);
    assert.equal(v3 & v6, 0);
    assert.equal(v3 & v7, 0);
    assert.equal(v3 & v8, 65535);
    assert.equal(v3 & v9, 1);
    assert.equal(v4 & v0, 0);
    assert.equal(v4 & v1, 1);
    assert.equal(v4 & v2, 2147483647);
    assert.equal(v4 & v3, 65535);
    assert.equal(v4 & v4, 2147483647);
    assert.equal(v4 & v5, 0);
    assert.equal(v4 & v6, 0);
    assert.equal(v4 & v7, 0);
    assert.equal(v4 & v8, 2147483647);
    assert.equal(v4 & v9, 1);
    assert.equal(v5 & v0, 0);
    assert.equal(v5 & v1, 0);
    assert.equal(v5 & v2, 2147483648);
    assert.equal(v5 & v3, 0);
    assert.equal(v5 & v4, 0);
    assert.equal(v5 & v5, 2147483648);
    assert.equal(v5 & v6, 2147483648);
    assert.equal(v5 & v7, 0);
    assert.equal(v5 & v8, 2147483648);
    assert.equal(v5 & v9, 0);
    assert.equal(v6 & v0, 0);
    assert.equal(v6 & v1, 0);
    assert.equal(v6 & v2, -2147483648);
    assert.equal(v6 & v3, 0);
    assert.equal(v6 & v4, 0);
    assert.equal(v6 & v5, 2147483648);
    assert.equal(v6 & v6, -2147483648);
    assert.equal(v6 & v7, 1099511627776);
    assert.equal(v6 & v8, 9007197107257344);
    assert.equal(v6 & v9, -9007199254740992);
    assert.equal(v7 & v0, 0);
    assert.equal(v7 & v1, 0);
    assert.equal(v7 & v2, 1099511627776);
    assert.equal(v7 & v3, 0);
    assert.equal(v7 & v4, 0);
    assert.equal(v7 & v5, 0);
    assert.equal(v7 & v6, 1099511627776);
    assert.equal(v7 & v7, 1099511627776);
    assert.equal(v7 & v8, 1099511627776);
    assert.equal(v7 & v9, 0);
    assert.equal(v8 & v0, 0);
    assert.equal(v8 & v1, 1);
    assert.equal(v8 & v2, 9007199254740991);
    assert.equal(v8 & v3, 65535);
    assert.equal(v8 & v4, 2147483647);
    assert.equal(v8 & v5, 2147483648);
    assert.equal(v8 & v6, 9007197107257344);
    assert.equal(v8 & v7, 1099511627776);
    assert.equal(v8 & v8, 9007199254740991);
    assert.equal(v8 & v9, 1);
    assert.equal(v9 & v0, 0);
    assert.equal(v9 & v1, 1);
    assert.equal(v9 & v2, -9007199254740991);
    assert.equal(v9 & v3, 1);
    assert.equal(v9 & v4, 1);
    assert.equal(v9 & v5, 0);
    assert.equal(v9 & v6, -9007199254740992);
    assert.equal(v9 & v7, 0);
    assert.equal(v9 & v8, 1);
    assert.equal(v9 & v9, -9007199254740991);
}

test "| agrees with the 64-bit answer at every boundary" {
    let v0: Int = 0;
    let v1: Int = 1;
    let v2: Int = -1;
    let v3: Int = 65535;
    let v4: Int = 2147483647;
    let v5: Int = 2147483648;
    let v6: Int = -2147483648;
    let v7: Int = 1099511627776;
    let v8: Int = 9007199254740991;
    let v9: Int = -9007199254740991;
    assert.equal(v0 | v0, 0);
    assert.equal(v0 | v1, 1);
    assert.equal(v0 | v2, -1);
    assert.equal(v0 | v3, 65535);
    assert.equal(v0 | v4, 2147483647);
    assert.equal(v0 | v5, 2147483648);
    assert.equal(v0 | v6, -2147483648);
    assert.equal(v0 | v7, 1099511627776);
    assert.equal(v0 | v8, 9007199254740991);
    assert.equal(v0 | v9, -9007199254740991);
