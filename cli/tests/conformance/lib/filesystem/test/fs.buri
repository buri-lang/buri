// core/fs — what is on the filesystem, and what changes it.
//
// The new half of the module: `metadata` and the two questions built on it,
// the directory listing that says what each entry is, the walk over it, the
// copy, the recursive delete, the window into a large file, and the two paths
// a program asks the platform for.
//
// Everything runs against `core/host/testing`'s `fs()`, which is a flat map in
// memory: it holds no symbolic links, so `.Symlink` never appears here, and its
// `modified` is the epoch. `native::e2e` is where a real tree answers.

from "core/effect" import { Allocator, Entropy, Environment };
from "core/fs" import * as fs;
from "core/fs" import { FileSystemRead, FileSystemWrite };
from "core/host/testing" import {
    alloc, copyFile, entropy, env, fs as disk, metadata, readDir, readRange, realPath,
    removeFile,
};
from "core/path" import * as path;
from "core/testing/assert" import * as assert;
from "core/time" import { Instant };

// -----------------------------------------------------------------------------
// metadata, and the two questions over it
// -----------------------------------------------------------------------------

test "a file's metadata is its kind, its octets and its timestamp" {
    let files = disk().files([("notes.txt", "hello")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    let info = assert.ok(fs.metadata(ctx, path.of(ctx, "notes.txt")));
    assert.equal(info.kind, .File);
    assert.equal(info.size, 5);
    assert.equal(info.modified, Instant(0));
}

test "a directory makeDir recorded is a directory" {
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "var/log")));
    let info = assert.ok(fs.metadata(ctx, path.of(ctx, "var/log")));
    assert.equal(info.kind, .Directory);
    assert.equal(info.size, 0);
}

test "a path naming nothing is NotFound" {
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.equal(assert.err(fs.metadata(ctx, path.of(ctx, "b"))), .NotFound);
}

test "isFile and isDirectory answer false for what is not there" {
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "d")));
    assert.isTrue(fs.isFile(ctx, path.of(ctx, "a")));
    assert.isFalse(fs.isDirectory(ctx, path.of(ctx, "a")));
    assert.isTrue(fs.isDirectory(ctx, path.of(ctx, "d")));
    assert.isFalse(fs.isFile(ctx, path.of(ctx, "d")));
    assert.isFalse(fs.isFile(ctx, path.of(ctx, "gone")));
    assert.isFalse(fs.isDirectory(ctx, path.of(ctx, "gone")));
}

test "an unreadable path reads as false rather than as an error" {
    // A fault is the only way to make a path that is there refuse to answer,
    // and `isFile` has nowhere to put the refusal — which the doc comment says
    // and this is.
    let files = disk()
        .files([("a", "A")])
        .faults([metadata("a").fails(.PermissionDenied)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.isFalse(fs.isFile(ctx, path.of(ctx, "a")));
}

// -----------------------------------------------------------------------------
// Listing, and walking
// -----------------------------------------------------------------------------

test "a listing says what each entry is" {
    let files = disk().files([("src/main.buri", "x"), ("src/lib.buri", "y")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "src/net")));
    let entries = assert.ok(fs.listDirectoryEntries(ctx, path.of(ctx, "src")));
    assert.equal(entries, [
        ("lib.buri", .File),
        ("main.buri", .File),
        ("net", .Directory),
    ]);
}

test "an empty directory lists nothing" {
    // A directory this filesystem does not have lists nothing rather than
    // failing: `readDir` on a flat map reads keys by prefix, so absence and
    // emptiness are the same question. A real one tells them apart, and
    // `native::e2e` is where that is asserted.
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "empty")));
    assert.isEmpty(assert.ok(fs.listDirectoryEntries(ctx, path.of(ctx, "empty"))));
}

test "walk lists a directory before what is inside it" {
    // `makeDir` for the nested one, because a flat map's parents are not
    // directories until something says so — `TestFileSystem` states that.
    let files = disk().files([("t/a.txt", "a"), ("t/deep/b.txt", "b")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "t/deep")));
    let found = assert.ok(fs.walk(ctx, path.of(ctx, "t"))).map(ctx, fn(p) => p.text());
    assert.equal(found, ["t/a.txt", "t/deep", "t/deep/b.txt"]);
}

test "walking an empty tree finds nothing" {
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "empty")));
    assert.isEmpty(assert.ok(fs.walk(ctx, path.of(ctx, "empty"))));
}

test "a walk stops at the first entry it cannot read" {
    let files = disk()
        .files([("t/a.txt", "a")])
        .faults([metadata("t/a.txt").fails(.PermissionDenied)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.equal(assert.err(fs.walk(ctx, path.of(ctx, "t"))), .PermissionDenied);
}

test "a deep tree comes back a directory at a time, deepest last" {
    // Four levels, with a sibling at two of them: depth first means a
    // directory is followed by everything under it before its own next
    // sibling, which one level could not show.
    let files = disk().files([
        ("t/a.txt", "a"),
        ("t/one/b.txt", "b"),
        ("t/one/deeper/c.txt", "c"),
        ("t/two/d.txt", "d"),
    ]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "t/one/deeper")));
    assert.ok(fs.makeDir(ctx, path.of(ctx, "t/two")));
    let found = assert.ok(fs.walk(ctx, path.of(ctx, "t"))).map(ctx, fn(p) => p.text());
    assert.equal(found, [
        "t/a.txt",
        "t/one",
        "t/one/b.txt",
        "t/one/deeper",
        "t/one/deeper/c.txt",
        "t/two",
        "t/two/d.txt",
    ]);
}

test "a directory that will not open stops the walk where it is" {
    // The refusal is a directory below the root, so the walk had already
    // listed part of the tree when it met one: the whole call is the failure
    // rather than the paths it had collected.
    let files = disk()
        .files([("t/a.txt", "a"), ("t/deep/b.txt", "b")])
        .faults([readDir("t/deep").fails(.PermissionDenied)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "t/deep")));
    assert.equal(assert.err(fs.walk(ctx, path.of(ctx, "t"))), .PermissionDenied);
}

test "a listing and a walk of what is not there are two different answers" {
    // A flat map cannot tell an empty directory from one nobody made, so what
    // this pins is the *shape* of the two calls: a listing that fails is a
    // failure and a walk carries it up. `native::e2e` is where a real
    // filesystem tells absence from emptiness.
    let files = disk()
        .files([("t/a.txt", "a")])
        .faults([readDir("gone").fails(.NotFound)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.equal(
        assert.err(fs.listDirectoryEntries(ctx, path.of(ctx, "gone"))),
        .NotFound,
    );
    assert.equal(assert.err(fs.walk(ctx, path.of(ctx, "gone"))), .NotFound);
}

// -----------------------------------------------------------------------------
// A window into a file
// -----------------------------------------------------------------------------

test "readRange gives the octets it was asked for" {
    let files = disk().filesBytes([("blob", [1, 2, 3, 4, 5])]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    let at = path.of(ctx, "blob");
    assert.equal(assert.ok(fs.readRange(ctx, at, 1, 3)), [2, 3, 4]);
    assert.equal(assert.ok(fs.readRange(ctx, at, 0, 99)), [1, 2, 3, 4, 5]);
    assert.isEmpty(assert.ok(fs.readRange(ctx, at, 0, 0)));
}

test "a range past the end is empty, and a negative one is an error" {
    let files = disk().filesBytes([("blob", [7, 8])]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    let at = path.of(ctx, "blob");
    assert.isEmpty(assert.ok(fs.readRange(ctx, at, 9, 4)));
    assert.equal(
        assert.err(fs.readRange(ctx, at, 0 - 1, 4)),
        .Other("a negative offset or count"),
    );
    assert.equal(assert.err(fs.readRange(ctx, path.of(ctx, "gone"), 0, 1)), .NotFound);
}

test "the four edges of the window: the end, past it, across it, and none of it" {
    let files = disk().filesBytes([("blob", [1, 2, 3, 4])]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    let at = path.of(ctx, "blob");
    // At the last octet, and at exactly the end.
    assert.equal(assert.ok(fs.readRange(ctx, at, 3, 1)), [4]);
    assert.isEmpty(assert.ok(fs.readRange(ctx, at, 4, 2)));
    // Spanning the end gives what is there rather than failing.
    assert.equal(assert.ok(fs.readRange(ctx, at, 2, 99)), [3, 4]);
    // A count of zero is the empty list wherever it is asked from.
    assert.isEmpty(assert.ok(fs.readRange(ctx, at, 0, 0)));
    assert.isEmpty(assert.ok(fs.readRange(ctx, at, 2, 0)));
    assert.isEmpty(assert.ok(fs.readRange(ctx, at, 99, 0)));
}

test "a negative count is an error, and so are two negatives" {
    let files = disk().filesBytes([("blob", [7, 8])]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    let at = path.of(ctx, "blob");
    assert.equal(
        assert.err(fs.readRange(ctx, at, 0, 0 - 1)),
        .Other("a negative offset or count"),
    );
    assert.equal(
        assert.err(fs.readRange(ctx, at, 0 - 5, 0 - 5)),
        .Other("a negative offset or count"),
    );
}

test "an empty file has no window to give" {
    let files = disk().filesBytes([("empty", [])]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.isEmpty(assert.ok(fs.readRange(ctx, path.of(ctx, "empty"), 0, 8)));
}

// -----------------------------------------------------------------------------
// Copying, and deleting a tree
// -----------------------------------------------------------------------------

test "a copy leaves both files behind" {
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b")));
    assert.equal(files.snapshot(), [("a", "A"), ("b", "A")]);
}

test "a copy onto itself leaves the file exactly as it was" {
    // The shape that empties a file where a copy truncates its destination
    // before it reads its source. It is `.Ok`, and the octets are still there.
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "a")));
    assert.equal(files.snapshot(), [("a", "A")]);
}

test "a copy over a file that is there replaces the whole of it" {
    // Whole contents, not a merge and not an append: the destination's own
    // octets are gone, including the ones past the end of the source.
    let files = disk().files([("a", "A"), ("b", "BBBB")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b")));
    assert.equal(files.snapshot(), [("a", "A"), ("b", "A")]);
}

test "an empty file copies as an empty file" {
    let files = disk().filesBytes([("a", [])]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b")));
    assert.isEmpty(assert.ok(fs.readBytes(ctx, path.of(ctx, "b"))));
}

test "a copy into a directory nobody made is the one answer a map cannot give" {
    // A flat map has no directories to be missing, so the key is simply
    // written. A real filesystem answers `.NotFound`, and `native::e2e` is
    // where that is asserted — this block is here so the difference is written
    // down rather than found later.
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "nowhere/b")));
    assert.equal(files.snapshot(), [("a", "A"), ("nowhere/b", "A")]);
}

test "copying what is not there is NotFound, and a read-only view refuses" {
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.equal(
        assert.err(fs.copy(ctx, path.of(ctx, "gone"), path.of(ctx, "b"))),
        .NotFound,
    );
    let frozen = files.readOnly();
    let sealed = context {
        Allocator: alloc(),
        FileSystemRead: frozen,
        FileSystemWrite: frozen,
    };
    assert.equal(
        assert.err(fs.copy(sealed, path.of(sealed, "a"), path.of(sealed, "c"))),
        .ReadOnly,
    );
}

test "removeTree takes the whole tree with it" {
    let files = disk().files([("t/a", "A"), ("t/deep/b", "B"), ("keep", "K")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "t/deep")));
    assert.ok(fs.removeTree(ctx, path.of(ctx, "t")));
    assert.equal(files.snapshot(), [("keep", "K")]);
    assert.isFalse(fs.exists(ctx, path.of(ctx, "t")));
}

test "removeTree on a file removes the file, and on nothing is NotFound" {
    let files = disk().files([("f", "F")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.removeTree(ctx, path.of(ctx, "f")));
    assert.isEmpty(files.snapshot());
    assert.equal(assert.err(fs.removeTree(ctx, path.of(ctx, "f"))), .NotFound);
}

test "removeTree on an empty directory takes the directory" {
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "scratch")));
    assert.ok(fs.removeTree(ctx, path.of(ctx, "scratch")));
    assert.isFalse(fs.exists(ctx, path.of(ctx, "scratch")));
}

test "a tree nothing may write to is left where it is" {
    // What a read-only entry costs: the walk finds the tree, the first removal
    // is refused, and the error is the answer. A partly removed tree is a real
    // outcome, so the assertion is that this one is not partly removed — the
    // refusal came before anything went.
    let files = disk().files([("t/a", "A"), ("t/deep/b", "B")]);
    let building = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(building, path.of(building, "t/deep")));
    let frozen = files.readOnly();
    let sealed = context {
        Allocator: alloc(),
        FileSystemRead: frozen,
        FileSystemWrite: frozen,
    };
    assert.equal(assert.err(fs.removeTree(sealed, path.of(sealed, "t"))), .ReadOnly);
    assert.equal(files.snapshot(), [("t/a", "A"), ("t/deep/b", "B")]);
}

test "removeTree stops at the first entry it cannot take, and says which" {
    let files = disk()
        .files([("t/a", "A"), ("t/b", "B")])
        .faults([removeFile("t/b").fails(.PermissionDenied)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(ctx, path.of(ctx, "t")));
    assert.equal(assert.err(fs.removeTree(ctx, path.of(ctx, "t"))), .PermissionDenied);
    // The one it reached first is gone, and the tree above it is still there:
    // this is the partly removed tree the doc comment names.
    assert.equal(files.snapshot(), [("t/b", "B")]);
}

// -----------------------------------------------------------------------------
// The two paths a program asks the platform for
// -----------------------------------------------------------------------------

test "canonicalize answers the path the filesystem holds" {
    let files = disk().files([("a/b", "B")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.equal(
        assert.ok(fs.canonicalize(ctx, path.of(ctx, "a/b"))),
        path.of(ctx, "a/b"),
    );
    assert.equal(assert.err(fs.canonicalize(ctx, path.of(ctx, "gone"))), .NotFound);
}

test "the current directory canonicalizes and `..` has nothing to resolve to" {
    // A flat map has no links and no directory above it, so `.` is itself and
    // `..` names nothing. What the *filesystem* makes of both is asserted in
    // `native::e2e`, which is the only place either question has an answer.
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
    };
    assert.equal(assert.ok(fs.canonicalize(ctx, path.of(ctx, "."))), path.of(ctx, "."));
    assert.equal(assert.err(fs.canonicalize(ctx, path.of(ctx, ".."))), .NotFound);
    assert.equal(assert.err(fs.canonicalize(ctx, path.of(ctx, "a/../a"))), .NotFound);
}

test "a temporary directory is under TMPDIR and exists once it is made" {
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
        Environment: env().variables([("TMPDIR", "/scratch")]),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    let made = assert.ok(fs.makeTemporaryDirectory(ctx, "build-"));
    assert.isTrue(made.startsWith(path.of(ctx, "/scratch")));
    assert.isTrue(fs.exists(ctx, made));
    // The prefix, then sixteen hex characters: `crypto.token(ctx, 8)`.
    assert.equal(assert.some(made.fileName()).length(), 22);
}

test "two temporary directories are two directories" {
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
        Environment: env(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    let one = assert.ok(fs.makeTemporaryDirectory(ctx, "a"));
    let two = assert.ok(fs.makeTemporaryDirectory(ctx, "a"));
    assert.notEq(one, two);
    assert.isTrue(one.startsWith(path.of(ctx, "/tmp")));
}

test "an empty prefix is a name of sixteen hex characters and nothing else" {
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
        Environment: env(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    let made = assert.ok(fs.makeTemporaryDirectory(ctx, ""));
    assert.equal(assert.some(made.fileName()).length(), 16);
    assert.equal(assert.some(made.parent()), path.of(ctx, "/tmp"));
}

test "a prefix with a separator in it names a directory further down" {
    // `prefix` is joined onto the temporary directory, and `join` is `join`:
    // a `/` in it makes the scratch directory deeper rather than being
    // rejected. Every parent is created, so what comes back is still there.
    let files = disk();
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
        Environment: env().variables([("TMPDIR", "/scratch")]),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    let made = assert.ok(fs.makeTemporaryDirectory(ctx, "buri/build-"));
    assert.isTrue(made.startsWith(path.of(ctx, "/scratch/buri")));
    assert.isTrue(fs.isDirectory(ctx, made));
    assert.isTrue(fs.isDirectory(ctx, path.of(ctx, "/scratch/buri")));
}

// -----------------------------------------------------------------------------
// The log
// -----------------------------------------------------------------------------

test "the four new methods are calls the log reports" {
    let files = disk().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    let _ = assert.ok(fs.metadata(ctx, path.of(ctx, "a")));
    let _ = assert.ok(fs.readRange(ctx, path.of(ctx, "a"), 0, 1));
    let _ = assert.ok(fs.canonicalize(ctx, path.of(ctx, "a")));
    assert.ok(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b")));
    assert.equal(files.calls(), [
        metadata("a"),
        readRange("a"),
        realPath("a"),
        copyFile("a", "b"),
    ]);
}

test "a fault fires on the method it names" {
    let files = disk()
        .files([("a", "A")])
        .faults([copyFile("a", "b").fails(.ReadOnly)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.equal(
        assert.err(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b"))),
        .ReadOnly,
    );
}

test "a call the plan failed writes nothing" {
    let files = disk()
        .files([("a", "A")])
        .faults([copyFile("a", "b").fails(.ReadOnly)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.equal(
        assert.err(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b"))),
        .ReadOnly,
    );
    assert.equal(files.snapshot(), [("a", "A")]);
}

test "a call the plan failed is still a call the log has" {
    let files = disk()
        .files([("a", "A")])
        .faults([copyFile("a", "b").fails(.ReadOnly)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.equal(
        assert.err(fs.copy(ctx, path.of(ctx, "a"), path.of(ctx, "b"))),
        .ReadOnly,
    );
    assert.equal(files.calls(), [copyFile("a", "b")]);
}
