// core/compression — RFC 1951 and RFC 1952.
//
// The compressed vectors were produced by zlib and gzip, not by this
// implementation, so a passing case is agreement with the format. The one
// stream this implementation *writes* is checked against zlib's own fixed
// Huffman output for the same three bytes.

from "core/bytes" import * as bytes;
from "core/bytes" import { DecodeError };
from "core/compression" import * as compression;
from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

fn octets(text: Str): [U8] {
    let ctx = context {
        Alloc: alloc(),
    };
    bytes.toUtf8(ctx, text)
}

fn text(b: [U8]): Str {
    let ctx = context {
        Alloc: alloc(),
    };
    bytes.fromUtf8(ctx, b).withDefault("<not utf-8>")
}

fn packed(raw: [U8]): [U8] {
    let ctx = context {
        Alloc: alloc(),
    };
    compression.deflate(ctx, raw)
}

fn unpacked(body: [U8]): Result<[U8], DecodeError> {
    let ctx = context {
        Alloc: alloc(),
    };
    compression.inflate(ctx, body)
}

fn wrapped(raw: [U8]): [U8] {
    let ctx = context {
        Alloc: alloc(),
    };
    compression.gzip(ctx, raw)
}

fn unwrapped(body: [U8]): Result<[U8], DecodeError> {
    let ctx = context {
        Alloc: alloc(),
    };
    compression.gunzip(ctx, body)
}

/// The same bytes with the one at `index` replaced. A list is a value, so this
/// is a splice rather than a write.
fn changed(b: [U8], index: Int, value: U8): [U8] {
    let ctx = context {
        Alloc: alloc(),
    };
    b.take(ctx, index).push(ctx, value).concat(ctx, b.drop(ctx, index + 1))
}

// About six kilobytes, and no two lines alike, so the match finder has to walk
// its chain rather than answering with one enormous run.
fn large(): [U8] {
    let ctx = context {
        Alloc: alloc(),
    };
    list
        .range(ctx, 0, 120)
        .mapCtx(ctx, fn(c, i) => {
            bytes.toUtf8(
                c,
                str.format(
                    c,
                    "line ${i}: the quick brown fox jumps over the lazy dog.\n",
                ),
            )
        })
        .flatten(ctx)
}

