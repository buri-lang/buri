let DYNAMIC_TEXT: Str =
    "Buri is a small language. Deflate is a small format. Huffman codes and back references, nothing else at all. A dynamic block writes its own two trees ahead of the data, and a third tree compresses those. Read them and the rest is easy.";

// zlib again, with a sync flush in the middle: a fixed block, then an empty
// stored block, then the final fixed block.
let MULTIBLOCK: [U8] = [
    74,
    203,
    44,
    42,
    46,
    81,
    0,
    0,
    0,
    0,
    255,
    255,
    43,
    78,
    77,
    206,
    207,
    75,
    1,
    0,
];

// `gzip -9`, mtime zero, over "hello, gzip\n".
let GZIP_HELLO: [U8] = [
    31,
    139,
    8,
    0,
    0,
    0,
    0,
    0,
    2,
    255,
