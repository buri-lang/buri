// --- What `deflate` writes ------------------------------------------------------

test "the empty input is a stream that says where it ends" {
    // Three bits of block header and seven of end-of-block: the two bytes every
    // zlib writes for nothing at all.
    assert.equal(packed(list.empty<U8>()), [3, 0]);
    assert.equal(assert.ok(unpacked([3, 0])), list.empty<U8>());
}

test "three literals are the bytes zlib's fixed Huffman writes" {
    assert.equal(packed(octets("abc")), [75, 76, 74, 6, 0]);
}

test "what it writes, it reads" {
    assert.equal(text(assert.ok(unpacked(packed(octets("abc"))))), "abc");
    assert.equal(
        text(assert.ok(unpacked(packed(octets("ha ha ha ha ha ha ha ha!"))))),
        "ha ha ha ha ha ha ha ha!",
    );
    assert.equal(text(assert.ok(unpacked(packed(octets(DYNAMIC_TEXT))))), DYNAMIC_TEXT);
}

test "a run longer than one match code round-trips" {
    let ctx = context {
        Allocator: alloc(),
    };
    // 700 bytes of one value: longer than the 258 a single length code can say,
    // so the emitter has to write more than one back-reference.
    let filler: U8 = 65;
    let run = list.repeat(ctx, filler, 700);
    assert.equal(assert.ok(unpacked(packed(run))), run);
}

// --- What `inflate` reads -------------------------------------------------------

test "a stored block is its bytes" {
    assert.equal(text(assert.ok(unpacked([1, 3, 0, 252, 255, 97, 98, 99]))), "abc");
}

test "a fixed-Huffman block" {
    assert.equal(text(assert.ok(unpacked([75, 76, 74, 6, 0]))), "abc");
}

test "a dynamic-Huffman block, tree and all" {
    assert.equal(text(assert.ok(unpacked(DYNAMIC))), DYNAMIC_TEXT);
}

test "more than one block in a stream" {
    assert.equal(text(assert.ok(unpacked(MULTIBLOCK))), "first second");
}

// --- What `inflate` refuses -----------------------------------------------------

test "nothing at all is not a stream" {
    assert.equal(assert.err(unpacked(list.empty<U8>())), DecodeError(0));
}

test "there is no fourth block type" {
    // `111`: a final block of type 11, which RFC 1951 reserves.
    assert.equal(assert.err(unpacked([7])), DecodeError(0));
}

test "a stream that stops mid-symbol" {
    assert.equal(assert.err(unpacked([75, 76])), DecodeError(2));
}

test "a stored block whose complement does not complement" {
    assert.equal(assert.err(unpacked([1, 3, 0, 0, 0, 97, 98, 99])), DecodeError(5));
}

test "a match that copies from before the start" {
    // One literal, then a length of 3 at a distance of 5, with one byte written.
    assert.equal(assert.err(unpacked([75, 4, 18, 0])), DecodeError(3));
}

// --- gzip -----------------------------------------------------------------------

test "a gzip member from gzip itself" {
    assert.equal(text(assert.ok(unwrapped(GZIP_HELLO))), "hello, gzip\n");
}

test "a header carrying a file name is read past" {
    assert.equal(text(assert.ok(unwrapped(GZIP_NAMED))), "named member");
}

test "what gzip writes, gunzip reads" {
    let raw = octets(DYNAMIC_TEXT);
    assert.equal(assert.ok(unwrapped(wrapped(raw))), raw);
    assert.equal(assert.ok(unwrapped(wrapped(list.empty<U8>()))), list.empty<U8>());
}

test "the header is the fixed ten bytes RFC 1952 asks for" {
    let ctx = context {
        Allocator: alloc(),
    };
    let member = wrapped(octets("x"));
    assert.equal(member.take(ctx, 10), [31, 139, 8, 0, 0, 0, 0, 0, 0, 255]);
}

test "a member is not a member without its magic number" {
    let ctx = context {
        Allocator: alloc(),
    };
    let zeroes: [U8] = list.repeat(ctx, 0, 24);
    assert.equal(assert.err(unwrapped(zeroes)), DecodeError(0));
}

test "a member shorter than a header" {
    assert.equal(assert.err(unwrapped([31, 139])), DecodeError(0));
}

test "a compression method that is not DEFLATE" {
    assert.equal(assert.err(unwrapped(changed(GZIP_HELLO, 2, 9))), DecodeError(2));
}

test "a trailer that does not match what came out" {
    // The last eight bytes are the CRC-32 and the length, in that order.
    assert.equal(assert.err(unwrapped(changed(GZIP_HELLO, 24, 0))), DecodeError(24));
    assert.equal(assert.err(unwrapped(changed(GZIP_HELLO, 28, 9))), DecodeError(28));
}

// --- A large input ---------------------------------------------------------------

test "six kilobytes there and back, through both wrappers" {
    let raw = large();
    assert.equal(assert.ok(unpacked(packed(raw))), raw);
    assert.equal(assert.ok(unwrapped(wrapped(raw))), raw);
}

test "and it actually compresses" {
    let raw = large();
    assert.lt(packed(raw).len(), raw.len() / 3);
}

// gzip again, with the extra field, the file name, the comment and the header
// checksum all present, over "flagged member".
