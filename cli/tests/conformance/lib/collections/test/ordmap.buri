// core/ordmap and core/ordset — the persistent B-tree, and the set over it.
//
// The cases worth writing are the ones that make the *structure* work rather
// than the interface. A node holds seven entries, so nothing below eight keys
// has ever split, and nothing that has not split has ever borrowed or merged:
// the large cases here are large on purpose, and the randomized one compares
// every answer against a sorted list, which is the model an ordered map is
// supposed to behave like.

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/ordmap" import * as ordmap;
from "core/ordmap" import { OrdMap };
from "core/ordset" import * as ordset;
from "core/ordset" import { OrdSet };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

/// The key half of an entry, for asserting on order.
fn keyOf<V>(entry: (Int, V)): Int {
    let (k, _) = entry;
    k
}

fn textOf<V>(entry: (Str, V)): Str {
    let (k, _) = entry;
    k
}

/// A map of `count` keys, inserted in an order that is not the key order —
/// which is what makes the tree split and rebalance rather than grow to one
/// side.
fn scattered<C: Alloc>(ctx: C, count: Int): OrdMap<Int, Int> {
    list
        .range(ctx, 0, count)
        .foldCtx(
            ctx,
            fn(c, acc: OrdMap<Int, Int>, i) => {
                let key = i * 137 % count;
                acc.insert(c, key, key * 2)
            },
            ordmap.empty<Int, Int>(),
        )
}

// --- empty ----------------------------------------------------------------------

test "an empty map holds nothing" {
    let m = ordmap.empty<Str, Int>();
    assert.eq(m.len(), 0);
    assert.isTrue(m.isEmpty());
    assert.isTrue(m.get("nothing").isNone());
    assert.isFalse(m.has("nothing"));
    assert.isTrue(m.first().isNone());
    assert.isTrue(m.last().isNone());
}

test "an empty map iterates to nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.empty<Str, Int>();
    assert.eq(m.entries(ctx).len(), 0);
    assert.eq(m.keys(ctx), list.empty<Str>());
    assert.eq(m.range(ctx, "a", "z").len(), 0);
    assert.eq(m.remove(ctx, "a").len(), 0);
}

// --- insert / get -----------------------------------------------------------------

test "insert then get" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.empty<Str, Int>().insert(ctx, "b", 2).insert(ctx, "a", 1);
    assert.eq(assert.some(m.get("a")), 1);
    assert.eq(assert.some(m.get("b")), 2);
    assert.eq(m.len(), 2);
    assert.isTrue(m.get("c").isNone());
}

test "inserting the same key replaces the value and does not change the size" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1), ("b", 2)]).insert(ctx, "a", 99);
    assert.eq(assert.some(m.get("a")), 99);
    assert.eq(m.len(), 2);
}

test "of holds every entry, later ones winning" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1), ("b", 2), ("a", 3)]);
    assert.eq(m.len(), 2);
    assert.eq(assert.some(m.get("a")), 3);
}

// --- key order --------------------------------------------------------------------

test "entries come out in key order whatever order they went in" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("delta", 4), ("alpha", 1), ("charlie", 3), ("bravo", 2)]);
    let names = m.entries(ctx).map(ctx, fn(e) => textOf(e));
    assert.eq(m.keys(ctx), ["alpha", "bravo", "charlie", "delta"]);
    assert.eq(m.values(ctx), [1, 2, 3, 4]);
    assert.eq(names, ["alpha", "bravo", "charlie", "delta"]);
}

test "a hundred keys inserted out of order come out in order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 100);
    assert.eq(m.len(), 100);
    assert.eq(m.keys(ctx), list.range(ctx, 0, 100));
    assert.eq(m.values(ctx), list.range(ctx, 0, 100).map(ctx, fn(k) => k * 2));
}

test "first and last are the ends of the key order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 100);
    assert.eq(keyOf(assert.some(m.first())), 0);
    assert.eq(keyOf(assert.some(m.last())), 99);
}

// --- remove -----------------------------------------------------------------------

test "remove takes a key out" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1), ("b", 2)]).remove(ctx, "a");
    assert.isTrue(m.get("a").isNone());
    assert.eq(assert.some(m.get("b")), 2);
    assert.eq(m.len(), 1);
}

test "removing a key that is not there changes nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1)]);
    assert.eq(m.remove(ctx, "zzz").len(), 1);
    assert.eq(assert.some(m.remove(ctx, "zzz").get("a")), 1);
}

test "removing every other key of two hundred leaves the rest in order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 200);
    let evens = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, k) => k % 2 == 0);
    let odds = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, k) => k % 2 == 1);
    let left = evens.foldCtx(
        ctx,
        fn(c, acc: OrdMap<Int, Int>, k) => acc.remove(c, k),
        m,
    );
    assert.eq(left.len(), 100);
    assert.eq(left.keys(ctx), odds);
    assert.isTrue(evens.all(fn(k) => left.get(k).isNone()));
    assert.isTrue(odds.all(fn(k) => left.get(k) == .Some(k * 2)));
}

test "removing every key of two hundred empties the map" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 200);
    // Out of key order again, so the removals fall in different places in the
    // tree and every rebalance — borrow left, borrow right, merge — is reached.
    let order = list.range(ctx, 0, 200).map(ctx, fn(i) => i * 91 % 200);
    let gone = order.foldCtx(
        ctx,
        fn(c, acc: OrdMap<Int, Int>, k) => acc.remove(c, k),
        m,
    );
    assert.eq(gone.len(), 0);
    assert.isTrue(gone.isEmpty());
    assert.isTrue(gone.first().isNone());
    assert.eq(gone.entries(ctx).len(), 0);
}

// --- persistence ------------------------------------------------------------------

test "a map is a value: inserting produces a new one" {
    let ctx = context {
        Alloc: alloc(),
    };
    let before = ordmap.of(ctx, [("a", 1)]);
    let after = before.insert(ctx, "b", 2);
    assert.eq(before.len(), 1);
    assert.eq(after.len(), 2);
    assert.isTrue(before.get("b").isNone());
}

test "the version a write shares its nodes with is unchanged" {
    let ctx = context {
        Alloc: alloc(),
    };
    let base = scattered(ctx, 120);
    // Enough writes to copy paths through most of the tree; `base` shares every
    // node none of them touched, and must still answer for all 120 keys.
    let insert = fn(c, acc: OrdMap<Int, Int>, k) => acc.insert(c, k, k * 2);
    let grown = list.range(ctx, 120, 200).foldCtx(ctx, insert, base);
    let drop = fn(c, acc: OrdMap<Int, Int>, k) => acc.remove(c, k);
    let shrunk = list.range(ctx, 0, 60).foldCtx(ctx, drop, base);
    assert.eq(base.len(), 120);
    assert.eq(base.keys(ctx), list.range(ctx, 0, 120));
    assert.eq(grown.len(), 200);
    assert.eq(grown.keys(ctx), list.range(ctx, 0, 200));
    assert.eq(shrunk.len(), 60);
    assert.eq(shrunk.keys(ctx), list.range(ctx, 60, 120));
}

// --- range ------------------------------------------------------------------------

test "range is half open" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 50);
    assert.eq(m.range(ctx, 10, 15).map(ctx, fn(e) => keyOf(e)), [10, 11, 12, 13, 14]);
    assert.eq(m.range(ctx, 10, 10).len(), 0);
    assert.eq(m.range(ctx, 11, 10).len(), 0);
}

test "ranges that share an endpoint tile without overlapping" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 50);
    let lower = m.range(ctx, 0, 20);
    let upper = m.range(ctx, 20, 50);
    assert.eq(lower.len() + upper.len(), 50);
    assert.eq(
        lower.concat(ctx, upper).map(ctx, fn(e) => keyOf(e)),
        list.range(ctx, 0, 50),
    );
}

test "range clamps to what is there" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 50);
    assert.eq(m.range(ctx, -100, 3).map(ctx, fn(e) => keyOf(e)), [0, 1, 2]);
    assert.eq(m.range(ctx, 47, 500).map(ctx, fn(e) => keyOf(e)), [47, 48, 49]);
    assert.eq(m.range(ctx, -100, 500).len(), 50);
    assert.eq(m.range(ctx, 100, 200).len(), 0);
}

test "a range over a large map answers the same as filtering it" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = scattered(ctx, 300);
    let scanned = m.range(ctx, 77, 231).map(ctx, fn(e) => keyOf(e));
    let filtered = m.keys(ctx).filterCtx(ctx, fn(_c, k) => k >= 77 && k < 231);
    assert.eq(scanned, filtered);
    assert.eq(scanned.len(), 154);
}

// --- prefix -----------------------------------------------------------------------

test "prefix answers the keys that begin with it, in order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [
        ("a", 1),
        ("ab", 2),
        ("abc", 3),
        ("ac", 4),
        ("b", 5),
        ("", 6),
    ]);
    assert.eq(m.prefix(ctx, "ab").map(ctx, fn(e) => textOf(e)), ["ab", "abc"]);
    assert.eq(m.prefix(ctx, "a").map(ctx, fn(e) => textOf(e)), [
        "a",
        "ab",
        "abc",
        "ac",
    ]);
    assert.eq(m.prefix(ctx, "abc").map(ctx, fn(e) => textOf(e)), ["abc"]);
}

test "the empty prefix is every entry and an absent one is none" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1), ("ab", 2), ("b", 3)]);
    assert.eq(m.prefix(ctx, "").len(), 3);
    assert.eq(m.prefix(ctx, "zz").len(), 0);
    assert.eq(m.prefix(ctx, "abc").len(), 0);
}

test "a prefix over a large map answers the same as filtering it" {
    let ctx = context {
        Alloc: alloc(),
    };
    let keys = list
        .range(ctx, 0, 300)
        .mapCtx(ctx, fn(c, i) => str.format(c, "key${i * 173 % 300}"));
    let insert = fn(c, acc: OrdMap<Str, Int>, k: Str) => acc.insert(c, k, k.len());
    let m = keys.foldCtx(ctx, insert, ordmap.empty<Str, Int>());
    assert.eq(m.len(), 300);
    let scanned = m.prefix(ctx, "key1").map(ctx, fn(e) => textOf(e));
    let filtered = m.keys(ctx).filterCtx(ctx, fn(_c, k) => k.startsWith("key1"));
    assert.eq(scanned, filtered);
    // key1, key10..key19, key100..key199.
    assert.eq(scanned.len(), 111);
}

// --- equals -----------------------------------------------------------------------

test "two maps with the same entries are equal whatever order they were built in" {
    let ctx = context {
        Alloc: alloc(),
    };
    let up = fn(c, acc: OrdMap<Int, Int>, k) => acc.insert(c, k, k);
    let down = fn(c, acc: OrdMap<Int, Int>, k) => acc.insert(c, 39 - k, 39 - k);
    let forwards = list.range(ctx, 0, 40).foldCtx(ctx, up, ordmap.empty<Int, Int>());
    let backwards = list.range(ctx, 0, 40).foldCtx(ctx, down, ordmap.empty<Int, Int>());
    assert.isTrue(forwards.equals(ctx, backwards));
    assert.isFalse(forwards.equals(ctx, backwards.remove(ctx, 7)));
    assert.isFalse(forwards.equals(ctx, backwards.insert(ctx, 7, 700)));
}

// --- alter / mapValues ----------------------------------------------------------------

test "alter inserts where there was nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap
        .empty<Str, Int>()
        .alter(ctx, "a", fn(v) => .Some(v.withDefault(0) + 1));
    assert.eq(assert.some(m.get("a")), 1);
    assert.eq(m.len(), 1);
}

test "alter replaces what was there" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap
        .of(ctx, [("a", 1)])
        .alter(ctx, "a", fn(v) => .Some(v.withDefault(0) + 1));
    assert.eq(assert.some(m.get("a")), 2);
    assert.eq(m.len(), 1);
}

// The branch that answers `.None` is the empty-inner pruning a nested map
// otherwise writes by hand.
test "alter removes when it answers None" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1), ("b", 2)]).alter(ctx, "a", fn(_v) => .None);
    assert.isTrue(m.get("a").isNone());
    assert.eq(m.keys(ctx), ["b"]);
    assert.eq(m.len(), 1);
}

test "alter answering None for a key that is not there changes nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let before = ordmap.of(ctx, [("a", 1)]);
    let after = before.alter(ctx, "z", fn(_v) => .None);
    assert.eq(after.len(), 1);
    assert.isTrue(after.equals(ctx, before));
}

// What `f` is handed is what is stored, so a counter needs no `get` of its own.
test "alter is handed the stored value" {
    let ctx = context {
        Alloc: alloc(),
    };
    let counts = ["a", "b", "a", "a"].foldCtx(
        ctx,
        fn(c, acc: OrdMap<Str, Int>, w) => {
            acc.alter(c, w, fn(v) => .Some(v.withDefault(0) + 1))
        },
        ordmap.empty<Str, Int>(),
    );
    assert.eq(assert.some(counts.get("a")), 3);
    assert.eq(assert.some(counts.get("b")), 1);
}

test "mapValues keeps the keys and their order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap
        .of(ctx, [("b", 2), ("a", 1), ("c", 3)])
        .mapValues(ctx, fn(v) => v * 10);
    assert.eq(m.keys(ctx), ["a", "b", "c"]);
    assert.eq(m.values(ctx), [10, 20, 30]);
    assert.eq(m.len(), 3);
}

test "mapValues may change the value type" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [("a", 1), ("b", 2)]).mapValues(ctx, fn(v) => v > 1);
    assert.eq(m.values(ctx), [false, true]);
}

test "mapValues of the empty map is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.empty<Str, Int>().mapValues(ctx, fn(v) => v + 1);
    assert.isTrue(m.isEmpty());
}

// --- groupBy / indexBy ------------------------------------------------------------

test "groupBy collects by key, in key order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let words = ["ant", "bee", "ape", "bat"];
    let m = ordmap.groupBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.eq(m.keys(ctx), ["a", "b"]);
    assert.eq(assert.some(m.get("a")), ["ant", "ape"]);
    assert.eq(assert.some(m.get("b")), ["bee", "bat"]);
}

test "groupBy of the empty list is the empty map" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(ordmap.groupBy(ctx, list.empty<Int>(), fn(n: Int) => n).isEmpty());
}

test "indexBy keeps one element per key, the last one winning" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.indexBy(ctx, ["ant", "bee", "ape"], fn(w: Str) => w.slice(0, 1));
    assert.eq(m.keys(ctx), ["a", "b"]);
    assert.eq(assert.some(m.get("a")), "ape");
}

// --- against a sorted list ----------------------------------------------------------

/// One step of the randomized comparison: a key drawn from a range small enough
/// that inserts collide and removes hit, applied to the map and to the list
/// model at once.
fn step<C: Alloc>(
    ctx: C,
    state: (OrdMap<Int, Int>, [Int], Int),
    _i: Int,
): (OrdMap<Int, Int>, [Int], Int) {
    let (m, model, seed) = state;
    let next = (seed * 1103515245 + 12345) % 2147483648;
    // The high bits, because a linear congruential generator's low ones have
    // short periods and a key drawn from them would revisit a handful of values.
    let key = next / 1024 % 400;
    if (next / 65536 % 3 == 0) {
        (m.remove(ctx, key), model.filterCtx(ctx, fn(_c, x) => x != key), next)
    } else {
        let grown = if (model.contains(key)) {
            model
        } else {
            model.push(ctx, key).sort(ctx)
        };
        (m.insert(ctx, key, key * 2), grown, next)
    }
}

test "a thousand mixed operations agree with a sorted list" {
    let ctx = context {
        Alloc: alloc(),
    };
    let start = (ordmap.empty<Int, Int>(), list.empty<Int>(), 7);
    let run = fn(c, acc: (OrdMap<Int, Int>, [Int], Int), i) => step(c, acc, i);
    let (m, model, _) = list.range(ctx, 0, 1000).foldCtx(ctx, run, start);
    // The comparison is worth making only if the run built a tree several levels
    // deep, so the size it settles at is asserted rather than assumed.
    assert.eq(model.len(), 246);
    assert.eq(m.len(), model.len());
    assert.eq(m.keys(ctx), model);
    assert.eq(m.values(ctx), model.map(ctx, fn(k) => k * 2));
    assert.eq(keyOf(assert.some(m.first())), assert.some(model.first()));
    assert.eq(keyOf(assert.some(m.last())), assert.some(model.last()));
    assert.isTrue(model.all(fn(k) => m.get(k) == .Some(k * 2)));
    let scanned = m.range(ctx, 100, 300).map(ctx, fn(e) => keyOf(e));
    assert.eq(scanned, model.filterCtx(ctx, fn(_c, k) => k >= 100 && k < 300));
}

// --- the set ------------------------------------------------------------------------

test "an empty set holds nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = ordset.empty<Int>();
    assert.eq(s.len(), 0);
    assert.isTrue(s.isEmpty());
    assert.isFalse(s.has(1));
    assert.isTrue(s.first().isNone());
    assert.isTrue(s.last().isNone());
    assert.eq(s.toList(ctx), list.empty<Int>());
}

test "a set collapses duplicates and iterates in order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = ordset.of(ctx, [5, 1, 3, 1, 5]);
    assert.eq(s.len(), 3);
    assert.eq(s.toList(ctx), [1, 3, 5]);
    assert.eq(assert.some(s.first()), 1);
    assert.eq(assert.some(s.last()), 5);
    assert.isTrue(s.has(3));
    assert.isFalse(s.has(4));
}

test "insert and remove on a set" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = ordset.of(ctx, [1, 3]).insert(ctx, 2).insert(ctx, 3);
    assert.eq(s.toList(ctx), [1, 2, 3]);
    assert.eq(s.remove(ctx, 2).toList(ctx), [1, 3]);
    assert.eq(s.remove(ctx, 99).len(), 3);
}

test "a set range is half open" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = ordset.of(ctx, list.range(ctx, 0, 60));
    assert.eq(s.range(ctx, 10, 14), [10, 11, 12, 13]);
    assert.eq(s.range(ctx, 10, 10).len(), 0);
}

test "the set operations" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a = ordset.of(ctx, [1, 3, 5]);
    let b = ordset.of(ctx, [3, 7]);
    assert.eq(a.union(ctx, b).toList(ctx), [1, 3, 5, 7]);
    assert.eq(a.intersect(ctx, b).toList(ctx), [3]);
    assert.eq(a.difference(ctx, b).toList(ctx), [1, 5]);
    assert.isTrue(ordset.of(ctx, [1, 5]).isSubsetOf(ctx, a));
    assert.isFalse(b.isSubsetOf(ctx, a));
    assert.isTrue(a.equals(ctx, ordset.of(ctx, [5, 3, 1])));
    assert.isFalse(a.equals(ctx, b));
}

test "a set of two hundred members survives insert and remove" {
    let ctx = context {
        Alloc: alloc(),
    };
    let members = list.range(ctx, 0, 200).map(ctx, fn(i) => i * 137 % 200);
    let add = fn(c, acc: OrdSet<Int>, x) => acc.insert(c, x);
    let s = members.foldCtx(ctx, add, ordset.empty<Int>());
    assert.eq(s.len(), 200);
    assert.eq(s.toList(ctx), list.range(ctx, 0, 200));
    let evens = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, k) => k % 2 == 0);
    let odds = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, k) => k % 2 == 1);
    let left = evens.foldCtx(ctx, fn(c, acc: OrdSet<Int>, x) => acc.remove(c, x), s);
    assert.eq(left.toList(ctx), odds);
    // The set it came from is untouched: the removals copied paths and shared
    // everything else.
    assert.eq(s.len(), 200);
}

test "a set of strings scans by prefix" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = ordset.of(ctx, ["ac", "ab", "abc", "b", "a"]);
    assert.eq(s.prefix(ctx, "ab"), ["ab", "abc"]);
    assert.eq(s.prefix(ctx, ""), ["a", "ab", "abc", "ac", "b"]);
    assert.eq(s.prefix(ctx, "z").len(), 0);
}

// --- pop / popFirst / popLast ---------------------------------------------------

test "pop answers the value and the map without it" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [(1, "a"), (2, "b")]);
    let (v, rest) = assert.some(m.pop(ctx, 1));
    assert.eq(v, "a");
    assert.eq(rest.keys(ctx), [2]);
    assert.eq(m.len(), 2);
    assert.isTrue(m.pop(ctx, 99).isNone());
    assert.isTrue(ordmap.empty<Int, Str>().pop(ctx, 1).isNone());
}

test "popFirst and popLast take the ends" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [(30, "c"), (10, "a"), (20, "b")]);
    let (first, withoutFirst) = assert.some(m.popFirst(ctx));
    assert.eq(first, (10, "a"));
    assert.eq(withoutFirst.keys(ctx), [20, 30]);
    let (last, withoutLast) = assert.some(m.popLast(ctx));
    assert.eq(last, (30, "c"));
    assert.eq(withoutLast.keys(ctx), [10, 20]);
    // The map they came from is untouched.
    assert.eq(m.len(), 3);
}

test "popping the ends of an empty map is nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(ordmap.empty<Int, Str>().popFirst(ctx).isNone());
    assert.isTrue(ordmap.empty<Int, Str>().popLast(ctx).isNone());
}

test "popping the last entry leaves the empty map" {
    let ctx = context {
        Alloc: alloc(),
    };
    let one = ordmap.of(ctx, [(5, "e")]);
    let (entry, rest) = assert.some(one.popFirst(ctx));
    assert.eq(entry, (5, "e"));
    assert.eq(rest.len(), 0);
    assert.isTrue(rest.isEmpty());
    assert.isTrue(rest.popFirst(ctx).isNone());
}

// The one descent has to repair the tree on the way back up, which is the half
// `first` followed by `remove` gets for free. Three hundred keys is deep enough
// that the walk borrows from a sibling and merges two short nodes on the way,
// and draining the whole map checks every step of it: the order that comes out,
// the size, and that the value still travels with its key.
test "draining with popFirst answers key order and keeps the tree honest" {
    let ctx = context {
        Alloc: alloc(),
    };
    let shuffled = list.range(ctx, 0, 300).map(ctx, fn(i) => i * 173 % 300);
    let m = ordmap.of(ctx, shuffled.map(ctx, fn(k) => (k, k * 2)));
    let drained = drainFirst(ctx, m, list.empty<Int>());
    assert.eq(drained, list.range(ctx, 0, 300));
}

test "draining with popLast answers reverse key order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let shuffled = list.range(ctx, 0, 300).map(ctx, fn(i) => i * 173 % 300);
    let m = ordmap.of(ctx, shuffled.map(ctx, fn(k) => (k, k * 2)));
    let drained = drainLast(ctx, m, list.empty<Int>());
    assert.eq(drained, list.range(ctx, 0, 300).reverse(ctx));
}

// `popFirst` is one descent and `first` then `remove` is two. Nothing in the
// language can count the comparisons — see this package's `lib.buri` — so what
// is asserted is that the two answer the same map at every one of three hundred
// steps, which is the property the descent has to preserve.
test "popFirst agrees with first and remove, all the way down" {
    let ctx = context {
        Alloc: alloc(),
    };
    let shuffled = list.range(ctx, 0, 300).map(ctx, fn(i) => i * 91 % 300);
    let m = ordmap.of(ctx, shuffled.map(ctx, fn(k) => (k, k)));
    assert.isTrue(popsAgree(ctx, m));
}

/// Every key, taken from the front one at a time.
fn drainFirst<C: Alloc>(ctx: C, m: OrdMap<Int, Int>, acc: [Int]): [Int] {
    match (m.popFirst(ctx)) {
        .None => acc,
        .Some(taken) => {
            let (entry, rest) = taken;
            let (k, v) = entry;
            // The value travels with its key, so a descent that took the entry
            // out of the wrong node shows up here rather than in the order.
            let next = if (v == k * 2) { acc.push(ctx, k) } else { acc };
            // The size drops by exactly one per step.
            if (rest.len() == m.len() - 1) { drainFirst(ctx, rest, next) } else { acc }
        },
    }
}

/// Every key, taken from the back one at a time.
fn drainLast<C: Alloc>(ctx: C, m: OrdMap<Int, Int>, acc: [Int]): [Int] {
    match (m.popLast(ctx)) {
        .None => acc,
        .Some(taken) => {
            let (entry, rest) = taken;
            let (k, v) = entry;
            let next = if (v == k * 2) { acc.push(ctx, k) } else { acc };
            if (rest.len() == m.len() - 1) { drainLast(ctx, rest, next) } else { acc }
        },
    }
}

/// Whether `popFirst` and `first` followed by `remove` answer the same map, at
/// every step down to empty.
fn popsAgree<C: Alloc>(ctx: C, m: OrdMap<Int, Int>): Bool {
    match (m.popFirst(ctx)) {
        .None => m.isEmpty(),
        .Some(taken) => {
            let (entry, rest) = taken;
            let (k, _v) = entry;
            let byHand = match (m.first()) {
                .None => m,
                .Some(head) => {
                    let (hk, _hv) = head;
                    m.remove(ctx, hk)
                },
            };
            let sameHead = m.first() == .Some(entry);
            let sameRest = rest.equals(ctx, byHand);
            let sameOrder = rest.entries(ctx) == byHand.entries(ctx);
            let gone = !rest.has(k);
            if (sameHead) {
                if (sameRest) {
                    if (sameOrder) {
                        if (gone) { popsAgree(ctx, rest) } else { false }
                    } else {
                        false
                    }
                } else {
                    false
                }
            } else {
                false
            }
        },
    }
}

// --- floor / ceiling -------------------------------------------------------------

test "floor and ceiling answer the nearest entry on each side" {
    let ctx = context {
        Alloc: alloc(),
    };
    let bands = ordmap.of(ctx, [(0, "cold"), (10, "mild"), (25, "hot")]);
    assert.eq(assert.some(bands.floor(17)), (10, "mild"));
    assert.eq(assert.some(bands.ceiling(17)), (25, "hot"));
    // An exact key is its own floor and its own ceiling.
    assert.eq(assert.some(bands.floor(10)), (10, "mild"));
    assert.eq(assert.some(bands.ceiling(10)), (10, "mild"));
}

test "floor below everything and ceiling above everything are nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [(10, "a"), (20, "b")]);
    assert.isTrue(m.floor(9).isNone());
    assert.isTrue(m.ceiling(21).isNone());
    assert.eq(assert.some(m.floor(10)), (10, "a"));
    assert.eq(assert.some(m.ceiling(20)), (20, "b"));
    assert.isTrue(ordmap.empty<Int, Str>().floor(0).isNone());
    assert.isTrue(ordmap.empty<Int, Str>().ceiling(0).isNone());
}

// A tree of three hundred keys is several nodes deep, so the answer for a key
// in a leaf comes from a candidate picked up on the way down — which is the
// part a one-node implementation gets wrong.
test "floor and ceiling agree with a scan over every key" {
    let ctx = context {
        Alloc: alloc(),
    };
    let evens = list.range(ctx, 0, 300).map(ctx, fn(i) => i * 2);
    let m = ordmap.of(ctx, evens.map(ctx, fn(k) => (k, k)));
    // Every odd key falls between two even ones, and every even key is its own
    // answer on both sides.
    let probes = list.range(ctx, 0, 598);
    assert.isTrue(probes.all(fn(p) => floorIsRight(m, p)));
    assert.isTrue(probes.all(fn(p) => ceilingIsRight(m, p)));
    assert.isTrue(m.floor(-1).isNone());
    assert.isTrue(m.ceiling(599).isNone());
}

/// The floor of `p` in a map of the even numbers: `p` rounded down.
fn floorIsRight(m: OrdMap<Int, Int>, p: Int): Bool {
    let wanted = p - p % 2;
    m.floor(p) == .Some((wanted, wanted))
}

/// The ceiling of `p` in a map of the even numbers: `p` rounded up.
fn ceilingIsRight(m: OrdMap<Int, Int>, p: Int): Bool {
    let wanted = p + p % 2;
    m.ceiling(p) == .Some((wanted, wanted))
}

// --- merge / mergeWith / filter / countBy -------------------------------------------

test "merge is right-biased and keeps key order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a = ordmap.of(ctx, [(1, "a"), (3, "c")]);
    let b = ordmap.of(ctx, [(2, "B"), (3, "C")]);
    let both = a.merge(ctx, b);
    assert.eq(both.keys(ctx), [1, 2, 3]);
    assert.eq(assert.some(both.get(3)), "C");
    assert.isTrue(a.merge(ctx, ordmap.empty<Int, Str>()).equals(ctx, a));
    assert.isTrue(ordmap.empty<Int, Str>().merge(ctx, a).equals(ctx, a));
}

test "mergeWith combines only the keys in both" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a = ordmap.of(ctx, [(1, 2), (3, 1)]);
    let b = ordmap.of(ctx, [(1, 3), (5, 5)]);
    let total = a.mergeWith(ctx, b, fn(x, y) => x * 100 + y);
    assert.eq(total.keys(ctx), [1, 3, 5]);
    assert.eq(assert.some(total.get(1)), 203);
    assert.eq(assert.some(total.get(3)), 1);
    assert.eq(assert.some(total.get(5)), 5);
}

test "merging two hundred keys either way keeps them all" {
    let ctx = context {
        Alloc: alloc(),
    };
    let evens = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, i) => i % 2 == 0);
    let odds = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, i) => i % 2 == 1);
    let a = ordmap.of(ctx, evens.map(ctx, fn(i) => (i, i)));
    let b = ordmap.of(ctx, odds.map(ctx, fn(i) => (i, i)));
    assert.eq(a.merge(ctx, b).keys(ctx), list.range(ctx, 0, 200));
    assert.eq(a.mergeWith(ctx, b, fn(x, _y) => x).len(), 200);
}

test "filter keeps what the predicate keeps, in order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = ordmap.of(ctx, [(1, "a"), (2, "bb"), (3, "c")]);
    assert.eq(m.filter(ctx, fn(_k, v) => v.len() == 1).keys(ctx), [1, 3]);
    assert.eq(m.filter(ctx, fn(k, _v) => k > 1).keys(ctx), [2, 3]);
    assert.isTrue(m.filter(ctx, fn(_k, _v) => false).isEmpty());
    assert.isTrue(m.filter(ctx, fn(_k, _v) => true).equals(ctx, m));
    assert.isTrue(ordmap.empty<Int, Str>().filter(ctx, fn(_k, _v) => true).isEmpty());
}

test "countBy counts the elements under each key, in key order" {
    let ctx = context {
        Alloc: alloc(),
    };
    let counts = ordmap.countBy(ctx, list.range(ctx, 0, 10), fn(n: Int) => n % 3);
    assert.eq(counts.keys(ctx), [0, 1, 2]);
    assert.eq(assert.some(counts.get(0)), 4);
    assert.eq(assert.some(counts.get(1)), 3);
    assert.eq(assert.some(counts.get(2)), 3);
    assert.isTrue(ordmap.countBy(ctx, list.empty<Int>(), fn(n: Int) => n).isEmpty());
}

// --- a list built inside the call that folds it -------------------------------
//
// The `map.of` rule, one module over: `ordmap.of(ctx, xs.map(ctx, f))` gives
// `list.map`'s result element the type `(K, V)` out of `ordmap.of`'s signature
// before the lambda is looked at, so the lambda's body is the only thing that
// says what `K` and `V` are. Sizes only, for the reason
// `collections/map.buri` gives at the same case.

test "ordmap.of over a list mapped inside the call keeps every entry" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(
        ordmap.of(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i))).len(),
        40,
    );
    assert.eq(
        ordmap.of(ctx, list.range(ctx, 0, 40).mapCtx(ctx, fn(_c, i) => (i, i))).len(),
        40,
    );
    let named = list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i));
    assert.eq(ordmap.of(ctx, named).len(), 40);
}

test "ordset.of over a list mapped inside the call keeps every item" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(
        ordset.of(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i))).len(),
        40,
    );
}
