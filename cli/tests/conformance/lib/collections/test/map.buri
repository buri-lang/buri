// core/map and core/set — hash maps and hash sets.
//
// The cases worth writing are the ones that make the structure work rather
// than the interface: growth (which rehashes every entry into twice as many
// buckets), collisions (two keys in one bucket), and replacement (which must
// not change the size).

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/map" import * as map;
from "core/map" import { Map };
from "core/set" import * as set;
from "core/testing/assert" import * as assert;

// --- empty --------------------------------------------------------------------

test "an empty map holds nothing" {
    let ctx = context {
    };
    let m = map.empty<Str, Int>();
    assert.eq(m.len(), 0);
    assert.isTrue(m.isEmpty());
    assert.isTrue(m.get("nothing").isNone());
    assert.isFalse(m.has("nothing"));
}

// --- insert / get ---------------------------------------------------------------

test "insert then get" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "b", 2);
    assert.eq(assert.some(m.get("a")), 1);
    assert.eq(assert.some(m.get("b")), 2);
    assert.eq(m.len(), 2);
    assert.isTrue(m.get("c").isNone());
}

test "inserting the same key replaces the value and does not change the size" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "a", 99);
    assert.eq(assert.some(m.get("a")), 99);
    assert.eq(m.len(), 1);
}

test "a map is a value: inserting produces a new one" {
    let ctx = context {
        Alloc: alloc(),
    };
    let before = map.empty<Str, Int>().insert(ctx, "a", 1);
    let after = before.insert(ctx, "b", 2);
    assert.eq(before.len(), 1);
    assert.eq(after.len(), 2);
    assert.isTrue(before.get("b").isNone());
}

// --- remove ---------------------------------------------------------------------

test "remove takes a key out" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]).remove(ctx, "a");
    assert.isTrue(m.get("a").isNone());
    assert.eq(assert.some(m.get("b")), 2);
    assert.eq(m.len(), 1);
}

test "removing a key that is not there changes nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]);
    assert.eq(m.remove(ctx, "zzz").len(), 1);
}

// --- of / entries / keys / values -------------------------------------------------

test "of holds every entry, later ones winning" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("a", 3)]);
    assert.eq(m.len(), 2);
    assert.eq(assert.some(m.get("a")), 3);
}

test "keys and values are as many as there are entries" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    assert.eq(m.entries(ctx).len(), 3);
    assert.eq(m.keys(ctx).sort(ctx), ["a", "b", "c"]);
    assert.eq(m.values(ctx).sort(ctx), [1, 2, 3]);
}

// The structure's own behaviour: past the load factor the map doubles its
// buckets and rehashes. Everything must still be findable afterwards, which is
// the one way a rehash can go wrong.
test "a map that outgrows its buckets keeps every entry" {
    let ctx = context {
        Alloc: alloc(),
    };
    let n = 200;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i, i * 10),
            map.empty<Int, Int>(),
        );
    // The accumulator is annotated because inference runs left to right: the
    // lambda is checked before the seed that would otherwise pin its type.
    assert.eq(m.len(), n);
    assert.isTrue(list.range(ctx, 0, n).all(fn(i) => m.get(i) == .Some(i * 10)));
    assert.isTrue(m.get(n).isNone());
}

test "growth does not duplicate entries" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = list
        .range(ctx, 0, 100)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i, i),
            map.empty<Int, Int>(),
        );
    assert.eq(m.entries(ctx).len(), 100);
}

test "equals compares entries rather than layout" {
    let ctx = context {
        Alloc: alloc(),
    };
    // Built in opposite orders, so the buckets were filled differently.
    let a = map.of(ctx, [("x", 1), ("y", 2), ("z", 3)]);
    let b = map.of(ctx, [("z", 3), ("y", 2), ("x", 1)]);
    assert.isTrue(a.equals(ctx, b));
    assert.isFalse(a.equals(ctx, map.of(ctx, [("x", 1)])));
    assert.isFalse(a.equals(ctx, map.of(ctx, [("x", 9), ("y", 2), ("z", 3)])));
}

test "NaN is an ordinary key" {
    // SPEC 7.2 makes `==` an equivalence relation, which is what a hash map
    // needs of its keys: a key that is not equal to itself can be inserted and
    // never found again. `Hash` agrees by construction — every NaN mixes as
    // zero — so lookup finds the bucket and `==` finds the entry in it.
    let ctx = context {
        Alloc: alloc(),
    };
    let nan = 0.0 / 0.0;
    let m = map.empty<F64, Str>().insert(ctx, nan, "n").insert(ctx, 1.5, "a");
    assert.eq(assert.some(m.get(nan)), "n");
    assert.eq(m.len(), 2);
    // Inserting it again replaces rather than duplicating, which only holds
    // because the two NaNs compare equal.
    let again = m.insert(ctx, 0.0 / 0.0, "m");
    assert.eq(assert.some(again.get(0.0 / 0.0)), "m");
    assert.eq(again.len(), 2);
}

// --- groupBy / indexBy ---------------------------------------------------------------

test "groupBy collects the elements that answer the same key" {
    let ctx = context {
        Alloc: alloc(),
    };
    let words = ["ant", "bee", "ape", "bat"];
    let m = map.groupBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.eq(m.len(), 2);
    assert.eq(assert.some(m.get("a")), ["ant", "ape"]);
    assert.eq(assert.some(m.get("b")), ["bee", "bat"]);
    assert.isTrue(m.get("c").isNone());
}

// Each group is in the order the elements arrived in, which is the property a
// grouped report depends on.
test "a group keeps the order of the list" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.groupBy(ctx, [3, 1, 4, 1, 5], fn(n: Int) => n % 2);
    assert.eq(assert.some(m.get(1)), [3, 1, 1, 5]);
    assert.eq(assert.some(m.get(0)), [4]);
}

test "groupBy of the empty list is the empty map" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.groupBy(ctx, list.empty<Int>(), fn(n: Int) => n);
    assert.isTrue(m.isEmpty());
}

test "indexBy keeps one element per key, the last one winning" {
    let ctx = context {
        Alloc: alloc(),
    };
    let words = ["ant", "bee", "ape"];
    let m = map.indexBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.eq(m.len(), 2);
    assert.eq(assert.some(m.get("a")), "ape");
    assert.eq(assert.some(m.get("b")), "bee");
}

test "indexBy of the empty list is the empty map" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.indexBy(ctx, list.empty<Int>(), fn(n: Int) => n);
    assert.isTrue(m.isEmpty());
}

// --- sets -------------------------------------------------------------------------

test "a set collapses duplicates" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = set.of(ctx, [1, 2, 2, 3, 1]);
    assert.eq(s.len(), 3);
    assert.eq(s.toList(ctx).sort(ctx), [1, 2, 3]);
}

test "insert, has, and remove" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = set.empty<Str>().insert(ctx, "a");
    assert.isTrue(s.has("a"));
    assert.isFalse(s.has("b"));
    assert.isFalse(s.remove(ctx, "a").has("a"));
    assert.isTrue(set.empty<Str>().isEmpty());
}

test "union, intersect and difference" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a = set.of(ctx, [1, 2, 3]);
    let b = set.of(ctx, [3, 4]);
    assert.eq(a.union(ctx, b).toList(ctx).sort(ctx), [1, 2, 3, 4]);
    assert.eq(a.intersect(ctx, b).toList(ctx).sort(ctx), [3]);
    assert.eq(a.difference(ctx, b).toList(ctx).sort(ctx), [1, 2]);
    assert.eq(b.difference(ctx, a).toList(ctx).sort(ctx), [4]);
}

test "isSubsetOf and equals" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a = set.of(ctx, [1, 2]);
    let b = set.of(ctx, [1, 2, 3]);
    assert.isTrue(a.isSubsetOf(ctx, b));
    assert.isFalse(b.isSubsetOf(ctx, a));
    assert.isTrue(set.empty<Int>().isSubsetOf(ctx, a));
    assert.isTrue(a.equals(ctx, set.of(ctx, [2, 1])));
    assert.isFalse(a.equals(ctx, b));
}

test "a set of many members survives growth too" {
    let ctx = context {
        Alloc: alloc(),
    };
    let s = set.of(ctx, list.range(ctx, 0, 150));
    assert.eq(s.len(), 150);
    assert.isTrue(list.range(ctx, 0, 150).all(fn(i) => s.has(i)));
    assert.isFalse(s.has(150));
}

// --- alter ------------------------------------------------------------------------

test "alter inserts, replaces and removes" {
    let ctx = context {
        Alloc: alloc(),
    };
    let counts = map.of(ctx, [("a", 1)]);
    let bump = fn(n: Option<Int>): Option<Int> => .Some(n.withDefault(0) + 1);
    let bumped = counts.alter(ctx, "a", bump).alter(ctx, "b", bump);
    assert.eq(assert.some(bumped.get("a")), 2);
    assert.eq(assert.some(bumped.get("b")), 1);
    // `.None` prunes, which is what keeps a map of maps from filling with
    // empty ones.
    let pruned = bumped.alter(ctx, "a", fn(_n) => .None);
    assert.isTrue(pruned.get("a").isNone());
    assert.eq(pruned.len(), 1);
}

test "altering a missing key to nothing changes nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]).alter(ctx, "zzz", fn(_n) => .None);
    assert.eq(m.len(), 1);
}

test "alter sees exactly what is stored" {
    let ctx = context {
        Alloc: alloc(),
    };
    // The update runs on the stored value, so what it answers proves what it
    // was handed.
    let m = map.of(ctx, [("a", 7)]);
    let seen = m.alter(ctx, "a", fn(n) => .Some(n.withDefault(-1)));
    assert.eq(assert.some(seen.get("a")), 7);
    let absent = m.alter(ctx, "b", fn(n) => .Some(n.withDefault(-1)));
    assert.eq(assert.some(absent.get("b")), -1);
}

// --- mapValues / filterMapValues ---------------------------------------------------

test "mapValues keeps every key" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]).mapValues(ctx, fn(v) => v * 10);
    assert.eq(m.len(), 2);
    assert.eq(assert.some(m.get("a")), 10);
    assert.eq(assert.some(m.get("b")), 20);
}

test "mapValues may change the value type" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]).mapValues(ctx, fn(v) => [v, v]);
    assert.eq(assert.some(m.get("a")), [1, 1]);
}

test "mapValues of the empty map is the empty map" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(map.empty<Str, Int>().mapValues(ctx, fn(v) => v).isEmpty());
}

test "filterMapValues drops what it answers nothing for" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map
        .of(ctx, [("a", 1), ("b", 2), ("c", 3)])
        .filterMapValues(ctx, fn(v) => if (v % 2 == 1) { .Some(v * 2) } else { .None });
    assert.eq(m.len(), 2);
    assert.eq(assert.some(m.get("a")), 2);
    assert.eq(assert.some(m.get("c")), 6);
    assert.isTrue(m.get("b").isNone());
}

test "filterMapValues that keeps nothing is empty" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]).filterMapValues(ctx, fn(_v) => .None);
    assert.isTrue(m.isEmpty());
    assert.eq(m.len(), 0);
}

// --- merge / mergeWith --------------------------------------------------------------

test "merge is right-biased" {
    let ctx = context {
        Alloc: alloc(),
    };
    let defaults = map.of(ctx, [("host", "localhost"), ("port", "80")]);
    let overrides = map.of(ctx, [("port", "8080")]);
    let both = defaults.merge(ctx, overrides);
    assert.eq(both.len(), 2);
    assert.eq(assert.some(both.get("host")), "localhost");
    assert.eq(assert.some(both.get("port")), "8080");
    // Neither side moved.
    assert.eq(assert.some(defaults.get("port")), "80");
    assert.eq(overrides.len(), 1);
}

test "merging with the empty map answers the same entries" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]);
    assert.isTrue(m.merge(ctx, map.empty<Str, Int>()).equals(ctx, m));
    assert.isTrue(map.empty<Str, Int>().merge(ctx, m).equals(ctx, m));
}

test "mergeWith combines only the keys in both" {
    let ctx = context {
        Alloc: alloc(),
    };
    let monday = map.of(ctx, [("ana", 2), ("bo", 1)]);
    let tuesday = map.of(ctx, [("ana", 3), ("cy", 5)]);
    // The combiner is `mine * 100 + theirs`, so a value it never touched is
    // visibly untouched and the argument order is visible too.
    let total = monday.mergeWith(ctx, tuesday, fn(a, b) => a * 100 + b);
    assert.eq(total.len(), 3);
    assert.eq(assert.some(total.get("ana")), 203);
    assert.eq(assert.some(total.get("bo")), 1);
    assert.eq(assert.some(total.get("cy")), 5);
}

test "mergeWith over two hundred keys keeps every one" {
    let ctx = context {
        Alloc: alloc(),
    };
    let evens = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, i) => i % 2 == 0);
    let odds = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, i) => i % 2 == 1);
    let a = map.of(ctx, evens.map(ctx, fn(i) => (i, i)));
    let b = map.of(ctx, odds.map(ctx, fn(i) => (i, i)));
    let both = a.mergeWith(ctx, b, fn(x, y) => x + y);
    assert.eq(both.len(), 200);
    assert.isTrue(list.range(ctx, 0, 200).all(fn(i) => both.get(i) == .Some(i)));
}

// --- filter -------------------------------------------------------------------------

test "filter keeps what the predicate keeps" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("bb", 2), ("c", 3)]);
    let short = m.filter(ctx, fn(k, _v) => k.len() == 1);
    assert.eq(short.len(), 2);
    assert.isTrue(short.get("bb").isNone());
    let odd = m.filter(ctx, fn(_k, v) => v % 2 == 1);
    assert.eq(odd.keys(ctx).sort(ctx), ["a", "c"]);
}

test "filter that keeps nothing, and filter that keeps everything" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    assert.isTrue(m.filter(ctx, fn(_k, _v) => false).isEmpty());
    assert.isTrue(m.filter(ctx, fn(_k, _v) => true).equals(ctx, m));
    assert.isTrue(map.empty<Str, Int>().filter(ctx, fn(_k, _v) => true).isEmpty());
}

// --- pop ----------------------------------------------------------------------------

test "pop answers the value and the map without it" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    let (v, rest) = assert.some(m.pop(ctx, "a"));
    assert.eq(v, 1);
    assert.eq(rest.len(), 1);
    assert.isTrue(rest.get("a").isNone());
    // The map it came from is untouched.
    assert.eq(m.len(), 2);
}

test "popping what is not there is nothing" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(map.of(ctx, [("a", 1)]).pop(ctx, "zzz").isNone());
    assert.isTrue(map.empty<Str, Int>().pop(ctx, "a").isNone());
}

// --- takeKeys / dropKeys -------------------------------------------------------------

test "takeKeys keeps the keys it names and skips the ones it does not have" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    let kept = m.takeKeys(ctx, ["a", "c", "zzz"]);
    assert.eq(kept.len(), 2);
    assert.eq(kept.keys(ctx).sort(ctx), ["a", "c"]);
    assert.eq(assert.some(kept.get("c")), 3);
}

test "dropKeys is takeKeys' complement" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    let left = m.dropKeys(ctx, ["a", "c", "zzz"]);
    assert.eq(left.keys(ctx), ["b"]);
    assert.eq(m.takeKeys(ctx, []).len(), 0);
    assert.isTrue(m.dropKeys(ctx, []).equals(ctx, m));
}

test "a repeated key is not counted twice" {
    let ctx = context {
        Alloc: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    assert.eq(m.takeKeys(ctx, ["a", "a", "a"]).len(), 1);
    assert.eq(m.dropKeys(ctx, ["a", "a"]).len(), 1);
}

// --- countBy / frequencies -----------------------------------------------------------

test "countBy counts the elements under each key" {
    let ctx = context {
        Alloc: alloc(),
    };
    let words = ["ant", "bee", "ape", "bat", "cow"];
    let counts = map.countBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.eq(counts.len(), 3);
    assert.eq(assert.some(counts.get("a")), 2);
    assert.eq(assert.some(counts.get("b")), 2);
    assert.eq(assert.some(counts.get("c")), 1);
    assert.isTrue(counts.get("z").isNone());
}

test "countBy of the empty list is the empty map" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.isTrue(map.countBy(ctx, list.empty<Int>(), fn(n: Int) => n).isEmpty());
}

test "countBy agrees with groupBy's sizes" {
    let ctx = context {
        Alloc: alloc(),
    };
    let ns = list.range(ctx, 0, 200);
    let key = fn(n: Int) => n % 7;
    let counts = map.countBy(ctx, ns, key);
    let groups = map.groupBy(ctx, ns, key);
    assert.eq(counts.len(), 7);
    assert.isTrue(
        list
            .range(ctx, 0, 7)
            .all(fn(k) => counts.get(k) == .Some(groups.get(k).withDefault([]).len())),
    );
}

test "frequencies is a histogram of the list" {
    let ctx = context {
        Alloc: alloc(),
    };
    let f = map.frequencies(ctx, [1, 2, 2, 3, 3, 3]);
    assert.eq(assert.some(f.get(1)), 1);
    assert.eq(assert.some(f.get(2)), 2);
    assert.eq(assert.some(f.get(3)), 3);
    assert.eq(f.len(), 3);
    assert.isTrue(map.frequencies(ctx, list.empty<Str>()).isEmpty());
}
