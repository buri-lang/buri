// core/map and core/set — hash maps and hash sets.
//
// The cases worth writing are the ones that make the structure work rather
// than the interface: growth (which rehashes every entry into twice as many
// buckets), collisions (two keys in one bucket), and replacement (which must
// not change the size).

from "core/list" import * as list;
from "core/map" import * as map;
from "core/map" import { Map };
from "core/math" import * as math;
from "core/order" import { Equal, Hash };
from "core/set" import * as set;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

// --- empty --------------------------------------------------------------------

test "an empty map holds nothing" {
    let ctx = context {
    };
    let m = map.empty<Str, Int>();
    assert.equal(m.length(), 0);
    assert.isTrue(m.isEmpty());
    assert.isTrue(m.get("nothing").isNone());
    assert.isFalse(m.has("nothing"));
}

// --- insert / get ---------------------------------------------------------------

test "insert then get" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "b", 2);
    assert.equal(assert.some(m.get("a")), 1);
    assert.equal(assert.some(m.get("b")), 2);
    assert.equal(m.length(), 2);
    assert.isTrue(m.get("c").isNone());
}

test "inserting the same key replaces the value and does not change the size" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "a", 99);
    assert.equal(assert.some(m.get("a")), 99);
    assert.equal(m.length(), 1);
}

test "a map is a value: inserting produces a new one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let before = map.empty<Str, Int>().insert(ctx, "a", 1);
    let after = before.insert(ctx, "b", 2);
    assert.equal(before.length(), 1);
    assert.equal(after.length(), 2);
    assert.isTrue(before.get("b").isNone());
}

// --- remove ---------------------------------------------------------------------

test "remove takes a key out" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]).remove(ctx, "a");
    assert.isTrue(m.get("a").isNone());
    assert.equal(assert.some(m.get("b")), 2);
    assert.equal(m.length(), 1);
}

test "removing a key that is not there changes nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]);
    assert.equal(m.remove(ctx, "zzz").length(), 1);
}

// --- of / entries / keys / values -------------------------------------------------

test "of holds every entry, later ones winning" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("a", 3)]);
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get("a")), 3);
}

test "keys and values are as many as there are entries" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    assert.equal(m.entries(ctx).length(), 3);
    assert.equal(m.keys(ctx).sort(ctx), ["a", "b", "c"]);
    assert.equal(m.values(ctx).sort(ctx), [1, 2, 3]);
}

// The structure's own behaviour: past the load factor the map doubles its
// buckets and rehashes. Everything must still be findable afterwards, which is
// the one way a rehash can go wrong.
test "a map that outgrows its buckets keeps every entry" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 200;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i, i * 10),
            map.empty<Int, Int>(),
        );
    // The accumulator is annotated because inference runs left to right: the
    // lambda is checked before the seed that would otherwise pin its type.
    assert.equal(m.length(), n);
    assert.isTrue(list.range(ctx, 0, n).all(fn(i) => m.get(i) == .Some(i * 10)));
    assert.isTrue(m.get(n).isNone());
}

test "growth does not duplicate entries" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = list
        .range(ctx, 0, 100)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i, i),
            map.empty<Int, Int>(),
        );
    assert.equal(m.entries(ctx).length(), 100);
}

test "equals compares entries rather than layout" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Built in opposite orders, so the buckets were filled differently.
    let a = map.of(ctx, [("x", 1), ("y", 2), ("z", 3)]);
    let b = map.of(ctx, [("z", 3), ("y", 2), ("x", 1)]);
    assert.isTrue(a.equals(ctx, b));
    assert.isFalse(a.equals(ctx, map.of(ctx, [("x", 1)])));
    assert.isFalse(a.equals(ctx, map.of(ctx, [("x", 9), ("y", 2), ("z", 3)])));
}

test "NaN is an ordinary key" {
    // SPEC 7.2 makes `==` an equivalence relation, which is what a hash map
    // needs of its keys: a key that is not equal to itself can be inserted and
    // never found again. `Hash` agrees by construction — every NaN mixes as
    // zero — so lookup finds the bucket and `==` finds the entry in it.
    let ctx = context {
        Allocator: alloc(),
    };
    let nan = 0.0 / 0.0;
    let m = map.empty<F64, Str>().insert(ctx, nan, "n").insert(ctx, 1.5, "a");
    assert.equal(assert.some(m.get(nan)), "n");
    assert.equal(m.length(), 2);
    // Inserting it again replaces rather than duplicating, which only holds
    // because the two NaNs compare equal.
    let again = m.insert(ctx, 0.0 / 0.0, "m");
    assert.equal(assert.some(again.get(0.0 / 0.0)), "m");
    assert.equal(again.length(), 2);
}

// --- keys that differ only in their high bits ------------------------------------
//
// An integer's hash mixed only its low 32 bits, so `i * 2^32` all hashed alike
// and a map of them was one long collision list (buri-lang/buri#273).

fn hashOf<K: Hash>(key: K): U64 {
    key.hash()
}

/// Whether no two of these hashes are the same.
fn distinct<C: Allocator>(ctx: C, hashes: [U64]): Bool {
    let sorted = hashes.sort(ctx);
    list.range(ctx, 1, sorted.length()).all(fn(i) => sorted.get(i) != sorted.get(i - 1))
}

test "Int keys that differ only above bit 32 hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = list.range(ctx, 0 - 32, 32);
    // 2^32, 2^40 and 2^48: the low half is zero, and so are some of the high.
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(i) => (i * 4_294_967_296).hash())));
    assert.isTrue(
        distinct(ctx, keys.map(ctx, fn(i) => (i * 1_099_511_627_776).hash())),
    );
    assert.isTrue(
        distinct(ctx, keys.map(ctx, fn(i) => (i * 281_474_976_710_656).hash())),
    );
}

test "U64 keys that differ only above bit 32 hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let step: U64 = 4_294_967_296;
    let keys = list.range(ctx, 0, 64).map(ctx, fn(i) => i.wrapToU64() * step);
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => k.hash())));
}

test "tuple keys that differ only above bit 32 hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = list.range(ctx, 0, 64);
    assert.isTrue(
        distinct(ctx, keys.map(ctx, fn(i) => hashOf((i * 4_294_967_296, "k")))),
    );
}

test "a map of keys that differ only above bit 32 keeps every entry" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 2000;
    let step = 4_294_967_296;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i * step, i),
            map.empty<Int, Int>(),
        );
    assert.equal(m.length(), n);
    assert.isTrue(list.range(ctx, 0, n).all(fn(i) => m.get(i * step) == .Some(i)));
    assert.isTrue(m.get(0 - step).isNone());
    assert.equal(m.remove(ctx, step).length(), n - 1);
}

// --- float keys ---------------------------------------------------------------------
//
// A float's hash mixed `ToUint32(Math.trunc(x))`, so every fraction in (0, 1)
// hashed as 0, and so did floats that agree mod 2^32 (follows #273).

test "F64 keys with fractions hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = list.range(ctx, 0 - 500, 500).map(ctx, fn(i) => i.toF64() / 1000.0);
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => k.hash())));
}

test "F64 keys that agree mod 2^32 hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = list.range(ctx, 1, 64).map(ctx, fn(i) => i.toF64() * 4_294_967_296.0);
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => k.hash())));
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => (k + 0.5).hash())));
}

test "F32 keys with fractions hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = list
        .range(ctx, 0 - 64, 64)
        .map(ctx, fn(i) => assert.ok((i.toF64() / 64.0).toF32()));
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => k.hash())));
}

test "tuple and Option keys with fractions hash apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = list.range(ctx, 0, 64).map(ctx, fn(i) => i.toF64() / 64.0);
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => hashOf((k, "k")))));
    assert.isTrue(distinct(ctx, keys.map(ctx, fn(k) => hashOf(Option.Some(k)))));
}

test "0.0 and -0.0 hash alike, as == says they are equal" {
    let zero: F32 = 0.0;
    assert.equal((-0.0).hash(), 0.0.hash());
    assert.equal((-zero).hash(), zero.hash());
    assert.equal(hashOf((-0.0, 1)), hashOf((0.0, 1)));
    assert.equal(hashOf(Option.Some(-0.0)), hashOf(Option.Some(0.0)));
}

/// A NaN made at run time rather than by `math.NAN`'s division.
fn madeNan(): F64 {
    math.INFINITY - math.INFINITY
}

test "every NaN hashes alike, as == says they are equal" {
    let zero: F32 = 0.0;
    let h = math.NAN.hash();
    assert.equal((-math.NAN).hash(), h);
    assert.equal(madeNan().hash(), h);
    assert.equal((-madeNan()).hash(), h);
    assert.equal((zero / zero).hash(), h);
    assert.equal((-(zero / zero)).hash(), h);
    assert.equal(hashOf((-madeNan(), 1)), hashOf((math.NAN, 1)));
}

test "a map of fractional keys keeps every entry, and -0.0 finds 0.0" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 2000;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<F64, Int>, i) => acc.insert(c, i.toF64() / 2000.0, i),
            map.empty<F64, Int>(),
        );
    assert.equal(m.length(), n);
    assert.isTrue(
        list.range(ctx, 0, n).all(fn(i) => m.get(i.toF64() / 2000.0) == .Some(i)),
    );
    assert.equal(m.get(-0.0), .Some(0));
    assert.isTrue(m.get(1.0).isNone());
    let s = set.of(ctx, [0.0, -0.0, math.NAN, -madeNan(), 0.5]);
    assert.equal(s.length(), 3);
}

// --- groupBy / indexBy ---------------------------------------------------------------

test "groupBy collects the elements that answer the same key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let words = ["ant", "bee", "ape", "bat"];
    let m = map.groupBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get("a")), ["ant", "ape"]);
    assert.equal(assert.some(m.get("b")), ["bee", "bat"]);
    assert.isTrue(m.get("c").isNone());
}

// Each group is in the order the elements arrived in, which is the property a
// grouped report depends on.
test "a group keeps the order of the list" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.groupBy(ctx, [3, 1, 4, 1, 5], fn(n: Int) => n % 2);
    assert.equal(assert.some(m.get(1)), [3, 1, 1, 5]);
    assert.equal(assert.some(m.get(0)), [4]);
}

test "groupBy files numbers under the names it gives them" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.groupBy(ctx, [3, 8, 5, 2, 7], fn(n: Int) => {
        if (n % 2 == 0) { "even" } else { "odd" }
    });
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get("odd")), [3, 5, 7]);
    assert.equal(assert.some(m.get("even")), [8, 2]);
    assert.isTrue(m.get("zero").isNone());
    assert.isFalse(m.has("prime"));
}

test "groupBy of the empty list is the empty map" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.groupBy(ctx, list.empty<Int>(), fn(n: Int) => n);
    assert.isTrue(m.isEmpty());
}

test "indexBy keeps one element per key, the last one winning" {
    let ctx = context {
        Allocator: alloc(),
    };
    let words = ["ant", "bee", "ape"];
    let m = map.indexBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get("a")), "ape");
    assert.equal(assert.some(m.get("b")), "bee");
}

test "indexBy of the empty list is the empty map" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.indexBy(ctx, list.empty<Int>(), fn(n: Int) => n);
    assert.isTrue(m.isEmpty());
}

// --- sets -------------------------------------------------------------------------

test "a set collapses duplicates" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = set.of(ctx, [1, 2, 2, 3, 1]);
    assert.equal(s.length(), 3);
    assert.equal(s.toList(ctx).sort(ctx), [1, 2, 3]);
}

test "insert, has, and remove" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = set.empty<Str>().insert(ctx, "a");
    assert.isTrue(s.has("a"));
    assert.isFalse(s.has("b"));
    assert.isFalse(s.remove(ctx, "a").has("a"));
    assert.isTrue(set.empty<Str>().isEmpty());
}

test "union, intersect and difference" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2, 3]);
    let b = set.of(ctx, [3, 4]);
    assert.equal(a.union(ctx, b).toList(ctx).sort(ctx), [1, 2, 3, 4]);
    assert.equal(a.intersect(ctx, b).toList(ctx).sort(ctx), [3]);
    assert.equal(a.difference(ctx, b).toList(ctx).sort(ctx), [1, 2]);
    assert.equal(b.difference(ctx, a).toList(ctx).sort(ctx), [4]);
}

test "isSubsetOf and equals" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2]);
    let b = set.of(ctx, [1, 2, 3]);
    assert.isTrue(a.isSubsetOf(ctx, b));
    assert.isFalse(b.isSubsetOf(ctx, a));
    assert.isTrue(set.empty<Int>().isSubsetOf(ctx, a));
    assert.isTrue(a.equals(ctx, set.of(ctx, [2, 1])));
    assert.isFalse(a.equals(ctx, b));
}

test "a set of many members survives growth too" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = set.of(ctx, list.range(ctx, 0, 150));
    assert.equal(s.length(), 150);
    assert.isTrue(list.range(ctx, 0, 150).all(fn(i) => s.has(i)));
    assert.isFalse(s.has(150));
}

// --- alter ------------------------------------------------------------------------

test "alter inserts, replaces and removes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let counts = map.of(ctx, [("a", 1)]);
    let bump = fn(n: Option<Int>): Option<Int> => .Some(n.withDefault(0) + 1);
    let bumped = counts.alter(ctx, "a", bump).alter(ctx, "b", bump);
    assert.equal(assert.some(bumped.get("a")), 2);
    assert.equal(assert.some(bumped.get("b")), 1);
    // `.None` prunes, which is what keeps a map of maps from filling with
    // empty ones.
    let pruned = bumped.alter(ctx, "a", fn(_n) => .None);
    assert.isTrue(pruned.get("a").isNone());
    assert.equal(pruned.length(), 1);
}

test "altering a missing key to nothing changes nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]).alter(ctx, "zzz", fn(_n) => .None);
    assert.equal(m.length(), 1);
}

test "alter sees exactly what is stored" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The update runs on the stored value, so what it answers proves what it
    // was handed.
    let m = map.of(ctx, [("a", 7)]);
    let seen = m.alter(ctx, "a", fn(n) => .Some(n.withDefault(-1)));
    assert.equal(assert.some(seen.get("a")), 7);
    let absent = m.alter(ctx, "b", fn(n) => .Some(n.withDefault(-1)));
    assert.equal(assert.some(absent.get("b")), -1);
}

// --- mapValues / filterMapValues ---------------------------------------------------

test "mapValues keeps every key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]).mapValues(ctx, fn(v) => v * 10);
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get("a")), 10);
    assert.equal(assert.some(m.get("b")), 20);
}

test "mapValues may change the value type" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]).mapValues(ctx, fn(v) => [v, v]);
    assert.equal(assert.some(m.get("a")), [1, 1]);
}

test "mapValues of the empty map is the empty map" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(map.empty<Str, Int>().mapValues(ctx, fn(v) => v).isEmpty());
}

test "filterMapValues drops what it answers nothing for" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map
        .of(ctx, [("a", 1), ("b", 2), ("c", 3)])
        .filterMapValues(ctx, fn(v) => if (v % 2 == 1) { .Some(v * 2) } else { .None });
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get("a")), 2);
    assert.equal(assert.some(m.get("c")), 6);
    assert.isTrue(m.get("b").isNone());
}

test "filterMapValues can keep only that a key passed" {
    let ctx = context {
        Allocator: alloc(),
    };
    let passed = map
        .of(ctx, [("a", 1), ("b", 2)])
        .filterMapValues(ctx, fn(v) => if (v > 1) { .Some(()) } else { .None });
    assert.equal(passed.length(), 1);
    assert.isTrue(passed.has("b"));
    assert.isFalse(passed.has("a"));
}

test "filterMapValues that keeps nothing is empty" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]).filterMapValues(ctx, fn(_v) => .None);
    assert.isTrue(m.isEmpty());
    assert.equal(m.length(), 0);
}

// --- merge / mergeWith --------------------------------------------------------------

test "merge is right-biased" {
    let ctx = context {
        Allocator: alloc(),
    };
    let defaults = map.of(ctx, [("host", "localhost"), ("port", "80")]);
    let overrides = map.of(ctx, [("port", "8080")]);
    let both = defaults.merge(ctx, overrides);
    assert.equal(both.length(), 2);
    assert.equal(assert.some(both.get("host")), "localhost");
    assert.equal(assert.some(both.get("port")), "8080");
    // Neither side moved.
    assert.equal(assert.some(defaults.get("port")), "80");
    assert.equal(overrides.length(), 1);
}

test "merging with the empty map answers the same entries" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]);
    assert.isTrue(m.merge(ctx, map.empty<Str, Int>()).equals(ctx, m));
    assert.isTrue(map.empty<Str, Int>().merge(ctx, m).equals(ctx, m));
}

test "mergeWith combines only the keys in both" {
    let ctx = context {
        Allocator: alloc(),
    };
    let monday = map.of(ctx, [("ana", 2), ("bo", 1)]);
    let tuesday = map.of(ctx, [("ana", 3), ("cy", 5)]);
    // The combiner is `mine * 100 + theirs`, so a value it never touched is
    // visibly untouched and the argument order is visible too.
    let total = monday.mergeWith(ctx, tuesday, fn(a, b) => a * 100 + b);
    assert.equal(total.length(), 3);
    assert.equal(assert.some(total.get("ana")), 203);
    assert.equal(assert.some(total.get("bo")), 1);
    assert.equal(assert.some(total.get("cy")), 5);
}

test "mergeWith over number keys combines the ones in both" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = map.of(ctx, [(1, 10), (2, 20)]);
    let b = map.of(ctx, [(2, 2), (3, 3)]);
    let both = a.mergeWith(ctx, b, fn(x, y) => x + y);
    assert.equal(both.length(), 3);
    assert.equal(both.get(2), .Some(22));
    // The same entries in another order are equal; a different size, or one
    // value that differs, is not.
    assert.isTrue(both.equals(ctx, map.of(ctx, [(3, 3), (2, 22), (1, 10)])));
    assert.isFalse(both.equals(ctx, a));
    assert.isFalse(both.equals(ctx, map.of(ctx, [(1, 10), (2, 20), (3, 3)])));
}

test "mergeWith over two hundred keys keeps every one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let evens = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, i) => i % 2 == 0);
    let odds = list.range(ctx, 0, 200).filterCtx(ctx, fn(_c, i) => i % 2 == 1);
    let a = map.of(ctx, evens.map(ctx, fn(i) => (i, i)));
    let b = map.of(ctx, odds.map(ctx, fn(i) => (i, i)));
    let both = a.mergeWith(ctx, b, fn(x, y) => x + y);
    assert.equal(both.length(), 200);
    assert.isTrue(list.range(ctx, 0, 200).all(fn(i) => both.get(i) == .Some(i)));
}

// --- filter -------------------------------------------------------------------------

test "filter keeps what the predicate keeps" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("bb", 2), ("c", 3)]);
    let short = m.filter(ctx, fn(k, _v) => k.length() == 1);
    assert.equal(short.length(), 2);
    assert.isTrue(short.get("bb").isNone());
    let odd = m.filter(ctx, fn(_k, v) => v % 2 == 1);
    assert.equal(odd.keys(ctx).sort(ctx), ["a", "c"]);
}

test "filter that keeps nothing, and filter that keeps everything" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    assert.isTrue(m.filter(ctx, fn(_k, _v) => false).isEmpty());
    assert.isTrue(m.filter(ctx, fn(_k, _v) => true).equals(ctx, m));
    assert.isTrue(map.empty<Str, Int>().filter(ctx, fn(_k, _v) => true).isEmpty());
}

// --- pop ----------------------------------------------------------------------------

test "pop answers the value and the map without it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    let (v, rest) = assert.some(m.pop(ctx, "a"));
    assert.equal(v, 1);
    assert.equal(rest.length(), 1);
    assert.isTrue(rest.get("a").isNone());
    // The map it came from is untouched.
    assert.equal(m.length(), 2);
}

test "popping what is not there is nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(map.of(ctx, [("a", 1)]).pop(ctx, "zzz").isNone());
    assert.isTrue(map.empty<Str, Int>().pop(ctx, "a").isNone());
    assert.isFalse(map.of(ctx, [("a", 1)]).pop(ctx, "a").isNone());
}

// --- takeKeys / dropKeys -------------------------------------------------------------

test "takeKeys keeps the keys it names and skips the ones it does not have" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    let kept = m.takeKeys(ctx, ["a", "c", "zzz"]);
    assert.equal(kept.length(), 2);
    assert.equal(kept.keys(ctx).sort(ctx), ["a", "c"]);
    assert.equal(assert.some(kept.get("c")), 3);
}

test "dropKeys is takeKeys' complement" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    let left = m.dropKeys(ctx, ["a", "c", "zzz"]);
    assert.equal(left.keys(ctx), ["b"]);
    assert.equal(m.takeKeys(ctx, []).length(), 0);
    assert.isTrue(m.dropKeys(ctx, []).equals(ctx, m));
}

test "a repeated key is not counted twice" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    assert.equal(m.takeKeys(ctx, ["a", "a", "a"]).length(), 1);
    assert.equal(m.dropKeys(ctx, ["a", "a"]).length(), 1);
}

// --- countBy / frequencies -----------------------------------------------------------

test "countBy counts the elements under each key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let words = ["ant", "bee", "ape", "bat", "cow"];
    let counts = map.countBy(ctx, words, fn(w: Str) => w.slice(0, 1));
    assert.equal(counts.length(), 3);
    assert.equal(assert.some(counts.get("a")), 2);
    assert.equal(assert.some(counts.get("b")), 2);
    assert.equal(assert.some(counts.get("c")), 1);
    assert.isTrue(counts.get("z").isNone());
}

test "countBy can count under a number" {
    let ctx = context {
        Allocator: alloc(),
    };
    let counts = map.countBy(ctx, ["ant", "bee", "deer"], fn(w: Str) => w.length());
    assert.equal(counts.length(), 2);
    assert.equal(counts.get(3), .Some(2));
    assert.equal(counts.get(4), .Some(1));
}

test "countBy of the empty list is the empty map" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(map.countBy(ctx, list.empty<Int>(), fn(n: Int) => n).isEmpty());
}

test "countBy agrees with groupBy's sizes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let ns = list.range(ctx, 0, 200);
    let key = fn(n: Int) => n % 7;
    let counts = map.countBy(ctx, ns, key);
    let groups = map.groupBy(ctx, ns, key);
    assert.equal(counts.length(), 7);
    assert.isTrue(
        list
            .range(ctx, 0, 7)
            .all(fn(k) => {
                counts.get(k) == .Some(groups.get(k).withDefault([]).length())
            }),
    );
}

test "frequencies is a histogram of the list" {
    let ctx = context {
        Allocator: alloc(),
    };
    let f = map.frequencies(ctx, [1, 2, 2, 3, 3, 3]);
    assert.equal(assert.some(f.get(1)), 1);
    assert.equal(assert.some(f.get(2)), 2);
    assert.equal(assert.some(f.get(3)), 3);
    assert.equal(f.length(), 3);
    assert.isTrue(map.frequencies(ctx, list.empty<Str>()).isEmpty());
}

// --- Where the combiner does not run ----------------------------------------------

/// Fails the test it is called from. `mergeWith` may only reach for it where a
/// key is in both maps, so a green case is a combiner that stayed put.
fn neverCombined(_a: Int, _b: Int): Int {
    assert.isTrue(false);
    0
}

test "mergeWith over disjoint keys never combines anything" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = map.of(ctx, [("a", 1), ("b", 2)]);
    let b = map.of(ctx, [("c", 3), ("d", 4)]);
    let both = a.mergeWith(ctx, b, neverCombined);
    assert.equal(both.length(), 4);
    assert.equal(assert.some(both.get("a")), 1);
    assert.equal(assert.some(both.get("d")), 4);
}

test "mergeWith with the empty map on either side never combines anything" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1)]);
    let none = map.empty<Str, Int>();
    assert.isTrue(m.mergeWith(ctx, none, neverCombined).equals(ctx, m));
    assert.isTrue(none.mergeWith(ctx, m, neverCombined).equals(ctx, m));
    assert.isTrue(none.mergeWith(ctx, none, neverCombined).isEmpty());
}

test "mergeWith over the same map combines every key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    let doubled = m.mergeWith(ctx, m, fn(x, y) => x + y);
    assert.equal(doubled.length(), 2);
    assert.equal(assert.some(doubled.get("a")), 2);
    assert.equal(assert.some(doubled.get("b")), 4);
}

// --- alter, over the four things it can do ----------------------------------------

test "alter leaves the map alone when it hands back what it was given" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2)]);
    let same = m.alter(ctx, "a", fn(v) => v);
    assert.isTrue(same.equals(ctx, m));
    let absent = m.alter(ctx, "z", fn(v) => v);
    assert.isTrue(absent.equals(ctx, m));
    // And the map it was called on is untouched either way.
    assert.equal(m.length(), 2);
}

// The counter idiom the method exists for, run until the map has to grow.
test "alter counts three hundred keys from nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let counted = list
        .range(ctx, 0, 900)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => {
                acc.alter(c, i % 300, fn(v) => .Some(v.withDefault(0) + 1))
            },
            map.empty<Int, Int>(),
        );
    assert.equal(counted.length(), 300);
    assert.isTrue(list.range(ctx, 0, 300).all(fn(k) => counted.get(k) == .Some(3)));
    // Removing every key with `alter` empties it again.
    let drained = list
        .range(ctx, 0, 300)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, k) => acc.alter(c, k, fn(_v) => .None),
            counted,
        );
    assert.isTrue(drained.isEmpty());
}

// --- pop, takeKeys and dropKeys at their edges -------------------------------------

test "popping the only entry leaves the empty map" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = map.of(ctx, [("a", 1)]);
    let (value, rest) = assert.some(one.pop(ctx, "a"));
    assert.equal(value, 1);
    assert.isTrue(rest.isEmpty());
    assert.isTrue(map.empty<Str, Int>().pop(ctx, "a").isNone());
    // The map it came from still has the entry: a map is a value.
    assert.equal(one.length(), 1);
}

test "takeKeys and dropKeys given nothing, everything, and a repeated key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [("a", 1), ("b", 2), ("c", 3)]);
    assert.isTrue(m.takeKeys(ctx, list.empty<Str>()).isEmpty());
    assert.isTrue(m.dropKeys(ctx, list.empty<Str>()).equals(ctx, m));
    assert.isTrue(m.takeKeys(ctx, ["a", "b", "c"]).equals(ctx, m));
    assert.isTrue(m.dropKeys(ctx, ["a", "b", "c"]).isEmpty());
    // A key named twice is one entry, and one named that is not there is none.
    assert.equal(m.takeKeys(ctx, ["a", "a", "z"]).length(), 1);
    assert.equal(m.dropKeys(ctx, ["a", "a", "z"]).length(), 2);
    // On the empty map both answer the empty map.
    let none = map.empty<Str, Int>();
    assert.isTrue(none.takeKeys(ctx, ["a"]).isEmpty());
    assert.isTrue(none.dropKeys(ctx, ["a"]).isEmpty());
}

// --- mapValues and filterMapValues over what they may not touch ---------------------

test "mapValues and filterMapValues on a map of one, and on a large one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = map.of(ctx, [("a", 1)]);
    assert.equal(assert.some(one.mapValues(ctx, fn(v) => v * 10).get("a")), 10);
    assert.equal(one.filterMapValues(ctx, fn(_v) => .None).length(), 0);
    assert.equal(assert.some(one.filterMapValues(ctx, fn(v) => .Some(v)).get("a")), 1);
    let big = map.of(ctx, list.range(ctx, 0, 300).map(ctx, fn(i) => (i, i)));
    assert.equal(big.mapValues(ctx, fn(v) => v + 1).length(), 300);
    assert.equal(
        big
            .filterMapValues(ctx, fn(v) => if (v % 2 == 0) { .Some(v) } else { .None })
            .length(),
        150,
    );
    // A filter that keeps everything is the map it started from.
    assert.isTrue(big.filterMapValues(ctx, fn(v) => .Some(v)).equals(ctx, big));
}

// --- countBy and frequencies at the sizes -------------------------------------------

test "countBy and frequencies over one element and over three hundred" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = map.countBy(ctx, ["ant"], fn(w: Str) => w.length());
    assert.equal(one.length(), 1);
    assert.equal(assert.some(one.get(3)), 1);
    assert.isTrue(map.frequencies(ctx, list.empty<Int>()).isEmpty());
    assert.equal(assert.some(map.frequencies(ctx, [7]).get(7)), 1);
    let many = map.frequencies(ctx, list.range(ctx, 0, 900).map(ctx, fn(i) => i % 300));
    assert.equal(many.length(), 300);
    assert.isTrue(list.range(ctx, 0, 300).all(fn(k) => many.get(k) == .Some(3)));
    // Every count adds up to the list it counted.
    assert.equal(many.values(ctx).sum(), 900);
}

// --- a list built inside the call that folds it -------------------------------
//
// `map.of(ctx, xs.map(ctx, f))` hands `list.map`'s result element the type
// `(K, V)` out of `map.of`'s own signature before the lambda is looked at, so
// the lambda's body is the only thing in the program that says what `K` and
// `V` are. Every case below therefore asserts **sizes only**: a `get` with an
// `Int` argument would pin `K` from the outside and the case would stop asking
// the question. Naming the list first is the same program and has to answer
// the same.

/// A fold onto a persistent map, written by hand rather than taken from
/// `core/map`, so the rule holds for a program that writes its own.
fn keyedBy<K: Hash + Equal, V, C: Allocator>(ctx: C, entries: [(K, V)]): Map<K, V> {
    entries.foldCtx(ctx, fn(c, acc, e) => acc.insert(c, e.0, e.1), map.empty<K, V>())
}

test "map.of over a list mapped inside the call keeps every entry" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        map.of(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i))).length(),
        40,
    );
    assert.equal(
        map
            .of(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i)))
            .keys(ctx)
            .length(),
        40,
    );
    let named = list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i));
    assert.equal(map.of(ctx, named).length(), 40);
}

test "the same for mapCtx and filterMap" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        map.of(ctx, list.range(ctx, 0, 40).mapCtx(ctx, fn(_c, i) => (i, i))).length(),
        40,
    );
    assert.equal(
        map
            .of(ctx, list.range(ctx, 0, 40).filterMap(ctx, fn(i) => .Some((i, i))))
            .length(),
        40,
    );
}

test "a hand-written fold onto a map answers the same" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        keyedBy(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i))).length(),
        40,
    );
    let named = list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i));
    assert.equal(keyedBy(ctx, named).length(), 40);
}

test "set.of over a list mapped inside the call keeps every item" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        set.of(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => (i, i))).length(),
        40,
    );
    assert.equal(set.of(ctx, list.range(ctx, 0, 40).map(ctx, fn(i) => i)).length(), 40);
}

// --- keys that share a hash ---------------------------------------------------
//
// Two distinct keys can hash to the same 64-bit value, and the map has to keep
// both, find each, and remove each without disturbing the other. `Collider`
// forces the case: its hash is `(id % 8) * 32`, so ids 0, 8, 16, ... all
// collide, and a constant hash would pile every key into one collision leaf.
// The low five bits are always zero, so the hashes that differ differ only
// further up, and the tree has to branch below its root to tell them apart. The interface
// says nothing about how a map does this; these cases only ever `get`, `remove`
// and count.

struct Collider {
    export id: Int,
}

impl Equal for Collider {
    fn equal(self, other: Collider): Bool {
        self.id == other.id
    }
}

impl Hash for Collider {
    fn hash(self): U64 {
        (self.id % 8 * 32).wrapToU64()
    }
}

/// Every key hashes to the same value, so a whole map lands in one bucket.
struct AllOne {
    export id: Int,
}

impl Equal for AllOne {
    fn equal(self, other: AllOne): Bool {
        self.id == other.id
    }
}

impl Hash for AllOne {
    fn hash(self): U64 {
        0
    }
}

test "distinct keys that share a hash are all retrievable" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 60;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Collider, Int>, i) => {
                acc.insert(c, Collider { id: i }, i * 10)
            },
            map.empty<Collider, Int>(),
        );
    assert.equal(m.length(), n);
    // Every key, including the many that share a bucket, is found with its value.
    assert.isTrue(
        list.range(ctx, 0, n).all(fn(i) => m.get(Collider { id: i }) == .Some(i * 10)),
    );
    assert.isTrue(m.get(Collider { id: n }).isNone());
    // Taking a key out of a shared bucket leaves the rest of it, and taking
    // one that was never put in changes nothing.
    let less = m.remove(ctx, Collider { id: 8 });
    assert.equal(less.length(), n - 1);
    assert.isTrue(less.get(Collider { id: 8 }).isNone());
    assert.equal(less.get(Collider { id: 16 }), .Some(160));
    assert.equal(less.remove(ctx, Collider { id: n }).length(), n - 1);
    assert.equal(less.entries(ctx).length(), n - 1);
    // Two keys whose hashes differ each keep a bucket of their own.
    let pair = map
        .empty<Collider, Int>()
        .insert(ctx, Collider { id: 0 }, 0)
        .insert(ctx, Collider { id: 1 }, 10);
    assert.equal(pair.entries(ctx).length(), 2);
    assert.equal(
        pair.remove(ctx, Collider { id: 0 }).get(Collider { id: 1 }),
        .Some(10),
    );
}

test "a colliding key is removed without disturbing the others in its bucket" {
    let ctx = context {
        Allocator: alloc(),
    };
    // 0, 8, 16, 24 all hash alike; take 8 out and the other three stay.
    let m = map.of(ctx, [
        (Collider { id: 0 }, "a"),
        (Collider { id: 8 }, "b"),
        (Collider { id: 16 }, "c"),
        (Collider { id: 24 }, "d"),
    ]);
    assert.equal(m.length(), 4);
    let less = m.remove(ctx, Collider { id: 8 });
    assert.equal(less.length(), 3);
    assert.isTrue(less.get(Collider { id: 8 }).isNone());
    assert.equal(assert.some(less.get(Collider { id: 0 })), "a");
    assert.equal(assert.some(less.get(Collider { id: 16 })), "c");
    assert.equal(assert.some(less.get(Collider { id: 24 })), "d");
    // Removing one that was never there changes nothing.
    assert.isTrue(less.remove(ctx, Collider { id: 99 }).equals(ctx, less));
}

// Keys 0 and 8 share a bucket and 1 has one of its own, so the map holds both
// kinds of node side by side: a lookup, an insert or a removal that lands in
// either has to leave the other as it was.
test "colliding and lone keys live side by side" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map.of(ctx, [
        (Collider { id: 0 }, "a"),
        (Collider { id: 8 }, "b"),
        (Collider { id: 1 }, "c"),
    ]);
    assert.equal(m.length(), 3);
    // A key that shares 0's bucket, or 1's, but is neither; and one whose
    // bucket is empty.
    assert.isTrue(m.get(Collider { id: 16 }).isNone());
    assert.isTrue(m.get(Collider { id: 9 }).isNone());
    assert.isTrue(m.get(Collider { id: 2 }).isNone());
    // Every entry is walked, whether it shares its bucket or has one alone.
    assert.equal(m.entries(ctx).length(), 3);
    // Two lone keys whose hashes differ are told apart a level down.
    let lone = map.of(ctx, [(Collider { id: 2 }, "x"), (Collider { id: 3 }, "y")]);
    assert.equal(assert.some(lone.get(Collider { id: 2 })), "x");
    assert.equal(assert.some(lone.get(Collider { id: 3 })), "y");
    // A third key joins the shared bucket; the second of 1's makes one more.
    let more = m
        .insert(ctx, Collider { id: 16 }, "d")
        .insert(ctx, Collider { id: 9 }, "e");
    assert.equal(more.length(), 5);
    assert.equal(assert.some(more.get(Collider { id: 16 })), "d");
    assert.equal(assert.some(more.get(Collider { id: 9 })), "e");
    assert.equal(assert.some(more.get(Collider { id: 1 })), "c");
    // Replacing the second key of a bucket changes no count.
    let replaced = more.insert(ctx, Collider { id: 8 }, "B");
    assert.equal(replaced.length(), 5);
    assert.equal(assert.some(replaced.get(Collider { id: 8 })), "B");
    assert.equal(replaced.entries(ctx).map(ctx, fn(e) => e.0.id).sort(ctx), [
        0,
        1,
        8,
        9,
        16,
    ]);
    // Down to one key per bucket, then to nothing.
    let fewer = replaced
        .remove(ctx, Collider { id: 0 })
        .remove(ctx, Collider { id: 16 })
        .remove(ctx, Collider { id: 9 });
    assert.equal(fewer.length(), 2);
    assert.equal(assert.some(fewer.get(Collider { id: 8 })), "B");
    assert.equal(assert.some(fewer.get(Collider { id: 1 })), "c");
    let gone = fewer.remove(ctx, Collider { id: 8 }).remove(ctx, Collider { id: 1 });
    assert.isTrue(gone.isEmpty());
    assert.isTrue(gone.equals(ctx, map.empty<Collider, Str>()));
    // Maps that differ in size, or only in a value, are not equal.
    assert.isFalse(fewer.equals(ctx, replaced));
    assert.isFalse(replaced.equals(ctx, more));
    assert.isTrue(replaced.equals(ctx, more.insert(ctx, Collider { id: 8 }, "B")));
}

test "inserting an existing colliding key replaces rather than duplicating" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = map
        .of(ctx, [(Collider { id: 0 }, 1), (Collider { id: 8 }, 2)])
        .insert(ctx, Collider { id: 0 }, 99);
    assert.equal(m.length(), 2);
    assert.equal(assert.some(m.get(Collider { id: 0 })), 99);
    assert.equal(assert.some(m.get(Collider { id: 8 })), 2);
}

/// Ids 0 and 8 share a bucket and 1 has its own: each kind of slot answers a
/// lookup, an insert and a removal for itself, and so does the bucket left as
/// the whole map once the others are gone.
fn buckets<V: Equal + Show, C: Allocator>(ctx: C, a: V, b: V, c: V, d: V): () {
    let key = fn(id: Int) => Collider { id: id };
    let m = map.of(ctx, [(key(0), a), (key(8), b), (key(1), c)]);
    assert.equal(m.get(key(1)), .Some(c));
    assert.equal(m.get(key(9)), .None);
    assert.equal(m.get(key(3)), .None);
    assert.equal(m.insert(ctx, key(1), d).get(key(1)), .Some(d));
    let replaced = m.insert(ctx, key(8), d);
    assert.equal((replaced.length(), replaced.get(key(8))), (3, .Some(d)));
    // Without 1, the bucket is the map; a key of another hash splits it again.
    let shared = m.remove(ctx, key(1));
    let grown = shared.insert(ctx, key(2), d);
    assert.equal(
        (grown.length(), grown.get(key(2)), grown.get(key(8))),
        (3, .Some(d), .Some(b)),
    );
    // Without 0 as well, one key is the map.
    let lone = shared.remove(ctx, key(0));
    assert.equal(lone.entries(ctx).map(ctx, fn(e) => e.0.id), [8]);
    let joined = lone.insert(ctx, key(16), d);
    assert.equal(
        (joined.length(), joined.get(key(16)), joined.get(key(8))),
        (2, .Some(d), .Some(b)),
    );
    let apart = lone.insert(ctx, key(3), d);
    assert.equal(
        (apart.length(), apart.get(key(3)), apart.get(key(8))),
        (2, .Some(d), .Some(b)),
    );
    assert.isTrue(lone.remove(ctx, key(8)).isEmpty());
    assert.isTrue(map.of(ctx, [(key(5), a)]).remove(ctx, key(5)).isEmpty());
}

test "each kind of slot answers for itself, whatever the values" {
    let ctx = context {
        Allocator: alloc(),
    };
    buckets(ctx, 10, 20, 30, 40);
    buckets(ctx, "a", "b", "c", "d");
}

test "a map of one shared hash answers lookups, replacements and removals in any order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let key = fn(id: Int) => AllOne { id: id };
    assert.equal(map.empty<AllOne, Int>().get(key(1)), .None);
    let one = map.empty<AllOne, Int>().insert(ctx, key(1), 1);
    assert.equal(one.get(key(2)), .None);
    assert.equal(one.insert(ctx, key(1), 5).length(), 1);
    assert.equal(one.insert(ctx, key(1), 5).get(key(1)), .Some(5));
    assert.isTrue(one.remove(ctx, key(1)).isEmpty());
    let many = list
        .range(ctx, 0, 6)
        .foldCtx(
            ctx,
            fn(c, acc: Map<AllOne, Int>, i) => acc.insert(c, key(i), i),
            map.empty<AllOne, Int>(),
        );
    assert.equal(many.get(key(9)), .None);
    let replaced = many.insert(ctx, key(4), 40);
    assert.equal(replaced.length(), 6);
    assert.equal((replaced.get(key(4)), replaced.get(key(3))), (.Some(40), .Some(3)));
    assert.equal(many.remove(ctx, key(9)).length(), 6);
    let backwards = list
        .range(ctx, 0, 6)
        .foldCtx(
            ctx,
            fn(c, acc: Map<AllOne, Int>, i) => acc.remove(c, key(5 - i)),
            many,
        );
    assert.isTrue(backwards.isEmpty());
}

test "a map whose keys all share one hash still works and empties cleanly" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 50;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<AllOne, Int>, i) => acc.insert(c, AllOne { id: i }, i),
            map.empty<AllOne, Int>(),
        );
    assert.equal(m.length(), n);
    assert.isTrue(
        list.range(ctx, 0, n).all(fn(i) => m.get(AllOne { id: i }) == .Some(i)),
    );
    // Removing every key one by one lands back at the empty map.
    let drained = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<AllOne, Int>, i) => acc.remove(c, AllOne { id: i }),
            m,
        );
    assert.isTrue(drained.isEmpty());
    assert.equal(drained.length(), 0);
}

// --- built-in keys that share a hash --------------------------------------------
//
// A hash is 32 bits of FNV-1a, so distinct strings, integers, floats and tuples
// share one too. `a`, `b` and `c` below share a hash. `other` has its own,
// but its lowest five bits are theirs, so it lands in their slot.

/// Three keys of one hash join one by one, a repeat replaces, and a key of
/// another hash sits beside them.
fn inserted<K: Hash + Equal, V, C: Allocator>(
    ctx: C,
    keys: (K, K, K, K),
    v: V,
): Map<K, V> {
    let (a, b, c, other) = keys;
    assert.equal(
        (a.hash() == b.hash(), b.hash() == c.hash(), c.hash() == other.hash()),
        (true, true, false),
    );
    let two = map.empty<K, V>().insert(ctx, a, v).insert(ctx, b, v);
    let three = two.insert(ctx, c, v).insert(ctx, b, v);
    let four = three.insert(ctx, other, v);
    let apart = map.empty<K, V>().insert(ctx, other, v).insert(ctx, a, v);
    assert.equal(
        (two.length(), three.length(), four.length(), apart.length()),
        (2, 3, 4, 2),
    );
    assert.equal(apart.insert(ctx, other, v).length(), 2);
    four
}

/// `inserted`, and then each key found where it is and missed where it isn't.
fn found<K: Hash + Equal, V, C: Allocator>(
    ctx: C,
    keys: (K, K, K, K),
    v: V,
): Map<K, V> {
    let (a, b, c, other) = keys;
    let two = map.empty<K, V>().insert(ctx, a, v).insert(ctx, b, v);
    assert.equal(
        (two.has(a), two.has(b), two.has(c), two.has(other)),
        (true, true, false, false),
    );
    let four = inserted(ctx, keys, v);
    assert.equal(
        (four.has(a), four.has(b), four.has(c), four.has(other)),
        (true, true, true, true),
    );
    let lone = map.empty<K, V>().insert(ctx, other, v);
    assert.equal((lone.has(a), four.entries(ctx).length()), (false, 4));
    four
}

/// `found`, and then the keys removed one at a time until none is left. A key
/// that is already gone removes nothing.
fn removed<K: Hash + Equal, V, C: Allocator>(ctx: C, keys: (K, K, K, K), v: V): () {
    let (a, b, c, other) = keys;
    let four = found(ctx, keys, v);
    let shared = four.remove(ctx, a);
    let one = shared.remove(ctx, other).remove(ctx, c);
    assert.equal(
        (shared.length(), shared.has(other), one.length(), one.has(b), one.has(a)),
        (3, true, 1, true, false),
    );
    assert.equal(one.remove(ctx, other).length(), 1);
    assert.isTrue(one.remove(ctx, b).isEmpty());
    let lone = map.empty<K, V>().insert(ctx, other, v);
    assert.isTrue(lone.remove(ctx, other).isEmpty());
}

test "strings that share a hash are kept apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let keys = ("costarring", "liquid", "gzwg阵", "word");
    removed(ctx, keys, ());
    removed(ctx, keys, 1);
    let _ = found(ctx, keys, "v");
    let _ = found(ctx, keys, [1]);
    let _ = found(ctx, keys, ["v"]);
}

test "integers that share a hash are kept apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    // A large integer mixes two 32-bit words and a small one mixes one.
    let keys = (-1175966504, 10000000000, 2870713190975804, 24);
    removed(ctx, keys, 1);
    let _ = found(ctx, keys, ());
    let _ = found(ctx, keys, [1]);
}

test "floats that share a hash are kept apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    // A whole float hashes as its integer, and any other mixes its eight bytes.
    let keys = (3503.5, 4252598.5, 3604364228.0, 4.0);
    let _ = found(ctx, keys, 1);
    // A key in a slot of its own is missed without visiting theirs.
    assert.isFalse(found(ctx, keys, "v").has(0.25));
    let _ = inserted(ctx, keys, ());
}

test "pairs that share a hash are kept apart" {
    let ctx = context {
        Allocator: alloc(),
    };
    let _ = inserted(ctx, ((0, 0), (1, 16779155), (2, 33555290), (5, 31)), ());
}

// --- a large map --------------------------------------------------------------
//
// The size the interface's complexity promise is about. Building ten thousand
// entries and reading each back is the round trip that a per-insert copy of the
// whole map would make quadratic.

test "ten thousand entries round-trip through get" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 10000;
    let m = list
        .range(ctx, 0, n)
        .foldCtx(
            ctx,
            fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i, i * 3),
            map.empty<Int, Int>(),
        );
    assert.equal(m.length(), n);
    assert.isTrue(list.range(ctx, 0, n).all(fn(i) => m.get(i) == .Some(i * 3)));
    assert.isTrue(m.get(n).isNone());
    assert.isTrue(m.get(-1).isNone());
    // Every entry is visited exactly once, so the entry count is the size.
    assert.equal(m.entries(ctx).length(), n);
}

test "entries visits every key exactly once" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 500;
    let m = map.of(ctx, list.range(ctx, 0, n).map(ctx, fn(i) => (i, i)));
    // Sorting the keys recovers the whole range with no gaps and no repeats,
    // which is the same as saying each key appeared once.
    assert.equal(m.keys(ctx).sort(ctx), list.range(ctx, 0, n));
    assert.equal(m.values(ctx).sort(ctx), list.range(ctx, 0, n));
    assert.equal(m.entries(ctx).length(), n);
}

// --- remove, over a whole map -------------------------------------------------

test "removing every key empties a large map" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 400;
    let m = map.of(ctx, list.range(ctx, 0, n).map(ctx, fn(i) => (i, i)));
    let drained = list
        .range(ctx, 0, n)
        .foldCtx(ctx, fn(c, acc: Map<Int, Int>, i) => acc.remove(c, i), m);
    assert.isTrue(drained.isEmpty());
    assert.equal(drained.length(), 0);
    assert.isTrue(drained.get(0).isNone());
    // The map removal came from is untouched: a map is a value.
    assert.equal(m.length(), n);
    // Removing half leaves exactly the other half, each still at its value.
    let half = list
        .range(ctx, 0, n)
        .filterCtx(ctx, fn(_c, i) => i % 2 == 0)
        .foldCtx(ctx, fn(c, acc: Map<Int, Int>, i) => acc.remove(c, i), m);
    assert.equal(half.length(), n / 2);
    assert.isTrue(
        list
            .range(ctx, 0, n)
            .all(fn(i) => {
                if (i % 2 == 0) {
                    half.get(i).isNone()
                } else {
                    half.get(i) == .Some(i)
                }
            }),
    );
}

test "overwriting every key changes values but not size" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = 300;
    let m = map.of(ctx, list.range(ctx, 0, n).map(ctx, fn(i) => (i, i)));
    let bumped = list
        .range(ctx, 0, n)
        .foldCtx(ctx, fn(c, acc: Map<Int, Int>, i) => acc.insert(c, i, i + 1000), m);
    assert.equal(bumped.length(), n);
    assert.isTrue(list.range(ctx, 0, n).all(fn(i) => bumped.get(i) == .Some(i + 1000)));
}
