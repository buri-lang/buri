    f56: Bool,
    f57: Bool,
    f58: Bool,
    f59: Bool,
    f60: Bool,
    f61: Bool,
    f62: Bool,
    f63: Bool,
}

test "8 flags" {
    let ctx = context {
        Allocator: alloc(),
    };
    let none = flags.none<W8>();
    let all = flags.all<W8>();
    let first = W8 { ..none, f0: true };
    let last = W8 { ..none, f7: true };
    assert.equal(all.count(), 8);
    assert.isTrue(none.isEmpty());
    assert.isTrue(last.f7 && !last.f0 && first.f0 && !first.f7);
    assert.equal(last.complement().count(), 7);
    assert.isFalse(last.complement().f7);
    assert.equal(all.difference(last), last.complement());
    assert.equal(last.symmetricDifference(all), last.complement());
    assert.equal(last.union(first).count(), 2);
    assert.isTrue(last.isSubsetOf(all) && !all.isSubsetOf(last));
    assert.isTrue(first > last && none < last && last < all);
    assert.equal(all.compare(all), Order.Equal);
    assert.notEqual(first.hash(), last.hash());
    assert.equal(last.hash(), 67918732);
    assert.equal(first.hash(), 2232128415);
    assert.startsWith(first.show(ctx), "W8 { f0: true, f1: false, ");
    assert.containsText(last.show(ctx), ", f7: true }");
}

