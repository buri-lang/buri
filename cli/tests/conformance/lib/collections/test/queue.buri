// core/queue — the banker's deque.
//
// Every exported name is called at least once, and every one that can meet an
// empty queue is given one: an empty queue is where the rebalance that makes
// the amortized bound work is actually visible.

from "core/testing/assert" import * as assert;
from "core/testing/context" import { Hermetic };

from "core/list" import * as list;
from "core/queue" import * as queue;

// --- empty / len / isEmpty ---------------------------------------------------

test "an empty queue has no elements" {
  let q = queue.empty<Int>();
  assert.eq(q.len(), 0);
  assert.isTrue(q.isEmpty());
}

test "of builds a queue from a list" {
  let ctx = Hermetic();
  let q = queue.of([1, 2, 3]);
  assert.eq(q.len(), 3);
  assert.eq(q.toList(ctx), [1, 2, 3]);
}

// --- push / peek -------------------------------------------------------------

test "push adds to the back" {
  let ctx = Hermetic();
  let q = queue.empty<Int>().push(ctx, 1).push(ctx, 2);
  assert.eq(q.toList(ctx), [1, 2]);
}

test "pushFront adds to the front" {
  let ctx = Hermetic();
  let q = queue.empty<Int>().push(ctx, 1).pushFront(ctx, 0);
  assert.eq(q.toList(ctx), [0, 1]);
}

test "peek is the first element and does not remove it" {
  let ctx = Hermetic();
  let q = queue.of([7, 8]);
  assert.eq(assert.some(q.peek()), 7);
  assert.eq(q.len(), 2);
}

test "peekBack is the last element" {
  let ctx = Hermetic();
  let q = queue.of([7, 8]);
  assert.eq(assert.some(q.peekBack()), 8);
}

test "peek of an empty queue is None" {
  assert.isTrue(queue.empty<Int>().peek().isNone());
  assert.isTrue(queue.empty<Int>().peekBack().isNone());
}

// --- pop ---------------------------------------------------------------------

test "pop takes from the front and returns the rest" {
  let ctx = Hermetic();
  let (v, rest) = assert.some(queue.of([1, 2, 3]).pop(ctx));
  assert.eq(v, 1);
  assert.eq(rest.toList(ctx), [2, 3]);
}

test "popBack takes from the back" {
  let ctx = Hermetic();
  let (v, rest) = assert.some(queue.of([1, 2, 3]).popBack(ctx));
  assert.eq(v, 3);
  assert.eq(rest.toList(ctx), [1, 2]);
}

test "pop of an empty queue is None" {
  let ctx = Hermetic();
  assert.isTrue(queue.empty<Int>().pop(ctx).isNone());
  assert.isTrue(queue.empty<Int>().popBack(ctx).isNone());
}

// The case the two-list representation exists for: everything is pushed to the
// back, so the front is empty and the first `pop` has to reverse. What must
// come out is insertion order, which is what a queue means.
test "pop reverses the back when the front is spent" {
  let ctx = Hermetic();
  let q = queue.empty<Int>().push(ctx, 1).push(ctx, 2).push(ctx, 3);
  let (a, q1) = assert.some(q.pop(ctx));
  let (b, q2) = assert.some(q1.pop(ctx));
  let (c, q3) = assert.some(q2.pop(ctx));
  assert.eq(a, 1);
  assert.eq(b, 2);
  assert.eq(c, 3);
  assert.isTrue(q3.isEmpty());
}

test "popBack reverses the front when the back is spent" {
  let ctx = Hermetic();
  let q = queue.empty<Int>().pushFront(ctx, 1).pushFront(ctx, 2);
  let (a, q1) = assert.some(q.popBack(ctx));
  let (b, q2) = assert.some(q1.popBack(ctx));
  assert.eq(a, 1);
  assert.eq(b, 2);
  assert.isTrue(q2.isEmpty());
}

// --- a queue is a sequence, not a pair of lists ------------------------------

test "equals ignores how the elements are split" {
  let ctx = Hermetic();
  // Same contents, opposite construction: one all pushed to the back, one all
  // pushed to the front. Their `front`/`back` fields do not match.
  let a = queue.empty<Int>().push(ctx, 1).push(ctx, 2);
  let b = queue.empty<Int>().pushFront(ctx, 2).pushFront(ctx, 1);
  assert.isTrue(a.equals(ctx, b));
  assert.eq(a.toList(ctx), b.toList(ctx));
}

test "equals is false for different contents" {
  let ctx = Hermetic();
  let a = queue.of([1, 2]);
  let b = queue.of([2, 1]);
  assert.isFalse(a.equals(ctx, b));
}

test "equals is false for different lengths" {
  let ctx = Hermetic();
  assert.isFalse(queue.of([1]).equals(ctx, queue.of([1, 2])));
}

// --- interleaving ------------------------------------------------------------

test "pushing and popping at both ends keeps the order" {
  let ctx = Hermetic();
  let q = queue.empty<Int>().push(ctx, 2).pushFront(ctx, 1).push(ctx, 3);
  assert.eq(q.toList(ctx), [1, 2, 3]);
  let (front, rest) = assert.some(q.pop(ctx));
  assert.eq(front, 1);
  let (back, rest2) = assert.some(rest.popBack(ctx));
  assert.eq(back, 3);
  assert.eq(rest2.toList(ctx), [2]);
}

test "a queue of one is both ends at once" {
  let ctx = Hermetic();
  let q = queue.empty<Str>().push(ctx, "only");
  assert.eq(assert.some(q.peek()), "only");
  assert.eq(assert.some(q.peekBack()), "only");
  let (v, rest) = assert.some(q.pop(ctx));
  assert.eq(v, "only");
  assert.isTrue(rest.isEmpty());
}

test "toList of an empty queue is empty" {
  let ctx = Hermetic();
  assert.eq(queue.empty<Int>().toList(ctx), list.empty<Int>());
}
