// core/heap — the pairing heap.
//
// The cases worth writing are the ones that make the structure work rather than
// the interface. A pairing heap does not balance: `push` hangs a node off the
// root and `pop` is the only thing that ever reshapes the tree, so the case
// that matters is a long run of pushes followed by a drain — which is where the
// two-pass merge either pays for itself or leaves a spine behind. Duplicates
// matter too, because holding the same priority twice is the reason this is not
// an `OrderedSet`.

from "core/effect" import { Allocator };
from "core/heap" import * as heap;
from "core/heap" import { Heap };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/order" import { Equal, Ordered, Order, Show };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// --- empty ---------------------------------------------------------------------

test "an empty heap holds nothing" {
    let h = heap.empty<Int>();
    assert.equal(h.length(), 0);
    assert.isTrue(h.isEmpty());
    assert.isTrue(h.peek().isNone());
}

test "popping an empty heap is nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(heap.empty<Int>().pop(ctx).isNone());
    assert.equal(heap.empty<Int>().toSortedList(ctx), []);
    assert.equal(heap.of(ctx, list.empty<Int>()).length(), 0);
}

// --- push / peek / pop ----------------------------------------------------------

test "peek answers the smallest, whatever order it arrived in" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.empty<Int>().push(ctx, 30).push(ctx, 10).push(ctx, 20);
    assert.equal(assert.some(h.peek()), 10);
    assert.equal(h.length(), 3);
    // The smallest arriving last is the same answer.
    let later = heap.empty<Int>().push(ctx, 30).push(ctx, 20).push(ctx, 5);
    assert.equal(assert.some(later.peek()), 5);
}

test "pop answers the smallest and the heap without it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.of(ctx, [30, 10, 20]);
    let (smallest, rest) = assert.some(h.pop(ctx));
    assert.equal(smallest, 10);
    assert.equal(rest.length(), 2);
    assert.equal(assert.some(rest.peek()), 20);
    // The heap it came from is untouched: a heap is a value.
    assert.equal(h.length(), 3);
    assert.equal(assert.some(h.peek()), 10);
}

test "a heap of one pops to the empty heap" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (only, rest) = assert.some(heap.of(ctx, [7]).pop(ctx));
    assert.equal(only, 7);
    assert.equal(rest.length(), 0);
    assert.isTrue(rest.isEmpty());
    assert.isTrue(rest.peek().isNone());
    assert.isTrue(rest.pop(ctx).isNone());
}

test "a heap holds duplicates, which is why it is not a set" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.of(ctx, [5, 5, 5, 1]);
    assert.equal(h.length(), 4);
    assert.equal(h.toSortedList(ctx), [1, 5, 5, 5]);
}

test "negatives and a repeated smallest come out in order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.of(ctx, [0, -3, 2, -3, 1]);
    assert.equal(h.toSortedList(ctx), [-3, -3, 0, 1, 2]);
}

// --- merge -----------------------------------------------------------------------

test "merge holds both sides" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = heap.of(ctx, [1, 5]);
    let b = heap.of(ctx, [3, 7]);
    let both = a.merge(ctx, b);
    assert.equal(both.length(), 4);
    assert.equal(assert.some(both.peek()), 1);
    assert.equal(both.toSortedList(ctx), [1, 3, 5, 7]);
    // Neither side moved.
    assert.equal(a.length(), 2);
    assert.equal(b.length(), 2);
}

test "merging with the empty heap answers the same elements" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = heap.of(ctx, [2, 4]);
    assert.equal(a.merge(ctx, heap.empty<Int>()).toSortedList(ctx), [2, 4]);
    assert.equal(heap.empty<Int>().merge(ctx, a).toSortedList(ctx), [2, 4]);
    assert.isTrue(heap.empty<Int>().merge(ctx, heap.empty<Int>()).isEmpty());
}

test "merge keeps the duplicates both sides brought" {
    let ctx = context {
        Allocator: alloc(),
    };
    let both = heap.of(ctx, [1, 1]).merge(ctx, heap.of(ctx, [1]));
    assert.equal(both.length(), 3);
    assert.equal(both.toSortedList(ctx), [1, 1, 1]);
}

// --- toSortedList ------------------------------------------------------------------

test "toSortedList is the elements smallest first" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(heap.of(ctx, [3, 1, 2]).toSortedList(ctx), [1, 2, 3]);
    assert.equal(heap.of(ctx, [1]).toSortedList(ctx), [1]);
    // It reads rather than consumes: the heap is a value.
    let h = heap.of(ctx, [3, 1, 2]);
    assert.equal(h.toSortedList(ctx), h.toSortedList(ctx));
    assert.equal(h.length(), 3);
}

test "a heap of strings sorts by the string order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.of(ctx, ["pear", "apple", "fig"]);
    assert.equal(assert.some(h.peek()), "apple");
    assert.equal(h.toSortedList(ctx), ["apple", "fig", "pear"]);
}

// The structure's own behaviour. A run of five hundred pushes leaves the root
// holding five hundred children, and the first `pop` is the one that has to
// meld all of them in pairs; the drain after it is what says the second pass
// left a heap rather than a spine.
test "five hundred pushes drain in order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let scattered = list.range(ctx, 0, 500).map(ctx, fn(i) => i * 251 % 500);
    let h = scattered.foldCtx(
        ctx,
        fn(c, acc: Heap<Int>, x) => acc.push(c, x),
        heap.empty<Int>(),
    );
    assert.equal(h.length(), 500);
    assert.equal(h.toSortedList(ctx), list.range(ctx, 0, 500));
}

test "pushes and pops interleaved keep answering the smallest" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Push two, pop one, two hundred times over: the heap is reshaped by a pop
    // and then grown again, which is the sequence a work queue actually runs.
    let taken = churn(ctx, heap.empty<Int>(), 0, 200, list.empty<Int>());
    // Round `i` pushes `1000 - 2i` and `999 - 2i` and pops the smallest, which
    // is always the odd one it just pushed — the evens pile up behind it.
    assert.equal(taken, list.range(ctx, 0, 200).map(ctx, fn(i) => 999 - i * 2));
}

/// Pushes `2n` and `2n + 1` in descending order and pops one, `rounds` times.
fn churn<C: Allocator>(ctx: C, h: Heap<Int>, at: Int, rounds: Int, acc: [Int]): [Int] {
    if (at >= rounds) {
        acc
    } else {
        let grown = h.push(ctx, 1000 - at * 2).push(ctx, 1000 - at * 2 - 1);
        match (grown.pop(ctx)) {
            .None => acc,
            .Some(taken) => {
                let (x, rest) = taken;
                churn(ctx, rest, at + 1, rounds, acc.push(ctx, x))
            },
        }
    }
}

test "of and a fold of pushes build the same heap" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = list.range(ctx, 0, 200).map(ctx, fn(i) => i * 89 % 200);
    let byOf = heap.of(ctx, xs);
    let byPush = xs.foldCtx(
        ctx,
        fn(c, acc: Heap<Int>, x) => acc.push(c, x),
        heap.empty<Int>(),
    );
    assert.equal(byOf.length(), byPush.length());
    assert.equal(byOf.toSortedList(ctx), byPush.toSortedList(ctx));
}

test "a merged heap drains the same as one built from both lists" {
    let ctx = context {
        Allocator: alloc(),
    };
    let evens = list.range(ctx, 0, 150).map(ctx, fn(i) => i * 2);
    let odds = list.range(ctx, 0, 150).map(ctx, fn(i) => i * 2 + 1);
    let merged = heap.of(ctx, evens).merge(ctx, heap.of(ctx, odds));
    assert.equal(merged.length(), 300);
    assert.equal(merged.toSortedList(ctx), list.range(ctx, 0, 300));
}

// --- A type with its own Ordered ------------------------------------------------------
//
// `peek` and `pop` answer the least element *by `Ordered`*, and the module's own
// header names the way to a largest-first queue: key the elements by a type
// whose `compare` flips. If the heap ever compared anything but the type's own
// `Ordered`, every assertion below would come out backwards.

/// An `Int` that sorts backwards, so a heap of these drains largest first.
struct Highest(export Int);

impl Equal for Highest {
    fn equal(self, other: Highest): Bool {
        self.0 == other.0
    }
}

impl Ordered for Highest {
    fn compare(self, other: Highest): Order {
        if (self.0 < other.0) {
            Order.Greater
        } else if (self.0 > other.0) {
            Order.Less
        } else {
            Order.Equal
        }
    }
}

impl Show for Highest {
    fn show<C: Allocator>(self, ctx: C): Str {
        str.format(ctx, "Highest(${self.0})")
    }
}

derive Equal, Ordered, Show for Job;
/// Two fields, so the derived order breaks a tie on the second one and a drain
/// is one list rather than a set of them.
struct Job {
    priority: Int,
    name: Str,
}

test "a heap takes the type's own Ordered, so a flipped one drains largest first" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.of(ctx, [Highest(3), Highest(9), Highest(1)]);
    assert.equal(assert.some(h.peek()), Highest(9));
    assert.equal(h.toSortedList(ctx), [Highest(9), Highest(3), Highest(1)]);
    // And through `push` rather than `of`, which is the other way in.
    let built = heap
        .empty<Highest>()
        .push(ctx, Highest(3))
        .push(ctx, Highest(9))
        .push(ctx, Highest(1));
    assert.equal(built.toSortedList(ctx), [Highest(9), Highest(3), Highest(1)]);
}

test "a heap of a derived Ordered orders by the fields in declaration order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let jobs = [
        Job { priority: 2, name: "b" },
        Job { priority: 1, name: "z" },
        Job { priority: 2, name: "a" },
        Job { priority: 1, name: "a" },
    ];
    let h = heap.of(ctx, jobs);
    assert.equal(assert.some(h.peek()), Job { priority: 1, name: "a" });
    assert.equal(h.toSortedList(ctx), [
        Job { priority: 1, name: "a" },
        Job { priority: 1, name: "z" },
        Job { priority: 2, name: "a" },
        Job { priority: 2, name: "b" },
    ]);
}

// Two elements the order calls equal are two elements, not one — which is the
// difference from an `OrderedSet` and the reason a heap exists.
test "a heap keeps elements a custom Ordered calls equal" {
    let ctx = context {
        Allocator: alloc(),
    };
    let h = heap.of(ctx, [Highest(5), Highest(5), Highest(5)]);
    assert.equal(h.length(), 3);
    assert.equal(h.toSortedList(ctx).len(), 3);
    let (_first, rest) = assert.some(h.pop(ctx));
    assert.equal(rest.length(), 2);
}

// --- The sizes ----------------------------------------------------------------------

test "a heap of one, through every verb it has" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = heap.of(ctx, [7]);
    assert.equal(one.length(), 1);
    assert.isFalse(one.isEmpty());
    assert.equal(assert.some(one.peek()), 7);
    assert.equal(one.toSortedList(ctx), [7]);
    let (only, rest) = assert.some(one.pop(ctx));
    assert.equal(only, 7);
    assert.isTrue(rest.isEmpty());
    assert.isTrue(rest.peek().isNone());
    // Merging one with nothing, either way round.
    assert.equal(one.merge(ctx, heap.empty<Int>()).toSortedList(ctx), [7]);
    assert.equal(heap.empty<Int>().merge(ctx, one).toSortedList(ctx), [7]);
    assert.equal(one.push(ctx, 3).toSortedList(ctx), [3, 7]);
}

test "merging two empty heaps is empty, and merging is not destructive" {
    let ctx = context {
        Allocator: alloc(),
    };
    let none = heap.empty<Int>();
    assert.isTrue(none.merge(ctx, none).isEmpty());
    let a = heap.of(ctx, [1, 3]);
    let b = heap.of(ctx, [2, 4]);
    assert.equal(a.merge(ctx, b).toSortedList(ctx), [1, 2, 3, 4]);
    // Both sides are still what they were.
    assert.equal(a.toSortedList(ctx), [1, 3]);
    assert.equal(b.toSortedList(ctx), [2, 4]);
    // And the same merge the other way round is the same heap.
    assert.equal(b.merge(ctx, a).toSortedList(ctx), [1, 2, 3, 4]);
}

// A run of merges rather than a run of pushes: the other way a pairing heap can
// end up with a long spine.
test "a thousand elements arriving as merged heaps still drain in order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let scattered = list.range(ctx, 0, 1000).map(ctx, fn(i) => i * 7919 % 1000);
    let merged = scattered
        .chunks(ctx, 8)
        .foldCtx(
            ctx,
            fn(c, acc: Heap<Int>, piece) => acc.merge(c, heap.of(c, piece)),
            heap.empty<Int>(),
        );
    assert.equal(merged.length(), 1000);
    assert.equal(merged.toSortedList(ctx), scattered.sort(ctx));
}
