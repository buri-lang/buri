// core/set and core/orderedset — the operations added beside union, intersect and
// difference, and the two free functions that dedupe a list.
//
// The cost claims are the point of the large cases here. `isDisjointFrom`
// answers without building the intersection and `distinct` is O(n) where
// `core/list`'s `uniqueBy` is O(n²); nothing in the language can count either
// (see this package's `lib.buri`), so each is pinned against the naive
// computation it replaces, over an input big enough that the two would part
// company.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/order" import * as order;
from "core/orderedset" import * as orderedset;
from "core/set" import * as set;
from "core/testing/assert" import * as assert;

// --- symmetricDifference -------------------------------------------------------

test "symmetricDifference is the members in exactly one side" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2, 3]);
    let b = set.of(ctx, [3, 4]);
    assert.eq(a.symmetricDifference(ctx, b).toList(ctx).sort(ctx), [1, 2, 4]);
    // Symmetric, which is the whole name.
    assert.eq(b.symmetricDifference(ctx, a).toList(ctx).sort(ctx), [1, 2, 4]);
}

test "symmetricDifference with nothing, and with itself" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2]);
    assert.isTrue(a.symmetricDifference(ctx, set.empty<Int>()).equals(ctx, a));
    assert.isTrue(a.symmetricDifference(ctx, a).isEmpty());
    assert.isTrue(
        set.empty<Int>().symmetricDifference(ctx, set.empty<Int>()).isEmpty(),
    );
}

test "an ordered symmetricDifference comes out in order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = orderedset.of(ctx, [1, 2, 3]);
    let b = orderedset.of(ctx, [3, 4]);
    assert.eq(a.symmetricDifference(ctx, b).toList(ctx), [1, 2, 4]);
    assert.isTrue(a.symmetricDifference(ctx, a).isEmpty());
}

// --- isDisjointFrom ------------------------------------------------------------

test "isDisjointFrom is true when nothing is shared" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2, 3]);
    assert.isTrue(a.isDisjointFrom(ctx, set.of(ctx, [4, 5])));
    assert.isFalse(a.isDisjointFrom(ctx, set.of(ctx, [3, 4])));
    // The empty set shares nothing with anything, itself included.
    assert.isTrue(a.isDisjointFrom(ctx, set.empty<Int>()));
    assert.isTrue(set.empty<Int>().isDisjointFrom(ctx, a));
    assert.isTrue(set.empty<Int>().isDisjointFrom(ctx, set.empty<Int>()));
    // A set is never disjoint from itself unless it is empty.
    assert.isFalse(a.isDisjointFrom(ctx, a));
}

// The claim is that this answers without building the intersection. What a test
// can see is the answer, so the answer is checked against the set that was not
// built — over sets big enough to have gone through the walk and the
// short-circuit both, and with the shared member at each end of the range so
// neither an early stop nor a late one is what makes it pass.
test "isDisjointFrom agrees with the intersection it does not build" {
    let ctx = context {
        Allocator: alloc(),
    };
    let low = set.of(ctx, list.range(ctx, 0, 400));
    let high = set.of(ctx, list.range(ctx, 400, 800));
    assert.isTrue(low.isDisjointFrom(ctx, high));
    assert.isTrue(low.intersect(ctx, high).isEmpty());
    // One member in common, at the bottom of one side and the top of the other.
    let overlapping = set.of(ctx, list.range(ctx, 399, 800));
    assert.isFalse(low.isDisjointFrom(ctx, overlapping));
    assert.isFalse(low.intersect(ctx, overlapping).isEmpty());
    // And with the sides swapped, which is the branch that walks the other one.
    assert.isFalse(overlapping.isDisjointFrom(ctx, low));
    assert.isTrue(high.isDisjointFrom(ctx, set.of(ctx, list.range(ctx, 0, 400))));
}

test "an ordered set is disjoint on the same terms" {
    let ctx = context {
        Allocator: alloc(),
    };
    let low = orderedset.of(ctx, list.range(ctx, 0, 200));
    let high = orderedset.of(ctx, list.range(ctx, 200, 400));
    assert.isTrue(low.isDisjointFrom(ctx, high));
    assert.isTrue(low.intersect(ctx, high).isEmpty());
    assert.isFalse(low.isDisjointFrom(ctx, orderedset.of(ctx, [199, 500])));
    assert.isTrue(low.isDisjointFrom(ctx, orderedset.empty<Int>()));
}

// --- isSupersetOf --------------------------------------------------------------

test "isSupersetOf is isSubsetOf read from the other end" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2, 3]);
    let b = set.of(ctx, [1, 2]);
    assert.isTrue(a.isSupersetOf(ctx, b));
    assert.isFalse(b.isSupersetOf(ctx, a));
    // Every set holds itself and the empty one.
    assert.isTrue(a.isSupersetOf(ctx, a));
    assert.isTrue(a.isSupersetOf(ctx, set.empty<Int>()));
    assert.isFalse(set.empty<Int>().isSupersetOf(ctx, a));
}

test "an ordered set is a superset on the same terms" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = orderedset.of(ctx, [1, 2, 3]);
    assert.isTrue(a.isSupersetOf(ctx, orderedset.of(ctx, [3, 1])));
    assert.isFalse(a.isSupersetOf(ctx, orderedset.of(ctx, [3, 4])));
    assert.isTrue(a.isSupersetOf(ctx, orderedset.empty<Int>()));
}

// --- filter --------------------------------------------------------------------

test "filter keeps what the predicate keeps" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = set.of(ctx, list.range(ctx, 0, 10));
    let evens = s.filter(ctx, fn(x) => x % 2 == 0);
    assert.eq(evens.toList(ctx).sort(ctx), [0, 2, 4, 6, 8]);
    assert.isTrue(s.filter(ctx, fn(_x) => false).isEmpty());
    assert.isTrue(s.filter(ctx, fn(_x) => true).equals(ctx, s));
    assert.isTrue(set.empty<Int>().filter(ctx, fn(_x) => true).isEmpty());
}

test "an ordered filter comes out in order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = orderedset.of(ctx, list.range(ctx, 0, 10));
    assert.eq(s.filter(ctx, fn(x) => x % 3 == 0).toList(ctx), [0, 3, 6, 9]);
    assert.isTrue(s.filter(ctx, fn(_x) => false).isEmpty());
    assert.isTrue(orderedset.empty<Int>().filter(ctx, fn(_x) => true).isEmpty());
}

// --- floor / ceiling on an ordered set -------------------------------------------

test "floor and ceiling answer the nearest member on each side" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = orderedset.of(ctx, [10, 20, 30]);
    assert.eq(assert.some(s.floor(25)), 20);
    assert.eq(assert.some(s.ceiling(25)), 30);
    // A member is its own floor and its own ceiling.
    assert.eq(assert.some(s.floor(20)), 20);
    assert.eq(assert.some(s.ceiling(20)), 20);
    assert.isTrue(s.floor(9).isNone());
    assert.isTrue(s.ceiling(31).isNone());
    assert.isTrue(orderedset.empty<Int>().floor(0).isNone());
    assert.isTrue(orderedset.empty<Int>().ceiling(0).isNone());
}

test "floor and ceiling hold over a set deep enough to have split" {
    let ctx = context {
        Allocator: alloc(),
    };
    let evens = list.range(ctx, 0, 200).map(ctx, fn(i) => i * 2);
    let s = orderedset.of(ctx, evens);
    let probes = list.range(ctx, 0, 398);
    assert.isTrue(probes.all(fn(p) => s.floor(p) == .Some(p - p % 2)));
    assert.isTrue(probes.all(fn(p) => s.ceiling(p) == .Some(p + p % 2)));
}

// --- distinct / distinctBy --------------------------------------------------------

test "distinct keeps the first of each and leaves the order alone" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(set.distinct(ctx, ["ana", "bo", "ana", "cy", "bo"]), ["ana", "bo", "cy"]);
    assert.eq(set.distinct(ctx, list.empty<Int>()), []);
    assert.eq(set.distinct(ctx, [1]), [1]);
    // Everything the same collapses to one, and nothing the same stays put.
    assert.eq(set.distinct(ctx, [7, 7, 7]), [7]);
    assert.eq(set.distinct(ctx, [3, 1, 2]), [3, 1, 2]);
}

test "distinctBy keeps the first element answering each key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let words = ["ant", "ape", "bee", "bat", "cow"];
    assert.eq(set.distinctBy(ctx, words, fn(w: Str) => w.slice(0, 1)), [
        "ant",
        "bee",
        "cow",
    ]);
    assert.eq(set.distinctBy(ctx, list.empty<Int>(), fn(n: Int) => n), []);
    // One key for everything answers one element.
    assert.eq(set.distinctBy(ctx, [1, 2, 3], fn(_n: Int) => 0), [1]);
}

test "an ordered distinct answers the same list" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(orderedset.distinct(ctx, [3, 1, 3, 2, 1]), [3, 1, 2]);
    assert.eq(orderedset.distinct(ctx, list.empty<Int>()), []);
    let words = ["ant", "ape", "bee", "bat"];
    assert.eq(orderedset.distinctBy(ctx, words, fn(w: Str) => w.slice(0, 1)), [
        "ant",
        "bee",
    ]);
    assert.eq(orderedset.distinctBy(ctx, list.empty<Int>(), fn(n: Int) => n), []);
}

// `uniqueBy` is the O(n²) answer and this is the O(n) one, so they must agree
// element for element. Two thousand elements with nineteen hundred duplicates
// is where the two costs part company, and where an implementation that lost
// the first-seen order would show it.
test "distinct agrees with uniqueBy over two thousand elements" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = list.range(ctx, 0, 2000).map(ctx, fn(i) => i * 7 % 100);
    let byHash = set.distinct(ctx, xs);
    let byComparison = xs.uniqueBy(ctx, fn(a: Int, b: Int) => order.int(a, b));
    assert.eq(byHash, byComparison);
    assert.eq(byHash.len(), 100);
    // And the ordered one is the third way to the same list.
    assert.eq(orderedset.distinct(ctx, xs), byComparison);
}

test "distinctBy agrees with uniqueBy over a key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = list.range(ctx, 0, 2000);
    let key = fn(n: Int) => n % 137;
    let byHash = set.distinctBy(ctx, xs, key);
    let byComparison = xs.uniqueBy(
        ctx,
        order.by(key, fn(a: Int, b: Int) => order.int(a, b)),
    );
    assert.eq(byHash, byComparison);
    assert.eq(byHash.len(), 137);
    assert.eq(orderedset.distinctBy(ctx, xs, key), byComparison);
}

// --- The empty set, on both sides of every relation ---------------------------------

// Nothing is shared with the empty set, everything contains it, and it contains
// only itself. Each of the four is the negative twin of a case above.
test "the empty set on both sides of isDisjointFrom and isSupersetOf" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = set.of(ctx, [1, 2]);
    let none = set.empty<Int>();
    assert.isTrue(a.isDisjointFrom(ctx, none));
    assert.isTrue(none.isDisjointFrom(ctx, a));
    assert.isTrue(none.isDisjointFrom(ctx, none));
    assert.isTrue(a.isSupersetOf(ctx, none));
    assert.isFalse(none.isSupersetOf(ctx, a));
    assert.isTrue(none.isSupersetOf(ctx, none));
    // A set is a superset of itself and is not disjoint from itself.
    assert.isTrue(a.isSupersetOf(ctx, a));
    assert.isFalse(a.isDisjointFrom(ctx, a));
    // One member each, sharing it or not.
    assert.isTrue(set.of(ctx, [1]).isDisjointFrom(ctx, set.of(ctx, [2])));
    assert.isFalse(set.of(ctx, [1]).isDisjointFrom(ctx, set.of(ctx, [1])));
}

test "the empty ordered set on both sides of the same two" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = orderedset.of(ctx, [1, 2]);
    let none = orderedset.empty<Int>();
    assert.isTrue(a.isDisjointFrom(ctx, none));
    assert.isTrue(none.isDisjointFrom(ctx, a));
    assert.isTrue(a.isSupersetOf(ctx, none));
    assert.isFalse(none.isSupersetOf(ctx, a));
    assert.isTrue(a.isSupersetOf(ctx, a));
    assert.isTrue(none.symmetricDifference(ctx, a).equals(ctx, a));
    assert.isTrue(none.symmetricDifference(ctx, none).isEmpty());
}

test "filter on a set of one, on the empty set, and over a large one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = set.of(ctx, [1]);
    assert.isTrue(one.filter(ctx, fn(_x) => true).equals(ctx, one));
    assert.isTrue(one.filter(ctx, fn(_x) => false).isEmpty());
    assert.isTrue(set.empty<Int>().filter(ctx, fn(_x) => true).isEmpty());
    let big = set.of(ctx, list.range(ctx, 0, 300));
    assert.eq(big.filter(ctx, fn(x) => x % 3 == 0).len(), 100);
    // The ordered one keeps its order through a filter.
    let ordered = orderedset.of(ctx, list.range(ctx, 0, 300));
    assert.eq(ordered.filter(ctx, fn(x) => x % 100 == 0).toList(ctx), [0, 100, 200]);
    assert.isTrue(orderedset.of(ctx, [1]).filter(ctx, fn(_x) => false).isEmpty());
}

// A superset relation that only just holds and only just fails, over a set big
// enough that a wrong answer could not be a coincidence.
test "isSupersetOf and isDisjointFrom at the boundary over three hundred members" {
    let ctx = context {
        Allocator: alloc(),
    };
    let all = set.of(ctx, list.range(ctx, 0, 300));
    let most = set.of(ctx, list.range(ctx, 0, 299));
    assert.isTrue(all.isSupersetOf(ctx, most));
    assert.isFalse(most.isSupersetOf(ctx, all));
    // One member outside is enough to break it.
    let strayed = set.of(ctx, list.range(ctx, 0, 299)).insert(ctx, 1000);
    assert.isFalse(all.isSupersetOf(ctx, strayed));
    // Disjoint until one member is shared.
    let above = set.of(ctx, list.range(ctx, 300, 600));
    assert.isTrue(all.isDisjointFrom(ctx, above));
    assert.isFalse(all.isDisjointFrom(ctx, above.insert(ctx, 299)));
}

// `symmetricDifference` on one member each, which is where a set that dropped
// the right-hand side would still look right on the sizes above.
test "symmetricDifference over singletons and over three hundred members" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(
        set
            .of(ctx, [1])
            .symmetricDifference(ctx, set.of(ctx, [2]))
            .toList(ctx)
            .sort(ctx),
        [1, 2],
    );
    assert.isTrue(
        set.of(ctx, [1]).symmetricDifference(ctx, set.of(ctx, [1])).isEmpty(),
    );
    let low = set.of(ctx, list.range(ctx, 0, 300));
    let high = set.of(ctx, list.range(ctx, 150, 450));
    let only = low.symmetricDifference(ctx, high);
    assert.eq(only.len(), 300);
    assert.isTrue(only.has(0));
    assert.isFalse(only.has(200));
    assert.isTrue(only.has(449));
    // Which is the union without the intersection, the other way to the answer.
    let byHand = low.union(ctx, high).difference(ctx, low.intersect(ctx, high));
    assert.isTrue(only.equals(ctx, byHand));
}

test "distinct and distinctBy over a list of one and a list of the same thing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.eq(set.distinct(ctx, ["only"]), ["only"]);
    assert.eq(set.distinctBy(ctx, ["only"], fn(w: Str) => w.len()), ["only"]);
    assert.eq(orderedset.distinct(ctx, ["only"]), ["only"]);
    assert.eq(orderedset.distinctBy(ctx, ["only"], fn(w: Str) => w.len()), ["only"]);
    // A thousand copies of one element is one element, through all four.
    let same = list.repeat(ctx, 7, 1000);
    assert.eq(set.distinct(ctx, same), [7]);
    assert.eq(orderedset.distinct(ctx, same), [7]);
    assert.eq(set.distinctBy(ctx, same, fn(n: Int) => n), [7]);
    assert.eq(orderedset.distinctBy(ctx, same, fn(n: Int) => n), [7]);
}
