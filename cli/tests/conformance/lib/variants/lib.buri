// //lib/variants — how an `Option` or a `Result` of any payload compares.
//
// `Equal` on an `Option` or a `Result` is derived, so each payload type gets
// its own comparison. A test that compares its own `Option`s or `Result`s
// passes a payload here to pin that each variant equals itself and not the
// other, for that payload.

/// Whether `.Some(x)` and `.None` each equal themselves and not each other.
export fn optionsCompare<T: Equal>(x: T): Bool {
    let some: Option<T> = .Some(x);
    let none: Option<T> = .None;
    [some == some, none == none, some == none, none == some]
        == [true, true, false, false]
}

/// Whether `.Ok(ok)` and `.Err(err)` each equal themselves and not each other.
export fn resultsCompare<T: Equal, E: Equal>(ok: T, err: E): Bool {
    let good: Result<T, E> = .Ok(ok);
    let bad: Result<T, E> = .Err(err);
    [good == good, bad == bad, good == bad, bad == good] == [true, true, false, false]
}
