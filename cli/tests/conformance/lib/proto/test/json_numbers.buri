// The numbers proto3 JSON spells its own way: NaN and the infinities as
// strings, and the 64-bit integers as decimal strings exact to the last digit,
// across the whole of each type's range.
//
// Each case here is one the protobuf conformance runner sends. A `uint64` or
// `fixed64` holds its value's bits in an `Int`, so one past 2^63 - 1 is a
// negative `Int` in Buri and a large decimal in the document.

from "core/json" import * as json;
from "core/json" import { Json };
from "core/math" import * as math;
from "core/proto" import { ProtoError };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/proto" import {
    decodeEverythingJson, defaultEverything, encodeEverythingJson, Everything,
};

let MIN: Int = -9223372036854775807 - 1;

let MAX: Int = 9223372036854775807;

fn text<C: Allocator>(ctx: C, v: Everything): Str {
    json.stringify(ctx, encodeEverythingJson(ctx, v))
}

fn read<C: Allocator>(ctx: C, source: Str): Result<Everything, ProtoError> {
    match (json.parse(ctx, source)) {
        .Ok(d) => decodeEverythingJson(ctx, d),
        .Err(_e) => .Err(.BadJson { path: "", wanted: "JSON" }),
    }
}

fn outOfRange(path: Str): Result<Everything, ProtoError> {
    .Err(.BadJson { path: path, wanted: "an integer in range" })
}

// --- NaN and the infinities ----------------------------------------------------

test "NaN and the infinities are written as strings" {
    let ctx = context {
        Allocator: alloc(),
    };
    let nan = 0.0 / 0.0;
    let inf = 1.0 / 0.0;
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), ratio: .Some(nan) }),
        "{\"ratio\":\"NaN\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), ratio: .Some(inf) }),
        "{\"ratio\":\"Infinity\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), ratio: .Some(0.0 - inf) }),
        "{\"ratio\":\"-Infinity\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), rough: .Some(nan) }),
        "{\"rough\":\"NaN\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), rough: .Some(0.0 - inf) }),
        "{\"rough\":\"-Infinity\"}",
    );
}

test "NaN and the infinities are read from their strings and only from them" {
    let ctx = context {
        Allocator: alloc(),
    };
    let nan = match (read(ctx, "{\"ratio\":\"NaN\"}")) {
        .Ok(v) => v.ratio.map(fn(x) => math.isNan(x)),
        .Err(_e) => .None,
    };
    assert.equal(nan, .Some(true));
    let roughNan = match (read(ctx, "{\"rough\":\"NaN\"}")) {
        .Ok(v) => v.rough.map(fn(x) => math.isNan(x)),
        .Err(_e) => .None,
    };
    assert.equal(roughNan, .Some(true));
    assert.equal(
        read(ctx, "{\"ratio\":\"-Infinity\"}"),
        .Ok(Everything { ..defaultEverything(), ratio: .Some(0.0 - 1.0 / 0.0) }),
    );
    assert.equal(
        read(ctx, "{\"rough\":\"Infinity\"}"),
        .Ok(Everything { ..defaultEverything(), rough: .Some(1.0 / 0.0) }),
    );
    // A finite number past a float's range is an error, not an infinity.
    assert.equal(
        read(ctx, "{\"rough\":3.502823e+38}"),
        .Err(.BadJson { path: "$.rough", wanted: "a number a float can hold" }),
    );
}

// --- int64 ----------------------------------------------------------------------

test "an int64 is exact at both ends of its range" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), total: .Some(MAX) }),
        "{\"total\":\"9223372036854775807\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), total: .Some(MIN) }),
        "{\"total\":\"-9223372036854775808\"}",
    );
    assert.equal(
        read(ctx, "{\"total\":\"9223372036854775807\"}"),
        .Ok(Everything { ..defaultEverything(), total: .Some(MAX) }),
    );
    assert.equal(
        read(ctx, "{\"total\":\"-9223372036854775808\"}"),
        .Ok(Everything { ..defaultEverything(), total: .Some(MIN) }),
    );
    assert.equal(
        read(ctx, "{\"total\":\"9223372036854775806\"}"),
        .Ok(Everything { ..defaultEverything(), total: .Some(MAX - 1) }),
    );
    // Unquoted, as exact as a double is.
    assert.equal(
        read(ctx, "{\"total\":9223372036854774784}"),
        .Ok(Everything { ..defaultEverything(), total: .Some(9223372036854774784) }),
    );
    assert.equal(
        read(ctx, "{\"total\":-9223372036854775808}"),
        .Ok(Everything { ..defaultEverything(), total: .Some(MIN) }),
    );
}

test "an int64 one past either end is refused, not rounded" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"total\":\"9223372036854775808\"}"),
        outOfRange("$.total"),
    );
    assert.equal(
        read(ctx, "{\"total\":\"-9223372036854775809\"}"),
        outOfRange("$.total"),
    );
    assert.equal(
        read(ctx, "{\"signedBig\":\"-9223372036854775809\"}"),
        outOfRange("$.signedBig"),
    );
    assert.equal(
        read(ctx, "{\"offset\":\"9223372036854775808\"}"),
        outOfRange("$.offset"),
    );
    assert.equal(
        read(ctx, "{\"total\":\"18446744073709551615\"}"),
        outOfRange("$.total"),
    );
}

// --- uint64 and fixed64 ------------------------------------------------------------

test "a uint64 past 2^63 is written as its unsigned decimal" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), large: .Some(MAX) }),
        "{\"large\":\"9223372036854775807\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), large: .Some(MIN) }),
        "{\"large\":\"9223372036854775808\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), large: .Some(-1) }),
        "{\"large\":\"18446744073709551615\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), large: .Some(-2) }),
        "{\"large\":\"18446744073709551614\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), serial: .Some(-10) }),
        "{\"serial\":\"18446744073709551606\"}",
    );
    assert.equal(
        text(ctx, Everything { ..defaultEverything(), serial: .Some(-1) }),
        "{\"serial\":\"18446744073709551615\"}",
    );
}

test "a uint64 reads its whole range back to the same bits" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"large\":\"18446744073709551615\"}"),
        .Ok(Everything { ..defaultEverything(), large: .Some(-1) }),
    );
    assert.equal(
        read(ctx, "{\"large\":\"9223372036854775808\"}"),
        .Ok(Everything { ..defaultEverything(), large: .Some(MIN) }),
    );
    assert.equal(
        read(ctx, "{\"large\":\"9223372036854775807\"}"),
        .Ok(Everything { ..defaultEverything(), large: .Some(MAX) }),
    );
    assert.equal(
        read(ctx, "{\"serial\":\"18446744073709551606\"}"),
        .Ok(Everything { ..defaultEverything(), serial: .Some(-10) }),
    );
    // Unquoted, as exact as a double is: 2^64 - 2048.
    assert.equal(
        read(ctx, "{\"large\":18446744073709549568}"),
        .Ok(Everything { ..defaultEverything(), large: .Some(-2048) }),
    );
    let v = Everything { ..defaultEverything(), large: .Some(-7), serial: .Some(MIN) };
    assert.equal(decodeEverythingJson(ctx, encodeEverythingJson(ctx, v)), .Ok(v));
}

test "a uint64 past 2^64 - 1 or below zero is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"large\":\"18446744073709551616\"}"),
        outOfRange("$.large"),
    );
    assert.equal(
        read(ctx, "{\"serial\":\"18446744073709551616\"}"),
        outOfRange("$.serial"),
    );
    assert.equal(read(ctx, "{\"large\":\"-1\"}"), outOfRange("$.large"));
    assert.equal(read(ctx, "{\"large\":\"1e536870000\"}"), outOfRange("$.large"));
}
