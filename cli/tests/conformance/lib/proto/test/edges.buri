// The edges of the wire format and of proto3 JSON: the widest tags and
// varints, each well-known type's own fields arriving with the wrong wire type,
// and the numbers, instants and spans JSON can spell but a field cannot hold.

from "core/bytes" import * as bytes;
from "core/json" import * as json;
from "core/list" import * as list;
from "core/proto" import { ProtoError };
from "core/proto/any" import * as any;
from "core/proto/any" import { Any };
from "core/proto/duration" import * as duration;
from "core/proto/duration" import { Duration };
from "core/proto/field_mask" import * as field_mask;
from "core/proto/field_mask" import { FieldMask };
from "core/proto/struct" import * as structs;
from "core/proto/struct" import { ListValue, Value, Value_Kind };
from "core/proto/timestamp" import * as timestamp;
from "core/proto/timestamp" import { Timestamp };
from "core/proto/wrappers" import * as wrappers;
from "core/proto/wrappers" import {
    BoolValue, BytesValue, DoubleValue, FloatValue, Int32Value, Int64Value, StringValue,
    UInt32Value, UInt64Value,
};
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/proto" import {
    decodeEverything, decodeEverythingJson, decodeKnownJson, defaultEverything,
    defaultKnown, encodeKnownJson, Everything, Known,
};

fn raw<C: Allocator>(ctx: C, text: Str): [U8] {
    match (bytes.fromHex(ctx, text)) {
        .Ok(b) => b,
        .Err(_e) => list.empty<U8>(),
    }
}

// --- tags and varints ---------------------------------------------------------------

test "a tag wider than 32 bits is no field number, however it is spelt" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Six bytes is past the five a `uint32` takes...
    assert.equal(
        decodeEverything(ctx, raw(ctx, "888080808000")),
        .Err(.BadFieldNumber(0)),
    );
    // ...and five bytes can still carry more than 32 bits.
    assert.equal(
        decodeEverything(ctx, raw(ctx, "ffffffff1f")),
        .Err(.BadFieldNumber(0)),
    );
    // The widest tag that fits is field 536870911, which this message skips.
    assert.equal(
        decodeEverything(ctx, raw(ctx, "f8ffffff0f00")),
        .Ok(defaultEverything()),
    );
}

test "the wire types after a group's are refused too" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        decodeEverything(ctx, raw(ctx, "0c")),
        .Err(.BadWireType { field: 1, wire: 4 }),
    );
    assert.equal(
        decodeEverything(ctx, raw(ctx, "0e")),
        .Err(.BadWireType { field: 1, wire: 6 }),
    );
    assert.equal(
        decodeEverything(ctx, raw(ctx, "0f")),
        .Err(.BadWireType { field: 1, wire: 7 }),
    );
}

test "a varint of eleven bytes is truncated even with bytes after it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        decodeEverything(ctx, raw(ctx, "10ffffffffffffffffffff0100")),
        .Err(.Truncated(1)),
    );
}

test "a negative length is truncated rather than read backwards" {
    let ctx = context {
        Allocator: alloc(),
    };
    // field 1, wire 2, and a length of -1 in ten bytes.
    assert.equal(
        decodeEverything(ctx, raw(ctx, "0affffffffffffffffff01")),
        .Err(.Truncated(1)),
    );
}

// --- well-known types on the wire ----------------------------------------------------

// Each case is the type's own field, then that field again with another wire
// type, then a field the type does not have. The two after the first are
// skipped, so the value is the first one's.

test "every wrapper reads its value, and skips what is not its value" {
    let ctx = context {
        Allocator: alloc(),
    };
    let tail = "0d000000001007";
    assert.equal(
        wrappers.decodeDoubleValue(ctx, raw(ctx, "09000000000000f83f08051007")),
        .Ok(DoubleValue { value: 1.5 }),
    );
    assert.equal(
        wrappers.decodeFloatValue(ctx, raw(ctx, "0d0000c03f08051007")),
        .Ok(FloatValue { value: 1.5 }),
    );
    assert.equal(
        wrappers.decodeInt64Value(ctx, raw(ctx, "082a".concat(ctx, tail))),
        .Ok(Int64Value { value: 42 }),
    );
    assert.equal(
        wrappers.decodeUInt64Value(ctx, raw(ctx, "082a".concat(ctx, tail))),
        .Ok(UInt64Value { value: 42 }),
    );
    assert.equal(
        wrappers.decodeInt32Value(ctx, raw(ctx, "082a".concat(ctx, tail))),
        .Ok(Int32Value { value: 42 }),
    );
    assert.equal(
        wrappers.decodeUInt32Value(ctx, raw(ctx, "082a".concat(ctx, tail))),
        .Ok(UInt32Value { value: 42 }),
    );
    assert.equal(
        wrappers.decodeBoolValue(ctx, raw(ctx, "0801".concat(ctx, tail))),
        .Ok(BoolValue { value: true }),
    );
    assert.equal(
        wrappers.decodeStringValue(ctx, raw(ctx, "0a02686908051007")),
        .Ok(StringValue { value: "hi" }),
    );
    assert.equal(
        wrappers.decodeBytesValue(ctx, raw(ctx, "0a02010208051007")),
        .Ok(BytesValue { value: [1.wrapToU8(), 2.wrapToU8()] }),
    );
}

test "a Duration, a Timestamp, an Any and a FieldMask skip what is not theirs" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        duration.decodeDuration(ctx, raw(ctx, "080510070a0012001801")),
        .Ok(Duration { seconds: 5, nanos: 7 }),
    );
    assert.equal(
        timestamp.decodeTimestamp(ctx, raw(ctx, "080510070a0012001801")),
        .Ok(Timestamp { seconds: 5, nanos: 7 }),
    );
    assert.equal(
        any.decodeAny(ctx, raw(ctx, "0a0161120102080110011801")),
        .Ok(Any { typeUrl: "a", value: [2.wrapToU8()] }),
    );
    assert.equal(
        field_mask.decodeFieldMask(ctx, raw(ctx, "0a016108011001")),
        .Ok(FieldMask { paths: ["a"] }),
    );
}

test "a FieldMask that stops short is truncated wherever it stops" {
    let ctx = context {
        Allocator: alloc(),
    };
    // In a tag, in a path's length-prefixed text, and in a field it skips.
    assert.equal(field_mask.decodeFieldMask(ctx, raw(ctx, "80")), .Err(.Truncated(0)));
    assert.equal(
        field_mask.decodeFieldMask(ctx, raw(ctx, "0a05")),
        .Err(.Truncated(1)),
    );
    assert.equal(
        field_mask.decodeFieldMask(ctx, raw(ctx, "0880")),
        .Err(.Truncated(1)),
    );
}

test "a Value, a Struct and a ListValue skip what is not theirs" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Every one of Value's six fields with the wrong wire type, then an empty
    // list, then a field it does not have.
    assert.equal(
        structs.decodeValue(ctx, raw(ctx, "0a001000180022002800300032003801")),
        .Ok(Value { kind: .Some(Value_Kind.ListValue(ListValue { values: [] })) }),
    );
    // An entry whose key and value each arrive once with the wrong wire type.
    let s = assert.ok(
        structs.decodeStruct(ctx, raw(ctx, "080118010a0b0a01610801100112022001")),
    );
    assert.equal(
        json.stringify(ctx, assert.ok(structs.encodeStructJson(ctx, s))),
        "{\"a\":true}",
    );
    let l = assert.ok(structs.decodeListValue(ctx, raw(ctx, "080110010a022001")));
    assert.equal(
        json.stringify(ctx, assert.ok(structs.encodeListValueJson(ctx, l))),
        "[true]",
    );
}

// --- numbers in JSON -------------------------------------------------------------------

fn read<C: Allocator>(ctx: C, source: Str): Result<Everything, ProtoError> {
    match (json.parse(ctx, source)) {
        .Ok(d) => decodeEverythingJson(ctx, d),
        .Err(_e) => .Err(.BadJson { path: "", wanted: "JSON" }),
    }
}

fn bad(path: Str, wanted: Str): Result<Everything, ProtoError> {
    .Err(.BadJson { path: path, wanted: wanted })
}

test "an int32 refuses a fraction, and a whole number past either end of its range" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(read(ctx, "{\"count\":1.5}"), bad("$.count", "an integer"));
    assert.equal(read(ctx, "{\"count\":1e300}"), bad("$.count", "an integer in range"));
    assert.equal(
        read(ctx, "{\"count\":3000000000}"),
        bad("$.count", "an integer in range"),
    );
    assert.equal(
        read(ctx, "{\"count\":-3000000000}"),
        bad("$.count", "an integer in range"),
    );
    assert.equal(
        read(ctx, "{\"count\":-2147483648}"),
        .Ok(Everything { ..defaultEverything(), count: .Some(-2147483648) }),
    );
}

test "a uint64 written as a JSON number past 2^63 keeps its bits" {
    let ctx = context {
        Allocator: alloc(),
    };
    // 2^63 is the double 9223372036854775808, whose bits as an `Int` are the
    // smallest one.
    assert.equal(
        read(ctx, "{\"large\":9223372036854775808}"),
        .Ok(Everything {
            ..defaultEverything(),
            large: .Some(-9223372036854775807 - 1),
        }),
    );
    assert.equal(read(ctx, "{\"large\":1e20}"), bad("$.large", "an integer in range"));
}

test "a uint64 written as a string may be minus zero but nothing else below zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"large\":\"-0\"}"),
        .Ok(Everything { ..defaultEverything(), large: .Some(0) }),
    );
    assert.equal(
        read(ctx, "{\"large\":\"-5\"}"),
        bad("$.large", "an integer in range"),
    );
}

test "a float refuses a number past either end of single precision" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"rough\":1e39}"),
        bad("$.rough", "a number a float can hold"),
    );
    assert.equal(
        read(ctx, "{\"rough\":-1e39}"),
        bad("$.rough", "a number a float can hold"),
    );
}

test "a double refuses a number that overflows to an infinity" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"ratio\":\"1e400\"}"),
        bad("$.ratio", "a number a double can hold"),
    );
    assert.equal(
        read(ctx, "{\"ratio\":\"-1e400\"}"),
        bad("$.ratio", "a number a double can hold"),
    );
}

// --- durations and timestamps in JSON ------------------------------------------------

fn known<C: Allocator>(ctx: C, source: Str): Result<Known, ProtoError> {
    match (json.parse(ctx, source)) {
        .Ok(d) => decodeKnownJson(ctx, d),
        .Err(_e) => .Err(.BadJson { path: "", wanted: "JSON" }),
    }
}

fn instant<C: Allocator>(ctx: C, text: Str): Result<Known, ProtoError> {
    known(ctx, ["{\"timestamp\":\"", text, "\"}"].join(ctx, ""))
}

fn seconds(s: Int): Result<Known, ProtoError> {
    .Ok(Known {
        ..defaultKnown(),
        timestamp: .Some(Timestamp { seconds: s, nanos: 0 }),
    })
}

fn noInstant(): Result<Known, ProtoError> {
    .Err(.BadJson { path: "$.timestamp", wanted: "a timestamp" })
}

test "a Duration's whole and fractional parts are digits, and a dozen at most" {
    let ctx = context {
        Allocator: alloc(),
    };
    let no: Result<Known, ProtoError> = .Err(.BadJson {
        path: "$.duration",
        wanted: "a duration",
    });
    assert.equal(known(ctx, "{\"duration\":\".5s\"}"), no);
    assert.equal(known(ctx, "{\"duration\":\"1234567890123s\"}"), no);
    assert.equal(known(ctx, "{\"duration\":\"1a.5s\"}"), no);
    assert.equal(known(ctx, "{\"duration\":\"1.5xs\"}"), no);
}

test "a leap day is a day only in a leap year" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "1900-02-29T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2100-02-29T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2000-02-29T00:00:00Z"), seconds(951782400));
    assert.equal(instant(ctx, "2024-02-29T00:00:00Z"), seconds(1709164800));
}

test "the thirty-day months end on the thirtieth" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "2021-04-31T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-06-31T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-09-31T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-11-31T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-11-30T00:00:00Z"), seconds(1638230400));
    assert.equal(instant(ctx, "2021-12-31T00:00:00Z"), seconds(1640908800));
}

test "a timestamp's fields are each within their range" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "2021-00-01T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-13-01T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-00T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T24:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T00:60:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T00:00:60Z"), noInstant());
    assert.equal(instant(ctx, "2021-0a-01T00:00:00Z"), noInstant());
}

test "a timestamp's separators are where RFC 3339 puts them" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "2021-01/01T00:00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T00-00:00Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T00:00-00Z"), noInstant());
}

test "a timestamp's fraction is one to nine digits" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "2021-01-01T00:00:00.Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T00:00:00.0000000001Z"), noInstant());
    // A fraction that runs to the end leaves no zone, and a zone is required.
    assert.equal(instant(ctx, "2021-01-01T00:00:00.123"), noInstant());
}

test "an offset is hours to 23 and minutes to 59, after a sign and before a colon" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "1970-01-01T00:00:00+01-00"), noInstant());
    assert.equal(instant(ctx, "1970-01-01T00:00:00+24:00"), noInstant());
    assert.equal(instant(ctx, "1970-01-01T00:00:00+01:60"), noInstant());
    assert.equal(instant(ctx, "1970-01-01T00:00:00*01:00"), noInstant());
    assert.equal(instant(ctx, "1970-01-01T00:00:00+0a:00"), noInstant());
    assert.equal(instant(ctx, "1970-01-01T00:00:00+23:59"), seconds(-86340));
}

test "an offset cannot carry an instant past either end of the years 1 to 9999" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "0001-01-01T00:00:00+00:01"), noInstant());
    assert.equal(instant(ctx, "9999-12-31T23:59:59-00:01"), noInstant());
}

test "a timestamp with a letter that is not ASCII where a digit belongs is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(instant(ctx, "202é-01-01T00:00:00Z"), noInstant());
}

test "a timestamp and a field mask are each a JSON string and nothing else" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(known(ctx, "{\"timestamp\":5}"), noInstant());
    assert.equal(
        known(ctx, "{\"mask\":[\"a\"]}"),
        .Err(.BadJson { path: "$.mask", wanted: "a field mask" }),
    );
}

// --- field masks in JSON -----------------------------------------------------------------

test "a FieldMask path keeps a letter that is not ASCII, but not one after an underscore" {
    let ctx = context {
        Allocator: alloc(),
    };
    let ok = Known { ..defaultKnown(), mask: .Some(FieldMask { paths: ["Éa"] }) };
    assert.equal(
        encodeKnownJson(ctx, ok).mapCtx(ctx, fn(c, d) => json.stringify(c, d)),
        .Ok("{\"mask\":\"Éa\"}"),
    );
    let no = Known { ..defaultKnown(), mask: .Some(FieldMask { paths: ["a_é"] }) };
    assert.equal(
        encodeKnownJson(ctx, no).mapCtx(ctx, fn(c, d) => json.stringify(c, d)),
        .Err(.Unwritable {
            path: "$.mask",
            reason: "`a_é` has no lowerCamelCase form",
        }),
    );
}

// --- digits ------------------------------------------------------------------------------

test "a digit from another script is not a digit to proto3 JSON" {
    let ctx = context {
        Allocator: alloc(),
    };
    // ١ is U+0661, ARABIC-INDIC DIGIT ONE.
    assert.equal(instant(ctx, "2021-01-01T00:00:00.١Z"), noInstant());
    assert.equal(instant(ctx, "2021-01-01T00:00:0١Z"), noInstant());
    assert.equal(read(ctx, "{\"total\":\"١\"}"), bad("$.total", "an integer"));
    assert.equal(read(ctx, "{\"large\":\"١\"}"), bad("$.large", "an integer"));
    assert.equal(read(ctx, "{\"count\":\"١\"}"), bad("$.count", "an integer"));
    assert.equal(read(ctx, "{\"ratio\":\"١\"}"), bad("$.ratio", "a number"));
    let no: Result<Known, ProtoError> = .Err(.BadJson {
        path: "$.duration",
        wanted: "a duration",
    });
    assert.equal(known(ctx, "{\"duration\":\"١s\"}"), no);
}

test "a uint64 written as a small JSON number is that number" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        read(ctx, "{\"large\":5}"),
        .Ok(Everything { ..defaultEverything(), large: .Some(5) }),
    );
}
