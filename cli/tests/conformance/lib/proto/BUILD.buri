library {
    generators: [
        { tool: "proto", inputs: [
            "address.proto",
            "demo.proto",
            "maps.proto",
            "wellknown.proto",
            "wire.proto",
        ] },
    ]
    visibility: ["//visibility:public"]

    test {
        sources: [
            "test/binary.buri",
            "test/failures.buri",
            "test/json.buri",
            "test/json_numbers.buri",
            "test/maps.buri",
            "test/wellknown.buri",
            "test/wire.buri",
        ]

        # The reference run, on the reference backend: `native::conformance`
        # drives these same files through the stencil backend
        # (cli/tests/README.md).
        backends: [JS]
    }
}
