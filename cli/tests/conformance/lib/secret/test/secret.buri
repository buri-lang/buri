// core/secret — a value that shows as `***`.

from "core/bytes" import * as bytes;
from "core/crypto" import * as crypto;
from "core/env" import * as env;
from "core/secret" import * as secret;
from "core/secret" import { Secret };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Environment };
from "platform/effect/testing" import { alloc, env as testEnv };

derive Show for Login;
struct Login {
    user: Str,
    password: Secret<Str>,
}

derive Show for Credential;
enum Credential {
    Anonymous,
    Token(Secret<Str>),
    Basic { user: Str, password: Secret<Str> },
}

derive Show for Vault;
struct Vault {
    maybe: Option<Secret<Str>>,
    keys: [Secret<[U8]>],
}

test "a secret shows as stars, whatever it holds" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(secret.of("hunter2").show(ctx), "***");
    assert.equal(secret.of(42).show(ctx), "***");
    assert.equal(secret.of([1, 2, 3]).show(ctx), "***");
    assert.equal(secret.of("").show(ctx), "***");
}

test "a derived show keeps a secret field masked" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = secret.of("hunter2");
    assert.equal(
        Login { user: "ada", password: s }.show(ctx),
        "Login { user: \"ada\", password: *** }",
    );
    assert.equal(Credential.Token(s).show(ctx), ".Token(***)");
    assert.equal(
        Credential.Basic { user: "ada", password: s }.show(ctx),
        ".Basic { user: \"ada\", password: *** }",
    );
    assert.equal(Credential.Anonymous.show(ctx), ".Anonymous");
}

test "an option and a list of secrets stay masked" {
    let ctx = context {
        Allocator: alloc(),
    };
    let full = Vault {
        maybe: .Some(secret.of("x")),
        keys: [secret.of([1]), secret.of([])],
    };
    assert.equal(full.show(ctx), "Vault { maybe: .Some(***), keys: [***, ***] }");
    assert.equal(
        Vault { maybe: .None, keys: [] }.show(ctx),
        "Vault { maybe: .None, keys: [] }",
    );
}

test "reveal answers the value" {
    assert.equal(secret.of("hunter2").reveal(), "hunter2");
    assert.equal(secret.of(42).reveal(), 42);
    assert.equal(secret.of([1, 2]).reveal(), [1, 2]);
}

test "map changes the value and keeps it wrapped" {
    let ctx = context {
        Allocator: alloc(),
    };
    let length = secret.of("hunter2").map(fn(text) => text.length());
    assert.equal(length.show(ctx), "***");
    assert.equal(length.reveal(), 7);
}

test "mapCtx turns a secret string into secret bytes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let raw = secret.of("hi").mapCtx(ctx, fn(c, text) => bytes.toUtf8(c, text));
    assert.equal(raw.show(ctx), "***");
    assert.equal(raw.reveal(), [104, 105]);
}

// buri-lang/buri#226's example, against the environment double.

derive Show for Config;
struct Config {
    region: Str,
    apiKey: Secret<Str>,
}

fn load<C: Environment>(ctx: C): Option<Config> {
    .Some(Config { region: "eu-west-1", apiKey: env.get(ctx, "API_KEY")? })
}

fn authorization<C: Allocator>(ctx: C, config: Config): Str {
    str.format(ctx, "Bearer ${config.apiKey.reveal()}")
}

fn signed<C: Allocator + Environment>(ctx: C, body: [U8]): Option<Str> {
    let key = env
        .get(ctx, "SIGNING_KEY")?
        .mapCtx(ctx, fn(c, text) => bytes.toUtf8(c, text));
    let mac = crypto.hmacSha256(ctx, key, body);
    .Some(mac.toHex(ctx))
}

test "a config read from the environment shows its key masked" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("API_KEY", "s3cr3t")]),
    };
    let config = assert.some(load(ctx));
    assert.equal(config.show(ctx), "Config { region: \"eu-west-1\", apiKey: *** }");
    assert.equal(authorization(ctx, config), "Bearer s3cr3t");
}

test "a config with no key in the environment is not loaded" {
    let ctx = context {
        Environment: testEnv(),
    };
    assert.none(load(ctx));
}

test "a key goes from the environment to hmac without being revealed" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("SIGNING_KEY", "key")]),
    };
    let body = bytes.toUtf8(ctx, "The quick brown fox jumps over the lazy dog");
    assert.equal(
        assert.some(signed(ctx, body)),
        "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8",
    );
}
