// core/secret — a value that shows as `***`.

from "core/bytes" import * as bytes;
from "core/secret" import * as secret;
from "core/secret" import { Secret };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

derive Show for Login;
struct Login {
    user: Str,
    password: Secret<Str>,
}

derive Show for Credential;
enum Credential {
    Anonymous,
    Token(Secret<Str>),
    Basic { user: Str, password: Secret<Str> },
}

derive Show for Vault;
struct Vault {
    maybe: Option<Secret<Str>>,
    keys: [Secret<[U8]>],
}

test "a secret shows as stars, whatever it holds" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(secret.of("hunter2").show(ctx), "***");
    assert.equal(secret.of(42).show(ctx), "***");
    assert.equal(secret.of([1, 2, 3]).show(ctx), "***");
    assert.equal(secret.of("").show(ctx), "***");
}

test "a derived show keeps a secret field masked" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = secret.of("hunter2");
    assert.equal(
        Login { user: "ada", password: s }.show(ctx),
        "Login { user: \"ada\", password: *** }",
    );
    assert.equal(Credential.Token(s).show(ctx), ".Token(***)");
    assert.equal(
        Credential.Basic { user: "ada", password: s }.show(ctx),
        ".Basic { user: \"ada\", password: *** }",
    );
    assert.equal(Credential.Anonymous.show(ctx), ".Anonymous");
}

test "an option and a list of secrets stay masked" {
    let ctx = context {
        Allocator: alloc(),
    };
    let full = Vault {
        maybe: .Some(secret.of("x")),
        keys: [secret.of([1]), secret.of([])],
    };
    assert.equal(full.show(ctx), "Vault { maybe: .Some(***), keys: [***, ***] }");
    assert.equal(
        Vault { maybe: .None, keys: [] }.show(ctx),
        "Vault { maybe: .None, keys: [] }",
    );
}

test "reveal answers the value" {
    assert.equal(secret.of("hunter2").reveal(), "hunter2");
    assert.equal(secret.of(42).reveal(), 42);
    assert.equal(secret.of([1, 2]).reveal(), [1, 2]);
}

test "map changes the value and keeps it wrapped" {
    let ctx = context {
        Allocator: alloc(),
    };
    let length = secret.of("hunter2").map(fn(text) => text.length());
    assert.equal(length.show(ctx), "***");
    assert.equal(length.reveal(), 7);
}

test "mapCtx turns a secret string into secret bytes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let raw = secret.of("hi").mapCtx(ctx, fn(c, text) => bytes.toUtf8(c, text));
    assert.equal(raw.show(ctx), "***");
    assert.equal(raw.reveal(), [104, 105]);
}
