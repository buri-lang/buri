// core/cli — one declaration, read four ways.
//
// `run` is the module's whole exported surface, so every claim below is made
// through it: an argument list goes in through `core/host/testing`'s
// environment double and what comes back is a captured stream, a `.Ok(())` or
// the message `main` would exit 1 with. That is the same path a real program
// takes, minus the host.
//
// The help pages are asserted as literals rather than by shape. A help page is
// a user interface, and a column that moved is a change somebody should have
// to write down.

from "core/cli" import * as cli;
from "core/effect" import { Allocator, Environment, Stderr, Stdout };
from "core/host/testing" import { alloc, env, stderr, stdout, TestStderr, TestStdout };
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// --- the tool under test -------------------------------------------------------

// Every handler prints one line naming itself and what it read, so a test can
// tell "the right command fired" from "a command fired".

fn count<C: Allocator + Stdout>(ctx: C, arguments: cli.Arguments): Result<(), Str> {
    let quiet = match (arguments.on("quiet")) {
        true => "quiet",
        false => "loud",
    };
    let file = arguments.arg("file").withDefault("-");
    let tag = arguments.arg("tag").withDefault("none");
    let out = arguments.value("out").withDefault("stdout");
    let extra = arguments.positionals().join(ctx, "+");
    let _ = io.println(ctx, "count ${file} ${tag} ${quiet} ${out} [${extra}]").ignore();
    .Ok(())
}

fn hash<C: Allocator + Stdout>(ctx: C, arguments: cli.Arguments): Result<(), Str> {
    let included = arguments.many("include").join(ctx, ",");
    let _ = io.println(ctx, "hash [${included}]").ignore();
    .Ok(())
}

fn tool<C: Allocator + Stdout>(): cli.Cli<C> {
    cli.Cli {
        name: "wc2",
        version: "0.1.0",
        about: "counts and hashes files",
        flags: .Some([
            cli.Flag {
                long: "quiet",
                short: .Some('q'),
                arity: .Switch,
                help: "print nothing on success",
            },
        ]),
        commands: [
            cli.Command {
                name: "count",
                about: "count the lines in a file",
                flags: .Some([
                    cli.Flag {
                        long: "out",
                        short: .Some('o'),
                        arity: .Value("path"),
                        help: "where to write the count",
                    },
                ]),
                arguments: .Some([
                    cli.Arg { name: "file", help: "file to read", required: true },
                    cli.Arg { name: "tag", help: "what to call it", required: false },
                ]),
                run: fn(c, arguments) => count(c, arguments),
            },
            cli.Command {
                name: "hash",
                about: "print a file's digest",
                flags: .Some([
                    cli.Flag {
                        long: "include",
                        short: .Some('I'),
                        arity: .Many("dir"),
                        help: "a directory to search",
                    },
                ]),
                run: fn(c, arguments) => hash(c, arguments),
            },
            cli.Command {
                name: "refuse",
                about: "always fails",
                run: fn(_c, _arguments) => .Err("the handler said no"),
            },
        ],
    }
}

// --- driving it ----------------------------------------------------------------

/// What one run of `wc2` produced: its answer, and both streams.
struct Ran {
    answer: Result<(), Str>,
    out: TestStdout,
    err: TestStderr,
}

fn ran(argv: [Str]): Ran {
    let out = stdout();
    let err = stderr();
    let ctx = context {
        Allocator: alloc(),
        Environment: env().withArguments(argv),
        Stdout: out,
        Stderr: err,
    };
    Ran { answer: cli.run(ctx, tool()), out: out, err: err }
}

/// The line a successful run printed, without its newline.
fn printed(r: Ran): Str {
    assert.ok(r.answer);
    r.out.captured().trimEnd()
}

/// The first line of stderr — the `name: message` line, above the usage.
fn complained<C: Allocator>(ctx: C, r: Ran): Option<Str> {
    r.err.captured().lines(ctx).first()
}

// --- dispatch ------------------------------------------------------------------

test "the named command fires, and nothing else does" {
    assert.equal(
        printed(ran(["count", "README.md"])),
        "count README.md none loud stdout [README.md]",
    );
    assert.equal(printed(ran(["hash"])), "hash []");
}

test "a declared positional is bound by name, in declaration order" {
    assert.equal(
        printed(ran(["count", "README.md", "docs"])),
        "count README.md docs loud stdout [README.md+docs]",
    );
}

test "positionals past the declared ones are kept rather than refused" {
    assert.equal(
        printed(ran(["count", "a", "b", "c", "d"])),
        "count a b loud stdout [a+b+c+d]",
    );
}

test "a handler's own error is the message main exits 1 with" {
    let r = ran(["refuse"]);
    assert.equal(assert.err(r.answer), "the handler said no");
    // The handler failed, not the parse, so nothing was written to stderr by
    // `core/cli`: rendering a usage block over a working command line would be
    // an answer to a question nobody asked.
    assert.equal(r.err.captured(), "");
}

// --- the five spellings of a flag ----------------------------------------------

test "a global switch is accepted before the subcommand, long and short" {
    assert.equal(
        printed(ran(["--quiet", "count", "f"])),
        "count f none quiet stdout [f]",
    );
    assert.equal(printed(ran(["-q", "count", "f"])), "count f none quiet stdout [f]");
}

test "a value may be attached with = or written as the next token" {
    assert.equal(
        printed(ran(["count", "--out=log", "f"])),
        "count f none loud log [f]",
    );
    assert.equal(
        printed(ran(["count", "--out", "log", "f"])),
        "count f none loud log [f]",
    );
    assert.equal(printed(ran(["count", "-o=log", "f"])), "count f none loud log [f]");
    assert.equal(
        printed(ran(["count", "-o", "log", "f"])),
        "count f none loud log [f]",
    );
}

test "the last value of a Value flag wins" {
    assert.equal(
        printed(ran(["count", "-o", "one", "--out=two", "f"])),
        "count f none loud two [f]",
    );
}

test "a Many flag keeps every value, in the order they were written" {
    assert.equal(
        printed(ran(["hash", "-I", "a", "--include=b", "-I=c"])),
        "hash [a,b,c]",
    );
}

test "a value that is not a long flag is taken whatever it looks like" {
    // `-` is the conventional name for standard input and `-1` is a number:
    // both are values, and neither is a flag this spec declares.
    assert.equal(printed(ran(["count", "--out", "-", "f"])), "count f none loud - [f]");
    assert.equal(
        printed(ran(["count", "--out", "-1", "f"])),
        "count f none loud -1 [f]",
    );
}

test "-- stops the flags, and everything after it is a positional" {
    assert.equal(
        printed(ran(["count", "--", "--out", "f"])),
        "count --out f loud stdout [--out+f]",
    );
}

test "-- before the command name still names the command" {
    assert.equal(printed(ran(["--", "count", "f"])), "count f none loud stdout [f]");
}

// --- --help and --version ------------------------------------------------------

test "the help page, to the byte" {
    let r = ran(["--help"]);
    assert.ok(r.answer);
    assert.equal(
        r.out.captured(),
        "wc2 0.1.0 — counts and hashes files\n\nusage: wc2 [options] <command> [arguments]\n\ncommands:\n  count   count the lines in a file\n  hash    print a file's digest\n  refuse  always fails\n\noptions:\n  -q, --quiet    print nothing on success\n      --help     print this help and exit\n      --version  print the version and exit\n",
    );
}

test "an empty argument list is the same question, and prints the same page" {
    assert.equal(printed(ran(list.empty<Str>())), printed(ran(["--help"])));
    assert.equal(ran(list.empty<Str>()).err.captured(), "");
}

test "a subcommand's help page names its own flags and its arguments" {
    let r = ran(["count", "--help"]);
    assert.ok(r.answer);
    assert.equal(
        r.out.captured(),
        "wc2 count — count the lines in a file\n\nusage: wc2 [global options] count [options] <file> [tag]\n\narguments:\n  <file>  file to read\n  <tag>   what to call it\n\noptions:\n  -o, --out <path>  where to write the count\n      --help        print this help and exit\n",
    );
}

test "a subcommand with no declared arguments has no arguments section" {
    let r = ran(["hash", "--help"]);
    assert.ok(r.answer);
    assert.equal(
        r.out.captured(),
        "wc2 hash — print a file's digest\n\nusage: wc2 [global options] hash [options]\n\noptions:\n  -I, --include <dir>...  a directory to search\n      --help              print this help and exit\n",
    );
}

test "--version prints the version and nothing else, before or after a command" {
    let r = ran(["--version"]);
    assert.ok(r.answer);
    assert.equal(r.out.captured(), "0.1.0\n");
    let after = ran(["count", "--version"]);
    assert.ok(after.answer);
    assert.equal(after.out.captured(), "0.1.0\n");
}

test "--help is answered where it is read, whatever the rest of the line says" {
    // It is answered at the token, so the missing `<file>` never becomes a
    // verdict: nothing reaches stderr and the run is `.Ok(())`.
    let r = ran(["count", "--help"]);
    assert.ok(r.answer);
    assert.equal(r.err.captured(), "");
    // `--help=anything` is still `--help` rather than `UnexpectedValue`.
    assert.equal(ran(["count", "--help=1"]).out.captured(), r.out.captured());
    // `-h` is not reserved: `wc2` declares none, so it is an unknown flag
    // rather than the page.
    assert.equal(assert.err(ran(["-h"]).answer), "unknown flag -h");
}

// --- the verdicts a line can earn ----------------------------------------------

test "an unknown flag names the token as it was written" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        assert.err(ran(["--verbose", "count", "f"]).answer),
        "unknown flag --verbose",
    );
    assert.equal(assert.err(ran(["-v", "count", "f"]).answer), "unknown flag -v");
    assert.equal(
        assert.err(ran(["count", "--verbose", "f"]).answer),
        "unknown flag --verbose",
    );
    // A global flag is global *before* the subcommand and unknown after it,
    // which is what `Cli.flags` means by "accepted before the subcommand".
    assert.equal(
        assert.err(ran(["count", "--quiet", "f"]).answer),
        "unknown flag --quiet",
    );
    assert.equal(
        complained(ctx, ran(["--verbose", "count", "f"])),
        .Some("wc2: unknown flag --verbose"),
    );
}

test "short flags do not cluster" {
    assert.equal(assert.err(ran(["hash", "-Iq"]).answer), "unknown flag -Iq");
}

test "a flag with no value left to take" {
    assert.equal(assert.err(ran(["count", "--out"]).answer), "--out needs a value");
    assert.equal(
        assert.err(ran(["count", "--out", "--quiet", "f"]).answer),
        "--out needs a value",
    );
    assert.equal(assert.err(ran(["count", "-o"]).answer), "-o needs a value");
}

test "a switch given a value" {
    assert.equal(
        assert.err(ran(["--quiet=loud", "count", "f"]).answer),
        "--quiet takes no value",
    );
    assert.equal(
        assert.err(ran(["-q=loud", "count", "f"]).answer),
        "-q takes no value",
    );
}

test "an unknown command, and no command at all" {
    assert.equal(assert.err(ran(["frobnicate"]).answer), "unknown command frobnicate");
    // Global flags and then nothing: the line meant to name a command.
    assert.equal(assert.err(ran(["--quiet"]).answer), "no command given");
    assert.equal(assert.err(ran(["--"]).answer), "no command given");
}

test "a required positional the line did not supply" {
    assert.equal(assert.err(ran(["count"]).answer), "missing argument <file>");
    // The optional one after it is not required to be there.
    assert.equal(printed(ran(["count", "f"])), "count f none loud stdout [f]");
}

test "a refused line puts the message and the usage on stderr" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = ran(["count"]);
    let lines = r.err.captured().lines(ctx);
    assert.equal(lines.first(), .Some("wc2: missing argument <file>"));
    // The help page follows, so a reader is told what was wrong and what to
    // write instead — the same page `--help` prints, from the same `Cli`.
    assert.equal(lines.get(1), .Some("wc2 0.1.0 — counts and hashes files"));
    assert.equal(lines.get(3), .Some("usage: wc2 [options] <command> [arguments]"));
    // Nothing reached stdout: an error is not output.
    assert.equal(r.out.captured(), "");
}

test "the message on stderr and the message main exits with are the same one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = ran(["frobnicate"]);
    let message = assert.err(r.answer);
    assert.equal(complained(ctx, r), .Some(str.format(ctx, "wc2: ${message}")));
}
