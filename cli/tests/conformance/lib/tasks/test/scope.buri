// `core/tasks` — `scope`, `spawn`, and what a scope promises.
//
// Every assertion here is a literal written into the file, so the two backends
// either both pass it or disagree about the language.
// `cli/tests/native/conformance.rs` runs this same file through the
// copy-and-patch backend, and `cli/tests/native/agreement.rs`'s
// `a_spawned_task_runs_before_its_scope_returns_on_every_backend` runs the same
// shape through the optimizing one.
//
// A stream is the observation throughout. `stdout()` records what was written
// and in what order, which is the one thing a test of background work has to be
// able to read back — and it is a value rather than a timing, so the assertion
// is the same on a backend that overlaps the tasks and one that does not.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Address, Stepped };
from "core/effect" import { Allocator, Clock, Stdout, Tasks };
from "core/host/testing" import { alloc, clock, stdout, tasks };
from "core/io" import * as io;
from "core/tasks" import * as tasks;
from "core/tasks" import { Scope };
from "core/testing/assert" import * as assert;
from "core/time" import * as time;

/// Writes one line, as a task does.
fn say<C: Stdout>(ctx: C, what: Str): () {
    let _ = io.println(ctx, what).ignore();
    ()
}

test "a scope answers what its body answered" {
    let ctx = context {
        Allocator: alloc(),
        Stdout: stdout(),
        Tasks: tasks(),
    };
    assert.eq(tasks.scope(ctx, fn(c, here) => 41 + 1), 42);
}

test "a scope that spawns nothing runs nothing" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let _ = tasks.scope(ctx, fn(c, here) => say(c, "body"));
    assert.eq(out.captured(), "body\n");
}

test "the body finishes before anything spawned in it starts" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let _ = tasks.scope(ctx, fn(c, here) => {
        let _ = tasks.spawn(c, here, fn(c2) => say(c2, "task"));
        say(c, "body")
    });
    assert.eq(out.captured(), "body\ntask\n");
}

test "a scope returns only once every task spawned in it has finished" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let _ = tasks.scope(ctx, fn(c, here) => {
        let _ = tasks.spawn(c, here, fn(c2) => say(c2, "one"));
        let _ = tasks.spawn(c, here, fn(c2) => say(c2, "two"));
        let _ = tasks.spawn(c, here, fn(c2) => say(c2, "three"));
        ()
    });
    assert.eq(out.captured(), "one\ntwo\nthree\n");
}

test "a task spawned by a task is waited for too" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let _ = tasks.scope(ctx, fn(c, here) => {
        let _ = tasks.spawn(c, here, fn(c2) => {
            let _ = say(c2, "outer");
            let _ = tasks.spawn(c2, here, fn(c3) => say(c3, "inner"));
            ()
        });
        ()
    });
    assert.eq(out.captured(), "outer\ninner\n");
}

test "a timer is a task that sleeps" {
    let out = stdout();
    let ticking = clock();
    let ctx = context {
        Allocator: alloc(),
        Clock: ticking,
        Stdout: out,
        Tasks: tasks(),
    };
    let _ = tasks.scope(ctx, fn(c, here) => {
        let _ = tasks.spawn(c, here, fn(c2) => {
            let _ = time.sleepMs(c2, 5 * 60 * 1000);
            say(c2, "the session expired")
        });
        say(c, "mounted")
    });
    assert.eq(out.captured(), "mounted\nthe session expired\n");
    // The wait was a wait, and the double is what makes it one a test can
    // read: no real time passed and the clock moved by the sleep.
    assert.eq(time.now(ctx).0, 300000);
}

// -- the order the tasks run in ----------------------------------------------
//
// A scope promises that every task has finished when it returns, and promises
// nothing about the order. So the order is `core/host/testing`'s to choose,
// exactly as it is for `parallel` — a spawned task is run through
// `Tasks.parallel`, so the double that decides `parallel`'s order decides this
// one, and a test writes the order down rather than hoping for it.

test "tasks() spawns in program order" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let _ = tasks.scope(ctx, fn(c, here) => spawnThree(c, here));
    assert.eq(out.captured(), "a\nb\nc\n");
}

test "a seed is the order the spawned tasks run in" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks().seed(5),
    };
    let _ = tasks.scope(ctx, fn(c, here) => spawnThree(c, here));
    assert.eq(out.captured(), "c\nb\na\n");
}

test "the double records a spawned task the way it records any other" {
    let scheduler = tasks();
    let ctx = context {
        Allocator: alloc(),
        Stdout: stdout(),
        Tasks: scheduler,
    };
    let _ = tasks.scope(ctx, fn(c, here) => spawnThree(c, here));
    assert.eq(scheduler.calls().len(), 3);
}

/// Three tasks, spawned in a written order, each saying which it is.
fn spawnThree<C: Allocator + Stdout + Tasks>(ctx: C, here: Scope): () {
    let _ = tasks.spawn(ctx, here, fn(c) => say(c, "a"));
    let _ = tasks.spawn(ctx, here, fn(c) => say(c, "b"));
    let _ = tasks.spawn(ctx, here, fn(c) => say(c, "c"));
    ()
}

// -- a scope a handler holds --------------------------------------------------

test "a scope is inert, so a lambda may capture it" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let handler = tasks.scope(ctx, fn(c, here) => {
        // The page's shape: the body mounts something that will spawn later,
        // and answers the thing that holds the scope.
        let _ = say(c, "mounted");
        fn(c2) => {
            let _ = tasks.spawn(c2, here, fn(c3) => say(c3, "a socket opened"));
            ()
        }
    });
    // Nothing has been spawned yet, so the scope returned with the body.
    assert.eq(out.captured(), "mounted\n");
    let click = handler;
    let _ = click(ctx);
    // The scope was still there, and the task ran on the caller that spawned it.
    assert.eq(out.captured(), "mounted\na socket opened\n");
}

// -- stopping a task ----------------------------------------------------------
//
// There is no `cancel`, and the module says so: a task ends when its own body
// ends. So a loop that means to be stoppable asks something outside it whether
// to carry on, and an actor is what a program already has for that.

enum Turn {
    Carry,
    Stop,
}

/// Says `Carry` for the first three asks and `Stop` after.
///
/// A socket would answer this question by being closed. The actor is the same
/// answer with the network taken out of it, so the file holds both sides.
fn gate<C: Allocator + Tasks>(turns: Int): Actor<C, Int, Ask, Turn> {
    Actor {
        state: turns,
        step: fn(c, left, message) => {
            match (left > 0) {
                true => Stepped { state: left - 1, answer: .Carry },
                false => Stepped { state: left, answer: .Stop },
            }
        },
    }
}

enum Ask {
    MayI,
}

/// The long-lived loop: one frame per turn, and it ends when it is told to.
fn frames<C: Allocator + Stdout + Tasks>(
    ctx: C,
    keeper: Address<C, Int, Ask, Turn>,
    n: Int,
): () {
    match (keeper.sendMessage(ctx, .MayI)) {
        .Ok(.Carry) => {
            let _ = io.println(ctx, "frame ${n}").ignore();
            frames(ctx, keeper, n + 1)
        },
        _stopped => say(ctx, "the loop stopped"),
    }
}

test "a spawned loop stops when the actor it asks says to" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let keeper = actor.start(ctx, gate(3));
    let _ = tasks.scope(ctx, fn(c, here) => {
        let _ = tasks.spawn(c, here, fn(c2) => frames(c2, keeper, 0));
        ()
    });
    assert.eq(out.captured(), "frame 0\nframe 1\nframe 2\nthe loop stopped\n");
    let _ = keeper.stop(ctx).ignore();
}
