// Floating point — SPEC 5.1.1 (`F32` is binary32 and `F64` is binary64),
// 6.2 ("Floating point follows IEEE-754. `==` on floats compares numerically
// with `-0.0` equal to `0.0`, and `NaN != NaN`"), and 5.11 (`Ord` on floats
// orders `-0.0` equal to `0.0`).
//
// The values here are chosen so the expected answer is exactly representable
// wherever the point is to test arithmetic rather than to test rounding; the
// tests that do exercise rounding say so.

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/math" import * as math;
from "core/num" import * as num;
from "core/order" import { Order };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

fn nan(): F64 {
    0.0 / 0.0
}

fn inf(): F64 {
    1.0 / 0.0
}

fn negInf(): F64 {
    -1.0 / 0.0
}

// --- F64 arithmetic ----------------------------------------------------------------

test "F64 adds, subtracts, multiplies and divides" {
    assert.eq(0.5 + 0.25, 0.75);
    assert.eq(0.75 - 0.25, 0.5);
    assert.eq(1.5 * 2.0, 3.0);
    assert.eq(3.0 / 2.0, 1.5);
}

test "F64 division does not truncate" {
    assert.eq(1.0 / 4.0, 0.25);
    assert.eq(7.0 / 2.0, 3.5);
    assert.eq(-7.0 / 2.0, -3.5);
    assert.eq(1.0 / 2.0, 0.5);
}

test "the float remainder takes the sign of the dividend" {
    assert.eq(7.5 % 2.0, 1.5);
    assert.eq(-7.5 % 2.0, -1.5);
    assert.eq(7.5 % -2.0, 1.5);
    assert.eq(-7.5 % -2.0, -1.5);
}

test "negating a float" {
    let a: F64 = 1.5;
    assert.eq(-a, -1.5);
    assert.eq(-(-a), 1.5);
    assert.eq(-0.0 == 0.0, true);
}

test "F64 carries binary floating point rounding, not decimal arithmetic" {
    assert.notEq(0.1 + 0.2, 0.3);
    assert.eq(0.1 + 0.2, 0.30000000000000004);
    assert.eq(0.1 + 0.4, 0.5);
}

test "powers of two are exact in F64" {
    assert.eq(0.5 + 0.5, 1.0);
    assert.eq(0.125 * 8.0, 1.0);
    assert.eq(9007199254740992.0 + 0.0, 9007199254740992.0);
    assert.eq(9007199254740992.0 + 1.0, 9007199254740992.0);
}

test "a float literal with nothing to pin it defaults to Float" {
    let a = 1.5;
    let b: F64 = 1.5;
    assert.eq(a, b);
    assert.eq(a * 2.0, 3.0);
}

test "a float literal pinned by an annotation gets that type" {
    let a: F32 = 1.5;
    let b: F32 = 2.5;
    assert.eq(a + b, 4.0);
    assert.eq(a.toF64(), 1.5);
}

test "an exponent literal is the value it spells" {
    assert.eq(1.0e3, 1000.0);
    assert.eq(1.5e-3, 0.0015);
    assert.eq(6.0e2, 600.0);
    assert.eq(1.0e0, 1.0);
}

// --- IEEE-754 behaviour --------------------------------------------------------------

test "NaN is equal to itself and to every other NaN" {
    // SPEC 6.2: `==` is an equivalence relation, so it is reflexive at every
    // value including this one. IEEE-754 says otherwise and the ordering
    // operators below still obey it; equality is the one place Buri departs.
    let x = nan();
    assert.isTrue(x == x);
    assert.isFalse(x != x);
    assert.eq(x, x);
    // A different bit pattern for the same value: negation flips the sign bit
    // and nothing else, so an equality that compared bits would fail here.
    let y = -x;
    assert.isTrue(x == y);
    assert.isTrue(math.isNan(y));
}

test "NaN is equal to no number" {
    let x = nan();
    assert.isFalse(x == 0.0);
    assert.isFalse(0.0 == x);
    assert.isTrue(x != 1.0);
    assert.isTrue(x != inf());
}

test "NaN answers false to every comparison" {
    let x = nan();
    assert.isFalse(x < 1.0);
    assert.isFalse(x > 1.0);
    assert.isFalse(x <= 1.0);
    assert.isFalse(x >= 1.0);
    assert.isFalse(1.0 < x);
    assert.isFalse(1.0 > x);
}

test "NaN propagates through arithmetic" {
    let x = nan();
    assert.isTrue(math.isNan(x + 1.0));
    assert.isTrue(math.isNan(x * 0.0));
    assert.isTrue(math.isNan(x - x));
    assert.isTrue(math.isNan(x / x));
}

test "minus zero equals zero but keeps its sign" {
    assert.eq(-0.0, 0.0);
    assert.isTrue(-0.0 == 0.0);
    assert.isFalse(-0.0 < 0.0);
    assert.eq(1.0 / 0.0, inf());
    assert.eq(1.0 / -0.0, negInf());
}

test "the infinities behave like infinities" {
    assert.eq(inf() + 1.0, inf());
    assert.eq(inf() * 2.0, inf());
    assert.eq(negInf() + 1.0, negInf());
    assert.eq(inf() + negInf() == inf(), false);
    assert.isTrue(math.isNan(inf() + negInf()));
    assert.isTrue(math.isNan(inf() * 0.0));
}

test "infinity orders above every finite value" {
    assert.isTrue(inf() > 1.0e300);
    assert.isTrue(negInf() < -1.0e300);
    assert.isTrue(negInf() < inf());
    assert.eq(1.0 / inf(), 0.0);
}

test "isNan, isInfinite and isFinite classify a float" {
    assert.isTrue(math.isNan(nan()));
    assert.isFalse(math.isNan(1.0));
    assert.isTrue(math.isInfinite(inf()));
    assert.isTrue(math.isInfinite(negInf()));
    assert.isFalse(math.isInfinite(nan()));
    assert.isTrue(math.isFinite(1.0));
    assert.isFalse(math.isFinite(inf()));
    assert.isFalse(math.isFinite(nan()));
}

// --- core/math -------------------------------------------------------------------------

test "sqrt" {
    assert.eq(math.sqrt(9.0), 3.0);
    assert.eq(math.sqrt(0.0), 0.0);
    assert.eq(math.sqrt(2.0), 1.4142135623730951);
    assert.eq(math.sqrt(0.25), 0.5);
    assert.isTrue(math.isNan(math.sqrt(-1.0)));
    assert.eq(math.sqrt(math.INFINITY), math.INFINITY);
}

test "cbrt" {
    assert.eq(math.cbrt(27.0), 3.0);
    assert.eq(math.cbrt(-8.0), -2.0);
    assert.eq(math.cbrt(0.0), 0.0);
}

test "pow" {
    assert.eq(math.pow(2.0, 10.0), 1024.0);
    assert.eq(math.pow(2.0, 0.0), 1.0);
    assert.eq(math.pow(2.0, -1.0), 0.5);
    assert.eq(math.pow(9.0, 0.5), 3.0);
    assert.eq(math.pow(-2.0, 3.0), -8.0);
}

test "floor rounds toward negative infinity" {
    assert.eq(math.floor(2.7), 2.0);
    assert.eq(math.floor(2.0), 2.0);
    assert.eq(math.floor(-2.1), -3.0);
    assert.eq(math.floor(-2.0), -2.0);
}

test "ceil rounds toward positive infinity" {
    assert.eq(math.ceil(2.1), 3.0);
    assert.eq(math.ceil(2.0), 2.0);
    assert.eq(math.ceil(-2.7), -2.0);
    assert.eq(math.ceil(-2.0), -2.0);
}

test "trunc rounds toward zero" {
    assert.eq(math.trunc(2.7), 2.0);
    assert.eq(math.trunc(-2.7), -2.0);
    assert.eq(math.trunc(0.9), 0.0);
    assert.eq(math.trunc(-0.9), 0.0);
}

test "round goes to the nearer whole number" {
    assert.eq(math.round(2.4), 2.0);
    assert.eq(math.round(2.6), 3.0);
    assert.eq(math.round(-2.4), -2.0);
    assert.eq(math.round(-2.6), -3.0);
    assert.eq(math.round(2.0), 2.0);
}

test "absFloat and the abs method agree" {
    let a: F64 = -2.5;
    assert.eq(math.absFloat(-2.5), 2.5);
    assert.eq(math.absFloat(2.5), 2.5);
    assert.eq(math.absFloat(0.0), 0.0);
    assert.eq(a.abs(), 2.5);
    assert.eq(math.absFloat(negInf()), inf());
}

test "exp and ln invert each other" {
    assert.eq(math.exp(0.0), 1.0);
    assert.eq(math.ln(1.0), 0.0);
    assert.eq(math.ln(math.E), 1.0);
    assert.eq(math.exp(1.0), math.E);
    assert.eq(math.ln(math.exp(2.0)), 2.0);
}

test "log2 and log10" {
    assert.eq(math.log2(1024.0), 10.0);
    assert.eq(math.log2(1.0), 0.0);
    assert.eq(math.log10(1000.0), 3.0);
    assert.eq(math.log10(1.0), 0.0);
}

test "the trigonometric functions at their easy points" {
    assert.eq(math.sin(0.0), 0.0);
    assert.eq(math.cos(0.0), 1.0);
    assert.eq(math.tan(0.0), 0.0);
    assert.eq(math.asin(0.0), 0.0);
    assert.eq(math.atan(0.0), 0.0);
    assert.eq(math.acos(1.0), 0.0);
    assert.eq(math.atan2(0.0, 1.0), 0.0);
    assert.eq(math.atan2(1.0, 0.0), math.PI / 2.0);
}

test "PI and E are the binary64 values nearest the constants" {
    assert.eq(math.PI, 3.141592653589793);
    assert.eq(math.E, 2.718281828459045);
    assert.eq(math.sin(math.PI) < 1.0e-15, true);
    assert.eq(math.cos(math.PI), -1.0);
}

// --- F32 ---------------------------------------------------------------------------------

test "F32 adds, subtracts, multiplies and divides" {
    let a: F32 = 1.5;
    let b: F32 = 0.5;
    assert.eq(a + b, 2.0);
    assert.eq(a - b, 1.0);
    assert.eq(a * b, 0.75);
    assert.eq(a / b, 3.0);
}

test "F32 compares like a float" {
    let a: F32 = 1.5;
    let b: F32 = 2.5;
    assert.isTrue(a < b);
    assert.isFalse(b < a);
    assert.eq(a.compare(b), Order.Less);
    let z: F32 = -0.0;
    let p: F32 = 0.0;
    assert.eq(z, p);
}

test "F32 is binary32, so it stops counting by ones at two to the twenty-fourth" {
    // SPEC 5.1.1: `F32` is IEEE-754 binary32. 16777217 is not representable in
    // binary32, so adding one to 16777216.0 has to give 16777216.0 back.
    let a: F32 = 16777216.0;
    let b: F32 = 1.0;
    assert.eq(a + b, 16777216.0);
}

test "F32 rounds a decimal literal to binary32" {
    // 0.1 is not representable in binary32 either; the nearest binary32 value
    // is 0.100000001490116119384765625.
    let a: F32 = 0.1;
    assert.eq(a.toF64(), 0.10000000149011612);
}

// --- Rendering and parsing -----------------------------------------------------------------

test "a whole-number float renders with a point" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloat(ctx, 1.0), "1.0");
    assert.eq(str.fromFloat(ctx, 0.0), "0.0");
    assert.eq(str.fromFloat(ctx, -2.0), "-2.0");
    assert.eq(str.fromFloat(ctx, 100.0), "100.0");
}

test "a fractional float renders its digits" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloat(ctx, 0.5), "0.5");
    assert.eq(str.fromFloat(ctx, -0.25), "-0.25");
    assert.eq(str.fromFloat(ctx, 0.1 + 0.2), "0.30000000000000004");
}

test "the special values render as names rather than numbers" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(str.fromFloat(ctx, inf()), "inf");
    assert.eq(str.fromFloat(ctx, negInf()), "-inf");
    assert.eq(str.fromFloat(ctx, nan()), "NaN");
    assert.eq(str.fromFloat(ctx, -0.0), "-0.0");
}

test "show on a float agrees with str.fromFloat" {
    let ctx = context {
        Alloc: alloc(),
    };
    let a: F64 = 1.5;
    assert.eq(a.show(ctx), str.fromFloat(ctx, 1.5));
    let b: F64 = 2.0;
    assert.eq(b.show(ctx), "2.0");
}

test "str.toFloat parses what str.fromFloat wrote" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(assert.some(str.fromFloat(ctx, 1.5).toFloat()), 1.5);
    assert.eq(assert.some(str.fromFloat(ctx, -0.25).toFloat()), -0.25);
    assert.eq(assert.some("2.5".toFloat()), 2.5);
    assert.eq(assert.some("2".toFloat()), 2.0);
}

test "str.toFloat rejects what is not a float" {
    assert.none("abc".toFloat());
    assert.none("".toFloat());
    assert.none("1.2.3".toFloat());
}

// --- Ordering and the free functions ----------------------------------------------------------

test "min and max on floats" {
    assert.eq(num.min(1.5, 2.5), 1.5);
    assert.eq(num.max(1.5, 2.5), 2.5);
    assert.eq(num.min(-1.5, -2.5), -2.5);
    assert.eq(num.max(0.0, -0.0), 0.0);
}

test "clamp on floats" {
    assert.eq(num.clamp(0.0, 1.0, 2.5), 1.0);
    assert.eq(num.clamp(0.0, 1.0, -2.5), 0.0);
    assert.eq(num.clamp(0.0, 1.0, 0.5), 0.5);
    assert.eq(num.clamp(0.0, 1.0, inf()), 1.0);
}

test "signum on floats" {
    let a: F64 = -2.5;
    let b: F64 = 2.5;
    let z: F64 = 0.0;
    assert.eq(a.signum(), -1.0);
    assert.eq(b.signum(), 1.0);
    assert.eq(z.signum(), 0.0);
}

test "compare on floats orders minus zero with zero" {
    let a: F64 = 1.5;
    let b: F64 = 2.5;
    assert.eq(a.compare(b), Order.Less);
    assert.eq(b.compare(a), Order.Greater);
    assert.eq(a.compare(a), Order.Equal);
    let z: F64 = -0.0;
    let p: F64 = 0.0;
    assert.eq(z.compare(p), Order.Equal);
}

test "Float is F64, not a type of its own" {
    let a: Float = 1.5;
    let b: F64 = 1.5;
    assert.eq(a, b);
    assert.eq(a + b, 3.0);
    assert.eq(math.sqrt(b), math.sqrt(a));
}

test "the comparison operators on F64" {
    let a: F64 = 1.5;
    let b: F64 = 2.5;
    assert.isTrue(a < b);
    assert.isTrue(a <= b);
    assert.isFalse(a > b);
    assert.isFalse(a >= b);
    assert.isTrue(a <= a);
    assert.isTrue(a >= a);
    assert.isTrue(a == a);
    assert.isTrue(a != b);
}

// --- The hyperbolics, and the two functions that keep their digits -------------------
//
// Every one of these reaches `exp` or `ln`, whose last bit IEEE-754 does not
// fix, so they belong in this file rather than beside the exact ones in
// `special_floats.buri` — and they are asserted against a *relative* tolerance
// rather than to the bit, for the same reason. Where an assertion is exact it
// is because the answer is one of the values the algorithm returns without
// computing.

/// Ten units in the last place, which is the band a value built out of `exp`
/// and `ln` is allowed to land in.
fn near(actual: Float, expected: Float): () {
    assert.isTrue(math.isCloseRelative(actual, expected, 10.0 * math.EPSILON))
}

test "expMinusOne keeps the digits that exp(x) - 1 throws away" {
    near(math.expMinusOne(1.0), 1.7182818284590453);
    near(math.expMinusOne(-1.0), -0.6321205588285577);
    assert.eq(math.expMinusOne(0.0), 0.0);
    // The whole reason it exists: down here `exp(x) - 1.0` is zero.
    assert.eq(math.expMinusOne(1.0e-16), 1.0e-16);
    assert.eq(math.exp(1.0e-16) - 1.0, 0.0);
    near(math.expMinusOne(1.0e-8), 1.0000000050000001e-8);
}

test "expMinusOne at the ends" {
    assert.eq(math.expMinusOne(math.NEG_INFINITY), -1.0);
    assert.eq(math.expMinusOne(math.INFINITY), math.INFINITY);
    assert.isTrue(math.isNan(math.expMinusOne(nan())));
}

test "lnOnePlus keeps the digits that ln(1 + x) throws away" {
    near(math.lnOnePlus(1.0), 0.6931471805599453);
    near(math.lnOnePlus(-0.5), -0.6931471805599453);
    assert.eq(math.lnOnePlus(0.0), 0.0);
    assert.eq(math.lnOnePlus(1.0e-16), 1.0e-16);
    assert.eq(math.ln(1.0 + 1.0e-16), 0.0);
}

test "expMinusOne and lnOnePlus undo each other" {
    near(math.lnOnePlus(math.expMinusOne(0.75)), 0.75);
    near(math.expMinusOne(math.lnOnePlus(0.75)), 0.75);
    near(math.lnOnePlus(math.expMinusOne(-0.25)), -0.25);
}

test "logBase divides one logarithm by another" {
    near(math.logBase(8.0, 2.0), 3.0);
    near(math.logBase(100.0, 10.0), 2.0);
    near(math.logBase(1.0, 10.0), 0.0);
    near(math.logBase(81.0, 3.0), 4.0);
}

test "sinh is odd and matches its published values" {
    near(math.sinh(1.0), 1.1752011936438014);
    near(math.sinh(0.5), 0.5210953054937474);
    near(math.sinh(-1.0), -1.1752011936438014);
    assert.eq(math.sinh(0.0), 0.0);
    near(math.sinh(3.0), 10.017874927409903);
}

test "sinh is x itself as x approaches zero" {
    assert.eq(math.sinh(1.0e-16), 1.0e-16);
    assert.eq(math.sinh(1.0e-8), 1.0e-8);
}

test "sinh overflows only where the answer does" {
    // `exp(710)` is infinite and `sinh(710)` is not.
    assert.isTrue(math.isFinite(math.sinh(710.0)));
    assert.isTrue(math.isInfinite(math.exp(710.0)));
    assert.eq(math.sinh(math.INFINITY), math.INFINITY);
    assert.eq(math.sinh(math.NEG_INFINITY), math.NEG_INFINITY);
    assert.isTrue(math.isNan(math.sinh(nan())));
}

test "cosh is even and never below one" {
    near(math.cosh(1.0), 1.5430806348152437);
    near(math.cosh(0.25), 1.0314130998795732);
    near(math.cosh(-1.0), 1.5430806348152437);
    assert.eq(math.cosh(0.0), 1.0);
    assert.isTrue(math.cosh(0.3) >= 1.0);
    assert.isTrue(math.cosh(-0.3) >= 1.0);
}

test "cosh overflows only where the answer does" {
    assert.isTrue(math.isFinite(math.cosh(710.0)));
    assert.eq(math.cosh(math.INFINITY), math.INFINITY);
    assert.eq(math.cosh(math.NEG_INFINITY), math.INFINITY);
    assert.isTrue(math.isNan(math.cosh(nan())));
}

test "cosh squared minus sinh squared is one" {
    let x = 1.75;
    near(math.cosh(x) * math.cosh(x) - math.sinh(x) * math.sinh(x), 1.0);
    let y = -0.4;
    near(math.cosh(y) * math.cosh(y) - math.sinh(y) * math.sinh(y), 1.0);
}

test "tanh is odd and stays inside minus one to one" {
    near(math.tanh(1.0), 0.7615941559557649);
    near(math.tanh(0.5), 0.46211715726000974);
    near(math.tanh(-1.0), -0.7615941559557649);
    assert.eq(math.tanh(0.0), 0.0);
    assert.isTrue(math.tanh(5.0) < 1.0);
    assert.isTrue(math.tanh(-5.0) > -1.0);
}

test "tanh is one to the last bit past twenty-two" {
    assert.eq(math.tanh(23.0), 1.0);
    assert.eq(math.tanh(-23.0), -1.0);
    assert.eq(math.tanh(math.INFINITY), 1.0);
    assert.eq(math.tanh(math.NEG_INFINITY), -1.0);
    assert.isTrue(math.isNan(math.tanh(nan())));
}

test "tanh is sinh over cosh" {
    let x = 0.9;
    near(math.tanh(x), math.sinh(x) / math.cosh(x));
    let y = -2.5;
    near(math.tanh(y), math.sinh(y) / math.cosh(y));
}

test "asinh is defined everywhere and is odd" {
    near(math.asinh(1.0), 0.881373587019543);
    near(math.asinh(-1.0), -0.881373587019543);
    assert.eq(math.asinh(0.0), 0.0);
    near(math.asinh(1.0e12), 28.32416829648849);
    assert.eq(math.asinh(math.INFINITY), math.INFINITY);
    assert.eq(math.asinh(math.NEG_INFINITY), math.NEG_INFINITY);
    assert.isTrue(math.isNan(math.asinh(nan())));
}

test "acosh is NaN below one and zero at it" {
    assert.eq(math.acosh(1.0), 0.0);
    near(math.acosh(2.0), 1.3169578969248166);
    near(math.acosh(1.5), 0.9624236501192069);
    near(math.acosh(1.0e12), 28.32416829648849);
    assert.isTrue(math.isNan(math.acosh(0.5)));
    assert.isTrue(math.isNan(math.acosh(-1.0)));
    assert.eq(math.acosh(math.INFINITY), math.INFINITY);
    assert.isTrue(math.isNan(math.acosh(nan())));
}

test "atanh is NaN outside minus one to one, and infinite at each end" {
    near(math.atanh(0.5), 0.5493061443340549);
    near(math.atanh(-0.5), -0.5493061443340549);
    near(math.atanh(0.9), 1.4722194895832204);
    assert.eq(math.atanh(0.0), 0.0);
    assert.eq(math.atanh(1.0), math.INFINITY);
    assert.eq(math.atanh(-1.0), math.NEG_INFINITY);
    assert.isTrue(math.isNan(math.atanh(1.5)));
    assert.isTrue(math.isNan(math.atanh(-1.5)));
    assert.isTrue(math.isNan(math.atanh(nan())));
}

test "each inverse undoes its own hyperbolic" {
    near(math.asinh(math.sinh(1.25)), 1.25);
    near(math.sinh(math.asinh(1.25)), 1.25);
    near(math.acosh(math.cosh(1.25)), 1.25);
    near(math.cosh(math.acosh(1.25)), 1.25);
    near(math.atanh(math.tanh(0.6)), 0.6);
    near(math.tanh(math.atanh(0.6)), 0.6);
}
