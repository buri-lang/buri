// Bit manipulation — `core/bits`.
//
// `shl` and `shr` are functions rather than operators because there is no `<<`
// or `>>` token (design/grammar-rationale.md 12.6), so the whole of this file
// is ordinary calls. The wide operations work on `Int`, which is `I64`; the
// `U8`, `U32` and `U64` forms are named separately because a method's receiver,
// not an argument, picks the width.
//
// Shifting by a count at or beyond the width of the type aborts, so every
// count below is in range.

from "core/bits" import * as bits;
from "core/num" import * as num;
from "core/testing/assert" import * as assert;

// --- shl ---------------------------------------------------------------------------

test "shl shifts toward the high bits" {
    assert.eq(bits.shl(1, 0), 1);
    assert.eq(bits.shl(1, 1), 2);
    assert.eq(bits.shl(1, 10), 1024);
    assert.eq(bits.shl(3, 4), 48);
    assert.eq(bits.shl(0, 17), 0);
}

test "shl is multiplication by a power of two while the product fits" {
    assert.eq(bits.shl(5, 3), 5 * 8);
    assert.eq(bits.shl(-5, 3), -5 * 8);
    assert.eq(bits.shl(1234567, 10), 1234567 * 1024);
}

test "shl by sixty-three lands on the sign bit" {
    assert.eq(bits.shl(1, 63), num.minValue<I64>());
    assert.eq(bits.shl(1, 62), 4611686018427387904);
}

// --- shr and sar ----------------------------------------------------------------------

test "shr shifts toward the low bits" {
    assert.eq(bits.shr(1024, 3), 128);
    assert.eq(bits.shr(1, 1), 0);
    assert.eq(bits.shr(255, 4), 15);
    assert.eq(bits.shr(0, 5), 0);
    assert.eq(bits.shr(1024, 0), 1024);
}

test "shr is division by a power of two for a non-negative value" {
    assert.eq(bits.shr(1000, 3), 1000 / 8);
    assert.eq(bits.shr(9007199254740992, 10), 9007199254740992 / 1024);
}

test "shr fills with zeros rather than with the sign bit" {
    assert.eq(bits.shr(-1, 1), num.maxValue<I64>());
    assert.eq(bits.shr(num.minValue<I64>(), 63), 1);
}

test "shr by zero is the identity, on a negative value too" {
    // Whatever a logical shift means for a negative `Int`, a shift by zero
    // returns the value, and the result has to be an `Int`.
    assert.eq(bits.shr(-1, 0), -1);
    assert.eq(bits.shr(num.minValue<I64>(), 0), num.minValue<I64>());
}

test "sar replicates the sign bit" {
    assert.eq(bits.sar(-8, 1), -4);
    assert.eq(bits.sar(-1, 1), -1);
    assert.eq(bits.sar(-1, 63), -1);
    assert.eq(bits.sar(num.minValue<I64>(), 63), -1);
    assert.eq(bits.sar(-1024, 3), -128);
}

test "sar rounds toward negative infinity, unlike division" {
    assert.eq(bits.sar(-7, 1), -4);
    assert.eq(-7 / 2, -3);
}

test "shr and sar agree on a non-negative value" {
    assert.eq(bits.shr(1024, 3), bits.sar(1024, 3));
    assert.eq(bits.shr(12345, 7), bits.sar(12345, 7));
    assert.eq(bits.shr(num.maxValue<I64>(), 1), bits.sar(num.maxValue<I64>(), 1));
}

test "a value survives a shift left and back when nothing falls off" {
    assert.eq(bits.shr(bits.shl(12345, 10), 10), 12345);
    assert.eq(bits.sar(bits.shl(1, 40), 40), 1);
}

// --- Counting bits ------------------------------------------------------------------------

test "popCount counts the one bits" {
    assert.eq(bits.popCount(0), 0);
    assert.eq(bits.popCount(1), 1);
    assert.eq(bits.popCount(255), 8);
    assert.eq(bits.popCount(0b1010_0110), 4);
    assert.eq(bits.popCount(bits.shl(1, 63)), 1);
}

// `popCount` reads the bit pattern, so it is exact even where the value is
// not: `maxValue<I64>()` is already the rounded 2^63 by the time it gets
// here, and one set bit is the honest answer for that number.
test "popCount of minus one is the whole width" {
    assert.eq(bits.popCount(-1), 64);
    assert.eq(bits.popCount(9007199254740991), 53);
    assert.eq(bits.popCount(num.minValue<I64>()), 1);
}

test "leadingZeros counts from the top" {
    assert.eq(bits.leadingZeros(0), 64);
    assert.eq(bits.leadingZeros(1), 63);
    assert.eq(bits.leadingZeros(2), 62);
    assert.eq(bits.leadingZeros(255), 56);
    assert.eq(bits.leadingZeros(-1), 0);
    assert.eq(bits.leadingZeros(num.minValue<I64>()), 0);
}

test "trailingZeros counts from the bottom" {
    assert.eq(bits.trailingZeros(0), 64);
    assert.eq(bits.trailingZeros(1), 0);
    assert.eq(bits.trailingZeros(6), 1);
    assert.eq(bits.trailingZeros(8), 3);
    assert.eq(bits.trailingZeros(-1), 0);
    assert.eq(bits.trailingZeros(num.minValue<I64>()), 63);
}

test "leadingZeros and trailingZeros bracket a single bit" {
    assert.eq(
        bits.leadingZeros(bits.shl(1, 20)) + bits.trailingZeros(bits.shl(1, 20)),
        63,
    );
    assert.eq(
        bits.leadingZeros(bits.shl(1, 40)) + bits.trailingZeros(bits.shl(1, 40)),
        63,
    );
    assert.eq(bits.popCount(bits.shl(1, 40)), 1);
}

// --- Rotation --------------------------------------------------------------------------------

test "rotateLeft moves bits up and brings them back around" {
    assert.eq(bits.rotateLeft(1, 1), 2);
    assert.eq(bits.rotateLeft(1, 10), 1024);
    assert.eq(bits.rotateLeft(1, 63), num.minValue<I64>());
    assert.eq(bits.rotateLeft(num.minValue<I64>(), 1), 1);
}

test "rotateRight moves bits down and brings them back around" {
    assert.eq(bits.rotateRight(2, 1), 1);
    assert.eq(bits.rotateRight(1024, 10), 1);
    assert.eq(bits.rotateRight(1, 1), num.minValue<I64>());
    assert.eq(bits.rotateRight(num.minValue<I64>(), 63), 1);
}

test "rotating by zero changes nothing" {
    assert.eq(bits.rotateLeft(12345, 0), 12345);
    assert.eq(bits.rotateRight(12345, 0), 12345);
    assert.eq(bits.rotateLeft(-1, 0), -1);
}

// A rotation is computed on the exact bit pattern, but the result comes back
// as a `number` — so a round trip is the identity only when the INTERMEDIATE
// also fits. Rotating a small value left by a large count does not.
test "rotating one way and back returns the value" {
    assert.eq(bits.rotateRight(bits.rotateLeft(12345, 4), 4), 12345);
    assert.eq(bits.rotateLeft(bits.rotateRight(1234567890123, 0), 0), 1234567890123);
    assert.eq(bits.rotateRight(bits.rotateLeft(-1, 33), 33), -1);
}

test "rotation preserves the number of one bits" {
    assert.eq(bits.popCount(bits.rotateLeft(255, 4)), 8);
    assert.eq(bits.popCount(bits.rotateRight(65280, 4)), 8);
    assert.eq(bits.popCount(bits.rotateLeft(-1, 7)), 64);
}

test "a rotation by the whole width less n is the other rotation by n" {
    assert.eq(bits.rotateLeft(12345, 40), bits.rotateRight(12345, 24));
    assert.eq(bits.rotateRight(987654321, 9), bits.rotateLeft(987654321, 55));
}

// --- The fixed-width forms ------------------------------------------------------------------------

test "shlU8 and shrU8 work inside eight bits" {
    assert.eq(bits.shlU8(1, 0), 1);
    assert.eq(bits.shlU8(1, 7), 128);
    assert.eq(bits.shlU8(3, 2), 12);
    assert.eq(bits.shrU8(255, 4), 15);
    assert.eq(bits.shrU8(128, 7), 1);
    assert.eq(bits.shrU8(1, 1), 0);
}

test "shlU8 drops the bits that leave the byte" {
    assert.eq(bits.shlU8(255, 1), 254);
    assert.eq(bits.shlU8(255, 7), 128);
    assert.eq(bits.shlU8(128, 1), 0);
    assert.eq(bits.shlU8(num.maxValue<U8>(), 4), 240);
}

test "shlU32 and shrU32 work inside thirty-two bits" {
    assert.eq(bits.shlU32(1, 31), 2147483648);
    assert.eq(bits.shlU32(1, 0), 1);
    assert.eq(bits.shlU32(4294967295, 1), 4294967294);
    assert.eq(bits.shrU32(4294967295, 16), 65535);
    assert.eq(bits.shrU32(num.maxValue<U32>(), 31), 1);
    assert.eq(bits.shrU32(2147483648, 31), 1);
}

// Shifting right is the direction that stays representable: it can only make
// the value smaller.
test "shlU64 and shrU64 work inside sixty-four bits" {
    assert.eq(bits.shlU64(1, 52), 4503599627370496);
    assert.eq(bits.shlU64(1, 0), 1);
    assert.eq(bits.shlU64(9007199254740991, 0), 9007199254740991);
    assert.eq(bits.shrU64(9007199254740991, 32), 2097151);
    assert.eq(bits.shrU64(9223372036854775808, 63), 1);
}

test "the unsigned and the signed shifts agree on a value that fits both" {
    assert.eq(bits.shlU64(1024, 5).wrapToI64(), bits.shl(1024, 5));
    assert.eq(bits.shrU64(1024, 5).wrapToI64(), bits.shr(1024, 5));
    assert.eq(bits.shlU32(1024, 5).toI64(), bits.shl(1024, 5));
    assert.eq(bits.shlU8(3, 5).toI64(), bits.shl(3, 5));
}

test "shifting by zero changes nothing at any width" {
    assert.eq(bits.shl(-12345, 0), -12345);
    assert.eq(bits.shr(12345, 0), 12345);
    assert.eq(bits.sar(-12345, 0), -12345);
    assert.eq(bits.shlU8(200, 0), 200);
    assert.eq(bits.shrU32(4294967295, 0), 4294967295);
    assert.eq(bits.shlU64(9007199254740991, 0), 9007199254740991);
}

// --- the bitwise operators are 64-bit ------------------------------------------------
//
// `Int` is `I64`, and JavaScript's `&`, `|`, `^` and `~` coerce to 32-bit
// signed — so on the only backend these had to stop being the native operators
// somewhere above bit 31. They did not, and every one of these was wrong until
// `core/bitset` walked into it.

test "or keeps bits above 31" {
    assert.eq(0 | bits.shl(1, 31), 2147483648);
    assert.eq(0 | bits.shl(1, 40), 1099511627776);
}

test "and keeps bits above 31" {
    assert.eq(bits.shl(1, 40) & bits.shl(1, 40), bits.shl(1, 40));
    assert.eq(bits.shl(1, 31) & bits.shl(1, 31), 2147483648);
}

test "xor keeps bits above 31" {
    assert.eq(bits.shl(1, 40) ^ 0, 1099511627776);
    assert.eq(bits.shl(1, 40) ^ bits.shl(1, 40), 0);
}

test "not is the 64-bit complement" {
    // The literals are bound first: `~` needs a type, and a bare literal has
    // not been pinned to one yet.
    let zero: Int = 0;
    let minusOne: Int = -1;
    assert.eq(~zero, -1);
    assert.eq(~minusOne, 0);
    // Two's complement: ~x == -x - 1, which only holds if the width is right.
    assert.eq(~bits.shl(1, 40), -bits.shl(1, 40) - 1);
}

// The same defect one width down: the native operators return a *signed*
// 32-bit result, so an unsigned type whose value has the top bit set came back
// negative, and `~` on a narrow unsigned type flipped bits the type does not
// have.
test "unsigned bitwise results stay unsigned" {
    let hi: U32 = 2147483648;
    let zeroU32: U32 = 0;
    assert.eq(hi | zeroU32, 2147483648);
    assert.eq(hi & hi, 2147483648);
    assert.eq(hi ^ zeroU32, 2147483648);
    assert.eq(~zeroU32, 4294967295);
}

test "a narrow unsigned complement stays inside its width" {
    let zeroU8: U8 = 0;
    let zeroU16: U16 = 0;
    assert.eq(~zeroU8, 255);
    assert.eq(~zeroU16, 65535);
}

test "the operators agree with popCount about how many bits there are" {
    assert.eq(bits.popCount(0 | bits.shl(1, 31)), 1);
    assert.eq(bits.popCount(bits.shl(1, 40) | bits.shl(1, 20)), 2);
    let zero: Int = 0;
    assert.eq(bits.popCount(~zero), 64);
}
