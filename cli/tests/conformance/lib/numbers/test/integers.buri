// Integer arithmetic — SPEC 5.1.1 (the widths, and how a literal is pinned),
// 6.2 (what `+ - * / %` mean), and 6.2.2 (`Checked`, `Wrapping`, `Saturating`,
// `Bounded`).
//
// The rules below are asserted at several widths, because the same answer has
// to come out of each one — and on the JavaScript backend the widths are not
// one representation: up to 32 bits an integer is a `number`, and at 64 and
// above it is a `BigInt`. Both are exact at their own width, which is what
// makes these assertions the same assertions on every backend.
//
// Nothing here is allowed to overflow, which is undefined behaviour (SPEC 6.2),
// or to divide by zero, which aborts and would end the test process. Division
// by zero is covered elsewhere; every value below sits inside its type's own
// range, on purpose.

from "core/number" import * as number;
from "core/number" import { Add, Bounded, Wrapping };
from "core/order" import { Order };
from "core/testing/assert" import * as assert;

// --- Helpers ------------------------------------------------------------------
//
// `a == (a / b) * b + (a % b)` is the law SPEC 6.2 states for every non-zero
// `b`. One reconstruction per representation, so the law is checked on the
// `number` side and on the `bigint` side.

fn recI8(a: I8, b: I8): I8 {
    a / b * b + a % b
}

fn recI32(a: I32, b: I32): I32 {
    a / b * b + a % b
}

fn recInt(a: Int, b: Int): Int {
    a / b * b + a % b
}

fn recI128(a: I128, b: I128): I128 {
    a / b * b + a % b
}

fn recU64(a: U64, b: U64): U64 {
    a / b * b + a % b
}

fn takesU8(x: U8): U8 {
    x
}

fn takesI128(x: I128): I128 {
    x
}

fn takesU32(x: U32): U32 {
    x
}

fn asInt(x: Int): Int {
    x
}

fn asI64(x: I64): I64 {
    x
}

// SPEC 5.1.1: arithmetic reaches a type parameter through the operator traits,
// so the same generic body has to work on both machine representations.

fn sum3<N: Add>(a: N, b: N, c: N): N {
    a + b + c
}

fn wrapSum<N: Wrapping>(a: N, b: N): N {
    a.wrappingAdd(b)
}

fn ceilingOf<N: Bounded>(): N {
    number.maxValue<N>()
}

// --- Arithmetic, one width at a time -------------------------------------------

test "I8 adds, subtracts, multiplies and divides inside its range" {
    let a: I8 = 100;
    let b: I8 = 27;
    assert.equal(a + b, 127);
    assert.equal(a - b, 73);
    let c: I8 = 12;
    let d: I8 = -10;
    assert.equal(c * d, -120);
    assert.equal(c / d, -1);
    assert.equal(c % d, 2);
}

test "I16 adds, subtracts, multiplies and divides inside its range" {
    let a: I16 = 30000;
    let b: I16 = 2767;
    assert.equal(a + b, 32767);
    assert.equal(a - b, 27233);
    let c: I16 = 300;
    let d: I16 = -100;
    assert.equal(c * d, -30000);
    assert.equal(c / d, -3);
    assert.equal(c % d, 0);
}

test "I32 adds, subtracts, multiplies and divides inside its range" {
    let a: I32 = 2000000000;
    let b: I32 = 147483647;
    assert.equal(a + b, 2147483647);
    assert.equal(a - b, 1852516353);
    let c: I32 = 46340;
    let d: I32 = 46341;
    assert.equal(c * d, 2147441940);
    assert.equal(c / 1000, 46);
    assert.equal(c % 1000, 340);
}

test "I64 adds, subtracts, multiplies and divides inside its range" {
    let a: I64 = 9007199254740990;
    assert.equal(a + 1, 9007199254740991);
    assert.equal(a - 6, 9007199254740984);
    let b: I64 = 4503599627370495;
    assert.equal(b * 2, 9007199254740990);
    assert.equal(a / 1000000000, 9007199);
    assert.equal(a % 1000000000, 254740990);
}

// The reported case: a nanosecond Unix timestamp is past 2^53 today, and every
// digit of it has to survive the arithmetic (buri-lang/buri#8).
test "I64 keeps every digit above two to the fifty-third" {
    let value: I64 = 1704067200123456789;
    assert.equal(value % 1000000000, 123456789);
    assert.equal(value / 1000000000, 1704067200);
    let seconds: I64 = 1704067200;
    assert.equal(seconds * 1000000000 + 123456789, value);
}

test "I64 arithmetic is exact up to its own maximum" {
    let top: I64 = 9223372036854775807;
    assert.equal(top - 1, 9223372036854775806);
    assert.equal(top / 2, 4611686018427387903);
    assert.equal(top % 1000, 807);
    let bottom: I64 = -9223372036854775808;
    assert.equal(bottom + 1, -9223372036854775807);
}

test "I128 adds, subtracts, multiplies and divides inside its range" {
    let a: I128 = 170141183460469231731687303715884105726;
    assert.equal(a + 1, 170141183460469231731687303715884105727);
    let b: I128 = 9223372036854775808;
    assert.equal(b * b, 85070591730234615865843651857942052864);
    assert.equal(a / 2, 85070591730234615865843651857942052863);
    assert.equal(a % 2, 0);
}

// The reported case: nanoseconds since the epoch held as an `I128`, where the
// low digits are the ones that carry the meaning (buri-lang/buri#4).
test "I128 keeps the low digits of a nanosecond timestamp" {
    let seconds: I128 = 1700000000;
    let nanoseconds: I128 = seconds * 1000000000 + 123456789;
    assert.equal(nanoseconds, 1700000000123456789);
    assert.equal(nanoseconds % 1000000000, 123456789);
    assert.equal(assert.ok(nanoseconds.toI64()), 1700000000123456789);
}

test "U8 adds, subtracts, multiplies and divides inside its range" {
    let a: U8 = 200;
    let b: U8 = 55;
    assert.equal(a + b, 255);
    assert.equal(a - b, 145);
    let c: U8 = 15;
    let d: U8 = 17;
    assert.equal(c * d, 255);
    assert.equal(a / 7, 28);
    assert.equal(a % 7, 4);
}

test "U16 adds, subtracts, multiplies and divides inside its range" {
    let a: U16 = 65000;
    let b: U16 = 535;
    assert.equal(a + b, 65535);
    assert.equal(a - b, 64465);
    let c: U16 = 300;
    let d: U16 = 218;
    assert.equal(c * d, 65400);
    assert.equal(a / 1000, 65);
    assert.equal(a % 1000, 0);
}

test "U32 adds, subtracts, multiplies and divides inside its range" {
    let a: U32 = 4294967000;
    let b: U32 = 295;
    assert.equal(a + b, 4294967295);
    assert.equal(a - b, 4294966705);
    let c: U32 = 65535;
    assert.equal(c * c, 4294836225);
    assert.equal(a / 1000000, 4294);
    assert.equal(a % 1000000, 967000);
}

test "U64 adds, subtracts, multiplies and divides inside its range" {
    let a: U64 = 9007199254740990;
    assert.equal(a + 1, 9007199254740991);
    assert.equal(a - 14, 9007199254740976);
    let c: U64 = 67108863;
    assert.equal(c * c, 4503599493152769);
    assert.equal(a / 1000000000, 9007199);
    assert.equal(a % 1000000000, 254740990);
}

test "U64 arithmetic is exact up to its own maximum" {
    let top: U64 = 18446744073709551615;
    assert.equal(top - 1, 18446744073709551614);
    assert.equal(top / 3, 6148914691236517205);
    assert.equal(top % 1000, 615);
    let big: U64 = 4294967296;
    assert.equal(big * big - 1, top);
}

test "U128 adds, subtracts, multiplies and divides inside its range" {
    let a: U128 = 340282366920938463463374607431768211454;
    assert.equal(a + 1, 340282366920938463463374607431768211455);
    assert.equal(a - 454, 340282366920938463463374607431768211000);
    let c: U128 = 18446744073709551615;
    assert.equal(c * c, 340282366920938463426481119284349108225);
    assert.equal(a / 2, 170141183460469231731687303715884105727);
    assert.equal(a % 2, 0);
}

// --- The two representations have to agree --------------------------------------

test "I32 and I64 agree on the same product" {
    let a32: I32 = 46340;
    let b32: I32 = 46341;
    let a64: I64 = 46340;
    let b64: I64 = 46341;
    assert.equal((a32 * b32).toI64(), a64 * b64);
}

test "U32 and U64 agree on the same product" {
    let a32: U32 = 65535;
    let a64: U64 = 65535;
    assert.equal((a32 * a32).toU64(), a64 * a64);
}

test "every signed width divides a negative dividend the same way" {
    let a8: I8 = -7;
    let b8: I8 = 2;
    let a16: I16 = -7;
    let b16: I16 = 2;
    let a32: I32 = -7;
    let b32: I32 = 2;
    let a64: I64 = -7;
    let b64: I64 = 2;
    let a128: I128 = -7;
    let b128: I128 = 2;
    assert.equal((a8 / b8).toI128(), -3);
    assert.equal((a16 / b16).toI128(), -3);
    assert.equal((a32 / b32).toI128(), -3);
    assert.equal((a64 / b64).toI128(), -3);
    assert.equal(a128 / b128, -3);
}

test "every signed width takes the remainder's sign from the dividend" {
    let a8: I8 = -7;
    let a16: I16 = -7;
    let a32: I32 = -7;
    let a64: I64 = -7;
    let a128: I128 = -7;
    assert.equal((a8 % 2).toI128(), -1);
    assert.equal((a16 % 2).toI128(), -1);
    assert.equal((a32 % 2).toI128(), -1);
    assert.equal((a64 % 2).toI128(), -1);
    assert.equal(a128 % 2, -1);
}

test "every unsigned width agrees on the same sum" {
    let a8: U8 = 200;
    let a16: U16 = 200;
    let a32: U32 = 200;
    let a64: U64 = 200;
    let a128: U128 = 200;
    assert.equal((a8 + 55).toU128(), 255);
    assert.equal((a16 + 55).toU128(), 255);
    assert.equal((a32 + 55).toU128(), 255);
    assert.equal((a64 + 55).toU128(), 255);
    assert.equal(a128 + 55, 255);
}

test "a value that fits every width multiplies the same everywhere" {
    let a8: I8 = 11;
    let a16: I16 = 11;
    let a32: I32 = 11;
    let a64: I64 = 11;
    let a128: I128 = 11;
    assert.equal((a8 * 11).toI128(), 121);
    assert.equal((a16 * 11).toI128(), 121);
    assert.equal((a32 * 11).toI128(), 121);
    assert.equal((a64 * 11).toI128(), 121);
    assert.equal(a128 * 11, 121);
}

// --- Boundaries -----------------------------------------------------------------

test "maxValue of every signed width" {
    assert.equal(number.maxValue<I8>(), 127);
    assert.equal(number.maxValue<I16>(), 32767);
    assert.equal(number.maxValue<I32>(), 2147483647);
    assert.equal(number.maxValue<I64>(), 9223372036854775807);
    assert.equal(number.maxValue<I128>(), 170141183460469231731687303715884105727);
}

test "minValue of every signed width" {
    // Widened before comparing, so the check does not lean on the literal form
    // of the minimum; the test below covers that separately.
    assert.equal(number.minValue<I8>().toI64(), -128);
    assert.equal(number.minValue<I16>().toI64(), -32768);
    assert.equal(number.minValue<I32>().toI64(), -2147483648);
    assert.equal(number.minValue<I64>().toI128(), -9223372036854775808);
    assert.equal(number.minValue<I128>() + 1, -170141183460469231731687303715884105727);
}

test "maxValue of the unsigned widths below 128 bits" {
    assert.equal(number.maxValue<U8>(), 255);
    assert.equal(number.maxValue<U16>(), 65535);
    assert.equal(number.maxValue<U32>(), 4294967295);
    assert.equal(number.maxValue<U64>(), 18446744073709551615);
}

test "U128's maxValue is two to the 128th minus one" {
    assert.equal(number.maxValue<U128>(), 340282366920938463463374607431768211455);
}

test "minValue of every unsigned width is zero" {
    assert.equal(number.minValue<U8>(), 0);
    assert.equal(number.minValue<U16>(), 0);
    assert.equal(number.minValue<U32>(), 0);
    assert.equal(number.minValue<U64>(), 0);
    assert.equal(number.minValue<U128>(), 0);
}

test "adding one right at the top of each unsigned width" {
    let a: U8 = 254;
    let b: U16 = 65534;
    let c: U32 = 4294967294;
    let d: U64 = 18446744073709551614;
    let e: U128 = 340282366920938463463374607431768211454;
    assert.equal(a + 1, number.maxValue<U8>());
    assert.equal(b + 1, number.maxValue<U16>());
    assert.equal(c + 1, number.maxValue<U32>());
    assert.equal(d + 1, number.maxValue<U64>());
    assert.equal(e + 1, 340282366920938463463374607431768211455);
}

test "subtracting one right at the bottom of each signed width" {
    let a: I8 = -127;
    let b: I16 = -32767;
    let c: I32 = -2147483647;
    let d: I64 = -9223372036854775807;
    let e: I128 = -170141183460469231731687303715884105727;
    assert.equal(a - 1, number.minValue<I8>());
    assert.equal(b - 1, number.minValue<I16>());
    assert.equal(c - 1, number.minValue<I32>());
    assert.equal(d - 1, number.minValue<I64>());
    assert.equal(e - 1, number.minValue<I128>());
}

test "negating maxValue lands one above minValue" {
    let a: I8 = 127;
    let b: I32 = 2147483647;
    let c: I64 = 9223372036854775807;
    assert.equal(-a, number.minValue<I8>() + 1);
    assert.equal(-b, number.minValue<I32>() + 1);
    assert.equal(-c, number.minValue<I64>() + 1);
}

test "subtracting down to zero from the top of a width" {
    let a: U8 = 255;
    assert.equal(a - 255, 0);
    let b: U64 = 18446744073709551615;
    assert.equal(b - 18446744073709551615, 0);
    let c: U128 = 340282366920938463463374607431768211455;
    assert.equal(c - 340282366920938463463374607431768211455, 0);
}

test "maxValue divided by itself is one at every width" {
    assert.equal(number.maxValue<U8>() / number.maxValue<U8>(), 1);
    assert.equal(number.maxValue<I32>() / number.maxValue<I32>(), 1);
    assert.equal(number.maxValue<U64>() / number.maxValue<U64>(), 1);
    assert.equal(number.maxValue<I128>() / number.maxValue<I128>(), 1);
}

// --- Division and remainder -----------------------------------------------------

test "integer division truncates toward zero" {
    assert.equal(7 / 2, 3);
    assert.equal(-7 / 2, -3);
    assert.equal(7 / -2, -3);
    assert.equal(-7 / -2, 3);
    assert.equal(1 / 2, 0);
    assert.equal(-1 / 2, 0);
}

test "the remainder takes the sign of the dividend" {
    assert.equal(7 % 2, 1);
    assert.equal(-7 % 2, -1);
    assert.equal(7 % -2, 1);
    assert.equal(-7 % -2, -1);
}

test "division truncates toward zero at I8" {
    let a: I8 = -7;
    let b: I8 = 2;
    assert.equal(a / b, -3);
    assert.equal(a % b, -1);
    let c: I8 = 7;
    let d: I8 = -2;
    assert.equal(c / d, -3);
    assert.equal(c % d, 1);
}

test "division truncates toward zero at I32" {
    let a: I32 = -2000000007;
    let b: I32 = 1000000000;
    assert.equal(a / b, -2);
    assert.equal(a % b, -7);
}

test "division truncates toward zero at I128" {
    let a: I128 = -9007199254740991;
    assert.equal(a / 10, -900719925474099);
    assert.equal(a % 10, -1);
}

test "the division identity holds for every sign combination at Int" {
    assert.equal(recInt(7, 2), 7);
    assert.equal(recInt(-7, 2), -7);
    assert.equal(recInt(7, -2), 7);
    assert.equal(recInt(-7, -2), -7);
    assert.equal(recInt(100, 7), 100);
    assert.equal(recInt(-100, 7), -100);
    assert.equal(recInt(100, -7), 100);
    assert.equal(recInt(-100, -7), -100);
}

test "the division identity holds for every sign combination at I8" {
    assert.equal(recI8(7, 2), 7);
    assert.equal(recI8(-7, 2), -7);
    assert.equal(recI8(7, -2), 7);
    assert.equal(recI8(-7, -2), -7);
    assert.equal(recI8(127, 5), 127);
    assert.equal(recI8(-127, 5), -127);
    assert.equal(recI8(127, -5), 127);
    assert.equal(recI8(-127, -5), -127);
}

test "the division identity holds for every sign combination at I32" {
    assert.equal(recI32(2147483647, 3), 2147483647);
    assert.equal(recI32(-2147483647, 3), -2147483647);
    assert.equal(recI32(2147483647, -3), 2147483647);
    assert.equal(recI32(-2147483647, -3), -2147483647);
}

test "the division identity holds for every sign combination at I128" {
    assert.equal(recI128(9007199254740991, 3), 9007199254740991);
    assert.equal(recI128(-9007199254740991, 3), -9007199254740991);
    assert.equal(recI128(9007199254740991, -3), 9007199254740991);
    assert.equal(recI128(-9007199254740991, -3), -9007199254740991);
}

test "the division identity holds for U64" {
    assert.equal(recU64(9007199254740991, 7), 9007199254740991);
    assert.equal(recU64(0, 7), 0);
    assert.equal(recU64(1, 9007199254740991), 1);
    assert.equal(recU64(1000000007, 1000000000), 1000000007);
}

test "dividing a smaller magnitude by a larger gives zero" {
    assert.equal(3 / 10, 0);
    assert.equal(-3 / 10, 0);
    assert.equal(3 / -10, 0);
    let a: U8 = 3;
    assert.equal(a / 10, 0);
    let b: I128 = -3;
    assert.equal(b / 10, 0);
}

test "an exact division leaves no remainder" {
    assert.equal(100 % 10, 0);
    assert.equal(-100 % 10, 0);
    assert.equal(100 % -10, 0);
    let a: U64 = 9007199254740990;
    assert.equal(a % 5, 0);
    let b: I128 = -9007199254740990;
    assert.equal(b % 10, 0);
}

test "zero divided by anything is zero, at both representations" {
    let a: I32 = 0;
    let b: I64 = 0;
    let c: U128 = 0;
    assert.equal(a / -5, 0);
    assert.equal(b / -5, 0);
    assert.equal(c / 5, 0);
    assert.equal(a % -5, 0);
    assert.equal(b % -5, 0);
}

// --- Floor division and the Euclidean remainder ------------------------------------
//
// `number.divideFloor` and `number.remainderEuclidean` are the other rounding, the one `/` and
// `%` deliberately do not do. Every assertion below is at `Int`, because that
// is the only type they take, and the zero-divisor case is not here: it aborts,
// which ends the process, so it lives in `cli/tests/crash/`.

test "divideFloor rounds toward negative infinity where division truncates" {
    // The pair that shows the difference: `/` rounds toward zero from both
    // sides, so its quotient jumps by one across the origin.
    assert.equal(7 / 2, 3);
    assert.equal(number.divideFloor(7, 2), 3);
    assert.equal(-7 / 2, -3);
    assert.equal(number.divideFloor(-7, 2), -4);
    assert.equal(number.divideFloor(-1, 2), -1);
    assert.equal(number.divideFloor(1, 2), 0);
}

test "divideFloor follows the sign of the divisor" {
    assert.equal(number.divideFloor(7, -2), -4);
    assert.equal(number.divideFloor(-7, -2), 3);
    assert.equal(number.divideFloor(1, -2), -1);
    assert.equal(number.divideFloor(-1, -2), 0);
}

test "divideFloor is division wherever the division is exact" {
    assert.equal(number.divideFloor(8, 2), 4);
    assert.equal(number.divideFloor(-8, 2), -4);
    assert.equal(number.divideFloor(8, -2), -4);
    assert.equal(number.divideFloor(-8, -2), 4);
    assert.equal(number.divideFloor(0, 5), 0);
    assert.equal(number.divideFloor(0, -5), 0);
    assert.equal(number.divideFloor(5, 1), 5);
    assert.equal(number.divideFloor(-5, 1), -5);
}

test "remainderEuclidean is never negative, where the remainder takes the dividend's sign" {
    assert.equal(-7 % 2, -1);
    assert.equal(number.remainderEuclidean(-7, 2), 1);
    assert.equal(number.remainderEuclidean(7, 2), 1);
    assert.equal(number.remainderEuclidean(-1, 2), 1);
    assert.equal(number.remainderEuclidean(0, 2), 0);
    assert.equal(number.remainderEuclidean(-8, 2), 0);
}

test "remainderEuclidean is never negative for a negative divisor either" {
    // `(x % n + n) % n`, the idiom this replaces, answers `-1` for these.
    assert.equal(number.remainderEuclidean(7, -3), 1);
    assert.equal(number.remainderEuclidean(-7, -3), 2);
    assert.equal(number.remainderEuclidean(-1, -3), 2);
    assert.equal(number.remainderEuclidean(0, -3), 0);
}

test "divideFloor and remainderEuclidean reconstruct the dividend for a positive divisor" {
    // The law that makes the pair usable, and it is stated for `b > 0` only:
    // below zero `divideFloor` follows the divisor's sign and `remainderEuclidean` does
    // not, so the two are not a matching quotient and remainder there.
    assert.equal(number.divideFloor(7, 3) * 3 + number.remainderEuclidean(7, 3), 7);
    assert.equal(number.divideFloor(-7, 3) * 3 + number.remainderEuclidean(-7, 3), -7);
    assert.equal(number.divideFloor(0, 3) * 3 + number.remainderEuclidean(0, 3), 0);
    assert.equal(number.divideFloor(-1, 7) * 7 + number.remainderEuclidean(-1, 7), -1);
    assert.equal(
        number.divideFloor(86399999, 86400000) * 86400000
            + number.remainderEuclidean(86399999, 86400000),
        86399999,
    );
    assert.equal(
        number.divideFloor(-86400001, 86400000) * 86400000
            + number.remainderEuclidean(-86400001, 86400000),
        -86400001,
    );
}

test "divideFloor and remainderEuclidean hold at the far end of I64" {
    // Both are `Int`, which is `I64`, so the values a calendar actually reaches
    // are nowhere near the top — these are here because the JavaScript backend
    // holds an `I64` as a `BigInt` and the native one as a register, and a
    // number past 2^53 is where those two would part if they were going to.
    assert.equal(number.divideFloor(9007199254740993, 2), 4503599627370496);
    assert.equal(number.remainderEuclidean(9007199254740993, 2), 1);
    assert.equal(number.divideFloor(-9007199254740993, 2), -4503599627370497);
    assert.equal(number.remainderEuclidean(-9007199254740993, 2), 1);
    assert.equal(number.divideFloor(9223372036854775807, 1000), 9223372036854775);
    assert.equal(number.remainderEuclidean(-9223372036854775807, 1000), 193);
}

// --- Literals -------------------------------------------------------------------

test "hex literals equal their decimal value" {
    assert.equal(0xFF, 255);
    assert.equal(0x10, 16);
    assert.equal(0x0, 0);
    assert.equal(0x7FFFFFFF, 2147483647);
    assert.equal(0xdeadbeef, 3735928559);
}

test "octal literals equal their decimal value" {
    assert.equal(0o755, 493);
    assert.equal(0o10, 8);
    assert.equal(0o0, 0);
    assert.equal(0o777, 511);
}

test "binary literals equal their decimal value" {
    assert.equal(0b1010_0110, 166);
    assert.equal(0b0, 0);
    assert.equal(0b1, 1);
    assert.equal(0b1111_1111, 255);
}

test "underscores are digit separators and change nothing" {
    assert.equal(1_000_000, 1000000);
    assert.equal(0xFF_FF, 65535);
    assert.equal(0b1_0, 2);
    assert.equal(1_0, 10);
    assert.equal(9_223_372_036_854_775_807, 9223372036854775807);
}

test "a literal pinned by an annotation gets that type" {
    let a: U8 = 0xFF;
    assert.equal(a, number.maxValue<U8>());
    let b: I16 = 0b1000_0000;
    assert.equal(b, 128);
    let c: U128 = 0o7;
    assert.equal(c, 7);
}

test "a literal pinned by a parameter gets that type" {
    assert.equal(takesU8(255), number.maxValue<U8>());
    assert.equal(takesU32(4294967295), number.maxValue<U32>());
    assert.equal(
        takesI128(170141183460469231731687303715884105727),
        number.maxValue<I128>(),
    );
}

test "an unconstrained integer literal defaults to Int" {
    let a = 5;
    let b: I64 = 5;
    assert.equal(a, b);
    let wide = 9_223_372_036_854_775_806;
    assert.equal(wide + 1, number.maxValue<I64>());
}

test "a literal in an array element position is pinned by the array's type" {
    let xs: [U8] = [1, 2, 255];
    assert.equal(assert.some(xs[2]), number.maxValue<U8>());
    assert.equal(assert.some(xs[0]) + assert.some(xs[1]), 3);
}

// --- Checked ---------------------------------------------------------------------

test "checkedAdd is Some when the sum fits in U8" {
    let a: U8 = 250;
    assert.equal(assert.some(a.checkedAdd(5)), 255);
    assert.equal(assert.some(a.checkedAdd(0)), 250);
}

test "checkedAdd is None when the sum leaves U8" {
    let a: U8 = 255;
    assert.none(a.checkedAdd(1));
    let b: U8 = 200;
    assert.none(b.checkedAdd(100));
}

test "checkedAdd at the I8 boundary" {
    let a: I8 = 126;
    assert.equal(assert.some(a.checkedAdd(1)), 127);
    let b: I8 = 127;
    assert.none(b.checkedAdd(1));
    assert.none(number.minValue<I8>().checkedAdd(-1));
}

test "checkedAdd at the I32 and U32 boundaries" {
    let a: I32 = 2147483646;
    assert.equal(assert.some(a.checkedAdd(1)), 2147483647);
    assert.none(a.checkedAdd(2));
    let b: U32 = 4294967294;
    assert.equal(assert.some(b.checkedAdd(1)), 4294967295);
    assert.none(b.checkedAdd(2));
}

// `Checked` is bounded by the numbers the backend has (SPEC 6.2.2), and at
// every width every backend now has the type's whole range — so `.Some(v)`
// means `v` IS the answer, over the same numbers everywhere.
test "checkedAdd just below the largest I64 and U64" {
    let a: I64 = 9007199254740990;
    assert.equal(assert.some(a.checkedAdd(1)), 9007199254740991);
    let b: U64 = 9007199254740990;
    assert.equal(assert.some(b.checkedAdd(1)), 9007199254740991);
}

// The sums that used to be `.None` here and `.Some` natively: the band above
// 2^53 and inside the type, which was `VALUE-MODEL.md` §12 row 2.
test "checkedAdd answers Some anywhere inside the type" {
    let a: I64 = 9223372036854775806;
    assert.equal(assert.some(a.checkedAdd(1)), 9223372036854775807);
    let b: U64 = 18446744073709551614;
    assert.equal(assert.some(b.checkedAdd(1)), 18446744073709551615);
    let c: I64 = 1152921504606846976;
    assert.equal(assert.some(c.checkedAdd(1)), 1152921504606846977);
}

test "checkedAdd at the largest I128 sum every backend can name" {
    let a: I128 = 9007199254740990;
    assert.equal(assert.some(a.checkedAdd(1)), 9007199254740991);
}

test "checkedAdd at the largest U128 sum every backend can name" {
    let a: U128 = 1;
    assert.equal(assert.some(a.checkedAdd(1)), 2);
    let b: U128 = 9007199254740990;
    assert.equal(assert.some(b.checkedAdd(1)), 9007199254740991);
}

// Leaving the type's own range is `.None` on every backend, and now for one
// reason rather than two: the addition overflowed.
test "checkedAdd is None when the sum leaves the type at 64 bits and above" {
    assert.none(number.maxValue<I64>().checkedAdd(1));
    assert.none(number.maxValue<U64>().checkedAdd(1));
    assert.none(number.maxValue<I128>().checkedAdd(1));
    assert.none(number.maxValue<U128>().checkedAdd(1));
}

test "checkedSubtract is None below zero for an unsigned type" {
    let a: U8 = 0;
    assert.none(a.checkedSubtract(1));
    let b: U64 = 0;
    assert.none(b.checkedSubtract(1));
    let c: U8 = 5;
    assert.equal(assert.some(c.checkedSubtract(5)), 0);
}

test "checkedSubtract at the signed minimum" {
    assert.none(number.minValue<I8>().checkedSubtract(1));
    assert.none(number.minValue<I64>().checkedSubtract(1));
    let a: I8 = -127;
    assert.equal(assert.some(a.checkedSubtract(1)), number.minValue<I8>());
}

test "checkedMultiply reports whether the product fits" {
    let a: U8 = 16;
    assert.equal(assert.some(a.checkedMultiply(15)), 240);
    assert.none(a.checkedMultiply(16));
    let b: I32 = 46340;
    assert.equal(assert.some(b.checkedMultiply(46341)), 2147441940);
    assert.none(b.checkedMultiply(46342));
}

test "checkedMultiply at the widest types" {
    let a: U64 = 67108863;
    assert.equal(assert.some(a.checkedMultiply(67108863)), 4503599493152769);
    let b: I64 = 94906265;
    assert.equal(assert.some(b.checkedMultiply(94906265)), 9007199136250225);
    // 2^32 * 2^32 is 2^64, which is past `U64` and past `I64` — so `.None` on
    // every backend, rather than only on the one that cannot name the product.
    // A product that fits its type but not a `number` is row 2's divergence and
    // is asserted in `cli/tests/native/agreement.rs` instead.
    let c: U64 = 4294967296;
    assert.none(c.checkedMultiply(4294967296));
    let d: I64 = 4294967296;
    assert.none(d.checkedMultiply(4294967296));
}

test "checkedDivide by zero is None rather than a crash" {
    let a: U8 = 10;
    assert.none(a.checkedDivide(0));
    let b: I64 = 10;
    assert.none(b.checkedDivide(0));
    let c: I128 = -10;
    assert.none(c.checkedDivide(0));
    let d: I32 = 0;
    assert.none(d.checkedDivide(0));
}

test "checkedDivide of minValue by minus one is None" {
    assert.none(number.minValue<I8>().checkedDivide(-1));
    assert.none(number.minValue<I32>().checkedDivide(-1));
    assert.none(number.minValue<I64>().checkedDivide(-1));
    assert.none(number.minValue<I128>().checkedDivide(-1));
}

test "checkedDivide truncates toward zero like ordinary division" {
    let a: I32 = -7;
    assert.equal(assert.some(a.checkedDivide(2)), -3);
    let b: I64 = -7;
    assert.equal(assert.some(b.checkedDivide(2)), -3);
    let c: U8 = 200;
    assert.equal(assert.some(c.checkedDivide(7)), 28);
}

// --- Wrapping ---------------------------------------------------------------------

test "wrappingAdd wraps at the top of U8" {
    let a: U8 = 255;
    assert.equal(a.wrappingAdd(1), 0);
    assert.equal(a.wrappingAdd(2), 1);
    let b: U8 = 250;
    assert.equal(b.wrappingAdd(10), 4);
}

test "wrappingSubtract wraps below zero for U8" {
    let a: U8 = 0;
    assert.equal(a.wrappingSubtract(1), 255);
    assert.equal(a.wrappingSubtract(255), 1);
    assert.equal(a.wrappingSubtract(0), 0);
}

test "wrappingAdd wraps at the top of I8" {
    let a: I8 = 127;
    assert.equal(a.wrappingAdd(1), number.minValue<I8>());
    assert.equal(a.wrappingAdd(2), -127);
    assert.equal(number.minValue<I8>().wrappingSubtract(1), 127);
}

test "wrappingMultiply at U8" {
    let a: U8 = 16;
    assert.equal(a.wrappingMultiply(16), 0);
    let b: U8 = 200;
    assert.equal(b.wrappingMultiply(3), 88);
    let c: U8 = 255;
    assert.equal(c.wrappingMultiply(255), 1);
}

test "wrapping at the I32 and U32 boundaries" {
    let a: I32 = 2147483647;
    assert.equal(a.wrappingAdd(1), number.minValue<I32>());
    let b: U32 = 4294967295;
    assert.equal(b.wrappingAdd(1), 0);
    assert.equal(b.wrappingMultiply(2), 4294967294);
    let c: U32 = 0;
    assert.equal(c.wrappingSubtract(1), 4294967295);
}

test "wrapping at the I64 and U64 boundaries" {
    let a: I64 = 9223372036854775807;
    assert.equal(a.wrappingAdd(1), number.minValue<I64>());
    let b: U64 = 18446744073709551615;
    assert.equal(b.wrappingAdd(1), 0);
    let c: U64 = 4294967296;
    assert.equal(c.wrappingMultiply(4294967296), 0);
    let d: U64 = 0;
    assert.equal(d.wrappingSubtract(1), 18446744073709551615);
}

test "wrapping at the I128 and U128 boundaries" {
    let a: I128 = 170141183460469231731687303715884105727;
    assert.equal(a.wrappingAdd(1), number.minValue<I128>());
    let b: U128 = 340282366920938463463374607431768211455;
    assert.equal(b.wrappingAdd(1), 0);
    let c: U128 = 0;
    assert.equal(c.wrappingSubtract(1), 340282366920938463463374607431768211455);
}

test "a wrapping hash step is the same on both representations" {
    let seed32: U32 = 2166136261;
    let seed64: U64 = 2166136261;
    assert.equal(seed32.wrappingMultiply(31).wrappingAdd(7), 2725714658);
    assert.equal(seed64.wrappingMultiply(31).wrappingAdd(7), 67150224098);
}

test "wrapping leaves a value that fits alone" {
    let a: U8 = 100;
    assert.equal(a.wrappingAdd(50), 150);
    assert.equal(a.wrappingSubtract(50), 50);
    assert.equal(a.wrappingMultiply(2), 200);
    let b: I64 = 100;
    assert.equal(b.wrappingAdd(50), 150);
    assert.equal(b.wrappingMultiply(2), 200);
}

// --- Saturating ----------------------------------------------------------------------

test "saturatingAdd clamps to maxValue" {
    let a: U8 = 250;
    assert.equal(a.saturatingAdd(10), 255);
    let b: I8 = 127;
    assert.equal(b.saturatingAdd(100), 127);
    let c: U64 = 18446744073709551615;
    assert.equal(c.saturatingAdd(1000), 18446744073709551615);
}

test "saturatingSubtract clamps to minValue" {
    let a: U8 = 5;
    assert.equal(a.saturatingSubtract(10), 0);
    assert.equal(number.minValue<I8>().saturatingSubtract(100), number.minValue<I8>());
    let b: U64 = 0;
    assert.equal(b.saturatingSubtract(1), 0);
}

test "saturatingMultiply clamps at both ends" {
    let a: U8 = 200;
    assert.equal(a.saturatingMultiply(2), 255);
    let b: I8 = -100;
    assert.equal(b.saturatingMultiply(3), number.minValue<I8>());
    let c: I32 = 100000;
    assert.equal(c.saturatingMultiply(100000), 2147483647);
}

test "saturating arithmetic leaves a value that fits alone" {
    let a: U8 = 100;
    assert.equal(a.saturatingAdd(50), 150);
    assert.equal(a.saturatingSubtract(50), 50);
    assert.equal(a.saturatingMultiply(2), 200);
    let b: I128 = 100;
    assert.equal(b.saturatingAdd(50), 150);
    assert.equal(b.saturatingMultiply(2), 200);
}

test "saturating arithmetic at the U128 boundary" {
    let a: U128 = 1;
    assert.equal(a.saturatingAdd(1), 2);
    let b: U128 = 340282366920938463463374607431768211455;
    assert.equal(b.saturatingAdd(1), 340282366920938463463374607431768211455);
}

test "saturating on the bigint side clamps to the same bound as maxValue" {
    let a: I64 = 9223372036854775807;
    assert.equal(a.saturatingAdd(1), number.maxValue<I64>());
    assert.equal(a.saturatingMultiply(2), number.maxValue<I64>());
    assert.equal(number.minValue<I64>().saturatingSubtract(1), number.minValue<I64>());
}

// --- min, max, clamp, abs, signum, compare -------------------------------------------

test "min and max pick the right operand" {
    assert.equal(number.min(3, 9), 3);
    assert.equal(number.max(3, 9), 9);
    assert.equal(number.min(-3, -9), -9);
    assert.equal(number.max(-3, -9), -3);
    assert.equal(number.min(4, 4), 4);
    assert.equal(number.max(4, 4), 4);
}

test "min and max on the narrow and the wide widths" {
    let a: U8 = 7;
    let b: U8 = 200;
    assert.equal(number.min(a, b), 7);
    assert.equal(number.max(a, b), 200);
    let c: I128 = -170141183460469231731687303715884105727;
    let d: I128 = 170141183460469231731687303715884105727;
    assert.equal(number.min(c, d), c);
    assert.equal(number.max(c, d), d);
}

test "clamp holds a value between its bounds" {
    assert.equal(number.clamp(0, 10, 42), 10);
    assert.equal(number.clamp(0, 10, -42), 0);
    assert.equal(number.clamp(0, 10, 7), 7);
    assert.equal(number.clamp(0, 10, 0), 0);
    assert.equal(number.clamp(0, 10, 10), 10);
}

test "clamp works at U8 and at I64" {
    let lo: U8 = 10;
    let hi: U8 = 20;
    assert.equal(number.clamp(lo, hi, 255), 20);
    assert.equal(number.clamp(lo, hi, 0), 10);
    let a: I64 = 9223372036854775807;
    assert.equal(number.clamp(-5, 5, a), 5);
}

test "abs of a negative is its magnitude" {
    let a: I8 = -127;
    assert.equal(a.abs(), 127);
    let b: I32 = -2147483647;
    assert.equal(b.abs(), 2147483647);
    let c: I64 = -9223372036854775807;
    assert.equal(c.abs(), 9223372036854775807);
    let d: I128 = -170141183460469231731687303715884105727;
    assert.equal(d.abs(), 170141183460469231731687303715884105727);
}

test "abs of a positive and of zero is itself" {
    let a: I32 = 42;
    let z: I32 = 0;
    assert.equal(a.abs(), 42);
    assert.equal(z.abs(), 0);
    let b: I64 = 42;
    assert.equal(b.abs(), 42);
}

test "signum reports the sign" {
    let a: I32 = -42;
    let b: I32 = 0;
    let c: I32 = 42;
    assert.equal(a.signum(), -1);
    assert.equal(b.signum(), 0);
    assert.equal(c.signum(), 1);
    let d: I128 = -170141183460469231731687303715884105727;
    assert.equal(d.signum(), -1);
    assert.equal(number.maxValue<I64>().signum(), 1);
}

test "compare yields an Order" {
    let a: I32 = 1;
    let b: I32 = 2;
    assert.equal(a.compare(b), Order.Less);
    assert.equal(b.compare(a), Order.Greater);
    assert.equal(a.compare(a), Order.Equal);
    let c: U64 = 18446744073709551615;
    assert.equal(c.compare(0), Order.Greater);
    assert.equal(number.minValue<I128>().compare(0), Order.Less);
}

test "the comparison operators agree with compare" {
    let a: U8 = 7;
    let b: U8 = 200;
    assert.isTrue(a < b);
    assert.isTrue(a <= b);
    assert.isFalse(a > b);
    assert.isFalse(a >= b);
    assert.isTrue(a <= a);
    assert.isTrue(a >= a);
    assert.isTrue(a == a);
    assert.isTrue(a != b);
}

test "the comparison operators work on the bigint widths" {
    let a: I64 = -9223372036854775807;
    let b: I64 = 9223372036854775807;
    assert.isTrue(a < b);
    assert.isFalse(b < a);
    let c: U128 = 340282366920938463463374607431768211455;
    assert.isTrue(c > 0);
    assert.isTrue(number.minValue<I128>() < 0);
}

// --- Aliases and generic numeric code --------------------------------------------------

test "Int and I64 are one type, not two" {
    let a: Int = 5;
    let b: I64 = 5;
    assert.equal(asInt(b), 5);
    assert.equal(asI64(a), 5);
    assert.equal(a + b, 10);
    assert.equal(a, b);
    assert.equal(a.toI128(), b.toI128());
}

test "Uint is U64 and Byte is U8" {
    let a: Uint = 18446744073709551615;
    assert.equal(a, number.maxValue<U64>());
    let b: Byte = 255;
    assert.equal(b, number.maxValue<U8>());
    assert.equal(b + 0, 255);
}

test "a generic Add body gives the same answer at every width" {
    let a8: U8 = 100;
    let a32: I32 = 100;
    let a64: I64 = 100;
    let a128: U128 = 100;
    assert.equal(sum3(a8, 50, 105), 255);
    assert.equal(sum3(a32, 50, 105), 255);
    assert.equal(sum3(a64, 50, 105), 255);
    assert.equal(sum3(a128, 50, 105), 255);
}

test "a generic Wrapping body wraps at each type's own boundary" {
    let a8: U8 = 255;
    let a32: U32 = 4294967295;
    let a64: U64 = 18446744073709551615;
    let a128: U128 = 340282366920938463463374607431768211455;
    assert.equal(wrapSum(a8, 1), 0);
    assert.equal(wrapSum(a32, 1), 0);
    assert.equal(wrapSum(a64, 1), 0);
    assert.equal(wrapSum(a128, 1), 0);
}

test "a generic Bounded body reports each type's own ceiling" {
    let a: U8 = ceilingOf();
    let b: I32 = ceilingOf();
    let c: I64 = ceilingOf();
    assert.equal(a, 255);
    assert.equal(b, 2147483647);
    assert.equal(c, 9223372036854775807);
}

test "the minimum of each signed width is writable as a literal" {
    let a: I8 = -128;
    let b: I16 = -32768;
    let c: I32 = -2147483648;
    let d: I64 = -9223372036854775808;
    let e: I128 = -170141183460469231731687303715884105728;
    assert.equal(a, number.minValue<I8>());
    assert.equal(b, number.minValue<I16>());
    assert.equal(c, number.minValue<I32>());
    assert.equal(d, number.minValue<I64>());
    assert.equal(e, number.minValue<I128>());
}

// --- Checked's other three ------------------------------------------------------
//
// `checkedRemainder`, `checkedNegate` and `checkedPower`, at several widths for
// the reason every other family here is: the answer has to be the same one at
// each, and on JavaScript the widths up to 32 bits are a `number` and the rest
// are a `BigInt`.

test "checkedRemainder answers .None only on a zero divisor" {
    assert.equal(7.checkedRemainder(3), .Some(1));
    assert.equal((-7).checkedRemainder(3), .Some(-1));
    assert.equal(7.checkedRemainder(-3), .Some(1));
    assert.equal(6.checkedRemainder(3), .Some(0));
    assert.equal(7.checkedRemainder(0), .None);
    assert.equal(0.checkedRemainder(5), .Some(0));
}

test "checkedRemainder takes the dividend's sign, as % does" {
    assert.equal((-7).checkedRemainder(3), .Some(-7 % 3));
    assert.equal(7.checkedRemainder(-3), .Some(7 % -3));
}

test "the remainder that has no quotient still has an answer" {
    // `minValue / -1` is `2^63`, which is `.None`; the matching remainder is
    // `0`, which is a value of every width.
    assert.equal(number.minValue<I64>().checkedDivide(-1), .None);
    assert.equal(number.minValue<I64>().checkedRemainder(-1), .Some(0));
    let small: I8 = -128;
    assert.equal(small.checkedDivide(-1), .None);
    assert.equal(small.checkedRemainder(-1), .Some(0));
}

test "checkedRemainder at the unsigned widths" {
    let a: U8 = 200;
    let b: U32 = 4294967295;
    let c: U64 = 18446744073709551615;
    assert.equal(a.checkedRemainder(7), .Some(4));
    assert.equal(b.checkedRemainder(1000), .Some(295));
    assert.equal(c.checkedRemainder(10), .Some(5));
    assert.equal(a.checkedRemainder(0), .None);
}

test "checkedNegate answers .None at the one value with no negative" {
    assert.equal(5.checkedNegate(), .Some(-5));
    assert.equal((-5).checkedNegate(), .Some(5));
    assert.equal(0.checkedNegate(), .Some(0));
    assert.equal(number.maxValue<I64>().checkedNegate(), .Some(-9223372036854775807));
    assert.equal(number.minValue<I64>().checkedNegate(), .None);
}

test "checkedNegate at the narrow signed widths" {
    let a: I8 = -128;
    let b: I8 = -127;
    let c: I32 = -2147483648;
    assert.equal(a.checkedNegate(), .None);
    assert.equal(b.checkedNegate(), .Some(127));
    assert.equal(c.checkedNegate(), .None);
}

test "an unsigned type has a negative for zero and for nothing else" {
    let zero: U8 = 0;
    let one: U8 = 1;
    let wide: U64 = 7;
    assert.equal(zero.checkedNegate(), .Some(0));
    assert.equal(one.checkedNegate(), .None);
    assert.equal(wide.checkedNegate(), .None);
}

test "checkedPower is the empty product at a zero exponent" {
    assert.equal(0.checkedPower(0), .Some(1));
    assert.equal(7.checkedPower(0), .Some(1));
    assert.equal((-7).checkedPower(0), .Some(1));
    let a: U8 = 3;
    assert.equal(a.checkedPower(0), .Some(1));
}

test "checkedPower multiplies the base by itself" {
    assert.equal(2.checkedPower(10), .Some(1024));
    assert.equal(3.checkedPower(5), .Some(243));
    assert.equal(10.checkedPower(18), .Some(1000000000000000000));
    assert.equal((-2).checkedPower(3), .Some(-8));
    assert.equal((-2).checkedPower(4), .Some(16));
    assert.equal(1.checkedPower(9007199254740993), .Some(1));
    assert.equal(0.checkedPower(5), .Some(0));
}

test "checkedPower answers .None past the type's own range" {
    assert.equal(10.checkedPower(19), .None);
    assert.equal(2.checkedPower(63), .None);
    assert.equal(2.checkedPower(62), .Some(4611686018427387904));
    let a: U8 = 2;
    assert.equal(a.checkedPower(7), .Some(128));
    assert.equal(a.checkedPower(8), .None);
    let b: I8 = 2;
    assert.equal(b.checkedPower(6), .Some(64));
    assert.equal(b.checkedPower(7), .None);
}

test "checkedPower answers .None for a negative exponent" {
    assert.equal(2.checkedPower(-1), .None);
    assert.equal(1.checkedPower(-1), .None);
    assert.equal(0.checkedPower(-1), .None);
}

test "checkedPower at the wide widths" {
    let a: U64 = 3;
    let b: U128 = 2;
    let c: I128 = 10;
    assert.equal(a.checkedPower(40), .Some(12157665459056928801));
    assert.equal(a.checkedPower(41), .None);
    assert.equal(b.checkedPower(127), .Some(170141183460469231731687303715884105728));
    assert.equal(b.checkedPower(128), .None);
    assert.equal(c.checkedPower(38), .Some(100000000000000000000000000000000000000));
    assert.equal(c.checkedPower(39), .None);
}

test "checkedPower is checkedMultiply repeated" {
    // The property that says the two agree: `x^n` is `x^(n-1) * x` wherever
    // both fit.
    assert.equal(
        7.checkedPower(5),
        7.checkedPower(4).andThen(fn(v) => v.checkedMultiply(7)),
    );
    assert.equal(
        3.checkedPower(20),
        3.checkedPower(19).andThen(fn(v) => v.checkedMultiply(3)),
    );
}

// --- Integer arithmetic in core/number --------------------------------------------

test "power is Option-valued exponentiation" {
    assert.equal(number.power(2, 10), .Some(1024));
    assert.equal(number.power(10, 0), .Some(1));
    assert.equal(number.power(0, 0), .Some(1));
    assert.equal(number.power(-3, 3), .Some(-27));
    assert.equal(number.power(-3, 4), .Some(81));
    assert.equal(number.power(10, 18), .Some(1000000000000000000));
    assert.equal(number.power(10, 19), .None);
    assert.equal(number.power(2, -1), .None);
}

test "power agrees with the Checked method it is written out of" {
    assert.equal(number.power(7, 11), 7.checkedPower(11));
    assert.equal(number.power(3037000500, 2), 3037000500.checkedPower(2));
    assert.equal(number.power(2, 63), 2.checkedPower(63));
}

test "greatestCommonDivisor ignores sign and answers zero for two zeros" {
    assert.equal(number.greatestCommonDivisor(12, 18), 6);
    assert.equal(number.greatestCommonDivisor(-12, 18), 6);
    assert.equal(number.greatestCommonDivisor(12, -18), 6);
    assert.equal(number.greatestCommonDivisor(-12, -18), 6);
    assert.equal(number.greatestCommonDivisor(0, 0), 0);
    assert.equal(number.greatestCommonDivisor(0, 7), 7);
    assert.equal(number.greatestCommonDivisor(7, 0), 7);
    assert.equal(number.greatestCommonDivisor(17, 5), 1);
    assert.equal(number.greatestCommonDivisor(270, 192), 6);
}

test "greatestCommonDivisor divides both, and nothing larger does" {
    let g = number.greatestCommonDivisor(462, 1071);
    assert.equal(g, 21);
    assert.equal(462 % g, 0);
    assert.equal(1071 % g, 0);
}

test "the two pairs whose divisor is not an Int answer that value anyway" {
    // `|minValue|` is `2^63`, which no `Int` holds, so these two are the
    // documented exception to the answer being non-negative.
    assert.equal(
        number.greatestCommonDivisor(number.minValue<I64>(), 0),
        number.minValue<I64>(),
    );
    assert.equal(
        number.greatestCommonDivisor(0, number.minValue<I64>()),
        number.minValue<I64>(),
    );
    // With any other second argument the magnitude comes back down.
    assert.equal(number.greatestCommonDivisor(number.minValue<I64>(), 2), 2);
    assert.equal(number.greatestCommonDivisor(number.minValue<I64>(), -1), 1);
}

test "leastCommonMultiple is the smallest number both divide" {
    assert.equal(number.leastCommonMultiple(4, 6), .Some(12));
    assert.equal(number.leastCommonMultiple(21, 6), .Some(42));
    assert.equal(number.leastCommonMultiple(-4, 6), .Some(12));
    assert.equal(number.leastCommonMultiple(7, 7), .Some(7));
    assert.equal(number.leastCommonMultiple(0, 5), .Some(0));
    assert.equal(number.leastCommonMultiple(5, 0), .Some(0));
    assert.equal(number.leastCommonMultiple(0, 0), .Some(0));
}

test "leastCommonMultiple answers .None when the multiple is not an Int" {
    assert.equal(
        number.leastCommonMultiple(number.maxValue<I64>(), number.maxValue<I64>() - 1),
        .None,
    );
    assert.equal(number.leastCommonMultiple(4611686018427387904, 3), .None);
}

test "the product of the two is the product of the arguments" {
    // `gcd(a, b) * lcm(a, b) == |a * b|`, on values small enough for the
    // product to be an `Int`.
    let a = 1071;
    let b = 462;
    let g = number.greatestCommonDivisor(a, b);
    assert.equal(number.leastCommonMultiple(a, b).map(fn(l) => l * g), .Some(a * b));
}

test "divideEuclidean pairs with remainderEuclidean at either sign of divisor" {
    assert.equal(number.divideEuclidean(7, 2), 3);
    assert.equal(number.divideEuclidean(-7, 2), -4);
    assert.equal(number.divideEuclidean(7, -2), -3);
    assert.equal(number.divideEuclidean(-7, -2), 4);
    assert.equal(number.divideEuclidean(6, 3), 2);
    assert.equal(number.divideEuclidean(0, 3), 0);
}

test "divideEuclidean times the divisor plus remainderEuclidean is the dividend" {
    assert.equal(
        number.divideEuclidean(-7, 2) * 2 + number.remainderEuclidean(-7, 2),
        -7,
    );
    assert.equal(
        number.divideEuclidean(-7, -2) * -2 + number.remainderEuclidean(-7, -2),
        -7,
    );
    assert.equal(
        number.divideEuclidean(7, -2) * -2 + number.remainderEuclidean(7, -2),
        7,
    );
    assert.equal(
        number.divideEuclidean(123, 7) * 7 + number.remainderEuclidean(123, 7),
        123,
    );
}

test "divideCeiling rounds toward positive infinity" {
    assert.equal(number.divideCeiling(7, 2), 4);
    assert.equal(number.divideCeiling(6, 2), 3);
    assert.equal(number.divideCeiling(-7, 2), -3);
    assert.equal(number.divideCeiling(7, -2), -3);
    assert.equal(number.divideCeiling(-7, -2), 4);
    assert.equal(number.divideCeiling(0, 5), 0);
    assert.equal(number.divideCeiling(1, 5), 1);
}

test "divideCeiling is never below the truncating quotient for a positive pair" {
    assert.equal(number.divideCeiling(10, 3), 4);
    assert.equal(number.divideCeiling(9, 3), 3);
    assert.equal(number.divideCeiling(1, 1000000), 1);
}

test "quotientRemainder is / and % in one call" {
    assert.equal(number.quotientRemainder(7, 2), (3, 1));
    assert.equal(number.quotientRemainder(-7, 2), (-3, -1));
    assert.equal(number.quotientRemainder(7, -2), (-3, 1));
    assert.equal(number.quotientRemainder(-7, -2), (3, -1));
    assert.equal(number.quotientRemainder(0, 5), (0, 0));
    assert.equal(number.quotientRemainder(6, 3), (2, 0));
}

test "the quotient times the divisor plus the remainder is the dividend" {
    let (q, r) = number.quotientRemainder(1234567, 89);
    assert.equal(q * 89 + r, 1234567);
}

test "integerSquareRoot is exact where math.squareRoot is not" {
    assert.equal(number.integerSquareRoot(0), .Some(0));
    assert.equal(number.integerSquareRoot(1), .Some(1));
    assert.equal(number.integerSquareRoot(2), .Some(1));
    assert.equal(number.integerSquareRoot(3), .Some(1));
    assert.equal(number.integerSquareRoot(4), .Some(2));
    assert.equal(number.integerSquareRoot(8), .Some(2));
    assert.equal(number.integerSquareRoot(9), .Some(3));
    assert.equal(number.integerSquareRoot(1000000), .Some(1000));
    assert.equal(number.integerSquareRoot(-1), .None);
    assert.equal(number.integerSquareRoot(-1000), .None);
}

test "integerSquareRoot at the top of the range" {
    assert.equal(number.integerSquareRoot(number.maxValue<I64>()), .Some(3037000499));
    assert.equal(number.integerSquareRoot(9223372030926249001), .Some(3037000499));
    assert.equal(number.integerSquareRoot(4611686018427387904), .Some(2147483648));
}

test "the root squared is at or below the value, and one more is above it" {
    let n = 987654321987;
    match (number.integerSquareRoot(n)) {
        .None => assert.isTrue(false),
        .Some(r) => {
            assert.isTrue(r * r <= n);
            assert.isTrue((r + 1) * (r + 1) > n);
        },
    }
}

test "absoluteDifference has no sign to get wrong" {
    assert.equal(number.absoluteDifference(7, 3), 4);
    assert.equal(number.absoluteDifference(3, 7), 4);
    assert.equal(number.absoluteDifference(-3, 7), 10);
    assert.equal(number.absoluteDifference(-7, -3), 4);
    assert.equal(number.absoluteDifference(5, 5), 0);
    assert.equal(number.absoluteDifference(0, 0), 0);
}

// --- Every one of them at 0, 1, -1 and the two ends -------------------------------
//
// The blocks above assert each function on the values a program usually hands
// it. These assert the same functions on the six values a program hands them by
// accident: zero, one, minus one, `minValue`, `maxValue`, and the pair whose
// answer is one past the range.
//
// An answer that is *not* an `Int` is `.None` where the signature has room to
// say so and undefined behaviour where it does not, and the difference between
// those two is what each block below is pinning.

test "power at zero, one and minus one" {
    // Zero to anything above zero is zero, and to nothing at all is one.
    assert.equal(number.power(0, 0), .Some(1));
    assert.equal(number.power(0, 1), .Some(0));
    assert.equal(number.power(0, 62), .Some(0));
    // One never leaves the range, however far it is raised.
    assert.equal(number.power(1, 0), .Some(1));
    assert.equal(number.power(1, 1), .Some(1));
    assert.equal(number.power(1, 62), .Some(1));
    assert.equal(number.power(1, number.maxValue<I64>()), .Some(1));
    // Minus one alternates, and `maxValue` is odd.
    assert.equal(number.power(-1, 0), .Some(1));
    assert.equal(number.power(-1, 1), .Some(-1));
    assert.equal(number.power(-1, 2), .Some(1));
    assert.equal(number.power(-1, number.maxValue<I64>()), .Some(-1));
    // A negative exponent is a fraction whichever base it is under.
    assert.equal(number.power(1, -1), .None);
    assert.equal(number.power(-1, -1), .None);
    assert.equal(number.power(0, -1), .None);
    assert.equal(number.power(0, number.minValue<I64>()), .None);
}

test "power at the two ends of Int" {
    // The empty product, and the base itself, are answers at every base — the
    // square is only taken when a further round needs it.
    assert.equal(number.power(number.maxValue<I64>(), 0), .Some(1));
    assert.equal(number.power(number.minValue<I64>(), 0), .Some(1));
    assert.equal(
        number.power(number.maxValue<I64>(), 1),
        .Some(number.maxValue<I64>()),
    );
    assert.equal(
        number.power(number.minValue<I64>(), 1),
        .Some(number.minValue<I64>()),
    );
    // The square of either end is not an `Int`.
    assert.equal(number.power(number.maxValue<I64>(), 2), .None);
    assert.equal(number.power(number.minValue<I64>(), 2), .None);
}

test "the powers of two on either side of the range" {
    assert.equal(number.power(2, 62), .Some(4611686018427387904));
    // `2^63` is one past `maxValue`.
    assert.equal(number.power(2, 63), .None);
    assert.equal(number.power(2, 64), .None);
    // And `-2^63` is `minValue` exactly, so the negative side reaches one
    // exponent further than the positive one does.
    assert.equal(number.power(-2, 63), .Some(number.minValue<I64>()));
    assert.equal(number.power(-2, 64), .None);
}

test "greatestCommonDivisor at zero, one and minus one" {
    assert.equal(number.greatestCommonDivisor(1, 1), 1);
    assert.equal(number.greatestCommonDivisor(-1, -1), 1);
    assert.equal(number.greatestCommonDivisor(1, -1), 1);
    assert.equal(number.greatestCommonDivisor(0, 1), 1);
    assert.equal(number.greatestCommonDivisor(1, 0), 1);
    assert.equal(number.greatestCommonDivisor(0, -1), 1);
}

test "greatestCommonDivisor at the two ends of Int" {
    let top = number.maxValue<I64>();
    let bottom = number.minValue<I64>();
    assert.equal(number.greatestCommonDivisor(top, top), top);
    assert.equal(number.greatestCommonDivisor(top, 1), 1);
    // `maxValue` is odd, so it shares nothing with a power of two.
    assert.equal(number.greatestCommonDivisor(top, 2), 1);
    assert.equal(number.greatestCommonDivisor(bottom, top), 1);
    assert.equal(number.greatestCommonDivisor(bottom, 4), 4);
    // The pairs whose divisor is `2^63` and so is not an `Int`: the two zero
    // pairs, and `minValue` against itself.
    assert.equal(number.greatestCommonDivisor(bottom, bottom), bottom);
    assert.equal(number.greatestCommonDivisor(bottom, 0), bottom);
    assert.equal(number.greatestCommonDivisor(0, bottom), bottom);
}

test "leastCommonMultiple of two large primes" {
    // 2^31 - 1 and 2^32 - 5, both prime, so the multiple is the product — and
    // it is about as large as a product of two primes can be and stay an `Int`.
    assert.equal(
        number.leastCommonMultiple(2147483647, 4294967291),
        .Some(9223372021822390277),
    );
    assert.equal(
        number.leastCommonMultiple(3037000493, 3037000499),
        .Some(9223372012704246007),
    );
    // One prime larger on either side and the product is past `maxValue`.
    assert.equal(number.leastCommonMultiple(4294967291, 4294967279), .None);
    assert.equal(number.leastCommonMultiple(3037000493, 3037000507), .None);
}

test "leastCommonMultiple at zero, one and the two ends" {
    let top = number.maxValue<I64>();
    let bottom = number.minValue<I64>();
    assert.equal(number.leastCommonMultiple(1, 1), .Some(1));
    assert.equal(number.leastCommonMultiple(-1, -1), .Some(1));
    assert.equal(number.leastCommonMultiple(1, -1), .Some(1));
    assert.equal(number.leastCommonMultiple(top, 1), .Some(top));
    assert.equal(number.leastCommonMultiple(top, top), .Some(top));
    // `|minValue|` is `2^63`, so every multiple of it that is not zero is one
    // past the range — the divisor cancelling exactly does not save it.
    assert.equal(number.leastCommonMultiple(bottom, 1), .None);
    assert.equal(number.leastCommonMultiple(bottom, 2), .None);
    assert.equal(number.leastCommonMultiple(bottom, bottom), .None);
    assert.equal(number.leastCommonMultiple(bottom, 0), .Some(0));
}

test "divideEuclidean at every sign of dividend and divisor" {
    // The four sign pairs, at a divisor that does not divide.
    assert.equal(number.divideEuclidean(7, 2), 3);
    assert.equal(number.divideEuclidean(-7, 2), -4);
    assert.equal(number.divideEuclidean(7, -2), -3);
    assert.equal(number.divideEuclidean(-7, -2), 4);
    // And at one that does, where the remainder is zero and no rounding
    // decision is taken.
    assert.equal(number.divideEuclidean(6, 2), 3);
    assert.equal(number.divideEuclidean(-6, 2), -3);
    assert.equal(number.divideEuclidean(6, -2), -3);
    assert.equal(number.divideEuclidean(-6, -2), 3);
    // A magnitude smaller than the divisor's, where the truncating quotient is
    // zero and the Euclidean one need not be.
    assert.equal(number.divideEuclidean(1, 2), 0);
    assert.equal(number.divideEuclidean(-1, 2), -1);
    assert.equal(number.divideEuclidean(1, -2), 0);
    assert.equal(number.divideEuclidean(-1, -2), 1);
}

test "divideEuclidean and remainderEuclidean still pair up at the ends of Int" {
    let top = number.maxValue<I64>();
    let bottom = number.minValue<I64>();
    assert.equal(number.divideEuclidean(top, 1), top);
    assert.equal(number.divideEuclidean(bottom, 1), bottom);
    assert.equal(number.divideEuclidean(top, -1), 0 - top);
    assert.equal(number.divideEuclidean(bottom, 2), -4611686018427387904);
    assert.equal(
        number.divideEuclidean(bottom, 2) * 2 + number.remainderEuclidean(bottom, 2),
        bottom,
    );
    assert.equal(
        number.divideEuclidean(top, 3) * 3 + number.remainderEuclidean(top, 3),
        top,
    );
    assert.equal(
        number.divideEuclidean(bottom, -3) * -3 + number.remainderEuclidean(bottom, -3),
        bottom,
    );
}

test "quotientRemainder at every sign, and at both ends" {
    let top = number.maxValue<I64>();
    let bottom = number.minValue<I64>();
    // The four sign pairs, one where the division is exact and one where it is
    // not: the remainder wears the dividend's sign in every one of them.
    assert.equal(number.quotientRemainder(7, 2), (3, 1));
    assert.equal(number.quotientRemainder(-7, 2), (-3, -1));
    assert.equal(number.quotientRemainder(7, -2), (-3, 1));
    assert.equal(number.quotientRemainder(-7, -2), (3, -1));
    assert.equal(number.quotientRemainder(6, 2), (3, 0));
    assert.equal(number.quotientRemainder(-6, 2), (-3, 0));
    assert.equal(number.quotientRemainder(6, -2), (-3, 0));
    assert.equal(number.quotientRemainder(-6, -2), (3, 0));
    // Zero, one and minus one on either side.
    assert.equal(number.quotientRemainder(0, bottom), (0, 0));
    assert.equal(number.quotientRemainder(1, bottom), (0, 1));
    assert.equal(number.quotientRemainder(-1, bottom), (0, -1));
    assert.equal(number.quotientRemainder(top, 1), (top, 0));
    assert.equal(number.quotientRemainder(bottom, 1), (bottom, 0));
    assert.equal(number.quotientRemainder(top, -1), (0 - top, 0));
    assert.equal(number.quotientRemainder(bottom, bottom), (1, 0));
    assert.equal(number.quotientRemainder(top, top), (1, 0));
}

test "divideCeiling at every sign, and at both ends" {
    let top = number.maxValue<I64>();
    let bottom = number.minValue<I64>();
    assert.equal(number.divideCeiling(1, 2), 1);
    assert.equal(number.divideCeiling(-1, 2), 0);
    assert.equal(number.divideCeiling(1, -2), 0);
    assert.equal(number.divideCeiling(-1, -2), 1);
    assert.equal(number.divideCeiling(6, 2), 3);
    assert.equal(number.divideCeiling(-6, -2), 3);
    assert.equal(number.divideCeiling(top, 1), top);
    assert.equal(number.divideCeiling(bottom, 1), bottom);
    assert.equal(number.divideCeiling(top, top), 1);
    assert.equal(number.divideCeiling(bottom, bottom), 1);
    assert.equal(number.divideCeiling(0, bottom), 0);
}

test "integerSquareRoot at zero, one and the two ends" {
    assert.equal(number.integerSquareRoot(0), .Some(0));
    assert.equal(number.integerSquareRoot(1), .Some(1));
    assert.equal(number.integerSquareRoot(number.maxValue<I64>()), .Some(3037000499));
    // Every negative value, `minValue` included, has no root in the integers.
    assert.equal(number.integerSquareRoot(-1), .None);
    assert.equal(number.integerSquareRoot(number.minValue<I64>()), .None);
    // A perfect square at the top of the range, and one below it.
    assert.equal(number.integerSquareRoot(9223372030926249001), .Some(3037000499));
    assert.equal(number.integerSquareRoot(9223372030926249000), .Some(3037000498));
}

test "absoluteDifference reaches maxValue and no further" {
    let top = number.maxValue<I64>();
    let bottom = number.minValue<I64>();
    assert.equal(number.absoluteDifference(top, 0), top);
    assert.equal(number.absoluteDifference(0, top), top);
    // The two pairs whose distance is exactly `maxValue` at the bottom end.
    assert.equal(number.absoluteDifference(0, bottom + 1), top);
    assert.equal(number.absoluteDifference(bottom, -1), top);
    assert.equal(number.absoluteDifference(bottom, bottom), 0);
    assert.equal(number.absoluteDifference(top, top), 0);
    assert.equal(number.absoluteDifference(bottom, bottom + 1), 1);
    assert.equal(number.absoluteDifference(top - 1, top), 1);
    // `absoluteDifference(minValue, maxValue)` is `2^64 - 1`, which is not an
    // `Int` — the documented overflow, and undefined behaviour (SPEC 6.2), so
    // there is no answer here to assert. The four values above are the largest
    // differences that *are* `Int`s.
}

// --- Checked's three new methods at every width ------------------------------------
//
// The blocks above reach several widths each. These reach **all ten**, because
// that is the claim: a `Checked` method means the same thing at every width, and
// on the JavaScript backend the widths up to 32 bits are a `number` while the
// rest are a `BigInt`. A method that answered `.None` at one representation and
// a value at the other would be two operations wearing one name.

test "checkedRemainder is .None on a zero divisor and on nothing else, at every width" {
    let a: I8 = -128;
    let b: I16 = -32768;
    let c: I32 = -2147483648;
    let d: I64 = -9223372036854775808;
    let e: I128 = -170141183460469231731687303715884105728;
    // The one remainder that has no matching quotient is still zero, at each
    // signed width.
    assert.equal(a.checkedRemainder(-1), .Some(0));
    assert.equal(b.checkedRemainder(-1), .Some(0));
    assert.equal(c.checkedRemainder(-1), .Some(0));
    assert.equal(d.checkedRemainder(-1), .Some(0));
    assert.equal(e.checkedRemainder(-1), .Some(0));
    // A zero divisor is the only `.None`.
    assert.equal(a.checkedRemainder(0), .None);
    assert.equal(b.checkedRemainder(0), .None);
    assert.equal(c.checkedRemainder(0), .None);
    assert.equal(d.checkedRemainder(0), .None);
    assert.equal(e.checkedRemainder(0), .None);
    // And at the unsigned widths, where there is no negative to get wrong.
    let f: U8 = 255;
    let g: U16 = 65535;
    let h: U32 = 4294967295;
    let i: U64 = 18446744073709551615;
    let j: U128 = 340282366920938463463374607431768211455;
    assert.equal(f.checkedRemainder(16), .Some(15));
    assert.equal(g.checkedRemainder(16), .Some(15));
    assert.equal(h.checkedRemainder(16), .Some(15));
    assert.equal(i.checkedRemainder(16), .Some(15));
    assert.equal(j.checkedRemainder(16), .Some(15));
    assert.equal(j.checkedRemainder(0), .None);
}

test "checkedNegate is .None at each type's own one value, at every width" {
    // The signed minimum, whose negation is one past the maximum.
    let a: I8 = -128;
    let b: I16 = -32768;
    let c: I32 = -2147483648;
    let d: I64 = -9223372036854775808;
    let e: I128 = -170141183460469231731687303715884105728;
    assert.equal(a.checkedNegate(), .None);
    assert.equal(b.checkedNegate(), .None);
    assert.equal(c.checkedNegate(), .None);
    assert.equal(d.checkedNegate(), .None);
    assert.equal(e.checkedNegate(), .None);
    // One above it negates, at each of them.
    let a2: I8 = -127;
    let b2: I16 = -32767;
    let c2: I32 = -2147483647;
    let d2: I64 = -9223372036854775807;
    let e2: I128 = -170141183460469231731687303715884105727;
    assert.equal(a2.checkedNegate(), .Some(127));
    assert.equal(b2.checkedNegate(), .Some(32767));
    assert.equal(c2.checkedNegate(), .Some(2147483647));
    assert.equal(d2.checkedNegate(), .Some(9223372036854775807));
    assert.equal(e2.checkedNegate(), .Some(170141183460469231731687303715884105727));
    // An unsigned type has a negative for zero and nothing else, at each width.
    let f: U8 = 0;
    let g: U16 = 0;
    let h: U32 = 0;
    let i: U64 = 0;
    let j: U128 = 0;
    assert.equal(f.checkedNegate(), .Some(0));
    assert.equal(g.checkedNegate(), .Some(0));
    assert.equal(h.checkedNegate(), .Some(0));
    assert.equal(i.checkedNegate(), .Some(0));
    assert.equal(j.checkedNegate(), .Some(0));
    let f2: U8 = 1;
    let g2: U16 = 1;
    let h2: U32 = 1;
    let i2: U64 = 1;
    let j2: U128 = 1;
    assert.equal(f2.checkedNegate(), .None);
    assert.equal(g2.checkedNegate(), .None);
    assert.equal(h2.checkedNegate(), .None);
    assert.equal(i2.checkedNegate(), .None);
    assert.equal(j2.checkedNegate(), .None);
}

test "checkedPower is one at a zero exponent and .None below it, at every width" {
    let a: I8 = -3;
    let b: I16 = -3;
    let c: I32 = -3;
    let d: I64 = -3;
    let e: I128 = -3;
    let f: U8 = 3;
    let g: U16 = 3;
    let h: U32 = 3;
    let i: U64 = 3;
    let j: U128 = 3;
    // The empty product, at every width and either sign.
    assert.equal(a.checkedPower(0), .Some(1));
    assert.equal(b.checkedPower(0), .Some(1));
    assert.equal(c.checkedPower(0), .Some(1));
    assert.equal(d.checkedPower(0), .Some(1));
    assert.equal(e.checkedPower(0), .Some(1));
    assert.equal(f.checkedPower(0), .Some(1));
    assert.equal(g.checkedPower(0), .Some(1));
    assert.equal(h.checkedPower(0), .Some(1));
    assert.equal(i.checkedPower(0), .Some(1));
    assert.equal(j.checkedPower(0), .Some(1));
    // A negative exponent is a fraction, at every width.
    assert.equal(a.checkedPower(-1), .None);
    assert.equal(c.checkedPower(-1), .None);
    assert.equal(e.checkedPower(-1), .None);
    assert.equal(f.checkedPower(-1), .None);
    assert.equal(j.checkedPower(-1), .None);
    // The base itself at an exponent of one, which never overflows.
    assert.equal(a.checkedPower(1), .Some(-3));
    assert.equal(e.checkedPower(1), .Some(-3));
    assert.equal(j.checkedPower(1), .Some(3));
}

test "checkedPower is .None exactly one exponent past each width's own ceiling" {
    let a: I8 = 3;
    let b: I16 = 3;
    let c: I32 = 3;
    let d: I64 = 3;
    let e: I128 = 3;
    // 3^4 is 81 and 3^5 is 243, which is past `I8`.
    assert.equal(a.checkedPower(4), .Some(81));
    assert.equal(a.checkedPower(5), .None);
    assert.equal(b.checkedPower(9), .Some(19683));
    assert.equal(b.checkedPower(10), .None);
    assert.equal(c.checkedPower(19), .Some(1162261467));
    assert.equal(c.checkedPower(20), .None);
    assert.equal(d.checkedPower(39), .Some(4052555153018976267));
    assert.equal(d.checkedPower(40), .None);
    assert.equal(e.checkedPower(80), .Some(147808829414345923316083210206383297601));
    assert.equal(e.checkedPower(81), .None);
    // And on the unsigned side, where the ceiling is one bit higher.
    let f: U8 = 3;
    let g: U16 = 3;
    let h: U32 = 3;
    let i: U64 = 3;
    let j: U128 = 3;
    assert.equal(f.checkedPower(5), .Some(243));
    assert.equal(f.checkedPower(6), .None);
    assert.equal(g.checkedPower(10), .Some(59049));
    assert.equal(g.checkedPower(11), .None);
    assert.equal(h.checkedPower(20), .Some(3486784401));
    assert.equal(h.checkedPower(21), .None);
    assert.equal(i.checkedPower(40), .Some(12157665459056928801));
    assert.equal(i.checkedPower(41), .None);
    assert.equal(j.checkedPower(80), .Some(147808829414345923316083210206383297601));
    assert.equal(j.checkedPower(81), .None);
}
