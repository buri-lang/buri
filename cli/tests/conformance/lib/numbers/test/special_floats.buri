// `core/math`'s three named values — `INFINITY`, `NEG_INFINITY` and `NAN`.
//
// They are `let` constants whose initialisers are IEEE-754 divisions rather
// than decimal numerals. `INFINITY` was `1.0e400` until this file existed: a
// literal that is infinite only because the decimal-to-binary conversion that
// read it overflowed, so what it meant was a property of whichever float parser
// ran rather than of anything the language states. `NaN` has no numeral at all,
// and there is no negative-infinity numeral either that is not the same
// overflow with a sign in front.
//
// This is a file of its own rather than a section of `floats.buri` because of
// which backends run it. `floats.buri` is held out of the native set over
// `core/math`'s thirteen transcendentals, whose last bit IEEE-754 does not fix
// (`cli/tests/native/conformance.rs`, and `cli/runtime/math.rs` for why) —
// and a constant being the same value on both backends is the entire point of
// the spelling, so it has to be asserted somewhere both backends read. Nothing
// below reaches a transcendental: division by zero, the sign, the three
// classifiers, `sqrt`, `floor`, `ceil` and `absFloat` are each exactly
// specified, and every rendering here is a name rather than a digit.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/math" import * as math;
from "core/number" import * as number;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;

// The values, derived a second way — this is what the constants are compared
// against, so that the assertion is `the constant is that value` rather than
// `the constant is itself`.

fn nan(): F64 {
    0.0 / 0.0
}

fn inf(): F64 {
    1.0 / 0.0
}

fn negInf(): F64 {
    -1.0 / 0.0
}

test "INFINITY is the infinity division produces, and is positive" {
    assert.equal(math.INFINITY, inf());
    assert.isTrue(math.isInfinite(math.INFINITY));
    assert.isFalse(math.isFinite(math.INFINITY));
    assert.isFalse(math.isNan(math.INFINITY));
    // Positive, said three ways: above every finite value, above zero, and
    // with the sign `signum` reports.
    assert.isTrue(math.INFINITY > 1.0e308);
    assert.isTrue(math.INFINITY > 0.0);
    assert.equal(math.INFINITY.signum(), 1.0);
}

test "NEG_INFINITY is the other one, and is negative" {
    assert.equal(math.NEG_INFINITY, negInf());
    assert.isTrue(math.isInfinite(math.NEG_INFINITY));
    assert.isFalse(math.isFinite(math.NEG_INFINITY));
    assert.isFalse(math.isNan(math.NEG_INFINITY));
    assert.isTrue(math.NEG_INFINITY < -1.0e308);
    assert.isTrue(math.NEG_INFINITY < 0.0);
    assert.equal(math.NEG_INFINITY.signum(), -1.0);
}

test "the two infinities are each other's negation" {
    assert.equal(-math.INFINITY, math.NEG_INFINITY);
    assert.equal(-math.NEG_INFINITY, math.INFINITY);
    assert.isTrue(math.NEG_INFINITY < math.INFINITY);
    assert.isFalse(math.INFINITY == math.NEG_INFINITY);
    assert.equal(math.absFloat(math.NEG_INFINITY), math.INFINITY);
}

test "NAN is a NaN" {
    assert.isTrue(math.isNan(math.NAN));
    assert.isFalse(math.isFinite(math.NAN));
    assert.isFalse(math.isInfinite(math.NAN));
    assert.equal(math.NAN, nan());
}

test "NAN equals itself, because equality in Buri is an equivalence relation" {
    // SPEC 6.2: `==` is reflexive at every value, so `NAN != NAN` is **false**
    // here where IEEE-754 makes it true. The documented departure, and the
    // reason a `NaN` can be a key: this is what a `Map`, a `Set` and every
    // `derive Equal` are built on.
    assert.isTrue(math.NAN == math.NAN);
    assert.isFalse(math.NAN != math.NAN);
    assert.equal(math.NAN, math.NAN);
    // A different bit pattern for the same value: negation flips the sign bit
    // and nothing else, so an equality that compared bits would fail here.
    assert.isTrue(math.NAN == -math.NAN);
    assert.isTrue(math.isNan(-math.NAN));
}

test "NAN is unordered, because the ordering operators are still IEEE's" {
    assert.isFalse(math.NAN < math.NAN);
    assert.isFalse(math.NAN > math.NAN);
    assert.isFalse(math.NAN <= math.NAN);
    assert.isFalse(math.NAN >= math.NAN);
    assert.isFalse(math.NAN < math.INFINITY);
    assert.isFalse(math.NAN > math.NEG_INFINITY);
    assert.isFalse(math.NAN == 0.0);
}

test "arithmetic on the three lands where IEEE-754 says" {
    assert.equal(math.INFINITY + 1.0, math.INFINITY);
    assert.equal(math.INFINITY * 2.0, math.INFINITY);
    assert.equal(math.INFINITY * -1.0, math.NEG_INFINITY);
    assert.equal(math.NEG_INFINITY - 1.0, math.NEG_INFINITY);
    assert.equal(1.0 / math.INFINITY, 0.0);
    assert.equal(1.0 / math.NEG_INFINITY, 0.0);
    // The four ways to make a NaN out of infinities, and two out of a NaN.
    assert.isTrue(math.isNan(math.INFINITY + math.NEG_INFINITY));
    assert.isTrue(math.isNan(math.INFINITY - math.INFINITY));
    assert.isTrue(math.isNan(math.INFINITY * 0.0));
    assert.isTrue(math.isNan(math.INFINITY / math.INFINITY));
    assert.isTrue(math.isNan(math.NAN + 1.0));
    assert.isTrue(math.isNan(math.NAN * 0.0));
}

test "the exactly-specified half of core/math agrees with the three" {
    assert.equal(math.sqrt(math.INFINITY), math.INFINITY);
    assert.isTrue(math.isNan(math.sqrt(math.NAN)));
    assert.equal(math.floor(math.INFINITY), math.INFINITY);
    assert.equal(math.ceil(math.NEG_INFINITY), math.NEG_INFINITY);
    assert.equal(math.absFloat(math.INFINITY), math.INFINITY);
}

test "number's free functions order the three the way the operators do" {
    assert.equal(number.min(1.0, math.NEG_INFINITY), math.NEG_INFINITY);
    assert.equal(number.max(1.0, math.INFINITY), math.INFINITY);
    assert.equal(number.clamp(0.0, 1.0, math.INFINITY), 1.0);
    assert.equal(number.clamp(0.0, 1.0, math.NEG_INFINITY), 0.0);
}

test "the three render the same text on every backend" {
    let ctx = context {
        Allocator: alloc(),
    };
    // A name rather than digits, on both backends: SPEC 6.2 says rendering a
    // float is the shortest decimal that round-trips, and none of these three
    // has one. A constant that was a different value on one backend would show
    // it here as different text.
    assert.equal(str.fromFloat(ctx, math.INFINITY), "inf");
    assert.equal(str.fromFloat(ctx, math.NEG_INFINITY), "-inf");
    assert.equal(str.fromFloat(ctx, math.NAN), "NaN");
    assert.equal(math.INFINITY.show(ctx), "inf");
    assert.equal(math.NEG_INFINITY.show(ctx), "-inf");
    assert.equal(math.NAN.show(ctx), "NaN");
}

test "the three render the same in a hole as they do through show" {
    let ctx = context {
        Allocator: alloc(),
    };
    // SPEC 3.6: a `Float` hole renders exactly as `show` renders it. This is
    // where the two rendering paths a backend has — the interpolation one and
    // `str.fromFloat` — have to meet, at the three values that are not digits.
    assert.equal(str.format(ctx, "${math.INFINITY}"), "inf");
    assert.equal(str.format(ctx, "${math.NEG_INFINITY}"), "-inf");
    assert.equal(str.format(ctx, "${math.NAN}"), "NaN");
    assert.equal(
        str.format(ctx, "${math.INFINITY} ${math.NEG_INFINITY} ${math.NAN}"),
        "inf -inf NaN",
    );
}

// --- The exact half of core/math's new surface -------------------------------------
//
// Everything below is `+ - * /`, `sqrt` and the comparisons, all of which
// IEEE-754 fixes exactly — so each answers the same bits on every backend, and
// each belongs here rather than in `floats.buri` with the transcendentals.

test "EPSILON is the gap above one" {
    assert.equal(1.0 + math.EPSILON > 1.0, true);
    assert.equal(1.0 + math.EPSILON / 2.0 == 1.0, true);
    assert.equal(math.EPSILON, 2.220446049250313e-16);
}

test "MIN_POSITIVE is the smallest float with a full mantissa" {
    assert.equal(math.MIN_POSITIVE > 0.0, true);
    assert.equal(math.MIN_POSITIVE, 2.2250738585072014e-308);
    // Halving it leaves the normals and keeps a value, which is what makes it
    // the *normal* minimum rather than the smallest float.
    assert.equal(math.MIN_POSITIVE / 2.0 > 0.0, true);
}

test "TAU is two PI" {
    assert.equal(math.TAU, 2.0 * math.PI);
    assert.equal(math.TAU / 4.0, math.PI / 2.0);
}

test "hypotenuse is the length of the third side" {
    assert.equal(math.hypotenuse(3.0, 4.0), 5.0);
    assert.equal(math.hypotenuse(0.0, 0.0), 0.0);
    assert.equal(math.hypotenuse(0.0, 7.0), 7.0);
    assert.equal(math.hypotenuse(-3.0, -4.0), 5.0);
    assert.equal(math.hypotenuse(5.0, 12.0), 13.0);
}

test "hypotenuse survives a side whose square would overflow" {
    // `x * x` is infinite here; the answer is not.
    let big = 1.0e200;
    assert.equal(math.hypotenuse(big, 0.0), big);
    assert.equal(math.isFinite(math.hypotenuse(big, big)), true);
    assert.equal(math.isInfinite(big * big), true);
}

test "hypotenuse answers infinity for an infinite side, NaN or not" {
    assert.equal(math.hypotenuse(math.INFINITY, 1.0), math.INFINITY);
    assert.equal(math.hypotenuse(1.0, math.NEG_INFINITY), math.INFINITY);
    assert.equal(math.hypotenuse(math.INFINITY, nan()), math.INFINITY);
    assert.isTrue(math.isNan(math.hypotenuse(nan(), 1.0)));
}

test "copySign takes the magnitude from one side and the sign from the other" {
    assert.equal(math.copySign(3.0, 1.0), 3.0);
    assert.equal(math.copySign(3.0, -1.0), -3.0);
    assert.equal(math.copySign(-3.0, 1.0), 3.0);
    assert.equal(math.copySign(-3.0, -1.0), -3.0);
    assert.equal(math.copySign(math.INFINITY, -1.0), math.NEG_INFINITY);
}

test "copySign reads a negative zero's sign" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloat(ctx, math.copySign(1.0, -0.0)), "-1.0");
    assert.equal(str.fromFloat(ctx, math.copySign(1.0, 0.0)), "1.0");
    assert.equal(str.fromFloat(ctx, math.copySign(0.0, -1.0)), "-0.0");
    // A `NaN` carries no sign in this language, so it counts as positive.
    assert.equal(str.fromFloat(ctx, math.copySign(1.0, nan())), "1.0");
}

test "toRadians and toDegrees are inverses at the usual angles" {
    assert.equal(math.toRadians(180.0), math.PI);
    assert.equal(math.toRadians(0.0), 0.0);
    assert.equal(math.toDegrees(math.PI), 180.0);
    assert.equal(math.toDegrees(0.0), 0.0);
    assert.equal(math.toDegrees(math.toRadians(90.0)), 90.0);
    assert.equal(math.toDegrees(math.toRadians(45.0)), 45.0);
}

test "roundEven sends a tie to the even neighbour" {
    assert.equal(math.roundEven(0.5), 0.0);
    assert.equal(math.roundEven(1.5), 2.0);
    assert.equal(math.roundEven(2.5), 2.0);
    assert.equal(math.roundEven(3.5), 4.0);
    assert.equal(math.roundEven(-0.5), 0.0);
    assert.equal(math.roundEven(-1.5), -2.0);
    assert.equal(math.roundEven(-2.5), -2.0);
}

test "roundEven rounds to the nearer number where there is one" {
    assert.equal(math.roundEven(0.4), 0.0);
    assert.equal(math.roundEven(0.6), 1.0);
    assert.equal(math.roundEven(-0.6), -1.0);
    assert.equal(math.roundEven(2.4), 2.0);
    assert.equal(math.roundEven(2.6), 3.0);
    assert.equal(math.roundEven(7.0), 7.0);
}

test "roundEven keeps the sign of a zero and passes the rest through" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.fromFloat(ctx, math.roundEven(-0.4)), "-0.0");
    assert.equal(str.fromFloat(ctx, math.roundEven(-0.0)), "-0.0");
    assert.equal(math.roundEven(math.INFINITY), math.INFINITY);
    assert.isTrue(math.isNan(math.roundEven(nan())));
    // Above 2^52 every double is already whole.
    assert.equal(math.roundEven(9007199254740993.0), 9007199254740993.0);
}

test "round and roundEven part company at a tie" {
    // `round` sends every tie the same way and drifts; `roundEven` splits them.
    assert.equal(math.round(2.5), 3.0);
    assert.equal(math.roundEven(2.5), 2.0);
    assert.equal(
        math.round(0.5) + math.round(1.5) + math.round(2.5) + math.round(3.5),
        10.0,
    );
    let even = math.roundEven(0.5)
        + math.roundEven(1.5)
        + math.roundEven(2.5)
        + math.roundEven(3.5);
    assert.equal(even, 8.0);
}

test "roundTo keeps the digits it is asked for" {
    assert.equal(math.roundTo(1.25, 1), 1.2);
    assert.equal(math.roundTo(1.35, 1), 1.4);
    assert.equal(math.roundTo(3.14159, 2), 3.14);
    assert.equal(math.roundTo(2.5, 0), 2.0);
    assert.equal(math.roundTo(7.0, 3), 7.0);
    assert.equal(math.roundTo(-1.25, 1), -1.2);
}

test "roundTo with a negative scale rounds above the point" {
    assert.equal(math.roundTo(1234.0, -2), 1200.0);
    assert.equal(math.roundTo(1250.0, -2), 1200.0);
    assert.equal(math.roundTo(1350.0, -2), 1400.0);
    assert.equal(math.roundTo(-1234.0, -2), -1200.0);
}

test "roundTo leaves what it cannot round" {
    assert.equal(math.roundTo(math.INFINITY, 2), math.INFINITY);
    assert.isTrue(math.isNan(math.roundTo(nan(), 2)));
    // A scale so large that the scaling itself would overflow.
    assert.equal(math.roundTo(1.5, 400), 1.5);
    assert.equal(math.roundTo(1.5, -400), 1.5);
}

test "isCloseAbsolute measures a plain difference" {
    assert.isTrue(math.isCloseAbsolute(1.0, 1.0, 0.0));
    assert.isTrue(math.isCloseAbsolute(1.0, 1.5, 0.5));
    assert.isFalse(math.isCloseAbsolute(1.0, 1.5, 0.25));
    // The tolerance's own sign does not matter.
    assert.isTrue(math.isCloseAbsolute(1.0, 1.5, -0.5));
    assert.isTrue(math.isCloseAbsolute(0.0, 0.0, 0.0));
}

test "isCloseAbsolute follows == at the values arithmetic cannot subtract" {
    assert.isTrue(math.isCloseAbsolute(math.INFINITY, math.INFINITY, 0.0));
    assert.isFalse(math.isCloseAbsolute(math.INFINITY, math.NEG_INFINITY, 1.0e300));
    // `NAN == NAN` is true in this language, and this agrees with it.
    assert.isTrue(math.isCloseAbsolute(nan(), nan(), 0.0));
    assert.isFalse(math.isCloseAbsolute(nan(), 1.0, 1.0e300));
}

test "isCloseRelative measures a fraction of the larger" {
    assert.isTrue(math.isCloseRelative(1000000.0, 1000000.1, 1.0e-6));
    assert.isFalse(math.isCloseRelative(1000000.0, 1000010.0, 1.0e-6));
    assert.isTrue(math.isCloseRelative(1.0, 1.0 + math.EPSILON, math.EPSILON));
    assert.isTrue(math.isCloseRelative(0.0, 0.0, 0.0));
    // Nothing is a fraction of nothing.
    assert.isFalse(math.isCloseRelative(0.0, 1.0e-300, 0.5));
}

test "isCloseRelative holds at a scale where a fixed tolerance says nothing" {
    let big = 1.0e18;
    assert.isFalse(math.isCloseAbsolute(big, big + 1000.0, 1.0e-9));
    assert.isTrue(math.isCloseRelative(big, big + 1000.0, 1.0e-9));
}

// --- The exact half of core/math at the ends of binary64 -------------------------
//
// Zero, negative zero, the two infinities and `NaN` are asserted above, one
// function at a time. These four blocks are the other two ends of the format:
// the **subnormals**, below `MIN_POSITIVE`, where a double trades mantissa bits
// for range; and the **largest finite value**, above which there is only
// infinity.
//
// Every function reached here is written out of `+ - * /`, `sqrt` and the
// comparisons, all of which IEEE 754 fixes exactly — so these are the same bits
// on every backend, which is why they are in this file and not in `floats.buri`.

/// The largest finite `Float`. One bit more anywhere in it and it is infinity.
fn largest(): Float {
    1.7976931348623157e308
}

/// The smallest positive `Float` there is: one bit of mantissa, and nothing
/// below it but zero.
fn smallest(): Float {
    5.0e-324
}

test "the two ends of the format are the values they are named for" {
    assert.isTrue(math.isFinite(largest()));
    assert.isTrue(math.isInfinite(largest() * 2.0));
    assert.isTrue(math.isInfinite(largest() + largest()));
    // Below `MIN_POSITIVE` and still not zero: that is what a subnormal is.
    assert.isTrue(smallest() > 0.0);
    assert.isTrue(smallest() < math.MIN_POSITIVE);
    assert.isTrue(math.MIN_POSITIVE / 2.0 > 0.0);
    assert.isTrue(math.MIN_POSITIVE / 2.0 < math.MIN_POSITIVE);
    // And nothing between it and zero, so halving it lands on zero.
    assert.equal(smallest() / 2.0, 0.0);
}

test "roundEven and roundTo at the subnormals and at the largest value" {
    let ctx = context {
        Allocator: alloc(),
    };
    // A subnormal is far below a half, so it rounds to a zero of its own sign.
    assert.equal(math.roundEven(smallest()), 0.0);
    assert.equal(str.fromFloat(ctx, math.roundEven(0.0 - smallest())), "-0.0");
    assert.equal(math.roundEven(math.MIN_POSITIVE / 2.0), 0.0);
    assert.equal(math.roundTo(smallest(), 2), 0.0);
    assert.equal(math.roundTo(math.MIN_POSITIVE, 300), 0.0);
    // Above 2^52 every double is whole already, and the largest one is far
    // above it — so both leave it exactly alone.
    assert.equal(math.roundEven(largest()), largest());
    assert.equal(math.roundTo(largest(), 0), largest());
    assert.equal(math.roundTo(largest(), 2), largest());
    // A negative zero survives the scaling.
    assert.equal(str.fromFloat(ctx, math.roundTo(-0.0, 2)), "-0.0");
    assert.equal(math.roundTo(math.NEG_INFINITY, 2), math.NEG_INFINITY);
}

test "roundTo sends its own ties to the even digit" {
    // The tie is taken after the scaling, so these are `roundEven`'s rule one
    // decimal place down.
    assert.equal(math.roundTo(0.125, 2), 0.12);
    assert.equal(math.roundTo(0.375, 2), 0.38);
    assert.equal(math.roundTo(0.625, 2), 0.62);
    assert.equal(math.roundTo(0.875, 2), 0.88);
    assert.equal(math.roundTo(2.5, 0), 2.0);
    assert.equal(math.roundTo(3.5, 0), 4.0);
    assert.equal(math.roundTo(-2.5, 0), -2.0);
    assert.equal(math.roundTo(-3.5, 0), -4.0);
    // A column of ties does not drift, which is the whole reason for the rule.
    let column = math.roundTo(0.125, 2)
        + math.roundTo(0.375, 2)
        + math.roundTo(0.625, 2)
        + math.roundTo(0.875, 2);
    assert.equal(column, 2.0);
}

test "roundTo rounds the double and not the decimal that was typed" {
    // `1.005` is really `1.00499999999999989...`, so scaling it by a hundred
    // gives something below a half and the answer is `1.0` rather than `1.01`.
    assert.equal(math.roundTo(1.005, 2), 1.0);
    assert.equal(math.roundTo(0.145, 2), 0.14);
    // And the other way: `2.675` is below its own numeral too, but the scaling
    // rounds *up* to exactly `267.5`, so the tie rule lifts it to `2.68`.
    assert.equal(math.roundTo(2.675, 2), 2.68);
    // `core/decimal` is where the digits themselves are the value.
}

test "the exact functions at the largest value and at a subnormal" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `copySign` is sign bit work, so it reaches both ends unchanged.
    assert.equal(math.copySign(largest(), -1.0), 0.0 - largest());
    assert.equal(math.copySign(0.0 - largest(), 1.0), largest());
    assert.isTrue(math.copySign(smallest(), -1.0) < 0.0);
    assert.equal(math.copySign(smallest(), 1.0), smallest());
    // `hypotenuse` scales by the larger side, which is what stops the largest
    // value squaring itself on the way.
    assert.equal(math.hypotenuse(largest(), 0.0), largest());
    assert.equal(math.hypotenuse(0.0, largest()), largest());
    assert.isTrue(math.isInfinite(math.hypotenuse(largest(), largest())));
    assert.equal(math.hypotenuse(math.MIN_POSITIVE, 0.0), math.MIN_POSITIVE);
    assert.isTrue(math.hypotenuse(smallest(), smallest()) > 0.0);
    // The degree conversions are a multiply and a divide, so they overflow at
    // the top and flush to a subnormal at the bottom.
    assert.isTrue(math.isInfinite(math.toRadians(largest())));
    assert.isTrue(math.toDegrees(smallest()) > 0.0);
    assert.equal(str.fromFloat(ctx, math.toRadians(-0.0)), "-0.0");
    assert.equal(str.fromFloat(ctx, math.toDegrees(-0.0)), "-0.0");
}

test "the two closeness tests at the ends of the format" {
    // A value is close to itself whatever the tolerance, at either end.
    assert.isTrue(math.isCloseAbsolute(largest(), largest(), 0.0));
    assert.isTrue(math.isCloseRelative(largest(), largest(), 0.0));
    assert.isTrue(math.isCloseAbsolute(smallest(), smallest(), 0.0));
    // Two subnormals a bit apart are close relatively and absolutely, because
    // everything down here is inside any ordinary tolerance.
    assert.isTrue(math.isCloseAbsolute(smallest(), 0.0, math.MIN_POSITIVE));
    assert.isFalse(math.isCloseRelative(smallest(), 0.0, 0.5));
    // The largest value against zero is not close on either measure — an
    // absolute tolerance cannot reach it and a relative one is a fraction of
    // the larger, which is the one that is huge.
    assert.isFalse(math.isCloseAbsolute(largest(), 0.0, 1.0e300));
    assert.isFalse(math.isCloseRelative(largest(), 0.0, 0.5));
    // The gap between the largest value and the next one down is about one
    // `EPSILON` of it, so the two agree to a bit and no more.
    let below = largest() - largest() * math.EPSILON;
    assert.isTrue(math.isCloseRelative(largest(), below, 2.0 * math.EPSILON));
    assert.isFalse(math.isCloseAbsolute(largest(), below, 1.0e290));
}
