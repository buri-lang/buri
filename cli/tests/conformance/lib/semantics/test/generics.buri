// SPEC 5.10, 5.12.5 — generics, bounds, explicit type arguments, and
// monomorphization.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/number" import * as number;
from "core/testing/assert" import * as assert;
from "//lib/semantics" import {
    Backwards, between, Boxed, Brick, constant, Count, depth, Either, eitherInt,
    Feather, flip, has, identity, inOrder, insert, largest, Level, mapTree, Meters,
    Pair, pair, showAll, size, Slot, slotOr, smallest, sortedShow, swap, totalGrams,
    Tree, treeOf, triple, twice, version,
};

// -----------------------------------------------------------------------------
// One type parameter
// -----------------------------------------------------------------------------

test "a generic function returns its argument at Int" {
    assert.equal(identity(42), 42);
}

test "the same generic function at Str" {
    assert.equal(identity("hello"), "hello");
}

test "the same generic function at Bool" {
    assert.isTrue(identity(true));
    assert.isFalse(identity(false));
}

test "the same generic function at a struct of mine" {
    assert.equal(identity(version(1, 2, 3)), version(1, 2, 3));
}

test "the same generic function at an enum of mine" {
    assert.equal(identity(Level.High), Level.High);
}

test "the same generic function at a list" {
    assert.equal(identity([1, 2, 3]), [1, 2, 3]);
}

test "the same generic function at a tuple" {
    assert.equal(identity((1, "a")), (1, "a"));
}

// -----------------------------------------------------------------------------
// Several type parameters
// -----------------------------------------------------------------------------

test "a two-parameter generic keeps the first argument" {
    assert.equal(constant(1, "ignored"), 1);
    assert.equal(constant("kept", 999), "kept");
}

test "a two-parameter generic over a tuple swaps the sides" {
    assert.equal(swap((1, "a")), ("a", 1));
    assert.equal(swap(("a", 1)), (1, "a"));
}

test "a three-parameter generic" {
    assert.equal(triple(1, "b", true), (1, "b", true));
    assert.equal(triple(Level.Low, 2, "c"), (Level.Low, 2, "c"));
}

// -----------------------------------------------------------------------------
// Explicit type arguments (SPEC 5.10)
// -----------------------------------------------------------------------------

test "an explicit type argument pins a type at a call" {
    assert.equal(identity<Int>(3), 3);
}

test "an explicit type argument at a second type" {
    assert.equal(identity<Str>("three"), "three");
}

test "an explicit type argument on a stdlib generic" {
    let empty: [Int] = list.empty<Int>();
    assert.equal(empty.length(), 0);
    assert.equal(empty, []);
}

test "explicit type arguments produce a function value that can be bound" {
    let f = identity<Int>;
    assert.equal(f(7), 7);
}

test "two type-argument bindings of one generic are independent" {
    let fi = identity<Int>;
    let fs = identity<Str>;
    assert.equal(fi(1), 1);
    assert.equal(fs("1"), "1");
}

test "an explicit type argument on a generic with a bound" {
    assert.equal(twice<Int>(21), 42);
}

// -----------------------------------------------------------------------------
// Bounds
// -----------------------------------------------------------------------------

test "an Ordered bound at Int" {
    assert.equal(assert.some(largest([3, 9, 4])), 9);
    assert.equal(assert.some(smallest([3, 9, 4])), 3);
}

test "an Ordered bound at Str" {
    assert.equal(assert.some(largest(["apple", "pear", "fig"])), "pear");
    assert.equal(assert.some(smallest(["apple", "pear", "fig"])), "apple");
}

test "an Ordered bound at a struct of mine" {
    assert.equal(
        assert.some(largest([version(1, 0, 0), version(0, 9, 9), version(1, 0, 1)])),
        version(1, 0, 1),
    );
}

test "an Ordered bound uses the type's own compare, reversed or not" {
    // Backwards' hand-written Ordered makes the *smallest* Int the largest value.
    assert.equal(
        assert.some(largest([Backwards(1), Backwards(9), Backwards(4)])),
        Backwards(1),
    );
}

test "an Ordered bound on an empty list gives None" {
    assert.none(largest(list.empty<Int>()));
}

test "an Ordered bound used twice in one expression" {
    assert.isTrue(between(1, 10, 5));
    assert.isFalse(between(1, 10, 11));
    assert.isTrue(between("a", "z", "m"));
}

test "two bounds joined with + are both usable" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(sortedShow(ctx, [3, 1, 2]), "1,2,3");
}

test "an Allocator bound alongside a value bound" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(showAll(ctx, [1, 2, 3]), "1,2,3");
}

test "a Show bound at a type with a hand-written show" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(showAll(ctx, [Backwards(1), Backwards(2)]), "Backwards(1),Backwards(2)");
}

test "number.min and number.max are the same Ordered bound at three types" {
    assert.equal(number.min(3, 7), 3);
    assert.equal(number.min("b", "a"), "a");
    assert.equal(number.max(Meters(1.0), Meters(2.0)), Meters(2.0));
}

// -----------------------------------------------------------------------------
// Monomorphization: one body, two instantiations, both right
// -----------------------------------------------------------------------------

test "one generic body at Int" {
    assert.equal(twice(21), 42);
}

test "the same generic body at a newtype with a derived Add" {
    assert.equal(twice(Meters(1.25)), Meters(2.5));
}

test "the same generic body at a second newtype" {
    assert.equal(twice(Count(8)), Count(16));
}

test "the same generic body at Float" {
    assert.equal(twice(0.5), 1.0);
}

test "both instantiations are live in one test" {
    // If the second instantiation overwrote the first, one of these is wrong.
    assert.equal(twice(3), 6);
    assert.equal(twice(Meters(3.0)), Meters(6.0));
    assert.equal(twice(3), 6);
    assert.equal(twice(Count(3)), Count(6));
    assert.equal(twice(1.5), 3.0);
}

test "a bounded generic over my own trait at two types in one test" {
    assert.equal(totalGrams([Brick { kilos: 1 }]), 1000);
    assert.equal(totalGrams([Feather { count: 1 }]), 1);
    assert.equal(totalGrams([Brick { kilos: 2 }]), 2000);
}

test "a generic instantiated at a generic type" {
    assert.equal(identity(pair(1, "a")), pair(1, "a"));
    assert.equal(identity(Slot.Filled(3)), Slot.Filled(3));
}

// -----------------------------------------------------------------------------
// Generic structs
// -----------------------------------------------------------------------------

test "a generic struct holds two different types" {
    let p = pair(1, "one");
    assert.equal(p.first, 1);
    assert.equal(p.second, "one");
}

test "a generic struct is equal by its fields" {
    assert.equal(pair(1, "one"), Pair { first: 1, second: "one" });
    assert.notEqual(pair(1, "one"), pair(1, "two"));
}

test "a generic struct at a second pair of types" {
    let p = pair(Level.High, version(1, 0, 0));
    assert.equal(p.first, Level.High);
    assert.equal(p.second, version(1, 0, 0));
}

test "a generic method on a generic struct swaps its parameters" {
    assert.equal(pair(1, "one").flip(), pair("one", 1));
    assert.equal(pair(1, "one").flip().flip(), pair(1, "one"));
}

test "a generic tuple struct" {
    assert.equal(Boxed(3).0, 3);
    assert.equal(Boxed("s").0, "s");
    assert.equal(Boxed(3), Boxed(3));
    assert.notEqual(Boxed(3), Boxed(4));
}

test "a generic struct nested in itself" {
    let p = pair(pair(1, 2), pair(3, 4));
    assert.equal(p.first.second, 2);
    assert.equal(p.second.first, 3);
}

// -----------------------------------------------------------------------------
// Generic enums
// -----------------------------------------------------------------------------

test "a generic enum carries a payload" {
    assert.equal(Slot.Filled(5).slotOr(0), 5);
    assert.equal(Slot.Vacant.slotOr(0), 0);
}

test "a generic enum at a second type" {
    assert.equal(Slot.Filled("x").slotOr("default"), "x");
    assert.equal(Slot.Vacant.slotOr("default"), "default");
}

test "a generic enum with two parameters" {
    assert.equal(Either.Right(9).eitherInt(), 9);
    assert.equal(Either.Left("nope").eitherInt(), 0);
}

test "a two-parameter generic enum is equal by variant and payload" {
    assert.equal(Either.Right(1), Either.Right(1));
    assert.notEqual(Either.Right(1), Either.Right(2));
    assert.notEqual(Either.Left(1), Either.Right(1));
}

// -----------------------------------------------------------------------------
// A recursive generic enum, with real recursion over it
// -----------------------------------------------------------------------------

test "an empty tree" {
    let t: Tree<Int> = Tree.Leaf;
    assert.equal(t.size(), 0);
    assert.equal(t.depth(), 0);
    assert.isFalse(t.has(1));
}

test "inserting into a tree grows it" {
    let t = Tree.Leaf.insert(5).insert(3).insert(8);
    assert.equal(t.size(), 3);
    assert.isTrue(t.has(3));
    assert.isTrue(t.has(5));
    assert.isTrue(t.has(8));
    assert.isFalse(t.has(4));
}

test "inserting a duplicate does not grow the tree" {
    let t = Tree.Leaf.insert(5).insert(5).insert(5);
    assert.equal(t.size(), 1);
}

test "depth follows the shape the inserts produced" {
    // Ascending inserts make a right spine.
    assert.equal(treeOf([1, 2, 3, 4]).depth(), 4);
    // A balanced-ish order is shallower.
    assert.equal(treeOf([2, 1, 3]).depth(), 2);
}

test "an in-order walk of a search tree is sorted" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(treeOf([5, 3, 8, 1, 4, 7, 9]).inOrder(ctx), [1, 3, 4, 5, 7, 8, 9]);
}

test "the same recursion at a second element type" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(treeOf(["pear", "apple", "fig"]).inOrder(ctx), ["apple", "fig", "pear"]);
}

test "the same recursion at a struct with a derived Ordered" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        treeOf([version(2, 0, 0), version(1, 0, 0), version(1, 5, 0)]).inOrder(ctx),
        [version(1, 0, 0), version(1, 5, 0), version(2, 0, 0)],
    );
}

test "the tree's Ordered is the element type's own" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Backwards reverses, so the in-order walk comes out descending by payload.
    assert.equal(treeOf([Backwards(1), Backwards(3), Backwards(2)]).inOrder(ctx), [
        Backwards(3),
        Backwards(2),
        Backwards(1),
    ]);
}

test "a derived Equal on a recursive generic enum compares the whole shape" {
    assert.equal(treeOf([1, 2, 3]), treeOf([1, 2, 3]));
    assert.notEqual(treeOf([1, 2, 3]), treeOf([3, 2, 1]));
    assert.notEqual(treeOf([1, 2, 3]), treeOf([1, 2]));
}

test "mapping a tree keeps its shape and changes its elements" {
    let ctx = context {
        Allocator: alloc(),
    };
    let t = treeOf([2, 1, 3]);
    let doubled = t.mapTree(ctx, fn(x) => x * 2);
    assert.equal(doubled.size(), 3);
    assert.equal(doubled.depth(), t.depth());
    assert.equal(doubled.inOrder(ctx), [2, 4, 6]);
}

test "mapping a tree may change its element type" {
    let ctx = context {
        Allocator: alloc(),
    };
    let t = treeOf([2, 1, 3]);
    let flags = t.mapTree(ctx, fn(x) => x > 1);
    assert.equal(flags.inOrder(ctx), [false, true, true]);
}

test "a generic enum whose parameter is a recursive generic enum" {
    let inner = treeOf([1, 2]);
    assert.equal(Slot.Filled(inner).slotOr(Tree.Leaf), inner);
    assert.equal(Slot.Vacant.slotOr(inner).size(), 2);
}

test "a generic struct whose fields are trees of different element types" {
    let ctx = context {
        Allocator: alloc(),
    };
    let p = pair(treeOf([2, 1]), treeOf(["b", "a"]));
    assert.equal(p.first.inOrder(ctx), [1, 2]);
    assert.equal(p.second.inOrder(ctx), ["a", "b"]);
}

test "recursion over a large tree stays correct" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = list.range(ctx, 0, 200);
    let t = treeOf(xs);
    assert.equal(t.size(), 200);
    assert.equal(t.inOrder(ctx), xs);
}

// -----------------------------------------------------------------------------
// Derived traits on a generic type apply at every instantiation
// -----------------------------------------------------------------------------

test "a derived Equal on a generic struct works at two instantiations" {
    assert.equal(pair(1, 2), pair(1, 2));
    assert.notEqual(pair(1, 2), pair(1, 3));
    assert.equal(pair("a", "b"), pair("a", "b"));
    assert.notEqual(pair("a", "b"), pair("a", "c"));
}

test "a derived Show on a generic struct renders both fields" {
    let ctx = context {
        Allocator: alloc(),
    };
    let shown = pair(7, "seven").show(ctx);
    assert.isTrue(shown.contains("7"));
    assert.isTrue(shown.contains("seven"));
    assert.isTrue(
        assert.some(shown.indexOf("7")) < assert.some(shown.indexOf("seven")),
    );
}

test "a derived Show on a generic enum names the variant" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(Slot.Filled(1).show(ctx).contains("Filled"));
    assert.isTrue(Slot.Vacant.show(ctx).contains("Vacant"));
    assert.isTrue(Either.Left("x").show(ctx).contains("Left"));
}

test "a derived Show on a recursive generic enum recurses" {
    let ctx = context {
        Allocator: alloc(),
    };
    let shown = treeOf([1, 2]).show(ctx);
    assert.isTrue(shown.contains("Node"));
    assert.isTrue(shown.contains("Leaf"));
    assert.isTrue(shown.contains("1"));
    assert.isTrue(shown.contains("2"));
}

test "Option is comparable and showable like any other enum" {
    let ctx = context {
        Allocator: alloc(),
    };
    let some: Option<Int> = .Some(1);
    let none: Option<Int> = .None;
    assert.equal(some, Option.Some(1));
    assert.notEqual(some, none);
    assert.isTrue(some.show(ctx).contains("Some"));
    assert.isTrue(none.show(ctx).contains("None"));
}

test "Result is comparable and showable like any other enum" {
    let ctx = context {
        Allocator: alloc(),
    };
    let ok: Result<Int, Str> = .Ok(1);
    let err: Result<Int, Str> = .Err("bad");
    assert.equal(ok, Result.Ok(1));
    assert.notEqual(ok, err);
    assert.isTrue(err.show(ctx).contains("bad"));
}

test "a generic function over a list of a generic type" {
    assert.equal(
        assert.some(largest([Boxed(1), Boxed(3), Boxed(2)]).map(fn(b) => b.0)),
        3,
    );
}
