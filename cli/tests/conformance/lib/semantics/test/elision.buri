// SPEC 5.6 — a struct literal gives every *required* field a value, and a
// field whose declared type is `Option<...>` is not required.
//
// Elision is a checker-side desugar: the literal is built with an explicit
// `.None` in the field's place, so every backend inherits it and the derived
// traits see an ordinary value. That is what these assertions are: an elided
// literal and a written one are the same value, by `Eq`, by `Show` and by
// `Hash`.

from "core/testing/assert" import * as assert;
from "core/host/testing" import { alloc };
from "core/effect" import { Alloc };

from "//lib/semantics" import { World, Holder, worldHere, Hidden, hidden, hiddenPrivate };

// -----------------------------------------------------------------------------
// 1. What an omitted field is
// -----------------------------------------------------------------------------

test "every optional field may be left out at once" {
  let world = World { hi: "hi" };
  assert.isTrue(world.hello.isNone());
}

test "an omitted field is the same value as a written `.None`" {
  assert.eq(
    World { hi: "hi" },
    World { hi: "hi", hello: .None, aliased: .None, nested: .None },
  );
}

test "a written value is not disturbed by the omission of another" {
  let world = World { hi: "hi", hello: .Some("there") };
  assert.eq(world.hello, .Some("there"));
  assert.isTrue(world.aliased.isNone());
}

test "an omitted field is not equal to a written `.Some`" {
  assert.notEq(World { hi: "hi" }, World { hi: "hi", hello: .Some("there") });
}

test "a required field of another type still decides equality" {
  assert.notEq(World { hi: "hi" }, World { hi: "bye" });
}

// -----------------------------------------------------------------------------
// 2. An alias of `Option`, and a nested one
// -----------------------------------------------------------------------------

test "a field declared through an alias of `Option` may be left out" {
  assert.isTrue(World { hi: "hi" }.aliased.isNone());
}

test "an alias field takes a written value like any other" {
  assert.eq(World { hi: "hi", aliased: .Some("named") }.aliased, .Some("named"));
}

test "an omitted `Option<Option<T>>` is the outer `.None`" {
  match (World { hi: "hi" }.nested) {
    .None => assert.isTrue(true),
    .Some(_inner) => assert.isTrue(false),
  }
}

test "the inner `.None` is still writable" {
  let world = World { hi: "hi", nested: .Some(.None) };
  match (world.nested) {
    .None => assert.isTrue(false),
    .Some(inner) => assert.isTrue(inner.isNone()),
  }
}

// -----------------------------------------------------------------------------
// 3. Shorthand, spread, and the declaring module
// -----------------------------------------------------------------------------

test "shorthand and elision compose" {
  let hi = "hi";
  assert.eq(World { hi }, World { hi: "hi" });
}

test "a spread provides the fields the literal does not write" {
  let base = World { hi: "hi", hello: .Some("there") };
  assert.eq(World { ..base }, base);
}

test "a spread keeps an optional field rather than resetting it" {
  let base = World { hi: "hi", hello: .Some("there") };
  assert.eq(World { ..base, hi: "bye" }.hello, .Some("there"));
}

test "an update may overwrite an optional field with `.None`" {
  let base = World { hi: "hi", hello: .Some("there") };
  assert.isTrue(World { ..base, hello: .None }.hello.isNone());
}

test "elision inside the declaring module builds the same value" {
  assert.eq(worldHere(), World { hi: "hi" });
}

test "a private optional field is elided by the module that declares it" {
  assert.isTrue(hiddenPrivate(hidden(7)).isNone());
  assert.eq(hidden(7), hidden(7));
}

// -----------------------------------------------------------------------------
// 4. A generic struct: the declared type is what decides
// -----------------------------------------------------------------------------

test "a field declared `Option<T>` may be left out at an instantiation" {
  assert.isTrue(Holder { only: 1 }.slot.isNone());
}

test "a field declared `Option<T>` takes a written value" {
  assert.eq(Holder { only: 1, slot: .Some(2) }.slot, .Some(2));
}

test "the same declaration elides at a second instantiation" {
  assert.eq(Holder { only: "a" }, Holder { only: "a", slot: .None });
}

test "a field declared `T` is required even where `T` is an `Option`" {
  let held: Holder<Option<Int>> = Holder { only: .Some(1) };
  assert.eq(held.only, .Some(1));
  assert.isTrue(held.slot.isNone());
}

// -----------------------------------------------------------------------------
// 5. The derived traits see an ordinary value
// -----------------------------------------------------------------------------

test "a derived `Show` reads the same either way" {
  let ctx = context { Alloc: alloc() };
  assert.eq(
    World { hi: "hi" }.show(ctx),
    World { hi: "hi", hello: .None, aliased: .None, nested: .None }.show(ctx),
  );
}

test "a derived `Show` still distinguishes an omission from a value" {
  let ctx = context { Alloc: alloc() };
  assert.notEq(
    World { hi: "hi" }.show(ctx),
    World { hi: "hi", hello: .Some("there") }.show(ctx),
  );
}

test "a derived `Hash` agrees with a derived `Eq`" {
  assert.eq(
    World { hi: "hi" }.hash(),
    World { hi: "hi", hello: .None, aliased: .None, nested: .None }.hash(),
  );
}

test "a derived `Show` on a generic struct reads the same either way" {
  let ctx = context { Alloc: alloc() };
  assert.eq(Holder { only: 1 }.show(ctx), Holder { only: 1, slot: .None }.show(ctx));
}
