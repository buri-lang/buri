// SPEC 10 — `Request` and `Response`, the two types `Network.fetch` speaks in.
//
// Every field of all four declarations is read back here: what a constructor
// puts in, what a builder changes, and what `Equal` and the derived `Show` make of
// the result. The round trip is not a nicety — E5's `Call`-by-`Equal` matches a
// recorded `fetch` against a `Request` *value*, so equality on these types is
// load-bearing.
//
// The types are declared in `core/effect`, because `effect Network`'s own signature
// names them, and re-exported by `core/net/http`. They are imported here
// through the re-export, which is where a program is meant to meet them.

from "core/bytes" import * as bytes;
from "core/effect" import { Allocator, Network };
from "core/host/testing" import { alloc, net };
from "core/net/http" import * as http;
from "core/net/http" import { Header, Method, NetError, Request, Response };
from "core/testing/assert" import * as assert;

// -----------------------------------------------------------------------------
// Method — seven variants, and no wire spelling anywhere in Buri
// -----------------------------------------------------------------------------

test "every method is its own value" {
    let all = [
        Method.Get,
        Method.Head,
        Method.Post,
        Method.Put,
        Method.Patch,
        Method.Delete,
        Method.Options,
    ];
    assert.equal(all.length(), 7);
    assert.equal(all.get(0), .Some(.Get));
    assert.equal(all.get(6), .Some(.Options));
    assert.notEq(Method.Get, Method.Head);
    assert.notEq(Method.Post, Method.Put);
}

test "a method shows as its Buri name, not its wire name" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(Method.Get.show(ctx), ".Get");
    assert.equal(Method.Options.show(ctx), ".Options");
}

// -----------------------------------------------------------------------------
// Header — two fields, lowercase names
// -----------------------------------------------------------------------------

test "a header is a name and a value" {
    let h = Header { name: "content-type", value: "text/plain" };
    assert.equal(h.name, "content-type");
    assert.equal(h.value, "text/plain");
    assert.equal(h, Header { name: "content-type", value: "text/plain" });
    assert.notEq(h, Header { name: "content-type", value: "text/html" });
}

test "a header shows both of its fields" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        Header { name: "accept", value: "*/*" }.show(ctx),
        "Header { name: \"accept\", value: \"*/*\" }",
    );
}

// -----------------------------------------------------------------------------
// Request — five fields
// -----------------------------------------------------------------------------

test "the constructor fills every field of a request" {
    let r = http.request(.Post, "http://example.com/things");
    assert.equal(r.method, .Post);
    assert.equal(r.url, "http://example.com/things");
    assert.equal(r.headers, []);
    assert.equal(r.body, []);
    assert.equal(r.timeoutMillis, 0);
}

test "a text request encodes its body as UTF-8" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = http.textRequest(ctx, .Put, "http://example.com/x", "hi €");
    assert.equal(r.method, .Put);
    assert.equal(r.body, bytes.toUtf8(ctx, "hi €"));
    assert.equal(r.body.length(), 6);
}

test "a request literal and a constructed request are equal" {
    assert.equal(http.request(.Get, "http://example.com/"), Request {
        method: .Get,
        url: "http://example.com/",
        headers: [],
        body: [],
        timeoutMillis: 0,
    });
    assert.notEq(
        http.request(.Get, "http://example.com/"),
        http.request(.Head, "http://example.com/"),
    );
}

test "withMethod, withBody and withHeader each change one field" {
    let ctx = context {
        Allocator: alloc(),
    };
    let base = http.request(.Get, "http://example.com/x");

    let posted = base.withMethod(.Post);
    assert.equal(posted.method, .Post);
    assert.equal(posted.url, base.url);

    let bodied = base.withBody([1, 2, 3]);
    assert.equal(bodied.body, [1, 2, 3]);
    assert.equal(bodied.method, .Get);

    let headed = base.withHeader(ctx, "accept", "*/*");
    assert.equal(headed.headers, [Header { name: "accept", value: "*/*" }]);
    // The receiver is unchanged: every builder answers a new value.
    assert.equal(base.headers, []);
}

test "withHeader lowercases the name and appends rather than replaces" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = http
        .request(.Get, "http://example.com/x")
        .withHeader(ctx, "Set-Cookie", "a=1")
        .withHeader(ctx, "SET-COOKIE", "b=2");
    assert.equal(r.headers, [
        Header { name: "set-cookie", value: "a=1" },
        Header { name: "set-cookie", value: "b=2" },
    ]);
    // `header` answers the first, which is the order they were added in.
    assert.equal(r.header("set-cookie"), .Some("a=1"));
    assert.equal(r.header("Set-Cookie"), .None);
    assert.equal(r.header("accept"), .None);
}

test "path is the path, without query or fragment" {
    assert.equal(http.request(.Get, "http://example.com/ping").path(), "/ping");
    assert.equal(http.request(.Get, "http://example.com/ping?x=1").path(), "/ping");
    assert.equal(http.request(.Get, "http://example.com/ping#top").path(), "/ping");
    assert.equal(http.request(.Get, "http://example.com/a/b?x=1#top").path(), "/a/b");
    assert.equal(http.request(.Get, "http://example.com:8080/a").path(), "/a");
    assert.equal(http.request(.Get, "https://example.com/a").path(), "/a");
    // No path at all, and the relative form a server hands a handler.
    assert.equal(http.request(.Get, "http://example.com").path(), "/");
    assert.equal(http.request(.Get, "/ping?x=1").path(), "/ping");
    assert.equal(http.request(.Get, "").path(), "/");
}

test "query is everything between the first ? and any #" {
    assert.equal(http.request(.Get, "http://example.com/a?x=1&y=2").query(), "x=1&y=2");
    assert.equal(http.request(.Get, "http://example.com/a?x=1#top").query(), "x=1");
    assert.equal(http.request(.Get, "http://example.com/a").query(), "");
    assert.equal(http.request(.Get, "http://example.com/a#top").query(), "");
}

test "a request shows all five of its fields" {
    let ctx = context {
        Allocator: alloc(),
    };
    let plain = http.request(.Get, "http://x/").withBody([65]);
    assert.equal(
        plain.show(ctx),
        "Request { method: .Get, url: \"http://x/\", headers: [], body: [65], timeoutMillis: 0 }",
    );
    let headed = plain.withHeader(ctx, "accept", "*/*");
    assert.isTrue(
        headed.show(ctx).contains("Header { name: \"accept\", value: \"*/*\" }"),
    );
}

// -----------------------------------------------------------------------------
// Response — three fields
// -----------------------------------------------------------------------------

test "status builds a response and nothing else" {
    let r = http.status(404);
    assert.equal(r.status, 404);
    assert.equal(r.headers, []);
    assert.equal(r.body, []);
    assert.equal(r, Response { status: 404, headers: [], body: [] });
}

test "ok carries a body and no content type" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = http.ok(ctx, "pong");
    assert.equal(r.status, 200);
    assert.equal(r.headers, []);
    assert.equal(assert.ok(http.bodyText(ctx, r.body)), "pong");
}

test "text and json each set one content type" {
    let ctx = context {
        Allocator: alloc(),
    };
    let plain = http.text(ctx, "pong");
    assert.equal(plain.status, 200);
    assert.equal(plain.header("content-type"), .Some("text/plain; charset=utf-8"));
    assert.equal(assert.ok(http.bodyText(ctx, plain.body)), "pong");

    let encoded = http.json(ctx, "{}");
    assert.equal(encoded.header("content-type"), .Some("application/json"));
    assert.equal(assert.ok(http.bodyText(ctx, encoded.body)), "{}");
}

test "isOk is 2xx and nothing else" {
    assert.isFalse(http.status(199).isOk());
    assert.isTrue(http.status(200).isOk());
    assert.isTrue(http.status(204).isOk());
    assert.isTrue(http.status(299).isOk());
    assert.isFalse(http.status(301).isOk());
    assert.isFalse(http.status(404).isOk());
    assert.isFalse(http.status(500).isOk());
}

test "withStatus, withBody and withHeader each change one field of a response" {
    let ctx = context {
        Allocator: alloc(),
    };
    let base = http.status(200);

    assert.equal(base.withStatus(503).status, 503);
    assert.equal(base.withBody([9]).body, [9]);

    let headed = base.withHeader(ctx, "Retry-After", "30");
    assert.equal(headed.headers, [Header { name: "retry-after", value: "30" }]);
    assert.equal(headed.header("retry-after"), .Some("30"));
    assert.equal(base.headers, []);
}

test "a response shows all three of its fields" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        http.status(404).withBody([110, 111]).show(ctx),
        "Response { status: 404, headers: [], body: [110, 111] }",
    );
}

test "two responses are equal exactly when all three fields are" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(http.text(ctx, "pong"), http.text(ctx, "pong"));
    assert.notEq(http.text(ctx, "pong"), http.text(ctx, "ping"));
    assert.notEq(http.text(ctx, "pong"), http.ok(ctx, "pong"));
    assert.notEq(http.status(200), http.status(404));
}

// -----------------------------------------------------------------------------
// Bodies
// -----------------------------------------------------------------------------

test "bodyText decodes octets and refuses what is not text" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.ok(http.bodyText(ctx, bytes.toUtf8(ctx, "hi €"))), "hi €");
    assert.equal(assert.ok(http.bodyText(ctx, [])), "");
    // A lone continuation byte is not UTF-8, and saying so is the point of the
    // `Result`.
    let _ = assert.err(http.bodyText(ctx, [0x80]));
}

// -----------------------------------------------------------------------------
// The effect, through the one implementation a test may have
// -----------------------------------------------------------------------------

test "send, get and post all reach the same Network.fetch" {
    let ctx = context {
        Allocator: alloc(),
        Network: net(),
    };
    assert.equal(assert.err(http.send(ctx, http.request(.Get, "http://x/"))), .Refused);
    assert.equal(assert.err(http.get(ctx, "http://x/")), .Refused);
    assert.equal(assert.err(http.post(ctx, "http://x/", "body")), .Refused);
}

test "NetError names five reasons, Aborted among them" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(http.errorText(.Timeout), "the request timed out");
    assert.equal(http.errorText(.Refused), "the connection was refused");
    assert.equal(http.errorText(.BadUrl("x")), "the url could not be parsed");
    assert.equal(http.errorText(.Transport("x")), "the transport failed");
    assert.equal(http.errorText(.Aborted), "the request was called off");
    // `Aborted` is its own reason: a caller that retries a `Timeout` must be
    // able to tell it apart from a request its own side called off.
    assert.notEq(NetError.Aborted, NetError.Timeout);
    assert.equal(NetError.Aborted.show(ctx), ".Aborted");
}
