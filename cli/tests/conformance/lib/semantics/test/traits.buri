// SPEC 5.11, 5.12 — traits, `impl`, `derive`, and operators as trait methods.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/number" import * as number;
from "core/order" import { Order };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "//lib/semantics" import {
    area, Backwards, Brick, Count, declIndex, Delta, Feather, heaviest, heavyLabel,
    Level, Loose, Meters, Offset, Pair, Percent, rank, relayAll, relayScaled,
    relayTwice, Rose, roseSum, Scale, Shape, Suit, totalGrams, Version, version,
    weighAndShow,
};

// -----------------------------------------------------------------------------
// derive Equal — structural, never referential
// -----------------------------------------------------------------------------

test "two separately constructed structs with equal fields are equal" {
    assert.equal(version(1, 2, 3), version(1, 2, 3));
}

test "a struct literal equals the same struct built by a function" {
    assert.equal(Version { major: 1, minor: 2, patch: 3 }, version(1, 2, 3));
}

test "a difference in the last field is still a difference" {
    assert.notEq(version(1, 2, 3), version(1, 2, 4));
}

test "a difference in the first field is a difference" {
    assert.notEq(version(1, 2, 3), version(9, 2, 3));
}

test "derived Equal on a payload-free enum variant" {
    assert.equal(Level.Medium, Level.Medium);
    assert.notEq(Level.Medium, Level.High);
}

test "derived Equal on an enum recurses into the payload" {
    assert.equal(Shape.Circle(2.0), Shape.Circle(2.0));
    assert.notEq(Shape.Circle(2.0), Shape.Circle(2.5));
}

test "derived Equal distinguishes variants with the same shape of payload" {
    assert.notEq(Shape.Circle(2.0), Shape.Empty);
}

test "derived Equal on a record-payload variant compares fields" {
    assert.equal(Shape.Rect { width: 2.0, height: 3.0 }, Shape.Rect {
        width: 2.0,
        height: 3.0,
    });
    assert.notEq(Shape.Rect { width: 2.0, height: 3.0 }, Shape.Rect {
        width: 3.0,
        height: 2.0,
    });
}

// -----------------------------------------------------------------------------
// derive Ordered — fields in declaration order, variants in declaration order
// -----------------------------------------------------------------------------

test "derived Ordered compares the first-declared field first" {
    // `minor` and `patch` are larger on the left, and lose anyway.
    assert.isTrue(version(1, 99, 99) < version(2, 0, 0));
    assert.isFalse(version(2, 0, 0) < version(1, 99, 99));
}

test "derived Ordered falls through to the second field on a tie" {
    assert.isTrue(version(1, 2, 99) < version(1, 3, 0));
}

test "derived Ordered falls through to the third field on two ties" {
    assert.isTrue(version(1, 2, 3) < version(1, 2, 4));
    assert.isTrue(version(1, 2, 4) > version(1, 2, 3));
}

test "derived Ordered reports equal values as neither less nor greater" {
    assert.isFalse(version(1, 2, 3) < version(1, 2, 3));
    assert.isFalse(version(1, 2, 3) > version(1, 2, 3));
    assert.isTrue(version(1, 2, 3) <= version(1, 2, 3));
    assert.isTrue(version(1, 2, 3) >= version(1, 2, 3));
}

test "derived Ordered exposes compare, which is what the operators call" {
    assert.equal(version(1, 0, 0).compare(version(2, 0, 0)), Order.Less);
    assert.equal(version(2, 0, 0).compare(version(1, 0, 0)), Order.Greater);
    assert.equal(version(1, 0, 0).compare(version(1, 0, 0)), Order.Equal);
}

test "derived Ordered on an enum ranks variants in declaration order" {
    assert.isTrue(Level.Low < Level.Medium);
    assert.isTrue(Level.Medium < Level.High);
    assert.isTrue(Level.Low < Level.High);
}

test "derived Ordered on an enum with payloads ranks by variant first" {
    // Circle, then Rect, then Empty — the order they are written in.
    assert.isTrue(Shape.Circle(1000.0) < Shape.Rect { width: 0.0, height: 0.0 });
    assert.isTrue(Shape.Rect { width: 0.0, height: 0.0 } < Shape.Empty);
}

test "derived Ordered on an enum compares payloads within one variant" {
    assert.isTrue(Shape.Circle(1.0) < Shape.Circle(2.0));
    assert.isTrue(
        Shape.Rect { width: 1.0, height: 9.0 } < Shape.Rect { width: 2.0, height: 0.0 },
    );
}

test "derived Ordered sorts a list into declaration order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sorted = [Level.High, Level.Low, Level.Medium].sortBy(ctx, fn(a, b) => {
        a.compare(b)
    });
    assert.equal(sorted, [Level.Low, Level.Medium, Level.High]);
}

// -----------------------------------------------------------------------------
// derive Show — structural, fields in declaration order
// -----------------------------------------------------------------------------

test "derived Show mentions every field value" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = version(7, 22, 333).show(ctx);
    assert.isTrue(s.contains("7"));
    assert.isTrue(s.contains("22"));
    assert.isTrue(s.contains("333"));
}

test "derived Show renders fields in declaration order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = version(7, 22, 333).show(ctx);
    let major = assert.some(s.indexOf("7"));
    let minor = assert.some(s.indexOf("22"));
    let patch = assert.some(s.indexOf("333"));
    assert.isTrue(major < minor);
    assert.isTrue(minor < patch);
}

test "derived Show names the enum variant" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(Level.Medium.show(ctx).contains("Medium"));
    assert.isTrue(Shape.Circle(2.0).show(ctx).contains("Circle"));
    assert.isTrue(Shape.Empty.show(ctx).contains("Empty"));
}

test "derived Show is a function of the value" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(version(1, 2, 3).show(ctx), version(1, 2, 3).show(ctx));
    assert.notEq(version(1, 2, 3).show(ctx), version(1, 2, 4).show(ctx));
}

// -----------------------------------------------------------------------------
// A `${...}` hole holds a value whose `Show` is derived (SPEC 3.6)
//
// The claim under every row here is one equation: a hole renders what
// `show` renders. A derived `Show` is a fold over the shape that the run time
// performs, which is why the hole needs no context of its own — and why the
// text may not be a second rendering that happens to look similar.
// -----------------------------------------------------------------------------

test "a hole holds a derived struct, and renders what show renders" {
    let ctx = context {
        Allocator: alloc(),
    };
    let v = version(1, 2, 3);
    assert.equal(str.format(ctx, "${v}"), v.show(ctx));
}

test "a derived hole is rendered in place, not appended" {
    let ctx = context {
        Allocator: alloc(),
    };
    let v = version(1, 2, 3);
    assert.equal(str.format(ctx, "v=${v}!"), str.format(ctx, "v=${v.show(ctx)}!"));
}

test "a hole holds a derived enum, payload and all" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = Shape.Rect { width: 1.0, height: 2.0 };
    assert.equal(str.format(ctx, "${s}"), s.show(ctx));
    assert.isTrue(str.format(ctx, "${s}").contains("Rect"));
}

test "a hole holds a payload-free variant" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.format(ctx, "${Level.Medium}"), Level.Medium.show(ctx));
}

test "a hole holds an array" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(str.format(ctx, "${[1, 2, 3]}"), "[1, 2, 3]");
}

test "a hole holds a generic struct, and quotes the Str inside it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let p = Pair { first: 1, second: "a" };
    assert.equal(str.format(ctx, "${p}"), p.show(ctx));
    // A `Str` *inside* a shape is quoted, exactly as `show` writes it; a `Str`
    // that is the whole hole is its own text.
    assert.isTrue(str.format(ctx, "${p}").contains("\"a\""));
    let bare = "a";
    assert.equal(str.format(ctx, "${bare}"), "a");
}

test "a hole holds a type that recurses through a container" {
    let ctx = context {
        Allocator: alloc(),
    };
    let r = Rose.Branch([Rose.Leaf(1), Rose.Leaf(2)]);
    assert.equal(str.format(ctx, "${r}"), r.show(ctx));
}

test "a hole holds an Option" {
    let ctx = context {
        Allocator: alloc(),
    };
    let some: Option<Int> = .Some(4);
    let none: Option<Int> = .None;
    assert.equal(str.format(ctx, "${some}"), some.show(ctx));
    assert.equal(str.format(ctx, "${none}"), none.show(ctx));
}

test "a derived hole sits beside primitive holes" {
    let ctx = context {
        Allocator: alloc(),
    };
    let v = version(1, 0, 0);
    assert.equal(
        str.format(ctx, "${1} ${v} ${true}"),
        str.format(ctx, "1 ${v.show(ctx)} true"),
    );
}

test "a hand-written Show is reached by calling it in the hole" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The conversion the language does not make for you: `${Suit.Hearts}` is
    // rejected, and this is what is written instead.
    assert.equal(str.format(ctx, "the suit is ${Suit.Hearts.show(ctx)}"), "the suit is H");
}

// -----------------------------------------------------------------------------
// derive Hash
// -----------------------------------------------------------------------------

test "derived Hash agrees on equal values" {
    assert.equal(version(4, 5, 6).hash(), version(4, 5, 6).hash());
}

test "derived Hash separates values that differ in one field" {
    assert.notEq(version(4, 5, 6).hash(), version(4, 5, 7).hash());
}

test "derived Hash on an enum separates variants" {
    assert.equal(Level.Low.hash(), Level.Low.hash());
    assert.notEq(Level.Low.hash(), Level.High.hash());
}

test "derived Hash on a newtype is stable" {
    assert.equal(Count(17).hash(), Count(17).hash());
    assert.notEq(Count(17).hash(), Count(18).hash());
}

// -----------------------------------------------------------------------------
// derive of the operator traits on a newtype (SPEC 5.12.4)
// -----------------------------------------------------------------------------

test "derived Add on a newtype adds the wrapped value" {
    assert.equal(Meters(1.5) + Meters(2.0), Meters(3.5));
}

test "derived Subtract on a newtype subtracts the wrapped value" {
    assert.equal(Meters(3.5) - Meters(2.0), Meters(1.5));
}

test "derived Ordered on a newtype compares the wrapped value" {
    assert.isTrue(Meters(3.5) > Meters(3.0));
    assert.isFalse(Meters(3.0) > Meters(3.5));
    assert.isTrue(Meters(1.0) < Meters(2.0));
}

test "a derived operator keeps the newtype, not the payload" {
    let total = Meters(1.5) + Meters(2.0);
    assert.equal(total.0, 3.5);
    assert.isTrue(total > Meters(3.0));
}

test "derived Multiply, Divide and Remainder on an integer newtype" {
    assert.equal(Count(6) * Count(7), Count(42));
    assert.equal(Count(42) / Count(7), Count(6));
    assert.equal(Count(43) % Count(7), Count(1));
}

test "derived Negate on a newtype" {
    assert.equal(-Delta(5), Delta(-5));
    assert.equal(-Delta(-5), Delta(5));
}

test "derived Add chains left to right" {
    assert.equal(Count(1) + Count(2) + Count(3), Count(6));
}

// -----------------------------------------------------------------------------
// A hand-written `impl Ordered` is what `<` and `>` actually use
// -----------------------------------------------------------------------------

test "a hand-written reversed Ordered decides `<`" {
    // Backwards(5) is *less than* Backwards(1) because the impl says so.
    assert.isTrue(Backwards(5) < Backwards(1));
    assert.isFalse(Backwards(1) < Backwards(5));
}

test "a hand-written reversed Ordered decides `>`" {
    assert.isTrue(Backwards(1) > Backwards(5));
    assert.isFalse(Backwards(5) > Backwards(1));
}

test "a hand-written reversed Ordered decides `<=` and `>=`" {
    assert.isTrue(Backwards(5) <= Backwards(1));
    assert.isTrue(Backwards(3) <= Backwards(3));
    assert.isTrue(Backwards(1) >= Backwards(5));
}

test "the operators and compare agree, because they are the same method" {
    assert.equal(Backwards(5).compare(Backwards(1)), Order.Less);
    assert.equal(Backwards(1).compare(Backwards(5)), Order.Greater);
    assert.equal(Backwards(3).compare(Backwards(3)), Order.Equal);
}

test "number.min through an Ordered bound follows the hand-written impl" {
    assert.equal(number.min(Backwards(1), Backwards(5)), Backwards(5));
    assert.equal(number.max(Backwards(1), Backwards(5)), Backwards(1));
}

test "sorting through a hand-written Ordered follows it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sorted = [Backwards(1), Backwards(3), Backwards(2)].sortBy(ctx, fn(a, b) => {
        a.compare(b)
    });
    assert.equal(sorted, [Backwards(3), Backwards(2), Backwards(1)]);
}

test "list.maximum through a hand-written Ordered follows it" {
    assert.equal(
        assert.some([Backwards(1), Backwards(3), Backwards(2)].maximum()),
        Backwards(1),
    );
    assert.equal(
        assert.some([Backwards(1), Backwards(3), Backwards(2)].minimum()),
        Backwards(3),
    );
}

// -----------------------------------------------------------------------------
// A hand-written `impl` on an enum
// -----------------------------------------------------------------------------

test "a hand-written enum Ordered disagrees with declaration order" {
    // Declared Diamonds, Clubs, Spades, Hearts; ordered Clubs < Diamonds.
    assert.isTrue(Suit.Diamonds.declIndex() < Suit.Clubs.declIndex());
    assert.isTrue(Suit.Clubs < Suit.Diamonds);
}

test "the hand-written bridge order holds across every adjacent pair" {
    assert.isTrue(Suit.Clubs < Suit.Diamonds);
    assert.isTrue(Suit.Diamonds < Suit.Hearts);
    assert.isTrue(Suit.Hearts < Suit.Spades);
}

test "the hand-written enum Ordered sorts into bridge order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sorted = [Suit.Hearts, Suit.Spades, Suit.Clubs, Suit.Diamonds].sortBy(
        ctx,
        fn(a, b) => a.compare(b),
    );
    assert.equal(sorted, [Suit.Clubs, Suit.Diamonds, Suit.Hearts, Suit.Spades]);
    assert.equal(sorted.mapCtx(ctx, fn(c, s) => s.rank()), [0, 1, 2, 3]);
}

test "a hand-written enum Equal is what == uses" {
    assert.equal(Suit.Hearts, Suit.Hearts);
    assert.notEq(Suit.Hearts, Suit.Spades);
}

test "a hand-written Show on an enum replaces the structural one" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(Suit.Hearts.show(ctx), "H");
    assert.equal(Suit.Clubs.show(ctx), "C");
}

// -----------------------------------------------------------------------------
// A hand-written `impl Equal` need not be structural (SPEC 5.11)
// -----------------------------------------------------------------------------

test "a hand-written Equal may ignore a field entirely" {
    assert.equal(Loose { word: "abc", ignored: 1 }, Loose { word: "xyz", ignored: 999 });
}

test "a hand-written Equal decides what != means too" {
    assert.notEq(Loose { word: "abc", ignored: 1 }, Loose { word: "abcd", ignored: 1 });
}

test "assert.equal goes through the type's own Equal" {
    // Different contents, equal by this type's rule — and assert.equal agrees,
    // because the comparison is `==` and nothing else.
    assert.isTrue(Loose { word: "aa", ignored: 0 } == Loose { word: "bb", ignored: 7 });
}

// -----------------------------------------------------------------------------
// A hand-written operator impl
// -----------------------------------------------------------------------------

test "a hand-written Add is what + calls" {
    assert.equal(Percent(60) + Percent(60), Percent(100));
    assert.equal(Percent(20) + Percent(30), Percent(50));
}

test "a hand-written Add is used at every position in a chain" {
    assert.equal(Percent(50) + Percent(40) + Percent(40), Percent(100));
}

// -----------------------------------------------------------------------------
// Trait methods called through a generic bound (SPEC 5.10)
// -----------------------------------------------------------------------------

test "a trait method resolves through a generic bound" {
    assert.equal(totalGrams([Brick { kilos: 2 }, Brick { kilos: 3 }]), 5000);
}

test "the same bounded generic works at a second type" {
    assert.equal(totalGrams([Feather { count: 3 }, Feather { count: 4 }]), 7);
}

test "a bounded generic returning the element type" {
    assert.equal(
        assert.some(
            heaviest([Brick { kilos: 1 }, Brick { kilos: 9 }, Brick { kilos: 4 }]),
        ),
        Brick { kilos: 9 },
    );
}

test "two bounds joined with + are both callable" {
    assert.equal(heavyLabel(Brick { kilos: 1 }), "brick");
    assert.equal(heavyLabel(Feather { count: 1 }), "light");
}

test "a bound of mine and a bound from core/order together" {
    let ctx = context {
        Allocator: alloc(),
    };
    let shown = weighAndShow(ctx, Feather { count: 12 });
    assert.isTrue(shown.contains("12"));
    assert.isTrue(shown.endsWith("=12"));
}

test "a trait method inside a lambda inside a bounded generic" {
    assert.equal(totalGrams([Feather { count: 1 }]), 1);
    assert.equal(totalGrams(list.empty<Feather>()), 0);
}

// -----------------------------------------------------------------------------
// `Self` written into a parameter type (SPEC 5.12)
// -----------------------------------------------------------------------------
//
// `Relay` declares `done: fn(Self, Int) => Int`, and both `impl`s write `Self`
// rather than naming their own type. The receiver handed to the callback is
// therefore a value whose type came out of the `impl` head, and every
// assertion here reads a *field* of it: a `Self` that stayed abstract past the
// front end has no fields to read and no size to pass, which on a native
// backend is a zero-sized argument and a wrong answer rather than a refusal.

test "a callback whose parameter type is written Self receives the receiver" {
    assert.equal(relayScaled(Scale { factor: 10 }, 3), 40);
}

test "the receiver a Self callback is handed carries its fields" {
    assert.equal(relayScaled(Scale { factor: 1 }, 0), 1);
    assert.equal(relayScaled(Scale { factor: 7 }, 6), 49);
}

test "a Self callback reaches the trait again through the value it is given" {
    assert.equal(relayTwice(Scale { factor: 2 }, 5), 22);
    assert.equal(relayTwice(Offset { by: 4 }, 5), 17);
}

test "a second implementation writes Self for its own type" {
    assert.equal(Offset { by: 4 }.relay(6, fn(back, value) => value + back.by), 14);
}

test "a Self callback applied once per element of a list" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(relayAll(ctx, [Scale { factor: 2 }, Scale { factor: 3 }], 4), [10, 15]);
    assert.equal(relayAll(ctx, list.empty<Scale>(), 4), list.empty<Int>());
}

test "area matches on all three payload shapes" {
    assert.equal(Shape.Rect { width: 2.0, height: 3.0 }.area(), 6.0);
    assert.equal(Shape.Empty.area(), 0.0);
    assert.isTrue(Shape.Circle(1.0).area() > 3.14);
}

// --- a derived trait on a type that recurses through a container --------------------
//
// Deciding whether a derived implementation holds is a walk over the type's
// components, and for a recursive type that walk reaches the type again. The
// direct case (`Tree`) was guarded; reaching itself through `[Rose]` was not,
// and comparing two `Rose` values hung the compiler until it ran out of stack.

test "a type that recurses through a list can be compared" {
    assert.equal(Rose.Leaf(1), Rose.Leaf(1));
    assert.notEq(Rose.Leaf(1), Rose.Leaf(2));
    assert.equal(Rose.Branch([Rose.Leaf(1)]), Rose.Branch([Rose.Leaf(1)]));
    assert.notEq(Rose.Branch([Rose.Leaf(1)]), Rose.Branch([Rose.Leaf(2)]));
    assert.notEq(Rose.Branch([]), Rose.Leaf(0));
}

test "a type that recurses through a list can be rendered" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(Rose.Branch([Rose.Leaf(1)]).show(ctx).contains("Leaf"));
}

test "nesting through the container is followed to the bottom" {
    let deep = Rose.Branch([Rose.Branch([Rose.Leaf(2), Rose.Leaf(3)]), Rose.Leaf(4)]);
    assert.equal(roseSum(deep), 9);
    assert.equal(
        deep,
        Rose.Branch([Rose.Branch([Rose.Leaf(2), Rose.Leaf(3)]), Rose.Leaf(4)]),
    );
}
