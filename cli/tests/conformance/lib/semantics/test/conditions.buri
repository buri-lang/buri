// SPEC 8.2.4: an `if` on a `Bool` takes the branch its value names, wherever
// the comparison that made it ran.
//
// Each function in `conditions.buri` makes a `Bool` from a comparison over
// arithmetic and branches on it somewhere else: after other work, in another
// function, through a field or a generic. The stencil backend once redid the
// comparison at the branch, from operands the work in between had overwritten
// (buri-lang/buri#297). The functions sit in the library rather than here so
// that `buri test --coverage` probes them too.

from "core/testing/assert" import * as assert;
from "//lib/semantics" import * as c;

test "a comparison bound before a list is built still decides the if after it" {
    assert.equal([c.heldAcrossAList(0), c.heldAcrossAList(1), c.heldAcrossAList(2)], [
        [],
        [],
        [2, 2, 2],
    ]);
}

test "a product compared before a list is built still decides the if after it" {
    assert.equal(
        [
            c.heldAcrossAnotherList(0, 5),
            c.heldAcrossAnotherList(1, 2),
            c.heldAcrossAnotherList(2, 20),
        ],
        [[], [], [20]],
    );
}

test "n - 1 > 0, passed on" {
    assert.equal([c.minusOne(0), c.minusOne(1), c.minusOne(2), c.minusOne(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "n + 1 > 1, passed on" {
    assert.equal([c.plusOne(0), c.plusOne(1), c.plusOne(2), c.plusOne(3)], [
        2,
        1,
        1,
        1,
    ]);
}

test "a comparison named by a let, passed on" {
    assert.equal([c.named(0), c.named(1), c.named(2), c.named(3)], [2, 2, 1, 1]);
}

test "n > 0, passed on" {
    assert.equal([c.plain(0), c.plain(1), c.plain(2), c.plain(3)], [2, 1, 1, 1]);
}

test "n - 1 > 0 && true, passed on" {
    assert.equal([c.withAnd(0), c.withAnd(1), c.withAnd(2), c.withAnd(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "an if on the comparison itself" {
    assert.equal([c.inline(0), c.inline(1), c.inline(2), c.inline(3)], [2, 2, 1, 1]);
}

test "a match on a passed Bool" {
    assert.equal([c.matched(0), c.matched(1), c.matched(2), c.matched(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "an if on the negation of a passed Bool" {
    assert.equal([c.negated(0), c.negated(1), c.negated(2), c.negated(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "an if comparing a passed Bool with false" {
    assert.equal(
        [c.equalsFalse(0), c.equalsFalse(1), c.equalsFalse(2), c.equalsFalse(3)],
        [2, 2, 1, 1],
    );
}

test "nested ifs on two passed Bools" {
    assert.equal([c.nested(0), c.nested(1), c.nested(2), c.nested(3)], [3, 3, 1, 2]);
}

test "n * 3 < 7, passed on" {
    assert.equal([c.below(0), c.below(1), c.below(2), c.below(3)], [1, 1, 1, 2]);
}

test "n - 2 >= 0, passed on" {
    assert.equal([c.atLeast(0), c.atLeast(1), c.atLeast(2), c.atLeast(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "n + 1 == 3, passed on" {
    assert.equal([c.equals(0), c.equals(1), c.equals(2), c.equals(3)], [2, 2, 1, 2]);
}

test "n - 1 != 0, passed on" {
    assert.equal([c.differs(0), c.differs(1), c.differs(2), c.differs(3)], [
        1,
        2,
        1,
        1,
    ]);
}

test "x * 2.0 > 3.0, passed on" {
    assert.equal([c.float(0.5), c.float(1.0), c.float(1.5), c.float(2.0)], [
        2,
        2,
        2,
        1,
    ]);
}

test "x - 0.5 < 1.0, passed on" {
    assert.equal(
        [c.floatBelow(0.5), c.floatBelow(1.0), c.floatBelow(1.5), c.floatBelow(2.0)],
        [1, 1, 2, 2],
    );
}

test "a Bool stored in a field and read back" {
    assert.equal([c.stored(0), c.stored(1), c.stored(2), c.stored(3)], [2, 2, 1, 1]);
}

test "a passed Bool picking an Int in a generic function" {
    assert.equal([c.generic(0), c.generic(1), c.generic(2), c.generic(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "a passed Bool picking a Str in a generic function" {
    assert.equal(
        [c.genericText(0), c.genericText(1), c.genericText(2), c.genericText(3)],
        ["no", "no", "yes", "yes"],
    );
}

test "a passed Bool as a match guard" {
    assert.equal([c.guardedBy(0), c.guardedBy(1), c.guardedBy(2), c.guardedBy(3)], [
        2,
        2,
        1,
        1,
    ]);
}

test "two passed Bools under ||" {
    assert.equal([c.eitherSide(0), c.eitherSide(1), c.eitherSide(2), c.eitherSide(3)], [
        1,
        2,
        1,
        1,
    ]);
}

test "&& and || over comparisons, passed on" {
    assert.equal([c.mixed(0), c.mixed(1), c.mixed(2), c.mixed(3), c.mixed(4)], [
        1,
        2,
        1,
        1,
        2,
    ]);
}

test "&& and || over three passed Bools" {
    assert.equal(
        [
            c.mixedArguments(0),
            c.mixedArguments(1),
            c.mixedArguments(2),
            c.mixedArguments(3),
            c.mixedArguments(4),
        ],
        [1, 2, 1, 1, 2],
    );
}
