test "a fresh network refuses a GET" {
    let ctx = context {
        Alloc: alloc(),
        Net: net(),
    };
    assert.eq(assert.err(http.get(ctx, "http://example.com")), .Refused);
}

test "a fresh network refuses a POST" {
    let ctx = context {
        Alloc: alloc(),
        Net: net(),
    };
    assert.eq(assert.err(http.post(ctx, "http://example.com", "body")), .Refused);
}

test "a fresh network refuses a raw fetch through the effect method" {
    let ctx = context {
        Alloc: alloc(),
        Net: net(),
    };
    assert.eq(assert.err(fetchBody(ctx, "http://example.com")), .Refused);
}

test "a default network refuses" {
    let ctx = Defaults();
    assert.eq(
        http.errorText(assert.err(http.get(ctx, "http://x"))),
        "the connection was refused",
    );
}

// -----------------------------------------------------------------------------
// My own implementations of an effect (SPEC 10.3, 10.9)
// -----------------------------------------------------------------------------

test "the code under test calls MY readFile" {
    let ctx = Mine();
    assert.eq(assert.ok(loadText(ctx, "known.txt")), "from my own Fs");
}

test "MY readFile decides what is missing" {
    let ctx = Mine();
    assert.eq(assert.err(loadText(ctx, "config.toml")), .NotFound);
}

test "MY writeFile decides what a write does" {
    // The runner's `fs()` would have accepted this write, and `readOnly()`
    // would have failed it with `.ReadOnly`; mine fails it with a third error,
    // so the error names which implementation ran.
    let ctx = Mine();
    assert.eq(assert.err(saveText(ctx, "known.txt", "nope")), .PermissionDenied);
}

test "MY fileExists is what fs.exists calls" {
    let ctx = Mine();
    assert.isTrue(fs.exists(ctx, "known.txt"));
    assert.isFalse(fs.exists(ctx, "anything-else"));
}

test "MY readDir is what fs.listDir calls" {
    let ctx = Mine();
    assert.eq(assert.ok(fs.listDir(ctx, "/")), ["known.txt"]);
}

test "MY clock is what time.now reads" {
    let ctx = Mine();
    assert.eq(stamp(ctx).0, 424242);
}

test "MY clock ignores sleep, because my implementation does nothing" {
    let ctx = Mine();
    time.sleepMs(ctx, 1000);
    assert.eq(stamp(ctx).0, 424242);
}

test "MY env answers every variable the same way" {
    let ctx = Mine();
    assert.eq(assert.some(env.get(ctx, "ANYTHING")), "echo");
    assert.eq(assert.some(env.get(ctx, "HOME")), "echo");
    assert.eq(env.args(ctx), ["echo"]);
}

test "MY net answers instead of refusing" {
    let ctx = Mine();
    assert.eq(assert.ok(fetchBody(ctx, "http://example.com")), "teapot");
}

test "MY net is what core/net/http is built on" {
    let ctx = Mine();
    let response = assert.ok(http.get(ctx, "http://example.com"));
    assert.eq(response.status, 418);
    assert.eq(assert.ok(http.bodyText(ctx, response.body)), "teapot");
    assert.eq(response.headers, []);
    assert.isFalse(response.isOk());
}

test "one binding may be mine and the rest the runner's" {
    let ctx = context {
        Alloc: alloc(),
        Fs: StaticFs { only: "k", body: "v" },
        Clock: clock().at(3),
    };
    assert.eq(assert.ok(loadText(ctx, "k")), "v");
    assert.eq(time.now(ctx).0, 3);
}

test "a fake is an ordinary value, so two of them are independent" {
    let a = context {
        Alloc: alloc(),
        Fs: StaticFs { only: "a", body: "A" },
    };
    let b = context {
        Alloc: alloc(),
        Fs: StaticFs { only: "b", body: "B" },
    };
    assert.eq(assert.ok(loadText(a, "a")), "A");
    assert.eq(assert.err(loadText(b, "a")), .NotFound);
    assert.eq(assert.ok(loadText(b, "b")), "B");
}

test "a confined callee receives the same value" {
    // `stamp` names only Clock, so it can do nothing else with this context.
    let ctx = context {
        Clock: FrozenClock { at: 9 },
        Fs: fs().files([]),
    };
    assert.eq(stamp(ctx).0, 9);
    assert.isFalse(fs.exists(ctx, "anything"));
}

// -----------------------------------------------------------------------------
// Attenuation with a wrapper of my own (SPEC 10.8)
// -----------------------------------------------------------------------------

test "my own attenuator forwards the reads it chose to forward" {
    let ctx = context {
        Alloc: alloc(),
        Fs: guarded(fs().files([("a", "A")])),
    };
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
    assert.isTrue(fs.exists(ctx, "a"));
    assert.isFalse(fs.exists(ctx, "b"));
}

test "my own attenuator refuses the writes it chose to refuse" {
    // The wrapped filesystem would have accepted this write; the wrapper never
    // reaches it, and the error is the wrapper's own.
    let ctx = context {
        Alloc: alloc(),
        Fs: guarded(fs().files([("a", "A")])),
    };
    assert.eq(assert.err(saveText(ctx, "a", "B")), IoError.Other("guarded"));
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
}

test "my own attenuator may wrap my own implementation" {
    let ctx = context {
        Alloc: alloc(),
        Fs: guarded(StaticFs { only: "k", body: "v" }),
    };
    assert.eq(assert.ok(loadText(ctx, "k")), "v");
    assert.eq(assert.err(loadText(ctx, "other")), IoError.NotFound);
    assert.eq(assert.err(saveText(ctx, "k", "w")), IoError.Other("guarded"));
}

test "my own attenuator may wrap the runner's attenuator" {
    let ctx = context {
        Alloc: alloc(),
        Fs: guarded(fs().files([("a", "A")]).readOnly()),
    };
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
    // The outer wrapper decides, so it is mine and not `.ReadOnly`.
    assert.eq(assert.err(saveText(ctx, "a", "B")), IoError.Other("guarded"));
}

// -----------------------------------------------------------------------------
// Effects a platform grants together, and the method names they claim
// -----------------------------------------------------------------------------
//
// `Listen` and `Sockets` are granted on the native platforms only, and this
// corpus runs on JavaScript too, so `host.listen` is unreachable from here
// (`standard_library/mod.rs`'s grant table, and two reject fixtures). An effect
// is still an ordinary interface, so a fake satisfies it and the *shape* is
// exercised on every backend — and the shape is the thing that is expensive to
// get wrong.
//
// What these blocks are really about is method-name collision. A call through
// a context searches every effect it binds, and two effects declaring one name
// make the call ambiguous rather than either declaration wrong; `Ui.read` and
// `Watch.read` are the shipped example, and there is no way to withdraw a name
// once programs are written against it. A server binds `Listen`, `Sockets` and
// `Net` in one context by design, so that trio is where the question had to be
// answered, and these are the answer as assertions. A *build* error here is
// the failure — the runtime values are almost beside the point.

test "one context binds Listen, Sockets and Net and every method is callable" {
    let ctx = context {
        Listen: OneShotListen { bindsTo: "127.0.0.1" },
        Net: TeapotNet { body: [] },
        Sockets: QuietSockets { },
    };
    // 418 back from the fake network, and positive because the fake server bound
    // its address — so both effects answered, and neither call was the other.
    assert.eq(serveOnce(ctx, "http://example.com/ping"), 418);
}

test "the same five methods resolve on the context value itself" {
    // `serveOnce` reaches them through a *bounded type parameter*; this reaches
    // them through a context value handed to the same wrappers, which is the
    // other half of the lookup (`Ty::Param` and `Ty::Ctx` both land in
    // `find_in_bounds`, one layer down, inside `core/net/server`).
    let ctx = context {
        Alloc: alloc(),
        Listen: OneShotListen { bindsTo: "127.0.0.1" },
        Net: TeapotNet { body: [] },
        Sockets: QuietSockets { },
        Stdout: stdout(),
    };
    let _ = server.sendText(ctx, 1, "hello");
    let _ = server.sendBytes(ctx, 1, []);
    let _ = server.close(ctx, 1, 1000, "bye");
    // `c` is the **caller's context**, which is what `run` hands the handler:
    // it calls `onRequest` itself, under the context `serve` was given. So the
    // assertion is that `c` can do what *this* context grants and the acceptor
    // does not — allocating, here — and `.Ok(())` back means the loop ran to
    // the listener's own end.
    assert.ok(
        server.serve(ctx, server.Server {
            port: 0,
            address: .Some("127.0.0.1"),
            onRequest: fn(c, request) => {
                Response {
                    status: if (str.format(c, "${request.url}") == "127.0.0.1") {
                        200
                    } else {
                        500
                    },
                    headers: [],
                    body: [],
                }
            },
        }),
    );
    let reply = assert.ok(
        http.send(ctx, Request {
            method: .Get,
            url: "http://example.com/ping",
            headers: [],
            body: [],
        }),
    );
    assert.eq(reply.status, 418);
}

// -----------------------------------------------------------------------------
// `core/net/server`'s own vocabulary
// -----------------------------------------------------------------------------
//
// The blocks above are about the *effect* — which names it claims, and what a
// handler is handed. These are about the module on top of it: the `Server`
// value, the two halves `serve` is made of, and the convention its `Option`
// fields travel under.
//
// The convention is the one thing here that is a *library* rule rather than a
// behaviour: an omitted `Option` field is `.None` (SPEC 5.6), and `.None`
// means "the runtime chooses" rather than a number this module promises. So
// what can be asserted from Buri is that omitting a field and writing `.None`
// are the same value — which is the half a program can rely on — and the
// acceptor's own answers are `cli/runtime/net.rs`'s to test.

test "an omitted Server field is .None and not a default this module chose" {
    let written = server.Server {
        port: 0,
        onRequest: fn(_c, _r) => Response { status: 200, headers: [], body: [] },
        address: .None,
        protocols: .None,
        requestLimit: .None,
        idleTimeoutMillis: .None,
    };
    let elided = server.Server {
        port: 0,
        onRequest: fn(_c, _r) => Response { status: 200, headers: [], body: [] },
    };
    assert.eq(elided.address, written.address);
    assert.eq(elided.protocols, written.protocols);
    assert.eq(elided.requestLimit, written.requestLimit);
    assert.eq(elided.idleTimeoutMillis, written.idleTimeoutMillis);
    assert.none(elided.address);
}

test "bind answers the port the acceptor chose, and run is the rest of serve" {
    // The reason the two halves are exported separately: a program binding
    // `port: 0` does not know its own port until the bind returns, and it has
    // to be able to publish it *before* the loop starts.
    let ctx = context {
        Alloc: alloc(),
        Listen: OneShotListen { bindsTo: "10.0.0.1" },
        Stdout: stdout(),
    };
    let plan = server.Server {
        port: 0,
        onRequest: fn(_c, _r) => Response { status: 200, headers: [], body: [] },
    };
    let listener = assert.ok(server.bind(ctx, plan));
    assert.eq(listener.port, 8080);
    assert.ok(server.run(ctx, listener, plan.onRequest));
}

test "a bind that fails is an error with the platform's own words on it" {
    let ctx = context {
        Alloc: alloc(),
        Listen: OneShotListen { bindsTo: "" },
        Stdout: stdout(),
    };
    let refused = assert.err(
        server.bind(ctx, server.Server {
            port: 0,
            onRequest: fn(_c, _r) => Response { status: 200, headers: [], body: [] },
        }),
    );
    // The cause is what a program branches on; the detail is what it prints.
    // Two fields rather than an enum with payloads, which is also what lets the
    // detail cross the C ABI — `core/effect` says so where `ServeError` is.
    assert.eq(refused.cause, .PermissionDenied);
    assert.eq(refused.detail, "no address");
    assert.eq(server.errorText(refused), "listening was not permitted");
}

test "every cause has a sentence, and errorText needs no context to say it" {
    // A constant per variant, so a `main` whose context grants nothing but
    // `Listen` can still `.mapErr(server.errorText)`.
    let ctx = context {
        Alloc: alloc(),
    };
    let said = [
        ServeFailure.AddressInUse,
        ServeFailure.AddressNotAvailable,
        ServeFailure.PermissionDenied,
        ServeFailure.Unsupported,
        ServeFailure.Timeout,
        ServeFailure.Closed,
        ServeFailure.Transport,
    ].map(ctx, fn(cause) => server.errorText(ServeError { cause: cause, detail: "" }));
    assert.eq(said.len(), 7);
    assert.isTrue(said.all(fn(line) => line != ""));
}

test "a server that will not bind is the Listen answer and not the network's" {
    // The network still answers 418; the negation is the bind's refusal, so the
    // two effects are distinguishable through one context.
    let ctx = context {
        Listen: OneShotListen { bindsTo: "" },
        Net: TeapotNet { body: [] },
        Sockets: QuietSockets { },
    };
    assert.eq(serveOnce(ctx, "http://example.com/ping"), 0 - 418);
}

// -----------------------------------------------------------------------------
// A request handler is handed the caller's context
// -----------------------------------------------------------------------------
//
// `Listen` used to take the request handler as a `Self`-spelled callback and
// invoke it, which made "which type is `Self` when the call goes through a
// context" a question with a program's life on it: substituting the receiver
// gave the handler the context's layout while the implementation's arrived,
// JavaScript never noticed because nothing there is laid out, and both native
// backends read the wrong bytes and died with no output at all. The rule that
// settled it is still the compiler's — `Self` is the implementing type, read
// off the context's bindings by `implementing_ty`, and adapted at
// instantiation by `middle/monomorphize.rs`'s `rewrite_call_args` where a
// bounded `C` hid the context — and it is guarded by that module's unit tests
// and by `semantics/expressions.rs`'s, which declare their own effect because
// they are written as a platform module.
//
// What the effect does now is *not* take a handler. `core/net/server`'s `run`
// accepts, calls `onRequest` under the caller's own context, and responds, so
// the handler's first parameter is the caller's `C` by construction and
// nothing about it crosses `Listen` at all. That is the property these blocks
// assert, and it is asserted the same way it always was: the handler uses an
// authority the *acceptor does not grant*, so it can only be working off the
// caller's context.
//
// The section below this one is the same rule for a task, which never changed:
// an effect that hands a callback the caller's context takes it as a `ctx`
// parameter and names it, which is what `Tasks.parallel` does.

test "a handler reached through the wrapper is handed the caller's context" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Listen: OneShotListen { bindsTo: "10.0.0.1" },
        Stdout: sink,
    };
    // Printing is something this context grants and `OneShotListen` does not, so
    // a handler handed the acceptor could not do it — and the capture below is
    // what says the line ran at all.
    assert.ok(
        server.serve(ctx, server.Server {
            port: 0,
            address: .Some("10.0.0.1"),
            onRequest: fn(c, request) => {
                io.println(c, "hit ${request.url}").ignore();
                Response {
                    status: if (request.url == "10.0.0.1") { 200 } else { 500 },
                    headers: [],
                    body: [],
                }
            },
        }),
    );
    assert.eq(sink.captured(), "hit 10.0.0.1\n");
    // The negation: the acceptor hands out a request naming *its own* address,
    // so a handler comparing the two answers 500 when they disagree, and
    // `OneShotListen` refuses anything outside 200..599 — a listener that
    // answered `.Ok` whatever it was handed would pass the block above too.
    let _ = assert.err(
        server.serve(ctx, server.Server {
            port: 0,
            address: .Some("10.0.0.1"),
            onRequest: fn(c, request) => {
                io.println(c, "hit ${request.url}").ignore();
                Response { status: 42, headers: [], body: [] }
            },
        }),
    );
    assert.eq(sink.captured(), "hit 10.0.0.1\nhit 10.0.0.1\n");
}

test "a context binding two effects reaches both through bounds" {
    // `serveOnce` and `runInOrder` over one context, so the two questions are
    // answered in the same instantiation and neither overwrites the other.
    let ctx = context {
        Alloc: alloc(),
        Listen: OneShotListen { bindsTo: "127.0.0.1" },
        Net: TeapotNet { body: [] },
        Sockets: QuietSockets { },
        Tasks: SerialTasks { label: "serial", bias: 0 },
    };
    assert.eq(serveOnce(ctx, "http://example.com/ping"), 418);
    assert.eq(runInOrder(ctx, [3, 4]), 107);
}

// -----------------------------------------------------------------------------
// A task is handed the caller's context (SPEC 10.6, 10.9)
// -----------------------------------------------------------------------------
//
// `Tasks.parallel<C, A, B>(self, ctx: C, items: [A], f: fn(C, Int, A) => B)`
// promises every step the caller's *whole* context, and these blocks are that
// promise as assertions. A step's first parameter is not the scheduler and not
// `Self`: it carries every bound the caller declared, so a step can do anything
// its caller could and nothing it could not.
//
// This is a recorded compiler bug written out. `parallel` used to spell the
// step's first parameter `Self` while documenting it as the context, and the
// trampoline delivered what the signature said: the implementation. Where the
// implementation was `core/host`'s empty `HostTasks` nothing was visibly wrong,
// because an empty struct and a context of empty structs are both zero words.
// The moment a context bound something stateful the two backends *disagreed* —
// natively the scheduler's handle was read as a clock and answered `0`, and on
// JavaScript a one-element array was indexed past its end and threw — which is
// the shape of a wrong answer rather than a refused one, and is why every block
// below reads a **value** out of the context rather than only calling through
// it.
//
// A step that ignores its first parameter passes whatever it is handed, so
// none of these do.

test "a step reads an effect out of the context it is handed" {
    // The reduced repro. `clock().at(5)` is stateful, so the answer says which value
    // arrived and not only how wide it was: a step handed the scheduler read `0`.
    let runner = SerialTasks { label: "s", bias: 0 };
    let ctx = context {
        Alloc: alloc(),
        Clock: clock().at(5),
        Tasks: runner,
    };
    let out = tasks.parallel(ctx, [7, 9], fn(c, i, x) => time.now(c).0 + x);
    assert.eq(out, [12, 14]);
}

test "a step uses two effects from its context in one expression" {
    // `Alloc` and `Clock` together, through `str.format`, which needs the first
    // and reads the second: a step handed one effect's implementation could
    // satisfy neither, and a step handed a context missing one would not compile.
    let runner = SerialTasks { label: "s", bias: 0 };
    let ctx = context {
        Alloc: alloc(),
        Clock: clock().at(5),
        Tasks: runner,
    };
    let out = tasks.parallel(ctx, [7, 9], fn(c, i, x) => {
        str.format(c, "${time.now(c).0}:${i}:${x}")
    });
    assert.eq(out, ["5:0:7", "5:1:9"]);
}

test "a nested parallel is made with the context the outer step was handed" {
    // The context has to survive being handed *out* to a step and then handed
    // back *in* as the receiver of a second call — which is the whole of what
    // "the full context" means, since a value that only looked right at the first
    // boundary would lose its clock at the second.
    let runner = SerialTasks { label: "s", bias: 0 };
    let ctx = context {
        Alloc: alloc(),
        Clock: clock().at(5),
        Tasks: runner,
    };
    let out = tasks.parallel(ctx, [7], fn(c, i, x) => {
        tasks
            .parallel(c, [x, x], fn(d, j, y) => time.now(d).0 + y + j)
            .fold(fn(a, m) => a + m, 0)
    });
    assert.eq(out, [25]);
}

test "a step through a bounded type parameter has the caller's bounds" {
    // `runInOrderNamed<C: Alloc + Tasks>` allocates *inside* the step, which is a
    // compile-time claim before it is a runtime one: nothing in that body names
    // what implements `Tasks` for `C`, so a step's first parameter typed as the
    // implementation would have no `Alloc` and the function would not build.
    let ctx = context {
        Alloc: alloc(),
        Tasks: SerialTasks { label: "s", bias: 0 },
    };
    assert.eq(runInOrderNamed(ctx, [3, 4]), ["0:3", "1:4"]);
}

test "an ordinary Buri implementation hands its steps the context" {
    // `SerialTasks` is written in Buri and calls its own callback — which it can
    // only do because the parameter is *named*. This is the rule's cost and its
    // point: `parallel` is implementable by anyone (SPEC 10.9), rather than only
    // by the compiler's trampoline.
    let runner = SerialTasks { label: "s", bias: 0 };
    let ctx = context {
        Alloc: alloc(),
        Clock: clock().at(11),
        Tasks: runner,
    };
    let out = tasks.parallel(ctx, [1, 2], fn(c, i, item) => {
        time.now(c).0 + i * 10 + item
    });
    assert.eq(out[0] ?? 0, 12);
    assert.eq(out[1] ?? 0, 23);
}

// -----------------------------------------------------------------------------
// A context-bounded parameter, satisfied by something that is not a context
// (SPEC 10.1, 10.8)
// -----------------------------------------------------------------------------
//
// `<C: Alloc>` is an ordinary bound, so the argument at `C` need not be a
// `context { … }` record — anything that implements `Alloc` satisfies it, and
// `core/host/testing`'s `alloc()` is a `struct TestAlloc(I64)` that does.
// Every block above passes a context, and every one of these deliberately does
// not.
//
// This is a recorded compiler bug written out as assertions. The native ABI
// drops a call's context argument, because the runtime allocates through
// `buri_rt_alloc` and has no use for one — and it asked *which* argument that
// was by looking at the value's type. A bare implementing value is not a
// `Ty::Ctx`, so it spread to a leaf the C signature has no parameter for and
// shifted every argument after it one register down: the reduced case died in
// `memmove` before the first block ran. Which argument is the context is now
// read off the declaration (`backend/runtime_table.rs`'s `Entry::ctx`).

test "a bare implementing value satisfies a context bound" {
    // The reduced repro. `alloc()` is not a context and never was one.
    assert.eq(pushedWith(alloc(), 7, [1]), [1, 7]);
}

test "a bare implementing value reaches a context in first position" {
    // `list.repeat(ctx, item, times)` has no receiver, so its context is
    // argument zero — the other index the rule can take.
    assert.eq(repeatedWith(alloc(), 5), [5, 5]);
}

test "a bare implementing value reaches str.concat, which has no table row" {
    assert.eq(joinedWith(alloc(), "ab", "cd"), "abcd");
}

test "an attenuating wrapper is a context bound's argument" {
    // SPEC 10.8's shape, and the reason the language wants the bound to be
    // ordinary: `ReadOnly` forwards `Alloc` and nothing else, so a callee holding
    // one genuinely cannot do the rest.
    assert.eq(pushedWith(ReadOnly { inner: alloc() }, 7, [1]), [1, 7]);
}

test "an implementor carrying a counted pointer is a context bound's argument" {
    // Two leaves and a `Str` among them, so the argument the C signature drops is
    // wider than one word and is one reference counting still has to balance.
    assert.eq(loggedWith(alloc(), [1]), [1, 4]);
}

test "one value satisfying two effects discharges a two-effect bound" {
    // `C: Alloc + Clock` through a single implementing value rather than a
    // context binding two rows, so the bound being a *list* is exercised.
    // Both bindings are live, and neither is asked for at the *call*: `ticking`
    // demands nothing, and what needs `Alloc` and `Clock` is `Ticking`'s own two
    // `impl`s, which the monomorphiser reaches and the checker does not.
    let both = ticking(context {
        Alloc: alloc(),
        Clock: clock().at(5),
    });
    assert.eq(stampedWith(both, [1]), [1, 5]);
}

test "a context holding the same double still reaches the same answer" {
    // The shape every other block in this file uses, asserted next to the bare
    // one: a `context { … }` whose binding is the very same `TestAlloc` handle.
    // The two are different types and must reach one answer.
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(pushedWith(ctx, 7, [1]), [1, 7]);
    assert.eq(repeatedWith(ctx, 5), [5, 5]);
    assert.eq(joinedWith(ctx, "ab", "cd"), "abcd");
}
