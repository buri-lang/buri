// SPEC 10, 11.2, 11.3 — effects, contexts, and the test platform.
//
// This file used to carry a recorded compiler bug in this comment: an effect
// *inherited* through a `..spread` could not be used, because the binding the
// spread copied did not carry the implementing type the base had recorded, and
// so `context { ..Defaults(), Fs: fs() }` typechecked but any call through
// the inherited `Clock` failed at monomorphization with "`Clock` could not be
// resolved to a concrete type". It is fixed — the spread keeps that type
// (`semantics/expressions.rs`, `check_context_body`) — and the section
// "An effect INHERITED through a spread" below is the bug written out as
// assertions instead: a build error there is a failure, so those blocks are a
// compile-time claim as much as a runtime one.

from "core/bytes" import * as bytes;
from "core/effect" import {
    Alloc, Clock, Env, Fs, IoError, Listen, Net, Rand, Request, Response, ServeError,
    ServeFailure, Sockets, Stderr, Stdin, Stdout, Tasks,
};
from "core/env" import * as env;
from "core/fs" import * as fs;
from "core/host/testing" import {
    alloc, clock, env, fs, net, rand, stderr, stdin, stdout,
};
from "core/io" import * as io;
from "core/net/http" import * as http;
from "core/net/server" import * as server;
from "core/random" import * as random;
from "core/str" import * as str;
from "core/tasks" import * as tasks;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "//lib/semantics" import {
    EchoEnv, elapsed, fetchBody, FrozenClock, greet, guarded, joinedWith, loadText,
    loggedWith, OneShotListen, pushedWith, QuietSockets, ReadOnly, repeatedWith,
    roundTrip, runInOrder, runInOrderNamed, saveText, SerialTasks, serveOnce, shout,
    stamp, stampedWith, StaticFs, TeapotNet, ticking,
};

// -----------------------------------------------------------------------------
// Named context declarations in a test source (SPEC 11.3)
// -----------------------------------------------------------------------------

/// Every effect, at the default the double it names is born with: nothing
/// captured, nothing on stdin, an empty filesystem, a network that refuses, a
/// clock at zero, a seeded generator, and no variables and no arguments.
///
/// A test binds what it needs and no more, so nine bindings is not what a suite
/// writes — it is what the spreads below are *about*. An effect a declaration
/// never names has to arrive from somewhere, and this is the somewhere.
context Defaults {
    Alloc: alloc(),
    Stdout: stdout(),
    Stderr: stderr(),
    Stdin: stdin(),
    Fs: fs(),
    Net: net(),
    Clock: clock(),
    Rand: rand(),
    Env: env(),
}

/// Begins with a spread and replaces one binding.
context Fixture {
    ..Defaults(),
    Fs: fs().files([("config.toml", "port=8080"), ("empty.txt", "")]),
}

/// A second declaration built from the first, replacing that same binding.
context OtherPort {
    ..Fixture(),
    Fs: fs().files([("config.toml", "port=9999")]),
}

/// A third, built from the second: two spreads between this and `Defaults`,
/// with an effect replaced here that neither of them named.
context DeepFixture {
    ..OtherPort(),
    Clock: clock().at(1234),
}

/// A spread whose replacement is a *generic* wrapper. The binding written here
/// is `Guarded<TestFs>`, so what a later spread carries is an implementing type
/// with type arguments of its own rather than a bare one.
context WrappedFixture {
    ..Defaults(),
    Fs: guarded(fs().files([("a", "A")])),
}

/// A context assembled from scratch, naming only two effects.
context Tiny {
    Alloc: alloc(),
    Fs: fs().files([("a", "A")]),
}

/// A context that binds *my* implementations rather than the runner's.
context Mine {
    Alloc: alloc(),
    Fs: StaticFs { only: "known.txt", body: "from my own Fs" },
    Clock: FrozenClock { at: 424242 },
    Env: EchoEnv { always: "echo" },
    // "teapot" as octets — see `TeapotNet`: an effect method takes only `self`,
    // so the fake is handed the bytes rather than encoding them.
    Net: TeapotNet { body: [116, 101, 97, 112, 111, 116] },
}

/// The whole world, written out, so a test can use every effect in it.
context World {
    Alloc: alloc(),
    Stdout: stdout(),
    Stderr: stderr(),
    Stdin: stdin().lines(["a line"]),
    Fs: fs().files([("w", "W")]),
    Net: net(),
    Clock: clock().at(1000),
    Rand: rand().seed(4),
    Env: env().variables([("K", "V")]).arguments(["arg"]),
}

// -----------------------------------------------------------------------------
// Building a context
// -----------------------------------------------------------------------------

test "a context binds one implementation per effect it names" {
    let ctx = World();
    assert.isTrue(fs.exists(ctx, "w"));
    assert.eq(time.now(ctx).0, 1000);
    assert.eq(assert.some(io.readLine(ctx)), "a line");
    assert.eq(env.args(ctx), ["arg"]);
    greet(ctx, "world");
    io.eprintln(ctx, "err").ignore();
    assert.eq(assert.err(http.get(ctx, "http://example.com")), .Refused);
    assert.isTrue(random.int(ctx, 0, 10) >= 0);
}

test "a declaration may bind every effect at its double's default" {
    let ctx = Defaults();
    assert.isFalse(fs.exists(ctx, "nothing"));
    assert.eq(time.now(ctx).0, 0);
    assert.none(io.readLine(ctx));
    assert.eq(env.args(ctx), []);
    greet(ctx, "hermetic");
    assert.eq(assert.err(http.get(ctx, "http://example.com")), .Refused);
    assert.isTrue(random.int(ctx, 0, 10) >= 0);
}

test "a context expression binds the effects it names" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("x", "1")]),
    };
    assert.eq(assert.ok(loadText(ctx, "x")), "1");
}

test "a named context declaration is constructed by calling it" {
    let ctx = Fixture();
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=8080");
}

test "a context naming only two effects satisfies a two-effect bound" {
    let ctx = Tiny();
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
}

test "a context is accepted by a bound naming a subset of its effects" {
    // `elapsed` names Clock alone; World names nine effects.
    let ctx = World();
    assert.eq(elapsed(ctx, stamp(ctx)), 0);
}

// -----------------------------------------------------------------------------
// Spreads (SPEC 11.3)
// -----------------------------------------------------------------------------

test "an explicit binding after a spread replaces the inherited one" {
    let ctx = Fixture();
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=8080");
}

test "a spread of a spread replaces the same binding again" {
    let ctx = OtherPort();
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=9999");
}

test "a replacement replaces wholesale rather than merging" {
    // Fixture's Fs has empty.txt; OtherPort's does not.
    let ctx = OtherPort();
    assert.isFalse(fs.exists(ctx, "empty.txt"));
    assert.isTrue(fs.exists(ctx, "config.toml"));
}

test "an inline context expression may start from a named one" {
    let ctx = context {
        ..Fixture(),
        Fs: fs().files([("config.toml", "port=1")]),
    };
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=1");
}

test "an inline context expression may start from another inline one" {
    let base = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "1")]),
    };
    let ctx = context {
        ..base,
        Fs: fs().files([("a", "2")]),
    };
    assert.eq(assert.ok(loadText(ctx, "a")), "2");
}

// -----------------------------------------------------------------------------
// An effect INHERITED through a spread (SPEC 11.3)
//
// A spread carries the *implementing type* its base recorded, so an effect that
// arrives that way dispatches exactly as one written out does. The blocks above
// assert on the binding that follows the spread; these assert on the ones it
// did not write, which is where the compiler used to have nothing to dispatch
// on.
// -----------------------------------------------------------------------------

test "an effect inherited through a spread can be called" {
    // `Fixture` names `Fs` and nothing else; `Clock` is `Defaults`'s.
    let ctx = Fixture();
    assert.eq(stamp(ctx).0, 0);
}

test "every effect a spread supplies can be called, not only the one replaced" {
    let ctx = Fixture();
    assert.eq(time.now(ctx).0, 0);
    assert.none(io.readLine(ctx));
    assert.eq(env.args(ctx), []);
    greet(ctx, "inherited");
    io.eprintln(ctx, "inherited").ignore();
    assert.eq(assert.err(http.get(ctx, "http://example.com")), .Refused);
    assert.isTrue(random.int(ctx, 0, 10) >= 0);
    // ...and the one it did replace, which is the only half that used to work.
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=8080");
}

test "an inherited effect survives a second spread" {
    // Two levels: `OtherPort` spreads `Fixture`, which spreads `Defaults`.
    let ctx = OtherPort();
    assert.eq(stamp(ctx).0, 0);
    assert.isTrue(random.int(ctx, 0, 10) >= 0);
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=9999");
}

test "a binding written after two spreads beats the twice-inherited one" {
    let ctx = DeepFixture();
    // Written here, over the `Clock` two spreads had carried down.
    assert.eq(stamp(ctx).0, 1234);
    // One level up, and two: neither was disturbed by the replacement.
    assert.eq(assert.ok(loadText(ctx, "config.toml")), "port=9999");
    assert.eq(env.args(ctx), []);
}

test "an inherited effect can be called from an inline context expression" {
    let ctx = context {
        ..Defaults(),
        Fs: fs().files([("a", "1")]),
    };
    assert.eq(stamp(ctx).0, 0);
    assert.eq(assert.ok(loadText(ctx, "a")), "1");
    assert.eq(assert.err(http.get(ctx, "http://example.com")), .Refused);
}

test "a spread with nothing written after it inherits every binding" {
    let ctx = context {
        ..Defaults(),
    };
    assert.eq(stamp(ctx).0, 0);
    assert.isFalse(fs.exists(ctx, "nothing"));
    assert.eq(assert.err(http.get(ctx, "http://example.com")), .Refused);
}

test "an inherited binding is the same value, not a fresh one" {
    // The spread reads the implementation out of the base rather than building
    // another, so the capture this test holds is the one the call writes to.
    let sink = stdout();
    let base = context {
        Alloc: alloc(),
        Stdout: sink,
        Clock: clock().at(5),
    };
    let ctx = context {
        ..base,
        Clock: clock().at(9),
    };
    greet(ctx, "through the spread");
    assert.eq(sink.captured(), "hello through the spread\n");
    assert.eq(stamp(ctx).0, 9);
}

test "a spread carries an implementing type's own type arguments with it" {
    // `Guarded<TestFs>`, inherited: the wrapper's `impl<C: Fs> Fs for Guarded<C>`
    // is instantiated from a receiver the spread carried, `TestFs` and all, so
    // what travels is a whole type rather than a constructor.
    let ctx = context {
        ..WrappedFixture(),
        Clock: clock().at(3),
    };
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
    assert.eq(assert.err(saveText(ctx, "a", "B")), IoError.Other("guarded"));
    assert.eq(stamp(ctx).0, 3);
}

// -----------------------------------------------------------------------------
// Each call to a named context builds a FRESH one (SPEC 11.3)
// -----------------------------------------------------------------------------

test "a write through one context is visible to that same context" {
    let ctx = Fixture();
    assert.ok(saveText(ctx, "scratch.txt", "written"));
    assert.eq(assert.ok(loadText(ctx, "scratch.txt")), "written");
}

test "a write through one context is invisible to the next one built" {
    let first = Fixture();
    assert.ok(saveText(first, "scratch.txt", "written"));
    assert.eq(assert.ok(loadText(first, "scratch.txt")), "written");

    // Same declaration, second call: a fresh filesystem, so the write is gone.
    let second = Fixture();
    assert.isFalse(fs.exists(second, "scratch.txt"));
    assert.eq(assert.ok(loadText(second, "config.toml")), "port=8080");
}

test "two contexts from one declaration are two values, not one handle" {
    let a = Fixture();
    let b = Fixture();
    assert.ok(saveText(a, "only-in-a", "1"));
    assert.isTrue(fs.exists(a, "only-in-a"));
    assert.isFalse(fs.exists(b, "only-in-a"));
}

test "an inline context expression is fresh too" {
    let a = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.ok(saveText(a, "f", "1"));
    let b = context {
        Fs: fs().files([]),
    };
    assert.isFalse(fs.exists(b, "f"));
}

test "freshness applies to a captured stream as well" {
    let first = stdout();
    let a = context {
        Stdout: first,
    };
    greet(a, "one");
    let second = stdout();
    // The stream is bound into a context here rather than left loose: what this
    // asserts is that a *reachable* second stream is still empty, and a binding
    // nothing calls is the only way to say so.
    let b = context {
        Stdout: second,
    };
    assert.eq(second.captured(), "");
    assert.eq(first.captured(), "hello one\n");
}

// -----------------------------------------------------------------------------
// fs(), its builders, and readOnly()
// -----------------------------------------------------------------------------

test "files contains exactly the entries it was given" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A"), ("b", "B")]),
    };
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
    assert.eq(assert.ok(loadText(ctx, "b")), "B");
    assert.isTrue(loadText(ctx, "c").isErr());
}

test "reading a path files does not have gives IoError.NotFound" {
    // `core/effect` declares the variant, and an unknown path is what `.NotFound`
    // is for; the match is exhaustive so a fourth answer cannot hide.
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]),
    };
    let which = match (loadText(ctx, "missing")) {
        .Ok(_v) => "ok",
        .Err(.NotFound) => "NotFound",
        .Err(.PermissionDenied) => "PermissionDenied",
        .Err(.ReadOnly) => "ReadOnly",
        .Err(.AlreadyExists) => "AlreadyExists",
        .Err(.NotADirectory) => "NotADirectory",
        .Err(.CrossDevice) => "CrossDevice",
        .Err(.Other(_m)) => "Other",
    };
    assert.eq(which, "NotFound");
}

test "files reports existence" {
    let ctx = context {
        Fs: fs().files([("a", "A")]),
    };
    assert.isTrue(fs.exists(ctx, "a"));
    assert.isFalse(fs.exists(ctx, "b"));
}

test "an empty file is a file, not an absent one" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("e", "")]),
    };
    assert.isTrue(fs.exists(ctx, "e"));
    assert.eq(assert.ok(loadText(ctx, "e")), "");
}

test "a write to files is readable back" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.eq(assert.ok(roundTrip(ctx, "note", "hello")), "hello");
}

test "a write to files replaces the previous body" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "one")]),
    };
    assert.ok(saveText(ctx, "a", "two"));
    assert.eq(assert.ok(loadText(ctx, "a")), "two");
}

test "a fresh filesystem is empty, and nothing seeds it" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs(),
    };
    assert.isTrue(loadText(ctx, "config.toml").isErr());
    assert.isFalse(fs.exists(ctx, "config.toml"));
}

test "reading a path a fresh filesystem does not have gives IoError.NotFound" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs(),
    };
    let which = match (loadText(ctx, "missing")) {
        .Ok(_v) => "ok",
        .Err(.NotFound) => "NotFound",
        .Err(.PermissionDenied) => "PermissionDenied",
        .Err(.ReadOnly) => "ReadOnly",
        .Err(.AlreadyExists) => "AlreadyExists",
        .Err(.NotADirectory) => "NotADirectory",
        .Err(.CrossDevice) => "CrossDevice",
        .Err(.Other(_m)) => "Other",
    };
    assert.eq(which, "NotFound");
}

test "a fresh filesystem is writable within one test" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs(),
    };
    assert.eq(assert.ok(roundTrip(ctx, "scratch", "x")), "x");
}

test "readOnly forwards reads" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]).readOnly(),
    };
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
    assert.isTrue(fs.exists(ctx, "a"));
}

test "a write through readOnly FAILS" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]).readOnly(),
    };
    assert.eq(assert.err(saveText(ctx, "a", "B")), .ReadOnly);
}

test "readOnly refuses a write to a path that does not exist either" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]).readOnly(),
    };
    assert.eq(assert.err(saveText(ctx, "new", "B")), .ReadOnly);
}

test "readOnly leaves the wrapped filesystem untouched" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]).readOnly(),
    };
    assert.eq(assert.err(saveText(ctx, "a", "B")), .ReadOnly);
    assert.eq(assert.ok(loadText(ctx, "a")), "A");
}

test "listDir sees the entries" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]),
    };
    assert.isTrue(assert.ok(fs.listDir(ctx, "")).len() >= 1);
}

// -----------------------------------------------------------------------------
// The binary, appending, renaming half of core/fs (issue #1)
//
// Every block here runs against `TestFs`, and `cli/tests/native/runtime.rs`'s
// `wal` mode runs the same sequence against a real filesystem through
// `buri_rt_host_fs_*`. That the two agree is the point of the fake.
// -----------------------------------------------------------------------------

test "writeBytes and readBytes carry octets a text encoding cannot" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    let raw: [U8] = [0, 1, 254, 255, 128];
    assert.ok(fs.writeBytes(ctx, "blob", raw));
    assert.eq(assert.ok(fs.readBytes(ctx, "blob")), raw);
}

test "readBytes of a path that is not there is NotFound" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.eq(assert.err(fs.readBytes(ctx, "missing")), .NotFound);
}

test "filesBytes is the byte twin of files" {
    let raw: [U8] = [255, 0, 17];
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().filesBytes([("blob", raw)]),
    };
    assert.eq(assert.ok(fs.readBytes(ctx, "blob")), raw);
    assert.isTrue(fs.exists(ctx, "blob"));
}

test "text written as octets reads back as text" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.ok(fs.writeBytes(ctx, "note", bytes.toUtf8(ctx, "héllo")));
    assert.eq(assert.ok(fs.readText(ctx, "note")), "héllo");
}

test "writeBytes replaces the whole file" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "one")]),
    };
    let two: [U8] = [50];
    assert.ok(fs.writeBytes(ctx, "a", two));
    assert.eq(assert.ok(fs.readBytes(ctx, "a")), two);
}

test "append CREATES the file when it is absent" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    let record: [U8] = [1, 2];
    assert.isFalse(fs.exists(ctx, "log"));
    assert.ok(fs.append(ctx, "log", record));
    assert.isTrue(fs.exists(ctx, "log"));
    assert.eq(assert.ok(fs.readBytes(ctx, "log")), record);
}

test "append adds to the end rather than replacing" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.ok(fs.append(ctx, "log", [1, 2]));
    assert.ok(fs.append(ctx, "log", [3]));
    assert.eq(assert.ok(fs.readBytes(ctx, "log")), [1, 2, 3]);
}

test "rename REPLACES the destination" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("new", "N"), ("old", "O")]),
    };
    assert.ok(fs.rename(ctx, "new", "old"));
    assert.eq(assert.ok(fs.readText(ctx, "old")), "N");
}

test "rename leaves nothing at the source" {
    let ctx = context {
        Fs: fs().files([("new", "N")]),
    };
    assert.ok(fs.rename(ctx, "new", "old"));
    assert.isFalse(fs.exists(ctx, "new"));
    assert.isTrue(fs.exists(ctx, "old"));
}

test "rename of a source that is not there is NotFound" {
    let ctx = context {
        Fs: fs().files([]),
    };
    assert.eq(assert.err(fs.rename(ctx, "missing", "other")), .NotFound);
}

test "remove deletes the file" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]),
    };
    assert.ok(fs.remove(ctx, "a"));
    assert.isFalse(fs.exists(ctx, "a"));
    assert.isTrue(fs.readText(ctx, "a").isErr());
}

test "remove OF A MISSING FILE is NotFound, not a silent success" {
    let ctx = context {
        Fs: fs().files([]),
    };
    assert.eq(assert.err(fs.remove(ctx, "never-there")), .NotFound);
}

test "makeDir ON AN EXISTING DIRECTORY is Ok" {
    let ctx = context {
        Fs: fs().files([]),
    };
    assert.ok(fs.makeDir(ctx, "tenants/one"));
    assert.ok(fs.makeDir(ctx, "tenants/one"));
    assert.isTrue(fs.exists(ctx, "tenants/one"));
}

test "makeDir creates the parents too" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.ok(fs.makeDir(ctx, "a/b/c"));
    assert.eq(assert.ok(fs.listDir(ctx, "a")), ["b"]);
    assert.eq(assert.ok(fs.listDir(ctx, "a/b")), ["c"]);
}

test "makeDir where a file already sits is AlreadyExists" {
    let ctx = context {
        Fs: fs().files([("a", "A")]),
    };
    assert.eq(assert.err(fs.makeDir(ctx, "a")), .AlreadyExists);
}

test "sync of a file that is there is Ok" {
    let ctx = context {
        Fs: fs().files([("a", "A")]),
    };
    assert.ok(fs.sync(ctx, "a"));
}

test "sync of a path that is not there is NotFound" {
    let ctx = context {
        Fs: fs().files([]),
    };
    assert.eq(assert.err(fs.sync(ctx, "missing")), .NotFound);
}

test "readOnly forwards readBytes" {
    let raw: [U8] = [7, 8];
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().filesBytes([("blob", raw)]).readOnly(),
    };
    assert.eq(assert.ok(fs.readBytes(ctx, "blob")), raw);
}

test "every writing half of the new surface FAILS through readOnly" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([("a", "A")]).readOnly(),
    };
    assert.eq(assert.err(fs.writeBytes(ctx, "a", [1])), .ReadOnly);
    assert.eq(assert.err(fs.append(ctx, "a", [1])), .ReadOnly);
    assert.eq(assert.err(fs.rename(ctx, "a", "b")), .ReadOnly);
    assert.eq(assert.err(fs.remove(ctx, "a")), .ReadOnly);
    assert.eq(assert.err(fs.makeDir(ctx, "d")), .ReadOnly);
    assert.eq(assert.ok(fs.readText(ctx, "a")), "A");
}

test "sync is not a write, so readOnly forwards it" {
    let ctx = context {
        Fs: fs().files([("a", "A")]).readOnly(),
    };
    assert.ok(fs.sync(ctx, "a"));
}

/// The whole reason the seven exist: a log that is appended to, a commit point
/// that is a call, and a checkpoint that swaps in atomically.
test "a write-ahead log commits through append, sync and rename" {
    let ctx = context {
        Alloc: alloc(),
        Fs: fs().files([]),
    };
    assert.ok(fs.makeDir(ctx, "wal"));

    // Two records, each one append, with the commit point stated after each.
    assert.ok(fs.append(ctx, "wal/log", [1, 10]));
    assert.ok(fs.sync(ctx, "wal/log"));
    assert.ok(fs.append(ctx, "wal/log", [2, 20]));
    assert.ok(fs.sync(ctx, "wal/log"));
    assert.eq(assert.ok(fs.readBytes(ctx, "wal/log")), [1, 10, 2, 20]);

    // Checkpoint: write the temporary, make it durable, swap it in, then make
    // the directory entry durable so the swap survives too.
    assert.ok(fs.writeBytes(ctx, "wal/checkpoint.tmp", [30]));
    assert.ok(fs.sync(ctx, "wal/checkpoint.tmp"));
    assert.ok(fs.rename(ctx, "wal/checkpoint.tmp", "wal/checkpoint"));
    assert.ok(fs.sync(ctx, "wal"));
    assert.isFalse(fs.exists(ctx, "wal/checkpoint.tmp"));
    assert.eq(assert.ok(fs.readBytes(ctx, "wal/checkpoint")), [30]);

    // Truncation after the checkpoint, which is what `remove` is for here.
    assert.ok(fs.remove(ctx, "wal/log"));
    assert.eq(assert.ok(fs.listDir(ctx, "wal")), ["checkpoint"]);
}

// -----------------------------------------------------------------------------
// stdout / stderr
// -----------------------------------------------------------------------------

test "captured reads back what a function printed" {
    let sink = stdout();
    let ctx = context {
        Stdout: sink,
    };
    greet(ctx, "world");
    assert.eq(sink.captured(), "hello world\n");
}

test "a fresh capture is empty" {
    let sink = stdout();
    let ctx = context {
        Stdout: sink,
    };
    assert.eq(sink.captured(), "");
    greet(ctx, "x");
    assert.notEq(sink.captured(), "");
}

test "captured accumulates in the order things were printed" {
    let sink = stdout();
    let ctx = context {
        Stdout: sink,
    };
    shout(ctx, ["a", "b", "c"]);
    assert.eq(sink.captured(), "abc");
}

test "print does not add a newline and println does" {
    let sink = stdout();
    let ctx = context {
        Stdout: sink,
    };
    io.print(ctx, "one").ignore();
    io.println(ctx, "two").ignore();
    io.print(ctx, "three").ignore();
    assert.eq(sink.captured(), "onetwo\nthree");
}

test "two captures in one test are independent" {
    let a = stdout();
    let b = stdout();
    let actx = context {
        Stdout: a,
    };
    let bctx = context {
        Stdout: b,
    };
    greet(actx, "one");
    assert.eq(a.captured(), "hello one\n");
    assert.eq(b.captured(), "");
    greet(bctx, "two");
    assert.eq(a.captured(), "hello one\n");
    assert.eq(b.captured(), "hello two\n");
}

test "captured reads back what went to stderr" {
    let sink = stderr();
    let ctx = context {
        Stderr: sink,
    };
    io.eprintln(ctx, "to stderr").ignore();
    assert.eq(sink.captured(), "to stderr\n");
}

test "stdout and stderr are separate streams" {
    let out = stdout();
    let err = stderr();
    let ctx = context {
        Stdout: out,
        Stderr: err,
    };
    io.print(ctx, "O").ignore();
    io.eprint(ctx, "E").ignore();
    assert.eq(out.captured(), "O");
    assert.eq(err.captured(), "E");
}

test "a captured stream keeps a passing test quiet" {
    let ctx = Defaults();
    greet(ctx, "quiet");
    io.eprintln(ctx, "quiet").ignore();
}

