// The origin map: where each printed node landed, and where it came from.
//
// An anchor is a **byte** range into the printed text, so a name outside ASCII
// moves every offset after it. That is asserted here rather than left to be
// discovered, because the compiler indexes the text with these numbers.

from "core/buri/ast" import * as ast;
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/buri_ast" import { ex, item, itemAt, n, nAt, one, ty };

let FILE: Str = "rows.schema";

fn alias(name: ast.Name, target: ast.Type, exported: Bool): ast.ItemKind {
    .TypeAlias(ast.TypeAliasDecl {
        name: name,
        generics: [],
        ty: target,
        exported: exported,
        docs: [],
    })
}

test "a node with an origin gets an anchor over its own printed text" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = ast.Module {
        items: [itemAt(alias(n("Id"), ty("Int"), true), FILE, 3, 9)],
        docs: [],
    };
    let out = ast.print(ctx, m);
    assert.eq(out.text, "export type Id = Int;\n");
    let a = assert.some(out.anchors.get(0));
    assert.len(out.anchors, 1);
    assert.eq(out.text.slice(a.start, a.end), "export type Id = Int;");
    assert.eq(a.origin, ast.origin(FILE, 3, 9));
}

test "a node whose origin names no file gets none" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = one(alias(n("Id"), ty("Int"), true));
    assert.isEmpty(ast.print(ctx, m).anchors);
}

test "anchors come back sorted, and the outermost first where two start together" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `Option` is the name of the return type and the head of it, so the two
    // nodes are printed from the same offset and only their ends part them.
    let inner = ast.Type { kind: .Named(n("Str"), []), origin: ast.nowhere() };
    let outer = ast.Type {
        kind: .Named(nAt("Option", FILE, 10, 16), [inner]),
        origin: ast.origin(FILE, 10, 20),
    };
    let m = ast.Module {
        items: [itemAt(alias(n("Id"), outer, true), FILE, 0, 20)],
        docs: [],
    };
    let out = ast.print(ctx, m);
    assert.eq(out.text, "export type Id = Option<Str>;\n");
    assert.eq(out.anchors, [
        ast.Anchor { start: 0, end: 29, origin: ast.origin(FILE, 0, 20) },
        ast.Anchor { start: 17, end: 28, origin: ast.origin(FILE, 10, 20) },
        ast.Anchor { start: 17, end: 23, origin: ast.origin(FILE, 10, 16) },
    ]);
    assert.eq(out.text.slice(17, 28), "Option<Str>");
    assert.eq(out.text.slice(17, 23), "Option");
}

test "an anchor counts UTF-8 bytes, not scalar values" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `é` is one scalar value and two bytes, so the second declaration starts
    // one byte further along than a character count would say.
    let first = item(
        .Let(ast.LetDecl {
            name: n("A"),
            ty: ty("Str"),
            value: ex(.Str("é")),
            exported: false,
            docs: [],
        }),
    );
    let second = itemAt(alias(n("B"), ty("Int"), false), FILE, 0, 1);
    let out = ast.print(ctx, ast.Module { items: [first, second], docs: [] });
    assert.eq(out.text, "let A: Str = \"é\";\n\ntype B = Int;\n");
    let a = assert.some(out.anchors.get(0));
    // 17 scalar values on the first line, 18 bytes, and then the two breaks a
    // pair of declarations is parted by.
    assert.eq(out.text.slice(0, 17).len(), 17);
    assert.eq(a.start, 20);
    assert.eq(a.end, 33);
}

test "every node kind that carries an origin records one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let field = ast.FieldDecl {
        name: nAt("x", FILE, 4, 5),
        ty: ty("Int"),
        exported: true,
        docs: [],
        origin: ast.origin(FILE, 2, 8),
    };
    let m = ast.Module {
        items: [
            itemAt(
                .Struct(ast.StructDecl {
                    name: nAt("Point", FILE, 0, 5),
                    generics: [],
                    body: .Record([field]),
                    exported: true,
                    docs: [],
                }),
                FILE,
                0,
                9,
            ),
        ],
        docs: [],
    };
    let out = ast.print(ctx, m);
    assert.eq(out.text, "export struct Point {\n    export x: Int,\n}\n");
    // The declaration, its name, the field, and the field's name.
    assert.len(out.anchors, 4);
    let decl = assert.some(out.anchors.get(0));
    assert.eq(
        out.text.slice(decl.start, decl.end),
        out.text.slice(0, out.text.len() - 1),
    );
    let name = assert.some(out.anchors.get(1));
    assert.eq(out.text.slice(name.start, name.end), "Point");
    let member = assert.some(out.anchors.get(2));
    assert.eq(out.text.slice(member.start, member.end), "export x: Int");
    let inner = assert.some(out.anchors.get(3));
    assert.eq(out.text.slice(inner.start, inner.end), "x");
}
