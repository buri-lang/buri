// `core/buri/ast`'s lexer: every token class the lexical grammar has, and the
// three places it is easy to get wrong — a tuple index that is not a float, a
// template hole that a block's brace does not close, and a span that counts
// bytes where the text counts scalars.

from "core/buri/ast" import * as ast;
from "core/buri/ast" import { Span, Token, TokenKind };
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

fn kinds<C: Allocator>(ctx: C, source: Str): [TokenKind] {
    ast.tokenize(ctx, source).map(ctx, fn(t) => t.kind)
}

fn texts<C: Allocator>(ctx: C, source: Str): [Str] {
    ast.tokenize(ctx, source).map(ctx, fn(t) => t.text)
}

// --- the basics ------------------------------------------------------------------

test "a declaration is its keyword, its name and its punctuation" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "let x = 1;"), ["let", "x", "=", "1", ";"]);
    assert.equal(kinds(ctx, "let x = 1;"), [
        TokenKind.Keyword,
        TokenKind.Identifier,
        TokenKind.Punctuation,
        TokenKind.Int,
        TokenKind.Punctuation,
    ]);
}

test "nothing comes of nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isEmpty(ast.tokenize(ctx, ""));
    assert.isEmpty(ast.tokenize(ctx, "   \n\t\r "));
}

// --- spans -----------------------------------------------------------------------

test "a span is the byte range the token covers" {
    let ctx = context {
        Allocator: alloc(),
    };
    let tokens = ast.tokenize(ctx, "let x = 1;");
    assert.equal(assert.some(tokens.get(0)).span, Span { start: 0, end: 3 });
    assert.equal(assert.some(tokens.get(1)).span, Span { start: 4, end: 5 });
    assert.equal(assert.some(tokens.get(4)).span, Span { start: 9, end: 10 });
}

test "a span counts bytes where the text counts scalars" {
    let ctx = context {
        Allocator: alloc(),
    };
    let tokens = ast.tokenize(ctx, "\"😀\" x");
    assert.equal(assert.some(tokens.get(0)).span, Span { start: 0, end: 6 });
    assert.equal(assert.some(tokens.get(0)).text.length(), 3);
    assert.equal(assert.some(tokens.get(1)).span, Span { start: 7, end: 8 });
    assert.equal(assert.some(tokens.get(1)).text, "x");
}

test "every span is non-empty and they run in order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let source = "export fn f<T: Equal>(self, ctx: C): [T] { \"a\${1}b\" }";
    let tokens = ast.tokenize(ctx, source);
    assert.greaterThan(tokens.length(), 15);
    assert.isTrue(tokens.all(fn(t) => t.span.end > t.span.start));
    assert.isTrue(tokens.windows(ctx, 2).all(fn(pair) => inOrder(pair)));
}

fn inOrder(pair: [Token]): Bool {
    match ((pair.get(0), pair.get(1))) {
        (.Some(a), .Some(b)) => a.span.end <= b.span.start,
        _ => true,
    }
}

// --- comments -----------------------------------------------------------------------

test "the marker decides which comment a comment is" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "//! module\n/// doc\n// plain\n//// plain\n/* block */"), [
        TokenKind.ModuleDoc,
        TokenKind.DocComment,
        TokenKind.LineComment,
        TokenKind.LineComment,
        TokenKind.BlockComment,
    ]);
}

test "block comments nest" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "/* a /* b */ c */x"), ["/* a /* b */ c */", "x"]);
}

// --- numbers -------------------------------------------------------------------------

test "an integer is decimal or one of three radices, underscores and all" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "0 1_000 0xff 0o17 0b1010"), [
        "0",
        "1_000",
        "0xff",
        "0o17",
        "0b1010",
    ]);
    assert.equal(kinds(ctx, "0 0xff"), [TokenKind.Int, TokenKind.Int]);
}

test "a float carries a point or an exponent" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "1 1.5 1e5 1.5e-3 1E+2"), [
        TokenKind.Int,
        TokenKind.Float,
        TokenKind.Float,
        TokenKind.Float,
        TokenKind.Float,
    ]);
}

test "a tuple index is a dot and an integer, never a float" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "pair.0"), ["pair", ".", "0"]);
    assert.equal(kinds(ctx, "pair.0"), [
        TokenKind.Identifier,
        TokenKind.Punctuation,
        TokenKind.Int,
    ]);
    // The documented wart: `t.0.1` lexes as `t` `.` `0.1`.
    assert.equal(texts(ctx, "t.0.1"), ["t", ".", "0.1"]);
}

// --- text ------------------------------------------------------------------------------

test "a string keeps its quotes and its escapes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "\"hi\" 'a' '\\n'"), ["\"hi\"", "'a'", "'\\n'"]);
    assert.equal(texts(ctx, "\"a\\\"b\""), ["\"a\\\"b\""]);
    assert.equal(texts(ctx, "'\\''"), ["'\\''"]);
    assert.equal(texts(ctx, "'\\u{1F600}'"), ["'\\u{1F600}'"]);
}

test "a template is a head, its holes and a tail" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "\"a\${x}b\${y}c\""), [
        TokenKind.TemplateHead,
        TokenKind.Identifier,
        TokenKind.TemplateSpan,
        TokenKind.Identifier,
        TokenKind.TemplateTail,
    ]);
    assert.equal(texts(ctx, "\"a\${x}b\""), ["\"a\${", "x", "}b\""]);
}

test "a brace inside a hole closes its block and not the template" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "\"\${ { } }\""), [
        TokenKind.TemplateHead,
        TokenKind.Punctuation,
        TokenKind.Punctuation,
        TokenKind.TemplateTail,
    ]);
    assert.equal(texts(ctx, "\"\${ { } }\""), ["\"\${", "{", "}", "}\""]);
}

test "a template nested in a template keeps its own holes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "\"a\${\"b\${c}d\"}e\""), [
        TokenKind.TemplateHead,
        TokenKind.TemplateHead,
        TokenKind.Identifier,
        TokenKind.TemplateTail,
        TokenKind.TemplateTail,
    ]);
}

// --- punctuation ---------------------------------------------------------------------------

test "longest match, and the pairs the grammar deliberately leaves out" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, ":: .. => == != <= >= && || = . : < > & |"), [
        "::",
        "..",
        "=>",
        "==",
        "!=",
        "<=",
        ">=",
        "&&",
        "||",
        "=",
        ".",
        ":",
        "<",
        ">",
        "&",
        "|",
    ]);
    // No `>>`, so a nested generic never mis-lexes; no `?.`, so `x?.f` is three.
    assert.equal(texts(ctx, "Map<Str, [Int]>>"), [
        "Map",
        "<",
        "Str",
        ",",
        "[",
        "Int",
        "]",
        ">",
        ">",
    ]);
    assert.equal(texts(ctx, "x?.f"), ["x", "?", ".", "f"]);
}

test "an underscore is punctuation and a word that starts with one is a name" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "_ _x"), [TokenKind.Punctuation, TokenKind.Identifier]);
}

// --- what is neither a name nor a keyword ---------------------------------------------------

test "a reserved word is Unknown, and a word that merely starts with one is not" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "await"), [TokenKind.Unknown]);
    assert.equal(kinds(ctx, "awaits"), [TokenKind.Identifier]);
    assert.equal(kinds(ctx, "while"), [TokenKind.Unknown]);
}

test "every keyword of the lexical grammar lexes as one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let all = "as const context ctx derive effect else enum export false fn for ".concat(
        ctx,
        "from if impl import let match self Self struct test trait true type",
    );
    let tokens = ast.tokenize(ctx, all);
    assert.equal(tokens.length(), 25);
    assert.isTrue(tokens.all(fn(t) => t.kind == TokenKind.Keyword));
}

test "a character no production names is Unknown" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "#"), [TokenKind.Unknown]);
    assert.equal(kinds(ctx, "$"), [TokenKind.Unknown]);
}

// --- what does not end ------------------------------------------------------------------------

test "an unterminated string or comment runs to the end of the source" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "\"abc"), ["\"abc"]);
    assert.equal(texts(ctx, "/* abc"), ["/* abc"]);
    assert.equal(texts(ctx, "\"a\${b"), ["\"a\${", "b"]);
}

// --- every class the enum has -----------------------------------------------------

test "one source produces every kind of token there is" {
    let ctx = context {
        Allocator: alloc(),
    };
    let source =
        "//! m\n/// d\n// l\n/* b */\nlet x = 1 1.5 \"s\" 'c' \"a\${x}b\${x}c\" #";
    assert.equal(kinds(ctx, source), [
        TokenKind.ModuleDoc,
        TokenKind.DocComment,
        TokenKind.LineComment,
        TokenKind.BlockComment,
        TokenKind.Keyword,
        TokenKind.Identifier,
        TokenKind.Punctuation,
        TokenKind.Int,
        TokenKind.Float,
        TokenKind.Str,
        TokenKind.Char,
        TokenKind.TemplateHead,
        TokenKind.Identifier,
        TokenKind.TemplateSpan,
        TokenKind.Identifier,
        TokenKind.TemplateTail,
        TokenKind.Unknown,
    ]);
}

// --- a file that is nothing but comments -------------------------------------------

test "a file of only comments is its comments" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "// one\n// two\n"), [
        TokenKind.LineComment,
        TokenKind.LineComment,
    ]);
    assert.equal(texts(ctx, "// one\n// two\n"), ["// one", "// two"]);
    assert.equal(kinds(ctx, "//! only a module doc"), [TokenKind.ModuleDoc]);
    assert.equal(kinds(ctx, "/* a */ /* b */"), [
        TokenKind.BlockComment,
        TokenKind.BlockComment,
    ]);
    // A comment runs to the end of its line and no further.
    assert.equal(texts(ctx, "// one\nx"), ["// one", "x"]);
}

test "a comment on the last line with no newline after it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "// one"), [TokenKind.LineComment]);
    assert.equal(kinds(ctx, "/// one"), [TokenKind.DocComment]);
}

// --- what does not end, once more ----------------------------------------------------

test "a character literal that never closes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(kinds(ctx, "'a"), [TokenKind.Char]);
    assert.equal(texts(ctx, "'a"), ["'a"]);
    assert.equal(texts(ctx, "'"), ["'"]);
    assert.equal(texts(ctx, "'\\"), ["'\\"]);
}

test "a block comment that never closes takes the nesting with it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "/* a /* b */"), ["/* a /* b */"]);
    assert.equal(kinds(ctx, "/*"), [TokenKind.BlockComment]);
}

test "a string whose last character is an escape" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(texts(ctx, "\"a\\"), ["\"a\\"]);
}

test "an unterminated token still carries a span inside the source" {
    let ctx = context {
        Allocator: alloc(),
    };
    let tokens = ast.tokenize(ctx, "x \"abc");
    assert.equal(tokens.length(), 2);
    assert.equal(assert.some(tokens.get(1)).span, Span { start: 2, end: 6 });
}
