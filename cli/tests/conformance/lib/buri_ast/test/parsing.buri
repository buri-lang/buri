// `core/buri/ast`'s parser, asked the only question that means anything about
// one: does the text come back as the same program?
//
// Every case below is written the way `print` writes it, so `print(parse(s))`
// is `s` exactly. The corpus-sized version of the same claim is
// `language::round_trip`, which rewrites the whole conformance repository and
// then runs it.

from "core/buri/ast" import * as ast;
from "core/list" import * as list;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

fn roundTrip<C: Allocator>(ctx: C, source: Str): Str {
    match (ast.parse(ctx, "probe.buri", source)) {
        .Ok(m) => ast.print(ctx, m).text,
        .Err(errors) => errors.map(ctx, fn(e) => e.message).join(ctx, "; "),
    }
}

fn same<C: Allocator>(ctx: C, source: Str): () {
    assert.equal(roundTrip(ctx, source), source)
}

test "declarations" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "export type Id = Int;\n");
    same(ctx, "type Pair = (Int, Str);\n");
    same(ctx, "type Fn = fn(Int, Str) => Bool;\n");
    same(ctx, "type Nested = Map<Str, [Option<Int>]>;\n");
    same(ctx, "let LIMIT: Int = 32;\n");
    same(ctx, "export let NAME: Str = \"buri\";\n");
}

test "imports" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "from \"core/list\" import * as list;\n");
    same(ctx, "from \"platform/effect\" import { Allocator };\n");
    same(ctx, "from \"core/order\" import { Equal, Ordered };\n");
    same(ctx, "from \"core/order\" import { Equal as Equal };\n");
    same(ctx, "from \"//lib/money\" export { Cents };\n");
}

test "functions" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "export fn f(): Int {\n    1\n}\n");
    same(ctx, "fn g(a: Int, b: Str): Bool {\n    true\n}\n");
    same(
        ctx,
        "fn h<T: Equal + Ordered, C: Allocator>(ctx: C, item: T): T {\n    item\n}\n",
    );
    same(ctx, "fn nothing(): () {\n    ()\n}\n");
}

test "structs and enums" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "export struct Point {\n    export x: Int,\n    y: Int,\n}\n");
    same(ctx, "struct Meters(export Float);\n");
    same(ctx, "struct Pair(Int, Str);\n");
    same(
        ctx,
        "export enum Shape {\n    Dot,\n    Line(Point, Point),\n    Box { w: Int, h: Int },\n}\n",
    );
}

test "traits, effects and impls" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(
        ctx,
        "export trait Show {\n    fn show<C: Allocator>(self, ctx: C): Str;\n}\n",
    );
    same(ctx, "export effect Clock {\n    fn now(self): Int;\n}\n");
    same(ctx, "impl Point {\n    export fn area(self): Int {\n        1\n    }\n}\n");
    same(ctx, "impl<T> [T] {\n    fn head(self): Int {\n        0\n    }\n}\n");
    // The trait comes first and the type second, which is the language's order
    // and the opposite of the one the grammar's labels read as.
    same(
        ctx,
        "impl Show for Point {\n    fn show(self): Str {\n        \"p\"\n    }\n}\n",
    );
    same(ctx, "derive Equal, Show for Point;\n");
}

test "tests and contexts" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "test \"it holds\" {\n    ()\n}\n");
    same(ctx, "context Fixture {\n    Allocator: alloc(),\n}\n");
    same(ctx, "export context Fixture {\n    Allocator: alloc(),\n}\n");
}

test "expressions" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "fn f(): Int {\n    1 + 2 * 3\n}\n");
    same(ctx, "fn f(): Int {\n    (1 + 2) * 3\n}\n");
    same(ctx, "fn f(): Bool {\n    a == b && c != d\n}\n");
    same(ctx, "fn f(): Int {\n    -x\n}\n");
    same(ctx, "fn f(): Int {\n    xs.length()\n}\n");
    same(ctx, "fn f(): Int {\n    pair.0\n}\n");
    same(ctx, "fn f(): Int {\n    xs[0]\n}\n");
    same(ctx, "fn f(): Int {\n    g()?\n}\n");
    same(ctx, "fn f(): [Int] {\n    list.empty<Int>()\n}\n");
    same(ctx, "fn f(): Point {\n    Point { x: 1, y: 2 }\n}\n");
    same(ctx, "fn f(): Point {\n    Point { ..base, x: 1 }\n}\n");
    same(ctx, "fn f(): Int {\n    { x: 1 }\n}\n");
    // A `..` or a name and a `:` after the `{` make a struct; anything else, a
    // block.
    same(ctx, "fn f(): Int {\n    { ..base, x: 1 }\n}\n");
    same(ctx, "fn f(): Int {\n    { x }\n}\n");
    same(ctx, "fn f(): Int {\n    { 1 }\n}\n");
    same(ctx, "fn f(): [Int] {\n    [1, 2, 3]\n}\n");
    same(ctx, "fn f(): (Int, Str) {\n    (1, \"a\")\n}\n");
    same(ctx, "fn f(): Str {\n    \"a\${x}b\"\n}\n");
    same(ctx, "fn f(): Char {\n    'x'\n}\n");
    same(ctx, "fn f(): Float {\n    1.5\n}\n");
    same(ctx, "fn f(): Int {\n    self.x\n}\n");
    same(ctx, "fn f(): Option<Int> {\n    .None\n}\n");
}

test "blocks, ifs and matches" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "fn f(): Int {\n    let a = 1;\n    a\n}\n");
    same(ctx, "fn f(): Int {\n    let a: Int = 1;\n    a\n}\n");
    same(ctx, "fn f(): Int {\n    let (a, b) = pair;\n    a\n}\n");
    same(ctx, "fn f(): Int {\n    if (a) { 1 } else { 2 }\n}\n");
    same(ctx, "fn f(): Int {\n    if (a) { 1 } else if (b) { 2 } else { 3 }\n}\n");
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        .Some(v) => v,\n        .None => 0,\n    }\n}\n",
    );
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        n if n > 0 => n,\n        _other => 0,\n    }\n}\n",
    );
}

test "lambdas and contexts" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "fn f(): Int {\n    g(fn(x) => x)\n}\n");
    same(ctx, "fn f(): Int {\n    g(fn(x: Int): Int => x)\n}\n");
    same(
        ctx,
        "fn f(): Int {\n    let ctx = context {\n        Allocator: alloc(),\n    };\n    1\n}\n",
    );
}

test "patterns" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        Option.None => 0,\n        _other => 1,\n    }\n}\n",
    );
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        Point { x, .. } => x,\n    }\n}\n",
    );
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        [a, b] => a,\n        [..rest] => 0,\n    }\n}\n",
    );
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        1 | 2 => 0,\n        -3 => 1,\n        _other => 2,\n    }\n}\n",
    );
    same(
        ctx,
        "fn f(): Int {\n    match (x) {\n        whole @ Point { x } => x,\n    }\n}\n",
    );
    same(ctx, "fn f(): Int {\n    match (x) {\n        () => 0,\n    }\n}\n");
    same(ctx, "fn f(): Int {\n    match (x) {\n        (a, b) => a,\n    }\n}\n");
}

test "doc comments come back" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(ctx, "/// A row's key.\nexport type Id = Int;\n");
    same(ctx, "//! The module.\n\ntype Id = Int;\n");
}

test "a module of several declarations" {
    let ctx = context {
        Allocator: alloc(),
    };
    same(
        ctx,
        "from \"core/list\" import * as list;\n\nderive Equal, Show for Point;\nexport struct Point {\n    export x: Int,\n}\n\nexport fn area(p: Point): Int {\n    p.x * p.x\n}\n",
    );
}

test "a source that does not parse says where" {
    let ctx = context {
        Allocator: alloc(),
    };
    match (ast.parse(ctx, "probe.buri", "export type = Int;\n")) {
        .Ok(_m) => assert.isTrue(false),
        .Err(errors) => {
            assert.equal(errors.length(), 1);
            assert.equal(
                assert.some(errors.first()).message,
                "expected an identifier, found `=`",
            );
        },
    }
}

// --- what the digits keep ---------------------------------------------------------

test "a literal comes back spelled the way it was written" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Plain decimal that fits is a number; everything else keeps its text.
    same(ctx, "let SMALL: Int = 32;\n");
    same(ctx, "let HEX: U8 = 0xff;\n");
    same(ctx, "let GROUPED: Int = 1_000;\n");
    same(ctx, "let WIDE: U64 = 18446744073709551615;\n");
    same(ctx, "let LOW: I64 = -9223372036854775808;\n");
}

// --- where a node came from ---------------------------------------------------------

test "every node knows the file and the bytes it came from" {
    let ctx = context {
        Allocator: alloc(),
    };
    let tree = assert.ok(ast.parse(ctx, "rows.buri", "type Id = Int;\n"));
    let item = assert.some(tree.items.first());
    assert.equal(item.origin.file, "rows.buri");
    assert.equal(item.origin.span, ast.Span { start: 0, end: 14 });
}

test "a printed module anchors the nodes it read" {
    let ctx = context {
        Allocator: alloc(),
    };
    let tree = assert.ok(ast.parse(ctx, "rows.buri", "type Id = Int;\n"));
    let printed = ast.print(ctx, tree);
    assert.equal(printed.text, "type Id = Int;\n");
    assert.greaterThan(printed.anchors.length(), 0);
}

// --- what it refuses ------------------------------------------------------------------

test "a mistake names what was wanted and what was there" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(errorsOf(ctx, "export type = Int;\n"), [
        "expected an identifier, found `=`",
    ]);
    assert.equal(errorsOf(ctx, "let x: Int = 1\n"), [
        "a `let` declaration ends with `;`",
    ]);
    assert.equal(errorsOf(ctx, "2\n"), ["expected a declaration, found `2`"]);
}

test "every declaration that failed is reported, not only the first" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(errorsOf(ctx, "type = Int;\ntype Ok = Int;\nenum = {}\n"), [
        "expected an identifier, found `=`",
        "expected an identifier, found `=`",
    ]);
}

test "a unicode escape that names no scalar value is refused, in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(errorsOf(ctx, "let C: Char = '\\u{D800}';\n"), [
        "`\\u{D800}` is not a Unicode scalar value",
    ]);
    assert.equal(errorsOf(ctx, "let C: Char = '\\u{dfff}';\n"), [
        "`\\u{dfff}` is not a Unicode scalar value",
    ]);
    assert.equal(errorsOf(ctx, "let S: Str = \"a\\u{110000}b\";\n"), [
        "`\\u{110000}` is not a Unicode scalar value",
    ]);
    // Too many digits for any scalar, even where the low bits would name one.
    assert.equal(errorsOf(ctx, "let S: Str = \"\\u{100000041}\";\n"), [
        "`\\u{100000041}` is not a Unicode scalar value",
    ]);
    assert.equal(errorsOf(ctx, "let S: Str = \"\\u{}\";\n"), [
        "`\\u{}` is not a Unicode scalar value",
    ]);
    // In a pattern, a template and an import path too, and each one is reported.
    assert.equal(
        errorsOf(
            ctx,
            "fn f(c: Char): Str {\n    match (c) {\n        '\\u{D800}' => \"x\${c}\\u{DFFF}\",\n        _ => \"\",\n    }\n}\n",
        ),
        [
            "`\\u{D800}` is not a Unicode scalar value",
            "`\\u{DFFF}` is not a Unicode scalar value",
        ],
    );
    assert.equal(errorsOf(ctx, "from \"\\u{D800}\" import * as x;\n"), [
        "`\\u{D800}` is not a Unicode scalar value",
    ]);
    // The edges of the valid range, and an escaped backslash, still read.
    same(ctx, "let C: Char = '\\u{d7ff}';\n");
    same(ctx, "let S: Str = \"\\u{e000}\\u{10ffff}\\\\u{D800}\";\n");
}

test "an unknown escape is refused, in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(errorsOf(ctx, "let S: Str = \"a\\qb\";\n"), ["unknown escape `\\q`"]);
    assert.equal(errorsOf(ctx, "let C: Char = '\\a';\n"), ["unknown escape `\\a`"]);
    assert.equal(errorsOf(ctx, "fn f(c: Char): Str {\n    \"\\x\${c}\\y\"\n}\n"), [
        "unknown escape `\\x`",
        "unknown escape `\\y`",
    ]);
    // Every escape the compiler knows still reads.
    assert.equal(errorsOf(ctx, "let S: Str = \"\\n\\r\\t\\0\\\\\\\"\\'\\$\";\n"), []);
}

test "a unicode escape with no brace is refused, in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(errorsOf(ctx, "let S: Str = \"\\u0041\";\n"), [
        "`\\u` must be followed by `{`, as in `\\u{1F600}`",
    ]);
    assert.equal(errorsOf(ctx, "let C: Char = '\\u';\n"), [
        "`\\u` must be followed by `{`, as in `\\u{1F600}`",
    ]);
}

test "a unicode escape whose brace never closes is refused, in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(errorsOf(ctx, "let S: Str = \"\\u{41\";\n"), [
        "unterminated `\\u{...}` escape",
    ]);
    // The digits stop at the first character that is not one.
    assert.equal(errorsOf(ctx, "let S: Str = \"\\u{4G}\";\n"), [
        "unterminated `\\u{...}` escape",
    ]);
    // A character literal still closes at its quote.
    assert.equal(errorsOf(ctx, "let C: Char = '\\u{41';\nlet D: Int = 1;\n"), [
        "unterminated `\\u{...}` escape",
    ]);
    assert.equal(errorsOf(ctx, "fn f(c: Char): Str {\n    \"\\u{41\${c}\"\n}\n"), [
        "unterminated `\\u{...}` escape",
    ]);
}

test "an escape's error carries the escape's own span" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "let C: Char = '\\u{D800}';\n",
        "let S: Str = \"ab\\q\";\n",
        "let S: Str = \"é\\u{41\";\n",
        "let S: Str = \"😀\\u0041\";\n",
    ];
    assert.equal(
        sources.mapCtx(ctx, fn(c, source) => {
            match (ast.parse(c, "probe.buri", source)) {
                .Ok(_tree) => [],
                .Err(errors) => errors.map(c, fn(e) => e.span),
            }
        }),
        [
            [ast.Span { start: 15, end: 23 }],
            [ast.Span { start: 16, end: 18 }],
            [ast.Span { start: 16, end: 21 }],
            [ast.Span { start: 18, end: 20 }],
        ],
    );
}

test "an error carries the span of the token it is about" {
    let ctx = context {
        Allocator: alloc(),
    };
    match (ast.parse(ctx, "probe.buri", "type = Int;\n")) {
        .Ok(_tree) => assert.isTrue(false),
        .Err(errors) => {
            assert.equal(assert.some(errors.first()).span, ast.Span {
                start: 5,
                end: 6,
            });
        },
    }
}

fn errorsOf<C: Allocator>(ctx: C, source: Str): [Str] {
    match (ast.parse(ctx, "probe.buri", source)) {
        .Ok(_tree) => [],
        .Err(errors) => errors.map(ctx, fn(e) => e.message),
    }
}

// --- recovery, in the compiler's words and spans ---------------------------------------
//
// Each expectation is what `buri build` reports for the same source.

fn spannedOf<C: Allocator>(ctx: C, source: Str): [Str] {
    match (ast.parse(ctx, "probe.buri", source)) {
        .Ok(_tree) => [],
        .Err(errors) => {
            errors.map(ctx, fn(e) => "${e.span.start}..${e.span.end} ${e.message}")
        },
    }
}

test "a missing comma or semicolon is said where it belongs, and the walk reads on" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "fn f(): [Int] {\n    let a = [1 2];\n    let b = a\n    a\n}\n\nfn g(): Int {\n    h(1 2)\n}\n",
        ),
        [
            "30..30 an array element ends with `,`",
            "48..48 a statement ends with `;`",
            "79..79 a call argument ends with `,`",
        ],
    );
}

test "an unclosed delimiter names what never closed, and the declarations after it are read" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "fn f(): Int {\n    g(1\n}\n\nstruct S { x: Int\n\nfn h(): Int {\n    [1, 2\n}\n",
        ),
        [
            "22..23 this call is missing its closing `)`",
            "44..46 this `struct` body is missing its closing `}`",
            "68..69 this array is missing its closing `]`",
        ],
    );
}

test "a delimiter still open at the end of the file is said once, at the end" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(spannedOf(ctx, "fn f(): Int {\n    match (x) {\n        _ => 1,\n"), [
        "46..46 this `match` is missing its closing `}`",
    ]);
}

test "a string that never closes is the only thing said about the rest of its line" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(spannedOf(ctx, "fn f(): Str {\n    let s = \"abc;\n}\n"), [
        "31..32 unterminated string literal",
    ]);
}

test "a token written one place too soon is said once and read where it belongs" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "\"core/list\" from import * as list;\nfn export one(): Int {\n    total let = 1;\n    { Point x: 1 }\n}\n",
        ),
        [
            "0..11 expected `from`, found a string literal",
            "38..44 expected an identifier, found `export`",
            "62..67 expected `let`, found `total`",
            "81..82 expected a struct literal's type, found `{`",
        ],
    );
}

test "a binding, an assignment, a block's postfix and a tuple index are refused in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "const N: Int = 1;\nfn f(): Int {\n    x = 2;\n    { 1 }.y;\n    t.99999999999;\n    t.0.1\n}\n",
        ),
        [
            "0..5 there is no `const` declaration; a module-level binding is written with `let`",
            "38..39 there is no assignment; a binding is given its value once, where it is declared",
            "52..53 a block is an operand, not the head of a `.`",
            "62..73 `99999999999` is not a tuple index",
            "81..84 `.0.1` lexes as a float, not two tuple indices",
        ],
    );
}

test "a double colon, a turbofish and a lone if are refused in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "fn f(): Int {\n    let a = b::c;\n    let d = e::<Int>();\n    if (x) { 1 }\n}\n",
        ),
        [
            "27..29 `::` is not an operator",
            "45..47 type arguments in an expression are written without `::`",
            "67..72 `if` requires an `else` branch",
        ],
    );
}

test "a misplaced self, a variant's export and an empty derive are refused in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "fn f(a: Int, self): Int {\n    1\n}\n\nfn g(self: Int): Int {\n    1\n}\n\nenum E { export A }\n\nderive for X;\n",
        ),
        [
            "13..17 `self` may appear only as a function's first parameter",
            "44..49 `self` is written without a type",
            "76..82 a variant carries no `export` of its own; an exported enum exports every one of its variants",
            "95..98 a `derive` clause names no traits",
        ],
    );
}

test "a rest pattern, a one-element tuple and an unnamed or leading-export import are refused in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        spannedOf(
            ctx,
            "fn f(): Int {\n    match (x) {\n        [..a, b] => 1,\n    };\n    (1,)\n}\n\nfrom \"a\" import *;\nexport from \"a\" export { b };\n",
        ),
        [
            "44..45 a rest pattern must come last",
            "64..68 a tuple has two elements or more",
            "88..89 a namespace import must be named",
            "98..102 write `from \"...\" export { ... }`, without a leading `export`",
        ],
    );
}

test "a comparison chain is refused once, however long it is" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(spannedOf(ctx, "fn f(): Int {\n    a < b < c\n}\n"), [
        "24..25 comparison operators are non-associative",
    ]);
}

test "the end of the file is named as such, at the file's end" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(spannedOf(ctx, "fn f(): Int {\n    let x =\n"), [
        "26..26 expected an expression, found end of file",
    ]);
}

test "nesting deeper than the compiler reads is refused where it gives up" {
    let ctx = context {
        Allocator: alloc(),
    };
    let grouped = "let X: Int = "
        .concat(ctx, "(".repeat(ctx, 300))
        .concat(ctx, "1")
        .concat(ctx, ")".repeat(ctx, 300))
        .concat(ctx, ";\n");
    let negated = "let X: Int = ".concat(ctx, "-".repeat(ctx, 300)).concat(ctx, "1;\n");
    assert.equal(spannedOf(ctx, grouped), ["141..142 expression nests too deeply"]);
    assert.equal(spannedOf(ctx, negated), ["268..269 expression nests too deeply"]);
}

test "a list reads on past a missing comma, and ends at what cannot start an element" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "struct S { a: Int b: Int }\n",
        "struct S { a: Int export b: Int }\n",
        "struct S { a: Int 1 }\n",
        "fn g(a: Int b: Int): Int {\n    a\n}\n",
        "fn g(a: Int self): Int {\n    a\n}\n",
        "fn g(a: Int 1): Int {\n    a\n}\n",
        "struct S(Int Str);\n",
        "struct S(Int export Str);\n",
        "struct S(Int 1);\n",
        "fn f(): Int {\n    match (x) {\n        1 => 2 y => 3,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A() => 1,\n        A(x, y) => 2,\n        A(x y) => 3,\n    }\n}\n",
        "fn f(): Int {\n    g(\"abc\n    x)\n}\n",
        "fn f(): Int {\n    g(1 = 2)\n}\n",
        "fn f(): Int {\n    g(1 = (2))\n}\n",
        "fn f(): Int {\n    g(1 = export)\n}\n",
        "fn f(): Int {\n    g(\"abc\n\n}\n",
        "enum E { A { export x: Int } }\n",
        "enum E { 1, B }\n",
        "enum E { 1\n",
        "enum E { , B }\n",
        "type T = (Int,);\n",
    ];
    assert.equal(sources.mapCtx(ctx, fn(c, s) => spannedOf(c, s).join(c, "; ")), [
        "17..17 a record field ends with `,`",
        "17..17 a record field ends with `,`",
        "18..19 this `struct` body is missing its closing `}`",
        "11..11 a function parameter ends with `,`",
        "11..11 a function parameter ends with `,`; 12..16 `self` may appear only as a function's first parameter",
        "12..13 this parameter list is missing its closing `)`",
        "12..12 a tuple-struct field ends with `,`",
        "12..12 a tuple-struct field ends with `,`",
        "13..14 this tuple-struct field list is missing its closing `)`",
        "44..44 a match arm ends with `,`",
        "81..81 a variant-pattern field ends with `,`",
        "24..25 unterminated string literal",
        "22..23 this call is missing its closing `)`",
        "22..23 this call is missing its closing `)`",
        "22..23 this call is missing its closing `)`; 24..30 expected an expression, found `export`; 30..31 expected a declaration, found `)`",
        "24..25 unterminated string literal",
        "13..19 a variant carries no `export` of its own; an exported enum exports every one of its variants",
        "9..10 expected an identifier, found `1`",
        "9..10 expected an identifier, found `1`",
        "9..10 expected an identifier, found `,`; 10..10 an enum variant ends with `,`",
        "9..15 a tuple type has two elements or more",
    ]);
}

test "a statement missing its semicolon, or one that cannot end, is said in the compiler's words" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "let X: Int = 1 ) ;\n",
        "fn f(): Int {\n    x = 2\n}\n",
        "fn f(): Int {\n    a\n    let b = 1;\n    b\n}\n",
        "fn f(): Int {\n    a\n    b\n}\n",
        "fn f(): Int {\n    a => b;\n    c\n}\n",
        "fn f(): Int {\n    a => b\n}\n",
        "fn f(): Int {\n    a => b\n}\nstruct S {\n}\n",
        "fn f(): Int {\n    a => (b);\n    c\n}\n",
        "fn f(): Int {\n    a => (b) }\n}\n",
        "fn f(): Int {\n    match (x) { _ => 1 } a\n}\n",
        "fn f(): Int {\n    if (x) { 1 } else { 2 } a\n}\n",
        "fn f(): Int {\n    { 1 } a\n}\n",
        "fn f(): Int {\n    context { A: a } a\n}\n",
        "fn f(): Int {\n    a b\n}\n",
        "fn f(): Int {\n    if (x) { 1 } else { 2 }.y;\n    c\n}\n",
        "fn f(): Int {\n    match (x) { _ => 1 }.y;\n    c\n}\n",
        "fn f(): Int {\n    context { A: a }.y;\n    c\n}\n",
        "fn f(): Int {\n    { 1 }?;\n    c\n}\n",
        "fn f(): Int {\n    { 1 }.y\n}\n",
        "fn f(): Int {\n    let @x = 1;\n    x\n}\n",
        "fn f(): Int {\n    let @ctx = c;\n    1\n}\n",
        "fn f(): Int {\n    let @ = 1;\n    1\n}\n",
        "fn f(): Int {\n    ctx let = c;\n    1\n}\n",
        "fn f(): Int {\n    x let y = 1;\n    1\n}\n",
        "fn f(): Int {\n    let x: = 1;\n    x\n}\n",
        "fn f(): Int {\n    let = 1;\n    1\n}\n",
        "fn f(): Int {\n    let a = 1 + * (b; c);\n    a\n}\n",
        "fn f(): Int {\n    struct S {}\n}\n",
        "fn f(): Int {\n    if (x) { 1 } y else { 2 }\n}\n",
        "fn f(): Int {\n    if (x) { 1\n}\n",
    ];
    assert.equal(sources.mapCtx(ctx, fn(c, s) => spannedOf(c, s).join(c, "; ")), [
        "15..16 expected `;`, found `)`",
        "20..21 there is no assignment; a binding is given its value once, where it is declared",
        "19..19 a statement ends with `;`",
        "19..19 a statement ends with `;`",
        "20..22 expected `;`, found `=>`",
        "20..22 this function body is missing its closing `}`",
        "20..22 this function body is missing its closing `}`",
        "20..22 expected `;`, found `=>`",
        "20..22 this function body is missing its closing `}`; 29..30 expected a declaration, found `}`",
        "38..38 a `match` used as a statement ends with `;`",
        "41..41 an `if` used as a statement ends with `;`",
        "23..23 a block used as a statement ends with `;`",
        "34..34 a `context` used as a statement ends with `;`",
        "19..19 a statement ends with `;`",
        "41..42 an `if` is an operand, not the head of a `.`",
        "38..39 a `match` is an operand, not the head of a `.`",
        "34..35 a `context` is an operand, not the head of a `.`",
        "23..24 a block is an operand, not the head of a `?`",
        "23..24 a block is an operand, not the head of a `.`",
        "22..23 expected a pattern, found `@`",
        "22..23 expected a pattern, found `@`",
        "22..23 expected a pattern, found `@`",
        "18..21 expected `let`, found `ctx`",
        "19..19 a statement ends with `;`",
        "25..26 expected a type, found `=`",
        "22..23 expected a pattern, found `=`",
        "30..31 expected an expression, found `*`",
        "18..24 this function body is missing its closing `}`; 30..31 expected a declaration, found `}`",
        "31..32 expected `else`, found `y`",
        "25..30 `if` requires an `else` branch; 31..31 this function body is missing its closing `}`",
    ]);
}

test "a declaration's stray or misplaced token is said once, and the declaration read where it can be" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "type T = 'c';\n",
        "Point struct { x: Int }\n",
        "struct @Point {}\n",
        "struct @ {}\n",
        "struct export {}\n",
        "struct export fn f(): Int { 1 }\n",
        "from @\"a\" import * as a;\n",
        "from @ import * as a;\n",
        "from @\"abc\n",
        "{ a { b } }\nstruct S {}\n",
        "let X: Int = { 1 } + ;\nstruct S {}\n",
        "let X: Int = (1) + ;\nstruct S {}\n",
        "X let: Int = 1;\n",
        "Point struct Other {}\n",
        "Point\nstruct {}\n",
        "fn export (): Int { 1 }\n",
        "fn g(): Int;\n",
        "fn g(: Int): Int { 1 }\n",
        "fn g(a: Int, : Int): Int { 1 }\n",
        "fn g(self: Int;\n",
        "fn g(self: ): Int { 1 }\n",
        "trait T { fn (): Int; fn g(): Int; }\n",
        "trait T { fn = }\n",
        "derive Equal, 1 for X;\n",
        "Point impl {}\n",
    ];
    assert.equal(sources.mapCtx(ctx, fn(c, s) => spannedOf(c, s).join(c, "; ")), [
        "9..12 expected a type, found a character literal",
        "0..5 expected `struct`, found `Point`",
        "7..8 expected an identifier, found `@`",
        "7..8 expected an identifier, found `@`",
        "7..13 expected an identifier, found `export`",
        "7..13 expected an identifier, found `export`",
        "5..6 expected a string literal, found `@`",
        "5..6 expected a string literal, found `@`",
        "5..6 expected a string literal, found `@`; 10..11 unterminated string literal",
        "0..1 expected a declaration, found `{`",
        "21..22 expected an expression, found `;`",
        "19..20 expected an expression, found `;`",
        "0..1 expected `let`, found `X`",
        "0..5 expected a declaration, found `Point`",
        "0..5 expected a declaration, found `Point`; 13..14 expected an identifier, found `{`",
        "3..9 expected an identifier, found `export`",
        "",
        "5..6 this parameter list is missing its closing `)`",
        "13..14 expected an identifier, found `:`",
        "9..10 this parameter list is missing its closing `)`",
        "9..10 this parameter list is missing its closing `)`",
        "13..14 expected an identifier, found `(`",
        "13..14 expected an identifier, found `=`",
        "14..15 expected an identifier, found `1`",
        "0..5 expected `impl`, found `Point`",
    ]);
}

test "a match arm that runs into the next is told apart from a field access" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "fn f(): Int {\n    match (x) {\n        \"abc\n        1 => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        1 ; 2 => 3,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        1 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        1 => *, 2 => 3,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        1 => * { a }, 2 => 3,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a.b,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B(x) => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B(x => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B { x } => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B if c => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B if (c) => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B | .C => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B if c, 2\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B if c; 2\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B if c ) 2\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B if c\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B ) => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B (x) y => 2,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => t .0,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        A => a .B c,\n    }\n}\n",
        "fn f(): Int {\n    match (x) {\n        = => 1,\n    }\n}\n",
    ];
    assert.equal(sources.mapCtx(ctx, fn(c, s) => spannedOf(c, s).join(c, "; ")), [
        "42..43 unterminated string literal",
        "39..39 a match arm is `pattern => expression`",
        "39..39 a match arm is `pattern => expression`",
        "43..44 expected an expression, found `*`",
        "43..44 expected an expression, found `*`",
        "44..44 a match arm ends with `,`",
        "",
        "44..44 a match arm ends with `,`",
        "50..52 this call is missing its closing `)`",
        "44..44 a match arm ends with `,`",
        "44..44 a match arm ends with `,`",
        "44..44 a match arm ends with `,`",
        "44..44 a match arm ends with `,`",
        "48..50 this `match` is missing its closing `}`",
        "47..47 a `match` used as a statement ends with `;`; 48..50 this `match` is missing its closing `}`; 51..52 expected `(`, found `c`; 62..63 expected a declaration, found `}`",
        "47..47 a `match` used as a statement ends with `;`; 48..50 this `match` is missing its closing `}`; 51..52 expected `(`, found `c`; 63..64 expected a declaration, found `}`",
        "48..50 this `match` is missing its closing `}`",
        "48..49 this `match` is missing its closing `}`; 62..63 expected a declaration, found `}`",
        "51..51 a match arm ends with `,`",
        "",
        "47..47 a match arm ends with `,`; 49..49 a match arm is `pattern => expression`",
        "38..39 expected a pattern, found `=`",
    ]);
}

test "a spaced bracket, a trial type argument and a tuple index read as the compiler reads them" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "fn f(): Int {\n    [a [1, 2]]\n}\n",
        "fn f(): Int {\n    [a [1]]\n}\n",
        "fn f(): Int {\n    [a[1, 2]]\n}\n",
        "fn f(): Int {\n    [a [(1, 2)]]\n}\n",
        "fn f(): Int {\n    [a [b<c, d]]\n}\n",
        "fn f(): Int {\n    [a [1)]\n}\n",
        "fn f(): Int {\n    f<[Int>(1)\n}\n",
        "fn f(): Int {\n    t.0\n}\n",
        "fn f(): Int {\n    t.99999999999999999999\n}\n",
    ];
    assert.equal(sources.mapCtx(ctx, fn(c, s) => spannedOf(c, s).join(c, "; ")), [
        "20..20 an array element ends with `,`",
        "",
        "22..23 this index is missing its closing `]`",
        "",
        "25..26 this index is missing its closing `]`",
        "23..24 this index is missing its closing `]`",
        "29..30 this array is missing its closing `]`",
        "",
        "20..40 `99999999999999999999` is not a tuple index",
    ]);
}

fn inBody<C: Allocator>(ctx: C, inner: Str): Str {
    "fn f(): Int {\n    ".concat(ctx, inner).concat(ctx, "\n}\n")
}

fn inArm<C: Allocator>(ctx: C, inner: Str): Str {
    "fn f(): Int {\n    match (x) {\n        "
        .concat(ctx, inner)
        .concat(ctx, "\n    }\n}\n")
}

fn around<C: Allocator>(ctx: C, before: Str, run: Str, after: Str): Str {
    before.concat(ctx, run.repeat(ctx, 300)).concat(ctx, after)
}

test "a lookahead gives up where the compiler's does, 256 tokens on" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        inBody(ctx, around(ctx, "g(1 = ", "a ", ")")),
        inBody(ctx, around(ctx, "a => ", "b ", ";")),
        inArm(ctx, around(ctx, "A => a .B(", "x ", ") => 2,")),
        inArm(ctx, around(ctx, "A => a .B if ", "c ", "=> 2,")),
        inBody(ctx, around(ctx, "[a [", "1 ", ", 2]]")),
        inBody(ctx, around(ctx, "a < ", "b ", "> c")),
        inBody(
            ctx,
            around(ctx, "let ", "(", "x")
                .concat(ctx, ")".repeat(ctx, 300))
                .concat(ctx, " = 1;\n    x"),
        ),
    ];
    assert.equal(
        sources.mapCtx(ctx, fn(c, s): Str => {
            let errors = spannedOf(c, s);
            let first = errors.getOr(0, "");
            errors.length().show(c).concat(c, ": ").concat(c, first)
        }),
        [
            "300: 22..23 this call is missing its closing `)`",
            "2: 20..22 this function body is missing its closing `}`",
            "300: 49..49 a call argument ends with `,`",
            "4: 47..47 a `match` used as a statement ends with `;`",
            "301: 23..23 an array element ends with `,`",
            "299: 23..23 a statement ends with `;`",
            "1: 277..278 expression nests too deeply",
        ],
    );
}

test "a lookahead that meets the end of the file, a declaration or a nested group stops there" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sources = [
        "fn f(): Int {\n    a => b",
        "fn f(): Int {\n    match (x) {\n        A => a .B(x",
        "fn f(): Int {\n    match (x) {\n        A => a .B if c",
        "fn f(): Int {\n    a => b\nstruct S {}\n",
        inBody(ctx, "-{ 1 }.y;\n    c"),
        inArm(ctx, "A => a .B((x)) => 2,"),
        inArm(ctx, "A => a .B(x] => 2,"),
        inArm(ctx, "1 => *"),
    ];
    assert.equal(sources.mapCtx(ctx, fn(c, s) => spannedOf(c, s).join(c, "; ")), [
        "20..22 this function body is missing its closing `}`",
        "49..49 this call is missing its closing `)`",
        "47..47 a `match` used as a statement ends with `;`; 48..50 this `match` is missing its closing `}`; 51..52 expected `(`, found `c`; 52..52 this function body is missing its closing `}`",
        "20..22 this function body is missing its closing `}`",
        "24..25 expected `;`, found `.`",
        "44..44 a match arm ends with `,`",
        "49..50 this call is missing its closing `)`; 63..64 expected a declaration, found `}`",
        "43..44 expected an expression, found `*`",
    ]);
}
