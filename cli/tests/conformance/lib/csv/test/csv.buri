// core/csv — RFC 4180, and the four things a hand-rolled splitter gets wrong:
// a quoted delimiter, a quoted newline, a doubled quote, and a quote that never
// closes.

from "core/csv" import * as csv;
from "core/csv" import { CsvError };
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

fn read(text: Str): Result<[[Str]], CsvError> {
    let ctx = context {
        Allocator: alloc(),
    };
    csv.parse(ctx, text)
}

fn readWith(text: Str, delimiter: Char): Result<[[Str]], CsvError> {
    let ctx = context {
        Allocator: alloc(),
    };
    csv.parseWith(ctx, text, delimiter)
}

fn readHeaded(text: Str): Result<([Str], [[Str]]), CsvError> {
    let ctx = context {
        Allocator: alloc(),
    };
    csv.parseWithHeader(ctx, text)
}

fn write(rows: [[Str]]): Str {
    let ctx = context {
        Allocator: alloc(),
    };
    csv.render(ctx, rows)
}

// --- Reading ------------------------------------------------------------------

test "a plain file is its records" {
    assert.equal(assert.ok(read("a,b\nc,d")), [["a", "b"], ["c", "d"]]);
}

test "a trailing terminator adds no record" {
    assert.equal(assert.ok(read("a,b\n")), [["a", "b"]]);
    assert.equal(assert.ok(read("a,b\r\n")), [["a", "b"]]);
}

test "an empty text has no records at all" {
    assert.equal(assert.ok(read("")), list.empty<[Str]>());
}

test "a record ends at CRLF and at CR as well as at LF" {
    assert.equal(assert.ok(read("a\r\nb")), [["a"], ["b"]]);
    assert.equal(assert.ok(read("a\rb")), [["a"], ["b"]]);
}

test "an empty field is a field" {
    assert.equal(assert.ok(read("a,")), [["a", ""]]);
    assert.equal(assert.ok(read(",a")), [["", "a"]]);
    assert.equal(assert.ok(read(",")), [["", ""]]);
}

test "quotes hide the delimiter, the newline and the carriage return" {
    assert.equal(assert.ok(read("\"one, two\",b")), [["one, two", "b"]]);
    assert.equal(assert.ok(read("\"one\ntwo\"")), [["one\ntwo"]]);
    assert.equal(assert.ok(read("\"one\r\ntwo\"")), [["one\r\ntwo"]]);
}

test "a doubled quote is one quote" {
    assert.equal(assert.ok(read("\"a\"\"b\"")), [["a\"b"]]);
    assert.equal(assert.ok(read("\"\"\"\"")), [["\""]]);
    assert.equal(assert.ok(read("\"\"")), [[""]]);
}

test "text after a closing quote joins the field" {
    assert.equal(assert.ok(read("\"ab\"c")), [["abc"]]);
}

test "a blank line in the middle is a record of one empty field" {
    assert.equal(assert.ok(read("a\n\nb")), [["a"], [""], ["b"]]);
}

test "a quote that never closes names the record that opened it" {
    assert.equal(assert.err(read("\"unclosed")), CsvError.Unterminated(0));
    assert.equal(assert.err(read("a,b\nc,\"unclosed")), CsvError.Unterminated(1));
}

test "a record of the wrong width names itself" {
    assert.equal(assert.err(read("a,b\nc")), CsvError.RaggedRow(1));
    assert.equal(assert.err(read("a\nb,c")), CsvError.RaggedRow(1));
    assert.equal(assert.err(read("a\nb\nc,d")), CsvError.RaggedRow(2));
}

test "another delimiter changes nothing else" {
    assert.equal(assert.ok(readWith("a\tb", '\t')), [["a", "b"]]);
    assert.equal(assert.ok(readWith("\"a\tb\";c", ';')), [["a\tb", "c"]]);
    // A comma is data once the delimiter is not one.
    assert.equal(assert.ok(readWith("a,b;c", ';')), [["a,b", "c"]]);
}

// --- The header ---------------------------------------------------------------

test "the first record is the header" {
    let table = assert.ok(readHeaded("name,age\nada,36"));
    assert.equal(table.0, ["name", "age"]);
    assert.equal(table.1, [["ada", "36"]]);
}

test "a header with no records under it" {
    let table = assert.ok(readHeaded("name,age"));
    assert.equal(table.0, ["name", "age"]);
    assert.equal(table.1, list.empty<[Str]>());
}

test "the empty text has no header and no records" {
    let table = assert.ok(readHeaded(""));
    assert.equal(table.0, list.empty<Str>());
    assert.equal(table.1, list.empty<[Str]>());
}

test "a ragged file fails through the header reader too" {
    assert.equal(assert.err(readHeaded("a,b\nc")), CsvError.RaggedRow(1));
}

// --- Writing ------------------------------------------------------------------

test "render quotes only what it has to" {
    assert.equal(write([["a", "b"]]), "a,b");
    assert.equal(write([["one, two"]]), "\"one, two\"");
    assert.equal(write([["a\"b"]]), "\"a\"\"b\"");
    assert.equal(write([["a\nb"]]), "\"a\nb\"");
    assert.equal(write([["a\rb"]]), "\"a\rb\"");
}

test "records are joined with CRLF and the last one has no terminator" {
    assert.equal(write([["a"], ["b"]]), "a\r\nb");
}

test "no records is the empty text" {
    assert.equal(write(list.empty<[Str]>()), "");
}

test "render then parse gives the records back" {
    let rows = [["plain", "one, two", "a\"b"], ["", "line\nbreak", "trailing "]];
    assert.equal(assert.ok(read(write(rows))), rows);
}

// --- The terminators, one at a time -----------------------------------------------

test "a file of one terminator is one record of one empty field" {
    assert.equal(assert.ok(read("\n")), [[""]]);
    assert.equal(assert.ok(read("\r")), [[""]]);
    assert.equal(assert.ok(read("\r\n")), [[""]]);
}

test "a carriage return that is not part of a CRLF ends its own record" {
    assert.equal(assert.ok(read("a\n\r\nb")), [["a"], [""], ["b"]]);
    assert.equal(assert.ok(read("a\r\rb")), [["a"], [""], ["b"]]);
    assert.equal(assert.ok(read("a\n\nb")), [["a"], [""], ["b"]]);
}

test "a terminator at the end and one in the middle are not the same thing" {
    assert.equal(assert.ok(read("a\nb\n")), [["a"], ["b"]]);
    assert.equal(assert.ok(read("a\nb")), [["a"], ["b"]]);
    // Two terminators at the end: the first ends the record, the second opens
    // one that has an empty field in it.
    assert.equal(assert.err(read("a,b\n\n")), CsvError.RaggedRow(1));
}

// --- A quote where a reader does not expect one --------------------------------------

test "a quote inside an unquoted field is data" {
    assert.equal(assert.ok(read("a\"b")), [["a\"b"]]);
    assert.equal(assert.ok(read("a\"\"b")), [["a\"\"b"]]);
    assert.equal(assert.ok(read("12\" pipe,x")), [["12\" pipe", "x"]]);
}

test "a quoted field spanning records is one field" {
    assert.equal(assert.ok(read("\"one\rtwo\"")), [["one\rtwo"]]);
    assert.equal(assert.ok(read("a,\"one\ntwo\"\nb,c")), [
        ["a", "one\ntwo"],
        ["b", "c"],
    ]);
    // Three records' worth of terminators, all inside one field.
    assert.equal(assert.ok(read("\"\n\r\n\r\"")), [["\n\r\n\r"]]);
}

test "a quote that never closes, wherever it opened" {
    assert.equal(assert.err(read("a,\"b")), CsvError.Unterminated(0));
    assert.equal(assert.err(read("a\nb\n\"c")), CsvError.Unterminated(2));
    // A field that opened, closed and opened again.
    assert.equal(assert.err(read("\"a\"\"b")), CsvError.Unterminated(0));
}

// --- A delimiter the format did not have in mind ---------------------------------------

test "a delimiter that is a quote loses to the quoting rules" {
    // The quote is read as a quote first, so it separates fields only where a
    // field is already under way.
    assert.equal(assert.ok(readWith("a\"b", '"')), [["a", "b"]]);
    assert.equal(assert.ok(readWith("\"a\"", '"')), [["a"]]);
}

test "a delimiter that is a record terminator leaves one record" {
    // `\n` is asked about as a delimiter before it is asked about as a
    // terminator, so nothing ends a record and the whole file is one.
    assert.equal(assert.ok(readWith("a\nb\nc", '\n')), [["a", "b", "c"]]);
}

test "a delimiter outside ASCII is a delimiter like any other" {
    assert.equal(assert.ok(readWith("a☃b", '☃')), [["a", "b"]]);
    assert.equal(assert.ok(readWith("\"a☃b\"☃c", '☃')), [["a☃b", "c"]]);
}

// --- Ragged, counted over every record ---------------------------------------------------

test "a file of one record can never be ragged" {
    assert.equal(assert.ok(read("a,b,c")), [["a", "b", "c"]]);
    assert.equal(assert.ok(read(",,")), [["", "", ""]]);
}

test "a blank record among wide ones is the ragged one" {
    assert.equal(assert.err(read("a,b\n\nc,d")), CsvError.RaggedRow(1));
    assert.equal(assert.err(read("a,b\nc,d\n\n")), CsvError.RaggedRow(2));
}

test "the first record is the width every other one is held to" {
    // Wider than the first, not only narrower.
    assert.equal(assert.err(read("a\nb,c,d")), CsvError.RaggedRow(1));
}

// --- The header, at its edges --------------------------------------------------------------

test "a header with a terminator under it and nothing else" {
    let table = assert.ok(readHeaded("name,age\n"));
    assert.equal(table.0, ["name", "age"]);
    assert.equal(table.1, list.empty<[Str]>());
}

test "a file of one terminator has a header of one empty column" {
    let table = assert.ok(readHeaded("\n"));
    assert.equal(table.0, [""]);
    assert.equal(table.1, list.empty<[Str]>());
}

test "an unterminated quote fails through the header reader too" {
    assert.equal(assert.err(readHeaded("a,b\nc,\"d")), CsvError.Unterminated(1));
}

// --- Writing, at its edges -----------------------------------------------------------------

test "a field of only a quote, and one of only a delimiter" {
    assert.equal(write([["\""]]), "\"\"\"\"");
    assert.equal(write([[","]]), "\",\"");
    assert.equal(write([["\r\n"]]), "\"\r\n\"");
}

test "space is not a reason to quote, and neither is anything else" {
    assert.equal(write([[" a "]]), " a ");
    assert.equal(write([["a;b\tc"]]), "a;b\tc");
    assert.equal(write([["☃"]]), "☃");
}

test "a record of no fields is an empty line" {
    assert.equal(write([list.empty<Str>()]), "");
    assert.equal(write([list.empty<Str>(), list.empty<Str>()]), "\r\n");
}

test "render then parse gives back every shape a field can take" {
    let rows = [
        ["", "\"", ",", "\r\n"],
        ["\n", "a\"\"b", " padded ", "☃"],
        ["plain", "one, two", "line\nbreak", "cr\rreturn"],
    ];
    assert.equal(assert.ok(read(write(rows))), rows);
}
