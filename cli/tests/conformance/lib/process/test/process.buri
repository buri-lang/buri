// core/process — running another program.
//
// `Spawn` is the largest authority a context can carry, so the double is where
// most of it is asserted: what `run` hands the effect, what a scripted answer
// comes back as, and where `which` looks. `native::e2e` runs `true`, `false`
// and `cat` for real.

from "core/fs" import * as fs;
from "core/fs" import { FileSystemRead, FileSystemWrite };
from "core/path" import * as path;
from "core/process" import * as process;
from "core/process" import { Command, Output, Spawn };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Environment };
from "platform/effect/testing" import { alloc, env, fs as testFs, spawn, spawned };

// -----------------------------------------------------------------------------
// Building a command
// -----------------------------------------------------------------------------

test "a command names a program and its arguments, and nothing else" {
    let one = process.command("git", ["describe", "--tags"]);
    assert.equal(one.program, "git");
    assert.equal(one.arguments, ["describe", "--tags"]);
    assert.none(one.workingDirectory);
    assert.none(one.environment);
    assert.none(one.stdin);
}

test "a command with no arguments is a command" {
    let bare = process.command("true", []);
    assert.equal(bare.arguments, []);
    assert.equal(bare, process.command("true", []));
}

// -----------------------------------------------------------------------------
// Running one
// -----------------------------------------------------------------------------

test "a double that was told nothing refuses" {
    let runner = spawn();
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    assert.equal(
        assert.err(process.run(ctx, process.command("git", ["--version"]))),
        .NotFound,
    );
    assert.equal(runner.calls(), [spawned("git", ["--version"])]);
}

test "a scripted output comes back whole" {
    let answer = Output { code: 0, stdout: [104, 105], stderr: [] };
    let runner = spawn().answers(answer);
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    assert.equal(assert.ok(process.run(ctx, process.command("echo", ["hi"]))), answer);
}

test "a non-zero exit is an answer rather than an error" {
    let runner = spawn().answers(Output { code: 3, stdout: [], stderr: [33] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let done = assert.ok(process.run(ctx, process.command("false", [])));
    assert.equal(done.code, 3);
    assert.equal(done.stderr, [33]);
}

test "a scripted failure is the failure" {
    let runner = spawn().fails(.PermissionDenied);
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    assert.equal(
        assert.err(process.run(ctx, process.command("sh", []))),
        .PermissionDenied,
    );
}

test "every run is a call the log has, in order" {
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let _ = assert.ok(process.run(ctx, process.command("a", ["1"])));
    let _ = assert.ok(process.run(ctx, process.command("b", [])));
    assert.equal(runner.calls(), [spawned("a", ["1"]), spawned("b", [])]);
}

test "an argument reaches the log exactly as it was written" {
    // Nothing is a shell, so a space, an `=`, a quote and a character outside
    // ASCII are each one argument and none of them is a second command. An
    // empty argument is an argument too.
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let arguments = ["", "two words", "--message=it's \"quoted\"", "café", ";rm -rf /"];
    let _ = assert.ok(process.run(ctx, process.command("tool", arguments)));
    assert.equal(runner.calls(), [spawned("tool", arguments)]);
}

test "a program named by a path is the program, separators and all" {
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let _ = assert.ok(process.run(ctx, process.command("/usr/bin/env", [])));
    let _ = assert.ok(process.run(ctx, process.command("./build/tool", ["x"])));
    assert.equal(runner.calls(), [
        spawned("/usr/bin/env", []),
        spawned("./build/tool", ["x"]),
    ]);
}

test "a child that wrote to both streams is read back from both" {
    let runner = spawn().answers(Output {
        code: 2,
        stdout: [111, 117, 116],
        stderr: [101],
    });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let done = assert.ok(process.run(ctx, process.command("noisy", [])));
    assert.equal(done.code, 2);
    assert.equal(done.stdout, [111, 117, 116]);
    assert.equal(done.stderr, [101]);
}

test "a run that failed is still a run the log has, and the next one runs" {
    // The failure is the effect's, not the command's: a program that carries
    // on after one is a program whose second command still reaches the double.
    let runner = spawn().fails(.NotFound);
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    assert.equal(assert.err(process.run(ctx, process.command("first", []))), .NotFound);
    assert.equal(
        assert.err(process.run(ctx, process.command("second", []))),
        .NotFound,
    );
    assert.equal(runner.calls(), [spawned("first", []), spawned("second", [])]);
}

test "the optional fields reach the effect without changing what is logged" {
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let full = Command {
        program: "make",
        arguments: ["-j", "4"],
        workingDirectory: .Some(path.of(ctx, "/srv/app")),
        environment: .Some([("CC", "clang")]),
        stdin: .Some([1, 2]),
        stdout: .Some(path.of(ctx, "/tmp/out.log")),
        stderr: .Some(path.of(ctx, "/tmp/err.log")),
    };
    let _ = assert.ok(process.run(ctx, full));
    assert.equal(runner.calls(), [spawned("make", ["-j", "4"])]);
}

// -----------------------------------------------------------------------------
// Starting one
// -----------------------------------------------------------------------------

test "a command's output files start empty, and a spread fills them" {
    let ctx = context {
        Allocator: alloc(),
    };
    let bare = process.command("server", []);
    assert.none(bare.stdout);
    assert.none(bare.stderr);
    let logged = Command { ..bare, stdout: .Some(path.of(ctx, "out.log")) };
    assert.equal(logged.stdout, .Some(path.of(ctx, "out.log")));
    assert.none(logged.stderr);
}

test "a double that was told nothing refuses to start, and logs the try" {
    let runner = spawn();
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    assert.equal(
        assert.err(process.start(ctx, process.command("./server", ["--port", "9001"]))),
        .NotFound,
    );
    assert.equal(runner.calls(), [spawned("./server", ["--port", "9001"])]);
}

test "a scripted failure fails a start too" {
    let runner = spawn().fails(.PermissionDenied);
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    assert.equal(
        assert.err(process.start(ctx, process.command("sh", []))),
        .PermissionDenied,
    );
}

test "a started child runs until it is waited on, and exits with the scripted code" {
    let runner = spawn().answers(Output { code: 7, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let child = assert.ok(process.start(ctx, process.command("server", [])));
    assert.equal(assert.ok(child.tryWait(ctx)), .None);
    assert.equal(assert.ok(child.wait(ctx)), .Exited(7));
    assert.equal(assert.ok(child.wait(ctx)), .Exited(7));
    assert.equal(assert.ok(child.tryWait(ctx)), .Some(.Exited(7)));
}

test "a signal that ends a process ends a started child" {
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let killed = assert.ok(process.start(ctx, process.command("a", [])));
    let terminated = assert.ok(process.start(ctx, process.command("b", [])));
    let interrupted = assert.ok(process.start(ctx, process.command("c", [])));
    let hungUp = assert.ok(process.start(ctx, process.command("d", [])));
    assert.ok(killed.signal(ctx, .Kill));
    assert.ok(terminated.signal(ctx, .Terminate));
    assert.ok(interrupted.signal(ctx, .Interrupt));
    assert.ok(hungUp.signal(ctx, .Other(1)));
    assert.equal(assert.ok(killed.tryWait(ctx)), .Some(.Signaled(.Kill)));
    assert.equal(assert.ok(terminated.wait(ctx)), .Signaled(.Terminate));
    assert.equal(assert.ok(interrupted.wait(ctx)), .Signaled(.Interrupt));
    assert.equal(assert.ok(hungUp.wait(ctx)), .Signaled(.Other(1)));
}

test "stop and continue leave a started child running" {
    let runner = spawn().answers(Output { code: 2, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let child = assert.ok(process.start(ctx, process.command("server", [])));
    assert.ok(child.signal(ctx, .Stop));
    assert.equal(assert.ok(child.tryWait(ctx)), .None);
    assert.ok(child.signal(ctx, .Continue));
    assert.equal(assert.ok(child.wait(ctx)), .Exited(2));
}

test "every signal is logged with the child it went to, in order" {
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let first = assert.ok(process.start(ctx, process.command("a", [])));
    let second = assert.ok(process.start(ctx, process.command("b", [])));
    assert.notEqual(first.id(), second.id());
    assert.ok(second.signal(ctx, .Stop));
    assert.ok(first.signal(ctx, .Kill));
    assert.ok(second.signal(ctx, .Continue));
    assert.equal(runner.signals(ctx), [
        (second.id(), .Stop),
        (first.id(), .Kill),
        (second.id(), .Continue),
    ]);
    assert.equal(runner.calls(), [spawned("a", []), spawned("b", [])]);
}

test "a signal to a child that has exited is logged and changes nothing" {
    let runner = spawn().answers(Output { code: 0, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let child = assert.ok(process.start(ctx, process.command("a", [])));
    assert.equal(assert.ok(child.wait(ctx)), .Exited(0));
    assert.ok(child.signal(ctx, .Kill));
    assert.equal(assert.ok(child.wait(ctx)), .Exited(0));
    assert.equal(runner.signals(ctx), [(child.id(), .Kill)]);
}

test "a signal reaches only the child it was sent to" {
    let runner = spawn().answers(Output { code: 1, stdout: [], stderr: [] });
    let ctx = context {
        Allocator: alloc(),
        Spawn: runner,
    };
    let killed = assert.ok(process.start(ctx, process.command("a", [])));
    let spared = assert.ok(process.start(ctx, process.command("b", [])));
    assert.ok(killed.signal(ctx, .Kill));
    assert.equal(assert.ok(killed.wait(ctx)), .Signaled(.Kill));
    assert.equal(assert.ok(spared.tryWait(ctx)), .None);
    assert.equal(assert.ok(spared.wait(ctx)), .Exited(1));
}

// -----------------------------------------------------------------------------
// which
// -----------------------------------------------------------------------------

test "which walks PATH and answers the first that is there" {
    let files = testFs().files([("/usr/bin/git", ""), ("/opt/bin/git", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/opt/bin:/usr/bin")]),
        FileSystemRead: files,
    };
    assert.equal(assert.some(process.which(ctx, "git")), path.of(ctx, "/opt/bin/git"));
}

test "which answers nothing where nothing on PATH is called that" {
    let files = testFs().files([("/usr/bin/git", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/usr/bin")]),
        FileSystemRead: files,
    };
    assert.none(process.which(ctx, "ffmpeg"));
}

test "a program with a separator in it names a file directly" {
    let files = testFs().files([("build/tool", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/usr/bin")]),
        FileSystemRead: files,
    };
    assert.equal(
        assert.some(process.which(ctx, "build/tool")),
        path.of(ctx, "build/tool"),
    );
    assert.none(process.which(ctx, "build/missing"));
}

test "an environment with no PATH finds nothing" {
    let files = testFs().files([("/usr/bin/git", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env(),
        FileSystemRead: files,
    };
    assert.none(process.which(ctx, "git"));
}

test "an absolute program names a file directly, and PATH is not consulted" {
    let files = testFs().files([("/opt/git", ""), ("/usr/bin/git", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/usr/bin")]),
        FileSystemRead: files,
    };
    assert.equal(assert.some(process.which(ctx, "/opt/git")), path.of(ctx, "/opt/git"));
    assert.none(process.which(ctx, "/opt/missing"));
}

test "an empty PATH is one empty entry, which is where the process stands" {
    // A shell reads an empty entry as the current directory, and `PATH=` is one
    // empty entry — so a relative `tool` beside the process is what `which`
    // finds, and nothing on any real search path is.
    let files = testFs().files([("tool", ""), ("/usr/bin/git", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "")]),
        FileSystemRead: files,
    };
    assert.equal(assert.some(process.which(ctx, "tool")), path.of(ctx, "tool"));
    assert.none(process.which(ctx, "git"));
}

test "an empty entry in the middle of PATH is the same current directory" {
    let files = testFs().files([("tool", ""), ("/usr/bin/other", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/usr/bin::/opt/bin")]),
        FileSystemRead: files,
    };
    assert.equal(assert.some(process.which(ctx, "tool")), path.of(ctx, "tool"));
}

test "a directory on PATH with the program's name answers as a path" {
    // `which` asks whether the name resolves, which is what its doc comment
    // says: a directory called `git` is `.Some`, and running it is what tells
    // a program it cannot be run.
    let files = testFs().files([("/usr/bin/git/keep", "")]);
    let building = context {
        Allocator: alloc(),
        Environment: env(),
        FileSystemRead: files,
        FileSystemWrite: files,
    };
    assert.ok(fs.makeDir(building, path.of(building, "/usr/bin/git")));
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/usr/bin")]),
        FileSystemRead: files,
    };
    assert.equal(assert.some(process.which(ctx, "git")), path.of(ctx, "/usr/bin/git"));
}

test "the first entry that has it wins, and a trailing separator changes nothing" {
    let files = testFs().files([("/a/tool", ""), ("/b/tool", "")]);
    let ctx = context {
        Allocator: alloc(),
        Environment: env().variables([("PATH", "/none:/a/:/b")]),
        FileSystemRead: files,
    };
    assert.equal(assert.some(process.which(ctx, "tool")), path.of(ctx, "/a/tool"));
}
