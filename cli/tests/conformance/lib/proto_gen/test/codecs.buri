// What comes with each type: five functions for a message, four for an enum,
// and the imports that make them resolve.

from "core/buri/ast" import * as ast;
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/proto_gen" import { block, generatedWith, HEAD, lines };

test "a module says where it came from and imports what it uses" {
    let ctx = context {
        Allocator: alloc(),
    };
    let out = lines(ctx, [HEAD, "message M { int32 a = 1; }\n"].join(ctx, ""));
    assert.equal(
        block(
            ctx,
            out,
            "//! Generated from lib/wire/point.proto. Not a file to edit: the schema is the source,",
            11,
        ),
        [
            "//! Generated from lib/wire/point.proto. Not a file to edit: the schema is the source,",
            "//! and this module is rebuilt from it whenever the schema changes.",
            "//!",
            "//! What the mapping is, and why: `buri docs build/proto`.",
            "",
            "from \"core/bytes\" import * as bytes;",
            "from \"core/effect\" import { Allocator };",
            "from \"core/json\" import { Json };",
            "from \"core/list\" import * as list;",
            "from \"core/proto\" import * as proto;",
            "from \"core/proto\" import { ProtoError };",
        ],
    );
}

test "a message brings five exported functions, and the two the rest of them share" {
    let ctx = context {
        Allocator: alloc(),
    };
    let out = lines(ctx, [HEAD, "message M { int32 a = 1; }\n"].join(ctx, ""));
    assert.contains(out, "export fn defaultM(): M {");
    assert.contains(out, "export fn encodeM<C: Allocator>(ctx: C, value: M): [U8] {");
    assert.contains(
        out,
        "export fn decodeM<C: Allocator>(ctx: C, b: [U8]): Result<M, ProtoError> {",
    );
    assert.contains(out, "export fn encodeMJson<C: Allocator>(ctx: C, value: M): Json {");
    assert.contains(
        out,
        "export fn decodeMJson<C: Allocator>(ctx: C, doc: Json): Result<M, ProtoError> {",
    );
    assert.contains(
        out,
        "export fn decodeMJsonAt<C: Allocator>(ctx: C, doc: Json, path: Str): Result<M, ProtoError> {",
    );
    // `mergeM` is the reader a repeated encoding of one message folds through,
    // and `readM` is the loop under both of them.
    assert.contains(
        out,
        "export fn mergeM<C: Allocator>(ctx: C, b: [U8], into: M): Result<M, ProtoError> {",
    );
    assert.contains(
        out,
        "fn readM<C: Allocator>(ctx: C, b: [U8], at: Int, acc: M): Result<M, ProtoError> {",
    );
}

test "an enum brings four" {
    let ctx = context {
        Allocator: alloc(),
    };
    let out = lines(ctx, [HEAD, "enum E { E_UNSPECIFIED = 0; }\n"].join(ctx, ""));
    assert.contains(out, "export fn encodeE(value: E): Int {");
    assert.contains(out, "export fn decodeE(number: Int): E {");
    assert.contains(out, "export fn encodeEJson(value: E): Json {");
    assert.contains(
        out,
        "export fn decodeEJson(doc: Json, path: Str): Result<E, ProtoError> {",
    );
}

test "a type from another schema arrives with its codecs" {
    let ctx = context {
        Allocator: alloc(),
    };
    let here = [
        HEAD,
        "import \"lib/proto/address.proto\";\n",
        "message Person { Address home = 1; }\n",
    ].join(ctx, "");
    let there = [HEAD, "message Address { string city = 1; }\n"].join(ctx, "");
    let out = ast
        .print(ctx, generatedWith(ctx, here, "//lib/proto/address.proto", there).tree)
        .text
        .lines(ctx);
    assert.contains(
        out,
        "from \"//lib/proto/address.proto\" import { Address, decodeAddress, decodeAddressJsonAt, defaultAddress, encodeAddress, encodeAddressJson, mergeAddress };",
    );
    assert.contains(out, "    export home: Option<Address>,");
}

test "a message with no fields still round-trips" {
    let ctx = context {
        Allocator: alloc(),
    };
    let out = lines(ctx, [HEAD, "message Empty {}\n"].join(ctx, ""));
    assert.contains(out, "export struct Empty {}");
    assert.contains(out, "    Empty { }");
    assert.contains(out, "    list.empty<U8>()");
    assert.contains(out, "        .Object(_entries) => { .Ok(Empty { }) },");
}
