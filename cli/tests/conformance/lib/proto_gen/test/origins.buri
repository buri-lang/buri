// Where a generated declaration came from.
//
// This is the claim nothing else in the tree checks: every node carries the
// span of the `.proto` declaration behind it, so go-to-definition on
// `Person.name` lands on `string name = 1;` and not on generated text nobody
// wrote.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/proto_gen" import { anchorOf, FILE, printed, spanText };

fn source<C: Allocator>(ctx: C): Str {
    [
        "edition = \"2026\";\n",
        "enum Shade { SHADE_UNSPECIFIED = 0; DARK = 2; }\n",
        "message Person {\n",
        "  string name = 1;\n",
        "  repeated string emails = 3;\n",
        "  oneof pick { string phone = 4; }\n",
        "}\n",
    ].join(ctx, "")
}

test "a generated field's name carries the span of the field that produced it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = source(ctx);
    let out = printed(ctx, text);
    let anchor = assert.some(anchorOf(ctx, out, "name"));
    assert.equal(anchor.origin.file, FILE);
    assert.equal(spanText(text, anchor.origin), "string name = 1;");
    // The whole member carries it too, so a diagnostic about the field lands on
    // the same line of the schema as one about its name.
    let member = assert.some(anchorOf(ctx, out, "export name: Option<Str>"));
    assert.equal(spanText(text, member.origin), "string name = 1;");
}

test "a generated struct carries its message's span" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = source(ctx);
    let out = printed(ctx, text);
    let anchor = assert.some(anchorOf(ctx, out, "Person"));
    assert.equal(spanText(text, anchor.origin), "Person");
}

test "a generated enum variant carries the span of its value" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = source(ctx);
    let out = printed(ctx, text);
    assert.equal(
        spanText(text, assert.some(anchorOf(ctx, out, "DARK")).origin),
        "DARK",
    );
    assert.equal(
        spanText(text, assert.some(anchorOf(ctx, out, "Shade")).origin),
        "Shade",
    );
}

test "a oneof's enum and its cases carry the schema's spans" {
    let ctx = context {
        Allocator: alloc(),
    };
    let text = source(ctx);
    let out = printed(ctx, text);
    let held = assert.some(anchorOf(ctx, out, "Person_Pick"));
    assert.equal(spanText(text, held.origin), "pick");
    let phone = assert.some(anchorOf(ctx, out, "Phone"));
    assert.equal(spanText(text, phone.origin), "string phone = 4;");
    let field = assert.some(anchorOf(ctx, out, "export pick: Option<Person_Pick>"));
    assert.equal(spanText(text, field.origin), "pick");
}

test "a node no declaration is behind records no anchor" {
    let ctx = context {
        Allocator: alloc(),
    };
    let out = printed(ctx, source(ctx));
    // `defaultPerson` is the generator's own name and not the schema's, so
    // nothing points at it.
    assert.none(anchorOf(ctx, out, "defaultPerson"));
    assert.none(anchorOf(ctx, out, "acc"));
    // Every anchor that *is* recorded names the file the schema was read from.
    assert.isTrue(out.anchors.all(fn(a) => a.origin.file == FILE));
    assert.notEmpty(out.anchors);
}
