// The mapping table of `buri docs build/proto`, read off the generated module.

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/proto_gen" import { block, HEAD, lines };

test "the page's own example is the module the page says it is" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [
        HEAD,
        "package example.v1;\n",
        "message Address { string city = 1; }\n",
        "message Person {\n",
        "  string name = 1;\n",
        "  int32 age = 2 [features.field_presence = IMPLICIT];\n",
        "  repeated string emails = 3;\n",
        "  Address home = 4;\n",
        "}\n",
    ].join(ctx, "");
    let out = lines(ctx, source);
    assert.eq(block(ctx, out, "export struct Person {", 6), [
        "export struct Person {",
        "    export name: Option<Str>,",
        "    export age: Int,",
        "    export emails: [Str],",
        "    export home: Option<Address>,",
        "}",
    ]);
    // The formatter puts a `derive` above the declaration it is about, so the
    // line sits just before the block.
    assert.contains(out, "derive Eq, Show for Person;");
}

test "a singular message field is an Option whatever the feature says" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [
        HEAD,
        "option features.field_presence = IMPLICIT;\n",
        "message Inner { int32 a = 1; }\n",
        "message M {\n",
        "  int32 bare = 1;\n",
        "  int32 tracked = 2 [features.field_presence = EXPLICIT];\n",
        "  Inner one = 3;\n",
        "}\n",
    ].join(ctx, "");
    assert.eq(block(ctx, lines(ctx, source), "export struct M {", 5), [
        "export struct M {",
        "    export bare: Int,",
        "    export tracked: Option<Int>,",
        "    export one: Option<Inner>,",
        "}",
    ]);
}

test "a oneof becomes an enum held as an Option" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [
        HEAD,
        "message Address { string city = 1; }\n",
        "message Everything {\n",
        "  oneof contact {\n",
        "    string phone = 60;\n",
        "    Address office = 61;\n",
        "  }\n",
        "}\n",
    ].join(ctx, "");
    let out = lines(ctx, source);
    assert.eq(block(ctx, out, "export enum Everything_Contact {", 4), [
        "export enum Everything_Contact {",
        "    Phone(Str),",
        "    Office(Address),",
        "}",
    ]);
    assert.eq(block(ctx, out, "export struct Everything {", 3), [
        "export struct Everything {",
        "    export contact: Option<Everything_Contact>,",
        "}",
    ]);
    assert.contains(out, "/// The cases of `Everything`'s `contact`.");
}

test "an open enum keeps a number it does not name" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [
        HEAD,
        "enum Shade { SHADE_UNSPECIFIED = 0; LIGHT = 1; DARK = 2; }\n",
    ].join(ctx, "");
    let out = lines(ctx, source);
    assert.eq(block(ctx, out, "export enum Shade {", 4), [
        "export enum Shade {",
        "    SHADE_UNSPECIFIED,",
        "    LIGHT,",
        "    DARK,",
    ]);
    assert.contains(out, "    Unrecognized(Int),");
    assert.contains(out, "        .Unrecognized(n) => n,");
    assert.contains(out, "        .Unrecognized(n) => proto.jsonInt32(n),");
}

test "a schema that already names Unrecognized keeps its meaning" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [HEAD, "enum E { E_UNSPECIFIED = 0; Unrecognized = 1; }\n"].join(
        ctx,
        "",
    );
    let out = lines(ctx, source);
    assert.contains(out, "    Unrecognized,");
    assert.contains(out, "    Unrecognized_(Int),");
    assert.contains(out, "        .Unrecognized_(n) => n,");
}

test "an alias decodes to the first name that claimed its number" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [HEAD, "enum E { E_UNSPECIFIED = 0; ONE = 1; ALSO_ONE = 1; }\n"].join(
        ctx,
        "",
    );
    let out = lines(ctx, source);
    assert.contains(out, "        .ALSO_ONE => 1,");
    assert.contains(
        out,
        "    if (number == 0) { E.E_UNSPECIFIED } else if (number == 1) { E.ONE } else { E.Unrecognized(number) }",
    );
}

test "nested types flatten with an underscore" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [
        HEAD,
        "message Outer {\n",
        "  message Inner { int32 a = 1; }\n",
        "  enum Note { NOTE_UNSPECIFIED = 0; }\n",
        "  Inner in = 1;\n",
        "  Note note = 2;\n",
        "}\n",
    ].join(ctx, "");
    let out = lines(ctx, source);
    assert.contains(out, "export struct Outer_Inner {");
    assert.contains(out, "export enum Outer_Note {");
    assert.eq(block(ctx, out, "export struct Outer {", 4), [
        "export struct Outer {",
        "    export in_: Option<Outer_Inner>,",
        "    export note: Option<Outer_Note>,",
        "}",
    ]);
}

test "a field's Buri name is protoc's json_name, and a keyword gets an underscore" {
    let ctx = context {
        Alloc: alloc(),
    };
    let source = [
        HEAD,
        "message M {\n",
        "  string user_name = 1;\n",
        "  string type = 2;\n",
        "  string URL = 3;\n",
        "  string a_b_c = 4;\n",
        "}\n",
    ].join(ctx, "");
    let out = lines(ctx, source);
    assert.eq(block(ctx, out, "export struct M {", 6), [
        "export struct M {",
        "    export userName: Option<Str>,",
        "    export type_: Option<Str>,",
        "    export URL: Option<Str>,",
        "    export aBC: Option<Str>,",
        "}",
    ]);
    // The JSON document is not ours to rename: the escaped field still writes
    // the name the schema wrote, and a camel name is looked up under both.
    assert.contains(out, "                .Some(x) => [(\"type\", Json.Str(x))],");
    assert.contains(out, "                .Some(x) => [(\"userName\", Json.Str(x))],");
    assert.contains(
        out,
        "            let type_: Option<Str> = match (proto.member(doc, \"type\")) {",
    );
    assert.contains(
        out,
        "            let userName: Option<Str> = match (proto.memberEither(doc, \"userName\", \"user_name\")) {",
    );
}
