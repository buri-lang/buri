// What `json.parse` takes and refuses at the edges of RFC 8259: a trailing
// comma, the surrogates either side of a pair, and the signs a number may carry.

from "core/json" import * as json;
from "core/json" import { DecodeError, Json, JsonError };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

test "a trailing comma closes nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "[1,]"), .Err(JsonError.Unexpected(3)));
    assert.equal(json.parse(ctx, "{\"a\": 1,}"), .Err(JsonError.Unexpected(8)));
}

test "a code point past the low surrogates is a character of its own" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "\"\\uE000\""), .Ok(Json.Str("\u{e000}")));
    assert.equal(json.parse(ctx, "\"\\uDFFF\""), .Err(JsonError.BadEscape(3)));
}

test "an escape reaches the last character on either side of the surrogates" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "\"\\uD7FF\""), .Ok(Json.Str("\u{d7ff}")));
    assert.equal(json.parse(ctx, "\"\\uFFFF\""), .Ok(Json.Str("\u{ffff}")));
    assert.equal(json.parse(ctx, "\"\\uD800\\uDC00\""), .Ok(Json.Str("𐀀")));
    assert.equal(json.parse(ctx, "\"\\uDBFF\\uDFFF\""), .Ok(Json.Str("\u{10ffff}")));
}

test "a high surrogate is paired only with a low one" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "\"\\uD83D\\uDE00\""), .Ok(Json.Str("😀")));
    assert.equal(json.parse(ctx, "\"\\uD83D\\u0041\""), .Err(JsonError.BadEscape(9)));
    assert.equal(json.parse(ctx, "\"\\uD83D\\uE000\""), .Err(JsonError.BadEscape(9)));
}

test "a number needs a digit before its point or its exponent" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "-.5"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "-"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "-e5"), .Err(JsonError.BadNumber(0)));
}

test "a sign belongs to a number only at its start or after its e" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "1e-2"), .Ok(Json.Num(0.01)));
    assert.equal(json.parse(ctx, "1E+2"), .Ok(Json.Num(100.0)));
    assert.equal(json.parse(ctx, "[1-2]"), .Err(JsonError.Unexpected(2)));
    assert.equal(json.parse(ctx, "[1.5+2]"), .Err(JsonError.Unexpected(4)));
}

test "a document that stops inside an array or an object is unterminated" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "["), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "{"), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "{\"a"), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "{\"a\""), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "{\"a\":"), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "{\"a\":1"), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "\"\\"), .Err(JsonError.Unterminated));
    assert.equal(json.parse(ctx, "\"\\u12"), .Err(JsonError.Unterminated));
}

test "a member followed by neither a comma nor a brace is unexpected" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "{\"a\":1 2}"), .Err(JsonError.Unexpected(7)));
    assert.equal(json.parse(ctx, "{\"a\" 1}"), .Err(JsonError.Unexpected(5)));
}

test "a pair's second half must be four hexadecimal digits" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "\"\\uD83D\\uZZZZ\""), .Err(JsonError.BadEscape(9)));
    assert.equal(json.parse(ctx, "\"\\r\\t\""), .Ok(Json.Str("\r\t")));
}

test "an exponent needs a digit after its e" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "1e"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1e+"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "[2.5E-]"), .Err(JsonError.BadNumber(1)));
    assert.equal(json.parse(ctx, "0E"), .Err(JsonError.BadNumber(0)));
}

test "an exponent with no digit is a bad number wherever it ends" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.parse(ctx, "-1e"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1E"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "0e+"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "-0E-"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1e-x"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1.5e "), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, " 1e"), .Err(JsonError.BadNumber(1)));
    assert.equal(json.parse(ctx, "[1e,2]"), .Err(JsonError.BadNumber(1)));
    assert.equal(json.parse(ctx, "[0, 1e+ ]"), .Err(JsonError.BadNumber(4)));
    assert.equal(json.parse(ctx, "{\"a\":1E}"), .Err(JsonError.BadNumber(5)));
    assert.equal(
        json.parse(ctx, "{\"a\": -2.0e-, \"b\": 1}"),
        .Err(JsonError.BadNumber(6)),
    );
    assert.equal(
        json.parse(ctx, "123456789012345678901234567890e"),
        .Err(JsonError.BadNumber(0)),
    );
    assert.equal(json.parse(ctx, "1ee5"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1e5e"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1e+-5"), .Err(JsonError.BadNumber(0)));
    assert.equal(json.parse(ctx, "1e5.0"), .Err(JsonError.BadNumber(0)));
    assert.equal(
        json.parse(ctx, "[-1E+0, 2e9]"),
        .Ok(Json.Array([Json.Num(-1.0), Json.Num(2e9)])),
    );
}

test "a carriage return and a tab are written as their escapes" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.stringify(ctx, Json.Str("a\rb\tc")), "\"a\\rb\\tc\"");
}

test "values of different kinds are never equal" {
    assert.isFalse(Json.Null == Json.Bool(false));
    assert.isFalse(Json.Bool(false) == Json.Num(0.0));
    assert.isFalse(Json.Num(0.0) == Json.Str("0"));
    assert.isFalse(Json.Str("") == Json.Array([]));
    assert.isFalse(Json.Array([]) == Json.Object([]));
    assert.isFalse(Json.Object([]) == Json.Null);
}

test "errors of different kinds are never equal, and each shows itself" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isFalse(JsonError.Unexpected(1) == JsonError.Unterminated);
    assert.isFalse(JsonError.Unterminated == JsonError.Trailing(1));
    assert.isFalse(JsonError.Trailing(1) == JsonError.BadNumber(1));
    assert.isFalse(JsonError.BadNumber(1) == JsonError.BadEscape(1));
    assert.isFalse(JsonError.BadEscape(1) == JsonError.TooDeep(1));
    assert.isFalse(JsonError.TooDeep(1) == JsonError.Unexpected(1));
    assert.isTrue(JsonError.TooDeep(1) == JsonError.TooDeep(1));
    assert.isFalse(JsonError.TooDeep(1) == JsonError.TooDeep(2));
    assert.equal(str.format(ctx, "${JsonError.Unterminated}"), ".Unterminated");
    assert.equal(str.format(ctx, "${JsonError.Trailing(2)}"), ".Trailing(2)");
    assert.equal(str.format(ctx, "${JsonError.BadNumber(3)}"), ".BadNumber(3)");
    assert.equal(str.format(ctx, "${JsonError.BadEscape(4)}"), ".BadEscape(4)");
    assert.equal(str.format(ctx, "${JsonError.TooDeep(5)}"), ".TooDeep(5)");
}

test "a number that isn't whole is no Int, and a value that isn't a number is neither" {
    assert.equal(Json.Num(7.0).asInt(), .Some(7));
    assert.equal(Json.Num(7.5).asInt(), .None);
    assert.equal(Json.Num(-0.5).asInt(), .None);
    assert.equal(Json.Num(1e300).asInt(), .None);
    assert.equal(Json.Null.asNumber(), .None);
}

test "decode errors of different kinds are never equal, and each shows itself" {
    let ctx = context {
        Allocator: alloc(),
    };
    let missing = DecodeError.Missing { path: "$.a" };
    let wrong = DecodeError.WrongType { path: "$.a", wanted: "Int", found: "Str" };
    let unknown = DecodeError.UnknownVariant { path: "$.a", tag: "Blue" };
    assert.isFalse(missing == wrong);
    assert.isFalse(wrong == unknown);
    assert.isFalse(unknown == missing);
    assert.isFalse(
        wrong == DecodeError.WrongType { path: "$.b", wanted: "Int", found: "Str" },
    );
    assert.isFalse(
        wrong == DecodeError.WrongType { path: "$.a", wanted: "Bool", found: "Str" },
    );
    assert.isFalse(unknown == DecodeError.UnknownVariant { path: "$.b", tag: "Blue" });
    assert.equal(str.format(ctx, "${missing}"), ".Missing { path: \"$.a\" }");
    assert.equal(
        str.format(ctx, "${wrong}"),
        ".WrongType { path: \"$.a\", wanted: \"Int\", found: \"Str\" }",
    );
    assert.equal(
        str.format(ctx, "${unknown}"),
        ".UnknownVariant { path: \"$.a\", tag: \"Blue\" }",
    );
}
