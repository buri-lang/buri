// What `derive ToJson` writes — asserted on the document, not on a round trip.
//
// `json.stringify` of the encoding is compared against the exact text, because
// the mapping stated in `core/json` is a promise about bytes another program
// reads. A round trip alone is symmetric: it would pass just as happily if
// both halves changed together.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/json" import * as json;
from "core/json" import { Json, ToJson };
from "core/testing/assert" import * as assert;
from "//lib/json" import {
    Chain, chain, Colour, Everything, everything, Hollow, Meters, Pair, Point, point,
    Rose, rose, Segment, Shape, Wrapper,
};

/// The document a value writes.
fn text<T: ToJson, C: Allocator>(ctx: C, value: T): Str {
    json.stringify(ctx, json.encode(ctx, value))
}

// --- the scalars ----------------------------------------------------------------

test "a Bool is a JSON boolean" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, true), "true");
    assert.equal(text(ctx, false), "false");
}

test "an Int is a JSON number" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, 0), "0");
    assert.equal(text(ctx, -17), "-17");
}

test "a Float is a JSON number, and a whole one keeps no point" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, 1.5), "1.5");
    assert.equal(text(ctx, 3.0), "3");
}

test "a Str is a JSON string, escaped" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, "hi"), "\"hi\"");
    assert.equal(text(ctx, "a\"b"), "\"a\\\"b\"");
}

test "a Char is a one-character JSON string" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, 'q'), "\"q\"");
}

test "unit is null" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, ()), "null");
}

/// The five variant tags the runtime walker writes are `core/json`'s own
/// declaration order, and nothing in the language pins them together. This is
/// the seam, so it is asserted directly rather than through `stringify`.
test "the encoder builds the Json this module declares" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(json.encode(ctx, ()), Json.Null);
    assert.equal(json.encode(ctx, true), Json.Bool(true));
    assert.equal(json.encode(ctx, 1), Json.Num(1.0));
    assert.equal(json.encode(ctx, "s"), Json.Str("s"));
    assert.equal(json.encode(ctx, [1]), Json.Array([Json.Num(1.0)]));
    assert.equal(
        json.encode(ctx, point(1, 2)),
        Json.Object([("x", Json.Num(1.0)), ("y", Json.Num(2.0))]),
    );
}

// --- containers -----------------------------------------------------------------

test "a list is an array" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, [1, 2, 3]), "[1,2,3]");
    assert.equal(text(ctx, [point(1, 2)]), "[{\"x\":1,\"y\":2}]");
}

test "an empty list is an empty array" {
    let ctx = context {
        Allocator: alloc(),
    };
    let empty: [Int] = [];
    assert.equal(text(ctx, empty), "[]");
}

test "a tuple is an array, because a tuple is positional" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, (1, "a")), "[1,\"a\"]");
}

test "an Option is its payload, or null" {
    let ctx = context {
        Allocator: alloc(),
    };
    let some: Option<Int> = .Some(4);
    let none: Option<Int> = .None;
    assert.equal(text(ctx, some), "4");
    assert.equal(text(ctx, none), "null");
}

test "JSON has one null, so a nested Option flattens onto it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let inner: Option<Option<Int>> = .Some(.None);
    let outer: Option<Option<Int>> = .None;
    assert.equal(text(ctx, inner), "null");
    assert.equal(text(ctx, outer), "null");
}

// --- structs --------------------------------------------------------------------

test "a struct with named fields is an object, in declaration order" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, point(1, 2)), "{\"x\":1,\"y\":2}");
}

test "a struct nests" {
    let ctx = context {
        Allocator: alloc(),
    };
    let s = Segment {
        start: point(0, 0),
        stop: point(3, 4),
        label: "d",
        waypoints: [point(1, 1)],
    };
    assert.equal(
        text(ctx, s),
        "{\"start\":{\"x\":0,\"y\":0},\"stop\":{\"x\":3,\"y\":4},\"label\":\"d\",\"waypoints\":[{\"x\":1,\"y\":1}]}",
    );
}

test "a struct with positional fields is an array, a one-field one included" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, Meters(5)), "[5]");
    assert.equal(text(ctx, Pair(1, "a")), "[1,\"a\"]");
}

test "a struct with nothing in it is an empty object" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, Hollow { }), "{}");
}

test "one of everything" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        text(ctx, everything()),
        "{\"flag\":true,\"letter\":\"q\",\"ratio\":1.5,\"text\":\"hi\",\"nothing\":null,\"both\":[7,\"z\"],\"present\":{\"x\":1,\"y\":2},\"absent\":null,\"many\":[{\"x\":3,\"y\":4}]}",
    );
}

test "one derive over a generic type writes a document per instantiation" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        text(ctx, Wrapper { value: point(1, 2), tag: "p" }),
        "{\"value\":{\"x\":1,\"y\":2},\"tag\":\"p\"}",
    );
    assert.equal(
        text(ctx, Wrapper { value: [1, 2], tag: "l" }),
        "{\"value\":[1,2],\"tag\":\"l\"}",
    );
}

// --- enums ----------------------------------------------------------------------

test "a variant with no fields is its own name" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, Colour.Red), "\"Red\"");
    assert.equal(text(ctx, Colour.Blue), "\"Blue\"");
    assert.equal(text(ctx, Shape.Empty), "\"Empty\"");
}

test "a variant with positional fields is a one-member object holding an array" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, Shape.Circle(2)), "{\"Circle\":[2]}");
    assert.equal(
        text(ctx, Shape.Line(point(0, 0), point(1, 1))),
        "{\"Line\":[{\"x\":0,\"y\":0},{\"x\":1,\"y\":1}]}",
    );
}

test "a variant with named fields is a one-member object holding an object" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        text(ctx, Shape.Rect { width: 3, height: 4 }),
        "{\"Rect\":{\"width\":3,\"height\":4}}",
    );
}

// --- recursion ------------------------------------------------------------------

test "a type that recurses through a list encodes to the bottom" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, rose(0)), "{\"Leaf\":[0]}");
    assert.equal(text(ctx, rose(1)), "{\"Branch\":[[{\"Leaf\":[1]},{\"Leaf\":[0]}]]}");
}

test "a type that recurses through an Option of a list encodes to the bottom" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(text(ctx, chain(0)), "{\"head\":0,\"rest\":null}");
    assert.equal(
        text(ctx, chain(2)),
        "{\"head\":2,\"rest\":[{\"head\":1,\"rest\":[{\"head\":0,\"rest\":null}]}]}",
    );
}

test "recursion is not a fixed depth" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Deep enough that a walker that unrolled a fixed number of levels, or that
    // built a descriptor per level, would be visible.
    let deep = rose(60);
    assert.isTrue(text(ctx, deep).length() > 1000);
}
