// core/random — `Gen`, the generator that is a value.
//
// Every number here is a literal in the file, which is only possible because
// `Gen` performs nothing: splitmix64 over a seed, the same sequence on every
// backend, in every process, forever. That is the claim, and a file full of
// literals is the only form the claim has.
//
// What is asserted, beyond the sequence: that a draw is a *function* of the
// generator it was given, that the bounded draw has no modulo bias, that
// `split` gives two streams and leaves neither caller holding the other's, and
// that the seed a `Rand` context supplies is assembled the same way on both
// backends.

from "core/bytes" import * as bytes;
from "core/effect" import { Alloc, Rand };
from "core/host/testing" import { alloc, rand };
from "core/random" import * as random;
from "core/random" import { Gen };
from "core/testing/assert" import * as assert;

// --- the sequence ---------------------------------------------------------------

test "a seed replays its own sequence" {
    let (a, one) = random.seeded(7).nextInt(1, 7);
    let (b, two) = one.nextInt(1, 7);
    let (c, three) = two.nextInt(1, 7);
    let (d, four) = three.nextInt(1, 7);
    let (e, _) = four.nextInt(1, 7);
    assert.eq([a, b, c, d, e], [4, 1, 1, 4, 5]);
}

test "a draw is a function of the generator it was handed" {
    let g = random.seeded(7);
    // The point of a generator that is a value: two calls on one `Gen` are two
    // calls on one value, so they answer the same thing. Nothing is hidden and
    // nothing is stepped behind the caller's back.
    assert.eq(g.nextInt(1, 7).0, g.nextInt(1, 7).0);
    assert.eq(g.nextInt(1, 7).1, g.nextInt(1, 7).1);
}

test "a negative seed is an ordinary seed" {
    // The state is the seed's own sixty-four bits, so `-1` is `2^64 - 1` and is
    // as good a starting point as any other.
    let (v, _) = random.seeded(-1).nextInt(0, 100);
    assert.eq(v, 36);
}

test "a float is in the unit interval, and is the same float on both backends" {
    let (f, _) = random.seeded(42).nextFloat();
    assert.isTrue(f >= 0.0);
    assert.isTrue(f < 1.0);
    assert.eq(f, 0.7415648787718233);
}

test "a bool is the top bit of a draw" {
    let g0 = random.seeded(42);
    let (a, g1) = g0.nextBool();
    let (b, g2) = g1.nextBool();
    let (c, g3) = g2.nextBool();
    let (d, _) = g3.nextBool();
    assert.eq([a, b, c, d], [true, false, false, false]);
}

// --- octets ------------------------------------------------------------------------

test "bytes are eight to a draw, least significant first" {
    let ctx = context {
        Alloc: alloc(),
    };
    let (b, _) = random.seeded(1).nextBytes(ctx, 16);
    assert.eq(bytes.toHex(ctx, b), "c15c0289ec2d0a9167ec8e65a18debbe");
}

test "a partial draw takes only the octets that were asked for" {
    let ctx = context {
        Alloc: alloc(),
    };
    let (b, _) = random.seeded(1).nextBytes(ctx, 3);
    // The first three of the sixteen above: a short request is the same draw
    // with the tail dropped, not a different one.
    assert.eq(bytes.toHex(ctx, b), "c15c02");
    assert.eq(random.seeded(1).nextBytes(ctx, 0).0.len(), 0);
    assert.eq(random.seeded(1).nextBytes(ctx, -4).0.len(), 0);
}

// --- the bounded draw --------------------------------------------------------------

test "an empty range answers lo and consumes nothing" {
    let g = random.seeded(7);
    let (v, next) = g.nextInt(5, 5);
    assert.eq(v, 5);
    assert.eq(next, g);
    // Inverted, which is the same emptiness written the other way.
    let (w, after) = g.nextInt(5, 1);
    assert.eq(w, 5);
    assert.eq(after, g);
}

test "a range of one is that one value" {
    let (v, _) = random.seeded(7).nextInt(41, 42);
    assert.eq(v, 41);
}

test "a bounded draw stays inside its range over three thousand of them" {
    let counts = tally(random.seeded(2024), 3000, 0, 0, 0);
    // Every draw landed in `[0, 3)`, which is the first thing a bounded draw
    // owes its caller.
    assert.eq(counts.0 + counts.1 + counts.2, 3000);
    // And the three buckets are within 1.3% of a third each. `2^64 % 3` is 1,
    // so a modulo without the rejection step would bias bucket zero — by far
    // too little to see at this many draws, which is exactly why the exact
    // counts below are pinned as well: they are what changes the moment the
    // rejection step does.
    assert.eq([counts.0, counts.1, counts.2], [961, 1001, 1038]);
}

// --- splitting -----------------------------------------------------------------------

test "split answers a new stream and this one, advanced" {
    let g = random.seeded(99);
    let (child, parent) = g.split();
    assert.eq(child, Gen(4824385676517010403));
    assert.eq(parent, Gen(11400714819323198584));
    // Two streams, drawn independently, and neither is the one `g` would have
    // produced by itself.
    assert.eq(child.nextInt(0, 1000000).0, 32678);
    assert.eq(parent.nextInt(0, 1000000).0, 494564);
}

test "a parent's sequence does not depend on how many children it made" {
    let g = random.seeded(99);
    let (_, parent) = g.split();
    let (_, again) = g.split();
    // `split` is a function like every other method here, so splitting twice
    // from one value gives one answer — which is what makes "hand the child
    // away and keep the parent" a decision with no ordering in it.
    assert.eq(parent, again);
}

// --- the seed a context supplies -------------------------------------------------------

test "a generator seeded from Rand is assembled the same way on both backends" {
    let ctx = context {
        Rand: rand(),
    };
    let g = random.gen(ctx);
    // Four sixteen-bit draws, low half first. The literal is what pins the
    // assembly: a backend that took the draws in the other order, or that lost
    // bits to a wider range, answers a different state here.
    assert.eq(g, Gen(11047233975125876769));
    assert.eq(g.nextInt(0, 1000).0, 96);
}

// --- the effectful door, which is still the other one ---------------------------------

test "core/random's own bytes are the Rand door, not this one" {
    let ctx = context {
        Alloc: alloc(),
        Rand: rand(),
    };
    // One draw per octet through the effect, which is a different sequence from
    // `Gen.nextBytes`'s eight-to-a-draw and is meant to be: the two doors are
    // two generators.
    assert.eq(random.bytes(ctx, 4), [33, 1, 197, 79]);
}

/// Three buckets over `n` draws, tail-recursively, so the loop costs one frame.
fn tally(g: Gen, n: Int, zero: Int, one: Int, two: Int): (Int, Int, Int) {
    if (n <= 0) {
        (zero, one, two)
    } else {
        let (v, next) = g.nextInt(0, 3);
        if (v == 0) {
            tally(next, n - 1, zero + 1, one, two)
        } else if (v == 1) {
            tally(next, n - 1, zero, one + 1, two)
        } else {
            tally(next, n - 1, zero, one, two + 1)
        }
    }
}
