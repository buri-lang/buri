// core/env — the process's environment.
//
// `get` and `args` were the whole module; this is the rest of it. Everything
// runs against `core/host/testing`'s `env()`, which answers `/` for the
// directory and `test` for the platform whatever machine the suite is on —
// `native::e2e` is where the real process answers.

from "core/effect" import { Allocator, Environment };
from "core/env" import * as env;
from "core/host/testing" import { alloc, env as testEnv };
from "core/path" import * as path;
from "core/testing/assert" import * as assert;

test "the current directory is a path" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv(),
    };
    assert.equal(env.currentDirectory(ctx), path.of(ctx, "/"));
}

test "all answers every variable, sorted by name" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([
            ("PATH", "/bin"),
            ("HOME", "/h"),
            ("LANG", "C"),
        ]),
    };
    assert.equal(env.all(ctx), [("HOME", "/h"), ("LANG", "C"), ("PATH", "/bin")]);
}

test "an environment with nothing in it answers nothing" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv(),
    };
    assert.isEmpty(env.all(ctx));
}

test "the last binding of a name is the one all reports" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("K", "one"), ("K", "two")]),
    };
    assert.equal(env.all(ctx), [("K", "two")]);
    assert.equal(assert.some(env.get(ctx, "K")), "two");
}

test "the temporary directory is TMPDIR, or /tmp where nothing set it" {
    let bare = context {
        Allocator: alloc(),
        Environment: testEnv(),
    };
    assert.equal(env.temporaryDirectory(bare), path.of(bare, "/tmp"));
    let set = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("TMPDIR", "/scratch/")]),
    };
    assert.equal(env.temporaryDirectory(set), path.of(set, "/scratch"));
}

test "a variable set to nothing is a variable nothing set" {
    // `TMPDIR=` and `HOME=` are how a scrubbed environment spells "no value",
    // and reading them literally would make the scratch directory the one the
    // process is standing in and the home directory `.`.
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("TMPDIR", ""), ("HOME", "")]),
    };
    assert.equal(env.temporaryDirectory(ctx), path.of(ctx, "/tmp"));
    assert.none(env.homeDirectory(ctx));
    // `get` still answers what is set: the empty value is a value.
    assert.equal(assert.some(env.get(ctx, "HOME")), "");
}

test "a relative TMPDIR is where it says, and a trailing separator is dropped" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("TMPDIR", "scratch//tmp/")]),
    };
    assert.equal(env.temporaryDirectory(ctx), path.of(ctx, "scratch/tmp"));
}

test "the home directory is HOME, or nothing at all" {
    let bare = context {
        Allocator: alloc(),
        Environment: testEnv(),
    };
    assert.none(env.homeDirectory(bare));
    let set = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("HOME", "/home/ada")]),
    };
    assert.equal(assert.some(env.homeDirectory(set)), path.of(set, "/home/ada"));
}

test "the double is not an operating system" {
    let ctx = context {
        Environment: testEnv(),
    };
    assert.equal(env.operatingSystem(ctx), "test");
}

test "a value carries whatever the platform put in it" {
    // A name is a name and a value is octets: an `=`, a newline and a
    // character outside ASCII all survive the round trip through `all`.
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([
            ("EQUALS", "a=b"),
            ("EMPTY", ""),
            ("LINES", "one\ntwo"),
            ("WIDE", "café"),
        ]),
    };
    assert.equal(env.all(ctx), [
        ("EMPTY", ""),
        ("EQUALS", "a=b"),
        ("LINES", "one\ntwo"),
        ("WIDE", "café"),
    ]);
    assert.equal(assert.some(env.get(ctx, "WIDE")), "café");
}

test "a name nothing bound is nothing, however many are bound" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("A", "1"), ("B", "2")]),
    };
    assert.none(env.get(ctx, "C"));
    assert.none(env.get(ctx, ""));
    assert.none(env.get(ctx, "a"));
}

test "no arguments at all is the empty list" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv(),
    };
    assert.isEmpty(env.arguments(ctx));
}

test "an argument is passed through as it was given" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().withArguments(["", "two words", "--flag=café", "-"]),
    };
    assert.equal(env.arguments(ctx), ["", "two words", "--flag=café", "-"]);
}

test "the two builders still compose, and neither touches the rest" {
    let ctx = context {
        Allocator: alloc(),
        Environment: testEnv().variables([("A", "1")]).withArguments(["--verbose"]),
    };
    assert.equal(env.arguments(ctx), ["--verbose"]);
    assert.equal(env.all(ctx), [("A", "1")]);
    assert.equal(env.currentDirectory(ctx), path.of(ctx, "/"));
}
