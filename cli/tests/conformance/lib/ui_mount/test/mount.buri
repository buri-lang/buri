// The one block of the render suite that reaches `ui/node`'s real `mount` — the
// live page mount a browser owns, WEB-only, with no native document to render
// into. The rest of the suite (`lib/ui`'s `tree.buri`) runs on both backends
// through `render`, the test-only renderer that builds the scene document; this
// is split out so that file can, and it keeps `platforms: [JS]` for the mount
// that still cannot cross (#53 phase 6).

from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/prop" import { Prop };
from "ui/signal" import { signal };
from "ui/style" import { Style };
from "ui/testing" import { headless };
from "ui/theme" import { Theme };

let badgeStyle: Style = .Group([
    .PaddingX(.Rem(0.5)),
    .Radius(.Px(6)),
    .Background(.Rgb(240, 240, 245)),
]);

fn badge<C>(title: Prop<Str>, count: Prop<Int>): Node<C> {
    ui.stack({
        styles: [.Layout(.Row), .Group([badgeStyle])],
        children: [
            ui.text({ content: title }),
            ui.text({ content: .Computed(fn(c) => "${count.read(c)}") }),
        ],
    })
}

fn counter<C: Ui>(ctx: C, label: Str): Node<C> {
    let count = signal(ctx, 0);

    ui.stack({
        styles: [.Layout(.Column), .Group([])],
        children: [
            ui.button({
                label: .Const(label),
                styles: [],
                onPress: .Some(fn(c) => count.update(c, fn(n) => n + 1)),
            }),
            badge(.Const(label), .Cell(count)),
            badge(.Const("doubled"), .Computed(fn(c) => count.get(c) * 2)),
        ],
    })
}

test "the counter mounts" {
    let ctx = context {
        Ui: headless(),
    };
    // Nothing can build a `Theme` yet, so the empty list is the only list there
    // is — which is what an app with no design tokens passes in any case.
    let themes: [Theme] = [];
    assert.equal(ui.mount(ctx, counter(ctx, "clicks"), themes), .Ok(()));
}

// The completion-list shape #181 is about: a field, its form's submit button,
// the stack around them and a dialog all carry `onKey`, and each handler answers
// whether it claimed the key. Answering `true` is what suppresses the platform's
// own handling of it in a browser — Tab leaving the field, Enter submitting the
// form, an arrow moving the caret, Escape shutting the dialog — so a completion
// list can drive those keys. The consume itself is a `preventDefault` a browser
// makes and a headless document has no pointer or keyboard to see; what a mount
// can show is that the four constructors take the one consistent handler shape
// and build.
fn completion<C: Ui>(ctx: C): Node<C> {
    let name = signal(ctx, "");
    let open = signal(ctx, false);
    ui.stack({
        styles: [],
        onKey: .Some(fn(_c, _key) => false),
        children: [
            ui.form({
                onSubmit: fn(_c) => (),
                styles: [],
                children: [
                    ui.field({
                        label: .Const("Name"),
                        kind: .Text,
                        value: name,
                        styles: [],
                        onKey: .Some(fn(_c, key) => {
                            key == "Enter"
                                || key == "Tab"
                                || key == "ArrowDown"
                                || key == "ArrowUp"
                        }),
                    }),
                    ui.button({
                        label: .Const("Send"),
                        styles: [],
                        kind: .Some(.Submit),
                        onKey: .Some(fn(_c, _key) => false),
                    }),
                ],
            }),
            ui.dialog({
                isOpen: open,
                label: .Const("Help"),
                children: [],
                styles: [],
                onKey: .Some(fn(_c, key) => key == "Escape"),
            }),
        ],
    })
}

test "a completion field, its submit, the stack and a dialog all carry a consuming onKey" {
    let ctx = context {
        Ui: headless(),
    };
    let themes: [Theme] = [];
    assert.equal(ui.mount(ctx, completion(ctx), themes), .Ok(()));
}
