// `core/actor` — the note's counter, and the rest of the module's surface.
//
// Every assertion here is a literal written into the file, so the two backends
// either both pass it or disagree about the language.
// `cli/tests/native/conformance.rs` runs this same file through the
// copy-and-patch backend, and `cli/tests/native/agreement.rs`'s
// `an_actor_counts_the_same_on_every_backend` runs the same shape through the
// optimizing one.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Address, Reply };
from "core/effect" import { Alloc, Stdout, Tasks };
from "core/host/testing" import { alloc, stdout, tasks };
from "core/io" import * as io;
from "core/testing/assert" import * as assert;

enum CounterMessage {
    Increment,
    Add(Int),
    Get(Reply<Int>),
}

/// The note's counter, with `Add` beside `Increment` so that ordering is
/// visible in the answer rather than only in the count.
fn counter<C: Alloc + Tasks>(initial: Int): Actor<C, Int, CounterMessage> {
    Actor {
        state: initial,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => count + 1,
                .Add(n) => count * 10 + n,
                .Get(reply) => {
                    let _ = reply.answer(c, count).ignore();
                    count
                },
            }
        },
    }
}

test "the note's counter answers two increments" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.send(ctx, .Increment).ignore();
    let _ = counted.send(ctx, .Increment).ignore();
    assert.eq(counted.ask(ctx, fn(reply) => .Get(reply)), .Ok(2));
    let _ = counted.stop(ctx).ignore();
}

test "one sender's messages arrive in the order it sent them" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.send(ctx, .Add(1)).ignore();
    let _ = counted.send(ctx, .Add(2)).ignore();
    let _ = counted.send(ctx, .Add(3)).ignore();
    // `count * 10 + n` is order-sensitive on purpose: 123 and not 321.
    assert.eq(counted.ask(ctx, fn(reply) => .Get(reply)), .Ok(123));
    let _ = counted.stop(ctx).ignore();
}

test "a mailbox at its bound is run down rather than grown" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    // Sixty-five posts into a mailbox that holds sixty-four. Nobody asked and
    // nobody stopped, so the only thing that could have stepped the actor is
    // the `send` that found the queue at its bound — and it stepped every
    // message waiting, which is why the answer is the whole sixty-five and not
    // some prefix of them.
    let counted = actor.start(ctx, counter(0));
    increments(ctx, counted, 65);
    assert.eq(counted.ask(ctx, fn(reply) => .Get(reply)), .Ok(65));
    let _ = counted.stop(ctx).ignore();
}

test "the drain happens at the bound and not at the stop" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    // `stop` discards what is still waiting, so what `onStop` prints is exactly
    // what the mailbox had already run down. Sixty-five posts leave one behind:
    // the sixty-fourth found the queue full and stepped all sixty-four, and the
    // sixty-fifth is still sitting there when the stop throws it away.
    let counted = actor.start(ctx, logged());
    increments(ctx, counted, 65);
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 64\n");
}

/// Posts `n` increments, one `send` at a time.
fn increments<C: Alloc + Tasks>(
    ctx: C,
    counted: Address<C, Int, CounterMessage>,
    n: Int,
): () {
    match (n <= 0) {
        true => (),
        false => {
            let _ = counted.send(ctx, .Increment).ignore();
            increments(ctx, counted, n - 1)
        },
    }
}

test "a send after a stop is .Err(.Stopped)" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.send(ctx, .Increment).ignore();
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(counted.send(ctx, .Increment), .Err(.Stopped));
    assert.eq(counted.ask(ctx, fn(reply) => .Get(reply)), .Err(.Stopped));
    // And a second `stop` is refused, which is what makes `onStop` run once
    // without the caller having to remember.
    assert.eq(counted.stop(ctx), .Err(.Stopped));
}

test "onStop runs once, with the final state" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, logged());
    let _ = counted.send(ctx, .Add(4)).ignore();
    let _ = counted.send(ctx, .Add(5)).ignore();
    // The `ask` is what runs the two posts down, so the state the hook is
    // handed is theirs. Nothing has been printed yet either way: the hook runs
    // at the stop and not before.
    assert.eq(counted.ask(ctx, fn(reply) => .Get(reply)), .Ok(45));
    assert.eq(sink.captured(), "");
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 45\n");
    // Twice would print twice.
    assert.eq(counted.stop(ctx), .Err(.Stopped));
    assert.eq(sink.captured(), "final 45\n");
}

/// The same counter with a hook that prints the state it ends on.
fn logged<C: Alloc + Stdout + Tasks>(): Actor<C, Int, CounterMessage> {
    Actor {
        state: 0,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => count + 1,
                .Add(n) => count * 10 + n,
                .Get(reply) => {
                    let _ = reply.answer(c, count).ignore();
                    count
                },
            }
        },
        onStop: .Some(fn(c, last) => io.println(c, "final ${last}").ignore()),
    }
}

test "a message that discards its reply leaves the ask stopped" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    // A step that never answers: `ask` has nothing to read, and says so
    // rather than waiting for an answer nobody is going to give.
    let silent = actor.start(ctx, mute());
    assert.eq(silent.ask(ctx, fn(reply) => .Get(reply)), .Err(.Stopped));
    let _ = silent.stop(ctx).ignore();
}

fn mute<C: Alloc + Tasks>(): Actor<C, Int, CounterMessage> {
    Actor { state: 0, step: fn(c, count, message) => count }
}

test "testing an actor is calling its step" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    // No mailbox, no address, no runtime: the step is an ordinary function in
    // an ordinary field, which is why this module ships no test double.
    let step = counter(0).step;
    assert.eq(step(ctx, 7, .Increment), 8);
    assert.eq(step(ctx, 7, .Add(2)), 72);
}

// **An interim, and the file's one case that is.** What `core/actor` promises
// is the first half of the assertion below: `stop` closes the mailbox and
// *discards what is still in it*, so `onStop` sees the state the discarded
// messages never reached. What makes three sends leave three messages still in
// it is a **scheduling** answer and not a semantic one — `send` posts and
// returns, and runs the mailbox down only where the post found it at the bound
// (`actor.buri`'s "When the actor runs"). On the day an actor gets a task of
// its own — `design/native/DECISIONS.md`'s `core/actor` row, "`send` is the
// spelling again" — a stop may find the mailbox already stepped, and the
// number below becomes `123` or anything between. It is that arm, and nothing
// else, that is entitled to change this line; a driver that quietly stopped
// discarding would still have to fail here first.
test "today's driver leaves three sends for `stop` to discard" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, logged());
    // Three posts into a mailbox nothing has run down, then a stop: the note
    // says the rest are discarded, so the final state is the one they never
    // reached.
    let _ = counted.send(ctx, .Add(1)).ignore();
    let _ = counted.send(ctx, .Add(2)).ignore();
    let _ = counted.send(ctx, .Add(3)).ignore();
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 0\n");
}
