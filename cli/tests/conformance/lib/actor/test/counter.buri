// `core/actor` — the note's counter, and the rest of the module's surface.
//
// Every assertion here is a literal written into the file, so the two backends
// either both pass it or disagree about the language.
// `cli/tests/native/conformance.rs` runs this same file through the
// copy-and-patch backend, and `cli/tests/native/agreement.rs`'s
// `an_actor_counts_the_same_on_every_backend` runs the same shape through the
// optimizing one.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Address, Stepped };
from "core/effect" import { Alloc, Stdout, Tasks };
from "core/host/testing" import { alloc, stdout, tasks };
from "core/io" import * as io;
from "core/testing/assert" import * as assert;

enum CounterMessage {
    Increment,
    Add(Int),
    Get,
}

derive Eq, Show for CounterAnswer;
enum CounterAnswer {
    Done,
    Count(Int),
}

/// The note's counter, with `Add` beside `Increment` so that ordering is
/// visible in the answer rather than only in the count.
fn counter<C: Alloc + Tasks>(
    initial: Int,
): Actor<C, Int, CounterMessage, CounterAnswer> {
    Actor {
        state: initial,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => Stepped { state: count + 1, answer: .Done },
                .Add(n) => Stepped { state: count * 10 + n, answer: .Done },
                .Get => Stepped { state: count, answer: .Count(count) },
            }
        },
    }
}

test "the note's counter answers two increments" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(2)));
    let _ = counted.stop(ctx).ignore();
}

test "one sender's messages arrive in the order it sent them" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Add(1)).ignore();
    let _ = counted.sendMessage(ctx, .Add(2)).ignore();
    let _ = counted.sendMessage(ctx, .Add(3)).ignore();
    // `count * 10 + n` is order-sensitive on purpose: 123 and not 321.
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(123)));
    let _ = counted.stop(ctx).ignore();
}

test "more messages than the mailbox holds still all arrive" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    // Sixty-five posts into a mailbox that holds sixty-four. Each one runs the
    // box down before it answers, so the bound is never reached and the answer
    // is the whole sixty-five rather than some prefix of them.
    let counted = actor.start(ctx, counter(0));
    increments(ctx, counted, 65);
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(65)));
    let _ = counted.stop(ctx).ignore();
}

test "every message is stepped before the stop, so the stop discards none" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    // `stop` discards what is still waiting, and after sixty-five sends there
    // is nothing waiting: what `onStop` prints is every message.
    let counted = actor.start(ctx, logged());
    increments(ctx, counted, 65);
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 65\n");
}

/// Posts `n` increments, one `sendMessage` at a time.
fn increments<C: Alloc + Tasks>(
    ctx: C,
    counted: Address<C, Int, CounterMessage, CounterAnswer>,
    n: Int,
): () {
    match (n <= 0) {
        true => (),
        false => {
            let _ = counted.sendMessage(ctx, .Increment).ignore();
            increments(ctx, counted, n - 1)
        },
    }
}

test "a send after a stop is .Err(.Stopped)" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(counted.sendMessage(ctx, .Increment), .Err(.Stopped));
    assert.eq(counted.sendMessage(ctx, .Get), .Err(.Stopped));
    // And a second `stop` is refused, which is what makes `onStop` run once
    // without the caller having to remember.
    assert.eq(counted.stop(ctx), .Err(.Stopped));
}

test "onStop runs once, with the final state" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, logged());
    let _ = counted.sendMessage(ctx, .Add(4)).ignore();
    let _ = counted.sendMessage(ctx, .Add(5)).ignore();
    // Nothing has been printed yet: the hook runs at the stop and not before.
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(45)));
    assert.eq(sink.captured(), "");
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 45\n");
    // Twice would print twice.
    assert.eq(counted.stop(ctx), .Err(.Stopped));
    assert.eq(sink.captured(), "final 45\n");
}

/// The same counter with a hook that prints the state it ends on.
fn logged<C: Alloc + Stdout + Tasks>(): Actor<C, Int, CounterMessage, CounterAnswer> {
    Actor {
        state: 0,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => Stepped { state: count + 1, answer: .Done },
                .Add(n) => Stepped { state: count * 10 + n, answer: .Done },
                .Get => Stepped { state: count, answer: .Count(count) },
            }
        },
        onStop: .Some(fn(c, last) => io.println(c, "final ${last}").ignore()),
    }
}

test "testing an actor is calling its step" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    // No mailbox, no address, no runtime: the step is an ordinary function in
    // an ordinary field, which is why this module ships no test double.
    let step = counter(0).step;
    assert.eq(step(ctx, 7, .Increment), Stepped { state: 8, answer: .Done });
    assert.eq(step(ctx, 7, .Add(2)), Stepped { state: 72, answer: .Done });
    assert.eq(step(ctx, 7, .Get), Stepped { state: 7, answer: .Count(7) });
}

test "the same step, through the actor" {
    let ctx = context {
        Alloc: alloc(),
        Tasks: tasks(),
    };
    // The block above and this one are the same three answers, once by calling
    // the step and once by posting to it.
    let counted = actor.start(ctx, counter(7));
    assert.eq(counted.sendMessage(ctx, .Increment), .Ok(.Done));
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(8)));
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(counted.sendMessage(ctx, .Get), .Err(.Stopped));
}

// **The file's one case that was pinned as an interim, and it has moved.** It
// used to read "today's driver leaves three sends for `stop` to discard": three
// posts below the bound, nothing that asked, and an `onStop` that saw the state
// the discarded messages never reached. `send` is gone and `sendMessage` runs
// the mailbox down before it answers, so there is nothing left to discard and
// the hook sees all three. What `core/actor` promises either way is the same
// sentence — `stop` discards what is *still* in the mailbox — and the number
// below is what today's driver leaves in it.
test "a stop discards nothing, because every send already ran" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, logged());
    let _ = counted.sendMessage(ctx, .Add(1)).ignore();
    let _ = counted.sendMessage(ctx, .Add(2)).ignore();
    let _ = counted.sendMessage(ctx, .Add(3)).ignore();
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 123\n");
}
