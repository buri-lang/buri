// `core/actor` — the note's counter, and the rest of the module's surface.
//
// Every assertion here is a literal written into the file, so the two backends
// either both pass it or disagree about the language.
// `cli/tests/native/conformance.rs` runs this same file through the
// copy-and-patch backend, and `cli/tests/native/agreement.rs`'s
// `an_actor_counts_the_same_on_every_backend` runs the same shape through the
// optimizing one.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Address, Stepped };
from "core/effect" import { Allocator, Stdout, Tasks };
from "core/host/testing" import { alloc, stdout, tasks };
from "core/io" import * as io;
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

enum CounterMessage {
    Increment,
    Add(Int),
    Get,
}

derive Equal, Show for CounterAnswer;
enum CounterAnswer {
    Done,
    Count(Int),
}

/// The note's counter, with `Add` beside `Increment` so that ordering is
/// visible in the answer rather than only in the count.
fn counter<C: Allocator + Tasks>(
    initial: Int,
): Actor<C, Int, CounterMessage, CounterAnswer> {
    Actor {
        state: initial,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => Stepped { state: count + 1, answer: .Done },
                .Add(n) => Stepped { state: count * 10 + n, answer: .Done },
                .Get => Stepped { state: count, answer: .Count(count) },
            }
        },
    }
}

test "the note's counter answers two increments" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(2)));
    let _ = counted.stop(ctx).ignore();
}

test "one sender's messages arrive in the order it sent them" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Add(1)).ignore();
    let _ = counted.sendMessage(ctx, .Add(2)).ignore();
    let _ = counted.sendMessage(ctx, .Add(3)).ignore();
    // `count * 10 + n` is order-sensitive on purpose: 123 and not 321.
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(123)));
    let _ = counted.stop(ctx).ignore();
}

test "more messages than the mailbox holds still all arrive" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // Sixty-five posts into a mailbox that holds sixty-four. Each one runs the
    // box down before it answers, so the bound is never reached and the answer
    // is the whole sixty-five rather than some prefix of them.
    let counted = actor.start(ctx, counter(0));
    increments(ctx, counted, 65);
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(65)));
    let _ = counted.stop(ctx).ignore();
}

test "every message is stepped before the stop, so the stop discards none" {
    let sink = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    // `stop` discards what is still waiting, and after sixty-five sends there
    // is nothing waiting: what `onStop` prints is every message.
    let counted = actor.start(ctx, logged());
    increments(ctx, counted, 65);
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(sink.captured(), "final 65\n");
}

/// Posts `n` increments, one `sendMessage` at a time.
fn increments<C: Allocator + Tasks>(
    ctx: C,
    counted: Address<C, Int, CounterMessage, CounterAnswer>,
    n: Int,
): () {
    match (n <= 0) {
        true => (),
        false => {
            let _ = counted.sendMessage(ctx, .Increment).ignore();
            increments(ctx, counted, n - 1)
        },
    }
}

test "a send after a stop is .Err(.Stopped)" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(counted.sendMessage(ctx, .Increment), .Err(.Stopped));
    assert.equal(counted.sendMessage(ctx, .Get), .Err(.Stopped));
    // And a second `stop` is refused, which is what makes `onStop` run once
    // without the caller having to remember.
    assert.equal(counted.stop(ctx), .Err(.Stopped));
}

test "onStop runs once, with the final state" {
    let sink = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, logged());
    let _ = counted.sendMessage(ctx, .Add(4)).ignore();
    let _ = counted.sendMessage(ctx, .Add(5)).ignore();
    // Nothing has been printed yet: the hook runs at the stop and not before.
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(45)));
    assert.equal(sink.captured(), "");
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(sink.captured(), "final 45\n");
    // Twice would print twice.
    assert.equal(counted.stop(ctx), .Err(.Stopped));
    assert.equal(sink.captured(), "final 45\n");
}

/// The same counter with a hook that prints the state it ends on.
fn logged<C: Allocator + Stdout + Tasks>(): Actor<C, Int, CounterMessage, CounterAnswer> {
    Actor {
        state: 0,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => Stepped { state: count + 1, answer: .Done },
                .Add(n) => Stepped { state: count * 10 + n, answer: .Done },
                .Get => Stepped { state: count, answer: .Count(count) },
            }
        },
        onStop: .Some(fn(c, last) => io.println(c, "final ${last}").ignore()),
    }
}

test "testing an actor is calling its step" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // No mailbox, no address, no runtime: the step is an ordinary function in
    // an ordinary field, which is why this module ships no test double.
    let step = counter(0).step;
    assert.equal(step(ctx, 7, .Increment), Stepped { state: 8, answer: .Done });
    assert.equal(step(ctx, 7, .Add(2)), Stepped { state: 72, answer: .Done });
    assert.equal(step(ctx, 7, .Get), Stepped { state: 7, answer: .Count(7) });
}

test "the same step, through the actor" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // The block above and this one are the same three answers, once by calling
    // the step and once by posting to it.
    let counted = actor.start(ctx, counter(7));
    assert.equal(counted.sendMessage(ctx, .Increment), .Ok(.Done));
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(8)));
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(counted.sendMessage(ctx, .Get), .Err(.Stopped));
}

// **The file's one case that was pinned as an interim, and it has moved.** It
// used to read "today's driver leaves three sends for `stop` to discard": three
// posts below the bound, nothing that asked, and an `onStop` that saw the state
// the discarded messages never reached. `send` is gone and `sendMessage` runs
// the mailbox down before it answers, so there is nothing left to discard and
// the hook sees all three. What `core/actor` promises either way is the same
// sentence — `stop` discards what is *still* in the mailbox — and the number
// below is what today's driver leaves in it.
test "a stop discards nothing, because every send already ran" {
    let sink = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, logged());
    let _ = counted.sendMessage(ctx, .Add(1)).ignore();
    let _ = counted.sendMessage(ctx, .Add(2)).ignore();
    let _ = counted.sendMessage(ctx, .Add(3)).ignore();
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(sink.captured(), "final 123\n");
}

// -----------------------------------------------------------------------------
// A step that sends to the actor that is running it
// -----------------------------------------------------------------------------
//
// The two types below are how a program reaches that at all. A step cannot name
// its own address — the address is what `start` answers, and a state or a
// message that held one would be a type defined in terms of itself. So the
// *message* carries a function instead, built where the address already is, and
// the step calls it. `fn(C) => Int` names no actor, so nothing here is
// recursive.

enum Reentrant<C> {
    /// Call this, and answer what it said.
    Reenter(fn(C) => Int),
    Tick,
    Get,
}

derive Equal, Show for Reentered;
enum Reentered {
    Ticked,
    Reentered(Int),
    Count(Int),
}

fn reentrant<C: Allocator + Tasks>(): Actor<C, Int, Reentrant<C>, Reentered> {
    Actor {
        state: 0,
        step: fn(c, count, message) => {
            match (message) {
                .Reenter(f) => {
                    let call = f;
                    Stepped { state: count, answer: .Reentered(call(c)) }
                },
                .Tick => Stepped { state: count + 1, answer: .Ticked },
                .Get => Stepped { state: count, answer: .Count(count) },
            }
        },
    }
}

test "a step that sends to its own actor is refused, and the message still arrives" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, reentrant());
    // The step holds the state while it runs, so the send below posts its
    // message and then finds nothing to step it with. Taking the state stays
    // non-blocking, so the answer is `.Err(.Stopped)` rather than a deadlock.
    let refused = counted.sendMessage(
        ctx,
        .Reenter(fn(c) => {
            match (counted.sendMessage(c, .Tick)) {
                .Ok(_answered) => 1,
                .Err(_gone) => 0,
            }
        }),
    );
    assert.equal(refused, .Ok(.Reentered(0)));
    // Refused is not lost. The `.Tick` is in the mailbox, and the loop that was
    // already running steps it — once — before it puts the state back.
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(1)));
    assert.equal(counted.stop(ctx), .Ok(()));
}

test "a step fills the mailbox to its bound, and every message still arrives" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // Sixty-four posts with nothing draining between them, which is the only
    // way a program reaches the bound: every other send runs the mailbox down
    // before it answers. Sixty-four is what fits, and all sixty-four are
    // stepped when the step that posted them returns.
    let filled = actor.start(ctx, reentrant());
    let fanned = filled.sendMessage(ctx, .Reenter(fn(c) => ticks(c, filled, 64)));
    assert.equal(fanned, .Ok(.Reentered(0)));
    assert.equal(filled.sendMessage(ctx, .Get), .Ok(.Count(64)));
    assert.equal(filled.stop(ctx), .Ok(()));
}

/// Posts `left` ticks and answers how many of them were stepped on the spot,
/// which is none of them: the caller is the step that holds the state.
fn ticks<C: Allocator + Tasks>(
    ctx: C,
    address: Address<C, Int, Reentrant<C>, Reentered>,
    left: Int,
): Int {
    match (left <= 0) {
        true => 0,
        false => {
            let stepped = match (address.sendMessage(ctx, .Tick)) {
                .Ok(_answered) => 1,
                .Err(_gone) => 0,
            };
            stepped + ticks(ctx, address, left - 1)
        },
    }
}

// -----------------------------------------------------------------------------
// The slot an answer nobody waited for goes into
// -----------------------------------------------------------------------------
//
// `sendMessage` opens a reply slot per message and takes it once, whatever
// happened: the actor was gone before the post, or the caller is a step of this
// same actor and the drive found nothing to step with. Both leave a slot with
// no answer in it, and **a take spends such a slot** — it goes back on the free
// list and its generation moves, so the answer the loop writes afterwards lands
// nowhere rather than in whoever holds the index by then.
//
// A slot that stayed open instead is two failures at once. It sits in the
// runtime's table for the life of the process, and the answer a step writes
// into it is a *block* nobody ever takes out — which is why every answer below
// carries a string or a list this program grew rather than an `Int`.
// `native::conformance` runs these blocks under `BURI_RT_HEAP_CHECK`, and that
// is where an answer left in an abandoned slot is read back as a block nobody
// gave back.

derive Equal, Show for Carrying;
enum Carrying {
    Said(Str),
    Listed([Int]),
    Total(Int),
}

enum Ask<C> {
    /// Call this, and fold what it said into the state.
    Reenter(fn(C) => Int),
    /// Answer with a string this program built.
    Say(Str),
    /// Answer with a list this program built.
    List(Int),
    Count,
}

/// A string this program grew, rather than one the compiler interned: a
/// constant lives in the artifact's pool and is never a block anybody has to
/// give back.
fn grown<C: Allocator>(ctx: C, s: Str): Str {
    s.concat(ctx, "")
}

/// An actor whose every answer carries a block.
fn carrier<C: Allocator + Tasks>(): Actor<C, Int, Ask<C>, Carrying> {
    Actor {
        state: 0,
        step: fn(c, seen, message) => {
            match (message) {
                .Reenter(f) => {
                    let call = f;
                    Stepped { state: seen + call(c), answer: .Total(seen) }
                },
                .Say(word) => {
                    Stepped { state: seen + 1, answer: .Said(word.concat(c, "!")) }
                },
                .List(n) => {
                    Stepped { state: seen + 1, answer: .Listed(list.range(c, 0, n)) }
                },
                .Count => Stepped { state: seen, answer: .Total(seen) },
            }
        },
    }
}

/// Posts `left` messages that answer with a string, and counts how many were
/// answered on the spot.
fn saying<C: Allocator + Tasks>(
    ctx: C,
    address: Address<C, Int, Ask<C>, Carrying>,
    left: Int,
): Int {
    match (left <= 0) {
        true => 0,
        false => {
            let answered = match (address.sendMessage(ctx, .Say(grown(ctx, "late")))) {
                .Ok(_said) => 1,
                .Err(_gone) => 0,
            };
            answered + saying(ctx, address, left - 1)
        },
    }
}

test "an answer written into a slot its sender gave up on is given back" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, carrier());
    let refused = counted.sendMessage(
        ctx,
        .Reenter(fn(c) => {
            match (counted.sendMessage(c, .Say(grown(c, "late")))) {
                .Ok(_said) => 1,
                .Err(_gone) => 0,
            }
        }),
    );
    // The send from inside the step is refused, so its slot is taken with
    // nothing in it.
    assert.equal(refused, .Ok(.Total(0)));
    // The message is not lost: the loop already running steps it, and the
    // string it answers with goes into a slot nobody is holding.
    assert.equal(counted.sendMessage(ctx, .Count), .Ok(.Total(1)));
    assert.equal(counted.stop(ctx), .Ok(()));
}

test "an answer that is a list, written into a slot its sender gave up on, is given back" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, carrier());
    let refused = counted.sendMessage(
        ctx,
        .Reenter(fn(c) => {
            match (counted.sendMessage(c, .List(4))) {
                .Ok(_listed) => 1,
                .Err(_gone) => 0,
            }
        }),
    );
    assert.equal(refused, .Ok(.Total(0)));
    assert.equal(counted.sendMessage(ctx, .Count), .Ok(.Total(1)));
    assert.equal(counted.stop(ctx), .Ok(()));
}

test "every slot a step's sends gave up on comes back, twenty in a row" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // Twenty slots opened and abandoned inside one step, then twenty answers
    // written into them afterwards. A slot that did not come back is twenty
    // table entries and twenty strings; the index each one is given back at is
    // taken by the next send, which is what makes the generation the thing
    // that keeps the late answers apart.
    let counted = actor.start(ctx, carrier());
    assert.equal(
        counted.sendMessage(ctx, .Reenter(fn(c) => saying(c, counted, 20))),
        .Ok(.Total(0)),
    );
    assert.equal(counted.sendMessage(ctx, .Count), .Ok(.Total(20)));
    assert.equal(counted.stop(ctx), .Ok(()));
}

test "an ordinary send after twenty abandoned ones gets its own answer" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // The reused index is the point. Every abandoned slot goes back on the
    // free list, so the send below opens an index one of them was named by —
    // and it has to come back with the answer to *this* message.
    let counted = actor.start(ctx, carrier());
    assert.equal(
        counted.sendMessage(ctx, .Reenter(fn(c) => saying(c, counted, 20))),
        .Ok(.Total(0)),
    );
    assert.equal(counted.sendMessage(ctx, .Say(grown(ctx, "mine"))), .Ok(.Said("mine!")));
    assert.equal(counted.sendMessage(ctx, .Count), .Ok(.Total(21)));
    assert.equal(counted.stop(ctx), .Ok(()));
}

/// Posts `left` messages into a mailbox that is closed, and counts the
/// refusals.
fn refused<C: Allocator + Tasks>(
    ctx: C,
    address: Address<C, Int, Ask<C>, Carrying>,
    left: Int,
): Int {
    match (left <= 0) {
        true => 0,
        false => {
            let gone = match (address.sendMessage(ctx, .Say(grown(ctx, "gone")))) {
                .Ok(_said) => 0,
                .Err(_stopped) => 1,
            };
            gone + refused(ctx, address, left - 1)
        },
    }
}

test "a slot opened for a message a closed mailbox refused comes back" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // The other arm that abandons a slot, and the one a program reaches by
    // accident: twenty sends to an actor that is already gone. Each opens a
    // slot, is refused before it is posted, and takes the slot back — and the
    // message it built is the caller's to release, because a closed mailbox
    // does not take the block.
    let counted = actor.start(ctx, carrier());
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(refused(ctx, counted, 20), 20);
    // And again, after twenty errors: nothing about the sequence is spent.
    assert.equal(refused(ctx, counted, 20), 20);
    assert.equal(counted.stop(ctx), .Err(.Stopped));
}
