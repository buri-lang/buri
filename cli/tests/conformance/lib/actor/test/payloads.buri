// `core/actor` — what a message, a state and an answer may be, and what an
// actor may do with another actor.
//
// `counter.buri` next door drives the protocol with `Int` states and `Int`
// answers, which is the one shape where nothing about the crossing is
// interesting: an `Int` fits in the word the block already had. This file is
// the rest of the type surface. Every value below goes into the runtime and
// comes back out — four crossings per send — so a value the runtime handed back
// at the wrong shape is a wrong *answer* here rather than a leak somewhere
// else.
//
// The unit block is the sharpest of them. `Carried`'s `pad` exists because a
// `[T]` whose element occupies no bytes has no block at all, and the only way
// to reach that is an actor whose state or whose answer is `()`. Nothing else
// in the corpus writes one.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Address, SendError, Stepped, Stopped };
from "core/alloc" import * as alloc;
from "core/io" import * as io;
from "core/tasks" import * as tasks;
from "core/tasks" import { Scope };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Stdout, Tasks };
from "platform/effect/testing" import { alloc, stdout, tasks };
from "//lib/variants" import * as variants;

// -----------------------------------------------------------------------------
// Nothing at all: `S` and `R` are both `()`
// -----------------------------------------------------------------------------

enum Ping<C> {
    Ping,
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

/// An actor with nothing to remember and nothing to say.
///
/// Both the state and the answer occupy no bytes, so both cross as a block
/// whose element is only `Carried`'s own word. The hook is handed a state of
/// `()` and has nothing to say about it, so what it prints is that it ran —
/// which is the only way a unit state is visible at all.
fn silent<C: Allocator + Stdout + Tasks>(): Actor<C, (), Ping<C>, ()> {
    Actor {
        state: (),
        step: fn(c, held, message) => {
            match (message) {
                .Ping => Stepped { state: (), answer: () },
                .Within(f) => {
                    let call = f;
                    Stepped { state: call(c), answer: () }
                },
            }
        },
        onStop: .Some(fn(c, last) => io.println(c, "quiet").ignore()),
    }
}

test "an actor whose state and answer are both unit answers every message" {
    let sink = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let quiet = actor.start(ctx, silent());
    assert.equal(quiet.sendMessage(ctx, .Ping), .Ok(()));
    assert.equal(quiet.sendMessage(ctx, .Ping), .Ok(()));
    assert.equal(sink.captured(), "");
    // The hook is handed the final state, and the final state is `()`.
    assert.equal(quiet.stop(ctx), .Ok(()));
    assert.equal(sink.captured(), "quiet\n");
    assert.equal(quiet.sendMessage(ctx, .Ping), .Err(.Stopped));
    assert.equal(quiet.stop(ctx), .Err(.Stopped));
}

// -----------------------------------------------------------------------------
// A list, a string nobody can spell in ASCII, and a struct inside a struct
// -----------------------------------------------------------------------------

enum Bag<C> {
    /// Replaces the whole state with a list the sender built.
    Fill([Int]),
    /// Appends one, so the state the runtime handed back is the one the next
    /// message reads.
    Push(Int),
    Drain,
    /// Answers the state and keeps it.
    Look,
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

derive Equal, Show for Bagged;
enum Bagged {
    Kept(Int),
    Held([Int]),
}

fn bag<C: Allocator + Tasks>(): Actor<C, [Int], Bag<C>, Bagged> {
    bagOf([])
}

fn bagOf<C: Allocator + Tasks>(initial: [Int]): Actor<C, [Int], Bag<C>, Bagged> {
    Actor {
        state: initial,
        step: fn(c, held, message) => {
            match (message) {
                .Fill(next) => Stepped { state: next, answer: .Kept(next.length()) },
                .Push(n) => {
                    let grown = held.push(c, n);
                    Stepped { state: grown, answer: .Kept(grown.length()) }
                },
                .Drain => Stepped { state: [], answer: .Held(held) },
                .Look => Stepped { state: held, answer: .Held(held) },
                .Within(f) => {
                    let call = f;
                    let _ = call(c);
                    Stepped { state: held, answer: .Kept(held.length()) }
                },
            }
        },
    }
}

test "a message, a state and an answer may each be a list" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let held = actor.start(ctx, bag());
    assert.equal(held.sendMessage(ctx, .Fill([1, 2, 3])), .Ok(.Kept(3)));
    assert.equal(held.sendMessage(ctx, .Push(4)), .Ok(.Kept(4)));
    assert.equal(held.sendMessage(ctx, .Push(5)), .Ok(.Kept(5)));
    // The list that comes back out is the one five messages built, in order.
    assert.equal(held.sendMessage(ctx, .Drain), .Ok(.Held([1, 2, 3, 4, 5])));
    // And the state the drain left behind is the empty list, which is the one
    // shape of `[T]` a program can hand over that has no block under it.
    assert.equal(held.sendMessage(ctx, .Drain), .Ok(.Held([])));
    assert.equal(held.stop(ctx), .Ok(()));
    // Stopped is final: a second stop and a later send are both refused.
    assert.equal(held.stop(ctx), .Err(.Stopped));
    assert.equal(assert.err(held.sendMessage(ctx, .Drain)), SendError.Stopped);
}

// The actor holds what it was started with and what it was sent, and the
// sender holds it too, so a list grown through either name is a new list.

test "a list an actor was started with or sent is not grown through the sender's name" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let first = [1].concat(ctx, [2]);
    let held = actor.start(ctx, bagOf(first));
    assert.equal(first.push(ctx, 3), [1, 2, 3]);
    assert.equal(held.sendMessage(ctx, .Look), .Ok(.Held([1, 2])));
    let second = [4].concat(ctx, [5]);
    assert.equal(held.sendMessage(ctx, .Fill(second)), .Ok(.Kept(2)));
    assert.equal(second.reverse(ctx), [5, 4]);
    assert.equal(held.sendMessage(ctx, .Look), .Ok(.Held([4, 5])));
    assert.equal(held.stop(ctx), .Ok(()));
}

test "an answer that is the actor's state is grown through neither" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let held = actor.start(ctx, bagOf([1].concat(ctx, [2])));
    let seen = match (held.sendMessage(ctx, .Look)) {
        .Ok(.Held(xs)) => xs,
        _ => [],
    };
    assert.equal(seen.push(ctx, 9), [1, 2, 9]);
    assert.equal(held.sendMessage(ctx, .Push(3)), .Ok(.Kept(3)));
    assert.equal(held.sendMessage(ctx, .Look), .Ok(.Held([1, 2, 3])));
    assert.equal(seen, [1, 2]);
    assert.equal(held.stop(ctx), .Ok(()));
}

enum Say<C> {
    Say(Str),
    Read,
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

derive Equal, Show for Said;
enum Said {
    Scalars(Int),
    Text(Str),
}

fn scribe<C: Allocator + Tasks>(initial: Str): Actor<C, Str, Say<C>, Said> {
    Actor {
        state: initial,
        step: fn(c, held, message) => {
            match (message) {
                .Say(next) => Stepped { state: next, answer: .Scalars(next.length()) },
                .Read => Stepped { state: held, answer: .Text(held) },
                .Within(f) => {
                    let call = f;
                    let _ = call(c);
                    Stepped { state: held, answer: .Text(held) }
                },
            }
        },
    }
}

test "text crosses the runtime whatever is in it" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // Seven scalars in four scripts, one of them outside the basic plane. A
    // crossing that counted bytes, or that stopped at a byte that is not a
    // whole scalar, gives a different answer to both assertions below.
    let told = actor.start(ctx, scribe("mix日😀éd"));
    assert.equal(told.sendMessage(ctx, .Read), .Ok(.Text("mix日😀éd")));
    assert.equal(told.sendMessage(ctx, .Say("héllo wörld 🌍")), .Ok(.Scalars(13)));
    assert.equal(told.sendMessage(ctx, .Read), .Ok(.Text("héllo wörld 🌍")));
    // The empty string is the other end of the same range.
    assert.equal(told.sendMessage(ctx, .Say("")), .Ok(.Scalars(0)));
    assert.equal(told.sendMessage(ctx, .Read), .Ok(.Text("")));
    assert.equal(told.stop(ctx), .Ok(()));
    assert.equal(told.stop(ctx), .Err(.Stopped));
    assert.equal(assert.err(told.sendMessage(ctx, .Read)), SendError.Stopped);
}

derive Equal, Show for Label;
struct Label {
    name: Str,
    tags: [Str],
}

derive Equal, Show for Record;
struct Record {
    label: Label,
    counts: [Int],
    note: Option<Str>,
}

enum Filing<C> {
    File(Record),
    Look,
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

derive Equal, Show for Filed;
enum Filed {
    Was(Record),
}

fn cabinet<C: Allocator + Tasks>(initial: Record): Actor<C, Record, Filing<C>, Filed> {
    Actor {
        state: initial,
        step: fn(c, held, message) => {
            match (message) {
                .File(next) => Stepped { state: next, answer: .Was(held) },
                .Look => Stepped { state: held, answer: .Was(held) },
                .Within(f) => {
                    let call = f;
                    let _ = call(c);
                    Stepped { state: held, answer: .Was(held) }
                },
            }
        },
    }
}

/// A record two structs deep, with a list at each level and an `Option` beside
/// them — the shape a shallow copy gets right and a deep one has to walk.
fn record(name: Str, note: Option<Str>): Record {
    Record {
        label: Label { name: name, tags: ["one", "two"] },
        counts: [7, 8, 9],
        note: note,
    }
}

test "a struct inside a struct crosses whole" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let filed = actor.start(ctx, cabinet(record("first", .None)));
    assert.equal(filed.sendMessage(ctx, .Look), .Ok(.Was(record("first", .None))));
    // The answer to a `File` is the record it replaced, so one send moves a
    // nested value both ways at once.
    assert.equal(
        filed.sendMessage(ctx, .File(record("second", .Some("kept")))),
        .Ok(.Was(record("first", .None))),
    );
    assert.equal(
        filed.sendMessage(ctx, .Look),
        .Ok(.Was(record("second", .Some("kept")))),
    );
    assert.equal(filed.stop(ctx), .Ok(()));
    assert.equal(filed.stop(ctx), .Err(.Stopped));
    assert.equal(assert.err(filed.sendMessage(ctx, .Look)), SendError.Stopped);
}

// -----------------------------------------------------------------------------
// One actor's address as another actor's state
// -----------------------------------------------------------------------------
//
// `Address` says it holds no context, so a lambda may capture one, "which is
// what makes an address usable as another actor's state". This is that
// sentence: a desk whose whole state is where to forward to.

enum Tally<C> {
    Increment,
    Get,
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

derive Equal, Show for Tallied;
enum Tallied {
    Done,
    Count(Int),
}

fn tally<C: Allocator + Tasks>(): Actor<C, Int, Tally<C>, Tallied> {
    Actor {
        state: 0,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => Stepped { state: count + 1, answer: .Done },
                .Get => Stepped { state: count, answer: .Count(count) },
                .Within(f) => {
                    let call = f;
                    let _ = call(c);
                    Stepped { state: count, answer: .Done }
                },
            }
        },
    }
}

enum Desk<C> {
    Bump,
    Total,
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

derive Equal, Show for Desked;
enum Desked {
    Noted,
    Total(Int),
    Gone,
}

/// A front desk. Its state is the address behind it, and every message it takes
/// it takes up with that actor — so a `sendMessage` here is a step of one actor
/// driving another's whole mailbox before it answers its own.
fn desk<C: Allocator + Tasks>(
    behind: Address<C, Int, Tally<C>, Tallied>,
): Actor<C, Address<C, Int, Tally<C>, Tallied>, Desk<C>, Desked> {
    Actor {
        state: behind,
        step: fn(c, back, message) => {
            match (message) {
                .Bump => {
                    match (back.sendMessage(c, .Increment)) {
                        .Ok(_done) => Stepped { state: back, answer: .Noted },
                        .Err(_gone) => Stepped { state: back, answer: .Gone },
                    }
                },
                .Total => {
                    match (back.sendMessage(c, .Get)) {
                        .Ok(.Count(n)) => Stepped { state: back, answer: .Total(n) },
                        .Ok(_other) => Stepped { state: back, answer: .Gone },
                        .Err(_gone) => Stepped { state: back, answer: .Gone },
                    }
                },
                .Within(f) => {
                    let call = f;
                    let _ = call(c);
                    Stepped { state: back, answer: .Noted }
                },
            }
        },
    }
}

test "two actors exchange messages, and one holds the other's address" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, tally());
    let front = actor.start(ctx, desk(counted));
    assert.equal(front.sendMessage(ctx, .Bump), .Ok(.Noted));
    assert.equal(front.sendMessage(ctx, .Bump), .Ok(.Noted));
    // Asked through the desk and asked directly: the same actor, so the same
    // number.
    assert.equal(front.sendMessage(ctx, .Total), .Ok(.Total(2)));
    assert.equal(counted.sendMessage(ctx, .Get), .Ok(.Count(2)));
    assert.equal(front.stop(ctx), .Ok(()));
    assert.equal(counted.stop(ctx), .Ok(()));
    assert.equal(
        (front.stop(ctx), counted.stop(ctx)),
        (.Err(.Stopped), .Err(.Stopped)),
    );
    assert.equal(assert.err(front.sendMessage(ctx, .Total)), SendError.Stopped);
    assert.equal(assert.err(counted.sendMessage(ctx, .Get)), SendError.Stopped);
}

test "a step that sends to an actor that has stopped is told so" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    // The desk outlives what it forwards to, which is the one way a program
    // reaches `.Err(.Stopped)` from *inside* a step rather than at a call site.
    let counted = actor.start(ctx, tally());
    let front = actor.start(ctx, desk(counted));
    assert.equal(front.sendMessage(ctx, .Bump), .Ok(.Noted));
    assert.equal(counted.stop(ctx), .Ok(()));
    // The desk is still running, so its own answer is `.Ok`; what it says is
    // that the actor behind it is gone.
    assert.equal(front.sendMessage(ctx, .Bump), .Ok(.Gone));
    assert.equal(front.sendMessage(ctx, .Total), .Ok(.Gone));
    assert.equal(front.stop(ctx), .Ok(()));
}

// -----------------------------------------------------------------------------
// A step that spawns
// -----------------------------------------------------------------------------
//
// A `Scope` is inert, so it fits in a message the same way an address fits in a
// state. That is the whole of what an actor needs to start background work:
// there is no `Tasks` method to reach for, only the scope somebody handed it.

enum Job<C> {
    /// Start a job in the scope the sender is holding.
    Run(Scope),
    /// Call this from inside the step.
    Within(fn(C) => ()),
}

derive Equal, Show for Ran;
enum Ran {
    Started(Int),
}

/// An actor that spawns rather than working: the step queues the task and
/// answers how many jobs it has started.
fn foreman<C: Allocator + Stdout + Tasks>(): Actor<C, Int, Job<C>, Ran> {
    Actor {
        state: 0,
        step: fn(c, started, message) => {
            match (message) {
                .Run(here) => {
                    let _ = tasks.spawn(c, here, fn(c2) => {
                        let _ = io.println(c2, "the job ran").ignore();
                        ()
                    });
                    Stepped { state: started + 1, answer: .Started(started + 1) }
                },
                .Within(f) => {
                    let call = f;
                    let _ = call(c);
                    Stepped { state: started, answer: .Started(started) }
                },
            }
        },
    }
}

test "a step may spawn into a scope the message handed it" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let boss = actor.start(ctx, foreman());
    let started = tasks.scope(ctx, fn(c, here) => {
        let first = boss.sendMessage(c, .Run(here));
        let second = boss.sendMessage(c, .Run(here));
        let _ = io.println(c, "asked twice").ignore();
        [first, second]
    });
    assert.equal(started, [.Ok(.Started(1)), .Ok(.Started(2))]);
    // The body is what printed first, so the scope was still its own drain
    // while the steps were spawning — and it waited for both jobs before it
    // answered.
    assert.equal(out.captured(), "asked twice\nthe job ran\nthe job ran\n");
    assert.equal(boss.stop(ctx), .Ok(()));
    assert.equal(boss.stop(ctx), .Err(.Stopped));
}

/// Every step in program order, for up to three steps: a scheduler of the
/// test's own. A block that schedules through one rather than `TestTasks` runs
/// a scope as its program would, so natively a scope's tasks run beside its
/// body. Every step runs in order, so what is answered is the same either way.
struct InOrder {}

impl Tasks for InOrder {
    fn parallel<C, A, B>(self, ctx: C, items: [A], f: fn(C, Int, A) => B): [B] {
        match (items) {
            [] => [],
            [a] => [f(ctx, 0, a)],
            [a, b] => [f(ctx, 0, a), f(ctx, 1, b)],
            [a, b, c, ..] => [f(ctx, 0, a), f(ctx, 1, b), f(ctx, 2, c)],
        }
    }
}

test "a step spawns into a scope under the test's own scheduler" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: InOrder {},
    };
    let boss = actor.start(ctx, foreman());
    let started = tasks.scope(ctx, fn(c, here) => {
        let first = boss.sendMessage(c, .Run(here));
        let second = boss.sendMessage(c, .Run(here));
        let _ = boss.stop(c).ignore();
        [first, second, boss.sendMessage(c, .Run(here))]
    });
    assert.equal(started, [.Ok(.Started(1)), .Ok(.Started(2)), .Err(.Stopped)]);
    assert.equal(out.captured(), "the job ran\nthe job ran\n");
}

test "each answer here, in a send's result, equals itself and not a failure" {
    let stopped = SendError.Stopped;
    assert.isTrue(variants.resultsCompare((), stopped));
    assert.isTrue(variants.resultsCompare(Bagged.Kept(1), stopped));
    assert.isTrue(variants.resultsCompare(Desked.Noted, stopped));
    assert.isTrue(variants.resultsCompare(Filed.Was(record("first", .None)), stopped));
    assert.isTrue(variants.resultsCompare(Said.Text("a"), stopped));
    assert.isTrue(variants.resultsCompare(Tallied.Done, stopped));
}

// -----------------------------------------------------------------------------
// A step that sends to its own actor, whatever the payload
// -----------------------------------------------------------------------------
//
// `counter.buri` shows the refusal with an `Int` message. Each actor above takes
// it here with its own payload: the send made from inside the step is
// `.Err(.WouldDeadlock)`, and the message it posted is stepped, whole, by the
// loop that was already running before that loop puts the state back.

test "a unit actor's step that sends to it is refused, and the message still arrives" {
    let sink = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let quiet = actor.start(ctx, silent());
    let refused = quiet.sendMessage(
        ctx,
        .Within(fn(c) => {
            let late = quiet.sendMessage(
                c,
                .Within(fn(c2) => io.println(c2, "late").ignore()),
            );
            assert.equal(late, .Err(.WouldDeadlock))
        }),
    );
    assert.equal(refused, .Ok(()));
    // The refused message printed once, after the step that sent it.
    assert.equal(sink.captured(), "late\n");
    assert.equal(quiet.stop(ctx), .Ok(()));
    assert.equal(sink.captured(), "late\nquiet\n");
}

test "a list sent from inside its own actor's step is refused, and still arrives" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let held = actor.start(ctx, bag());
    let refused = held.sendMessage(
        ctx,
        .Within(fn(c) => {
            assert.equal(held.sendMessage(c, .Fill([7, 8, 9])), .Err(.WouldDeadlock))
        }),
    );
    assert.equal(refused, .Ok(.Kept(0)));
    assert.equal(held.sendMessage(ctx, .Drain), .Ok(.Held([7, 8, 9])));
    assert.equal(held.stop(ctx), .Ok(()));
}

test "text sent from inside its own actor's step is refused, and still arrives" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let told = actor.start(ctx, scribe("before"));
    let refused = told.sendMessage(
        ctx,
        .Within(fn(c) => {
            assert.equal(told.sendMessage(c, .Say("日😀é")), .Err(.WouldDeadlock))
        }),
    );
    assert.equal(refused, .Ok(.Text("before")));
    assert.equal(told.sendMessage(ctx, .Read), .Ok(.Text("日😀é")));
    assert.equal(told.stop(ctx), .Ok(()));
}

test "a record sent from inside its own actor's step is refused, and still arrives" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let filed = actor.start(ctx, cabinet(record("first", .None)));
    let refused = filed.sendMessage(
        ctx,
        .Within(fn(c) => {
            let late = filed.sendMessage(c, .File(record("late", .Some("x"))));
            assert.equal(late, .Err(.WouldDeadlock))
        }),
    );
    assert.equal(refused, .Ok(.Was(record("first", .None))));
    assert.equal(filed.sendMessage(ctx, .Look), .Ok(.Was(record("late", .Some("x")))));
    assert.equal(filed.stop(ctx), .Ok(()));
}

test "a desk and the actor behind it each refuse a send from their own step" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, tally());
    let front = actor.start(ctx, desk(counted));
    let tallied = counted.sendMessage(
        ctx,
        .Within(fn(c) => {
            assert.equal(counted.sendMessage(c, .Increment), .Err(.WouldDeadlock))
        }),
    );
    assert.equal(tallied, .Ok(.Done));
    let desked = front.sendMessage(
        ctx,
        .Within(fn(c) => {
            assert.equal(front.sendMessage(c, .Bump), .Err(.WouldDeadlock))
        }),
    );
    assert.equal(desked, .Ok(.Noted));
    // One increment the tally refused and stepped, and one the desk's refused
    // `Bump` forwarded once the desk's own loop reached it.
    assert.equal(front.sendMessage(ctx, .Total), .Ok(.Total(2)));
    assert.equal(front.stop(ctx), .Ok(()));
    assert.equal(counted.stop(ctx), .Ok(()));
}

test "a job sent from inside its own actor's step is refused, and still runs" {
    let out = stdout();
    let ctx = context {
        Allocator: alloc(),
        Stdout: out,
        Tasks: tasks(),
    };
    let boss = actor.start(ctx, foreman());
    let refused = tasks.scope(ctx, fn(c, here) => {
        let within = boss.sendMessage(
            c,
            .Within(fn(c2) => {
                assert.equal(boss.sendMessage(c2, .Run(here)), .Err(.WouldDeadlock))
            }),
        );
        [within, boss.sendMessage(c, .Run(here))]
    });
    assert.equal(refused, [.Ok(.Started(0)), .Ok(.Started(2))]);
    // A send that started a job is never the same as one that was refused,
    // whichever way round the two are compared.
    let started: Result<Ran, SendError> = .Ok(.Started(2));
    let late: Result<Ran, SendError> = .Err(.WouldDeadlock);
    assert.equal(started, .Ok(.Started(2)));
    assert.notEqual(started, late);
    assert.notEqual(late, started);
    // The refused `Run` was stepped before the next send's, so two jobs were
    // spawned and the scope waited for both.
    assert.equal(out.captured(), "the job ran\nthe job ran\n");
    assert.equal(boss.stop(ctx), .Ok(()));
}

// -----------------------------------------------------------------------------
// While a scope holds pages
// -----------------------------------------------------------------------------
//
// While any `alloc.scoped` arena holds pages, every value an actor hands the
// runtime is copied out of the arenas first; while none does, it crosses as it
// is. `scoped.buri` drives an actor through a scope's own context. Each actor
// below lives its whole life inside a scope instead, through a context of its
// own, and answers what it answers anywhere else. Each one stops with a hook
// that checks the state it ends on.

/// `silent` without a hook: stopping it runs nothing.
fn quietly(): (Result<(), SendError>, Result<(), Stopped>, Result<(), SendError>) {
    let ctx = context {
        Allocator: alloc(),
        Stdout: stdout(),
        Tasks: tasks(),
    };
    let quiet = actor.start(ctx, Actor { ..silent(), onStop: .None });
    let answered = quiet.sendMessage(ctx, .Ping);
    let stopped = quiet.stop(ctx);
    (answered, stopped, quiet.sendMessage(ctx, .Ping))
}

fn bagged(): [Result<Bagged, SendError>] {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let held = actor.start(ctx, Actor {
        ..bag(),
        onStop: .Some(fn(c, last) => assert.equal(last, [1, 2])),
    });
    let filled = held.sendMessage(ctx, .Fill([1]));
    let pushed = held.sendMessage(ctx, .Push(2));
    let _ = held.stop(ctx).ignore();
    [filled, pushed]
}

fn said(): [Result<Said, SendError>] {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let told = actor.start(ctx, Actor {
        ..scribe("before"),
        onStop: .Some(fn(c, last) => assert.equal(last, "after")),
    });
    let replaced = told.sendMessage(ctx, .Say("after"));
    let read = told.sendMessage(ctx, .Read);
    let _ = told.stop(ctx).ignore();
    [replaced, read]
}

fn filedAway(): Result<Filed, SendError> {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let filed = actor.start(ctx, Actor {
        ..cabinet(record("first", .None)),
        onStop: .Some(fn(c, last) => assert.equal(last, record("second", .Some("x")))),
    });
    let answered = filed.sendMessage(ctx, .File(record("second", .Some("x"))));
    let _ = filed.stop(ctx).ignore();
    answered
}

fn forwarded(): [Result<Desked, SendError>] {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, tally());
    let front = actor.start(ctx, Actor { ..desk(counted), onStop: .Some(bumpedOnce) });
    let bumped = front.sendMessage(ctx, .Bump);
    let total = front.sendMessage(ctx, .Total);
    let _ = front.stop(ctx).ignore();
    let _ = counted.stop(ctx).ignore();
    [bumped, total]
}

/// The desk's hook: the actor behind it was bumped once.
fn bumpedOnce<C: Allocator + Tasks>(
    ctx: C,
    behind: Address<C, Int, Tally<C>, Tallied>,
): () {
    assert.equal(behind.sendMessage(ctx, .Get), .Ok(.Count(1)))
}

fn spawned(): [Result<Ran, SendError>] {
    let ctx = context {
        Allocator: alloc(),
        Stdout: stdout(),
        Tasks: tasks(),
    };
    let boss = actor.start(ctx, foreman());
    tasks.scope(ctx, fn(c, here) => {
        let first = boss.sendMessage(c, .Run(here));
        let second = boss.sendMessage(c, .Run(here));
        let _ = boss.stop(c).ignore();
        // And after the stop, the job is refused before it is posted.
        [first, second, boss.sendMessage(c, .Run(here))]
    })
}

test "every payload crosses the same while a scope holds pages" {
    let ctx = context {
        Allocator: alloc(),
        Tasks: tasks(),
    };
    let answers = alloc.scoped(ctx, fn(c) => {
        let held = "pages".repeat(c, 100);
        (
            held.length(),
            quietly(),
            bagged(),
            said(),
            filedAway(),
            forwarded(),
            spawned(),
        )
    });
    assert.equal(
        answers,
        (
            500,
            (.Ok(()), .Ok(()), .Err(.Stopped)),
            [.Ok(.Kept(1)), .Ok(.Kept(2))],
            [.Ok(.Scalars(5)), .Ok(.Text("after"))],
            .Ok(.Was(record("first", .None))),
            [.Ok(.Noted), .Ok(.Total(1))],
            [.Ok(.Started(1)), .Ok(.Started(2)), .Err(.Stopped)],
        ),
    );
}
