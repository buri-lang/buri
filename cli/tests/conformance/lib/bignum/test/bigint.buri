// core/bigint — integers with no width.
//
// Every expected value here was computed somewhere else and written into the
// file: known factorials, powers of two and three, and modular exponentiations.
// A module whose whole claim is exactness has to be checked against arithmetic
// it did not do itself.
//
// Ordinary Buri over `[Int]` with no host anywhere in it, so the assertions are
// answers rather than anything a platform decides.

from "core/bigint" import * as bigint;
from "core/bigint" import { BigInt };
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/number" import * as number;
from "core/order" import { Order };
from "core/testing/assert" import * as assert;

// --- of, zero and text -----------------------------------------------------------

test "of and text round-trip every Int" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(0).text(ctx), "0");
    assert.equal(bigint.of(1).text(ctx), "1");
    assert.equal(bigint.of(-1).text(ctx), "-1");
    assert.equal(bigint.of(1000000).text(ctx), "1000000");
    assert.equal(bigint.of(-1000000).text(ctx), "-1000000");
    assert.equal(bigint.of(16777216).text(ctx), "16777216");
    assert.equal(bigint.of(number.maxValue<I64>()).text(ctx), "9223372036854775807");
    assert.equal(bigint.of(number.minValue<I64>()).text(ctx), "-9223372036854775808");
}

test "zero has one shape, however it was reached" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(0), bigint.zero());
    assert.equal(bigint.of(5).subtract(ctx, bigint.of(5)), bigint.zero());
    assert.equal(bigint.of(-5).add(ctx, bigint.of(5)), bigint.zero());
    assert.equal(bigint.of(0).negate(), bigint.zero());
    assert.isTrue(bigint.zero().isZero());
    assert.isFalse(bigint.of(1).isZero());
}

test "text puts every seven-digit group back with its zeros" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The conversion moves seven digits at a time; a group of zeros in the
    // middle is what a missing pad would lose.
    assert.equal(
        assert.some(bigint.parse(ctx, "10000000000000001")).text(ctx),
        "10000000000000001",
    );
    assert.equal(assert.some(bigint.parse(ctx, "100000000")).text(ctx), "100000000");
    assert.equal(assert.some(bigint.parse(ctx, "10000000")).text(ctx), "10000000");
}

// --- parse ------------------------------------------------------------------------

test "parse reads the digits back" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.parse(ctx, "0"), .Some(bigint.zero()));
    assert.equal(bigint.parse(ctx, "-0"), .Some(bigint.zero()));
    assert.equal(bigint.parse(ctx, "42"), .Some(bigint.of(42)));
    assert.equal(bigint.parse(ctx, "-42"), .Some(bigint.of(-42)));
    assert.equal(
        assert.some(bigint.parse(ctx, "1267650600228229401496703205376")).text(ctx),
        "1267650600228229401496703205376",
    );
}

test "parse is strict" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.parse(ctx, ""), .None);
    assert.equal(bigint.parse(ctx, "-"), .None);
    assert.equal(bigint.parse(ctx, " 1"), .None);
    assert.equal(bigint.parse(ctx, "1 "), .None);
    assert.equal(bigint.parse(ctx, "1_000"), .None);
    assert.equal(bigint.parse(ctx, "+1"), .None);
    assert.equal(bigint.parse(ctx, "1.0"), .None);
    assert.equal(bigint.parse(ctx, "0x10"), .None);
    assert.equal(bigint.parse(ctx, "12-3"), .None);
}

// --- add and subtract ------------------------------------------------------------------

test "add and subtract carry and borrow across limbs" {
    let ctx = context {
        Allocator: alloc(),
    };
    let big = assert.some(bigint.parse(ctx, "18446744073709551616"));
    let one = bigint.of(1);
    assert.equal(big.add(ctx, one).text(ctx), "18446744073709551617");
    assert.equal(big.subtract(ctx, one).text(ctx), "18446744073709551615");
    assert.equal(bigint.of(999999999).add(ctx, bigint.of(1)).text(ctx), "1000000000");
    assert.equal(
        bigint.of(1000000000).subtract(ctx, bigint.of(1)).text(ctx),
        "999999999",
    );
}

test "add crosses zero and keeps the right sign" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(5).add(ctx, bigint.of(-7)).text(ctx), "-2");
    assert.equal(bigint.of(-5).add(ctx, bigint.of(7)).text(ctx), "2");
    assert.equal(bigint.of(-5).add(ctx, bigint.of(-7)).text(ctx), "-12");
    assert.equal(bigint.of(7).subtract(ctx, bigint.of(-5)).text(ctx), "12");
    assert.equal(bigint.of(-7).subtract(ctx, bigint.of(-5)).text(ctx), "-2");
}

test "add is what an Int cannot do" {
    let ctx = context {
        Allocator: alloc(),
    };
    let top = bigint.of(number.maxValue<I64>());
    assert.equal(top.add(ctx, bigint.of(1)).text(ctx), "9223372036854775808");
    assert.equal(top.add(ctx, top).text(ctx), "18446744073709551614");
    let bottom = bigint.of(number.minValue<I64>());
    assert.equal(bottom.add(ctx, bottom).text(ctx), "-18446744073709551616");
}

test "adding and subtracting the same value gets back where it started" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = assert.some(bigint.parse(ctx, "123456789012345678901234567890"));
    let b = assert.some(bigint.parse(ctx, "98765432109876543210"));
    assert.equal(a.add(ctx, b).subtract(ctx, b), a);
    assert.equal(a.subtract(ctx, b).add(ctx, b), a);
    assert.equal(a.negate().negate(), a);
}

// --- multiply ---------------------------------------------------------------------------

test "multiply matches the factorials it was checked against" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(factorial(ctx, 0).text(ctx), "1");
    assert.equal(factorial(ctx, 1).text(ctx), "1");
    assert.equal(factorial(ctx, 20).text(ctx), "2432902008176640000");
    assert.equal(factorial(ctx, 25).text(ctx), "15511210043330985984000000");
    assert.equal(factorial(ctx, 30).text(ctx), "265252859812191058636308480000000");
    assert.equal(
        factorial(ctx, 50).text(ctx),
        "30414093201713378043612608166064768844377641568960512000000000000",
    );
}

test "multiply carries the sign and answers zero for a zero side" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(6).multiply(ctx, bigint.of(7)).text(ctx), "42");
    assert.equal(bigint.of(-6).multiply(ctx, bigint.of(7)).text(ctx), "-42");
    assert.equal(bigint.of(6).multiply(ctx, bigint.of(-7)).text(ctx), "-42");
    assert.equal(bigint.of(-6).multiply(ctx, bigint.of(-7)).text(ctx), "42");
    assert.equal(bigint.of(0).multiply(ctx, bigint.of(-7)), bigint.zero());
    assert.equal(bigint.of(-7).multiply(ctx, bigint.zero()), bigint.zero());
}

test "multiply is what an Int cannot do" {
    let ctx = context {
        Allocator: alloc(),
    };
    let top = bigint.of(number.maxValue<I64>());
    assert.equal(
        top.multiply(ctx, top).text(ctx),
        "85070591730234615847396907784232501249",
    );
    let ten = assert.some(bigint.parse(ctx, "10000000000000000000"));
    assert.equal(
        ten.multiply(ctx, ten).text(ctx),
        "100000000000000000000000000000000000000",
    );
}

test "multiply is commutative and distributes over add" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = assert.some(bigint.parse(ctx, "987654321987654321"));
    let b = assert.some(bigint.parse(ctx, "123456789123456789"));
    let c = bigint.of(-4242);
    assert.equal(a.multiply(ctx, b), b.multiply(ctx, a));
    assert.equal(
        a.multiply(ctx, b.add(ctx, c)),
        a.multiply(ctx, b).add(ctx, a.multiply(ctx, c)),
    );
}

// --- power --------------------------------------------------------------------------

test "power matches the powers it was checked against" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(2).power(ctx, 0).text(ctx), "1");
    assert.equal(bigint.of(2).power(ctx, 1).text(ctx), "2");
    assert.equal(bigint.of(2).power(ctx, 64).text(ctx), "18446744073709551616");
    assert.equal(
        bigint.of(2).power(ctx, 100).text(ctx),
        "1267650600228229401496703205376",
    );
    assert.equal(bigint.of(3).power(ctx, 40).text(ctx), "12157665459056928801");
    assert.equal(
        bigint.of(10).power(ctx, 40).text(ctx),
        "10000000000000000000000000000000000000000",
    );
}

test "power keeps the sign an odd exponent gives it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(-2).power(ctx, 3).text(ctx), "-8");
    assert.equal(bigint.of(-2).power(ctx, 4).text(ctx), "16");
    assert.equal(bigint.of(0).power(ctx, 0).text(ctx), "1");
    assert.equal(bigint.of(0).power(ctx, 7), bigint.zero());
}

test "a negative exponent is the whole part of a fraction" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(2).power(ctx, -1), bigint.zero());
    assert.equal(bigint.of(0).power(ctx, -1), bigint.zero());
    assert.equal(bigint.of(1).power(ctx, -5).text(ctx), "1");
    assert.equal(bigint.of(-1).power(ctx, -5).text(ctx), "-1");
    assert.equal(bigint.of(-1).power(ctx, -4).text(ctx), "1");
}

test "power is repeated multiplication" {
    let ctx = context {
        Allocator: alloc(),
    };
    let base = bigint.of(12345);
    assert.equal(base.power(ctx, 5), base.power(ctx, 4).multiply(ctx, base));
    assert.equal(base.power(ctx, 1), base);
}

// --- quotientRemainder ---------------------------------------------------------------

test "quotientRemainder truncates toward zero, as Int's operators do" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(split(ctx, 7, 2), ("3", "1"));
    assert.equal(split(ctx, -7, 2), ("-3", "-1"));
    assert.equal(split(ctx, 7, -2), ("-3", "1"));
    assert.equal(split(ctx, -7, -2), ("3", "-1"));
    assert.equal(split(ctx, 6, 3), ("2", "0"));
    assert.equal(split(ctx, 0, 3), ("0", "0"));
    assert.equal(split(ctx, 2, 7), ("0", "2"));
}

test "quotientRemainder answers .None on a zero divisor" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(7).quotientRemainder(ctx, bigint.zero()), .None);
    assert.equal(bigint.zero().quotientRemainder(ctx, bigint.zero()), .None);
}

test "quotientRemainder over many limbs" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = assert.some(bigint.parse(ctx, "10000000000000000000000000000000000000000"));
    let (q, r) = assert.some(a.quotientRemainder(ctx, bigint.of(7)));
    assert.equal(q.text(ctx), "1428571428571428571428571428571428571428");
    assert.equal(r.text(ctx), "4");

    let two = bigint.of(2).power(ctx, 100);
    let three = bigint.of(3).power(ctx, 20);
    let (q2, r2) = assert.some(two.quotientRemainder(ctx, three));
    assert.equal(q2.text(ctx), "363558641556578823726");
    assert.equal(r2.text(ctx), "1957707250");
}

test "the quotient times the divisor plus the remainder is the dividend" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = assert.some(bigint.parse(ctx, "-987654321098765432109876543210"));
    let b = assert.some(bigint.parse(ctx, "123456789"));
    let (q, r) = assert.some(a.quotientRemainder(ctx, b));
    assert.equal(q.multiply(ctx, b).add(ctx, r), a);
}

test "dividing a factorial by its own factors leaves nothing" {
    let ctx = context {
        Allocator: alloc(),
    };
    let twenty = factorial(ctx, 20);
    let nineteen = factorial(ctx, 19);
    let (q, r) = assert.some(twenty.quotientRemainder(ctx, nineteen));
    assert.equal(q.text(ctx), "20");
    assert.isTrue(r.isZero());
}

// --- modularPower ---------------------------------------------------------------------

test "modularPower matches the residues it was checked against" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(residue(ctx, 7, 128, 13), "3");
    assert.equal(residue(ctx, 2, 1000, 1000000007), "688423210");
    assert.equal(residue(ctx, 123456789, 987654321, 1000000007), "652541198");
    assert.equal(residue(ctx, 5, 0, 7), "1");
    assert.equal(residue(ctx, 5, 1, 7), "5");
}

test "modularPower answers a non-negative residue whatever the signs" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(residue(ctx, -3, 3, 7), "1");
    assert.equal(residue(ctx, -3, 2, 7), "2");
    assert.equal(residue(ctx, 3, 3, -7), "6");
    assert.equal(residue(ctx, 5, 3, 1), "0");
}

test "modularPower answers zero where there is nothing to answer" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.isTrue(bigint.of(5).modularPower(ctx, bigint.of(3), bigint.zero()).isZero());
    assert.isTrue(bigint.of(5).modularPower(ctx, bigint.of(-1), bigint.of(7)).isZero());
}

test "modularPower agrees with power reduced afterwards" {
    let ctx = context {
        Allocator: alloc(),
    };
    let m = bigint.of(97);
    let whole = bigint.of(6).power(ctx, 30);
    let (_, r) = assert.some(whole.quotientRemainder(ctx, m));
    assert.equal(bigint.of(6).modularPower(ctx, bigint.of(30), m), r);
}

// --- toInt ------------------------------------------------------------------------------

test "toInt is exact at both ends" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(0).toInt(), .Ok(0));
    assert.equal(bigint.of(-1).toInt(), .Ok(-1));
    assert.equal(bigint.of(1234567890).toInt(), .Ok(1234567890));
    assert.equal(
        bigint.of(number.maxValue<I64>()).toInt(),
        .Ok(number.maxValue<I64>()),
    );
    assert.equal(
        bigint.of(number.minValue<I64>()).toInt(),
        .Ok(number.minValue<I64>()),
    );
    assert.isTrue(
        bigint.of(number.maxValue<I64>()).add(ctx, bigint.of(1)).toInt().isErr(),
    );
    assert.isTrue(
        bigint.of(number.minValue<I64>()).subtract(ctx, bigint.of(1)).toInt().isErr(),
    );
}

test "toInt and of undo each other" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values = [
        0,
        1,
        -1,
        16777215,
        16777216,
        16777217,
        number.maxValue<I64>(),
        number.minValue<I64>(),
    ];
    let broken = values.filter(ctx, fn(v) => bigint.of(v).toInt() != .Ok(v));
    assert.isEmpty(broken);
}

// --- Equal, Ordered and Hash ----------------------------------------------------------------

test "equality is numeric because the shape is canonical" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(42), assert.some(bigint.parse(ctx, "42")));
    assert.equal(bigint.of(-42), assert.some(bigint.parse(ctx, "-42")));
    assert.notEqual(bigint.of(42), bigint.of(-42));
    assert.equal(bigint.of(1).multiply(ctx, bigint.of(0)), bigint.zero());
    assert.equal(bigint.of(2).power(ctx, 100), bigint.of(2).power(ctx, 100));
}

test "order is numeric and not the field order a derive would give" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.of(-5).compare(bigint.of(3)), Order.Less);
    assert.equal(bigint.of(3).compare(bigint.of(-5)), Order.Greater);
    assert.equal(bigint.of(3).compare(bigint.of(3)), Order.Equal);
    assert.equal(bigint.of(-5).compare(bigint.of(-7)), Order.Greater);
    assert.equal(bigint.zero().compare(bigint.of(-1)), Order.Greater);
    assert.equal(
        bigint.of(2).power(ctx, 100).compare(bigint.of(number.maxValue<I64>())),
        Order.Greater,
    );
}

test "sorting puts them in numeric order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values = [
        bigint.of(3),
        bigint.of(-5),
        bigint.zero(),
        bigint.of(100),
        bigint.of(-100),
    ];
    let sorted = values.sort(ctx).mapCtx(ctx, fn(c, v) => v.text(c));
    assert.equal(sorted, ["-100", "-5", "0", "3", "100"]);
}

// --- helpers ---------------------------------------------------------------------------

/// `n!`, built with `multiply` alone.
fn factorial<C: Allocator>(ctx: C, n: Int): BigInt {
    list
        .range(ctx, 1, n + 1)
        .foldCtx(ctx, fn(c, acc, i) => acc.multiply(c, bigint.of(i)), bigint.of(1))
}

/// A division, as the two numbers it answers.
fn split<C: Allocator>(ctx: C, a: Int, b: Int): (Str, Str) {
    let (q, r) = assert.some(bigint.of(a).quotientRemainder(ctx, bigint.of(b)));
    (q.text(ctx), r.text(ctx))
}

/// One modular exponentiation, written out.
fn residue<C: Allocator>(ctx: C, base: Int, exponent: Int, modulus: Int): Str {
    bigint.of(base).modularPower(ctx, bigint.of(exponent), bigint.of(modulus)).text(ctx)
}

// --- The limb boundary --------------------------------------------------------------
//
// A limb holds twenty-four bits, so `2^24` is where a magnitude grows a second
// limb and `2^48` a third. Every carry, borrow and column in this module is
// written around that boundary, and a number that sits exactly on one is what
// an off-by-one in any of them shows up at.

test "of and text cross the limb boundary in both directions" {
    let ctx = context {
        Allocator: alloc(),
    };
    // 2^24 - 1 is the largest one-limb magnitude; 2^24 is the smallest two-limb
    // one; 2^48 is the smallest three-limb one.
    assert.equal(bigint.of(16777215).text(ctx), "16777215");
    assert.equal(bigint.of(16777216).text(ctx), "16777216");
    assert.equal(bigint.of(16777217).text(ctx), "16777217");
    assert.equal(bigint.of(281474976710655).text(ctx), "281474976710655");
    assert.equal(bigint.of(281474976710656).text(ctx), "281474976710656");
    assert.equal(bigint.of(281474976710657).text(ctx), "281474976710657");
    // And with a sign on, where `of` counts from below zero.
    assert.equal(bigint.of(-16777216).text(ctx), "-16777216");
    assert.equal(bigint.of(-281474976710656).text(ctx), "-281474976710656");
}

test "add and subtract carry and borrow exactly at the limb boundary" {
    let ctx = context {
        Allocator: alloc(),
    };
    let limb = bigint.of(16777216);
    let one = bigint.of(1);
    // The carry into a second limb, and the borrow back out of it.
    assert.equal(bigint.of(16777215).add(ctx, one), limb);
    assert.equal(limb.subtract(ctx, one), bigint.of(16777215));
    // The same at the third limb.
    let two = bigint.of(281474976710656);
    assert.equal(bigint.of(281474976710655).add(ctx, one), two);
    assert.equal(two.subtract(ctx, one), bigint.of(281474976710655));
    // A carry that runs the whole way up: every limb is full below it.
    let full = assert.some(bigint.parse(ctx, "4722366482869645213695"));
    let rounded = assert.some(bigint.parse(ctx, "4722366482869645213696"));
    assert.equal(full.add(ctx, one), rounded);
    assert.equal(rounded.subtract(ctx, one), full);
}

test "multiply lands exactly on a limb boundary and on the one above it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let limb = bigint.of(16777216);
    // 2^24 * 2^24 is 2^48: a column whose carry is the whole of the answer.
    assert.equal(limb.multiply(ctx, limb).text(ctx), "281474976710656");
    // 2^48 * 2^24 is 2^72, past what an `Int` holds at all.
    assert.equal(
        limb.multiply(ctx, limb).multiply(ctx, limb).text(ctx),
        "4722366482869645213696",
    );
    // One below the boundary squared, where no carry leaves the column.
    assert.equal(
        bigint.of(16777215).multiply(ctx, bigint.of(16777215)).text(ctx),
        "281474943156225",
    );
}

test "quotientRemainder divides exactly at the limb boundary" {
    let ctx = context {
        Allocator: alloc(),
    };
    let limb = bigint.of(16777216);
    let (q, r) = assert.some(bigint.of(281474976710656).quotientRemainder(ctx, limb));
    assert.equal(q, limb);
    assert.isTrue(r.isZero());
    // One either side of the boundary, where the quotient loses a limb.
    let (q2, r2) = assert.some(bigint.of(281474976710655).quotientRemainder(ctx, limb));
    assert.equal(q2.text(ctx), "16777215");
    assert.equal(r2.text(ctx), "16777215");
    let (q3, r3) = assert.some(bigint.of(16777216).quotientRemainder(ctx, limb));
    assert.equal(q3, bigint.of(1));
    assert.isTrue(r3.isZero());
}

// --- Zero, one and minus one --------------------------------------------------------

test "zero is absorbing and neutral in the right places" {
    let ctx = context {
        Allocator: alloc(),
    };
    let zero = bigint.zero();
    let seven = bigint.of(7);
    assert.equal(zero.add(ctx, zero), zero);
    assert.equal(zero.subtract(ctx, zero), zero);
    assert.equal(zero.add(ctx, seven), seven);
    assert.equal(seven.subtract(ctx, seven), zero);
    assert.equal(zero.multiply(ctx, seven), zero);
    assert.equal(seven.multiply(ctx, zero), zero);
    assert.equal(zero.power(ctx, 5), zero);
    // The empty product is one at every base, zero included.
    assert.equal(zero.power(ctx, 0), bigint.of(1));
    // There is one zero and it is positive: negating it changes nothing, and a
    // subtraction that lands on it does not leave a signed one behind.
    assert.equal(zero.negate(), zero);
    assert.equal(bigint.of(-7).add(ctx, seven), zero);
    assert.equal(bigint.of(-7).add(ctx, seven).text(ctx), "0");
    assert.equal(bigint.of(-7).add(ctx, seven).negate().text(ctx), "0");
    // Divided into, it is zero; divided by, there is no answer.
    assert.equal(assert.some(zero.quotientRemainder(ctx, seven)), (zero, zero));
    assert.equal(seven.quotientRemainder(ctx, zero), .None);
    assert.equal(zero.quotientRemainder(ctx, zero), .None);
}

test "one and minus one at every operation" {
    let ctx = context {
        Allocator: alloc(),
    };
    let one = bigint.of(1);
    let minusOne = bigint.of(-1);
    let big = assert.some(bigint.parse(ctx, "123456789012345678901234567890"));
    assert.equal(big.multiply(ctx, one), big);
    assert.equal(big.multiply(ctx, minusOne), big.negate());
    assert.equal(assert.some(big.quotientRemainder(ctx, one)), (big, bigint.zero()));
    assert.equal(
        assert.some(big.quotientRemainder(ctx, minusOne)),
        (big.negate(), bigint.zero()),
    );
    assert.equal(one.power(ctx, 1000), one);
    assert.equal(minusOne.power(ctx, 1000), one);
    assert.equal(minusOne.power(ctx, 1001), minusOne);
    // A negative exponent is the whole part of a fraction, which is zero
    // everywhere but at these two bases.
    assert.equal(one.power(ctx, -5), one);
    assert.equal(minusOne.power(ctx, -5), minusOne);
    assert.equal(minusOne.power(ctx, -4), one);
    assert.equal(bigint.of(2).power(ctx, -1), bigint.zero());
}

test "the four sign pairs of add, subtract and multiply" {
    let ctx = context {
        Allocator: alloc(),
    };
    let a = bigint.of(12);
    let b = bigint.of(5);
    assert.equal(a.add(ctx, b), bigint.of(17));
    assert.equal(a.negate().add(ctx, b), bigint.of(-7));
    assert.equal(a.add(ctx, b.negate()), bigint.of(7));
    assert.equal(a.negate().add(ctx, b.negate()), bigint.of(-17));
    assert.equal(a.subtract(ctx, b), bigint.of(7));
    assert.equal(a.negate().subtract(ctx, b), bigint.of(-17));
    assert.equal(a.subtract(ctx, b.negate()), bigint.of(17));
    assert.equal(a.negate().subtract(ctx, b.negate()), bigint.of(-7));
    assert.equal(a.multiply(ctx, b), bigint.of(60));
    assert.equal(a.negate().multiply(ctx, b), bigint.of(-60));
    assert.equal(a.multiply(ctx, b.negate()), bigint.of(-60));
    assert.equal(a.negate().multiply(ctx, b.negate()), bigint.of(60));
    // The smaller magnitude on the left, where `add` has to swap the operands
    // before it can subtract.
    assert.equal(b.negate().add(ctx, a), bigint.of(7));
    assert.equal(b.add(ctx, a.negate()), bigint.of(-7));
}

// --- parse, at the shapes that are not numbers -----------------------------------------

test "parse reads leading zeros and a signed zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Leading zeros are digits like any other and are folded away by the
    // arithmetic, so the value is the number and `text` writes it without them.
    assert.equal(bigint.parse(ctx, "007"), .Some(bigint.of(7)));
    assert.equal(bigint.parse(ctx, "-007"), .Some(bigint.of(-7)));
    assert.equal(bigint.parse(ctx, "0000"), .Some(bigint.zero()));
    assert.equal(bigint.parse(ctx, "-0000"), .Some(bigint.zero()));
    assert.equal(assert.some(bigint.parse(ctx, "007")).text(ctx), "7");
    assert.equal(assert.some(bigint.parse(ctx, "00000000000000000001")).text(ctx), "1");
    // `-0` is zero, and zero has one shape however it was reached.
    assert.equal(assert.some(bigint.parse(ctx, "-0")), bigint.zero());
    assert.equal(assert.some(bigint.parse(ctx, "-0")).text(ctx), "0");
    assert.equal(
        assert.some(bigint.parse(ctx, "-0")).compare(bigint.zero()),
        Order.Equal,
    );
}

test "parse refuses a sign alone and anything that is not a digit" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(bigint.parse(ctx, "-"), .None);
    assert.equal(bigint.parse(ctx, "--1"), .None);
    assert.equal(bigint.parse(ctx, "1-"), .None);
    assert.equal(bigint.parse(ctx, "-1-"), .None);
    assert.equal(bigint.parse(ctx, "a"), .None);
    assert.equal(bigint.parse(ctx, "1a"), .None);
    assert.equal(bigint.parse(ctx, "a1"), .None);
    assert.equal(bigint.parse(ctx, "١٢٣"), .None);
    assert.equal(bigint.parse(ctx, "1\n"), .None);
    assert.equal(bigint.parse(ctx, "9223372036854775808x"), .None);
}

test "parse and text round-trip across the limb boundary" {
    let ctx = context {
        Allocator: alloc(),
    };
    let written = [
        "0",
        "1",
        "-1",
        "16777215",
        "16777216",
        "16777217",
        "281474976710655",
        "281474976710656",
        "-281474976710656",
        "4722366482869645213696",
        "9223372036854775807",
        "-9223372036854775808",
        "9223372036854775808",
    ];
    let broken = written.filterCtx(ctx, fn(c, t) => {
        match (bigint.parse(c, t)) {
            .None => true,
            .Some(v) => v.text(c) != t,
        }
    });
    assert.isEmpty(broken);
}

test "toInt is exact at the Int limits and one past each of them" {
    let ctx = context {
        Allocator: alloc(),
    };
    let top = assert.some(bigint.parse(ctx, "9223372036854775807"));
    let bottom = assert.some(bigint.parse(ctx, "-9223372036854775808"));
    assert.equal(top.toInt(), .Ok(number.maxValue<I64>()));
    assert.equal(bottom.toInt(), .Ok(number.minValue<I64>()));
    // One past either end has no `Int`, and the error names the target.
    let over = assert.some(bigint.parse(ctx, "9223372036854775808"));
    let under = assert.some(bigint.parse(ctx, "-9223372036854775809"));
    assert.isTrue(over.toInt().isErr());
    assert.isTrue(under.toInt().isErr());
    assert.equal(assert.err(over.toInt()).target, "Int");
    // The limb boundary is nowhere near either end, so it converts.
    assert.equal(bigint.of(16777216).toInt(), .Ok(16777216));
    assert.equal(bigint.of(-281474976710656).toInt(), .Ok(-281474976710656));
    // And a number many limbs long does not.
    assert.isTrue(bigint.of(2).power(ctx, 200).toInt().isErr());
}
