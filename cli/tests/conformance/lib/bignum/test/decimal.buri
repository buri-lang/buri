// core/decimal — a number whose value is its digits.
//
// Two claims, and every test below is one of them: the arithmetic is exact or
// it answers `.None`, and `roundTo` sends a tie to the even neighbour. Both are
// what money wants and neither is what a `Float` gives.
//
// Ordinary Buri over two `Int`s with no host anywhere in it, so the assertions
// are answers rather than anything a platform decides.

from "core/decimal" import * as decimal;
from "core/decimal" import { Decimal };
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/math" import * as math;
from "core/number" import * as number;
from "core/order" import { Order };
from "core/testing/assert" import * as assert;

// --- of, and the canonical form --------------------------------------------------

test "of puts the point where the scale says" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(1999, 2).text(ctx), "19.99");
    assert.equal(decimal.of(5, 2).text(ctx), "0.05");
    assert.equal(decimal.of(-5, 2).text(ctx), "-0.05");
    assert.equal(decimal.of(7, 0).text(ctx), "7");
    assert.equal(decimal.of(0, 5).text(ctx), "0");
    assert.equal(decimal.of(123, 3).text(ctx), "0.123");
}

test "a trailing zero is absorbed into the scale" {
    assert.equal(decimal.of(100, 2), decimal.of(1, 0));
    assert.equal(decimal.of(150, 2), decimal.of(15, 1));
    assert.equal(decimal.of(1000, 3), decimal.of(1, 0));
    assert.equal(decimal.of(0, 9), decimal.of(0, 0));
    // The zeros before the point stay, because the scale cannot absorb them.
    assert.notEqual(decimal.of(100, 0), decimal.of(10, 0));
}

test "a negative scale is read as zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(5, -2), decimal.of(5, 0));
    assert.equal(decimal.of(5, -2).text(ctx), "5");
    // Multiplying is how you get the other thing.
    assert.equal(
        assert.some(decimal.of(5, 0).multiply(decimal.of(100, 0))).text(ctx),
        "500",
    );
}

test "equality is numeric because the shape is canonical" {
    assert.equal(decimal.of(10, 1), decimal.of(1, 0));
    assert.equal(decimal.of(10, 1).hash(), decimal.of(1, 0).hash());
    assert.equal(decimal.of(0, 0).hash(), decimal.of(0, 7).hash());
    assert.notEqual(decimal.of(1, 1), decimal.of(1, 0));
}

// --- parse --------------------------------------------------------------------------

test "parse reads a decimal numeral" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.parse("0"), .Some(decimal.of(0, 0)));
    assert.equal(decimal.parse("-0"), .Some(decimal.of(0, 0)));
    assert.equal(decimal.parse("19.99"), .Some(decimal.of(1999, 2)));
    assert.equal(decimal.parse("-19.99"), .Some(decimal.of(-1999, 2)));
    assert.equal(decimal.parse("0.5"), .Some(decimal.of(5, 1)));
    assert.equal(decimal.parse("1.50"), .Some(decimal.of(15, 1)));
    assert.equal(assert.some(decimal.parse("1.50")).text(ctx), "1.5");
    assert.equal(decimal.parse("42"), .Some(decimal.of(42, 0)));
}

test "parse is strict" {
    assert.equal(decimal.parse(""), .None);
    assert.equal(decimal.parse("-"), .None);
    assert.equal(decimal.parse("."), .None);
    assert.equal(decimal.parse("1."), .None);
    assert.equal(decimal.parse(".5"), .None);
    assert.equal(decimal.parse("1.2.3"), .None);
    assert.equal(decimal.parse("+1"), .None);
    assert.equal(decimal.parse(" 1"), .None);
    assert.equal(decimal.parse("1 "), .None);
    assert.equal(decimal.parse("1_000"), .None);
    assert.equal(decimal.parse("1e3"), .None);
}

test "parse answers .None past what an Int holds" {
    assert.equal(
        decimal.parse("9223372036854775807"),
        .Some(decimal.of(number.maxValue<I64>(), 0)),
    );
    assert.equal(
        decimal.parse("-9223372036854775808"),
        .Some(decimal.of(number.minValue<I64>(), 0)),
    );
    assert.equal(decimal.parse("9223372036854775808"), .None);
    assert.equal(decimal.parse("99999999999999999999999"), .None);
}

test "parse and text round-trip" {
    let ctx = context {
        Allocator: alloc(),
    };
    let written = ["0", "1", "-1", "19.99", "-0.05", "1234567.891", "0.000001"];
    let broken = written.filterCtx(ctx, fn(c, t) => {
        match (decimal.parse(t)) {
            .None => true,
            .Some(d) => d.text(c) != t,
        }
    });
    assert.isEmpty(broken);
}

// --- add, subtract and multiply ------------------------------------------------------------

test "add raises both sides to the larger scale" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        assert.some(decimal.of(10, 1).add(decimal.of(20, 2))).text(ctx),
        "1.2",
    );
    assert.equal(assert.some(decimal.of(1, 0).add(decimal.of(1, 2))).text(ctx), "1.01");
    assert.equal(
        assert.some(decimal.of(1999, 2).add(decimal.of(1, 2))).text(ctx),
        "20",
    );
    assert.equal(
        assert.some(decimal.of(0, 0).add(decimal.of(5, 3))).text(ctx),
        "0.005",
    );
}

test "the sum a Float gets wrong" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `0.1 + 0.2` is `0.30000000000000004` as doubles.
    assert.notEqual(0.1 + 0.2, 0.3);
    let sum = assert.some(decimal.of(1, 1).add(decimal.of(2, 1)));
    assert.equal(sum.text(ctx), "0.3");
    assert.equal(sum, decimal.of(3, 1));
}

test "subtract is add with the other sign" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        assert.some(decimal.of(1999, 2).subtract(decimal.of(99, 2))).text(ctx),
        "19",
    );
    assert.equal(
        assert.some(decimal.of(1, 0).subtract(decimal.of(1, 2))).text(ctx),
        "0.99",
    );
    assert.equal(
        assert.some(decimal.of(5, 1).subtract(decimal.of(5, 1))),
        decimal.of(0, 0),
    );
    assert.equal(
        assert.some(decimal.of(1, 1).subtract(decimal.of(2, 1))).text(ctx),
        "-0.1",
    );
}

test "multiply adds the scales and keeps every digit" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        assert.some(decimal.of(5, 1).multiply(decimal.of(5, 1))).text(ctx),
        "0.25",
    );
    assert.equal(
        assert.some(decimal.of(1999, 2).multiply(decimal.of(3, 0))).text(ctx),
        "59.97",
    );
    assert.equal(
        assert.some(decimal.of(0, 0).multiply(decimal.of(1999, 2))),
        decimal.of(0, 0),
    );
    assert.equal(
        assert.some(decimal.of(-5, 1).multiply(decimal.of(5, 1))).text(ctx),
        "-0.25",
    );
}

test "every arithmetic method answers .None where the units would not fit" {
    let top = decimal.of(number.maxValue<I64>(), 0);
    let bottom = decimal.of(number.minValue<I64>(), 0);
    assert.equal(top.add(decimal.of(1, 0)), .None);
    assert.equal(bottom.subtract(decimal.of(1, 0)), .None);
    assert.equal(top.multiply(top), .None);
    // Raising to a common scale is where a small pair can fail.
    assert.equal(decimal.of(1, 0).add(decimal.of(1, 19)), .None);
    assert.isTrue(decimal.of(1, 0).add(decimal.of(1, 18)).isSome());
}

test "add and subtract undo each other" {
    let a = decimal.of(1999, 2);
    let b = decimal.of(7, 3);
    assert.equal(a.add(b).andThen(fn(v) => v.subtract(b)), .Some(a));
    assert.equal(a.subtract(b).andThen(fn(v) => v.add(b)), .Some(a));
}

test "negate flips the sign, and fails only where the negation does not fit" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(assert.some(decimal.of(1999, 2).negate()).text(ctx), "-19.99");
    assert.equal(assert.some(decimal.of(0, 0).negate()), decimal.of(0, 0));
    assert.equal(decimal.of(number.minValue<I64>(), 0).negate(), .None);
    assert.isFalse(decimal.of(1999, 2).isZero());
    assert.isTrue(decimal.of(0, 3).isZero());
}

// --- roundTo -------------------------------------------------------------------------

test "roundTo sends a tie to the even neighbour" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(25, 2).roundTo(1).text(ctx), "0.2");
    assert.equal(decimal.of(35, 2).roundTo(1).text(ctx), "0.4");
    assert.equal(decimal.of(45, 2).roundTo(1).text(ctx), "0.4");
    assert.equal(decimal.of(55, 2).roundTo(1).text(ctx), "0.6");
    assert.equal(decimal.of(15, 1).roundTo(0).text(ctx), "2");
    assert.equal(decimal.of(25, 1).roundTo(0).text(ctx), "2");
    assert.equal(decimal.of(5, 1).roundTo(0).text(ctx), "0");
}

test "roundTo takes a negative tie to the even neighbour too" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(-25, 2).roundTo(1).text(ctx), "-0.2");
    assert.equal(decimal.of(-35, 2).roundTo(1).text(ctx), "-0.4");
    assert.equal(decimal.of(-15, 1).roundTo(0).text(ctx), "-2");
    assert.equal(decimal.of(-5, 1).roundTo(0).text(ctx), "0");
}

test "roundTo rounds to the nearer number where there is one" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(24, 2).roundTo(1).text(ctx), "0.2");
    assert.equal(decimal.of(26, 2).roundTo(1).text(ctx), "0.3");
    assert.equal(decimal.of(-26, 2).roundTo(1).text(ctx), "-0.3");
    assert.equal(decimal.of(314159, 5).roundTo(2).text(ctx), "3.14");
    assert.equal(decimal.of(314159, 5).roundTo(4).text(ctx), "3.1416");
}

test "a column of ties does not drift" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Four ties, two up and two down, so the rounded total is the true total.
    let ties = [
        decimal.of(5, 1),
        decimal.of(15, 1),
        decimal.of(25, 1),
        decimal.of(35, 1),
    ];
    let rounded = ties.fold(fn(acc, d) => acc + d.roundTo(0).units, 0);
    assert.equal(rounded, 8);
    assert.equal(ties.fold(fn(acc, d) => acc + d.units, 0), 80);
}

test "roundTo at or above the current scale changes nothing" {
    let a = decimal.of(1999, 2);
    assert.equal(a.roundTo(2), a);
    assert.equal(a.roundTo(5), a);
    assert.equal(decimal.of(0, 0).roundTo(4), decimal.of(0, 0));
}

test "roundTo with a negative scale is roundTo zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(1999, 2).roundTo(-3), decimal.of(1999, 2).roundTo(0));
    assert.equal(decimal.of(1999, 2).roundTo(0).text(ctx), "20");
}

test "roundTo drops more digits than an Int has powers of ten" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The scale is past 10^19, so the quotient is zero and only the halfway
    // test can lift it.
    assert.equal(decimal.of(number.maxValue<I64>(), 19).roundTo(0).text(ctx), "1");
    assert.equal(decimal.of(1, 19).roundTo(0).text(ctx), "0");
    assert.equal(decimal.of(number.minValue<I64>(), 19).roundTo(0).text(ctx), "-1");
    assert.equal(decimal.of(1, 30).roundTo(0).text(ctx), "0");
}

// --- toFloat -------------------------------------------------------------------------

test "toFloat is the nearest double" {
    assert.equal(decimal.of(1, 0).toFloat(), 1.0);
    assert.equal(decimal.of(1999, 2).toFloat(), 19.99);
    assert.equal(decimal.of(1, 1).toFloat(), 0.1);
    assert.equal(decimal.of(-5, 2).toFloat(), -0.05);
    assert.equal(decimal.of(0, 0).toFloat(), 0.0);
    assert.equal(decimal.of(1, 400).toFloat(), 0.0);
}

test "toFloat is where the exactness stops" {
    // A tenth is not a binary fraction, which is the whole reason this type
    // exists — so three tenths added as doubles and as decimals differ.
    let asFloats = decimal.of(1, 1).toFloat() + decimal.of(2, 1).toFloat();
    assert.notEqual(asFloats, decimal.of(3, 1).toFloat());
    assert.isTrue(math.isCloseAbsolute(asFloats, 0.3, 1.0e-15));
}

// --- Ordered and Show -----------------------------------------------------------------------

test "order is numeric and not the field order a derive would give" {
    // `units` sorts before `scale`, so a derived order would put `1` below
    // `0.5`.
    assert.equal(decimal.of(1, 0).compare(decimal.of(5, 1)), Order.Greater);
    assert.equal(decimal.of(5, 1).compare(decimal.of(1, 0)), Order.Less);
    assert.equal(decimal.of(1, 0).compare(decimal.of(10, 1)), Order.Equal);
    assert.equal(decimal.of(-1, 0).compare(decimal.of(1, 0)), Order.Less);
    assert.equal(decimal.of(-5, 1).compare(decimal.of(-1, 0)), Order.Greater);
}

test "order is exact even where the common scale would not fit" {
    // `1` at scale 19 is past `Int`, so the comparison cannot raise it — and
    // the value that will not fit is the larger magnitude by that very fact.
    assert.equal(decimal.of(1, 0).compare(decimal.of(1, 19)), Order.Greater);
    assert.equal(decimal.of(1, 19).compare(decimal.of(1, 0)), Order.Less);
    assert.equal(decimal.of(-1, 0).compare(decimal.of(1, 19)), Order.Less);
    assert.equal(decimal.of(1, 19).compare(decimal.of(-1, 0)), Order.Greater);
}

test "sorting puts them in numeric order" {
    let ctx = context {
        Allocator: alloc(),
    };
    let values = [
        decimal.of(1, 0),
        decimal.of(5, 1),
        decimal.of(-1, 0),
        decimal.of(0, 0),
    ];
    let sorted = values.sort(ctx).mapCtx(ctx, fn(c, d) => d.text(c));
    assert.equal(sorted, ["-1", "0", "0.5", "1"]);
}

test "Show is text" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(1999, 2).show(ctx), "19.99");
    assert.equal(decimal.of(0, 0).show(ctx), "0");
    assert.equal(decimal.of(-5, 3).show(ctx), "-0.005");
}

test "text reaches both ends of Int with a scale on it" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        decimal.of(number.maxValue<I64>(), 2).text(ctx),
        "92233720368547758.07",
    );
    assert.equal(
        decimal.of(number.minValue<I64>(), 2).text(ctx),
        "-92233720368547758.08",
    );
}

// --- Scale zero, and the largest scale there is ----------------------------------------
//
// The scale is an `Int`, so it runs from zero to `maxValue`. At zero a
// `Decimal` is a whole number and `text` is `str.fromInt`; at the top the value
// is a fraction so small that nothing can be added to it and no digit of it can
// be written. Both ends are reachable through `of`, so both have to answer.

test "at scale zero a Decimal is the Int it holds" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.of(0, 0).text(ctx), "0");
    assert.equal(decimal.of(7, 0).text(ctx), "7");
    assert.equal(decimal.of(-7, 0).text(ctx), "-7");
    assert.equal(
        decimal.of(number.maxValue<I64>(), 0).text(ctx),
        "9223372036854775807",
    );
    assert.equal(
        decimal.of(number.minValue<I64>(), 0).text(ctx),
        "-9223372036854775808",
    );
    // A trailing zero is a digit at scale zero and is kept, because there is no
    // scale left for it to be absorbed into.
    assert.equal(decimal.of(100, 0).text(ctx), "100");
    assert.equal(decimal.of(100, 0).scale, 0);
    assert.equal(decimal.of(100, 0).units, 100);
    // Where at any scale above zero it *is* absorbed.
    assert.equal(decimal.of(100, 2), decimal.of(1, 0));
    assert.equal(decimal.of(100, 1), decimal.of(10, 0));
    // Whole-number arithmetic at scale zero is `Int` arithmetic.
    assert.equal(decimal.of(7, 0).add(decimal.of(-7, 0)), .Some(decimal.of(0, 0)));
    assert.equal(
        assert.some(decimal.of(7, 0).multiply(decimal.of(6, 0))).text(ctx),
        "42",
    );
    assert.equal(decimal.of(7, 0).roundTo(0), decimal.of(7, 0));
    assert.equal(decimal.of(7, 0).toFloat(), 7.0);
}

test "the largest scale is reachable and answers everywhere it can" {
    let tiny = decimal.of(1, number.maxValue<I64>());
    assert.equal(tiny.scale, number.maxValue<I64>());
    assert.equal(tiny.units, 1);
    assert.isFalse(tiny.isZero());
    // A double has no exponent this small, so the conversion is zero.
    assert.equal(tiny.toFloat(), 0.0);
    // Rounding to any scale below it drops every digit, and the value is far
    // below a half, so nothing is lifted.
    assert.equal(tiny.roundTo(0), decimal.of(0, 0));
    assert.equal(tiny.roundTo(5), decimal.of(0, 0));
    // The sign still flips.
    assert.equal(tiny.negate(), .Some(decimal.of(-1, number.maxValue<I64>())));
    // And it orders below every ordinary number, without the common scale ever
    // being computed.
    assert.equal(tiny.compare(decimal.of(1, 0)), Order.Less);
    assert.equal(decimal.of(1, 0).compare(tiny), Order.Greater);
    assert.equal(tiny.compare(decimal.of(-1, 0)), Order.Greater);
    assert.equal(tiny.compare(tiny), Order.Equal);
}

test "the largest scale a value can be written at" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Eighteen zeros and a one: the smallest number `parse` and `text` still
    // round-trip, because raising a scale-zero value to it is nineteen powers
    // of ten and that is where an `Int` stops.
    assert.equal(decimal.of(1, 18).text(ctx), "0.000000000000000001");
    assert.equal(decimal.parse("0.000000000000000001"), .Some(decimal.of(1, 18)));
    assert.isTrue(decimal.of(1, 0).add(decimal.of(1, 18)).isSome());
    assert.equal(decimal.of(1, 0).add(decimal.of(1, 19)), .None);
    // One digit further still parses — the scale comes from the text and the
    // units from the digits, and neither has left `Int`.
    assert.equal(decimal.parse("0.0000000000000000001"), .Some(decimal.of(1, 19)));
    assert.equal(decimal.of(1, 19).text(ctx), "0.0000000000000000001");
}

// --- Every path that answers .None -------------------------------------------------------

test "add and subtract answer .None at each of the three places they can" {
    let top = decimal.of(number.maxValue<I64>(), 0);
    let bottom = decimal.of(number.minValue<I64>(), 0);
    // The sum itself does not fit.
    assert.equal(top.add(decimal.of(1, 0)), .None);
    assert.equal(bottom.subtract(decimal.of(1, 0)), .None);
    assert.equal(top.subtract(bottom), .None);
    assert.equal(bottom.add(bottom), .None);
    // Raising the *left* side to the common scale does not fit.
    assert.equal(top.add(decimal.of(1, 1)), .None);
    assert.equal(top.subtract(decimal.of(1, 1)), .None);
    // Raising the *right* side does not fit.
    assert.equal(decimal.of(1, 1).add(top), .None);
    assert.equal(decimal.of(1, 1).subtract(top), .None);
    // A zero is short-circuited rather than scaled, so it survives a scale no
    // number could be raised through.
    assert.equal(
        decimal.of(0, 0).add(decimal.of(1, number.maxValue<I64>())).isSome(),
        true,
    );
    assert.equal(
        decimal.of(1, number.maxValue<I64>()).subtract(decimal.of(0, 0)).isSome(),
        true,
    );
}

test "multiply answers .None from the units and from the scales alike" {
    let top = decimal.of(number.maxValue<I64>(), 0);
    // The product of the units does not fit.
    assert.equal(top.multiply(top), .None);
    assert.equal(top.multiply(decimal.of(2, 0)), .None);
    assert.equal(top.multiply(decimal.of(2, 5)), .None);
    // The units fit and the *scales* do not: two tiny fractions whose scales
    // add past `maxValue`.
    let tiny = decimal.of(3, number.maxValue<I64>());
    assert.equal(tiny.multiply(tiny), .None);
    assert.equal(tiny.multiply(decimal.of(3, 1)), .None);
    // A zero on either side is canonical zero at scale zero, so it multiplies
    // through whatever the other side's scale is.
    assert.equal(tiny.multiply(decimal.of(0, 0)), .Some(decimal.of(0, 0)));
    assert.equal(decimal.of(0, 0).multiply(tiny), .Some(decimal.of(0, 0)));
}

test "negate answers .None at the one value with no negative" {
    assert.equal(decimal.of(number.minValue<I64>(), 0).negate(), .None);
    assert.equal(decimal.of(number.minValue<I64>(), 7).negate(), .None);
    assert.equal(
        decimal.of(number.maxValue<I64>(), 0).negate(),
        .Some(decimal.of(-9223372036854775807, 0)),
    );
    assert.equal(decimal.of(0, 0).negate(), .Some(decimal.of(0, 0)));
}

test "parse answers .None at every shape and at every overflow" {
    // A sign alone, and a sign with only a point after it.
    assert.equal(decimal.parse("-"), .None);
    assert.equal(decimal.parse("-."), .None);
    assert.equal(decimal.parse("--1"), .None);
    assert.equal(decimal.parse("1-"), .None);
    // The whole part overflows before the point is ever reached.
    assert.equal(decimal.parse("99999999999999999999.5"), .None);
    // The digits after the point are what tips it over.
    assert.equal(decimal.parse("9223372036854775807.1"), .None);
    assert.equal(decimal.parse("922337203685477580.71"), .None);
    // `maxValue + 1` is not mistaken for `minValue`: the accumulator counts
    // below zero, so the negative numeral parses and the positive one does not.
    assert.equal(
        decimal.parse("-9223372036854775808"),
        .Some(decimal.of(number.minValue<I64>(), 0)),
    );
    assert.equal(decimal.parse("9223372036854775808"), .None);
    assert.equal(decimal.parse("-9223372036854775809"), .None);
}

test "parse reads leading zeros and a signed zero" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(decimal.parse("007"), .Some(decimal.of(7, 0)));
    assert.equal(decimal.parse("-007"), .Some(decimal.of(-7, 0)));
    assert.equal(decimal.parse("0000"), .Some(decimal.of(0, 0)));
    assert.equal(decimal.parse("-0.0"), .Some(decimal.of(0, 0)));
    assert.equal(decimal.parse("0.00"), .Some(decimal.of(0, 0)));
    assert.equal(decimal.parse("007.50"), .Some(decimal.of(75, 1)));
    assert.equal(assert.some(decimal.parse("007.50")).text(ctx), "7.5");
    // A zero of either sign is the one zero, at scale zero.
    assert.equal(assert.some(decimal.parse("-0.0")).scale, 0);
    assert.equal(assert.some(decimal.parse("-0.0")).text(ctx), "0");
    assert.isTrue(assert.some(decimal.parse("-0.000")).isZero());
}
