// core/crypto — `verifyEd25519` against RFC 8032's vectors, and `verifyEs256` and
// `verifyRs256` against RFC 7515's ES256 and RS256 examples, with the keys read
// every way they arrive.

from "core/bytes" import * as bytes;
from "core/crypto" import * as crypto;
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

fn hex(text: Template): [U8] {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.fromHex(ctx, str.format(ctx, text)).withDefault([])
}

fn text(t: Template): [U8] {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.toUtf8(ctx, str.format(ctx, t))
}

fn ed25519(key: Template, message: Template, signature: Template): Bool {
    match (crypto.ed25519PublicKeyFromRaw(hex(key))) {
        .Ok(k) => crypto.verifyEd25519(k, hex(message), hex(signature)),
        .Err(_) => false,
    }
}

// --- Ed25519, RFC 8032 section 7.1 -----------------------------------------------

let KEY_1: Str = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a";

let SIGNATURE_1: Str =
    "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b";

let KEY_2: Str = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c";

let SIGNATURE_2: Str =
    "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00";

test "test 1, the empty message" {
    assert.isTrue(ed25519(KEY_1, "", SIGNATURE_1));
}

test "test 2, one byte" {
    assert.isTrue(ed25519(KEY_2, "72", SIGNATURE_2));
}

test "test 3, two bytes" {
    assert.isTrue(
        ed25519(
            "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
            "af82",
            "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a",
        ),
    );
}

test "test SHA(abc), a 64-byte message" {
    assert.isTrue(
        ed25519(
            "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf",
            "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
            "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704",
        ),
    );
}

test "a changed message is refused" {
    assert.isFalse(ed25519(KEY_2, "73", SIGNATURE_2));
    assert.isFalse(ed25519(KEY_1, "00", SIGNATURE_1));
}

test "a changed signature is refused" {
    // One bit in R, then one bit in S.
    assert.isFalse(
        ed25519(
            KEY_2,
            "72",
            "93a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00",
        ),
    );
    assert.isFalse(
        ed25519(
            KEY_2,
            "72",
            "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da095ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00",
        ),
    );
}

test "another key's signature is refused" {
    assert.isFalse(ed25519(KEY_1, "72", SIGNATURE_2));
}

test "S plus the group order is the same point and is still refused" {
    // Test 1's signature with L added to S: a forgery by malleability.
    assert.isFalse(
        ed25519(
            KEY_1,
            "",
            "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901554c8c7872aa064e049dbb3013fbf29380d25bf5f0595bbe24655141438e7a101b",
        ),
    );
}

test "a signature that is not 64 bytes is refused" {
    assert.isFalse(ed25519(KEY_1, "", "e5564300c360ac72"));
    assert.isFalse(ed25519(KEY_1, "", "${SIGNATURE_1}00"));
}

test "a key that is not 32 bytes is not a key" {
    assert.equal(
        crypto.ed25519PublicKeyFromRaw(hex("d75a98")).map(fn(_k) => ()),
        .Err("an Ed25519 key is 32 bytes"),
    );
}

// --- ES256, RFC 7515 appendix A.3 -------------------------------------------------

let JWK_X: Str = "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU";

let JWK_Y: Str = "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0";

let SEC1: Str =
    "047fcdce2770f6c45d4183cbee6fdb4b7b580733357be9ef13bacf6e3c7bd15445c7f144cd1bbd9b7e872cdfedb9eeb9f4b3695d6ea90b24ad8a4623288588e5ad";

let SIGNING_INPUT: Str =
    "eyJhbGciOiJFUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ";

let JWS_SIGNATURE: Str =
    "DtEhU3ljbEg8L38VWAfUAqOyKAM6-Xx-F4GawxaepmXFCgfTjDxw5djxLa8ISlSApmWQxfKTUJqPP3-Kg6NU1Q";

fn jwkKey(): crypto.P256PublicKey {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.ok(crypto.p256PublicKeyFromJwk(ctx, JWK_X, JWK_Y))
}

fn jwsSignature(): [U8] {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.fromBase64Url(ctx, JWS_SIGNATURE).withDefault([])
}

test "the RFC's ES256 JWS checks against its JWK" {
    assert.isTrue(crypto.verifyEs256(jwkKey(), text(SIGNING_INPUT), jwsSignature()));
}

test "the same key read as SEC1 and as SPKI checks too" {
    let ctx = context {
        Allocator: alloc(),
    };
    let sec1 = assert.ok(crypto.p256PublicKeyFromSec1(hex(SEC1)));
    let spki = assert.ok(
        crypto.p256PublicKeyFromSpki(
            ctx,
            hex("3059301306072a8648ce3d020106082a8648ce3d030107034200${SEC1}"),
        ),
    );
    assert.isTrue(crypto.verifyEs256(sec1, text(SIGNING_INPUT), jwsSignature()));
    assert.isTrue(crypto.verifyEs256(spki, text(SIGNING_INPUT), jwsSignature()));
}

test "a changed payload is refused" {
    assert.isFalse(
        crypto.verifyEs256(jwkKey(), text("${SIGNING_INPUT}x"), jwsSignature()),
    );
}

test "a changed ES256 signature is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    let signature = jwsSignature();
    let changed = signature
        .slice(ctx, 0, 40)
        .push(ctx, (signature.get(40).withDefault(0).toI64() ^ 1).wrapToU8())
        .concat(ctx, signature.slice(ctx, 41, 64));
    assert.isFalse(crypto.verifyEs256(jwkKey(), text(SIGNING_INPUT), changed));
    assert.isFalse(
        crypto.verifyEs256(jwkKey(), text(SIGNING_INPUT), signature.slice(ctx, 0, 63)),
    );
    // r and s of zero, which no signature has.
    assert.isFalse(
        crypto.verifyEs256(jwkKey(), text(SIGNING_INPUT), hex("00".repeat(ctx, 64))),
    );
}

test "another key is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The P-256 generator, which is on the curve and is not the signer.
    let other = assert.ok(
        crypto.p256PublicKeyFromSec1(
            hex(
                "046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
            ),
        ),
    );
    assert.isFalse(crypto.verifyEs256(other, text(SIGNING_INPUT), jwsSignature()));
}

test "a point off the curve is refused" {
    // The RFC's key with the last bit of y flipped.
    let off = assert.ok(
        crypto.p256PublicKeyFromSec1(
            hex(
                "047fcdce2770f6c45d4183cbee6fdb4b7b580733357be9ef13bacf6e3c7bd15445c7f144cd1bbd9b7e872cdfedb9eeb9f4b3695d6ea90b24ad8a4623288588e5ac",
            ),
        ),
    );
    assert.isFalse(crypto.verifyEs256(off, text(SIGNING_INPUT), jwsSignature()));
}

test "keys in the wrong shape are not keys" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(
        crypto.p256PublicKeyFromJwk(ctx, "f83OJ3D2", JWK_Y).map(fn(_k) => ()),
        .Err("a P-256 coordinate is 32 bytes"),
    );
    assert.equal(
        crypto.p256PublicKeyFromJwk(ctx, "not base64!", JWK_Y).map(fn(_k) => ()),
        .Err("a JWK coordinate is base64url"),
    );
    // The compressed form: 0x02 or 0x03, then x.
    assert.equal(
        crypto
            .p256PublicKeyFromSec1(
                hex(
                    "037fcdce2770f6c45d4183cbee6fdb4b7b580733357be9ef13bacf6e3c7bd15445",
                ),
            )
            .map(fn(_k) => ()),
        .Err("a P-256 key is 65 bytes starting with 0x04"),
    );
    assert.equal(
        crypto.p256PublicKeyFromSpki(ctx, hex(SEC1)).map(fn(_k) => ()),
        .Err("not a P-256 SubjectPublicKeyInfo"),
    );
}

// --- RS256, RFC 7515 appendix A.2 -------------------------------------------------

let RSA_N: Str =
    "ofgWCuLjybRlzo0tZWJjNiuSfb4p4fAkd_wWJcyQoTbji9k0l8W26mPddxHmfHQp-Vaw-4qPCJrcS2mJPMEzP1Pt0Bm4d4QlL-yRT-SFd2lZS-pCgNMsD1W_YpRPEwOWvG6b32690r2jZ47soMZo9wGzjb_7OMg0LOL-bSf63kpaSHSXndS5z5rexMdbBYUsLA9e-KXBdQOS-UTo7WTBEMa2R2CapHg665xsmtdVMTBQY4uDZlxvb3qCo5ZwKh9kG4LT6_I5IhlJH7aGhyxXFvUK-DWNmoudF8NAco9_h9iaGNj8q2ethFkMLs91kzk2PAcDTW9gb54h4FRWyuXpoQ";

// The same modulus in hex, to build DER around.
let RSA_N_HEX: Str =
    "";

// The key's SubjectPublicKeyInfo as `openssl` writes it, up to the modulus,
// and the exponent after it.
let RSA_SPKI_HEAD: Str =
    "30820122300d06092a864886f70d01010105000382010f003082010a0282010100";

let RSA_SPKI_TAIL: Str = "0203010001";

let RS256_SIGNING_INPUT: Str =
    "eyJhbGciOiJSUzI1NiJ9.eyJpc3MiOiJqb2UiLA0KICJleHAiOjEzMDA4MTkzODAsDQogImh0dHA6Ly9leGFtcGxlLmNvbS9pc19yb290Ijp0cnVlfQ";

let RS256_SIGNATURE: Str =
    "cC4hiUPoj9Eetdgtv3hF80EGrhuB__dzERat0XF9g2VtQgr9PJbu3XOiZj5RZmh7AAuHIm4Bh-0Qc_lF5YKt_O8W2Fp5jujGbds9uJdbF9CUAr7t1dnZcAcQjbKBYNX4BAynRFdiuB--f_nZLgrnbyTyWzO75vRK5h6xBArLIARNPvkSjtQBMHlb1L07Qe7K0GarZRmB_eSN9383LcOLn6_dO--xi12jzDwusC-eOkHWEsqtFZESc6BfI7noOPqvhJ1phCnvWh6IeYI2w9QOYEUipUTI8np6LbgGY9Fs98rqVt5AXLIhWkWywlVmtVrBp0igcN_IoypGlUPQGe77Rw";

fn rsaKey(): crypto.RsaPublicKey {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.ok(crypto.rsaPublicKeyFromJwk(ctx, RSA_N, "AQAB"))
}

fn rs256Signature(): [U8] {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.fromBase64Url(ctx, RS256_SIGNATURE).withDefault([])
}

fn rs256(signature: [U8]): Bool {
    crypto.verifyRs256(rsaKey(), text(RS256_SIGNING_INPUT), signature)
}

fn jwk(n: [U8], e: [U8]): Result<(), Str> {
    let ctx = context {
        Allocator: alloc(),
    };
    crypto
        .rsaPublicKeyFromJwk(ctx, bytes.toBase64Url(ctx, n), bytes.toBase64Url(ctx, e))
        .map(fn(_k) => ())
}

fn spki(der: [U8]): Result<(), Str> {
    let ctx = context {
        Allocator: alloc(),
    };
    crypto.rsaPublicKeyFromSpki(ctx, der).map(fn(_k) => ())
}

test "the RFC's RS256 JWS checks against its JWK" {
    assert.isTrue(rs256(rs256Signature()));
}

test "the same RSA key read as SPKI checks too" {
    let ctx = context {
        Allocator: alloc(),
    };
    let key = assert.ok(
        crypto.rsaPublicKeyFromSpki(
            ctx,
            hex("${RSA_SPKI_HEAD}${RSA_N_HEX}${RSA_SPKI_TAIL}"),
        ),
    );
    assert.isTrue(crypto.verifyRs256(key, text(RS256_SIGNING_INPUT), rs256Signature()));
}

test "a changed RS256 payload is refused" {
    assert.isFalse(
        crypto.verifyRs256(rsaKey(), text("${RS256_SIGNING_INPUT}x"), rs256Signature()),
    );
}

test "a changed RS256 signature is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    let signature = rs256Signature();
    let changed = signature
        .slice(ctx, 0, 100)
        .push(ctx, (signature.get(100).withDefault(0).toI64() ^ 1).wrapToU8())
        .concat(ctx, signature.slice(ctx, 101, 256));
    assert.isFalse(rs256(changed));
}

test "an RS256 signature as long as the modulus is the only length checked" {
    let ctx = context {
        Allocator: alloc(),
    };
    let signature = rs256Signature();
    assert.isFalse(rs256(signature.slice(ctx, 0, 255)));
    assert.isFalse(rs256(hex("00").concat(ctx, signature)));
    assert.isFalse(rs256(signature.concat(ctx, hex("00"))));
    assert.isFalse(rs256([]));
}

test "another RSA key is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The RFC's modulus with one bit changed in the middle: still odd and 2048
    // bits, and not the signer.
    let n = hex(RSA_N_HEX);
    let other = n
        .slice(ctx, 0, 128)
        .push(ctx, (n.get(128).withDefault(0).toI64() ^ 4).wrapToU8())
        .concat(ctx, n.slice(ctx, 129, 256));
    let key = assert.ok(
        crypto.rsaPublicKeyFromJwk(ctx, bytes.toBase64Url(ctx, other), "AQAB"),
    );
    assert.isFalse(
        crypto.verifyRs256(key, text(RS256_SIGNING_INPUT), rs256Signature()),
    );
}

test "a JWK modulus with a leading zero octet is the same key" {
    assert.equal(jwk(hex("00${RSA_N_HEX}"), hex("010001")), .Ok(()));
}

test "a modulus outside 2048 to 8192 bits is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = hex(RSA_N_HEX);
    let size = "an RSA modulus is 2048 to 8192 bits";
    // 1024 bits.
    assert.equal(
        jwk(n.slice(ctx, 0, 127).concat(ctx, hex("01")), hex("03")),
        .Err(size),
    );
    // 2047 bits: 256 octets with the top bit clear.
    assert.equal(
        jwk(hex("7f").concat(ctx, n.slice(ctx, 1, 256)), hex("03")),
        .Err(size),
    );
    // 8193 bits.
    assert.equal(
        jwk(hex("01").concat(ctx, hex("ff".repeat(ctx, 1024))), hex("03")),
        .Err(size),
    );
    assert.equal(jwk([], hex("03")), .Err(size));
    // 8192 bits is the top of the range.
    assert.equal(jwk(hex("ff".repeat(ctx, 1024)), hex("03")), .Ok(()));
}

test "an even modulus is refused" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = hex(RSA_N_HEX);
    assert.equal(
        jwk(n.slice(ctx, 0, 255).concat(ctx, hex("a0")), hex("010001")),
        .Err("an RSA modulus is odd"),
    );
}

test "an even, tiny or huge exponent is refused" {
    let n = hex(RSA_N_HEX);
    let bad = "an RSA exponent is odd, at least 3 and below 2^33";
    assert.equal(jwk(n, hex("01")), .Err(bad));
    assert.equal(jwk(n, hex("02")), .Err(bad));
    assert.equal(jwk(n, hex("010000")), .Err(bad));
    assert.equal(jwk(n, hex("0200000001")), .Err(bad));
    assert.equal(jwk(n, hex("010000000001")), .Err(bad));
    assert.equal(jwk(n, []), .Err(bad));
    // 3 and 2^33 - 1 are the ends of the range.
    assert.equal(jwk(n, hex("03")), .Ok(()));
    assert.equal(jwk(n, hex("01ffffffff")), .Ok(()));
}

test "an RSA JWK that is not base64url is not a key" {
    let ctx = context {
        Allocator: alloc(),
    };
    let notBase64 = "a JWK modulus or exponent is base64url";
    assert.equal(
        crypto.rsaPublicKeyFromJwk(ctx, "not base64!", "AQAB").map(fn(_k) => ()),
        .Err(notBase64),
    );
    assert.equal(
        crypto.rsaPublicKeyFromJwk(ctx, RSA_N, "A%AB").map(fn(_k) => ()),
        .Err(notBase64),
    );
}

test "RSA SubjectPublicKeyInfo bytes are read strictly" {
    let notRsa = "not an RSA SubjectPublicKeyInfo";
    assert.equal(spki(hex("${RSA_SPKI_HEAD}${RSA_N_HEX}${RSA_SPKI_TAIL}")), .Ok(()));
    // A P-256 key.
    assert.equal(
        spki(hex("3059301306072a8648ce3d020106082a8648ce3d030107034200${SEC1}")),
        .Err(notRsa),
    );
    // Cut short, and with an octet after the end.
    assert.equal(spki(hex("${RSA_SPKI_HEAD}${RSA_N_HEX}020301")), .Err(notRsa));
    assert.equal(
        spki(hex("${RSA_SPKI_HEAD}${RSA_N_HEX}${RSA_SPKI_TAIL}00")),
        .Err(notRsa),
    );
    assert.equal(spki([]), .Err(notRsa));
    // The outer length in three octets where two will do.
    assert.equal(
        spki(
            hex(
                "3083000122300d06092a864886f70d01010105000382010f003082010a0282010100${RSA_N_HEX}${RSA_SPKI_TAIL}",
            ),
        ),
        .Err(notRsa),
    );
    // The modulus without the zero octet that keeps it positive.
    assert.equal(
        spki(
            hex(
                "30820121300d06092a864886f70d01010105000382010e003082010902820100${RSA_N_HEX}${RSA_SPKI_TAIL}",
            ),
        ),
        .Err(notRsa),
    );
    // The exponent with a zero octet it does not need.
    assert.equal(
        spki(
            hex(
                "30820123300d06092a864886f70d010101050003820110003082010b0282010100${RSA_N_HEX}020400010001",
            ),
        ),
        .Err(notRsa),
    );
    // Bits left unused at the end of the BIT STRING.
    assert.equal(
        spki(
            hex(
                "30820122300d06092a864886f70d01010105000382010f013082010a0282010100${RSA_N_HEX}${RSA_SPKI_TAIL}",
            ),
        ),
        .Err(notRsa),
    );
    // Well-formed, and refused for its size: n = 101, e = 3.
    assert.equal(
        spki(hex("301a300d06092a864886f70d01010105000309003006020165020103")),
        .Err("an RSA modulus is 2048 to 8192 bits"),
    );
}
