// core/crypto — `verifyRs256` against a subset of Wycheproof's RSA PKCS#1 v1.5
// SHA-256 vectors: every valid one and the acceptable one, every edge-case
// signature value, and the first two of each other kind of invalid signature.
//
// From C2SP/wycheproof commit e0df04e0c033f2d25c5051dd06230336c7822358,
// `testvectors_v1/rsa_signature_2048_sha256_test.json`, under the Apache License
// 2.0 in `lib/crypto/wycheproof/LICENSE`. Each key is that file's
// `publicKeyDer`, and each test is named by its `tcId`.

from "core/bytes" import * as bytes;
from "core/crypto" import * as crypto;
from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;

fn hex(text: Str): [U8] {
    let ctx = context {
        Allocator: alloc(),
    };
    bytes.fromHex(ctx, text).withDefault([])
}

fn rs256(key: Str, message: Str, signature: Str): Bool {
    let ctx = context {
        Allocator: alloc(),
    };
    let k = assert.ok(crypto.rsaPublicKeyFromSpki(ctx, hex(key)));
    crypto.verifyRs256(k, hex(message), hex(signature))
}

// Group 1: e = 65537.
let KEY_1: Str =
    "";

// Group 2: e = 3.
let KEY_2: Str =
    "";

// Group 3: e = 3.
let KEY_3: Str =
    "";

test "tcId 1, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "",
            "",
        ),
    );
}

test "tcId 2, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "0000000000000000000000000000000000000000",
            "",
        ),
    );
}

test "tcId 3, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "54657374",
            "",
        ),
    );
}

test "tcId 4, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 5, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "4d657373616765",
            "",
        ),
    );
}

test "tcId 6, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "61",
            "",
        ),
    );
}

test "tcId 7, no flags: valid" {
    assert.isTrue(
        rs256(
            KEY_1,
            "e0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff",
            "",
        ),
    );
}

test "tcId 8, MissingNull: Missing NULL in the ASN encoding" {
    // Acceptable either way; `ring` refuses a DigestInfo without its NULL.
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 9, BerEncodedPadding: length of digestInfo uses long form encoding" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 10, BerEncodedPadding: length of digestInfo contains a leading 0" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 11, InvalidAsnInPadding: length of digestInfo uses 50 instead of 49" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 12, InvalidAsnInPadding: length of digestInfo uses 48 instead of 49" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 24, ModifiedPadding: appending 0's to digestInfo" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 25, ModifiedPadding: prepending 0's to digestInfo" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 215, WrongHash: The algorithm encoded in the padding is MD5 instead of SHA-256." {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 216, WrongHash: The message is hashed with MD5 instead of SHA-256." {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 236, NoHash: The message is not hashed." {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 237, NoHash: The message is not hashed." {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 238, InvalidPadding: using PKCS#1 encryption padding: 0002ff...00<hash>" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 239, InvalidPadding: using PKCS#1 encryption padding: 0002ff...00<message>" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 243, ShortPadding: PKCS#1 padding too short: 000001ff..." {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 244, SignatureMalleability: the signature is not reduced" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 245, SignatureMalleability: the signature is not reduced" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 247, InvalidSignature: the signature is empty" {
    assert.isFalse(rs256(KEY_1, "313233343030", ""));
}

test "tcId 248, InvalidSignature: the signature has value 0" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 249, InvalidSignature: the signature has value 1" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 250, InvalidSignature: the signature has value 2" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 251, InvalidSignature: the signature has value n-1" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 252, InvalidSignature: the signature has value n" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 253, InvalidSignature: the signature has value n+1" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 254, InvalidSignature: the signature has value -1" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 255, WrongPrimitive: RSASSA-PSS signature" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 256, WrongPrimitive: RSASSA-PSS signature" {
    assert.isFalse(
        rs256(
            KEY_1,
            "313233343030",
            "",
        ),
    );
}

test "tcId 258, SmallSignature, SmallPublicKey: small signature" {
    assert.isTrue(
        rs256(
            KEY_2,
            "33363730",
            "",
        ),
    );
}

test "tcId 259, EdgeCaseSignature, SmallPublicKey: signature is close to n" {
    assert.isTrue(
        rs256(
            KEY_3,
            "32353934",
            "",
        ),
    );
}
