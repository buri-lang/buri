// core/crypto — the platform's randomness, and the seeded double that stands in
// for it.
//
// `Entropy` is the one effect whose real implementation no test can assert
// anything about: the whole of what `host.entropy` promises is that nobody can
// write its answer down in advance. What a test can pin is everything around
// it — the length, the shape of a token, the refusal, and the fact that the
// *seeded* implementation the runner binds draws the same sequence on both
// backends, which is what lets a value that was minted here be written into an
// assertion at all.
//
// The sequence itself is `TestRandom`'s. `entropy()` and `rand()` are two handles
// onto one generator, so `crypto.randomBytes` and `random.bytes` at the same
// seed are the same octets — the second half of this file is that agreement,
// asserted rather than assumed.

from "core/bytes" import * as bytes;
from "core/crypto" import * as crypto;
from "core/effect" import { Allocator, Entropy, Random };
from "core/host/testing" import { alloc, entropy, rand };
from "core/random" import * as random;
from "core/testing/assert" import * as assert;

// --- the seeded sequence, which is the same on both backends ------------------

test "the unseeded generator draws the same octets on every backend" {
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
    };
    assert.equal(
        bytes.toHex(ctx, crypto.randomBytes(ctx, 16)),
        "2101c54fd1d01ab22574cb378aaef5b1",
    );
}

test "a seed picks a different sequence, and picks the same one twice" {
    let one = context {
        Allocator: alloc(),
        Entropy: entropy().seed(7),
    };
    let two = context {
        Allocator: alloc(),
        Entropy: entropy().seed(7),
    };
    assert.equal(
        bytes.toHex(one, crypto.randomBytes(one, 16)),
        "e7074345ff94ba57af0afde4a8fe4535",
    );
    // A second handle at the same seed starts from the start of the sequence:
    // `seed` answers a **new** generator rather than reseeding this one.
    assert.equal(
        bytes.toHex(two, crypto.randomBytes(two, 16)),
        "e7074345ff94ba57af0afde4a8fe4535",
    );
}

test "one generator is drawn down rather than restarted" {
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
    };
    let first = crypto.randomBytes(ctx, 8);
    let second = crypto.randomBytes(ctx, 8);
    assert.equal(bytes.toHex(ctx, first), "2101c54fd1d01ab2");
    assert.equal(bytes.toHex(ctx, second), "2574cb378aaef5b1");
}

// --- what a caller gets ---------------------------------------------------------

test "the count is the number of octets, and zero is the empty list" {
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
    };
    assert.equal(crypto.randomBytes(ctx, 0).length(), 0);
    assert.equal(crypto.randomBytes(ctx, 1).length(), 1);
    assert.equal(crypto.randomBytes(ctx, 32).length(), 32);
    // 65536 is WebCrypto's per-call quota, so this is the length that crosses
    // it. The window is the runtime's business and not the caller's.
    assert.equal(crypto.randomBytes(ctx, 65537).length(), 65537);
}

test "a token is hex, twice as long as the entropy it carries" {
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy().seed(7),
    };
    let t = crypto.token(ctx, 16);
    assert.equal(t.length(), 32);
    assert.equal(t, "e7074345ff94ba57af0afde4a8fe4535");
    // Written down as hex and read back as the octets it was made of.
    assert.equal(bytes.fromHex(ctx, t).withDefault([]).length(), 16);
}

test "a token of no octets is the empty string" {
    let ctx = context {
        Allocator: alloc(),
        Entropy: entropy(),
    };
    assert.equal(crypto.token(ctx, 0), "");
}

// --- the two generators are one generator ---------------------------------------

test "the seeded Entropy and the seeded Random draw the same octets" {
    let secret = context {
        Allocator: alloc(),
        Entropy: entropy().seed(99),
    };
    let uniform = context {
        Allocator: alloc(),
        Random: rand().seed(99),
    };
    // `random.bytes` takes the low byte of each step, which is what
    // `nextInt(0, 256)` is, and `crypto.randomBytes` takes the same one. The
    // two modules differ in what they *promise*, not in what the double does.
    assert.equal(
        bytes.toHex(secret, crypto.randomBytes(secret, 24)),
        bytes.toHex(uniform, random.bytes(uniform, 24)),
    );
}

test "core/random answers octets of its own, and a negative count is empty" {
    let ctx = context {
        Allocator: alloc(),
        Random: rand(),
    };
    assert.equal(random.bytes(ctx, 4).length(), 4);
    assert.equal(random.bytes(ctx, 0).length(), 0);
    assert.equal(random.bytes(ctx, -1).length(), 0);
}
