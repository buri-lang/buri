// `design/native/MEMORY.md` §5.5 — a closure does not consume what it captures.
//
// The in-place half of the value model lets an operation write through a list
// nobody else holds: `push` appends instead of copying, `slice` moves the
// window down instead of allocating a new one. Which list "nobody else holds"
// means is decided by `middle::rc`, once, for every backend.
//
// A **capture** is the case where the enclosing scope's liveness answers the
// wrong question. The body of a closure runs later, elsewhere, and as many
// times as somebody calls it, so a captured list always has a second reader —
// the next call — however dead the capture looks at the point the closure was
// written. Reading it as the last use let `xs.slice(c, 0, i)` truncate `xs` in
// place on the first call, and every call after that sliced what was left:
// `0, 0, 0` where the answer is `0, 1, 2`.
//
// So every case here calls one closure **more than once** and asserts the
// answers, and the six operations below are the whole in-place half of
// `core/list`. The lists are built by `grown` rather than written as literals:
// a literal is immortal and lives in the artifact's constant pool
// (VALUE-MODEL.md §5.2), so it can never be the unique owner these operations
// are looking for and would prove nothing.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

/// A list this program grew, rather than one the compiler interned.
///
/// `push` onto `list.empty()` is the shape `filterMap` and every other fold in
/// `core/list` produces, and it is what makes the answer a block the program
/// owns outright.
fn grown<C: Allocator>(ctx: C, n: Int): [Int] {
    list
        .range(ctx, 0, n)
        .foldCtx(ctx, fn(c, acc: [Int], i) => acc.push(c, i), list.empty())
}

/// The same, of strings, so a second element type reaches the same code.
fn grownText<C: Allocator>(ctx: C, n: Int): [Str] {
    list
        .range(ctx, 0, n)
        .foldCtx(ctx, fn(c, acc: [Str], _i) => acc.push(c, "x"), list.empty())
}

// -----------------------------------------------------------------------------
// The six operations that write through
// -----------------------------------------------------------------------------

test "a captured list slices the same way on every call" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    assert.equal(
        list.range(ctx, 0, 4).mapCtx(ctx, fn(c, i) => xs.slice(c, 0, i).length()),
        [0, 1, 2, 3],
    );
}

test "a captured list takes the same way on every call" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    assert.equal(
        list.range(ctx, 0, 4).mapCtx(ctx, fn(c, i) => xs.take(c, i).length()),
        [0, 1, 2, 3],
    );
}

test "a captured list drops the same way on every call" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    assert.equal(
        list.range(ctx, 0, 4).mapCtx(ctx, fn(c, i) => xs.drop(c, i).length()),
        [3, 2, 1, 0],
    );
}

test "a captured list is not grown in place by the closure that pushes to it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 2);
    assert.equal(
        list.range(ctx, 0, 3).mapCtx(ctx, fn(c, i) => xs.push(c, i).length()),
        [3, 3, 3],
    );
}

test "a captured list is not extended in place by the closure that concatenates it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 2);
    let ys = grown(ctx, 3);
    assert.equal(
        list.range(ctx, 0, 3).mapCtx(ctx, fn(c, _i) => xs.concat(c, ys).length()),
        [5, 5, 5],
    );
}

test "a captured list is not turned around in place by the closure that reverses it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    assert.equal(
        list
            .range(ctx, 0, 3)
            .mapCtx(ctx, fn(c, _i) => xs.reverse(c).get(0).withDefault(-1)),
        [2, 2, 2],
    );
}

// -----------------------------------------------------------------------------
// What the capture still is afterwards
// -----------------------------------------------------------------------------

test "a list a closure sliced is the list it was" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    let lengths = list
        .range(ctx, 0, 3)
        .mapCtx(ctx, fn(c, i) => xs.slice(c, 0, i).length());
    assert.equal(lengths, [0, 1, 2]);
    assert.equal(xs, [0, 1, 2]);
}

/// Calls one closure twice, so a case can say "twice" without going through
/// `core/list` to say it.
fn twice<C: Allocator>(ctx: C, f: fn(C, Int) => Int): [Int] {
    [f(ctx, 1), f(ctx, 1)]
}

test "a closure that runs twice reads the same capture twice" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 4);
    assert.equal(twice(ctx, fn(c, n) => xs.drop(c, n).length()), [3, 3]);
}

// -----------------------------------------------------------------------------
// Through a generic helper, of two element types
// -----------------------------------------------------------------------------

/// The shape the bug was found in: a `<C: Allocator>` helper over `[T]`, called
/// from inside a closure, with a second instantiation over another element
/// type beside it. Two monomorphizations of one function reach one closure
/// body, which is what made it look like a monomorphization bug rather than an
/// ownership one.
fn prefixLen<C: Allocator, T>(ctx: C, ps: [T], i: Int): Int {
    ps.slice(ctx, 0, i).length()
}

test "two instantiations of one helper read two captures" {
    let ctx = context {
        Allocator: alloc(),
    };
    let ns = grown(ctx, 3);
    let ss = grownText(ctx, 3);
    let pairs = list
        .range(ctx, 0, 3)
        .mapCtx(ctx, fn(c, i) => prefixLen(c, ns, i) + prefixLen(c, ss, i));
    assert.equal(pairs, [0, 2, 4]);
}

// -----------------------------------------------------------------------------
// Every kind of captured value
// -----------------------------------------------------------------------------
//
// The rule is about *what a closure captures*, not about what type it is, so
// each shape below reaches an in-place operation through a different route: a
// field of a struct, an element of a tuple, a variant's payload, an element of
// a list of lists, and a `Str`. Every one is grown by this program.
//
// **What is asserted is the closure's own answers, and the capture is not read
// afterwards.** That is not shyness about the stronger claim — it is what makes
// these cases able to fail. Reading a capture back after the closure has run is
// a use of it in the *enclosing* scope, which is exactly what makes the
// enclosing liveness answer "still live" and mark it whatever the rule says. A
// capture the enclosing scope never mentions again is the shape the bug needs,
// and the next section is where a case reads one back.

derive Equal, Show for Basket;
struct Basket {
    label: Str,
    items: [Int],
}

derive Equal, Show for Load;
enum Load {
    Full([Int]),
    Empty,
}

/// A carried closure, so a case can put one in a field and call it later.
struct Step<C> {
    run: fn(C, Int) => Int,
}

/// What `f` answers for `0 .. n`, through the combinator the bug was found in.
fn over<C: Allocator>(ctx: C, n: Int, f: fn(C, Int) => Int): [Int] {
    list.range(ctx, 0, n).mapCtx(ctx, f)
}

/// The same, from the bottom of a recursion rather than from a loop: `f` is
/// called once per frame, so the capture is read at a depth the combinator
/// never reaches.
fn down<C: Allocator>(ctx: C, i: Int, f: fn(C, Int) => Int, acc: [Int]): [Int] {
    if (i <= 0) { acc } else { down(ctx, i - 1, f, acc.push(ctx, f(ctx, i))) }
}

/// A string this program grew.
fn grownWord<C: Allocator>(ctx: C, n: Int): Str {
    list.range(ctx, 0, n).foldCtx(ctx, fn(c, acc: Str, _i) => acc.concat(c, "x"), "")
}

/// What is inside a `Load`, or an empty list.
fn inside(load: Load): [Int] {
    match (load) {
        .Full(xs) => xs,
        .Empty => list.empty<Int>(),
    }
}

test "a captured struct's list is not written through by the closure that pushes it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let basket = Basket { label: "b", items: grown(ctx, 2) };
    let sizes = over(ctx, 3, fn(c, i) => {
        let out = Basket { ..basket, items: basket.items.push(c, i) };
        out.items.length()
    });
    assert.equal(sizes, [3, 3, 3]);
}

test "a captured tuple's two lists are not written through" {
    let ctx = context {
        Allocator: alloc(),
    };
    let pair = (grown(ctx, 2), grownText(ctx, 2));
    let sizes = over(ctx, 3, fn(c, i) => {
        pair.0.push(c, i).length() + pair.1.push(c, "y").length()
    });
    assert.equal(sizes, [6, 6, 6]);
}

test "a captured variant's payload is not written through" {
    let ctx = context {
        Allocator: alloc(),
    };
    let load = Load.Full(grown(ctx, 2));
    let sizes = over(ctx, 3, fn(c, i) => inside(load).push(c, i).length());
    assert.equal(sizes, [3, 3, 3]);
}

test "a captured list of lists is not written through at either level" {
    let ctx = context {
        Allocator: alloc(),
    };
    let rows = list.empty<[Int]>().push(ctx, grown(ctx, 2));
    let sizes = over(ctx, 3, fn(c, i) => {
        let row = rows.get(0).withDefault(list.empty<Int>());
        rows.push(c, list.empty<Int>()).length() + row.push(c, i).length()
    });
    assert.equal(sizes, [5, 5, 5]);
}

test "a captured string is not extended in place" {
    let ctx = context {
        Allocator: alloc(),
    };
    let word = grownWord(ctx, 3);
    let sizes = over(ctx, 3, fn(c, _i) => word.concat(c, "!").length());
    assert.equal(sizes, [4, 4, 4]);
}

// And the read-back half, for the shapes above: the closure runs, and then the
// capture is what it was. Two cases rather than five, because the claim is one
// claim and reading it back is what stops the others being able to fail.

test "a struct a closure pushed through is the struct it was" {
    let ctx = context {
        Allocator: alloc(),
    };
    let basket = Basket { label: "b", items: grown(ctx, 2) };
    let sizes = over(ctx, 2, fn(c, i) => {
        let out = Basket { ..basket, items: basket.items.push(c, i) };
        out.items.length()
    });
    assert.equal(sizes, [3, 3]);
    assert.equal(basket, Basket { label: "b", items: [0, 1] });
}

test "a list of lists a closure pushed through is the list it was" {
    let ctx = context {
        Allocator: alloc(),
    };
    let rows = list.empty<[Int]>().push(ctx, grown(ctx, 2));
    let sizes = over(ctx, 2, fn(c, i) => {
        let row = rows.get(0).withDefault(list.empty<Int>());
        rows.push(c, list.empty<Int>()).length() + row.push(c, i).length()
    });
    assert.equal(sizes, [5, 5]);
    assert.equal(rows.length(), 1);
    assert.equal(rows.get(0).withDefault(list.empty<Int>()), [0, 1]);
}

// -----------------------------------------------------------------------------
// Where the closure is, and where it is called from
// -----------------------------------------------------------------------------

test "a capture read by a lambda inside a lambda is read the same way every time" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    // The inner lambda's capture is the outer one's capture, two scopes up
    // from where `xs` was bound.
    let sums = list
        .range(ctx, 0, 3)
        .mapCtx(ctx, fn(c, i) => {
            list.range(c, 0, 2).mapCtx(c, fn(d, _k) => xs.slice(d, 0, i).length()).sum()
        });
    assert.equal(sums, [0, 2, 4]);
}

test "a lambda kept in a struct reads its capture on every later call" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    // The closure is built once, stored, and called three times afterwards —
    // so the call that reads the capture is nowhere near the scope that made
    // it.
    let held = Step { run: fn(c, i) => xs.drop(c, i).length() };
    let call = held.run;
    assert.equal([call(ctx, 0), call(ctx, 1), call(ctx, 2)], [3, 2, 1]);
}

test "a list of closures each reads its own capture" {
    let ctx = context {
        Allocator: alloc(),
    };
    let short = grown(ctx, 2);
    let long = grown(ctx, 4);
    let held = [
        Step { run: fn(c, i) => short.drop(c, i).length() },
        Step { run: fn(c, i) => long.drop(c, i).length() },
    ];
    let first = assert.some(held.get(0)).run;
    let second = assert.some(held.get(1)).run;
    // Interleaved, and the first one twice, so a capture one call had spent
    // shows up in the next: `drop` moves the window down, so a list written
    // through would answer `1, 3, 0`.
    assert.equal([first(ctx, 1), second(ctx, 1), first(ctx, 1)], [1, 3, 1]);
}

test "a capture read from the bottom of a recursion is read the same way every frame" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    // `drop` rather than `take`, because the frames count down: a `take` that
    // wrote through would answer the same three numbers, and a `drop` that did
    // would answer `0, 0, 0`.
    assert.equal(down(ctx, 3, fn(c, i) => xs.drop(c, i).length(), list.empty<Int>()), [
        0,
        1,
        2,
    ]);
}

test "a closure that reads one capture twice reads it twice every call" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 4);
    // `take(i)` and `drop(i)` between them are the whole list, whatever `i`
    // is — which stops being true the moment either writes through.
    assert.equal(
        over(ctx, 3, fn(c, i) => xs.take(c, i).length() + xs.drop(c, i).length()),
        [4, 4, 4],
    );
}

test "a closure nobody calls leaves its capture alone" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    let none = list.empty<Int>().mapCtx(ctx, fn(c, i) => xs.push(c, i).length());
    assert.equal(none, list.empty<Int>());
    assert.equal(xs, [0, 1, 2]);
}

// -----------------------------------------------------------------------------
// And the other direction: what the body binds is still the body's
// -----------------------------------------------------------------------------
//
// A rule that took every list in a closure body away from the in-place path
// would pass every case above and cost the language its one optimisation. What
// a lambda binds *itself* is owned by that call, so a fold inside a closure
// still writes through its own accumulator —
// `language::sharing::growing_a_list_in_a_loop_is_linear` is the cost half of
// this, and these are the answers.

test "a list a closure grew itself is the closure's own" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 2);
    let sizes = over(ctx, 3, fn(c, i) => {
        let mine = list
            .range(c, 0, 4)
            .foldCtx(c, fn(d, acc: [Int], k) => acc.push(d, k + i), list.empty<Int>());
        mine.push(c, i).length() + xs.length()
    });
    assert.equal(sizes, [7, 7, 7]);
}

test "an accumulator threaded through a closure is still written through" {
    let ctx = context {
        Allocator: alloc(),
    };
    let xs = grown(ctx, 3);
    // The accumulator is the lambda's own parameter, so it stays owned; `xs`
    // beside it is a capture, and neither answer moves the other.
    let built = list
        .range(ctx, 0, 4)
        .foldCtx(
            ctx,
            fn(c, acc: [Int], i) => acc.push(c, xs.take(c, i).length()),
            list.empty<Int>(),
        );
    assert.equal(built, [0, 1, 2, 3]);
}
