// `design/native/MEMORY.md` §5 — a match arm's guard borrows, it does not
// consume.
//
// A guard runs before its arm is committed, so when it is false the next arm
// runs. A value the guard hands to a callee that owns it is therefore not the
// guard's last use of it — the fall-through arm still holds it. `middle::rc`
// releasing it once in the guard and again in the arm it fell through to freed
// a heap `Str` a whole recompute early (issue #198). These blocks run a heap
// `Str` through such a guard on both backends and read it afterward, so the
// value the guard borrowed is still the same characters.

from "core/map" import * as map;
from "core/orderedmap" import * as ordmap;
from "core/orderedmap" import { OrderedMap };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

enum Kind {
    Str,
    Int,
    Bool,
}

enum Value {
    Text(Str),
    Empty,
}

// Owns `value`: it binds the payload and reads it, so the match keeps a piece
// of `value` and takes the whole — the shape a query filter's `matchesKind`
// has.
fn holdsText(value: Value): Bool {
    match (value) {
        .Text(text) => text.length() >= 0,
        .Empty => false,
    }
}

fn textOf(value: Value): Str {
    match (value) {
        .Text(text) => text,
        .Empty => "",
    }
}

// A runtime `Kind`, so the match is not folded to one arm and its guard stays
// in the program.
fn kindOf(marker: Str): Kind {
    if (marker.length() > 3) { .Str } else { .Int }
}

// A wildcard guard consumes `value`; the arms after it never read it, so they
// release it themselves on the path the guard fell through by.
fn accepts(kind: Kind, value: Value): Bool {
    match (kind) {
        .Bool => holdsText(value),
        _ if !holdsText(value) => false,
        .Str => true,
        .Int => true,
    }
}

test "a guard's consuming call leaves an alias of a heap Str usable" {
    let ctx = context {
        Allocator: alloc(),
    };
    let heap = str.format(ctx, "2026-03-${"01"}");
    // `heap` is read after the match, so the wrap and the read share one block.
    assert.isTrue(accepts(kindOf(heap), Value.Text(heap)));
    assert.equal(heap, "2026-03-01");
}

test "a guard that holds selects its own arm" {
    assert.isFalse(accepts(kindOf("no"), Value.Empty));
}

test "an arm reachable only past a guard reads a heap Str the guard borrowed" {
    let ctx = context {
        Allocator: alloc(),
    };
    let heap = str.format(ctx, "2026-03-${"01"}");
    let described = match (kindOf(heap)) {
        .Bool => "bool",
        _ if !holdsText(Value.Text(heap)) => "empty",
        .Str => textOf(Value.Text(heap)),
        .Int => "int",
    };
    assert.equal(described, "2026-03-01");
}

// A guard that binds names of its own. `has` is a short call, so the inliner
// pastes its body into the guard, and that body binds the map and the key to
// names that live and die inside the guard: the arm owes them nothing.
// `middle::rc` released each of them again at the arm's entry, which freed the
// map the arm was about to insert into — a crash, or a map whose entries were
// somebody else's blocks.
fn addOnce<C: Allocator>(
    ctx: C,
    seen: OrderedMap<Str, ()>,
    key: Option<Str>,
): OrderedMap<Str, ()> {
    match (key) {
        .Some(k) if !seen.has(k) => seen.insert(ctx, k, ()),
        _ => seen,
    }
}

test "a guard whose call binds names of its own leaves the map its arm grows alive" {
    let ctx = context {
        Allocator: alloc(),
    };
    let words = ["users.name", "teams.name", "users.email", "count"];
    let seen = words.foldCtx(
        ctx,
        fn(c, all: OrderedMap<Str, ()>, word) => {
            addOnce(c, all, word.splitOnce(".").map(fn(parts) => parts.0))
        },
        ordmap.empty<Str, ()>(),
    );
    assert.equal(seen.keys(ctx), ["teams", "users"]);
}

test "a guard with a let of its own leaves the list its arm grows alive" {
    let ctx = context {
        Allocator: alloc(),
    };
    let held = [str.format(ctx, "a${"b"}")];
    let grown = match (Option.Some(str.format(ctx, "c${"d"}"))) {
        .Some(next) if {
            let alias = held;
            !alias.contains(next)
        } => { held.push(ctx, next) },
        _ => held,
    };
    assert.equal(grown, ["ab", "cd"]);
}

struct Stamp {
    at: Int,
    node: Str,
}

fn decoded<C: Allocator>(ctx: C, at: Int): Option<Stamp> {
    .Some(Stamp { at, node: str.format(ctx, "node-${at}") })
}

// The arm binds a heap record and its guard is false, so the match falls
// through to the wildcard, which owes the record its release once (issue #231).
// Called once, so the inliner pastes it into the fold's step and the record
// arrives as a `let` the match consumes.
fn later<C: Allocator>(ctx: C, stamp: Option<Stamp>, limit: Int): [Str] {
    match (stamp) {
        .Some(found) if found.at > limit => [],
        _ => [str.format(ctx, "a-${limit}"), str.format(ctx, "b-${limit}")],
    }
}

test "a guard that fails on a bound heap value falls through cleanly" {
    let ctx = context {
        Allocator: alloc(),
    };
    let total = [1, 2, 3, 4, 5, 6, 7, 8].foldCtx(
        ctx,
        fn(c, sum, i) => sum + later(c, decoded(c, i), 100).length(),
        0,
    );
    assert.equal(total, 16);
    assert.equal(assert.some(decoded(ctx, 2)).node, "node-2");
}

// A false guard reading the local the match consumes leaves it to the arm the
// match falls through to, which releases it once (issue #345).

fn wildcardGuard<C: Allocator>(ctx: C, n: Int): Str {
    let lower = str.format(ctx, "page-${n}");
    match (lower) {
        _ if lower.contains("x") => "has x",
        _ => "no x",
    }
}

test "a false guard calling a method on the scrutinee leaves it to the next arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(wildcardGuard(ctx, 1), "no x");
    assert.equal(wildcardGuard(ctx, 2), "no x");
}

fn handsOnScrutinee<C: Allocator>(ctx: C, n: Int): Str {
    let lower = str.format(ctx, "page-${n}");
    match (lower) {
        "page-0" => "zero",
        _ if lower.contains("x") => "has x",
        _ => lower,
    }
}

test "the arm past a false guard on the scrutinee answers the scrutinee itself" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(handsOnScrutinee(ctx, 7), "page-7");
    assert.equal(handsOnScrutinee(ctx, 0), "zero");
}

fn takesText(text: Str): Bool {
    text.endsWith("x")
}

fn consumingGuard<C: Allocator>(ctx: C, n: Int): Str {
    let lower = str.format(ctx, "page-${n}");
    match (lower) {
        _ if takesText(lower) => "ends in x",
        _ => lower,
    }
}

test "a false guard handing the scrutinee to a function leaves it to the next arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(consumingGuard(ctx, 3), "page-3");
}

fn shortCircuitGuard<C: Allocator>(ctx: C, n: Int): Str {
    let lower = str.format(ctx, "page-${n}");
    match (lower) {
        _ if n > 0 && lower.contains("x") => "has x",
        _ => "no x",
    }
}

test "a false guard reading the scrutinee on the right of && leaves it to the next arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(shortCircuitGuard(ctx, 4), "no x");
    assert.equal(shortCircuitGuard(ctx, 0), "no x");
}

fn capturingGuard<C: Allocator>(ctx: C, n: Int): Int {
    let lower = str.format(ctx, "page-${n}");
    let known = ["home", "about"];
    match (lower) {
        _ if known.any(fn(name) => name == lower) => 1,
        _ => 2,
    }
}

test "a false guard whose closure captures the scrutinee leaves it to the next arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(capturingGuard(ctx, 5), 2);
}

fn payloadGuard<C: Allocator>(ctx: C, n: Int): Str {
    let found: Option<Str> = .Some(str.format(ctx, "page-${n}"));
    match (found) {
        .Some(text) if found.isSome() && text.contains("x") => text,
        _ => "no x",
    }
}

test "a false guard reading both a payload and the enum it came from falls through" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(payloadGuard(ctx, 6), "no x");
}

struct Titled {
    title: Str,
    rank: Int,
}

fn recordGuard<C: Allocator>(ctx: C, n: Int): Str {
    let titled = Titled { title: str.format(ctx, "page-${n}"), rank: n };
    match (titled) {
        Titled { rank, .. } if rank > 0 && titled.title.contains("x") => "has x",
        Titled { title, rank: _ } => title,
    }
}

test "a false guard reading a field of the struct the match takes apart falls through" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(recordGuard(ctx, 8), "page-8");
}

fn listGuard<C: Allocator>(ctx: C, n: Int): Int {
    let pages = [str.format(ctx, "page-${n}"), str.format(ctx, "page-${n + 1}")];
    match (pages) {
        _ if pages.contains("x") => 0,
        _ => pages.length(),
    }
}

test "a false guard over a list of heap Strs leaves the list to the next arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(listGuard(ctx, 9), 2);
}

fn mapGuard<C: Allocator>(ctx: C, n: Int): Int {
    let pages = map.empty<Str, Int>().insert(ctx, str.format(ctx, "page-${n}"), n);
    match (pages) {
        _ if pages.has("x") => 0,
        _ => pages.size,
    }
}

test "a false guard over a map with a heap key leaves the map to the next arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(mapGuard(ctx, 10), 1);
}

fn untilMarked<C: Allocator>(ctx: C, text: Str, steps: Int): Int {
    match (text) {
        _ if text.contains("x") => steps,
        _ => if (steps > 3) { steps } else { untilMarked(ctx, str.format(ctx, "${text}y"), steps + 1) },
    }
}

test "a recursive arm past a false guard on the scrutinee leaves it to that arm" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(untilMarked(ctx, str.format(ctx, "page-${1}"), 0), 4);
}
