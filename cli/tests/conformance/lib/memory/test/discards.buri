// A `let` gives back what it does not keep.
//
// `middle::rc` releases a value through a *name* — a local, or the node that
// produced a temporary. A destructuring `let` used to leave the positions its
// pattern skipped with neither: `let (q, _) = nextToken(ctx, p)` takes the
// pair the call answered, hands element 0 to `q`, and element 1 went nowhere.
// Nothing released it, so every discarded token in the `.proto` reader kept
// the `Str` it carried — thirteen blocks of `proto_schema/refusals.buri`, all
// of them one or two bytes of punctuation.
//
// **The assertions here are answers, and the leak is the harness's question.**
// A leaked block changes no answer, so on the reference backend this file only
// says the values are right; `native::conformance` runs the same blocks under
// `BURI_RT_HEAP_CHECK` and that is where a skipped position that nobody freed
// fails. Which is why every value below is *grown* rather than written as a
// literal — a literal lives in the constant pool (VALUE-MODEL.md §5.2) and is
// never a block anybody has to give back.
//
// A field a `..` stands for is a skipped position too, and it is the one the
// walk could not see: `..` left those fields out of the tree entirely, so
// `let Nest { tag, .. }` leaked whatever it elided. The checker writes them out
// as wildcards now, and the two `..` cases below are what found that.
//
// The last section is the other direction. Naming a skipped position is only
// right if the name is not a *second* one for a value something else already
// releases, so those cases read the value again after destructuring it: an
// over-release is a use-after-free, which the heap check's quarantine stops
// with a different message than a leak.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/list" import * as list;
from "core/testing/assert" import * as assert;

derive Equal, Show for Token;
/// One token, the shape the `.proto` reader steps over: a word this program
/// built, and an end nobody has to give back.
enum Token {
    Word(Str),
    End,
}

derive Equal, Show for Pair;
struct Pair {
    kept: Int,
    dropped: Str,
}

/// A string this program grew, rather than one the compiler interned.
fn grown<C: Allocator>(ctx: C, s: Str): Str {
    s.concat(ctx, "")
}

/// A list this program grew, for a skipped position of another counted shape.
fn grownList<C: Allocator>(ctx: C, n: Int): [Int] {
    list
        .range(ctx, 0, n)
        .foldCtx(ctx, fn(c, acc: [Int], i) => acc.push(c, i), list.empty())
}

/// The reader's own shape: a cursor, and the token it just read.
fn next<C: Allocator>(ctx: C, at: Int, word: Str): (Int, Token) {
    (at + 1, Token.Word(grown(ctx, word)))
}

// -----------------------------------------------------------------------------
// A position the pattern skips
// -----------------------------------------------------------------------------

test "a tuple element the pattern skips is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `skipStatement`, in one line: step over a token and keep only where the
    // cursor now is.
    let (at, _) = next(ctx, 0, "message");
    assert.equal(at, 1);
}

test "the skipped element may be the first one" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (_, t) = (grown(ctx, "syntax"), 7);
    assert.equal(t, 7);
}

test "a skipped element is given back however many there are" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (_, n, _) = (grown(ctx, "extend"), 2, grownList(ctx, 3));
    assert.equal(n, 2);
}

test "a struct field the pattern skips is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    let Pair { kept, dropped: _ } = Pair { kept: 4, dropped: grown(ctx, "group") };
    assert.equal(kept, 4);
}

test "a skipped position nested under a kept one is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (n, (_, m)) = (1, (grown(ctx, "optional"), 2));
    assert.equal(n + m, 3);
}

test "the value being destructured may be a local rather than a call" {
    let ctx = context {
        Allocator: alloc(),
    };
    let token = next(ctx, 0, "required");
    let (at, _) = token;
    assert.equal(at, 1);
}

test "a payload the pattern never reaches is given back with its token" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Two of them, because the reader peeks and then consumes: one call's
    // answer is looked at and the other's is thrown away whole.
    let (peeked, t) = next(ctx, 0, "service");
    let (consumed, _) = next(ctx, peeked, "service");
    assert.equal(consumed, 2);
    assert.equal(t, Token.Word("service"));
}

test "a `let` that keeps nothing at all is still a statement that gives back" {
    let ctx = context {
        Allocator: alloc(),
    };
    // Nothing is bound, so there is nothing to name — the value is the
    // statement's own temporary, and the statement drops it.
    let (_, _) = next(ctx, 0, "public");
    let _ = next(ctx, 0, "public");
    assert.equal(1, 1);
}

// -----------------------------------------------------------------------------
// And not twice
// -----------------------------------------------------------------------------

test "a skipped position of a value still in use is not given back twice" {
    let ctx = context {
        Allocator: alloc(),
    };
    let token = next(ctx, 0, "reserved");
    let (at, _) = token;
    // The destructuring above is not the last read of `token`, so it took a
    // count of its own rather than the one `token` holds.
    assert.equal(at, 1);
    assert.equal(token.1, Token.Word("reserved"));
}

test "a skipped field of a struct still in use is not given back twice" {
    let ctx = context {
        Allocator: alloc(),
    };
    let p = Pair { kept: 9, dropped: grown(ctx, "extensions") };
    let Pair { kept, dropped: _ } = p;
    assert.equal(kept, 9);
    assert.equal(p.dropped, "extensions");
}

test "the same position skipped in a loop is given back every time round" {
    let ctx = context {
        Allocator: alloc(),
    };
    let steps = list
        .range(ctx, 0, 8)
        .foldCtx(
            ctx,
            fn(c, acc: Int, _i) => {
                let (at, _) = next(c, acc, "map");
                at
            },
            0,
        );
    assert.equal(steps, 8);
}

// -----------------------------------------------------------------------------
// Every depth, and every counted shape
// -----------------------------------------------------------------------------
//
// A pattern nests as far as the types do, and the walk that names a skipped
// position stops at the first position that binds nothing — so a position three
// levels down, under two that do bind, is the case a shallower walk would
// miss. `Deep` is a tuple inside a struct inside a variant, which is the three
// pattern forms a `let` may hold, in one type.
//
// **A parameter is not one of them.** A Buri parameter is a name and a type
// (`grammar.ebnf`, `Param`), so there is no destructuring parameter to skip a
// position in; the only patterns that reach `let`'s rule are the ones below,
// and a `match` arm's payload goes with its scrutinee instead — the section
// after them is what says so.

derive Equal, Show for Nest;
struct Nest {
    tag: Int,
    both: (Str, [Int]),
}

derive Equal, Show for Deep;
enum Deep {
    Only(Nest),
}

derive Equal, Show for Holder;
struct Holder {
    label: Str,
    token: Token,
}

/// A `Deep` this program built, every counted leaf of it grown.
fn deep<C: Allocator>(ctx: C, word: Str): Deep {
    .Only(Nest { tag: 1, both: (grown(ctx, word), grownList(ctx, 2)) })
}

/// A `Holder` this program built.
fn holder<C: Allocator>(ctx: C, word: Str): Holder {
    Holder { label: grown(ctx, word), token: Token.Word(grown(ctx, word)) }
}

/// A list of strings, so a skipped position may be a block of blocks.
fn grownWords<C: Allocator>(ctx: C, n: Int): [Str] {
    list
        .range(ctx, 0, n)
        .foldCtx(ctx, fn(c, acc: [Str], _i) => acc.push(c, grown(c, "w")), list.empty())
}

test "a position skipped three levels down is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `tag` is kept, so the walk goes on under `Only` and under `Nest`; the
    // tuple's first element is where it stops, and that `Str` is what nothing
    // used to release.
    let .Only(Nest { tag, both: (_, kept) }) = deep(ctx, "enum");
    assert.equal(tag, 1);
    assert.equal(kept, [0, 1]);
}

test "two positions skipped at one depth are both given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    let .Only(Nest { tag, both: (_, _) }) = deep(ctx, "import");
    assert.equal(tag, 1);
}

test "a position skipped either side of a kept one, two levels down, is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (_, (_, n, _), _) = (
        grown(ctx, "package"),
        (grownWords(ctx, 2), 5, grownList(ctx, 3)),
        grown(ctx, "weak"),
    );
    assert.equal(n, 5);
}

test "a struct field the pattern does not name at all is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    // `..` names no field, so the fields it stands for are skipped positions
    // the pattern never wrote down.
    let Nest { tag, .. } = Nest {
        tag: 3,
        both: (grown(ctx, "stream"), grownList(ctx, 2)),
    };
    assert.equal(tag, 3);
}

test "a skipped position may hold a list of blocks" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (n, _) = (6, grownWords(ctx, 3));
    assert.equal(n, 6);
}

test "a skipped position may hold an option that is there" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (n, _) = (7, Option.Some(grown(ctx, "returns")));
    assert.equal(n, 7);
}

test "a skipped position may hold a struct with a list in it" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (n, _) = (8, Nest { tag: 0, both: (grown(ctx, "rpc"), grownList(ctx, 2)) });
    assert.equal(n, 8);
}

test "a position named but never read is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The other half of the rule: a name nobody reads is not a skipped
    // position at all — it is a binding the scan drops where it is bound —
    // and it has to come back the way one that was never named does.
    let (at, _unread) = next(ctx, 0, "oneof");
    assert.equal(at, 1);
}

// -----------------------------------------------------------------------------
// A `match` arm, which is the other model and stays the other model
// -----------------------------------------------------------------------------
//
// An arm's unbound payload goes back with the *scrutinee*, because the arm is
// one of several and the value is one. Naming those positions the way a `let`
// names them would put a second release on a value the match already accounts
// for, so these cases are here as the twin: the same skipped payloads, and
// nothing given back twice.

test "a payload a match arm skips is given back with its scrutinee" {
    let ctx = context {
        Allocator: alloc(),
    };
    let (_, token) = next(ctx, 0, "rpc");
    let n = match (token) {
        .Word(_) => 1,
        .End => 0,
    };
    assert.equal(n, 1);
}

test "a payload a match arm skips under a field it keeps is given back" {
    let ctx = context {
        Allocator: alloc(),
    };
    let n = match (holder(ctx, "service")) {
        Holder { label, token: .Word(_) } => label.length(),
        Holder { label: _, token: .End } => 0,
    };
    assert.equal(n, 7);
}

test "an arm that keeps a payload leaves the value it came out of whole" {
    let ctx = context {
        Allocator: alloc(),
    };
    let held = holder(ctx, "message");
    let word = match (held) {
        Holder { label: _, token: .Word(w) } => w,
        Holder { label, token: .End } => label,
    };
    assert.equal(word, "message");
    // The scrutinee is still whole, so the arm that kept a piece of it took a
    // count rather than the one `held` holds.
    assert.equal(held.label, "message");
}

// -----------------------------------------------------------------------------
// Round a loop
// -----------------------------------------------------------------------------

test "a skipped position of a fold's accumulator is given back every round" {
    let ctx = context {
        Allocator: alloc(),
    };
    // The accumulator carries a string it does not keep, and every round drops
    // the previous one on the floor by not naming it.
    let ended = list
        .range(ctx, 0, 8)
        .foldCtx(
            ctx,
            fn(c, acc: (Int, Str), _i) => {
                let (at, _) = acc;
                (at + 1, grown(c, "reserved"))
            },
            (0, ""),
        );
    let (at, _) = ended;
    assert.equal(at, 8);
}

test "a position skipped inside a mapped closure is given back every element" {
    let ctx = context {
        Allocator: alloc(),
    };
    let steps = list
        .range(ctx, 0, 8)
        .mapCtx(ctx, fn(c, i) => {
            let .Only(Nest { tag, both: (_, _) }) = deep(c, "syntax");
            tag + i
        });
    assert.equal(steps, [1, 2, 3, 4, 5, 6, 7, 8]);
}

// -----------------------------------------------------------------------------
// And still not twice, at depth
// -----------------------------------------------------------------------------

test "a deep skipped position of a value still in use is not given back twice" {
    let ctx = context {
        Allocator: alloc(),
    };
    let whole = deep(ctx, "extend");
    let .Only(Nest { tag, both: (_, kept) }) = whole;
    assert.equal(tag, 1);
    assert.equal(kept, [0, 1]);
    // The destructuring above was not the last read of `whole`.
    assert.equal(whole, deep(ctx, "extend"));
}

test "a field `..` stood for is not given back twice while the struct is read" {
    let ctx = context {
        Allocator: alloc(),
    };
    let nest = Nest { tag: 2, both: (grown(ctx, "public"), grownList(ctx, 2)) };
    let Nest { tag, .. } = nest;
    assert.equal(tag, 2);
    assert.equal(nest.both.0, "public");
}
