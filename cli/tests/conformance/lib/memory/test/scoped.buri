// SPEC 10.8 and `design/native/MEMORY.md` §7.2 — `core/alloc`'s `scoped`, and
// the attenuating wrapper it hands the body.
//
// `Scoped<C>` makes one claim and its negation, and this file is both halves:
//
//   * **every effect forwards** — a scope narrows nothing but allocation, so a
//     body prints on the same stdout, reads the same files, waits on the same
//     clock and fans out onto the same tasks as its caller;
//   * **`Alloc` does not** — a charge inside a scope reaches the scope's own
//     arena and the wrapped allocator's totals do not move.
//
// The second is asserted as a *divergence* rather than as a number, and that is
// the only way it can be asserted from Buri: the arena's pages are a native
// fact (`buri_rt_heap_stats`, and `cli/runtime/memory.rs`'s own cases), while
// the counts are the defined model and are the same integers on every backend.
// So what is written here is what both backends agree about — who was charged.
//
// The thirteen forwarding blocks are hand-written, one per effect, because
// there are no blanket implementations and no delegation in this language.
// This file calls every method of every one of them through a scope, so a
// block that was forgotten is a build error here rather than a surprise at the
// call site of whoever needed it first.

from "core/alloc" import * as alloc;
from "core/alloc" import { Stats };
from "core/effect" import {
    Alloc, Clock, Env, Header, Listen, Listener, Net, NetError, Proc, Rand, Received,
    Request, Response, Serve, ServeError, Sockets, Stderr, Stdin, Stdout, Tasks,
};
from "core/env" import * as env;
from "core/fs" import * as fs;
from "core/fs" import { FsRead, FsWrite };
from "core/host/testing" import * as testing;
from "core/io" import * as io;
from "core/net/http" import * as http;
from "core/net/server" import * as server;
from "core/path" import * as path;
from "core/proc" import * as proc;
from "core/random" import * as random;
from "core/tasks" import * as tasks;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;

// -----------------------------------------------------------------------------
// Fakes for the two effects that have no test double
// -----------------------------------------------------------------------------
//
// `core/host/testing` doubles eleven of the thirteen. `Listen` and `Sockets`
// have none — the acceptor behind them is a real socket, and there is no test
// double for a port — so they are written here. Each is the smallest thing that
// can *answer differently from nothing*, because a fake that returned the zero
// value would pass whether or not the forward happened.

/// Binds when it is told to, hands out one request, takes one answer, and
/// closes.
///
/// `binds` is an `Int` rather than the address it used to be, and that is the
/// stencil backend's limit rather than a preference: `serve` fans its accept
/// loop out with `Tasks.parallel`, and that backend refuses a step whose
/// *context* owns a reference count (`stencil/rtcall.rs`) — so a context
/// binding a `Str`-carrying acceptor would drop this whole file out of the
/// frame-threaded corpus. Nothing here was ever about the field's type.
///
/// **This is the fake for the forward `Scoped` used to have to be clever
/// about.** `Listen.listen` once took the request handler as a `Self`-spelled
/// callback and invoked it, so a wrapper could not pass the handler along
/// unchanged: it had to rebuild it, putting the scope back around the context
/// the acceptor handed out. `core/net/server` owns the loop now and calls the
/// handler itself, so all five forwards below are ordinary — and the case at
/// the bottom of this file can make the call rather than only claim the bound.
struct OneShot {
    binds: Int,
}

/// The address `OneShot` answers with, since it no longer carries one.
let SERVED_URL: Str = "127.0.0.1";

impl Listen for OneShot {
    fn listenBind(
        self,
        address: Str,
        port: Int,
        plan: [Serve],
        requestLimit: Int,
        idleTimeoutMillis: Int,
    ): Result<Listener, ServeError> {
        match (self.binds) {
            0 => .Err(ServeError { cause: .PermissionDenied, detail: "no address" }),
            _ => .Ok(Listener { handle: 1, port: 8080, handlers: 1 }),
        }
    }

    fn listenAccept(self, handle: Int): Result<Int, ServeError> {
        match (handle) {
            1 => .Ok(7),
            _ => .Err(ServeError { cause: .Closed, detail: "" }),
        }
    }

    fn listenRequest(self, connection: Int): Result<Request, ServeError> {
        match (connection) {
            7 => {
                .Ok(Request { method: .Get, url: SERVED_URL, headers: [], body: [] })
            },
            _ => .Err(ServeError { cause: .Closed, detail: "" }),
        }
    }

    /// `.Closed` after one answer, because an effect method takes only `self`
    /// and `self` is immutable — so a stateless fake says "that was the last
    /// one" here rather than counting. `core/net/server` reads `.Closed` from
    /// either call as the ordinary end.
    fn listenRespond(
        self,
        connection: Int,
        status: Int,
        headers: [Header],
        body: [U8],
    ): Result<(), ServeError> {
        match (status) {
            200 => .Err(ServeError { cause: .Closed, detail: "" }),
            _ => .Err(ServeError { cause: .Transport, detail: "not 200" }),
        }
    }

    fn listenClose(self, handle: Int): () {
        ()
    }

    /// Not an upgrade, which is the answer that keeps the request a request:
    /// `core/net/server` reads any `.Err` here as "hand this to `onRequest`".
    fn listenUpgrade(self, connection: Int): Result<Int, ServeError> {
        .Err(ServeError { cause: .Unsupported, detail: "not an upgrade" })
    }

    fn listenReceive(self, socket: Int): Result<Received, ServeError> {
        .Err(ServeError { cause: .Closed, detail: "" })
    }
}

/// Swallows everything. An effect method takes only `self`, so a fake here
/// cannot record what it was told; the claim is that every method is reachable
/// through a scope by name.
struct Quiet {}

impl Sockets for Quiet {
    fn socketSendText(self, socket: Int, text: Str): () {
        ()
    }

    fn socketSendBytes(self, socket: Int, body: [U8]): () {
        ()
    }

    fn socketClose(self, socket: Int, code: Int, reason: Str): () {
        ()
    }
}

// -----------------------------------------------------------------------------
// The functions a scope's body calls
// -----------------------------------------------------------------------------
//
// Each takes a bounded `C` and is called with a `Scoped<C>`, which is the
// point: a scope's body hands the wrapper to code written against the bound,
// and the wrapper has to satisfy it.

fn charge<C: Alloc>(ctx: C, bytes: Int): Int {
    let region = alloc.allocate(ctx, bytes);
    region.0
}

fn printed<C: Stdout>(ctx: C): () {
    let _ = io.print(ctx, "a").ignore();
    let _ = io.println(ctx, "b").ignore();
    io.writeBytes(ctx, [99]).ignore()
}

fn warned<C: Stderr>(ctx: C): () {
    let _ = io.eprint(ctx, "x").ignore();
    io.eprintln(ctx, "y").ignore()
}

fn firstLine<C: Stdin>(ctx: C): Str {
    io.readLine(ctx).withDefault("none")
}

fn readBack<C: Alloc + FsRead>(ctx: C, at: Str): Str {
    match (fs.readText(ctx, path.of(ctx, at))) {
        .Ok(text) => text,
        .Err(_e) => "missing",
    }
}

/// The six writing methods of `FsWrite`, called by name so a missing forward
/// is a build error. The answers are not asserted — a `TestFs` under a scope answers
/// exactly what it answers without one — only that each call reaches one.
fn wroteEveryWay<C: Alloc + FsWrite>(ctx: C): Int {
    let wroteBytes = match (fs.writeBytes(ctx, path.of(ctx, "b"), [1])) {
        .Ok(_u) => 8,
        .Err(_e) => 0,
    };
    let appended = match (fs.append(ctx, path.of(ctx, "b"), [2])) {
        .Ok(_u) => 16,
        .Err(_e) => 0,
    };
    let wroteText = match (fs.writeText(ctx, path.of(ctx, "c"), "c")) {
        .Ok(_u) => 32,
        .Err(_e) => 0,
    };
    let renamed = match (fs.rename(ctx, path.of(ctx, "c"), path.of(ctx, "d"))) {
        .Ok(_u) => 64,
        .Err(_e) => 0,
    };
    let removed = match (fs.remove(ctx, path.of(ctx, "d"))) {
        .Ok(_u) => 128,
        .Err(_e) => 0,
    };
    let made = match (fs.makeDir(ctx, path.of(ctx, "e"))) {
        .Ok(_u) => 256,
        .Err(_e) => 0,
    };
    wroteBytes + appended + wroteText + renamed + removed + made
}

/// The four reading methods beyond `readFile`, on `wroteEveryWay`'s terms.
/// `syncFile` is here rather than there because it is not a write — it is the
/// commit point of one, and there is nothing it could be hiding.
fn readEveryWay<C: Alloc + FsRead + FsWrite>(ctx: C): Int {
    let exists = if (fs.exists(ctx, path.of(ctx, "a"))) { 1 } else { 0 };
    let dir = match (fs.listDir(ctx, path.of(ctx, "."))) {
        .Ok(_e) => 2,
        .Err(_e) => 0,
    };
    let bytes = match (fs.readBytes(ctx, path.of(ctx, "a"))) {
        .Ok(_b) => 4,
        .Err(_e) => 0,
    };
    let synced = match (fs.sync(ctx, path.of(ctx, "b"))) {
        .Ok(_u) => 512,
        .Err(_e) => 0,
    };
    exists + dir + bytes + synced
}

/// Ten calls, ten bits. Writes first, so `syncFile` has a file to commit.
fn touchedEveryFile<C: Alloc + FsRead + FsWrite>(ctx: C): Int {
    let wrote = wroteEveryWay(ctx);
    let read = readEveryWay(ctx);
    wrote + read
}

fn status<C: Net>(ctx: C): Int {
    let request = Request { method: .Get, url: "http://x/", headers: [], body: [] };
    match (http.send(ctx, request)) {
        .Ok(response) => response.status,
        .Err(_e) => 0,
    }
}

fn ticked<C: Clock>(ctx: C): I64 {
    let _ = time.sleepMs(ctx, 0);
    time.now(ctx).0
}

fn rolled<C: Rand>(ctx: C): Int {
    random.int(ctx, 1, 1000)
}

fn variable<C: Env>(ctx: C, name: Str): Str {
    env.get(ctx, name).withDefault("unset")
}

fn firstArgument<C: Env>(ctx: C): Str {
    env.args(ctx)[0].withDefault("none")
}

fn exited<C: Proc>(ctx: C): Int {
    let _ = proc.exit(ctx, 0);
    1
}

fn indexed<C: Alloc + Tasks>(ctx: C, items: [Int]): Int {
    let out = tasks.parallel(ctx, items, fn(c, i, item) => i * 100 + item);
    out[0].withDefault(0) + out[1].withDefault(0)
}

fn pushed<C: Sockets>(ctx: C): Int {
    // A forged `Socket`, which is what an inert handle allows: the three
    // `Sockets` methods are reached through it, and each one goes through the
    // scope's forward on the way.
    let socket = server.Socket(1);
    let _sentText = socket.send(ctx, .Text("hi"));
    let _sentBytes = socket.send(ctx, .Binary([1, 2]));
    let _closed = socket.close(ctx, .Normal);
    1
}

/// A whole server reached through `core/net/server`, with a handler written
/// against the very type the call hands it — a `Scoped<C>` when the caller is
/// inside a scope, and the bare `C` when it is not.
fn served<C: Alloc + Listen + Tasks>(ctx: C): Bool {
    server
        .serve(ctx, server.Server {
            port: 8080,
            address: .Some("127.0.0.1"),
            onRequest: fn(_c, _request) => {
                Response { status: 200, headers: [], body: [] }
            },
        })
        .isOk()
}

/// The same server with a handler that **uses** what it is handed.
///
/// `serve` calls the handler itself, under the context it was given, so what
/// arrives here is the `Scoped<C>` this was called on — and a handler may
/// therefore charge the scope and print on the caller's stdout, neither of
/// which the acceptor grants. A handler that ignored its first parameter, like
/// `served` above, would pass whatever arrived.
fn servedUsing<C: Alloc + Listen + Stdout + Tasks>(ctx: C): Bool {
    server
        .serve(ctx, server.Server {
            port: 8080,
            address: .Some("127.0.0.1"),
            onRequest: fn(c, request) => {
                let _ = io.println(c, "handled ${request.url}").ignore();
                let _ = alloc.allocate(c, 16);
                Response { status: 200, headers: [], body: [] }
            },
        })
        .isOk()
}

// -----------------------------------------------------------------------------
// `Alloc` does not forward
// -----------------------------------------------------------------------------

test "a charge inside a scope reaches the scope and not the wrapped allocator" {
    let gp = alloc.generalPurpose();
    let ctx = context {
        Alloc: gp,
    };

    // Once outside the scope, so the two totals are distinguishable by more
    // than "one of them is zero".
    let _ = charge(ctx, 10);

    let inside = alloc.scoped(ctx, fn(c) => charge(c, 64) + charge(c, 100));

    // The scope answered the same `Region` an unscoped allocator would have:
    // `allocate(n)` is `n` under every implementation of the model.
    assert.eq(inside, 164);

    // And the wrapped allocator saw only the one charge that was not scoped.
    assert.eq(gp.stats(), Stats { allocations: 1, bytes: 10 });
}

test "a scope's own totals are the charges it took" {
    let ctx = context {
        Alloc: alloc.generalPurpose(),
    };
    let inside = alloc.scoped(ctx, fn(c) => {
        let _ = charge(c, 64);
        let _ = charge(c, 0);
        c.stats()
    });
    assert.eq(inside, Stats { allocations: 2, bytes: 64 });
}

test "two scopes over one context count separately" {
    let gp = alloc.generalPurpose();
    let ctx = context {
        Alloc: gp,
    };
    let first = alloc.scoped(ctx, fn(c) => {
        let _ = charge(c, 8);
        c.stats().bytes
    });
    let second = alloc.scoped(ctx, fn(c) => {
        let _ = charge(c, 40);
        c.stats().bytes
    });
    assert.eq(first, 8);
    assert.eq(second, 40);
    assert.eq(gp.stats(), Stats { allocations: 0, bytes: 0 });
}

test "a scope inside a scope is a scope of its own" {
    let gp = alloc.generalPurpose();
    let ctx = context {
        Alloc: gp,
    };
    let both = alloc.scoped(ctx, fn(outer) => {
        let _ = charge(outer, 5);
        let inner = alloc.scoped(outer, fn(i) => {
            let _ = charge(i, 900);
            i.stats().bytes
        });
        (outer.stats().bytes, inner)
    });
    // The inner scope's charge is the inner scope's: the outer one kept its own
    // five bytes and never saw the nine hundred.
    assert.eq(both, (5, 900));
    assert.eq(gp.stats().allocations, 0);
}

test "a scope that outlives its body charges nothing" {
    // `body`'s return type is unbounded, so a body may hand its `Scoped` back.
    // The arena is released when `scoped` returns and its handle is retired, so
    // a charge afterwards moves no counter — a number that stops, never a use
    // of memory that has been given back.
    let ctx = context {
        Alloc: alloc.generalPurpose(),
    };
    let escaped = alloc.scoped(ctx, fn(c) => c);
    let after = charge(escaped, 512);
    assert.eq(after, 512);
    assert.eq(escaped.stats(), Stats { allocations: 0, bytes: 0 });
}

// -----------------------------------------------------------------------------
// Every other effect forwards
// -----------------------------------------------------------------------------

test "a scope forwards standard output" {
    let out = testing.stdout();
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Stdout: out,
    };
    let _ = alloc.scoped(ctx, fn(c) => printed(c));
    assert.eq(out.captured(), "ab\nc");
}

test "a scope forwards standard error" {
    let err = testing.stderr();
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Stderr: err,
    };
    let _ = alloc.scoped(ctx, fn(c) => warned(c));
    assert.eq(err.captured(), "xy\n");
}

test "a scope forwards standard input" {
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Stdin: testing.stdin().lines(["one", "two"]),
    };
    assert.eq(alloc.scoped(ctx, fn(c) => firstLine(c)), "one");
}

test "a scope forwards the filesystem" {
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        FsRead: testing.fs().files([("a", "A")]),
    };
    assert.eq(alloc.scoped(ctx, fn(c) => readBack(c, "a")), "A");
    assert.eq(alloc.scoped(ctx, fn(c) => readBack(c, "nope")), "missing");
}

test "a scope forwards every method of the filesystem" {
    // Ten calls, ten bits. What matters is that each reached the `TestFs`
    // rather than a wrapper that answered for it, and a scope that dropped one
    // of them would not compile.
    // One double bound to both halves: `FsRead` and `FsWrite` are two effects
    // over one filesystem, and two `fs()` calls would be two filesystems.
    let bareDisk = testing.fs().files([("a", "A")]);
    let bare = context {
        Alloc: alloc.generalPurpose(),
        FsRead: bareDisk,
        FsWrite: bareDisk,
    };
    let wrappedDisk = testing.fs().files([("a", "A")]);
    let wrapped = context {
        Alloc: alloc.generalPurpose(),
        FsRead: wrappedDisk,
        FsWrite: wrappedDisk,
    };
    assert.eq(
        alloc.scoped(wrapped, fn(c) => touchedEveryFile(c)),
        touchedEveryFile(bare),
    );
}

test "a scope forwards the network" {
    // A teapot, so a forwarded `fetch` is distinguishable from a refusal that
    // never left the wrapper.
    let teapot = testing
        .net()
        .respond(fn(_request) => .Ok(Response { status: 418, headers: [], body: [] }));
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Net: teapot,
    };
    assert.eq(alloc.scoped(ctx, fn(c) => status(c)), 418);
}

test "a scope forwards the clock" {
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Clock: testing.clock().at(1234),
    };
    assert.eq(alloc.scoped(ctx, fn(c) => ticked(c)), 1234);
}

test "a scope forwards randomness" {
    // Two contexts at one seed: the scoped draw and the bare draw are the same
    // number, which they could not be if the wrapper had answered.
    let bare = context {
        Alloc: alloc.generalPurpose(),
        Rand: testing.rand().seed(7),
    };
    let wrapped = context {
        Alloc: alloc.generalPurpose(),
        Rand: testing.rand().seed(7),
    };
    assert.eq(alloc.scoped(wrapped, fn(c) => rolled(c)), rolled(bare));
}

test "a scope forwards the environment" {
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Env: testing.env().variables([("HOME", "/h")]).arguments(["first", "second"]),
    };
    assert.eq(alloc.scoped(ctx, fn(c) => variable(c, "HOME")), "/h");
    assert.eq(alloc.scoped(ctx, fn(c) => variable(c, "NOPE")), "unset");
    assert.eq(alloc.scoped(ctx, fn(c) => firstArgument(c)), "first");
}

test "a scope forwards the process" {
    // `exitWith` cannot be called for its effect in a test — the double absorbs
    // it — so the claim here is that a `Scoped<C>` satisfies `Proc` where `C`
    // does and the method is reachable through it by name.
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Proc: testing.proc(),
    };
    assert.eq(alloc.scoped(ctx, fn(c) => exited(c)), 1);
}

test "a scope forwards tasks" {
    // Program order, which is what `tasks()` schedules unless a test says
    // otherwise — and the results are in the items' order whatever it
    // schedules, which is `Tasks`' own promise.
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Tasks: testing.tasks(),
    };
    assert.eq(alloc.scoped(ctx, fn(c) => indexed(c, [7, 9])), 116);
}

test "a scope forwards sockets" {
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Sockets: Quiet { },
    };
    assert.eq(alloc.scoped(ctx, fn(c) => pushed(c)), 1);
}

// `Listen` is five ordinary forwards, and it is worth saying why that sentence
// is short. The effect used to take the request handler as a `Self`-spelled
// callback and *invoke* it, which made this the one `impl` in `core/alloc` that
// could not pass its argument along: `Self` is `Scoped<C>` at the wrapper and
// the acceptor inside it, so the handler had to be rebuilt. That rebuilt
// handler was a call both native backends faulted on, until
// `middle/monomorphize.rs`'s `rewrite_call_args` stopped retyping it and
// started adapting the call.
//
// `core/net/server` owns the loop now and calls `onRequest` itself, under the
// caller's context, so nothing crosses `Listen` but a handle, a request and a
// response — and the property that mattered is unchanged and still asserted
// below: a handler running inside a scope charges the scope.
//
// F3 put the loop on tasks, so `serve` now needs `Tasks` beside `Listen` and
// the wrapper is on both paths at once: the fan-out goes through
// `Scoped<C>`'s `Tasks` forward and every worker's accept through its `Listen`
// one. Two forwards that used to be tested apart are tested together here, and
// the handler still lands inside the scope.

test "a scope forwards listening" {
    // A real server through the wrapper: the bind is refused, and the refusal
    // comes back out through the scope.
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Listen: OneShot { binds: 0 },
        Tasks: testing.tasks(),
    };
    assert.isFalse(alloc.scoped(ctx, fn(c) => served(c)));
}

test "a scope forwards listening onto a handler the loop calls" {
    // The handler runs inside the scope: it prints on the caller's stdout and
    // charges the scope's arena, and the caller's own allocator does not move.
    let out = testing.stdout();
    let gp = alloc.generalPurpose();
    let ctx = context {
        Alloc: gp,
        Listen: OneShot { binds: 1 },
        Stdout: out,
        Tasks: testing.tasks(),
    };
    assert.isTrue(alloc.scoped(ctx, fn(c) => servedUsing(c)));
    assert.eq(out.captured(), "handled 127.0.0.1\n");
    assert.eq(gp.stats(), Stats { allocations: 0, bytes: 0 });
}

test "a server answers the handler it is given" {
    // The other half, with nothing wrapped: the handler runs, its `200` is what
    // the acceptor accepts, and `serve` ends `.Ok` on the listener's `.Closed`.
    // The context is the ordinary three now rather than the bare fake, because
    // `serve` fans its loop out and a fan-out needs somewhere to run.
    let ctx = context {
        Alloc: alloc.generalPurpose(),
        Listen: OneShot { binds: 1 },
        Tasks: testing.tasks(),
    };
    assert.isTrue(served(ctx));
    let refused = context {
        Alloc: alloc.generalPurpose(),
        Listen: OneShot { binds: 0 },
        Tasks: testing.tasks(),
    };
    assert.isFalse(served(refused));
}

// -----------------------------------------------------------------------------
// The shape a server's `onRequest` will have
// -----------------------------------------------------------------------------
//
// The note's example is
//
//     onRequest: fn(c, request) => alloc.scoped(c, fn(c2) => handle(c2, request)),
//
// and there is no `Server` to hang it on yet. What is pinned here is the part
// that has nothing to do with servers: a handler written against a bound,
// wrapped in a scope by a lambda that captures the request and hands the
// scope's context to the handler. When `core/net/server` lands, its hook takes
// this expression unchanged.

fn handle<C: Alloc + FsRead + Stdout>(ctx: C, request: Request): Response {
    let _ = io.println(ctx, "serving").ignore();
    // The charge a handler makes on its own behalf, which under `dispatch` is
    // the scope's and not the server's.
    let _ = alloc.allocate(ctx, alloc.strBytes(request.url.len()));
    match (fs.readText(ctx, path.of(ctx, request.url))) {
        .Ok(_body) => Response { status: 200, headers: [], body: [] },
        .Err(_e) => Response { status: 404, headers: [], body: [] },
    }
}

/// The wrapping itself, as a plain function over a context and a request.
fn dispatch<C: Alloc + FsRead + Stdout>(ctx: C, request: Request): Response {
    alloc.scoped(ctx, fn(c) => handle(c, request))
}

test "a request handler wrapped in a scope is an ordinary call" {
    let out = testing.stdout();
    let gp = alloc.generalPurpose();
    let ctx = context {
        Alloc: gp,
        FsRead: testing.fs().files([("index.html", "<p>")]),
        Stdout: out,
    };

    let found = dispatch(ctx, Request {
        method: .Get,
        url: "index.html",
        headers: [],
        body: [],
    });
    let absent = dispatch(ctx, Request {
        method: .Get,
        url: "nope",
        headers: [],
        body: [],
    });

    assert.eq(found.status, 200);
    assert.eq(absent.status, 404);
    // The handler printed through the scope, on the caller's own stdout.
    assert.eq(out.captured(), "serving\nserving\n");
    // And nothing it charged reached the caller's allocator.
    assert.eq(gp.stats().allocations, 0);
}
