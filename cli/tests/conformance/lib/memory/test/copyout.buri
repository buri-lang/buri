// `design/native/MEMORY.md` §7.2.1 — the copy out of a scope.
//
// A `core/alloc::scoped` body allocates out of the scope's own mappings, and
// those mappings are `munmap`ed when it returns. Exactly one value leaves, and
// it leaves as a **deep copy**: every counted block reachable from `body`'s
// answer is duplicated onto the caller's allocator first, at every depth.
//
// **What these cases are is a use-after-free detector.** Every one of them
// builds a value inside a scope out of blocks the *program* allocated — never
// a literal, which is immortal and lives in the artifact's constant pool
// (VALUE-MODEL.md §5.2) and would be copied correctly whatever the glue did —
// and then reads it after the scope has ended. On the native backends a
// pointer that still named the arena would be a read of unmapped memory; on
// JavaScript there is no arena and the copy is the identity, and the cases
// still say what the answer is. So this file asserts *values*, which is what
// both backends can agree about, and `cli/runtime/memory.rs`'s own cases
// assert the things only one of them has: that the pages went back, and that
// a copy is not a share.
//
// The shapes are the ones the walk has an arm for, because an arm with no case
// is an arm nothing is holding to its word: a `Str`, a `[T]`, a nested `[[T]]`,
// a struct, a tagged enum with a payload, an `Option`'s niche, a closure's
// captured environment, and a recursive type whose field is behind a box.

from "core/alloc" import * as alloc;
from "core/effect" import { Alloc };
from "core/host/testing" import * as testing;
from "core/testing/assert" import * as assert;

derive Eq, Show for Labelled;
// -----------------------------------------------------------------------------
// The shapes
// -----------------------------------------------------------------------------

struct Labelled {
    label: Str,
    parts: [Str],
    count: Int,
}

derive Eq, Show for Answer;
enum Answer {
    Nothing,
    Text(Str),
    Many([Str]),
    Both { head: Str, rest: [Str] },
}

derive Eq, Show for Chain;
/// A type that reaches itself, so `middle::layout` puts the recursive field
/// behind a pointer (VALUE-MODEL.md §5.2) — which is the one arm of the walk
/// that copies a block without descending into it in the same breath.
enum Chain {
    End,
    Link(Str, Chain),
}

/// A `Str` this program built rather than one the compiler interned.
///
/// **This is the load-bearing helper of the file.** A literal is `IMMORTAL`
/// and is not in any arena, so a scope that answered one would prove nothing
/// about copying out of a scope. `repeat` allocates.
fn built<C: Alloc>(ctx: C, unit: Str, times: Int): Str {
    unit.repeat(ctx, times)
}

// -----------------------------------------------------------------------------
// One block deep
// -----------------------------------------------------------------------------

test "a scope answers a string it built" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => built(c, "ab", 4));
    assert.eq(out, "abababab");
}

test "a scope answers a string built by concatenation" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => built(c, "x", 3).concat(c, built(c, "y", 2)));
    assert.eq(out, "xxxyy");
}

test "a scope answers a list of strings it built" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => [built(c, "a", 2), built(c, "b", 3)]);
    assert.eq(out, ["aa", "bbb"]);
}

test "a scope answers a list of integers, which holds no counted block" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => [1, 2, 3].map(c, fn(x) => x * 2));
    assert.eq(out, [2, 4, 6]);
}

// -----------------------------------------------------------------------------
// Nested
// -----------------------------------------------------------------------------

test "a scope answers a nested list of lists of strings" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        [[built(c, "a", 1), built(c, "b", 2)], [built(c, "c", 3)], []]
    });
    assert.eq(out, [["a", "bb"], ["ccc"], []]);
}

test "a scope answers three lists deep" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => [[[built(c, "z", 4)]]]);
    assert.eq(out, [[["zzzz"]]]);
}

test "a scope answers a list its body built with map" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        [1, 2, 3].mapCtx(c, fn(k, n) => "-".repeat(k, n))
    });
    assert.eq(out, ["-", "--", "---"]);
}

// -----------------------------------------------------------------------------
// Aggregates and enums
// -----------------------------------------------------------------------------

test "a scope answers a struct whose fields are counted" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        Labelled {
            label: built(c, "k", 2),
            parts: [built(c, "p", 1), built(c, "q", 3)],
            count: 2,
        }
    });
    assert.eq(out, Labelled { label: "kk", parts: ["p", "qqq"], count: 2 });
}

test "a scope answers an enum variant carrying a string" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => Answer.Text(built(c, "hi", 2)));
    assert.eq(out, Answer.Text("hihi"));
}

test "a scope answers an enum variant carrying a list" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        Answer.Many([built(c, "m", 2), built(c, "n", 1)])
    });
    assert.eq(out, Answer.Many(["mm", "n"]));
}

test "a scope answers an enum record variant carrying both" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        Answer.Both { head: built(c, "h", 3), rest: [built(c, "r", 2)] }
    });
    assert.eq(out, Answer.Both { head: "hhh", rest: ["rr"] });
}

// A variant with nothing in it: the walk's tag dispatch has no arm for it, and
// the copy has to fall through to the join rather than off the end.
test "a scope answers an enum variant carrying nothing" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        let _ = built(c, "discarded", 4);
        Answer.Nothing
    });
    assert.eq(out, Answer.Nothing);
}

test "a scope answers a `.Some` through the niche" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out: Option<Str> = alloc.scoped(ctx, fn(c) => .Some(built(c, "s", 3)));
    assert.eq(out, .Some("sss"));
}

// `.None` is a null pointer where a `Str`'s block would be (VALUE-MODEL.md §6),
// and every other byte of the payload is whatever the frame last held — so a
// copy that walked it unguarded would copy a block from an address that was
// never a pointer.
test "a scope answers a `.None` through the niche" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out: Option<Str> = alloc.scoped(ctx, fn(c) => {
        let _ = built(c, "discarded", 4);
        .None
    });
    assert.eq(out, .None);
}

test "a scope answers a Result carrying a list" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out: Result<[Str], Str> = alloc.scoped(ctx, fn(c) => .Ok([built(c, "o", 2)]));
    assert.eq(out, .Ok(["oo"]));
}

test "a scope answers a Result carrying an error string" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out: Result<[Str], Str> = alloc.scoped(ctx, fn(c) => .Err(built(c, "e", 3)));
    assert.eq(out, .Err("eee"));
}

test "a scope answers a value behind a box" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(c) => {
        Chain.Link(built(c, "a", 2), Chain.Link(built(c, "b", 1), Chain.End))
    });
    assert.eq(out, Chain.Link("aa", Chain.Link("b", Chain.End)));
}

// -----------------------------------------------------------------------------
// Closures
// -----------------------------------------------------------------------------
//
// A closure's environment is a heap block that does not record what it holds:
// `Ty::Fn` is silent about the captures, so the block carries its own release
// function and — since G5 — its own copy function, in the two words before the
// record (`backend/stencil/glue.rs`'s `ENV_FIELDS`). These are the cases that
// hold that second word to its word.

test "a scope answers a closure whose environment it built" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let f = alloc.scoped(ctx, fn(c) => {
        let greeting = built(c, "ab", 4);
        fn() => greeting
    });
    assert.eq(f(), "abababab");
}

test "a scope answers a closure capturing a list of strings" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let f = alloc.scoped(ctx, fn(c) => {
        let parts = [built(c, "p", 2), built(c, "q", 1)];
        fn() => parts
    });
    assert.eq(f(), ["pp", "q"]);
}

test "a scope answers a list of closures" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let fs = alloc.scoped(ctx, fn(c) => {
        let one = built(c, "1", 2);
        let two = built(c, "2", 3);
        [fn() => one, fn() => two]
    });
    assert.eq(fs.map(ctx, fn(f) => f()), ["11", "222"]);
}

// -----------------------------------------------------------------------------
// Scopes beside and inside each other
// -----------------------------------------------------------------------------

test "a scope inside a scope answers through both" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(outer) => {
        alloc.scoped(outer, fn(inner) => [built(inner, "i", 2), built(inner, "j", 3)])
    });
    assert.eq(out, ["ii", "jjj"]);
}

test "a scope inside a scope answers a value the outer one adds to" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let out = alloc.scoped(ctx, fn(outer) => {
        let inner = alloc.scoped(outer, fn(c) => built(c, "in", 2));
        [inner, built(outer, "out", 1)]
    });
    assert.eq(out, ["inin", "out"]);
}

// **The strongest case in the file.** A second scope maps and releases pages of
// its own after the first has answered, so an address that had escaped the
// first arena is one this scope's allocator is entitled to hand out again. The
// first answer is read *after* all of that, and it still says what it said.
test "an answer outlives the scopes that run after it" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let first = alloc.scoped(ctx, fn(c) => [built(c, "keep", 3), built(c, "me", 2)]);
    let second = alloc.scoped(ctx, fn(c) => {
        [1].mapCtx(c, fn(k, n) => built(k, "churn", n * 64))
    });
    let third = alloc.scoped(ctx, fn(c) => built(c, "more", 128));
    assert.eq(first, ["keepkeepkeep", "meme"]);
    assert.eq(second.len(), 1);
    assert.eq(third.len(), 512);
}

test "two sequential scopes each answer their own value" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let a = alloc.scoped(ctx, fn(c) => built(c, "a", 3));
    let b = alloc.scoped(ctx, fn(c) => built(c, "b", 4));
    assert.eq(a, "aaa");
    assert.eq(b, "bbbb");
}

// -----------------------------------------------------------------------------
// What crosses in, and what a scope does not touch
// -----------------------------------------------------------------------------

test "a value made outside a scope is unchanged by passing through one" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let outside = built(ctx, "o", 3);
    let out = alloc.scoped(ctx, fn(c) => [outside, built(c, "i", 2)]);
    assert.eq(out, ["ooo", "ii"]);
    assert.eq(outside, "ooo");
}

test "a scope that answers nothing counted answers it anyway" {
    let ctx = context {
        Alloc: testing.alloc(),
    };
    let n = alloc.scoped(ctx, fn(c) => built(c, "count", 4).len());
    assert.eq(n, 20);
}

// The charge counters are `scoped`'s own, and G4's cases are what pin them.
// This one is here so that the *copy* is known not to have moved them: the
// answer is copied onto the caller's allocator, and the caller's allocator is
// the platform's rather than a counting one, so nothing is charged for it.
test "the copy out of a scope charges the caller nothing" {
    let gp = alloc.generalPurpose();
    let ctx = context {
        Alloc: gp,
    };
    let out = alloc.scoped(ctx, fn(c) => [built(c, "z", 3), built(c, "y", 2)]);
    assert.eq(out, ["zzz", "yy"]);
    assert.eq(gp.stats().allocations, 0);
}
