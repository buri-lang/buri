library {
    sources: []

    test {
        sources: [
            "test/reactive.buri",
            "test/reactivity.buri",
            "test/styling.buri",
            "test/tree.buri",
            "test/theme.buri",
        ]

        # Both backends, the way `lib/web`'s router is: `buri test` runs these on
        # JavaScript, `native::conformance` drives the same files through the
        # native backend, and `native::differential` compares the two verdict by
        # verdict. #53 phase 6 earned that — the reactive graph, the reconciled
        # document and the CSS/theme artifacts are all native (phases 1–5), and
        # `markup()` is now the headerless scene document both backends write, so
        # every block agrees byte for byte.
        #
        # JavaScript and not the host default because the render suite otherwise
        # asks for a native test binary in every profile, and a release native
        # binary needs a code generator this toolchain does not carry on every
        # host (`language::release_and_debug_agree`). The native coverage is the
        # driver's, which has no such need.
        #
        # The one block that reached `ui/node`'s real page `mount` is split into
        # `lib/ui_mount`, which keeps `platforms: [JS]` for the mount that cannot
        # cross. `test/render.buri` is not listed — it is the native renderer's
        # own parity file, driven by `native::conformance` alone. The retired
        # `test/fetch.buri` covered `ui/effect`'s callback-shaped `Fetch`; a page
        # grants `Network` now and `semantics/test/http.buri` pins a request.
        platforms: [JS]
    }
}
