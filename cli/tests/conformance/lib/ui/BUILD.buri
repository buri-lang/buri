library {
    sources: []

    test {
        sources: [
            "test/reactive.buri",
            "test/reactivity.buri",
            "test/styling.buri",
            "test/tree.buri",
            "test/theme.buri",
        ]

        # JS only, and not for the usual reason: the reactive graph and the
        # document under the tree are runtime intrinsics. `native::conformance`
        # records `reactivity`, `tree` and `theme` as excluded, with that
        # reason. Two files are the exception it runs on both backends:
        # `reactive.buri`, whose every assertion reads the reconciled document —
        # `identity`, `text`, `count`, an effect log — and `styling.buri`, whose
        # every assertion reads the CSS/theme artifacts `stylesheet`, `install`
        # and `variables` produce. Neither reads `markup()`, whose format still
        # differs until phase 6, so both are `included` there and here at once.
        #
        # There were four. `test/fetch.buri` covered `ui/effect`'s
        # callback-shaped `Fetch`, which is retired: a page grants `Network` now,
        # and `semantics/test/http.buri` is where a request is pinned.
        platforms: [JS]
    }
}
