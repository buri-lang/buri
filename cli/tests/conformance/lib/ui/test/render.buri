// The native renderer's static half (#53): `render(ctx, root).markup()`,
// `.text()`, `.count()` and `.identity()` over trees with no reactivity,
// byte-for-byte the headerless scene document `ui/node`'s `describe` writes for
// the same tree.
//
// This is the parity the design asks for, met by construction: `describe` is
// ordinary Buri that runs the same on both backends, and `renderInto` mirrors
// its `nodeLines` arm for arm — the same helpers build the class-and-declaration
// body — so pinning `markup()` to a headerless `describe` pins it to what the
// JavaScript backend produces for the scene document too. Every static
// `NodeKind` is covered here, styled and unstyled.
//
// It runs on the native backend only — `native::conformance` drives it — because
// on the JavaScript backend `markup()` is still the HTML document double, which
// is Phase 6's to move; here it is the scene lines.
//
// Static only. `choose`/`computed`/`each` are built once, a `Prop` is read once,
// and a widget's `disabled`/`checked`/value are the current ones. Reactive
// behaviour — watchers, identity across writes, reconciliation, dispatch — is a
// later phase.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc as testAlloc };
from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/testing" import { headless, render };

/// The scene document without its `buri-scene 1` / `viewport` header — what
/// `markup()` answers, which is a `describe` with those two lines dropped.
fn headerless(scene: Str): Str {
    // The header is always two lines — `buri-scene 1` and `viewport <w> fit` —
    // and the body is everything after the second newline. A tree that draws
    // nothing (a shut dialog, a bare `nothing`) has no body and no second
    // newline, and its markup is the empty string, so both `.None` arms answer
    // that rather than a header line.
    match (scene.splitOnce("\n")) {
        .None => "",
        .Some(afterFirst) => {
            match (afterFirst.1.splitOnce("\n")) {
                .None => "",
                .Some(afterSecond) => afterSecond.1,
            }
        },
    }
}

/// The one claim every test below makes: a native `markup()` is a headerless
/// `describe` of the same tree, in the same resting state.
fn matchesDescribe<C: Allocator + Ui>(ctx: C, tree: Node<C>): () {
    assert.equal(render(ctx, tree).markup(), headerless(ui.describe(ctx, tree, .Hover)))
}

/// A press handler that does nothing — dropped by the static walk, as `describe`
/// drops it, so it does not reach the markup.
fn noPress<C>(c: C): () {
    let _ = c;
}

fn noFollow<C>(c: C, dest: Str): () {
    let _ = c;
    let _ = dest;
}

test "text, headings and a nested stack, styled" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    matchesDescribe(ctx, ui.text({ content: .Const("bare") }));
    matchesDescribe(
        ctx,
        ui.text({ content: .Const("Prices"), headingLevel: .Some(2), styles: .Some([.FontWeight(.Bold)]) }),
    );
    matchesDescribe(
        ctx,
        ui.stack({
            styles: [.Layout(.Row), .Padding(.Rem(1.0)), .Gap(.Rem(0.5))],
            children: [
                ui.text({ content: .Const("a") }),
                ui.stack({ styles: [], children: [ui.text({ content: .Const("b") }), ui.empty()] }),
            ],
        }),
    );
}

test "every region role lowers to its own element" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    matchesDescribe(
        ctx,
        ui.stack({ styles: [], children: [ui.text({ content: .Const("home") })], role: .Some(.Navigation) }),
    );
    matchesDescribe(
        ctx,
        ui.stack({
            styles: [.Padding(.Rem(1.0))],
            children: [ui.stack({ styles: [], children: [], role: .Some(.Banner) })],
            role: .Some(.Main),
        }),
    );
    matchesDescribe(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [], children: [ui.text({ content: .Const("a") })], role: .Some(.ListItem) }),
                ui.stack({ styles: [], children: [ui.text({ content: .Const("b") })], role: .Some(.ListItem) }),
            ],
            role: .Some(.List),
        }),
    );
    matchesDescribe(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [],
                    children: [
                        ui.stack({ styles: [], children: [ui.text({ content: .Const("H") })], role: .Some(.ColumnHeader) }),
                        ui.stack({ styles: [], children: [ui.text({ content: .Const("c") })], role: .Some(.Cell) }),
                    ],
                    role: .Some(.TableRow),
                }),
            ],
            role: .Some(.Table),
        }),
    );
}

test "a button draws its label or its children" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    matchesDescribe(
        ctx,
        ui.button({ label: .Const("ok"), styles: [.Padding(.Rem(0.5))], onPress: .Some(noPress) }),
    );
    matchesDescribe(
        ctx,
        ui.button({
            label: .Const("ok"),
            styles: [],
            children: .Some([ui.text({ content: .Const("glyph") })]),
            onPress: .Some(noPress),
            isDisabled: .Some(.Const(true)),
        }),
    );
}

test "links, a route link, a picture and an icon" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    matchesDescribe(
        ctx,
        ui.link({ dest: .Const("/a"), children: [ui.text({ content: .Const("go") })], styles: [] }),
    );
    matchesDescribe(
        ctx,
        ui.link({
            dest: .Const("/b"),
            children: [ui.text({ content: .Const("route") })],
            styles: [],
            onFollow: .Some(noFollow),
        }),
    );
    matchesDescribe(
        ctx,
        ui.image({ source: .Const("data:x"), alt: .AccessibilityText("alt"), styles: [.Width(.Rem(4.0))] }),
    );
    matchesDescribe(
        ctx,
        ui.image({ source: .Const("<svg><path d=\"M0 0\"/></svg>"), alt: .Decorative, styles: [.Width(.Rem(1.0))] }),
    );
}

test "fields of every kind, and the run of text they hold" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    let text = signal(ctx, "typed");
    matchesDescribe(
        ctx,
        ui.field({
            label: .Const("Name"),
            kind: .Text,
            value: text,
            styles: [],
            hint: .Some(.Const("hint")),
        }),
    );
    let secret = signal(ctx, "");
    matchesDescribe(
        ctx,
        ui.field({
            label: .Const("Password"),
            kind: .Password,
            value: secret,
            styles: [],
            isDisabled: .Some(.Const(true)),
        }),
    );
    let note = signal(ctx, "lines");
    matchesDescribe(
        ctx,
        ui.field({
            label: .Const("Note"),
            kind: .Multiline,
            value: note,
            styles: [],
        }),
    );
    let level = signal(ctx, 3.0);
    matchesDescribe(
        ctx,
        ui.slider({
            label: .Const("Level"),
            value: level,
            min: 0.0,
            max: 10.0,
            styles: [],
            step: .Some(1.0),
        }),
    );
}

test "toggles, on and off, switch and checkbox" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    let on = signal(ctx, true);
    matchesDescribe(
        ctx,
        ui.toggle({ label: .Const("Wifi"), kind: .Switch, isOn: on, styles: [] }),
    );
    let off = signal(ctx, false);
    matchesDescribe(
        ctx,
        ui.toggle({ label: .Const("Wifi"), kind: .Switch, isOn: off, styles: [] }),
    );
    let ticked = signal(ctx, true);
    matchesDescribe(
        ctx,
        ui.toggle({ label: .Const("Agree"), kind: .Checkbox, isOn: ticked, styles: [] }),
    );
    let clear = signal(ctx, false);
    matchesDescribe(
        ctx,
        ui.toggle({
            label: .Const("Agree"),
            kind: .Checkbox,
            isOn: clear,
            styles: [],
            isDisabled: .Some(.Const(true)),
        }),
    );
}

test "a form with a submit, and a radio group" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    let name = signal(ctx, "");
    matchesDescribe(
        ctx,
        ui.form({
            onSubmit: noPress,
            children: [
                ui.field({ label: .Const("Name"), kind: .Text, value: name, styles: [] }),
                ui.button({ label: .Const("Send"), styles: [], kind: .Some(.Submit) }),
            ],
            styles: [.Padding(.Rem(1.0))],
        }),
    );
    let choice = signal(ctx, "b");
    matchesDescribe(
        ctx,
        ui.picker({
            label: .Const("Pick"),
            options: [
                ("a", ui.text({ content: .Const("First") })),
                ("b", ui.text({ content: .Const("Second") })),
            ],
            value: choice,
            styles: [],
        }),
    );
}

test "choose, computed and each are built once" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    matchesDescribe(
        ctx,
        ui.choose(.Const(true), ui.text({ content: .Const("then") }), ui.text({ content: .Const("else") })),
    );
    matchesDescribe(
        ctx,
        ui.choose(.Const(false), ui.text({ content: .Const("then") }), ui.text({ content: .Const("else") })),
    );
    matchesDescribe(
        ctx,
        ui.computed(fn(_scope) => ui.text({ content: .Const("built"), headingLevel: .Some(1) })),
    );
    matchesDescribe(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.each(.Const(["x", "y", "z"]), fn(item) => item, fn(_c, item, _index) => {
                    ui.stack({ styles: [], children: [ui.text({ content: .Const(item) })], role: .Some(.ListItem) })
                }),
            ],
            role: .Some(.List),
        }),
    );
}

test "a dialog, an overlay, a progress bar and a disclosure" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    let open = signal(ctx, true);
    matchesDescribe(
        ctx,
        ui.dialog({
            isOpen: open,
            label: .Const("Delete?"),
            children: [ui.text({ content: .Const("Sure?") })],
            styles: [.Padding(.Rem(1.0))],
        }),
    );
    let shut = signal(ctx, false);
    matchesDescribe(
        ctx,
        ui.dialog({
            isOpen: shut,
            label: .Const("Hidden"),
            children: [ui.text({ content: .Const("nope") })],
            styles: [],
        }),
    );
    matchesDescribe(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.text({ content: .Const("panel") })],
            onPressOutside: .Some(noPress),
        }),
    );
    matchesDescribe(
        ctx,
        ui.progress({
            label: .Const("Loading"),
            value: .Some(.Const(0.5)),
            styles: [],
            children: .Some([ui.text({ content: .Const("half") })]),
        }),
    );
    let expanded = signal(ctx, true);
    matchesDescribe(
        ctx,
        ui.disclosure({
            summary: .Const("More"),
            isOpen: expanded,
            children: [ui.text({ content: .Const("details") })],
            styles: [],
        }),
    );
    let collapsed = signal(ctx, false);
    matchesDescribe(
        ctx,
        ui.disclosure({
            summary: .Const("More"),
            isOpen: collapsed,
            children: [ui.text({ content: .Const("hidden") })],
            styles: [],
        }),
    );
}

test "text, count and identity over a resolved tree" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    let tree = ui.stack({
        styles: [],
        children: [
            ui.stack({ styles: [], children: [ui.text({ content: .Const("a") })], role: .Some(.ListItem) }),
            ui.stack({ styles: [], children: [ui.text({ content: .Const("b") })], role: .Some(.ListItem) }),
            ui.stack({ styles: [], children: [ui.text({ content: .Const("c") })], role: .Some(.ListItem) }),
        ],
        role: .Some(.List),
    });
    let page = render(ctx, tree);
    assert.equal(page.text(), "a b c");
    assert.equal(page.count("ul"), 1);
    assert.equal(page.count("li"), 3);
    assert.equal(page.count("h1"), 0);
    let first = page.identity("li", 0);
    assert.equal(page.identity("li", 0), first);
    assert.notEqual(page.identity("li", 1), first);
}

test "count reaches the widget elements a form builds" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    let name = signal(ctx, "");
    let email = signal(ctx, "");
    let page = render(
        ctx,
        ui.form({
            onSubmit: noPress,
            children: [
                ui.field({ label: .Const("Name"), kind: .Text, value: name, styles: [] }),
                ui.field({ label: .Const("Email"), kind: .Email, value: email, styles: [] }),
                ui.button({ label: .Const("Send"), styles: [], kind: .Some(.Submit) }),
            ],
            styles: [],
        }),
    );
    assert.equal(page.count("form"), 1);
    assert.equal(page.count("input"), 2);
    assert.equal(page.count("button"), 1);
    assert.equal(page.count("label"), 2);
}
