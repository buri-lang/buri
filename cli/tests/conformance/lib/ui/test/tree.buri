// design/ui-reactivity.md, "The tree". What `ui/node` builds and what the
// runtime makes of it, asserted against a rendered document rather than
// against a picture of one:
//
//   - meaning is the role, and every role lowers to the element that carries
//     it, with `role=` where HTML has none;
//   - arrangement is the style, and a style is applied to the element it
//     belongs to;
//   - an accessibility-critical parameter is a parameter: a button has its
//     label, an image its alt, a field and a toggle their label;
//   - a handler receives its context as a parameter and never captures one;
//   - the three reactive constructors each re-run the smallest thing they
//     can — `choose` and `computed` rebuild one subtree, `each` moves the rows
//     that are still there and builds only the ones that are not;
//   - and a reactive leaf allocates, so `each` walks a filtered view of a
//     signal and a leaf shows text formatted from one.
//
// `ui/testing`'s renderer is the one `mount` uses, against a document the
// runtime supplies. What it cannot cover is what only a browser does — layout,
// painting, focus order, and the browser's own dispatch of a press — and that
// needs a browser rather than a substitute for one.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { FieldKind, Node };
from "ui/prop" import { Prop };
from "ui/signal" import { Signal, signal, watch };
from "ui/style" import { Shadow, Style };
from "ui/testing" import { headless, observer, recorder, render, stylesheet };
from "ui/theme" import { Theme };

// --- helpers -------------------------------------------------------------------------

/// A reactive closure answers a value, and a `fn(Scope) => ()` has nowhere to
/// put it.
fn ignore(value: Int): () {
    let _ = value;
}

/// A row of a keyed list: the item is the key and the text, so that what the
/// document shows says which row it is.
fn labelRow<C>(ctx: C, item: Str, index: Int): Node<C> {
    ui.region(.ListItem, [], [ui.text(.Const(item))])
}

/// The key of a row is the item itself. Two rows with one key is a mistake the
/// runtime refuses, and this is the shape that never makes it.
fn itself(item: Str): Str {
    item
}

/// A heading whose text does not depend on `value`, so that what changes when
/// `value` changes is only whether the subtree was built again.
fn headingFor<C>(value: Int): Node<C> {
    ui.heading(1, [], .Const("head"))
}

// --- structure -----------------------------------------------------------------------

test "a stack is arrangement with no meaning, and text is a bare run" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [ui.text(.Const("hello"))]);
    assert.equal(render(ctx, tree).markup(), "<div>hello</div>");
}

test "nothing renders nothing at all" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [ui.nothing(), ui.text(.Const("only")), ui.nothing()]);
    assert.equal(render(ctx, tree).markup(), "<div>only</div>");
}

test "a row runs along the axis and a column runs down the page" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, ui.row([], [])).markup(), "<div class=\"lay-row\"></div>");
    assert.equal(
        render(ctx, ui.column([], [])).markup(),
        "<div class=\"lay-col\"></div>",
    );
}

test "a caller's own layout wins over the sugar's" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.row([.Layout(.Column)], []);
    assert.equal(render(ctx, tree).markup(), "<div class=\"lay-col\"></div>");
}

test "a spacer takes what is left over" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, ui.spacer()).markup(), "<div class=\"grow-1\"></div>");
}

test "every role lowers to the element that carries it" {
    let ctx = context {
        Ui: headless(),
    };
    let landmarks = ui.stack([], [
        ui.region(.Navigation, [], []),
        ui.region(.Main, [], []),
        ui.region(.Banner, [], []),
        ui.region(.ContentInfo, [], []),
        ui.region(.Complementary, [], []),
        ui.region(.Article, [], []),
        ui.region(.Search, [], []),
    ]);
    assert.equal(
        render(ctx, landmarks).markup(),
        "<div><nav></nav><main></main><header></header><footer></footer><aside></aside><article></article><search role=\"search\"></search></div>",
    );

    let structure = ui.stack([], [
        ui.region(.List, [], [ui.region(.ListItem, [], [])]),
        ui.region(.Group, [], []),
        ui.region(.Separator, [], []),
    ]);
    assert.equal(
        render(ctx, structure).markup(),
        "<div><ul><li></li></ul><div role=\"group\"></div><hr /></div>",
    );

    let live = ui.stack([], [ui.region(.Status, [], []), ui.region(.Alert, [], [])]);
    assert.equal(
        render(ctx, live).markup(),
        "<div><div role=\"status\" aria-live=\"polite\"></div><div role=\"alert\" aria-live=\"assertive\"></div></div>",
    );
}

test "a data table is roles, and its headers say which way they head" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.region(.Table, [], [
        ui.region(.TableRow, [], [
            ui.region(.ColumnHeader, [], [ui.text(.Const("name"))]),
            ui.region(.ColumnHeader, [], [ui.text(.Const("owed"))]),
        ]),
        ui.region(.TableRow, [], [
            ui.region(.RowHeader, [], [ui.text(.Const("ada"))]),
            ui.region(.Cell, [], [ui.text(.Const("3"))]),
        ]),
    ]);
    assert.equal(
        render(ctx, tree).markup(),
        "<table><tr><th scope=\"col\">name</th><th scope=\"col\">owed</th></tr><tr><th scope=\"row\">ada</th><td>3</td></tr></table>",
    );
}

test "a heading is an outline level, and there is no seventh" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [
        ui.heading(1, [], .Const("top")),
        ui.heading(3, [], .Const("inner")),
        ui.heading(9, [], .Const("clamped")),
        ui.heading(0, [], .Const("also clamped")),
    ]);
    assert.equal(
        render(ctx, tree).markup(),
        "<div><h1>top</h1><h3>inner</h3><h6>clamped</h6><h1>also clamped</h1></div>",
    );
}

test "a heading paints what the program asked for and nothing else" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // The size the stack asks for is the size the heading is: nothing in the
    // sheet sets one on the element, so it inherits like any other run of text.
    let tree = ui.stack([.FontSize(.Px(13))], [ui.heading(2, [], .Const("not found"))]);
    assert.equal(
        render(ctx, tree).markup(),
        "<div class=\"fs-13\"><h2>not found</h2></div>",
    );
    // The headless painter reads this, and a browser reads the markup above.
    // They agree only while the heading's line carries what the sheet does.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 600\ne 0 class:fs-13\ne 1 \nt 2 not found",
    );
}

test "a heading takes styles of its own, and they land on the heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = ui.heading(
        2,
        [.FontSize(.Px(28)), .FontWeight(.Bold)],
        .Const("Prices"),
    );
    assert.equal(render(ctx, tree).markup(), "<h2 class=\"fs-28 fw-bold\">Prices</h2>");
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 600\ne 0 class:fs-28 fw-bold\nt 1 Prices",
    );
}

// --- styling -------------------------------------------------------------------------
//
// design/ui-reactivity.md, "Styling". Two tiers: everything except `Computed`
// is extracted at compile time into one atomic class per distinct property
// value, deduped across the whole build, and `Computed` is applied inline and
// is deliberately absent from the stylesheet. So a styling assertion has two
// halves — which classes an element carries, and what those classes mean —
// and `stylesheet()` is the second half.

/// A component with styles of its own that a caller may override.
///
/// The merge happens in the runtime, and it is a scan over `(slot, class)`
/// pairs the compiler assigned: it can only ever choose between classes that
/// are already in the sheet.
fn boxed<C>(extra: [Style], label: Str): Node<C> {
    ui.stack([.Group([.Padding(.Px(8)), .Background(.Rgb(0, 0, 0))]), .Group(extra)], [
        ui.text(.Const(label)),
    ])
}

test "every property lowers to the one declaration it names" {
    let ctx = context {
        Ui: headless(),
    };
    let everything: [Style] = [
        .Group([.Layout(.Row), .Gap(.Px(8))]),
        .Padding(.Rem(1.5)),
        .PaddingX(.Percent(10.0)),
        .PaddingY(.Auto),
        .Width(.Full),
        .Height(.Px(40)),
        .AlignMain(.SpaceBetween),
        .AlignCross(.Center),
        .Grow(2),
        .Background(.Rgb(1, 2, 3)),
        .Foreground(.Rgba(4, 5, 6, 0.5)),
        .BorderWidth(.Px(1)),
        .BorderColor(.Transparent),
        .Radius(.Px(6)),
        .FontSize(.Rem(0.875)),
        .FontWeight(.Semibold),
        .Cursor(.Pointer),
    ];
    assert.equal(
        render(ctx, ui.stack(everything, [])).markup(),
        "<div class=\"lay-row gap-8 p-r1_5 px-pc10 py-auto w-full h-40 am-between ac-center grow-2 bg-010203 fg-040506a0_5 bw-1 bc-none r-6 fs-r0_875 fw-semibold cur-pointer\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".gap-8{gap:8px}"));
    assert.isTrue(sheet.contains(".px-pc10{padding-inline:10%}"));
    assert.isTrue(sheet.contains(".fg-040506a0_5{color:rgba(4,5,6,0.5)}"));
    assert.isTrue(sheet.contains(".bw-1{border-style:solid;border-width:1px}"));
    assert.isTrue(sheet.contains(".fs-r0_875{font-size:0.875rem}"));
}

test "the rest of the vocabulary lowers to the declarations it names" {
    let ctx = context {
        Ui: headless(),
    };
    let rest: [Style] = [
        .AlignSelf(.End),
        .Wrap(true),
        .Scroll(.Y),
        .Shrink(0),
        .Span(2),
        .Pin(.Top, .Px(0)),
        .Position(.Sticky),
        .GapX(.Px(4)),
        .GapY(.Px(6)),
        .PaddingEdge(.Start, .Rem(1.0)),
        .MinWidth(.Px(100)),
        .MaxWidth(.Rem(40.0)),
        .MinHeight(.Px(20)),
        .MaxHeight(.Percent(50.0)),
        .AspectRatio(1.5),
        .BorderStyle(.Dashed),
        .Opacity(0.5),
        .Italic(true),
        .LineHeight(1.5),
        .LetterSpacing(.Px(1)),
        .TextAlign(.Center),
        .TextCase(.Upper),
        .TextLine(.Underline),
        .TextWrap(.Balance),
        .Truncate(2),
    ];
    assert.equal(
        render(ctx, ui.stack(rest, [])).markup(),
        "<div class=\"as-end wrap-wrap scroll-y shrink-0 span-2 pin-out pin-top-0 pos-sticky gapx-4 gapy-6 pe-start-r1 minw-100 maxw-r40 minh-20 maxh-pc50 ar-1_5 bs-dashed op-0_5 it-italic lh-1_5 ls-1 ta-center tc-upper tl-underline tw-balance trunc-2\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pin-top-0{inset-block-start:0px}"));
    assert.isTrue(sheet.contains(".pe-start-r1{padding-inline-start:1rem}"));
    assert.isTrue(sheet.contains(".ar-1_5{aspect-ratio:1.5}"));
    assert.isTrue(
        sheet.contains(
            ".trunc-2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}",
        ),
    );
}

test "pins naming different edges compose, and `Position` owns `position`" {
    let ctx = context {
        Ui: headless(),
    };
    // The overlay written the obvious way: fixed to the viewport, held to all
    // four of its edges.
    let overlay: [Style] = [
        .Position(.PinViewport),
        .Pin(.Top, .Px(0)),
        .Pin(.Bottom, .Px(0)),
        .Pin(.Start, .Px(0)),
        .Pin(.End, .Px(0)),
    ];
    assert.equal(
        render(ctx, ui.stack(overlay, [])).markup(),
        "<div class=\"pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pin-top-0{inset-block-start:0px}"));
    assert.isTrue(sheet.contains(".pin-bottom-0{inset-block-end:0px}"));
    assert.isTrue(sheet.contains(".pin-start-0{inset-inline-start:0px}"));
    assert.isTrue(sheet.contains(".pin-end-0{inset-inline-end:0px}"));
    // Out of the flow is one fact about the element rather than one per edge,
    // and the `Position` beside it wins because the sheet writes it later.
    let pinned = sheet.indexOf(".pin-out{position:absolute}").withDefault(-1);
    let viewport = sheet.indexOf(".pos-viewport{position:fixed}").withDefault(-1);
    assert.isTrue(pinned >= 0);
    assert.isTrue(pinned < viewport);
}

test "padding named edge by edge composes too" {
    let ctx = context {
        Ui: headless(),
    };
    let edges: [Style] = [
        .PaddingEdge(.Top, .Px(1)),
        .PaddingEdge(.Bottom, .Px(2)),
        .PaddingEdge(.Start, .Px(3)),
        .PaddingEdge(.End, .Px(4)),
    ];
    assert.equal(
        render(ctx, ui.stack(edges, [])).markup(),
        "<div class=\"pe-top-1 pe-bottom-2 pe-start-3 pe-end-4\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pe-top-1{padding-block-start:1px}"));
    assert.isTrue(sheet.contains(".pe-end-4{padding-inline-end:4px}"));
}

test "a border named edge by edge composes, and the colour stays whole-box" {
    let ctx = context {
        Ui: headless(),
    };
    // The divider under a table row, the guide line down a submenu: one edge
    // of a box rather than a box of its own.
    let edges: [Style] = [
        .BorderEdge(.Top, .Px(1)),
        .BorderEdge(.Bottom, .Px(2)),
        .BorderEdge(.Start, .Px(3)),
        .BorderEdge(.End, .Rem(0.5)),
        .BorderColor(.Rgb(200, 200, 210)),
    ];
    assert.equal(
        render(ctx, ui.stack(edges, [])).markup(),
        "<div class=\"be-top-1 be-bottom-2 be-start-3 be-end-r0_5 bc-c8c8d2\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ".be-top-1{border-block-start-style:solid;border-block-start-width:1px}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ".be-end-r0_5{border-inline-end-style:solid;border-inline-end-width:0.5rem}",
        ),
    );
    assert.isTrue(sheet.contains(".bc-c8c8d2{border-color:rgb(200,200,210)}"));
}

test "a border edge sits after the width it narrows and before the style" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack(
        [.BorderWidth(.Px(1)), .BorderEdge(.Bottom, .Px(4)), .BorderStyle(.Dashed)],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div class=\"bw-1 be-bottom-4 bs-dashed\"></div>",
    );
    // Position in the sheet is what decides between two properties that touch
    // one declaration: the edge overrides the whole box, and `BorderStyle`
    // overrides the solid both of them implied.
    let sheet = stylesheet();
    let whole = sheet
        .indexOf(".bw-1{border-style:solid;border-width:1px}")
        .withDefault(-1);
    let edge = sheet
        .indexOf(
            ".be-bottom-4{border-block-end-style:solid;border-block-end-width:4px}",
        )
        .withDefault(-1);
    let dashed = sheet.indexOf(".bs-dashed{border-style:dashed}").withDefault(-1);
    assert.isTrue(whole >= 0);
    assert.isTrue(whole < edge);
    assert.isTrue(edge < dashed);
}

test "the same border edge twice is last-wins, and a state is its own slot" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack(
        [
            .BorderEdge(.Bottom, .Px(1)),
            .BorderEdge(.Bottom, .Px(3)),
            .On(.Hover, [.BorderEdge(.Bottom, .Px(1))]),
        ],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div class=\"be-bottom-3 hover_be-bottom-1\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ".hover_be-bottom-1:hover{border-block-end-style:solid;border-block-end-width:1px}",
        ),
    );
}

test "radius named corner by corner composes, and a joined group is spellable" {
    let ctx = context {
        Ui: headless(),
    };
    let corners: [Style] = [
        .RadiusCorner(.TopStart, .Px(1)),
        .RadiusCorner(.TopEnd, .Px(2)),
        .RadiusCorner(.BottomStart, .Px(3)),
        .RadiusCorner(.BottomEnd, .Px(4)),
    ];
    assert.equal(
        render(ctx, ui.stack(corners, [])).markup(),
        "<div class=\"rc-topstart-1 rc-topend-2 rc-bottomstart-3 rc-bottomend-4\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".rc-topstart-1{border-start-start-radius:1px}"));
    assert.isTrue(sheet.contains(".rc-topend-2{border-start-end-radius:2px}"));
    assert.isTrue(sheet.contains(".rc-bottomstart-3{border-end-start-radius:3px}"));
    assert.isTrue(sheet.contains(".rc-bottomend-4{border-end-end-radius:4px}"));
}

test "a corner squares the side that meets its neighbour, and the shorthand loses" {
    let ctx = context {
        Ui: headless(),
    };
    // The middle child of a joined button group: rounded ends, square where it
    // welds onto the button beside it, and one shared hairline.
    let middle: [Style] = [
        .Radius(.Px(6)),
        .RadiusCorner(.TopStart, .Px(0)),
        .RadiusCorner(.BottomStart, .Px(0)),
        .BorderWidth(.Px(1)),
        .BorderEdge(.Start, .Px(0)),
    ];
    assert.equal(
        render(ctx, ui.stack(middle, [])).markup(),
        "<div class=\"r-6 rc-topstart-0 rc-bottomstart-0 bw-1 be-start-0\"></div>",
    );
    let sheet = stylesheet();
    let whole = sheet.indexOf(".r-6{border-radius:6px}").withDefault(-1);
    let corner = sheet
        .indexOf(".rc-topstart-0{border-start-start-radius:0px}")
        .withDefault(-1);
    assert.isTrue(whole >= 0);
    assert.isTrue(whole < corner);
    assert.isTrue(
        sheet.contains(
            ".be-start-0{border-inline-start-style:solid;border-inline-start-width:0px}",
        ),
    );
}

test "an edge and a corner reach the scene document the way the sheet does" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = ui.stack(
        [
            .BorderEdge(.Bottom, .Px(1)),
            .BorderColor(.Rgb(0, 0, 0)),
            .RadiusCorner(.TopEnd, .Px(4)),
        ],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div class=\"be-bottom-1 bc-000000 rc-topend-4\"></div>",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 600\ne 0 class:be-bottom-1 bc-000000 rc-topend-4",
    );
}

test "an edge and a corner the compiler cannot evaluate become inline styles" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so the folder stops and both degrade to the tier
    // `Computed` lives in — the same declarations, written out.
    let thickness = signal(ctx, 2);
    let rounding = signal(ctx, 5);
    assert.equal(
        render(
            ctx,
            ui.stack([.BorderEdge(.Bottom, .Px(thickness.get(ctx)))], []),
        ).markup(),
        "<div style=\"border-block-end-style: solid; border-block-end-width: 2px\"></div>",
    );
    assert.equal(
        render(
            ctx,
            ui.stack([.RadiusCorner(.BottomEnd, .Px(rounding.get(ctx)))], []),
        ).markup(),
        "<div style=\"border-end-end-radius: 5px\"></div>",
    );
}

test "a bleed takes a child out past the padding its parent put it inside" {
    let ctx = context {
        Ui: headless(),
    };
    // The menu separator: the menu is padded by four, and the rule runs from
    // one edge of it to the other.
    let separator: [Style] = [
        .Height(.Px(1)),
        .Bleed(.Start, .Px(4)),
        .Bleed(.End, .Px(4)),
    ];
    assert.equal(
        render(ctx, ui.region(.Separator, separator, [])).markup(),
        "<hr class=\"h-1 bleed-start-4 bleed-end-4\" />",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-start-4{margin-inline-start:-4px}"));
    assert.isTrue(sheet.contains(".bleed-end-4{margin-inline-end:-4px}"));
}

test "bleeds naming different edges compose, and the same edge is last-wins" {
    let ctx = context {
        Ui: headless(),
    };
    let edges: [Style] = [
        .Bleed(.Top, .Px(1)),
        .Bleed(.Bottom, .Px(2)),
        .Bleed(.Start, .Px(3)),
        .Bleed(.End, .Px(4)),
        .Bleed(.Start, .Px(8)),
    ];
    assert.equal(
        render(ctx, ui.stack(edges, [])).markup(),
        "<div class=\"bleed-top-1 bleed-bottom-2 bleed-start-8 bleed-end-4\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-top-1{margin-block-start:-1px}"));
    assert.isTrue(sheet.contains(".bleed-bottom-2{margin-block-end:-2px}"));
    assert.isTrue(sheet.contains(".bleed-start-8{margin-inline-start:-8px}"));
    assert.isTrue(sheet.contains(".bleed-end-4{margin-inline-end:-4px}"));
    // The one that lost is not in the sheet either: a class nobody reaches is
    // not shipped.
    assert.isFalse(sheet.contains(".bleed-start-3"));
}

test "a bleed is a distance outwards, so nothing inward and nothing automatic" {
    let ctx = context {
        Ui: headless(),
    };
    let lengths: [Style] = [
        .Bleed(.Top, .Rem(0.5)),
        .Bleed(.Bottom, .Percent(10.0)),
        .Bleed(.Start, .Full),
        .Bleed(.End, .Px(-8)),
    ];
    assert.equal(
        render(ctx, ui.stack(lengths, [])).markup(),
        "<div class=\"bleed-top-r0_5 bleed-bottom-pc10 bleed-start-full bleed-end-n8\"></div>",
    );
    assert.equal(
        render(ctx, ui.stack([.Bleed(.Top, .Auto)], [])).markup(),
        "<div class=\"bleed-top-auto\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-top-r0_5{margin-block-start:-0.5rem}"));
    assert.isTrue(sheet.contains(".bleed-bottom-pc10{margin-block-end:-10%}"));
    assert.isTrue(sheet.contains(".bleed-start-full{margin-inline-start:-100%}"));
    // Inward is the margin this vocabulary does not have, and `.Auto` is not a
    // distance at all. Both bleed nothing.
    assert.isTrue(sheet.contains(".bleed-end-n8{margin-inline-end:0px}"));
    assert.isTrue(sheet.contains(".bleed-top-auto{margin-block-start:0px}"));
}

test "a bleed shares an edge with a pin and a padding and fights neither" {
    let ctx = context {
        Ui: headless(),
    };
    let stated: [Style] = [
        .Bleed(.Start, .Px(8)),
        .PaddingEdge(.Start, .Px(2)),
        .Pin(.Start, .Px(4)),
        .Position(.Flow),
        .On(.Hover, [.Bleed(.Start, .Px(16))]),
    ];
    assert.equal(
        render(ctx, ui.stack(stated, [])).markup(),
        "<div class=\"bleed-start-8 pe-start-2 pin-out pin-start-4 pos-flow hover_bleed-start-16\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-start-8{margin-inline-start:-8px}"));
    assert.isTrue(sheet.contains(".pe-start-2{padding-inline-start:2px}"));
    assert.isTrue(sheet.contains(".pin-start-4{inset-inline-start:4px}"));
    // A state is a slot of its own, so the hover rule does not replace the
    // resting one — it applies over it.
    assert.isTrue(
        sheet.contains(".hover_bleed-start-16:hover{margin-inline-start:-16px}"),
    );
}

test "a bleed the compiler cannot evaluate is written out inline" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so the folder stops here and the style degrades to
    // the tier `Computed` lives in.
    let out = signal(ctx, 23);
    let tree = ui.stack([.Bleed(.Start, .Px(out.get(ctx)))], []);
    assert.equal(
        render(ctx, tree).markup(),
        "<div style=\"margin-inline-start: -23px\"></div>",
    );
    assert.isFalse(stylesheet().contains("bleed-start-23"));
}

test "the scene document writes the bleed the browser was given" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    // The inline tier on both sides: the painter reads the scene, a browser
    // reads the style attribute, and the two say the same thing.
    let out = signal(ctx, 8);
    let tree = ui.stack(
        [.Bleed(.Start, .Px(out.get(ctx))), .Bleed(.Top, .Px(0 - out.get(ctx)))],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div style=\"margin-inline-start: -8px; margin-block-start: 0px\"></div>",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 600\ne 0 margin-inline-start:-8px;margin-block-start:0px",
    );
}

test "a value with no bounded spelling is named by what it is" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [
        ui.stack([.Layout(.Grid([.Fraction(1), .Fixed(.Px(200)), .Auto]))], []),
        ui.stack([.Layout(.Layers)], []),
        ui.stack([.FontFamily(.Mono)], []),
        ui.stack([.FontFamily(.Named("Iosevka"))], []),
        ui.stack(
            [
                .Shadow(Shadow {
                    x: .Px(0),
                    y: .Px(2),
                    blur: .Px(6),
                    spread: .Px(0),
                    color: .Rgba(0, 0, 0, 0.25),
                }),
            ],
            [],
        ),
    ]);
    let _ = render(ctx, tree).markup();
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains("{display:grid;grid-template-columns:1fr 200px auto}"),
    );
    // The children's half of `Layers` is a rule about descendants, which is the
    // one place a class needs two blocks.
    assert.isTrue(sheet.contains("{grid-area:1/1}"));
    assert.isTrue(
        sheet.contains("{font-family:ui-monospace,SFMono-Regular,monospace}"),
    );
    assert.isTrue(sheet.contains("{font-family:\"Iosevka\",ui-sans-serif,sans-serif}"));
    assert.isTrue(sheet.contains("{box-shadow:0px 2px 6px 0px rgba(0,0,0,0.25)}"));
}

test "the last value of a property is the one that survives" {
    let ctx = context {
        Ui: headless(),
    };
    // Both sides are literals, so this resolved at compile time: the element
    // carries one class rather than two that fight in the cascade.
    let tree = ui.stack([.Background(.Rgb(0, 0, 0)), .Background(.Inherit)], []);
    assert.equal(render(ctx, tree).markup(), "<div class=\"bg-inherit\"></div>");
}

test "the remaining alignments and weights and cursors each have a name" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [
        ui.stack([.AlignMain(.Start), .AlignCross(.End), .FontWeight(.Regular)], []),
        ui.stack(
            [.AlignMain(.Stretch), .AlignCross(.SpaceAround), .FontWeight(.Medium)],
            [],
        ),
        ui.stack([.AlignMain(.SpaceEvenly), .FontWeight(.Bold), .Cursor(.Default)], []),
        ui.stack([.Cursor(.Text)], []),
        ui.stack([.Cursor(.NotAllowed)], []),
    ]);
    assert.equal(
        render(ctx, tree).markup(),
        "<div><div class=\"am-start ac-end fw-regular\"></div><div class=\"am-stretch ac-around fw-medium\"></div><div class=\"am-evenly fw-bold cur-default\"></div><div class=\"cur-text\"></div><div class=\"cur-notallowed\"></div></div>",
    );
}

test "two elements asking for one padding are given one class" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [
        ui.stack([.Padding(.Px(11))], []),
        ui.row([.Padding(.Px(11))], []),
    ]);
    assert.equal(
        render(ctx, tree).markup(),
        "<div><div class=\"p-11\"></div><div class=\"lay-row p-11\"></div></div>",
    );
    assert.isTrue(stylesheet().contains(".p-11{padding:11px}"));
}

test "a state is a pseudo-class in the stylesheet and costs nothing on the element" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack(
        [.Background(.Rgb(1, 1, 1)), .On(.Hover, [.Background(.Rgb(2, 2, 2))])],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div class=\"bg-010101 hover_bg-020202\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".hover_bg-020202:hover{background-color:rgb(2,2,2)}"),
    );
    // A pseudo-class and the base value are different conflict slots: they
    // apply at different times, so they never resolve against each other.
    assert.isTrue(sheet.contains(".bg-010101{background-color:rgb(1,1,1)}"));
}

test "a breakpoint is a media query, mobile first" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack(
        [.At(.Medium, [.Padding(.Px(24))]), .At(.Large, [.Padding(.Px(32))])],
        [],
    );
    assert.equal(render(ctx, tree).markup(), "<div class=\"md_p-24 lg_p-32\"></div>");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".md_p-24{padding:24px}"));
    assert.isTrue(sheet.contains(".lg_p-32{padding:32px}"));
    // Ascending, so a larger tier overrides a smaller one by being written
    // later. That is what makes a max-width query unnecessary.
    let medium = assert.some(sheet.indexOf("(min-width:48rem)"));
    let large = assert.some(sheet.indexOf("(min-width:64rem)"));
    assert.isTrue(medium < large);
}

test "a state inside a breakpoint is both at once" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([.At(.Small, [.On(.Focus, [.Radius(.Px(3))])])], []);
    assert.equal(render(ctx, tree).markup(), "<div class=\"sm_focus_r-3\"></div>");
    assert.isTrue(
        stylesheet().contains(".sm_focus_r-3:focus-visible{border-radius:3px}"),
    );
}

test "an em is a length, and it follows the element's own text size" {
    let ctx = context {
        Ui: headless(),
    };
    // A rem follows the root and an em follows this element, so tracking
    // written once is right at every size the title is ever set at.
    let tree = ui.stack(
        [
            .FontSize(.Px(18)),
            .LetterSpacing(.Em(-0.025)),
            .Gap(.Em(0.5)),
            .Padding(.Em(1.0)),
            .Width(.Em(12.0)),
        ],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div class=\"fs-18 ls-en0_025 gap-e0_5 p-e1 w-e12\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".ls-en0_025{letter-spacing:-0.025em}"));
    assert.isTrue(sheet.contains(".gap-e0_5{gap:0.5em}"));
    assert.isTrue(sheet.contains(".p-e1{padding:1em}"));
    assert.isTrue(sheet.contains(".w-e12{width:12em}"));
}

test "an em resolves per property like every other length" {
    let ctx = context {
        Ui: headless(),
    };
    // The same slot twice is last-wins, whichever unit each side is in.
    let overridden = ui.stack([.Padding(.Em(1.0)), .Padding(.Px(4))], []);
    assert.equal(render(ctx, overridden).markup(), "<div class=\"p-4\"></div>");
    // Two edges are two slots, so they compose.
    let edges = ui.stack(
        [.PaddingEdge(.Top, .Em(0.5)), .PaddingEdge(.Bottom, .Em(1.5))],
        [],
    );
    assert.equal(
        render(ctx, edges).markup(),
        "<div class=\"pe-top-e0_5 pe-bottom-e1_5\"></div>",
    );
    // And a condition is a slot of its own, in the stylesheet either way.
    let stated = ui.stack(
        [.On(.Hover, [.Gap(.Em(2.0))]), .At(.Medium, [.Gap(.Em(3.0))])],
        [],
    );
    assert.equal(
        render(ctx, stated).markup(),
        "<div class=\"hover_gap-e2 md_gap-e3\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pe-top-e0_5{padding-block-start:0.5em}"));
    assert.isTrue(sheet.contains(".pe-bottom-e1_5{padding-block-end:1.5em}"));
    assert.isTrue(sheet.contains(".hover_gap-e2:hover{gap:2em}"));
    assert.isTrue(sheet.contains(".md_gap-e3{gap:3em}"));
}

test "a reversed layout paints backwards and leaves the document alone" {
    let ctx = context {
        Ui: headless(),
    };
    // The order is the caller's, and it is the order a screen reader and the
    // tab ring read. Only the paint is reversed.
    let footer = ui.stack([.Layout(.ColumnReverse)], [
        ui.text(.Const("cancel")),
        ui.text(.Const("confirm")),
    ]);
    assert.equal(
        render(ctx, footer).markup(),
        "<div class=\"lay-colrev\">cancelconfirm</div>",
    );
    assert.equal(
        render(ctx, ui.stack([.Layout(.RowReverse)], [])).markup(),
        "<div class=\"lay-rowrev\"></div>",
    );
    // One property, so the last one written is the one that survives.
    assert.equal(
        render(ctx, ui.stack([.Layout(.Row), .Layout(.RowReverse)], [])).markup(),
        "<div class=\"lay-rowrev\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".lay-colrev{display:flex;flex-direction:column-reverse}"),
    );
    assert.isTrue(
        sheet.contains(".lay-rowrev{display:flex;flex-direction:row-reverse}"),
    );
    // `Truncate` is declared after `Layout` and still overrides it, which is
    // the ordering the four layouts shared and the two new ones join.
    let layout = assert.some(sheet.indexOf(".lay-rowrev"));
    let truncate = assert.some(sheet.indexOf(".trunc-"));
    assert.isTrue(layout < truncate);
}

test "a translate shifts the painted box and moves no sibling" {
    let ctx = context {
        Ui: headless(),
    };
    // The press every design system writes: a pixel down while the pointer is
    // held, with the row around it exactly where it was.
    let save = ui.button(
        .Const("Save"),
        [.Radius(.Px(8)), .On(.Active, [.Translate(.Px(0), .Px(1))])],
        fn(_c, _e) => (),
    );
    assert.equal(
        render(ctx, save).markup(),
        "<button type=\"button\" class=\"r-8 active_tr-0-1\">Save</button>",
    );
    // One slot: two translates are one transform, and the last wins.
    assert.equal(
        render(
            ctx,
            ui.stack(
                [.Translate(.Px(4), .Px(4)), .Translate(.Em(0.5), .Percent(-50.0))],
                [],
            ),
        ).markup(),
        "<div class=\"tr-e0_5-pcn50\"></div>",
    );
    // A `Position` beside it is a different declaration and composes.
    assert.equal(
        render(
            ctx,
            ui.stack([.Position(.Sticky), .Translate(.Rem(1.0), .Auto)], []),
        ).markup(),
        "<div class=\"pos-sticky tr-r1-auto\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".active_tr-0-1:active{transform:translate(0px,1px)}"),
    );
    assert.isTrue(sheet.contains(".tr-e0_5-pcn50{transform:translate(0.5em,-50%)}"));
    assert.isTrue(sheet.contains(".tr-r1-auto{transform:translate(1rem,auto)}"));
}

test "focus-within is a state, and it is the container's own" {
    let ctx = context {
        Ui: headless(),
    };
    // The input group: the wrapper owns the hairline and the ring, and the
    // field inside it is bare.
    let group = ui.row(
        [
            .BorderWidth(.Px(1)),
            .On(.FocusWithin, [.BorderColor(.Rgb(2, 2, 2))]),
            .At(.Small, [.On(.FocusWithin, [.Radius(.Px(3))])]),
        ],
        [],
    );
    assert.equal(
        render(ctx, group).markup(),
        "<div class=\"lay-row bw-1 focuswithin_bc-020202 sm_focuswithin_r-3\"></div>",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".focuswithin_bc-020202:focus-within{border-color:rgb(2,2,2)}"),
    );
    assert.isTrue(
        sheet.contains(".sm_focuswithin_r-3:focus-within{border-radius:3px}"),
    );
    // `Focus` is `:focus-visible` on the element itself, so the two are
    // different conditions and different slots.
    let both = ui.stack(
        [.On(.Focus, [.Opacity(0.9)]), .On(.FocusWithin, [.Opacity(0.8)])],
        [],
    );
    assert.equal(
        render(ctx, both).markup(),
        "<div class=\"focus_op-0_9 focuswithin_op-0_8\"></div>",
    );
}

test "a document is taken in one state, and carries only that state's classes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = ui.stack(
        [
            .Background(.Rgb(1, 1, 1)),
            .On(.Hover, [.Background(.Rgb(2, 2, 2))]),
            .On(.FocusWithin, [.Background(.Rgb(3, 3, 3))]),
        ],
        [],
    );
    assert.equal(
        ui.describe(ctx, tree, .FocusWithin),
        "buri-scene 1\nviewport 800 600\ne 0 class:bg-010101 focuswithin_bg-030303",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 600\ne 0 class:bg-010101 hover_bg-020202",
    );
}

test "the three new entries write the same declarations inline" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so the folder stops at each of these and all three
    // degrade to the tier `Computed` lives in. What they write out there has to
    // be the CSS the classes above mean.
    let reversed = signal(ctx, true);
    let tracking = signal(ctx, 0.1);
    let sunk = signal(ctx, -0.5);
    let tree = ui.stack(
        [
            .Layout(if (reversed.get(ctx)) { .ColumnReverse } else { .Column }),
            .LetterSpacing(.Em(tracking.get(ctx))),
            .Translate(.Px(0), .Em(sunk.get(ctx))),
        ],
        [],
    );
    assert.equal(
        render(ctx, tree).markup(),
        "<div style=\"display: flex; flex-direction: column-reverse; letter-spacing: 0.1em; transform: translate(0px,-0.5em)\"></div>",
    );
    // The scene document the headless painter reads says the same thing.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 600\ne 0 display:flex;flex-direction:column-reverse;letter-spacing:0.1em;transform:translate(0px,-0.5em)",
    );
    assert.isFalse(stylesheet().contains("letter-spacing:0.1em"));
}

test "a `When` puts both branches in the stylesheet and swaps between them" {
    let ctx = context {
        Ui: headless(),
    };
    let lit = signal(ctx, false);
    let tree = ui.stack(
        [
            .When(.Cell(lit), [.Background(.Rgb(255, 0, 0))], [
                .Background(.Rgb(0, 0, 255)),
            ]),
        ],
        [],
    );
    let view = render(ctx, tree);
    assert.equal(view.markup(), "<div class=\"bg-0000ff\"></div>");
    lit.set(ctx, true);
    assert.equal(view.markup(), "<div class=\"bg-ff0000\"></div>");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bg-ff0000{background-color:rgb(255,0,0)}"));
    assert.isTrue(sheet.contains(".bg-0000ff{background-color:rgb(0,0,255)}"));
}

test "a `Computed` style is inline, re-serialises, and is never in the stylesheet" {
    let ctx = context {
        Ui: headless(),
    };
    let width = signal(ctx, 137);
    let tree = ui.stack([.Computed(fn(scope) => [.Width(.Px(width.get(scope)))])], []);
    let view = render(ctx, tree);
    assert.equal(view.markup(), "<div style=\"width: 137px\"></div>");
    width.set(ctx, 241);
    assert.equal(view.markup(), "<div style=\"width: 241px\"></div>");
    let sheet = stylesheet();
    assert.isFalse(sheet.contains("137px"));
    assert.isFalse(sheet.contains("241px"));
}

test "a style the compiler cannot evaluate becomes an inline style" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so it is not pure, so the folder stops here — and
    // the style degrades to the tier `Computed` lives in rather than failing.
    let share = signal(ctx, 7);
    let tree = ui.stack([.Grow(share.get(ctx))], []);
    assert.equal(render(ctx, tree).markup(), "<div style=\"flex-grow: 7\"></div>");
    assert.isFalse(stylesheet().contains("grow-7"));
}

test "a style that arrives as a parameter resolves last-wins over emitted classes" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [
        boxed([], "plain"),
        boxed([.Background(.Rgb(9, 9, 9))], "loud"),
    ]);
    assert.equal(
        render(ctx, tree).markup(),
        "<div><div class=\"p-8 bg-000000\">plain</div><div class=\"p-8 bg-090909\">loud</div></div>",
    );
}

test "a static style registers nothing and a computed one re-runs once per change" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let width = signal(ctx, 21);
    let view = render(
        ctx,
        ui.stack([], [
            ui.stack([.Padding(.Px(13))], []),
            ui.stack(
                [.Computed(fn(scope) => [.Width(.Px(log.note(width.get(scope))))])],
                [],
            ),
        ]),
    );
    assert.equal(
        view.markup(),
        "<div><div class=\"p-13\"></div><div style=\"width: 21px\"></div></div>",
    );
    // The static one never ran a computation, so nothing it could have noted
    // is here; the computed one ran once.
    assert.equal(log.noted(), [21]);
    width.set(ctx, 22);
    assert.equal(
        view.markup(),
        "<div><div class=\"p-13\"></div><div style=\"width: 22px\"></div></div>",
    );
    assert.equal(log.noted(), [21, 22]);
}

// --- widgets -------------------------------------------------------------------------

test "a button carries its label, and a press runs its handler" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let count = signal(ctx, 0);
    let tree = ui.button(.Const("add"), [], fn(c, e) => {
        count.update(c, fn(n) => n + 1)
    });
    let page = render(ctx, tree);
    assert.equal(page.markup(), "<button type=\"button\">add</button>");
    let _ = page.press("add");
    let _ = page.press("add");
    assert.equal(count.get(ctx), 2);
}

test "a handler is handed the context the tree was rendered with" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let seen = signal(ctx, "");
    // The handler captures the signal, which holds no authority, and takes the
    // authority to write it as a parameter. Capturing the context instead is
    // `lambda-captures-effect`, which is `cli/tests/reject/`'s business.
    let page = render(
        ctx,
        ui.button(.Const("go"), [], fn(c, e) => seen.set(c, "pressed")),
    );
    let _ = page.press("go");
    assert.equal(seen.get(ctx), "pressed");
}

test "a link says where it goes" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.link(.Const("/prices"), [], [ui.text(.Const("prices"))]);
    assert.equal(render(ctx, tree).markup(), "<a href=\"/prices\">prices</a>");
}

test "an attribute follows a prop that varies" {
    let ctx = context {
        Ui: headless(),
    };
    let dest = signal(ctx, "/one");
    let page = render(ctx, ui.link(.Cell(dest), [], [ui.text(.Const("there"))]));
    assert.equal(page.markup(), "<a href=\"/one\">there</a>");
    let _ = dest.set(ctx, "/two");
    assert.equal(page.markup(), "<a href=\"/two\">there</a>");
}

test "an image says what it shows" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = ui.stack([], [
        ui.image(.Const("/cat.png"), .Const("a cat, asleep")),
        ui.image(.Const("/rule.png"), .Const("")),
    ]);
    // The empty string is how a decorative image says it is decorative,
    // which a reader has to be told and cannot guess.
    assert.equal(
        render(ctx, tree).markup(),
        "<div><img src=\"/cat.png\" alt=\"a cat, asleep\" /><img src=\"/rule.png\" alt=\"\" /></div>",
    );
}

test "a field is labelled, and what is typed into it is in its signal" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "ada");
    let page = render(ctx, ui.field(.Const("name"), .Text, [], name));
    assert.equal(
        page.markup(),
        "<label><span>name</span><input type=\"text\" value=\"ada\" /></label>",
    );
    let _ = page.fill("name", "grace");
    assert.equal(name.get(ctx), "grace");
}

test "a field follows its signal when something else writes it" {
    let ctx = context {
        Ui: headless(),
    };
    let name = signal(ctx, "ada");
    let page = render(ctx, ui.field(.Const("name"), .Text, [], name));
    let _ = name.set(ctx, "grace");
    assert.equal(
        page.markup(),
        "<label><span>name</span><input type=\"text\" value=\"grace\" /></label>",
    );
}

test "a field kind is what the field accepts" {
    let ctx = context {
        Ui: headless(),
    };
    let value = signal(ctx, "");
    let tree = ui.stack([], [
        ui.field(.Const("story"), .Multiline, [], value),
        ui.field(.Const("secret"), .Password, [], value),
        ui.field(.Const("address"), .Email, [], value),
        ui.field(.Const("how many"), .Number, [], value),
        ui.field(.Const("query"), .Search, [], value),
    ]);
    assert.equal(
        render(ctx, tree).markup(),
        "<div><label><span>story</span><textarea></textarea></label><label><span>secret</span><input type=\"password\" /></label><label><span>address</span><input type=\"email\" /></label><label><span>how many</span><input type=\"number\" /></label><label><span>query</span><input type=\"search\" /></label></div>",
    );
}

test "a toggle is two states and a label" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let done = signal(ctx, false);
    let page = render(ctx, ui.toggle(.Const("done"), [], done));
    assert.equal(
        page.markup(),
        "<label><input type=\"checkbox\" /><span>done</span></label>",
    );
    let _ = page.flip("done");
    assert.isTrue(done.get(ctx));
    assert.equal(
        page.markup(),
        "<label><input type=\"checkbox\" checked /><span>done</span></label>",
    );
    let _ = page.flip("done");
    assert.isFalse(done.get(ctx));
}

test "the label a field and a toggle are wrapped in flows on one line" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let name = signal(ctx, "ada");
    let done = signal(ctx, false);
    // The wrapper is the runtime's element rather than the program's, and a
    // browser lays it out as an inline box: the control and its text sit on one
    // line, and a control as wide as the line takes one of its own. The painter
    // has no inline flow, so the scene says what that comes to in the
    // vocabulary it does have — and the two renderers agree only while it does.
    let inline = "display:flex;flex-direction:row;flex-wrap:wrap;align-items:center";
    assert.equal(
        ui.describe(ctx, ui.toggle(.Const("done"), [], done), .Hover),
        str.format(
            ctx,
            "buri-scene 1\nviewport 800 600\ne 0 ${inline}\ne 1 \nt 1 done",
        ),
    );
    // A field is the same wrapper with the text first, which is the order the
    // markup puts them in too.
    assert.equal(
        ui.describe(ctx, ui.field(.Const("name"), .Text, [], name), .Hover),
        str.format(
            ctx,
            "buri-scene 1\nviewport 800 600\ne 0 ${inline}\nt 1 name\ne 1 field:text\nt 2 ada",
        ),
    );
}

test "a field's kind is in the scene, and a password's value is never in it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let secret = signal(ctx, "hunter2");
    // `describe` used to drop the kind, so all six fields painted alike and a
    // snapshot of a password field held the secret as ordinary text. The kind
    // is the `type` the markup carries — `multiline` for the `textarea` that
    // has none — and it is what the painter masks a value on.
    assert.containsText(kindOf(ctx, .Text, secret), "field:text");
    assert.containsText(kindOf(ctx, .Multiline, secret), "field:multiline");
    assert.containsText(kindOf(ctx, .Password, secret), "field:password");
    assert.containsText(kindOf(ctx, .Email, secret), "field:email");
    assert.containsText(kindOf(ctx, .Number, secret), "field:number");
    assert.containsText(kindOf(ctx, .Search, secret), "field:search");
}

/// The scene document one field of a kind writes.
fn kindOf<C: Allocator>(ctx: C, kind: FieldKind, value: Signal<Str>): Str {
    ui.describe(ctx, ui.field(.Const("secret"), kind, [], value), .Hover)
}

test "a control takes styles of its own, and they land on the control" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "ada");
    let done = signal(ctx, false);
    let tree = ui.stack([], [
        ui.button(
            .Const("go"),
            [.Padding(.Px(12)), .On(.Hover, [.Opacity(0.9)])],
            fn(_c, _e) => (),
        ),
        ui.link(.Const("/prices"), [.Foreground(.Rgb(9, 9, 9))], []),
        ui.field(.Const("name"), .Text, [.Radius(.Px(4))], name),
        ui.toggle(.Const("done"), [.Width(.Px(20))], done),
    ]);
    // The classes are on the button, the anchor and the two inputs, never on a
    // wrapper. That is what makes a state work: a wrapper is not the thing that
    // is hovered, focused or disabled.
    assert.equal(
        render(ctx, tree).markup(),
        "<div><button type=\"button\" class=\"p-12 hover_op-0_9\">go</button><a href=\"/prices\" class=\"fg-090909\"></a><label><span>name</span><input type=\"text\" class=\"r-4\" value=\"ada\" /></label><label><input type=\"checkbox\" class=\"w-20\" /><span>done</span></label></div>",
    );
    assert.isTrue(stylesheet().contains(".hover_op-0_9:hover{opacity:0.9}"));
}

test "the sheet drops the chrome a browser draws by itself" {
    // Otherwise a styled button paints twice: its own background inside the
    // browser's bevel. The reset is `:where(...)`, which weighs nothing in the
    // cascade, so every class beats it wherever the two meet.
    let sheet = stylesheet();
    // A heading's level is its outline position and nothing else, so the size,
    // the weight and the margins a browser paints on one go too. The margin is
    // the half no ancestor could reach: it is not inherited, and the scene
    // document the headless painter reads has no counterpart for one.
    assert.isTrue(
        sheet.contains(
            ":where(h1,h2,h3,h4,h5,h6){font-size:inherit;font-weight:inherit;margin:0}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ":where(button){appearance:none;background:none;border:0;padding:0;font:inherit;color:inherit}",
        ),
    );
    assert.isTrue(sheet.contains(":where(a){color:inherit;text-decoration:none}"));
    // A checkbox is left out: `appearance: none` erases the tick, and this
    // vocabulary has nothing to draw a new one with.
    assert.isTrue(
        sheet.contains(
            ":where(input:not([type=checkbox]),textarea){appearance:none;background:none;border:0;padding:0;font:inherit;color:inherit}",
        ),
    );
    // It opens the sheet, ahead of every class in it.
    let reset = assert.some(sheet.indexOf(":where(h1,"));
    let padding = assert.some(sheet.indexOf(".p-12{"));
    assert.isTrue(reset < padding);
}

test "a list has no marker until one is asked for" {
    let ctx = context {
        Ui: headless(),
    };
    // A navigation rail, written the accessible way. The role is what a reader
    // is told; the browser's disc and its forty-pixel indent are styling
    // nobody asked for, so the sheet drops both.
    let rail = ui.region(.List, [], [
        ui.region(.ListItem, [], [
            ui.link(.Const("/a"), [], [ui.text(.Const("Alpha"))]),
        ]),
    ]);
    assert.equal(
        render(ctx, rail).markup(),
        "<ul><li><a href=\"/a\">Alpha</a></li></ul>",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(":where(ul,ol){margin:0;padding:0;list-style:none}"));

    // And back again for a list that wants them, with room for them to hang
    // in. The class beats the reset, which is why the reset opens the sheet.
    let numbered = ui.region(
        .List,
        [.PaddingEdge(.Start, .Px(24)), .ListMarker(.Decimal)],
        [ui.region(.ListItem, [], [ui.text(.Const("first"))])],
    );
    assert.equal(
        render(ctx, numbered).markup(),
        "<ul class=\"pe-start-24 lm-decimal\"><li>first</li></ul>",
    );
    assert.isTrue(sheet.contains(".lm-decimal{list-style-type:decimal}"));
    let reset = assert.some(sheet.indexOf(":where(ul,ol)"));
    let marker = assert.some(sheet.indexOf(".lm-decimal{"));
    assert.isTrue(reset < marker);
}

test "a form is submitted, which is behaviour and so not a role" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let draft = signal(ctx, "");
    let added = signal(ctx, "");
    let page = render(
        ctx,
        ui.form(fn(c, e) => added.set(c, draft.get(c)), [], [
            ui.field(.Const("what"), .Text, [], draft),
        ]),
    );
    let _ = page.fill("what", "milk");
    let _ = page.submit(0);
    assert.equal(added.get(ctx), "milk");
}

// --- reactivity in the tree ----------------------------------------------------------

test "text follows the cell it was given" {
    let ctx = context {
        Ui: headless(),
    };
    let label = signal(ctx, "before");
    let page = render(ctx, ui.text(.Cell(label)));
    assert.equal(page.text(), "before");
    let _ = label.set(ctx, "after");
    assert.equal(page.text(), "after");
}

test "a constant leaf registers nothing and never changes" {
    let ctx = context {
        Ui: headless(),
    };
    let unrelated = signal(ctx, 0);
    let page = render(ctx, ui.text(.Const("fixed")));
    let _ = unrelated.set(ctx, 1);
    assert.equal(page.text(), "fixed");
}

test "choose shows one subtree or the other" {
    let ctx = context {
        Ui: headless(),
    };
    let signedIn = signal(ctx, false);
    let page = render(
        ctx,
        ui.choose(
            .Cell(signedIn),
            ui.text(.Const("welcome")),
            ui.text(.Const("sign in")),
        ),
    );
    assert.equal(page.text(), "sign in");
    let _ = signedIn.set(ctx, true);
    assert.equal(page.text(), "welcome");
    let _ = signedIn.set(ctx, false);
    assert.equal(page.text(), "sign in");
}

test "the subtree choose removed is disposed with it" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let showing = signal(ctx, true);
    let n = signal(ctx, 1);
    let page = render(
        ctx,
        ui.choose(
            .Cell(showing),
            ui.text(.Computed(fn(c) => "${log.note(n.get(c))}")),
            ui.nothing(),
        ),
    );
    assert.equal(log.noted(), [1]);
    let _ = n.set(ctx, 2);
    assert.equal(log.noted(), [1, 2]);

    // The subtree is gone, so what it created is gone: writing what it read is
    // no longer a reason for anything to run.
    let _ = showing.set(ctx, false);
    let _ = n.set(ctx, 3);
    assert.equal(log.noted(), [1, 2]);
    assert.equal(page.text(), "");
}

test "computed rebuilds its subtree from whatever it read" {
    let ctx = context {
        Ui: headless(),
    };
    let count = signal(ctx, 0);
    let page = render(
        ctx,
        ui.computed(fn(c) => {
            ui.heading(if (count.get(c) > 1) { 2 } else { 1 }, [], .Const("head"))
        }),
    );
    assert.equal(page.count("h1"), 1);
    assert.equal(page.count("h2"), 0);
    let _ = count.set(ctx, 5);
    assert.equal(page.count("h1"), 0);
    assert.equal(page.count("h2"), 1);
}

test "a computed subtree is rebuilt, and a leaf prop is not" {
    let ctx = context {
        Ui: headless(),
    };
    let n = signal(ctx, 0);

    // The coarse instrument: the whole subtree is built again, so the element
    // is a different one.
    let coarse = render(ctx, ui.computed(fn(c) => headingFor(n.get(c))));
    let first = coarse.identity("h1", 0);
    let _ = n.set(ctx, 1);
    assert.notEqual(coarse.identity("h1", 0), first);

    // The fine one: the same element, with one run of text changed.
    let fine = render(ctx, ui.heading(1, [], .Computed(fn(c) => "${n.get(c)}")));
    let kept = fine.identity("h1", 0);
    let _ = n.set(ctx, 2);
    assert.equal(fine.identity("h1", 0), kept);
    assert.equal(fine.text(), "2");
}

// --- keyed lists ---------------------------------------------------------------------

test "each renders one row per item" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "b", "c"]);
    let page = render(
        ctx,
        ui.region(.List, [], [ui.each(.Cell(items), itself, labelRow)]),
    );
    assert.equal(page.markup(), "<ul><li>a</li><li>b</li><li>c</li></ul>");
    assert.equal(page.count("li"), 3);
}

test "an empty list renders no rows" {
    let ctx = context {
        Ui: headless(),
    };
    let items: Signal<[Str]> = signal(ctx, []);
    let page = render(
        ctx,
        ui.region(.List, [], [ui.each(.Cell(items), itself, labelRow)]),
    );
    assert.equal(page.count("li"), 0);
    let _ = items.set(ctx, ["only"]);
    assert.equal(page.markup(), "<ul><li>only</li></ul>");
}

test "inserting a row keeps the rows that were already there" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "c"]);
    let page = render(
        ctx,
        ui.region(.List, [], [ui.each(.Cell(items), itself, labelRow)]),
    );
    let a = page.identity("li", 0);
    let c = page.identity("li", 1);

    let _ = items.set(ctx, ["a", "b", "c"]);
    assert.equal(page.markup(), "<ul><li>a</li><li>b</li><li>c</li></ul>");
    assert.equal(page.identity("li", 0), a);
    assert.notEqual(page.identity("li", 1), a);
    assert.equal(page.identity("li", 2), c);
}

test "removing a row keeps the others" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "b", "c"]);
    let page = render(
        ctx,
        ui.region(.List, [], [ui.each(.Cell(items), itself, labelRow)]),
    );
    let a = page.identity("li", 0);
    let c = page.identity("li", 2);

    let _ = items.set(ctx, ["a", "c"]);
    assert.equal(page.markup(), "<ul><li>a</li><li>c</li></ul>");
    assert.equal(page.identity("li", 0), a);
    assert.equal(page.identity("li", 1), c);
}

test "reordering moves the rows rather than rebuilding them" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "b", "c"]);
    let page = render(
        ctx,
        ui.region(.List, [], [ui.each(.Cell(items), itself, labelRow)]),
    );
    let a = page.identity("li", 0);
    let b = page.identity("li", 1);
    let c = page.identity("li", 2);

    let _ = items.set(ctx, ["c", "a", "b"]);
    assert.equal(page.markup(), "<ul><li>c</li><li>a</li><li>b</li></ul>");
    // Keyed: the same three elements, in the new order. This is the assertion
    // the whole `key` parameter exists for — with rows keyed by position, all
    // three would have been rebuilt and every one of these would fail.
    assert.equal(page.identity("li", 0), c);
    assert.equal(page.identity("li", 1), a);
    assert.equal(page.identity("li", 2), b);
}

test "a row that leaves takes what it created with it" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let n = signal(ctx, 1);
    let items = signal(ctx, ["kept", "leaving"]);
    let page = render(
        ctx,
        ui.region(.List, [], [
            ui.each(.Cell(items), itself, fn(c, item, index) => {
                ui.region(.ListItem, [], [
                    ui.text(.Computed(fn(s) => "${item} ${log.note(n.get(s))}")),
                ])
            }),
        ]),
    );
    assert.equal(log.noted(), [1, 1]);

    // Both rows read `n`, so both re-run.
    let _ = n.set(ctx, 2);
    assert.equal(log.noted(), [1, 1, 2, 2]);

    // One row leaves. What it created is disposed with it, so the next write
    // runs one computation rather than two.
    let _ = items.set(ctx, ["kept"]);
    let _ = n.set(ctx, 3);
    assert.equal(log.noted(), [1, 1, 2, 2, 3]);
    assert.equal(page.text(), "kept 3");
}

test "a row keeps its own reactive leaf across a reorder" {
    let ctx = context {
        Ui: headless(),
    };
    let suffix = signal(ctx, "!");
    let items = signal(ctx, ["a", "b"]);
    let page = render(
        ctx,
        ui.region(.List, [], [
            ui.each(.Cell(items), itself, fn(c, item, index) => {
                ui.region(.ListItem, [], [
                    ui.text(.Computed(fn(s) => "${item}${suffix.get(s)}")),
                ])
            }),
        ]),
    );
    assert.equal(page.markup(), "<ul><li>a!</li><li>b!</li></ul>");
    let _ = items.set(ctx, ["b", "a"]);
    let _ = suffix.set(ctx, "?");
    assert.equal(page.markup(), "<ul><li>b?</li><li>a?</li></ul>");
}

test "a list nested in a list reconciles on its own" {
    let ctx = context {
        Ui: headless(),
    };
    let inner = signal(ctx, ["x"]);
    let outer = signal(ctx, ["a", "b"]);
    let page = render(
        ctx,
        ui.region(.List, [], [
            ui.each(.Cell(outer), itself, fn(c, item, index) => {
                ui.region(.ListItem, [], [
                    ui.text(.Const(item)),
                    ui.region(.List, [], [ui.each(.Cell(inner), itself, labelRow)]),
                ])
            }),
        ]),
    );
    assert.equal(page.count("li"), 4);
    let _ = inner.set(ctx, ["x", "y"]);
    assert.equal(page.count("li"), 6);
    assert.equal(page.text(), "a x y b x y");
}

// --- derived lists and derived text ---------------------------------------------------

// buri-lang/buri#50, in the document. A `Scope` is an `Allocator`, so the list
// `each` walks may be a filtered view of a signal and the text a leaf shows may
// be formatted from one. Both are the shapes an app hits on its first screen.

fn isEven(value: Int): Bool {
    value % 2 == 0
}

/// A row of the derived list. The item's own text is formatted inside the leaf,
/// which is the second half of the issue: a number reaches a `ui.text` only if
/// the closure rendering it can allocate.
fn numberRow<C>(ctx: C, item: Int, index: Int): Node<C> {
    ui.region(.ListItem, [], [ui.text(.Computed(fn(s) => str.format(s, "${item}")))])
}

/// The issue's program, word for word: a filtered `Prop<[Int]>` handed to
/// `each`, from a function with no context of its own.
fn evens<C>(xs: Signal<[Int]>): Node<C> {
    ui.each(.Computed(fn(s) => xs.get(s).filter(s, isEven)), fn(x) => "${x}", numberRow)
}

test "a derived list re-filters and re-renders when its signal is written" {
    let ctx = context {
        Ui: headless(),
    };
    let xs = signal(ctx, [1, 2, 3, 4]);
    let page = render(ctx, ui.region(.List, [], [evens(xs)]));
    assert.equal(page.markup(), "<ul><li>2</li><li>4</li></ul>");

    let _ = xs.set(ctx, [1, 2, 3, 4, 5, 6]);
    assert.equal(page.markup(), "<ul><li>2</li><li>4</li><li>6</li></ul>");

    // Keyed, so the rows that survived the re-filter were moved rather than
    // rebuilt — the derivation is fine-grained, not a repaint.
    let two = page.identity("li", 0);
    let _ = xs.set(ctx, [2, 6]);
    assert.equal(page.markup(), "<ul><li>2</li><li>6</li></ul>");
    assert.equal(page.identity("li", 0), two);
}

test "formatted text follows the signal it was formatted from" {
    let ctx = context {
        Ui: headless(),
    };
    let n = signal(ctx, 1);
    let page = render(
        ctx,
        ui.text(.Computed(fn(s) => str.format(s, "${n.get(s)} items"))),
    );
    assert.equal(page.text(), "1 items");
    let _ = n.set(ctx, 12);
    assert.equal(page.text(), "12 items");
}

// --- batching ------------------------------------------------------------------------

test "one press is one update, however many signals it writes" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let first = signal(ctx, 0);
    let second = signal(ctx, 0);
    let _ = watch(ctx, fn(s) => ignore(log.note(first.get(s) + second.get(s))));
    assert.equal(log.noted(), [0]);

    let page = render(
        ctx,
        ui.button(.Const("both"), [], fn(c, e) => writeBoth(c, first, second)),
    );
    let _ = page.press("both");

    // Two writes, one pass over the watchers: the handler ran inside one
    // transaction. Two passes would have noted 1 and then 3.
    assert.equal(log.noted(), [0, 3]);
}

fn writeBoth<C: Ui>(ctx: C, first: Signal<Int>, second: Signal<Int>): () {
    let _ = first.set(ctx, 1);
    let _ = second.set(ctx, 2);
}

// --- the design's example ------------------------------------------------------------

// design/ui-reactivity.md, "Example", as written there: a pure component that
// cannot tell whether either of its props varies, an effectful one that owns
// the signal, and a handler that captures the signal and takes its context as a
// parameter. The badge's style is written out rather than reaching for a design
// token, because a token is resolved against a theme and `ui/theme` has no way
// to build one yet.

let badgeStyle: Style = .Group([
    .PaddingX(.Rem(0.5)),
    .Radius(.Px(6)),
    .Background(.Rgb(240, 240, 245)),
]);

fn badge<C>(title: Prop<Str>, count: Prop<Int>): Node<C> {
    ui.row([badgeStyle], [
        ui.text(title),
        ui.text(.Computed(fn(c) => "${count.read(c)}")),
    ])
}

fn counter<C: Ui>(ctx: C, label: Str): Node<C> {
    let count = signal(ctx, 0);

    ui.column([], [
        ui.button(.Const(label), [], fn(c, e) => count.update(c, fn(n) => n + 1)),
        badge(.Const(label), .Cell(count)),
        badge(.Const("doubled"), .Computed(fn(c) => count.get(c) * 2)),
    ])
}

test "the counter counts, and both badges follow" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, counter(ctx, "clicks"));
    assert.equal(page.text(), "clicks clicks 0 doubled 0");
    let _ = page.press("clicks");
    assert.equal(page.text(), "clicks clicks 1 doubled 2");
    let _ = page.press("clicks");
    let _ = page.press("clicks");
    assert.equal(page.text(), "clicks clicks 3 doubled 6");
}

test "the counter mounts" {
    let ctx = context {
        Ui: headless(),
    };
    // Nothing can build a `Theme` yet, so the empty list is the only list there
    // is — which is what an app with no design tokens passes in any case.
    let themes: [Theme] = [];
    assert.equal(ui.mount(ctx, counter(ctx, "clicks"), themes), .Ok(()));
}
