// design/ui-reactivity.md, "The tree". What `ui/node` builds and what the
// runtime makes of it, asserted against a rendered document rather than
// against a picture of one:
//
//   - meaning is the role, and every role lowers to the element that carries
//     it, with `role=` where HTML has none;
//   - arrangement is the style, and a style is applied to the element it
//     belongs to;
//   - an accessibility-critical parameter is a parameter: a button has its
//     label, an image its alt, a field and a toggle their label;
//   - a handler receives its context as a parameter and never captures one;
//   - the three reactive constructors each re-run the smallest thing they
//     can — `choose` and `computed` rebuild one subtree, `each` moves the rows
//     that are still there and builds only the ones that are not;
//   - and a reactive leaf allocates, so `each` walks a filtered view of a
//     signal and a leaf shows text formatted from one.
//
// `ui/testing`'s renderer is the one `mount` uses, against a document the
// runtime supplies. What it cannot cover is what only a browser does — layout,
// painting, focus order, and the browser's own dispatch of a press — and that
// needs a browser rather than a substitute for one.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/str" import * as str;
from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { FieldKind, Node };
from "ui/prop" import { Prop };
from "ui/signal" import { Signal, signal, watch };
from "ui/style" import * as style;
from "ui/style" import { Color, Shadow, Style };
from "ui/testing" import { headless, observer, recorder, render, stylesheet, Recorder };

// --- helpers -------------------------------------------------------------------------

/// A reactive closure answers a value, and a `fn(Scope) => ()` has nowhere to
/// put it.
fn ignore(value: Int): () {
    let _ = value;
}

/// A row of a keyed list: the item is the key and the text, so that what the
/// document shows says which row it is.
fn labelRow<C>(ctx: C, item: Str, index: Int): Node<C> {
    ui.stack({
        styles: [],
        children: [ui.text({ content: .Const(item) })],
        role: .Some(.ListItem),
    })
}

/// The key of a row is the item itself. Two rows with one key is a mistake the
/// runtime refuses, and this is the shape that never makes it.
fn itself(item: Str): Str {
    item
}

/// One field of a kind, with the same hint on every one of them.
fn hinted<C>(ctx: C, kind: FieldKind, value: Signal<Str>): Node<C> {
    ui.field({
        label: .Const("what"),
        kind: kind,
        value: value,
        styles: [],
        hint: .Some(.Const("hint")),
    })
}

/// A heading whose text does not depend on `value`, so that what changes when
/// `value` changes is only whether the subtree was built again.
fn headingFor<C>(value: Int): Node<C> {
    ui.text({ content: .Const("head"), headingLevel: .Some(1) })
}

/// Binds a freshly built node to the context it will be rendered with, so a
/// config literal saved in a `let` has its context settled the way passing it
/// straight to `render`/`describe` would. A pure passthrough — it returns the
/// node unchanged and adds nothing to the scene.
fn rooted<C>(ctx: C, node: Node<C>): Node<C> {
    node
}

// --- structure -----------------------------------------------------------------------

test "a stack is arrangement with no meaning, and text is a bare run" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({ styles: [], children: [ui.text({ content: .Const("hello") })] }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 \nt 1 hello");
}

test "nothing renders nothing at all" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.empty(), ui.text({ content: .Const("only") }), ui.empty()],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 \nt 1 only");
}

test "a row runs along the axis and a column runs down the page" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Layout(.Row), .Group([])], children: [] }),
        ).markup(),
        "e 0 class:lay-row",
    );
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Layout(.Column), .Group([])], children: [] }),
        ).markup(),
        "e 0 class:lay-col",
    );
}

test "a caller's own layout wins over the sugar's" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({ styles: [.Layout(.Row), .Group([.Layout(.Column)])], children: [] }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:lay-col");
}

test "a spacer takes what is left over" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, ui.spacer({ size: .None })).markup(), "e 0 class:grow-1");
}

test "every role lowers to the element that carries it" {
    let ctx = context {
        Ui: headless(),
    };
    let landmarks = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [], children: [], role: .Some(.Navigation) }),
                ui.stack({ styles: [], children: [], role: .Some(.Main) }),
                ui.stack({ styles: [], children: [], role: .Some(.Banner) }),
                ui.stack({ styles: [], children: [], role: .Some(.ContentInfo) }),
                ui.stack({ styles: [], children: [], role: .Some(.Complementary) }),
                ui.stack({ styles: [], children: [], role: .Some(.Article) }),
                ui.stack({ styles: [], children: [], role: .Some(.Search) }),
            ],
        }),
    );
    assert.equal(
        render(ctx, landmarks).markup(),
        "e 0 \ne 1 \ne 1 \ne 1 \ne 1 \ne 1 \ne 1 \ne 1 ",
    );

    let structure = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [],
                    children: [
                        ui.stack({ styles: [], children: [], role: .Some(.ListItem) }),
                    ],
                    role: .Some(.List),
                }),
                ui.stack({ styles: [], children: [], role: .Some(.Group) }),
                ui.stack({ styles: [], children: [], role: .Some(.Separator) }),
            ],
        }),
    );
    assert.equal(render(ctx, structure).markup(), "e 0 \ne 1 \ne 2 \ne 1 \ne 1 ");

    let live = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [], children: [], role: .Some(.Status) }),
                ui.stack({ styles: [], children: [], role: .Some(.Alert) }),
            ],
        }),
    );
    assert.equal(render(ctx, live).markup(), "e 0 \ne 1 \ne 1 ");
}

test "a data table is roles, and its headers say which way they head" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [],
                    children: [
                        ui.stack({
                            styles: [],
                            children: [ui.text({ content: .Const("name") })],
                            role: .Some(.ColumnHeader),
                        }),
                        ui.stack({
                            styles: [],
                            children: [ui.text({ content: .Const("owed") })],
                            role: .Some(.ColumnHeader),
                        }),
                    ],
                    role: .Some(.TableRow),
                }),
                ui.stack({
                    styles: [],
                    children: [
                        ui.stack({
                            styles: [],
                            children: [ui.text({ content: .Const("ada") })],
                            role: .Some(.RowHeader),
                        }),
                        ui.stack({
                            styles: [],
                            children: [ui.text({ content: .Const("3") })],
                            role: .Some(.Cell),
                        }),
                    ],
                    role: .Some(.TableRow),
                }),
            ],
            role: .Some(.Table),
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 display:grid;grid-template-columns:1fr 1fr\ne 2 class:fw-bold ta-center\nt 3 name\ne 2 class:fw-bold ta-center\nt 3 owed\ne 1 display:grid;grid-template-columns:1fr 1fr\ne 2 class:fw-bold ta-center\nt 3 ada\ne 2 \nt 3 3",
    );
}

test "a heading is an outline level, and there is no seventh" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.text({ content: .Const("top"), headingLevel: .Some(1) }),
                ui.text({ content: .Const("inner"), headingLevel: .Some(3) }),
                ui.text({ content: .Const("clamped"), headingLevel: .Some(9) }),
                ui.text({ content: .Const("also clamped"), headingLevel: .Some(0) }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 \nt 2 top\ne 1 \nt 2 inner\ne 1 \nt 2 clamped\ne 1 \nt 2 also clamped",
    );
}

test "a heading paints what the program asked for and nothing else" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // The size the stack asks for is the size the heading is: nothing in the
    // sheet sets one on the element, so it inherits like any other run of text.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.FontSize(.Px(13))],
            children: [
                ui.text({ content: .Const("not found"), headingLevel: .Some(2) }),
            ],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:fs-13\ne 1 \nt 2 not found");
    // The headless painter reads this, and a browser reads the markup above.
    // They agree only while the heading's line carries what the sheet does.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:fs-13\ne 1 \nt 2 not found",
    );
}

test "a heading takes styles of its own, and they land on the heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.text({
            content: .Const("Prices"),
            headingLevel: .Some(2),
            styles: .Some([.FontSize(.Px(28)), .FontWeight(.Bold)]),
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:fs-28 fw-bold\nt 1 Prices");
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:fs-28 fw-bold\nt 1 Prices",
    );
}

// --- styling -------------------------------------------------------------------------
//
// design/ui-reactivity.md, "Styling". Two tiers: everything except `Computed`
// is extracted at compile time into one atomic class per distinct property
// value, deduped across the whole build, and `Computed` is applied inline and
// is deliberately absent from the stylesheet. So a styling assertion has two
// halves — which classes an element carries, and what those classes mean —
// and `stylesheet()` is the second half.

/// A component with styles of its own that a caller may override.
///
/// The merge happens in the runtime, and it is a scan over `(slot, class)`
/// pairs the compiler assigned: it can only ever choose between classes that
/// are already in the sheet.
fn boxed<C>(extra: [Style], label: Str): Node<C> {
    ui.stack({
        styles: [.Group([.Padding(.Px(8)), .Background(.Rgb(0, 0, 0))]), .Group(extra)],
        children: [ui.text({ content: .Const(label) })],
    })
}

/// The three shadows a design system ships: a tight one under a resting card,
/// the wide half of an elevation, and the ring a focus style is.
///
/// Module-level, because a style is extracted where it is written and a local
/// is a value only the run time has.
let tight: Shadow = Shadow {
    x: .Px(0),
    y: .Px(1),
    blur: .Px(2),
    spread: .Px(0),
    color: .Rgba(0, 0, 0, 0.05),
};

let lift: Shadow = Shadow {
    x: .Px(0),
    y: .Px(2),
    blur: .Px(4),
    spread: .Px(0),
    color: .Rgba(0, 0, 0, 0.2),
};

let ring: Shadow = Shadow {
    x: .Px(0),
    y: .Px(0),
    blur: .Px(0),
    spread: .Px(3),
    color: .Rgba(59, 130, 246, 0.5),
};

/// A component with a shadow of its own that a caller may replace.
///
/// `Shadow` and `Shadows` are one conflict slot, so a caller's two-layer
/// elevation replaces this one rather than landing beside it.
fn shadowed<C>(extra: [Style], label: Str): Node<C> {
    ui.stack({
        styles: [.Shadow(tight), .Group(extra)],
        children: [ui.text({ content: .Const(label) })],
    })
}

/// A component whose shadow and whose background are whatever its caller asks
/// for. Both styles are built out of a parameter, so the compiler cannot
/// evaluate either and both degrade to the inline tier — which is where the
/// other half of each lowering is.
fn cast<C>(layers: [Shadow]): Node<C> {
    ui.stack({ styles: [.Shadows(layers)], children: [] })
}

fn painted<C>(paint: Color): Node<C> {
    ui.stack({ styles: [.Background(paint)], children: [] })
}

test "every property lowers to the one declaration it names" {
    let ctx = context {
        Ui: headless(),
    };
    let everything: [Style] = [
        .Group([.Layout(.Row), .Gap(.Px(8))]),
        .Padding(.Rem(1.5)),
        .PaddingX(.Percent(10.0)),
        .PaddingY(.Auto),
        .Width(.Full),
        .Height(.Px(40)),
        .AlignMain(.SpaceBetween),
        .AlignCross(.Center),
        .Grow(2),
        .Background(.Rgb(1, 2, 3)),
        .Foreground(.Rgba(4, 5, 6, 0.5)),
        .BorderWidth(.Px(1)),
        .BorderColor(.Transparent),
        .Radius(.Px(6)),
        .FontSize(.Rem(0.875)),
        .FontWeight(.Semibold),
        .Cursor(.Pointer),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: everything, children: [] })).markup(),
        "e 0 class:lay-row gap-8 p-r1_5 px-pc10 py-auto w-full h-40 am-between ac-center grow-2 bg-010203 fg-040506a0_5 bw-1 bc-none r-6 fs-r0_875 fw-semibold cur-pointer",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".gap-8{gap:8px}"));
    assert.isTrue(sheet.contains(".px-pc10{padding-inline:10%}"));
    assert.isTrue(sheet.contains(".fg-040506a0_5{color:rgba(4,5,6,0.5)}"));
    assert.isTrue(sheet.contains(".bw-1{border-style:solid;border-width:1px}"));
    assert.isTrue(sheet.contains(".fs-r0_875{font-size:0.875rem}"));
}

test "the rest of the vocabulary lowers to the declarations it names" {
    let ctx = context {
        Ui: headless(),
    };
    let rest: [Style] = [
        .AlignSelf(.End),
        .Wrap(true),
        .Scroll(.Y),
        .Shrink(0),
        .Span(2),
        .Pin(.Top, .Px(0)),
        .Position(.Sticky),
        .GapX(.Px(4)),
        .GapY(.Px(6)),
        .PaddingEdge(.Start, .Rem(1.0)),
        .MinWidth(.Px(100)),
        .MaxWidth(.Rem(40.0)),
        .MinHeight(.Px(20)),
        .MaxHeight(.Percent(50.0)),
        .AspectRatio(1.5),
        .BorderStyle(.Dashed),
        .Opacity(0.5),
        .Italic(true),
        .LineHeight(1.5),
        .LetterSpacing(.Px(1)),
        .TextAlign(.Center),
        .TextCase(.Upper),
        .TextLine(.Underline),
        .TextWrap(.Balance),
        .Truncate(2),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: rest, children: [] })).markup(),
        "e 0 class:as-end wrap-wrap scroll-y shrink-0 span-2 pin-out pin-top-0 pos-sticky gapx-4 gapy-6 pe-start-r1 minw-100 maxw-r40 minh-20 maxh-pc50 ar-1_5 bs-dashed op-0_5 it-italic lh-1_5 ls-1 ta-center tc-upper tl-underline tw-balance trunc-2",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pin-top-0{inset-block-start:0px}"));
    assert.isTrue(sheet.contains(".pe-start-r1{padding-inline-start:1rem}"));
    assert.isTrue(sheet.contains(".ar-1_5{aspect-ratio:1.5}"));
    assert.isTrue(
        sheet.contains(
            ".trunc-2{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}",
        ),
    );
}

test "a caret colour paints the caret even where the text is transparent" {
    let ctx = context {
        Ui: headless(),
    };
    // The syntax-highlight-mirror technique: an `<input>` whose own text is
    // transparent, painted over by a copy drawn run by run. On its own the
    // caret is whatever `Foreground` is — transparent — so the reader types
    // into a box with no caret in it. Naming the caret keeps it visible while
    // the text stays transparent, which is what makes the mirror shippable.
    let styles: [Style] = [.Foreground(.Transparent), .CaretColor(.Rgb(20, 20, 20))];
    assert.equal(
        render(ctx, ui.stack({ styles: styles, children: [] })).markup(),
        "e 0 class:fg-none caret-141414",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".caret-141414{caret-color:rgb(20,20,20)}"));
}

test "pins naming different edges compose, and `Position` owns `position`" {
    let ctx = context {
        Ui: headless(),
    };
    // The overlay written the obvious way: fixed to the viewport, held to all
    // four of its edges.
    let overlay: [Style] = [
        .Position(.PinViewport),
        .Pin(.Top, .Px(0)),
        .Pin(.Bottom, .Px(0)),
        .Pin(.Start, .Px(0)),
        .Pin(.End, .Px(0)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: overlay, children: [] })).markup(),
        "e 0 class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pin-top-0{inset-block-start:0px}"));
    assert.isTrue(sheet.contains(".pin-bottom-0{inset-block-end:0px}"));
    assert.isTrue(sheet.contains(".pin-start-0{inset-inline-start:0px}"));
    assert.isTrue(sheet.contains(".pin-end-0{inset-inline-end:0px}"));
    // Out of the flow is one fact about the element rather than one per edge,
    // and the `Position` beside it wins because the sheet writes it later.
    let pinned = sheet.indexOf(".pin-out{position:absolute}").withDefault(-1);
    let viewport = sheet.indexOf(".pos-viewport{position:fixed}").withDefault(-1);
    assert.isTrue(pinned >= 0);
    assert.isTrue(pinned < viewport);
}

test "padding named edge by edge composes too" {
    let ctx = context {
        Ui: headless(),
    };
    let edges: [Style] = [
        .PaddingEdge(.Top, .Px(1)),
        .PaddingEdge(.Bottom, .Px(2)),
        .PaddingEdge(.Start, .Px(3)),
        .PaddingEdge(.End, .Px(4)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: edges, children: [] })).markup(),
        "e 0 class:pe-top-1 pe-bottom-2 pe-start-3 pe-end-4",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pe-top-1{padding-block-start:1px}"));
    assert.isTrue(sheet.contains(".pe-end-4{padding-inline-end:4px}"));
}

test "a border named edge by edge composes, and the colour stays whole-box" {
    let ctx = context {
        Ui: headless(),
    };
    // The divider under a table row, the guide line down a submenu: one edge
    // of a box rather than a box of its own.
    let edges: [Style] = [
        .BorderEdge(.Top, .Px(1)),
        .BorderEdge(.Bottom, .Px(2)),
        .BorderEdge(.Start, .Px(3)),
        .BorderEdge(.End, .Rem(0.5)),
        .BorderColor(.Rgb(200, 200, 210)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: edges, children: [] })).markup(),
        "e 0 class:be-top-1 be-bottom-2 be-start-3 be-end-r0_5 bc-c8c8d2",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ".be-top-1{border-block-start-style:solid;border-block-start-width:1px}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ".be-end-r0_5{border-inline-end-style:solid;border-inline-end-width:0.5rem}",
        ),
    );
    assert.isTrue(sheet.contains(".bc-c8c8d2{border-color:rgb(200,200,210)}"));
}

test "a border edge sits after the width it narrows and before the style" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .BorderWidth(.Px(1)),
                .BorderEdge(.Bottom, .Px(4)),
                .BorderStyle(.Dashed),
            ],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:bw-1 be-bottom-4 bs-dashed");
    // Position in the sheet is what decides between two properties that touch
    // one declaration: the edge overrides the whole box, and `BorderStyle`
    // overrides the solid both of them implied.
    let sheet = stylesheet();
    let whole = sheet
        .indexOf(".bw-1{border-style:solid;border-width:1px}")
        .withDefault(-1);
    let edge = sheet
        .indexOf(
            ".be-bottom-4{border-block-end-style:solid;border-block-end-width:4px}",
        )
        .withDefault(-1);
    let dashed = sheet.indexOf(".bs-dashed{border-style:dashed}").withDefault(-1);
    assert.isTrue(whole >= 0);
    assert.isTrue(whole < edge);
    assert.isTrue(edge < dashed);
}

test "the same border edge twice is last-wins, and a state is its own slot" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .BorderEdge(.Bottom, .Px(1)),
                .BorderEdge(.Bottom, .Px(3)),
                .On(.Hover, [.BorderEdge(.Bottom, .Px(1))]),
            ],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:be-bottom-3 hover_be-bottom-1");
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ".hover_be-bottom-1:hover{border-block-end-style:solid;border-block-end-width:1px}",
        ),
    );
}

test "radius named corner by corner composes, and a joined group is spellable" {
    let ctx = context {
        Ui: headless(),
    };
    let corners: [Style] = [
        .RadiusCorner(.TopStart, .Px(1)),
        .RadiusCorner(.TopEnd, .Px(2)),
        .RadiusCorner(.BottomStart, .Px(3)),
        .RadiusCorner(.BottomEnd, .Px(4)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: corners, children: [] })).markup(),
        "e 0 class:rc-topstart-1 rc-topend-2 rc-bottomstart-3 rc-bottomend-4",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".rc-topstart-1{border-start-start-radius:1px}"));
    assert.isTrue(sheet.contains(".rc-topend-2{border-start-end-radius:2px}"));
    assert.isTrue(sheet.contains(".rc-bottomstart-3{border-end-start-radius:3px}"));
    assert.isTrue(sheet.contains(".rc-bottomend-4{border-end-end-radius:4px}"));
}

test "a full radius is a pill on every box, where a percentage is an ellipse" {
    let ctx = context {
        Ui: headless(),
    };
    // buri#144: `Radius(.Full)` lowers to `9999px`, the way Tailwind's
    // `rounded-full` does — a pill on any box, where `border-radius:100%`
    // resolves per axis to an ellipse on anything that is not square. A corner
    // takes the same pill, and `Percent` keeps the ellipse a caller asks for by
    // writing one.
    let pill = rooted(
        ctx,
        ui.stack({
            styles: [.Radius(.Full), .RadiusCorner(.TopEnd, .Full)],
            children: [],
        }),
    );
    assert.equal(render(ctx, pill).markup(), "e 0 class:r-full rc-topend-full");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".r-full{border-radius:9999px}"));
    assert.isTrue(sheet.contains(".rc-topend-full{border-start-end-radius:9999px}"));
    // A percentage radius is left alone: `Percent(50)` is the ellipse.
    let ellipse = rooted(
        ctx,
        ui.stack({ styles: [.Radius(.Percent(50.0))], children: [] }),
    );
    assert.equal(render(ctx, ellipse).markup(), "e 0 class:r-pc50");
    assert.isTrue(stylesheet().contains(".r-pc50{border-radius:50%}"));
}

test "a full radius and a square corner compose, whole radius first" {
    let ctx = context {
        Ui: headless(),
    };
    // A pill welded onto its neighbour: rounded but for the one corner squared
    // where it meets the box beside it. The whole radius is written before the
    // corner that overrides it, exactly as a numeric radius is.
    let welded: [Style] = [.Radius(.Full), .RadiusCorner(.TopStart, .Px(0))];
    assert.equal(
        render(ctx, ui.stack({ styles: welded, children: [] })).markup(),
        "e 0 class:r-full rc-topstart-0",
    );
    let sheet = stylesheet();
    let whole = sheet.indexOf(".r-full{border-radius:9999px}").withDefault(-1);
    let corner = sheet
        .indexOf(".rc-topstart-0{border-start-start-radius:0px}")
        .withDefault(-1);
    assert.isTrue(whole >= 0);
    assert.isTrue(whole < corner);
}

test "a corner squares the side that meets its neighbour, and the shorthand loses" {
    let ctx = context {
        Ui: headless(),
    };
    // The middle child of a joined button group: rounded ends, square where it
    // welds onto the button beside it, and one shared hairline.
    let middle: [Style] = [
        .Radius(.Px(6)),
        .RadiusCorner(.TopStart, .Px(0)),
        .RadiusCorner(.BottomStart, .Px(0)),
        .BorderWidth(.Px(1)),
        .BorderEdge(.Start, .Px(0)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: middle, children: [] })).markup(),
        "e 0 class:r-6 rc-topstart-0 rc-bottomstart-0 bw-1 be-start-0",
    );
    let sheet = stylesheet();
    let whole = sheet.indexOf(".r-6{border-radius:6px}").withDefault(-1);
    let corner = sheet
        .indexOf(".rc-topstart-0{border-start-start-radius:0px}")
        .withDefault(-1);
    assert.isTrue(whole >= 0);
    assert.isTrue(whole < corner);
    assert.isTrue(
        sheet.contains(
            ".be-start-0{border-inline-start-style:solid;border-inline-start-width:0px}",
        ),
    );
}

test "an edge and a corner reach the scene document the way the sheet does" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .BorderEdge(.Bottom, .Px(1)),
                .BorderColor(.Rgb(0, 0, 0)),
                .RadiusCorner(.TopEnd, .Px(4)),
            ],
            children: [],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:be-bottom-1 bc-000000 rc-topend-4",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:be-bottom-1 bc-000000 rc-topend-4",
    );
}

test "an edge and a corner the compiler cannot evaluate become inline styles" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so the folder stops and both degrade to the tier
    // `Computed` lives in — the same declarations, written out.
    let thickness = signal(ctx, 2);
    let rounding = signal(ctx, 5);
    assert.equal(
        render(
            ctx,
            ui.stack({
                styles: [.BorderEdge(.Bottom, .Px(thickness.get(ctx)))],
                children: [],
            }),
        ).markup(),
        "e 0 border-block-end-style:solid;border-block-end-width:2px",
    );
    assert.equal(
        render(
            ctx,
            ui.stack({
                styles: [.RadiusCorner(.BottomEnd, .Px(rounding.get(ctx)))],
                children: [],
            }),
        ).markup(),
        "e 0 border-end-end-radius:5px",
    );
}

test "a bleed takes a child out past the padding its parent put it inside" {
    let ctx = context {
        Ui: headless(),
    };
    // The menu separator: the menu is padded by four, and the rule runs from
    // one edge of it to the other.
    let separator: [Style] = [
        .Height(.Px(1)),
        .Bleed(.Start, .Px(4)),
        .Bleed(.End, .Px(4)),
    ];
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: separator, children: [], role: .Some(.Separator) }),
        ).markup(),
        "e 0 class:h-1 bleed-start-4 bleed-end-4",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-start-4{margin-inline-start:-4px}"));
    assert.isTrue(sheet.contains(".bleed-end-4{margin-inline-end:-4px}"));
}

test "bleeds naming different edges compose, and the same edge is last-wins" {
    let ctx = context {
        Ui: headless(),
    };
    let edges: [Style] = [
        .Bleed(.Top, .Px(1)),
        .Bleed(.Bottom, .Px(2)),
        .Bleed(.Start, .Px(3)),
        .Bleed(.End, .Px(4)),
        .Bleed(.Start, .Px(8)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: edges, children: [] })).markup(),
        "e 0 class:bleed-top-1 bleed-bottom-2 bleed-start-8 bleed-end-4",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-top-1{margin-block-start:-1px}"));
    assert.isTrue(sheet.contains(".bleed-bottom-2{margin-block-end:-2px}"));
    assert.isTrue(sheet.contains(".bleed-start-8{margin-inline-start:-8px}"));
    assert.isTrue(sheet.contains(".bleed-end-4{margin-inline-end:-4px}"));
    // The one that lost is not in the sheet either: a class nobody reaches is
    // not shipped.
    assert.isFalse(sheet.contains(".bleed-start-3"));
}

test "a bleed is a distance outwards, so nothing inward and nothing automatic" {
    let ctx = context {
        Ui: headless(),
    };
    let lengths: [Style] = [
        .Bleed(.Top, .Rem(0.5)),
        .Bleed(.Bottom, .Percent(10.0)),
        .Bleed(.Start, .Full),
        .Bleed(.End, .Px(-8)),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: lengths, children: [] })).markup(),
        "e 0 class:bleed-top-r0_5 bleed-bottom-pc10 bleed-start-full bleed-end-n8",
    );
    assert.equal(
        render(ctx, ui.stack({ styles: [.Bleed(.Top, .Auto)], children: [] })).markup(),
        "e 0 class:bleed-top-auto",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-top-r0_5{margin-block-start:-0.5rem}"));
    assert.isTrue(sheet.contains(".bleed-bottom-pc10{margin-block-end:-10%}"));
    assert.isTrue(sheet.contains(".bleed-start-full{margin-inline-start:-100%}"));
    // Inward is the margin this vocabulary does not have, and `.Auto` is not a
    // distance at all. Both bleed nothing.
    assert.isTrue(sheet.contains(".bleed-end-n8{margin-inline-end:0px}"));
    assert.isTrue(sheet.contains(".bleed-top-auto{margin-block-start:0px}"));
}

test "a bleed shares an edge with a pin and a padding and fights neither" {
    let ctx = context {
        Ui: headless(),
    };
    let stated: [Style] = [
        .Bleed(.Start, .Px(8)),
        .PaddingEdge(.Start, .Px(2)),
        .Pin(.Start, .Px(4)),
        .Position(.Flow),
        .On(.Hover, [.Bleed(.Start, .Px(16))]),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: stated, children: [] })).markup(),
        "e 0 class:bleed-start-8 pe-start-2 pin-out pin-start-4 pos-flow hover_bleed-start-16",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bleed-start-8{margin-inline-start:-8px}"));
    assert.isTrue(sheet.contains(".pe-start-2{padding-inline-start:2px}"));
    assert.isTrue(sheet.contains(".pin-start-4{inset-inline-start:4px}"));
    // A state is a slot of its own, so the hover rule does not replace the
    // resting one — it applies over it.
    assert.isTrue(
        sheet.contains(".hover_bleed-start-16:hover{margin-inline-start:-16px}"),
    );
}

test "a bleed the compiler cannot evaluate is written out inline" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so the folder stops here and the style degrades to
    // the tier `Computed` lives in.
    let out = signal(ctx, 23);
    let tree = rooted(
        ctx,
        ui.stack({ styles: [.Bleed(.Start, .Px(out.get(ctx)))], children: [] }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 margin-inline-start:-23px");
    assert.isFalse(stylesheet().contains("bleed-start-23"));
}

test "the scene document writes the bleed the browser was given" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    // The inline tier on both sides: the painter reads the scene, a browser
    // reads the style attribute, and the two say the same thing.
    let out = signal(ctx, 8);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Bleed(.Start, .Px(out.get(ctx))),
                .Bleed(.Top, .Px(0 - out.get(ctx))),
            ],
            children: [],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 margin-inline-start:-8px;margin-block-start:0px",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 margin-inline-start:-8px;margin-block-start:0px",
    );
}

test "a clip cuts a child to its parent's box, and asks for no scrollbar" {
    let ctx = context {
        Ui: headless(),
    };
    // The card with a full-bleed banner: the radius rounds the card, and the
    // clip is what stops the picture squaring the corner off again.
    let card: [Style] = [.Radius(.Px(12)), .Clip(true)];
    assert.equal(
        render(ctx, ui.stack({ styles: card, children: [] })).markup(),
        "e 0 class:r-12 clip-clip",
    );
    assert.equal(
        render(ctx, ui.stack({ styles: [.Clip(false)], children: [] })).markup(),
        "e 0 class:clip-visible",
    );
    let sheet = stylesheet();
    // `clip` rather than `hidden`: content outside the box is not painted, and
    // nothing here becomes a scroll container a keyboard can land in.
    assert.isTrue(sheet.contains(".clip-clip{overflow:clip}"));
    assert.isTrue(sheet.contains(".clip-visible{overflow:visible}"));
}

test "a clip and a scroll are two slots, and the clip is the later rule" {
    let ctx = context {
        Ui: headless(),
    };
    // Same property, last wins.
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Clip(false), .Clip(true)], children: [] }),
        ).markup(),
        "e 0 class:clip-clip",
    );
    // Different properties over one declaration, so both classes land and the
    // sheet decides. `Clip` is declared after `Scroll`, so an element that asks
    // for both is clipped.
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Clip(true), .Scroll(.Y)], children: [] }),
        ).markup(),
        "e 0 class:clip-clip scroll-y",
    );
    let sheet = stylesheet();
    let scroll = assert.some(sheet.indexOf(".scroll-y{overflow-y:auto}"));
    let clip = assert.some(sheet.indexOf(".clip-clip{overflow:clip}"));
    assert.isTrue(scroll < clip);
}

test "a clip takes a state and a breakpoint, and degrades to an inline style" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let stated: [Style] = [
        .Clip(true),
        .Position(.Flow),
        .On(.Hover, [.Clip(false)]),
        .At(.Medium, [.Clip(false)]),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: stated, children: [] })).markup(),
        "e 0 class:clip-clip pos-flow hover_clip-visible md_clip-visible",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".hover_clip-visible:hover{overflow:visible}"));
    assert.isTrue(sheet.contains(".md_clip-visible{overflow:visible}"));
    // `get` takes a context, so the folder stops there and the style lands in
    // the tier `Computed` lives in.
    let cut = signal(ctx, 1);
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Clip(cut.get(ctx) > 0)], children: [] }),
        ).markup(),
        "e 0 overflow:clip",
    );
}

test "the scene document writes the clip the browser was given" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    let cut = signal(ctx, 0);
    let tree = rooted(
        ctx,
        ui.stack({ styles: [.Radius(.Px(4)), .Clip(cut.get(ctx) == 0)], children: [] }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:r-4;overflow:clip");
    // The radius folded and the clip did not, so the element carries one of
    // each tier — and the scene says both, in the order the browser was given
    // them.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:r-4;overflow:clip",
    );
}

test "a dock passes the pointer through, and each toast in it takes it back" {
    let ctx = context {
        Ui: headless(),
    };
    // The toaster dock: a full-width band pinned across the viewport that must
    // not intercept the page under it, and a toast in it that must.
    let dock: [Style] = [.Position(.PinViewport), .Width(.Full), .Passthrough(true)];
    let tree = rooted(
        ctx,
        ui.stack({
            styles: dock,
            children: [ui.stack({ styles: [.Passthrough(false)], children: [] })],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:pos-viewport w-full pass-none\ne 1 class:pass-auto",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pass-none{pointer-events:none}"));
    assert.isTrue(sheet.contains(".pass-auto{pointer-events:auto}"));
}

test "a press does not reach an element the pointer passes through" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let presses = signal(ctx, 0);
    // The switch thumb, drawn over the control: the mark passes the pointer
    // through, so the press still lands on the control under it.
    let page = render(
        ctx,
        ui.stack({
            styles: [.Layout(.Layers)],
            children: [
                ui.button({
                    label: .Const("flip"),
                    styles: [],
                    onPress: .Some(fn(c) => { presses.set(c, presses.get(c) + 1) }),
                }),
                ui.stack({ styles: [.Passthrough(true)], children: [] }),
            ],
        }),
    );
    let _ = page.press("flip");
    assert.equal(presses.get(ctx), 1);

    // And the other way round: a button under a subtree that passes the
    // pointer through never receives one, which is what a browser does.
    let ignored = signal(ctx, 0);
    let dock = render(
        ctx,
        ui.stack({
            styles: [.Passthrough(true)],
            children: [
                ui.button({
                    label: .Const("dead"),
                    styles: [],
                    onPress: .Some(fn(c) => { ignored.set(c, ignored.get(c) + 1) }),
                }),
                ui.stack({
                    styles: [.Passthrough(false)],
                    children: [
                        ui.button({
                            label: .Const("live"),
                            styles: [],
                            onPress: .Some(fn(c) => {
                                ignored.set(c, ignored.get(c) + 10)
                            }),
                        }),
                    ],
                }),
            ],
        }),
    );
    let _ = dock.press("dead");
    assert.equal(ignored.get(ctx), 0);
    // A child that opts back in is pressed, the way a toast inside a
    // pass-through dock is.
    let _ = dock.press("live");
    assert.equal(ignored.get(ctx), 10);
}

test "a pass-through takes a state and degrades to an inline style" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let stated: [Style] = [
        .Passthrough(true),
        .Cursor(.NotAllowed),
        .On(.Disabled, [.Passthrough(true)]),
        .At(.Large, [.Passthrough(false)]),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: stated, children: [] })).markup(),
        "e 0 class:pass-none cur-notallowed lg_pass-auto",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".disabled_pass-none:disabled{pointer-events:none}"));
    assert.isTrue(sheet.contains(".lg_pass-auto{pointer-events:auto}"));
    let through = signal(ctx, 1);
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Passthrough(through.get(ctx) > 0)], children: [] }),
        ).markup(),
        "e 0 pointer-events:none",
    );
}

test "a scrim blurs the page behind it, at a pixel radius and a rem one" {
    let ctx = context {
        Ui: headless(),
    };
    // The modal scrim: a tenth of black over the page, separated from it by the
    // blur rather than by a heavier wash.
    let scrim: [Style] = [.Background(.Rgba(0, 0, 0, 0.1)), .BackdropBlur(.Px(4))];
    assert.equal(
        render(ctx, ui.stack({ styles: scrim, children: [] })).markup(),
        "e 0 class:bg-000000a0_1 bdblur-4",
    );
    // A radius that follows the reader's text size.
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.BackdropBlur(.Rem(0.125))], children: [] }),
        ).markup(),
        "e 0 class:bdblur-r0_125",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bdblur-4{backdrop-filter:blur(4px)}"));
    assert.isTrue(sheet.contains(".bdblur-r0_125{backdrop-filter:blur(0.125rem)}"));
}

test "a backdrop blur is its own slot: last wins, and a background beside it stays" {
    let ctx = context {
        Ui: headless(),
    };
    // Same property, last wins.
    assert.equal(
        render(
            ctx,
            ui.stack({
                styles: [.BackdropBlur(.Px(2)), .BackdropBlur(.Px(8))],
                children: [],
            }),
        ).markup(),
        "e 0 class:bdblur-8",
    );
    // A different property, so both classes land — the blur touches no
    // declaration a background does.
    assert.equal(
        render(
            ctx,
            ui.stack({
                styles: [.BackdropBlur(.Px(4)), .Background(.Rgb(0, 0, 0))],
                children: [],
            }),
        ).markup(),
        "e 0 class:bdblur-4 bg-000000",
    );
}

test "a backdrop blur takes a state and a breakpoint, and degrades to an inline style" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let stated: [Style] = [
        .BackdropBlur(.Px(4)),
        .On(.Hover, [.BackdropBlur(.Px(8))]),
        .At(.Medium, [.BackdropBlur(.Px(2))]),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: stated, children: [] })).markup(),
        "e 0 class:bdblur-4 hover_bdblur-8 md_bdblur-2",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".hover_bdblur-8:hover{backdrop-filter:blur(8px)}"));
    assert.isTrue(sheet.contains(".md_bdblur-2{backdrop-filter:blur(2px)}"));
    // A radius the folder cannot reach lands in the tier `Computed` lives in.
    let radius = signal(ctx, 4);
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.BackdropBlur(.Px(radius.get(ctx)))], children: [] }),
        ).markup(),
        "e 0 backdrop-filter:blur(4px)",
    );
}

test "the scene document writes the backdrop blur the browser was given" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    let radius = signal(ctx, 0);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Background(.Rgba(0, 0, 0, 0.1)),
                .BackdropBlur(.Px(radius.get(ctx) + 4)),
            ],
            children: [],
        }),
    );
    // The background folded and the blur did not, so the element carries one of
    // each tier — and the scene says both, in the order the browser was given
    // them.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:bg-000000a0_1;backdrop-filter:blur(4px)",
    );
}

test "a failing control announces so, and the ring hangs off the attribute" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let email = signal(ctx, "ada");
    let failing = signal(ctx, true);
    let ring: [Style] = [.On(.Invalid, [.BorderColor(.Rgb(220, 38, 38))])];
    let page = render(
        ctx,
        ui.field({
            label: .Const("Email"),
            kind: .Email,
            value: email,
            styles: ring,
            isInvalid: .Some(.Cell(failing)),
        }),
    );
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Email\ne 1 field:email\nt 2 ada",
    );
    let sheet = stylesheet();
    // The attribute is the source of truth, so the rule asks about the
    // attribute — `:invalid` is a browser's own verdict and no program can
    // reach it.
    assert.isTrue(
        sheet.contains(
            ".invalid_bc-dc2626[aria-invalid=true]{border-color:rgb(220,38,38)}",
        ),
    );
    // Valid again, and the attribute goes rather than saying `false`: an
    // attribute that is there is what the selector asks about.
    let _ = failing.set(ctx, false);
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Email\ne 1 field:email\nt 2 ada",
    );
}

test "a toggle says it is failing the same way, and a valid one says nothing" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let agreed = signal(ctx, false);
    let page = render(
        ctx,
        ui.toggle({
            label: .Const("terms"),
            kind: .Checkbox,
            isOn: agreed,
            styles: [],
            isInvalid: .Some(.Const(true)),
        }),
    );
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\ne 1 class:lay-row ac-center w-r1 h-r1 shrink-0 am-start;checked:false\nt 1 terms",
    );
    // A control that is not failing carries nothing at all, which is what
    // every field and toggle in this suite already says.
    let quiet = render(
        ctx,
        ui.toggle({ label: .Const("done"), kind: .Checkbox, isOn: agreed, styles: [] }),
    );
    assert.equal(
        quiet.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\ne 1 class:lay-row ac-center w-r1 h-r1 shrink-0 am-start;checked:false\nt 1 done",
    );
}

test "a radio group is a radiogroup of real radios sharing one name" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let size = signal(ctx, "m");
    let page = render(
        ctx,
        ui.picker({
            label: .Const("Size"),
            options: [
                ("s", ui.text({ content: .Const("Small") })),
                ("m", ui.text({ content: .Const("Medium") })),
                ("l", ui.text({ content: .Const("Large") })),
            ],
            value: size,
            styles: [],
        }),
    );
    // A `role="radiogroup"` labelled by the group's name, one real
    // `<input type="radio">` per option all sharing the group's `name`, each
    // option a `(key, caption)`, and the input whose key is the signal checked.
    // The browser owns the roving tabindex, the arrow keys, `aria-checked` and
    // Space from there.
    assert.equal(
        page.markup(),
        "e 0 \ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:false\nt 2 Small\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:true\ne 3 mark:dot;width:50%;height:50%\nt 2 Medium\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:false\nt 2 Large",
    );
    // One input per option, and nothing shared with a second group: a page of
    // two groups numbers them apart, which is what makes the browser's model
    // right.
    assert.equal(page.count("input"), 3);
    let two = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.picker({
                    label: .Const("A"),
                    options: [("x", ui.text({ content: .Const("X") }))],
                    value: size,
                    styles: [],
                }),
                ui.picker({
                    label: .Const("B"),
                    options: [("y", ui.text({ content: .Const("Y") }))],
                    value: signal(ctx, "y"),
                    styles: [],
                }),
            ],
        }),
    );
    // The shared `name` that groups each set of radios, and that two groups on
    // one page number apart, is an HTML attribute the scene does not carry —
    // `ui/web`'s document pins it (`web/document.buri`). Here the structure is
    // the claim: two groups, one input each.
    assert.equal(two.count("input"), 2);
}

test "picking a radio writes its key, and the checked one follows the signal" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let choice = signal(ctx, "a");
    let page = render(
        ctx,
        ui.picker({
            label: .Const("Pick"),
            options: [
                ("a", ui.text({ content: .Const("Apple") })),
                ("b", ui.text({ content: .Const("Banana") })),
            ],
            value: choice,
            styles: [],
        }),
    );
    // Picking an option is the browser's `change` on its input, and what it
    // does is write the option's key. The checked input then follows the
    // signal, so the one that was on goes off without a handler saying so.
    page.flip("Banana");
    assert.equal(
        page.markup(),
        "e 0 \ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:true\ne 3 mark:dot;width:50%;height:50%\nt 2 Apple\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:false\nt 2 Banana",
    );
    // Writing the signal from elsewhere checks the matching input too.
    let _ = choice.set(ctx, "a");
    assert.containsText(
        page.markup(),
        "e 0 \ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:true\ne 3 mark:dot;width:50%;height:50%\nt 2 Apple\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row am-center ac-center w-r1 h-r1 shrink-0 r-full bw-1;checked:false\nt 2 Banana",
    );
}

test "a radio group's scene is a box of options, the checked one holding the dot" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let size = signal(ctx, "m");
    let tree = rooted(
        ctx,
        ui.picker({
            label: .Const("Size"),
            options: [
                ("s", ui.text({ content: .Const("Small") })),
                ("m", ui.text({ content: .Const("Medium") })),
            ],
            value: size,
            styles: [],
        }),
    );
    let scene = ui.describe(ctx, tree, .Hover);
    // One option answers `:checked` and holds the dot the reset draws with
    // `:checked::before`; the other answers false and holds none. The captions
    // are the runs of text beside them.
    assert.containsText(scene, "checked:true");
    assert.containsText(scene, "checked:false");
    assert.containsText(scene, "mark:dot");
    assert.containsText(scene, "Small");
    assert.containsText(scene, "Medium");
    // A key no option carries checks nothing, which is what an unset group is:
    // no option answers checked, and no dot is drawn.
    let _ = size.set(ctx, "none");
    let unset = ui.describe(ctx, tree, .Hover);
    assert.isFalse(unset.contains("checked:true"));
    assert.isFalse(unset.contains("mark:dot"));
}

test "the invalid state is a state like the other five" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let stated: [Style] = [
        .On(.Invalid, [.Background(.Rgb(254, 226, 226))]),
        .At(.Small, [.On(.Invalid, [.Opacity(0.5)])]),
    ];
    assert.equal(
        render(ctx, ui.stack({ styles: stated, children: [] })).markup(),
        "e 0 ",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ".invalid_bg-fee2e2[aria-invalid=true]{background-color:rgb(254,226,226)}",
        ),
    );
    assert.isTrue(sheet.contains(".sm_invalid_op-0_5[aria-invalid=true]{opacity:0.5}"));
    // A scene taken in one state carries that state's classes and no other's,
    // which is the whole of how a snapshot tells six documents apart.
    let scene = ui.describe(ctx, ui.stack({ styles: stated, children: [] }), .Invalid);
    assert.containsText(scene, "invalid_bg-fee2e2");
    assert.isFalse(
        ui
            .describe(ctx, ui.stack({ styles: stated, children: [] }), .Hover)
            .contains("invalid_"),
    );
}

test "a value with no bounded spelling is named by what it is" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [.Layout(.Grid([.Fraction(1), .Fixed(.Px(200)), .Auto]))],
                    children: [],
                }),
                ui.stack({ styles: [.Layout(.Layers)], children: [] }),
                ui.stack({ styles: [.FontFamily(.Mono)], children: [] }),
                ui.stack({ styles: [.FontFamily(.Named("Iosevka"))], children: [] }),
                ui.stack({
                    styles: [
                        .Shadow(Shadow {
                            x: .Px(0),
                            y: .Px(2),
                            blur: .Px(6),
                            spread: .Px(0),
                            color: .Rgba(0, 0, 0, 0.25),
                        }),
                    ],
                    children: [],
                }),
            ],
        }),
    );
    let _ = render(ctx, tree).markup();
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains("{display:grid;grid-template-columns:1fr 200px auto}"),
    );
    // The children's half of `Layers` is a rule about descendants, which is the
    // one place a class needs two blocks.
    assert.isTrue(sheet.contains("{grid-area:1/1}"));
    assert.isTrue(
        sheet.contains("{font-family:ui-monospace,SFMono-Regular,monospace}"),
    );
    assert.isTrue(sheet.contains("{font-family:\"Iosevka\",ui-sans-serif,sans-serif}"));
    assert.isTrue(sheet.contains("{box-shadow:0px 2px 6px 0px rgba(0,0,0,0.25)}"));
}

test "the last value of a property is the one that survives" {
    let ctx = context {
        Ui: headless(),
    };
    // Both sides are literals, so this resolved at compile time: the element
    // carries one class rather than two that fight in the cascade.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Background(.Rgb(0, 0, 0)), .Background(.Inherit)],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:bg-inherit");
}

// --- shadows, in layers ---------------------------------------------------------------

test "several shadows are one declaration, in the order they were written" {
    let ctx = context {
        Ui: headless(),
    };
    // The elevation every design system ships: a wide soft layer, and a tight
    // one under the near edge that keeps it crisp.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Shadows([
                    Shadow {
                        x: .Px(0),
                        y: .Px(4),
                        blur: .Px(6),
                        spread: .Px(-1),
                        color: .Rgba(0, 0, 0, 0.1),
                    },
                    Shadow {
                        x: .Px(0),
                        y: .Px(2),
                        blur: .Px(4),
                        spread: .Px(-2),
                        color: .Rgba(0, 0, 0, 0.1),
                    },
                ]),
            ],
            children: [],
        }),
    );
    let _ = render(ctx, tree).markup();
    assert.isTrue(
        stylesheet().contains(
            "{box-shadow:0px 4px 6px -1px rgba(0,0,0,0.1),0px 2px 4px -2px rgba(0,0,0,0.1)}",
        ),
    );
}

test "one shadow written as a list is the one-layer spelling's own class" {
    let ctx = context {
        Ui: headless(),
    };
    // The declaration decides the class, so a list of one and the single
    // spelling of the same shadow are one rule rather than two.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [.Shadow(tight)], children: [] }),
                ui.stack({ styles: [.Shadows([tight])], children: [] }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:sh-f3a4517c\ne 1 class:sh-f3a4517c",
    );
    assert.isTrue(
        stylesheet().contains(
            ".sh-f3a4517c{box-shadow:0px 1px 2px 0px rgba(0,0,0,0.05)}",
        ),
    );
}

test "`Shadow` and `Shadows` share one slot, so the last written wins" {
    let ctx = context {
        Ui: headless(),
    };
    // Both sides are literals, so the compiler settled this: one class each,
    // and it is the one written last.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [.Shadow(ring), .Shadows([lift, ring])],
                    children: [],
                }),
                ui.stack({
                    styles: [.Shadows([lift, ring]), .Shadow(ring)],
                    children: [],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:sh-a990b199\ne 1 class:sh-a64dfa66",
    );
}

test "a shadow under a state is its own slot, beside the resting one" {
    let ctx = context {
        Ui: headless(),
    };
    // A pseudo-class and the resting value are different slots, so a card that
    // is raised keeps its elevation and gains the ring on focus.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Shadow(lift), .On(.Focus, [.Shadows([ring, lift])])],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:sh-174de1bf");
    assert.isTrue(
        stylesheet().contains(
            ".focus_sh-10967775:focus-visible{box-shadow:0px 0px 0px 3px rgba(59,130,246,0.5),0px 2px 4px 0px rgba(0,0,0,0.2)}",
        ),
    );
}

test "shadows that arrive as a parameter resolve last-wins over the one emitted" {
    let ctx = context {
        Ui: headless(),
    };
    // The merge is the runtime scan, and one slot for the two spellings is
    // what makes a caller's elevation replace the component's own shadow
    // rather than land beside it.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                shadowed([], "plain"),
                shadowed([.Shadows([lift, ring])], "raised"),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:sh-f3a4517c\nt 2 plain\ne 1 class:sh-a990b199\nt 2 raised",
    );
}

test "a shadow list is in the scene document the painter reads" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // The layers are a parameter, so this is the inline tier — and what it
    // writes out is the same declaration the stylesheet would have held. The
    // headless painter reads the scene and a browser reads the markup, and
    // they agree only while the two carry the same text.
    let tree = cast([lift, ring]);
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 box-shadow:0px 2px 4px 0px rgba(0,0,0,0.2),0px 0px 0px 3px rgba(59,130,246,0.5)",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 box-shadow:0px 2px 4px 0px rgba(0,0,0,0.2),0px 0px 0px 3px rgba(59,130,246,0.5)",
    );
}

// --- a colour, faded ------------------------------------------------------------------

test "a colour written out fades to a plain rgba" {
    let ctx = context {
        Ui: headless(),
    };
    // Nothing is deferred: the channels are known, so the fade is arithmetic
    // the compiler does and the class is the ordinary `Rgba` one.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [.Background(Color.Rgb(30, 110, 220).alpha(0.5))],
                    children: [],
                }),
                ui.stack({
                    styles: [.Foreground(Color.Rgba(0, 0, 0, 1.0).alpha(0.25))],
                    children: [],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:bg-1e6edca0_5\ne 1 class:fg-000000a0_25",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".bg-1e6edca0_5{background-color:rgba(30,110,220,0.5)}"),
    );
    assert.isTrue(sheet.contains(".fg-000000a0_25{color:rgba(0,0,0,0.25)}"));
}

test "a token fades into a mix that still names the token" {
    let ctx = context {
        Ui: headless(),
    };
    // The token is still what decides the hue, so a theme that changes it
    // changes this too — and no second token has to be minted to spell a fade.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .BorderWidth(.Px(3)),
                .BorderColor(style.token("cardlib", "ring").alpha(0.5)),
                .Background(style.token("cardlib", "ring").alpha(0.2)),
            ],
            children: [],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:bw-3 bc-t_cardlib_ringa0_5 bg-t_cardlib_ringa0_2",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ".bc-t_cardlib_ringa0_5{border-color:color-mix(in srgb,var(--cardlib-ring) 50%,transparent)}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ".bg-t_cardlib_ringa0_2{background-color:color-mix(in srgb,var(--cardlib-ring) 20%,transparent)}",
        ),
    );
}

test "fading a colour is the same property, so the last one wins" {
    let ctx = context {
        Ui: headless(),
    };
    // A fade is not a property of its own. It is the colour, so it lands in
    // the colour's slot and the two never sit side by side.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Background(style.token("cardlib", "ring")),
                .Background(style.token("cardlib", "ring").alpha(0.5)),
            ],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:bg-t_cardlib_ringa0_5");
}

test "nothing and whatever-was-inherited have no colour to fade" {
    let ctx = context {
        Ui: headless(),
    };
    // Neither names a colour, so `alpha` answers each of them unchanged rather
    // than inventing one to fade.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [.Background(Color.Transparent.alpha(0.5))],
                    children: [],
                }),
                ui.stack({
                    styles: [.Foreground(Color.Inherit.alpha(0.5))],
                    children: [],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:bg-none\ne 1 class:fg-inherit",
    );
}

test "a faded token is the same mix inline, and in the scene document" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // The colour is a parameter, so it degrades to the inline tier — and what
    // is written out is the same text the stylesheet would have held.
    let tree = painted(style.token("cardlib", "ring").alpha(0.5));
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 background-color:color-mix(in srgb,var(--cardlib-ring) 50%,transparent)",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 background-color:color-mix(in srgb,var(--cardlib-ring) 50%,transparent)",
    );
}

test "a faded token inside a shadow is the ring every focus style is" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .On(.Focus, [
                    .Shadow(Shadow {
                        x: .Px(0),
                        y: .Px(0),
                        blur: .Px(0),
                        spread: .Px(3),
                        color: style.token("cardlib", "ring").alpha(0.5),
                    }),
                ]),
            ],
            children: [],
        }),
    );
    let _ = render(ctx, tree).markup();
    assert.isTrue(
        stylesheet().contains(
            ":focus-visible{box-shadow:0px 0px 0px 3px color-mix(in srgb,var(--cardlib-ring) 50%,transparent)}",
        ),
    );
}

test "the remaining alignments and weights and cursors each have a name" {
    let ctx = context {
        Ui: headless(),
    };
    // `AlignCross(.SpaceAround)` is not a legal `align-items` value, so it
    // resolves to the stretch a browser falls back to — the class is
    // `ac-stretch`, the same one `AlignCross(.Stretch)` earns. On the main
    // axis a distribution is legal, so `AlignMain(.SpaceEvenly)` keeps `am-evenly`.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [
                        .AlignMain(.Start),
                        .AlignCross(.End),
                        .FontWeight(.Regular),
                    ],
                    children: [],
                }),
                ui.stack({
                    styles: [
                        .AlignMain(.Stretch),
                        .AlignCross(.SpaceAround),
                        .FontWeight(.Medium),
                    ],
                    children: [],
                }),
                ui.stack({
                    styles: [
                        .AlignMain(.SpaceEvenly),
                        .FontWeight(.Bold),
                        .Cursor(.Default),
                    ],
                    children: [],
                }),
                ui.stack({ styles: [.Cursor(.Text)], children: [] }),
                ui.stack({ styles: [.Cursor(.NotAllowed)], children: [] }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:am-start ac-end fw-regular\ne 1 class:am-stretch ac-stretch fw-medium\ne 1 class:am-evenly fw-bold cur-default\ne 1 class:cur-text\ne 1 class:cur-notallowed",
    );
}

test "a cross-axis distribution is the stretch a browser falls back to" {
    let ctx = context {
        Ui: headless(),
    };
    // buri#80: `align-items:space-between` is not a legal declaration, so a
    // browser drops it and `align-items` stays `normal`, which for a flex
    // container is stretch. `AlignCross` and `AlignSelf` take the whole `Align`
    // enum, so the three distributions resolve to the stretch a browser lands
    // on — one class, shared with the `.Stretch` that means it outright — while
    // `AlignMain`, where a distribution is legal, keeps it.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [.AlignCross(.SpaceBetween)], children: [] }),
                ui.stack({ styles: [.AlignCross(.SpaceAround)], children: [] }),
                ui.stack({ styles: [.AlignCross(.SpaceEvenly)], children: [] }),
                ui.stack({ styles: [.AlignCross(.Stretch)], children: [] }),
                ui.stack({ styles: [.AlignSelf(.SpaceEvenly)], children: [] }),
                ui.stack({ styles: [.AlignSelf(.Stretch)], children: [] }),
                ui.stack({ styles: [.AlignMain(.SpaceBetween)], children: [] }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:ac-stretch\ne 1 class:ac-stretch\ne 1 class:ac-stretch\ne 1 class:ac-stretch\ne 1 class:as-stretch\ne 1 class:as-stretch\ne 1 class:am-between",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".ac-stretch{align-items:stretch}"));
    assert.isTrue(sheet.contains(".as-stretch{align-self:stretch}"));
    // A distribution on the main axis is legal and untouched.
    assert.isTrue(sheet.contains(".am-between{justify-content:space-between}"));
    // The sheet never carries the declaration a browser would throw away.
    assert.isFalse(sheet.contains("align-items:space-between"));
    assert.isFalse(sheet.contains("align-items:space-around"));
    assert.isFalse(sheet.contains("align-items:space-evenly"));
    assert.isFalse(sheet.contains("align-self:space-evenly"));
}

test "two elements asking for one padding are given one class" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [.Padding(.Px(11))], children: [] }),
                ui.stack({
                    styles: [.Layout(.Row), .Group([.Padding(.Px(11))])],
                    children: [],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:p-11\ne 1 class:lay-row p-11",
    );
    assert.isTrue(stylesheet().contains(".p-11{padding:11px}"));
}

test "a state is a pseudo-class in the stylesheet and costs nothing on the element" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Background(.Rgb(1, 1, 1)),
                .On(.Hover, [.Background(.Rgb(2, 2, 2))]),
            ],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:bg-010101 hover_bg-020202");
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".hover_bg-020202:hover{background-color:rgb(2,2,2)}"),
    );
    // A pseudo-class and the base value are different conflict slots: they
    // apply at different times, so they never resolve against each other.
    assert.isTrue(sheet.contains(".bg-010101{background-color:rgb(1,1,1)}"));
}

test "a breakpoint is a media query, mobile first" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .At(.Medium, [.Padding(.Px(24))]),
                .At(.Large, [.Padding(.Px(32))]),
            ],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:md_p-24 lg_p-32");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".md_p-24{padding:24px}"));
    assert.isTrue(sheet.contains(".lg_p-32{padding:32px}"));
    // Ascending, so a larger tier overrides a smaller one by being written
    // later. That is what makes a max-width query unnecessary.
    let medium = assert.some(sheet.indexOf("(min-width:48rem)"));
    let large = assert.some(sheet.indexOf("(min-width:64rem)"));
    assert.isTrue(medium < large);
}

test "a state inside a breakpoint is both at once" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.At(.Small, [.On(.Focus, [.Radius(.Px(3))])])],
            children: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 ");
    assert.isTrue(
        stylesheet().contains(".sm_focus_r-3:focus-visible{border-radius:3px}"),
    );
}

test "an em is a length, and it follows the element's own text size" {
    let ctx = context {
        Ui: headless(),
    };
    // A rem follows the root and an em follows this element, so tracking
    // written once is right at every size the title is ever set at.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .FontSize(.Px(18)),
                .LetterSpacing(.Em(-0.025)),
                .Gap(.Em(0.5)),
                .Padding(.Em(1.0)),
                .Width(.Em(12.0)),
            ],
            children: [],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:fs-18 ls-en0_025 gap-e0_5 p-e1 w-e12",
    );
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".ls-en0_025{letter-spacing:-0.025em}"));
    assert.isTrue(sheet.contains(".gap-e0_5{gap:0.5em}"));
    assert.isTrue(sheet.contains(".p-e1{padding:1em}"));
    assert.isTrue(sheet.contains(".w-e12{width:12em}"));
}

test "an em resolves per property like every other length" {
    let ctx = context {
        Ui: headless(),
    };
    // The same slot twice is last-wins, whichever unit each side is in.
    let overridden = rooted(
        ctx,
        ui.stack({ styles: [.Padding(.Em(1.0)), .Padding(.Px(4))], children: [] }),
    );
    assert.equal(render(ctx, overridden).markup(), "e 0 class:p-4");
    // Two edges are two slots, so they compose.
    let edges = rooted(
        ctx,
        ui.stack({
            styles: [.PaddingEdge(.Top, .Em(0.5)), .PaddingEdge(.Bottom, .Em(1.5))],
            children: [],
        }),
    );
    assert.equal(render(ctx, edges).markup(), "e 0 class:pe-top-e0_5 pe-bottom-e1_5");
    // And a condition is a slot of its own, in the stylesheet either way.
    let stated = rooted(
        ctx,
        ui.stack({
            styles: [.On(.Hover, [.Gap(.Em(2.0))]), .At(.Medium, [.Gap(.Em(3.0))])],
            children: [],
        }),
    );
    assert.equal(render(ctx, stated).markup(), "e 0 class:hover_gap-e2 md_gap-e3");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".pe-top-e0_5{padding-block-start:0.5em}"));
    assert.isTrue(sheet.contains(".pe-bottom-e1_5{padding-block-end:1.5em}"));
    assert.isTrue(sheet.contains(".hover_gap-e2:hover{gap:2em}"));
    assert.isTrue(sheet.contains(".md_gap-e3{gap:3em}"));
}

test "a reversed layout paints backwards and leaves the document alone" {
    let ctx = context {
        Ui: headless(),
    };
    // The order is the caller's, and it is the order a screen reader and the
    // tab ring read. Only the paint is reversed.
    let footer = rooted(
        ctx,
        ui.stack({
            styles: [.Layout(.ColumnReverse)],
            children: [
                ui.text({ content: .Const("cancel") }),
                ui.text({ content: .Const("confirm") }),
            ],
        }),
    );
    assert.equal(
        render(ctx, footer).markup(),
        "e 0 class:lay-colrev\nt 1 cancel\nt 1 confirm",
    );
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Layout(.RowReverse)], children: [] }),
        ).markup(),
        "e 0 class:lay-rowrev",
    );
    // One property, so the last one written is the one that survives.
    assert.equal(
        render(
            ctx,
            ui.stack({ styles: [.Layout(.Row), .Layout(.RowReverse)], children: [] }),
        ).markup(),
        "e 0 class:lay-rowrev",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".lay-colrev{display:flex;flex-direction:column-reverse}"),
    );
    assert.isTrue(
        sheet.contains(".lay-rowrev{display:flex;flex-direction:row-reverse}"),
    );
    // `Truncate` is declared after `Layout` and still overrides it, which is
    // the ordering the four layouts shared and the two new ones join.
    let layout = assert.some(sheet.indexOf(".lay-rowrev"));
    let truncate = assert.some(sheet.indexOf(".trunc-"));
    assert.isTrue(layout < truncate);
}

test "a translate shifts the painted box and moves no sibling" {
    let ctx = context {
        Ui: headless(),
    };
    // The press every design system writes: a pixel down while the pointer is
    // held, with the row around it exactly where it was.
    let save = rooted(
        ctx,
        ui.button({
            label: .Const("Save"),
            styles: [.Radius(.Px(8)), .On(.Active, [.Translate(.Px(0), .Px(1))])],
            onPress: .Some(fn(_c) => ()),
        }),
    );
    assert.equal(render(ctx, save).markup(), "e 0 class:r-8\nt 1 Save");
    // One slot: two translates are one transform, and the last wins.
    assert.equal(
        render(
            ctx,
            ui.stack({
                styles: [
                    .Translate(.Px(4), .Px(4)),
                    .Translate(.Em(0.5), .Percent(-50.0)),
                ],
                children: [],
            }),
        ).markup(),
        "e 0 class:tr-e0_5-pcn50",
    );
    // A `Position` beside it is a different declaration and composes.
    assert.equal(
        render(
            ctx,
            ui.stack({
                styles: [.Position(.Sticky), .Translate(.Rem(1.0), .Auto)],
                children: [],
            }),
        ).markup(),
        "e 0 class:pos-sticky tr-r1-auto",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".active_tr-0-1:active{transform:translate(0px,1px)}"),
    );
    assert.isTrue(sheet.contains(".tr-e0_5-pcn50{transform:translate(0.5em,-50%)}"));
    assert.isTrue(sheet.contains(".tr-r1-auto{transform:translate(1rem,auto)}"));
}

test "focus-within is a state, and it is the container's own" {
    let ctx = context {
        Ui: headless(),
    };
    // The input group: the wrapper owns the hairline and the ring, and the
    // field inside it is bare.
    let group = rooted(
        ctx,
        ui.stack({
            styles: [
                .Layout(.Row),
                .Group([
                    .BorderWidth(.Px(1)),
                    .On(.FocusWithin, [.BorderColor(.Rgb(2, 2, 2))]),
                    .At(.Small, [.On(.FocusWithin, [.Radius(.Px(3))])]),
                ]),
            ],
            children: [],
        }),
    );
    assert.equal(render(ctx, group).markup(), "e 0 class:lay-row bw-1");
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".focuswithin_bc-020202:focus-within{border-color:rgb(2,2,2)}"),
    );
    assert.isTrue(
        sheet.contains(".sm_focuswithin_r-3:focus-within{border-radius:3px}"),
    );
    // `Focus` is `:focus-visible` on the element itself, so the two are
    // different conditions and different slots.
    let both = rooted(
        ctx,
        ui.stack({
            styles: [.On(.Focus, [.Opacity(0.9)]), .On(.FocusWithin, [.Opacity(0.8)])],
            children: [],
        }),
    );
    assert.equal(render(ctx, both).markup(), "e 0 ");
}

test "a document is taken in one state, and carries only that state's classes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Background(.Rgb(1, 1, 1)),
                .On(.Hover, [.Background(.Rgb(2, 2, 2))]),
                .On(.FocusWithin, [.Background(.Rgb(3, 3, 3))]),
            ],
            children: [],
        }),
    );
    assert.equal(
        ui.describe(ctx, tree, .FocusWithin),
        "buri-scene 1\nviewport 800 fit\ne 0 class:bg-010101 focuswithin_bg-030303",
    );
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:bg-010101 hover_bg-020202",
    );
}

test "the three new entries write the same declarations inline" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so the folder stops at each of these and all three
    // degrade to the tier `Computed` lives in. What they write out there has to
    // be the CSS the classes above mean.
    let reversed = signal(ctx, true);
    let tracking = signal(ctx, 0.1);
    let sunk = signal(ctx, -0.5);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Layout(if (reversed.get(ctx)) { .ColumnReverse } else { .Column }),
                .LetterSpacing(.Em(tracking.get(ctx))),
                .Translate(.Px(0), .Em(sunk.get(ctx))),
            ],
            children: [],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 display:flex;flex-direction:column-reverse;letter-spacing:0.1em;transform:translate(0px,-0.5em)",
    );
    // The scene document the headless painter reads says the same thing.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 display:flex;flex-direction:column-reverse;letter-spacing:0.1em;transform:translate(0px,-0.5em)",
    );
    assert.isFalse(stylesheet().contains("letter-spacing:0.1em"));
}

test "a `When` puts both branches in the stylesheet and swaps between them" {
    let ctx = context {
        Ui: headless(),
    };
    let lit = signal(ctx, false);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .When(.Cell(lit), [.Background(.Rgb(255, 0, 0))], [
                    .Background(.Rgb(0, 0, 255)),
                ]),
            ],
            children: [],
        }),
    );
    let view = render(ctx, tree);
    assert.equal(view.markup(), "e 0 class:bg-0000ff");
    lit.set(ctx, true);
    assert.equal(view.markup(), "e 0 class:bg-ff0000");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".bg-ff0000{background-color:rgb(255,0,0)}"));
    assert.isTrue(sheet.contains(".bg-0000ff{background-color:rgb(0,0,255)}"));
}

test "a `Computed` style is inline, re-serialises, and is never in the stylesheet" {
    let ctx = context {
        Ui: headless(),
    };
    let width = signal(ctx, 137);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Computed(fn(scope) => [.Width(.Px(width.get(scope)))])],
            children: [],
        }),
    );
    let view = render(ctx, tree);
    assert.equal(view.markup(), "e 0 width:137px");
    width.set(ctx, 241);
    assert.equal(view.markup(), "e 0 width:241px");
    let sheet = stylesheet();
    assert.isFalse(sheet.contains("137px"));
    assert.isFalse(sheet.contains("241px"));
}

test "a style the compiler cannot evaluate becomes an inline style" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // `get` takes a context, so it is not pure, so the folder stops here — and
    // the style degrades to the tier `Computed` lives in rather than failing.
    let share = signal(ctx, 7);
    let tree = rooted(ctx, ui.stack({ styles: [.Grow(share.get(ctx))], children: [] }));
    assert.equal(render(ctx, tree).markup(), "e 0 flex-grow:7");
    assert.isFalse(stylesheet().contains("grow-7"));
}

test "a style that arrives as a parameter resolves last-wins over emitted classes" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [boxed([], "plain"), boxed([.Background(.Rgb(9, 9, 9))], "loud")],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:p-8 bg-000000\nt 2 plain\ne 1 class:p-8 bg-090909\nt 2 loud",
    );
}

test "a static style registers nothing and a computed one re-runs once per change" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let width = signal(ctx, 21);
    let view = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({ styles: [.Padding(.Px(13))], children: [] }),
                ui.stack({
                    styles: [
                        .Computed(fn(scope) => {
                            [.Width(.Px(log.note(width.get(scope))))]
                        }),
                    ],
                    children: [],
                }),
            ],
        }),
    );
    assert.equal(view.markup(), "e 0 \ne 1 class:p-13\ne 1 width:21px");
    // The static one never ran a computation, so nothing it could have noted
    // is here; the computed one ran once.
    assert.equal(log.noted(), [21]);
    width.set(ctx, 22);
    assert.equal(view.markup(), "e 0 \ne 1 class:p-13\ne 1 width:22px");
    assert.equal(log.noted(), [21, 22]);
}

// --- widgets -------------------------------------------------------------------------

test "a button carries its label, and a press runs its handler" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let count = signal(ctx, 0);
    let tree = rooted(
        ctx,
        ui.button({
            label: .Const("add"),
            styles: [],
            onPress: .Some(fn(c) => { count.update(c, fn(n) => n + 1) }),
        }),
    );
    let page = render(ctx, tree);
    // The label is the accessible name, so it is an attribute; a button with no
    // children shows it, which is the one place the name and the glyphs agree.
    assert.equal(page.markup(), "e 0 \nt 1 add");
    let _ = page.press("add");
    let _ = page.press("add");
    assert.equal(count.get(ctx), 2);
}

test "a button holds children, and its label stays its name" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    let count = signal(ctx, 0);
    // A rail entry: a mark and a word, one element. Before this the two had to
    // be a row, and a wash for hovered or for the current page went on the row
    // rather than on the thing that is pressed.
    let tree = rooted(
        ctx,
        ui.button({
            label: .Const("Overview"),
            styles: [.Padding(.Px(4))],
            children: .Some([
                ui.text({ content: .Const("*") }),
                ui.text({ content: .Const("Overview") }),
            ]),
            onPress: .Some(fn(c) => count.update(c, fn(n) => n + 1)),
        }),
    );
    let page = render(ctx, tree);
    assert.equal(page.markup(), "e 0 class:p-4\nt 1 *\nt 1 Overview");
    // Pressed by the name a reader hears, which is the label and never the
    // glyphs.
    let _ = page.press("Overview");
    assert.equal(count.get(ctx), 1);
    // And the children are inside the button in the scene too, so what paints
    // the button paints them.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:p-4\nt 1 *\nt 1 Overview",
    );
}

test "a handler is handed the context the tree was rendered with" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let seen = signal(ctx, "");
    // The handler captures the signal, which holds no authority, and takes the
    // authority to write it as a parameter. Capturing the context instead is
    // `lambda-captures-effect`, which is `cli/tests/reject/`'s business.
    let page = render(
        ctx,
        ui.button({
            label: .Const("go"),
            styles: [],
            onPress: .Some(fn(c) => seen.set(c, "pressed")),
        }),
    );
    let _ = page.press("go");
    assert.equal(seen.get(ctx), "pressed");
}

test "a link says where it goes" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.link({
            dest: .Const("/prices"),
            children: [ui.text({ content: .Const("prices") })],
            styles: [],
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 \nt 1 prices");
}

test "an attribute follows a prop that varies" {
    let ctx = context {
        Ui: headless(),
    };
    let dest = signal(ctx, "/one");
    let page = render(
        ctx,
        ui.link({
            dest: .Cell(dest),
            children: [ui.text({ content: .Const("there") })],
            styles: [],
        }),
    );
    assert.equal(page.markup(), "e 0 \nt 1 there");
    let _ = dest.set(ctx, "/two");
    assert.equal(page.markup(), "e 0 \nt 1 there");
}

test "an image says what it shows" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.image({
                    source: .Const("/cat.png"),
                    alt: .AccessibilityText("a cat, asleep"),
                    styles: [],
                }),
                ui.image({
                    source: .Const("/rule.png"),
                    alt: .AccessibilityText(""),
                    styles: [],
                }),
            ],
        }),
    );
    // The empty string is how a decorative image says it is decorative,
    // which a reader has to be told and cannot guess.
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 image:/cat.png\ne 1 image:/rule.png",
    );
}

// --- artwork -------------------------------------------------------------------------
//
// An `icon` is vector artwork *in* the tree. The source is written into the
// document as an `<svg>`, so `currentColor` inside it is the element's own
// `Foreground` and the cascade reaches the stroke — which is the one thing an
// `image` cannot do, its source being a document of its own.

/// A lucide check, the way a component library ships one: `currentColor` where
/// the stroke goes, so the colour is whatever the caller is painting in.
fn check<C>(styles: [Style]): Node<C> {
    ui.image({
        source: .Const(
            "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>",
        ),
        alt: .Decorative,
        styles: styles,
    })
}

/// That artwork as the markup it becomes: the `xmlns` dropped, because the
/// element is in that namespace already, and `aria-hidden` after the source's
/// own attributes.
let drawn: Str =
    "e 0 icon:<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>";

test "an icon is artwork in the tree, so the colour around it reaches inside" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, check([])).markup(), drawn);
    // The row asks for white text and the glyph strokes in `currentColor`, so
    // one declaration paints the label and the glyph together. A data URI in an
    // `image` would still be whatever colour was baked into it.
    let row = rooted(
        ctx,
        ui.stack({
            styles: [.Layout(.Row), .Group([.Foreground(.Rgb(255, 255, 255))])],
            children: [check([])],
        }),
    );
    assert.containsText(render(ctx, row).markup(), "stroke='currentColor'");
}

test "an icon takes styles of its own, and they land on the artwork" {
    let ctx = context {
        Ui: headless(),
    };
    // The `<svg>` is the element, so a size and a colour apply to the thing
    // that is drawn rather than to a wrapper around it.
    assert.containsText(
        render(ctx, check([.Width(.Px(16)), .Height(.Px(16))])).markup(),
        "class:w-16 h-16",
    );
    assert.isTrue(stylesheet().contains(".w-16{width:16px}"));
}

test "an icon's styles compose and conflict the way every other element's do" {
    let ctx = context {
        Ui: headless(),
    };
    // Two edges are two slots, so they compose; one edge twice is one slot, so
    // the last one wins. The scan is the runtime's, over pairs the compiler
    // assigned, and an icon is no different from a stack.
    assert.containsText(
        render(
            ctx,
            check([.PaddingEdge(.Top, .Px(4)), .PaddingEdge(.Bottom, .Px(8))]),
        ).markup(),
        "class:pe-top-4 pe-bottom-8",
    );
    assert.containsText(
        render(
            ctx,
            check([.Foreground(.Rgb(200, 30, 30)), .Foreground(.Rgb(30, 120, 60))]),
        ).markup(),
        "class:fg-1e783c",
    );
    // A pin takes the artwork out of the flow, exactly as it does a stack.
    assert.containsText(
        render(ctx, check([.Position(.Flow), .Pin(.Top, .Px(0))])).markup(),
        "class:pos-flow pin-out pin-top-0",
    );
}

test "an icon's artwork is one scene line however it was written" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // A declaration is one line, and artwork is usually written across several.
    // The breaks flatten to spaces, which is the same whitespace either way —
    // nothing an icon may hold reads a line break as anything else.
    let scene = ui.describe(
        ctx,
        ui.image({
            source: .Const(
                "<svg viewBox='0 0 24 24'>\n  <path d='M20 6 9 17l-5-5'/>\n</svg>",
            ),
            alt: .Decorative,
            styles: [],
        }),
        .Hover,
    );
    assert.equal(scene.lines(ctx).length(), 3);
    assert.containsText(scene, "icon:<svg viewBox='0 0 24 24'>   <path");
}

test "an icon's artwork is in the scene the painter reads" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // `icon:` is a scene-only declaration, as `image:` and `field:` are, and it
    // carries the artwork itself rather than an address — which is what lets
    // the painter bind `currentColor` to the element's own colour. It comes
    // first, so a style still wins over it.
    let scene = ui.describe(ctx, check([.Width(.Px(16))]), .Hover);
    assert.containsText(scene, "e 0 class:w-16;icon:<svg xmlns=");
    assert.containsText(scene, "stroke='currentColor'");
    // A picture holds no children: what is inside it is the source.
    assert.equal(scene.lines(ctx).length(), 3);
}

test "an icon in a state carries that state's classes and no other's" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // A pseudo-class is a rule in the sheet, so what the scene decides is which
    // state's classes the element carries — the same rule every other element
    // is read under.
    let hovered = check([.On(.Hover, [.Foreground(.Rgb(200, 30, 30))])]);
    assert.containsText(ui.describe(ctx, hovered, .Hover), "class:");
    assert.isFalse(ui.describe(ctx, hovered, .Focus).contains("class:"));
}

test "a field is labelled, and what is typed into it is in its signal" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "ada");
    let page = render(
        ctx,
        ui.field({ label: .Const("name"), kind: .Text, value: name, styles: [] }),
    );
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 name\ne 1 field:text\nt 2 ada",
    );
    let _ = page.fill("name", "grace");
    assert.equal(name.get(ctx), "grace");
}

test "a field follows its signal when something else writes it" {
    let ctx = context {
        Ui: headless(),
    };
    let name = signal(ctx, "ada");
    let page = render(
        ctx,
        ui.field({ label: .Const("name"), kind: .Text, value: name, styles: [] }),
    );
    let _ = name.set(ctx, "grace");
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 name\ne 1 field:text\nt 2 grace",
    );
}

test "a field kind is what the field accepts" {
    let ctx = context {
        Ui: headless(),
    };
    let value = signal(ctx, "");
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.field({
                    label: .Const("story"),
                    kind: .Multiline,
                    value: value,
                    styles: [],
                }),
                ui.field({
                    label: .Const("secret"),
                    kind: .Password,
                    value: value,
                    styles: [],
                }),
                ui.field({
                    label: .Const("address"),
                    kind: .Email,
                    value: value,
                    styles: [],
                }),
                ui.field({
                    label: .Const("how many"),
                    kind: .Number,
                    value: value,
                    styles: [],
                }),
                ui.field({
                    label: .Const("query"),
                    kind: .Search,
                    value: value,
                    styles: [],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 story\ne 2 field:multiline\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 secret\ne 2 field:password\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 address\ne 2 field:email\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 how many\ne 2 field:number\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 query\ne 2 field:search\nt 3 ",
    );
}

test "a field takes a hint, and it is the placeholder inside its box" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let query = signal(ctx, "");
    let line = rooted(
        ctx,
        ui.field({
            label: .Const("Search"),
            kind: .Search,
            value: query,
            styles: [],
            hint: .Some(.Const("Type a command")),
        }),
    );
    // The hint is `aria-placeholder`-shaped: it is announced *after* the
    // accessible name rather than instead of it, so the label is still there
    // and still first.
    assert.equal(
        render(ctx, line).markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Search\ne 1 field:search;placeholder:Type a command\nt 2 ",
    );
    // The scene carries it beside the kind, which is what the painter draws
    // the hint from.
    assert.containsText(
        ui.describe(ctx, line, .Hover),
        "e 1 field:search;placeholder:Type a command",
    );
}

test "a hint outlives the value in the markup, the way the attribute does" {
    let ctx = context {
        Ui: headless(),
    };
    let query = signal(ctx, "");
    let page = render(
        ctx,
        ui.field({
            label: .Const("Search"),
            kind: .Search,
            value: query,
            styles: [],
            hint: .Some(.Const("Type a command")),
        }),
    );
    let _ = query.set(ctx, "open");
    // A browser keeps the attribute and stops drawing it, so the hint comes
    // back when the box is cleared. Whether it is *drawn* is the painter's,
    // and `sweep_widgets_hint` is where that is a picture.
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Search\ne 1 field:search;placeholder:Type a command\nt 2 open",
    );
}

test "no hint is no placeholder at all" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let name = signal(ctx, "ada");
    let plain = rooted(
        ctx,
        ui.field({ label: .Const("name"), kind: .Text, value: name, styles: [] }),
    );
    // The empty string is "no hint", the way an image's `alt` already spells
    // "decorative", so a field that wants none carries no markup for one.
    assert.equal(
        render(ctx, plain).markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 name\ne 1 field:text\nt 2 ada",
    );
    assert.isFalse(ui.describe(ctx, plain, .Hover).contains("placeholder"));
}

test "a hint may vary" {
    let ctx = context {
        Ui: headless(),
    };
    let hint = signal(ctx, "Type a command");
    let page = render(
        ctx,
        ui.field({
            label: .Const("Search"),
            kind: .Search,
            value: signal(ctx, ""),
            styles: [],
            hint: .Some(.Cell(hint)),
        }),
    );
    let _ = hint.set(ctx, "Search the docs");
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Search\ne 1 field:search;placeholder:Search the docs\nt 2 ",
    );
    // Emptied, the attribute goes rather than staying on as `placeholder=""`.
    let _ = hint.set(ctx, "");
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Search\ne 1 field:search\nt 2 ",
    );
}

test "every kind that holds text takes a hint, and a range takes none" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let empty = signal(ctx, "");
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                hinted(ctx, .Text, empty),
                hinted(ctx, .Multiline, empty),
                hinted(ctx, .Password, empty),
                hinted(ctx, .Email, empty),
                hinted(ctx, .Number, empty),
                hinted(ctx, .Search, empty),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 what\ne 2 field:text;placeholder:hint\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 what\ne 2 field:multiline;placeholder:hint\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 what\ne 2 field:password;placeholder:hint\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 what\ne 2 field:email;placeholder:hint\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 what\ne 2 field:number;placeholder:hint\nt 3 \ne 1 class:lay-row wrap-wrap ac-center\nt 2 what\ne 2 field:search;placeholder:hint\nt 3 ",
    );
    // A slider has no box to put a word in, and HTML's own `placeholder`
    // applies to the types that hold text and to nothing else. The hint is
    // dropped rather than refused, which is what the DOM does with one.
    let slider = rooted(
        ctx,
        ui.slider({
            label: .Const("Volume"),
            value: signal(ctx, 40.0),
            min: 0.0,
            max: 100.0,
            styles: [],
            step: .Some(1.0),
        }),
    );
    assert.equal(
        render(ctx, slider).markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Volume\ne 1 class:w-r12 h-r1 shrink-0;field:range;range:0.0 100.0 40.0",
    );
    assert.isFalse(ui.describe(ctx, slider, .Hover).contains("placeholder"));
}

test "a hint neither ends the declaration nor the line it is on" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // A semicolon separates one declaration from the next and a line break
    // ends the element, so a hint holding either has to be written out —
    // otherwise a scene reads a word of a hint as a property of its own.
    let scene = ui.describe(
        ctx,
        ui.field({
            label: .Const("Note"),
            kind: .Text,
            value: signal(ctx, ""),
            styles: [],
            hint: .Some(.Const("a; b\nc")),
        }),
        .Hover,
    );
    assert.equal(
        scene,
        "buri-scene 1\nviewport 800 fit\ne 0 class:lay-row wrap-wrap ac-center\nt 1 Note\ne 1 field:text;placeholder:a\\; b c\nt 2 ",
    );
}

test "a toggle is two states and a label" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let done = signal(ctx, false);
    let page = render(
        ctx,
        ui.toggle({ label: .Const("done"), kind: .Checkbox, isOn: done, styles: [] }),
    );
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\ne 1 class:lay-row ac-center w-r1 h-r1 shrink-0 am-start;checked:false\nt 1 done",
    );
    let _ = page.flip("done");
    assert.isTrue(done.get(ctx));
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\ne 1 class:lay-row ac-center w-r1 h-r1 shrink-0 am-end;checked:true\ne 2 mark:tick;width:100%;height:100%\nt 1 done",
    );
    let _ = page.flip("done");
    assert.isFalse(done.get(ctx));
}

test "the label a field and a toggle are wrapped in flows on one line" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let name = signal(ctx, "ada");
    let done = signal(ctx, false);
    // The wrapper is the runtime's element rather than the program's, and the
    // sheet's reset lays it out as a wrapping row: the control and its text sit
    // on one line, and a control as wide as the line takes one of its own. The
    // painter has no inline flow, so the scene says what that comes to in the
    // vocabulary it does have — and the two renderers agree only while it does.
    let inline = "class:lay-row wrap-wrap ac-center";
    let box = "class:lay-row ac-center w-r1 h-r1 shrink-0 am-start";
    assert.equal(
        ui.describe(
            ctx,
            ui.toggle({
                label: .Const("done"),
                kind: .Checkbox,
                isOn: done,
                styles: [],
            }),
            .Hover,
        ),
        str.format(
            ctx,
            "buri-scene 1\nviewport 800 fit\ne 0 ${inline}\ne 1 ${box};checked:false\nt 1 done",
        ),
    );
    // A field is the same wrapper with the text first, which is the order the
    // markup puts them in too.
    assert.equal(
        ui.describe(
            ctx,
            ui.field({ label: .Const("name"), kind: .Text, value: name, styles: [] }),
            .Hover,
        ),
        str.format(
            ctx,
            "buri-scene 1\nviewport 800 fit\ne 0 ${inline}\nt 1 name\ne 1 field:text\nt 2 ada",
        ),
    );
    // And that arrangement is in the sheet as well, weightless, so a class on
    // the wrapper beats it.
    assert.isTrue(
        stylesheet().contains(
            ":where(label){display:flex;flex-direction:row;flex-wrap:wrap;align-items:center}",
        ),
    );
}

test "a labelled control takes styles for the box around it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let site = signal(ctx, "");
    // The input group every form library has: an addon either side of a control
    // that takes the room they leave. `Grow` has to land on the `<label>`,
    // because the label is what the row lays out and nothing on the input can
    // reach it.
    let tree = rooted(
        ctx,
        ui.field({
            label: .Const("Site"),
            kind: .Text,
            value: site,
            styles: [.Width(.Full)],
            around: .Some([.Grow(1)]),
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:lay-row wrap-wrap ac-center grow-1\nt 1 Site\ne 1 class:w-full;field:text\nt 2 ",
    );
    // The scene says the same: the wrapper carries the caller's class beside
    // the arrangement it is given, and the input carries its own.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:lay-row wrap-wrap ac-center grow-1\nt 1 Site\ne 1 class:w-full;field:text\nt 2 ",
    );
    // A style the caller puts on the wrapper beats the arrangement the runtime
    // gave it, which is the rule a `row`'s own `Layout` follows.
    assert.containsText(
        ui.describe(
            ctx,
            ui.field({
                label: .Const("Site"),
                kind: .Text,
                value: site,
                styles: [],
                around: .Some([.Layout(.Column)]),
            }),
            .Hover,
        ),
        "e 0 class:wrap-wrap ac-center lay-col",
    );
}

test "a field exposes its caret and selection, and select moves them" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let value = signal(ctx, "Balance");
    let caret = signal(ctx, (0, 0));
    // A reader watching where the caret is — a completion needs the offset it is
    // at, which nothing but the selection could tell it. Before this a field had
    // no caret to read at all.
    let log = recorder();
    let _ = watch(ctx, fn(s) => ignore(log.note(caret.get(s).0)));
    let page = render(
        ctx,
        ui.field({
            label: .Const("Formula"),
            kind: .Text,
            value: value,
            styles: [],
            selection: .Some(caret),
        }),
    );
    assert.equal(log.noted(), [0]);
    // Selecting a span writes the `(anchor, focus)` pair a reader would have.
    let _ = page.select("Formula", 0, 7);
    assert.equal(caret.get(ctx), (0, 7));
    // A caret is a selection whose two offsets are equal.
    let _ = page.select("Formula", 3, 3);
    assert.equal(caret.get(ctx), (3, 3));
    // A reader watching the caret sees each move — the offset a completion reads
    // is reactive, not a guess diffed out of the text.
    assert.equal(log.noted(), [0, 0, 3]);
    // The selection is not in the scene a painter reads, so moving it rebuilds
    // no field: the value the box shows is where it was.
    assert.containsText(page.markup(), "t 2 Balance");
}

test "a field built without a selection keeps none, and select leaves it alone" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let value = signal(ctx, "Ada");
    let page = render(
        ctx,
        ui.field({ label: .Const("Name"), kind: .Text, value: value, styles: [] }),
    );
    // No selection signal to move: `select` finds the field and does the
    // observable nothing the interface promises — what the box holds is
    // untouched, and nothing aborts.
    let _ = page.select("Name", 0, 3);
    assert.equal(value.get(ctx), "Ada");
}

test "a toggle draws its own mark" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let off = signal(ctx, false);
    let on = signal(ctx, true);
    // A switch always has its thumb, and where it sits is the whole of what
    // tells off from on: at the near end of the track, then at the far end.
    assert.containsText(
        ui.describe(
            ctx,
            ui.toggle({ label: .Const("email"), kind: .Switch, isOn: off, styles: [] }),
            .Hover,
        ),
        "am-start;checked:false\ne 2 mark:thumb;height:100%;aspect-ratio:1",
    );
    assert.containsText(
        ui.describe(
            ctx,
            ui.toggle({ label: .Const("email"), kind: .Switch, isOn: on, styles: [] }),
            .Hover,
        ),
        "am-end;checked:true\ne 2 mark:thumb;height:100%;aspect-ratio:1",
    );
    // A checkbox has its tick only when it is on. Before this a ticked checkbox
    // was a filled square with no check in it.
    assert.isFalse(
        ui
            .describe(
                ctx,
                ui.toggle({
                    label: .Const("done"),
                    kind: .Checkbox,
                    isOn: off,
                    styles: [],
                }),
                .Hover,
            )
            .contains("mark:"),
    );
    assert.containsText(
        ui.describe(
            ctx,
            ui.toggle({ label: .Const("done"), kind: .Checkbox, isOn: on, styles: [] }),
            .Hover,
        ),
        "e 2 mark:tick;width:100%;height:100%",
    );
    // In a browser the mark is the reset's, on the box the runtime built —
    // because an `<input>` holds no children — and a switch says which it is.
    assert.equal(
        render(
            ctx,
            ui.toggle({ label: .Const("email"), kind: .Switch, isOn: on, styles: [] }),
        ).markup(),
        "e 0 class:lay-row wrap-wrap ac-center\ne 1 class:lay-row ac-center w-r1 h-r1 shrink-0 am-end;checked:true\ne 2 mark:thumb;height:100%;aspect-ratio:1\nt 1 email",
    );
    let sheet = stylesheet();
    assert.containsText(
        sheet,
        ":where(input[type=checkbox][role=switch])::before{content:\"\";height:100%;aspect-ratio:1;border-radius:9999px;background-color:currentColor}",
    );
    assert.containsText(
        sheet,
        ":where(input[type=checkbox]:checked){justify-content:flex-end}",
    );
    assert.containsText(
        sheet,
        ":where(input[type=checkbox]:not([role=switch]):checked)::before{",
    );
}

test "an image takes styles of its own, and they land on the picture" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // buri#123: `image` was the one constructor with no `[Style]` slot, so a
    // picture could not be told to fill its box, to crop square or to take the
    // box's corner, and an avatar could not be built. The styles are the
    // picture's rather than a wrapper's: a wrapper's own width is the
    // wrapper's.
    let tree = rooted(
        ctx,
        ui.image({
            source: .Const("/a.png"),
            alt: .AccessibilityText(""),
            styles: [.Width(.Full), .AspectRatio(1.0), .Radius(.Px(9999))],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:w-full ar-1 r-9999;image:/a.png",
    );
    // The scene carries the same three, behind the `image:` that says the box
    // is a picture — the source comes first, so a style still wins over it.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:w-full ar-1 r-9999;image:/a.png",
    );
}

test "a picture's styles take the conflict slots every other element's do" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // Two entries naming different edges compose; the same edge twice is
    // last-wins; and a `Position`, an `On` and an `At` beside them each land
    // where they land on any other element.
    let tree = rooted(
        ctx,
        ui.image({
            source: .Const("/a.png"),
            alt: .AccessibilityText("a"),
            styles: [
                .PaddingEdge(.Top, .Px(4)),
                .PaddingEdge(.Bottom, .Px(6)),
                .PaddingEdge(.Top, .Px(8)),
                .Position(.Sticky),
                .On(.Hover, [.Opacity(0.5)]),
                .At(.Medium, [.Width(.Px(40))]),
            ],
        }),
    );
    let classes = "class:pe-top-8 pe-bottom-6 pos-sticky hover_op-0_5 md_w-40";
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        str.format(ctx, "buri-scene 1\nviewport 800 fit\ne 0 ${classes};image:/a.png"),
    );
    // The same list at rest keeps the breakpoint class — a breakpoint is the
    // stylesheet's business, not the snapshot's — and drops the hover one.
    let resting = "class:pe-top-8 pe-bottom-6 pos-sticky md_w-40";
    assert.equal(
        ui.describe(ctx, tree, .Focus),
        str.format(ctx, "buri-scene 1\nviewport 800 fit\ne 0 ${resting};image:/a.png"),
    );
}

test "a disabled control says so in its markup" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // buri#126: nothing could put an element into `State::Disabled`, so every
    // `On(.Disabled, ...)` ever written was dead code and a control that should
    // refuse input stayed focusable. The attribute is what takes it out of the
    // tab order and tells a reader it is unavailable rather than absent.
    let name = signal(ctx, "ada");
    let done = signal(ctx, false);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("save"),
                    styles: [],
                    onPress: .Some(fn(_c) => ()),
                    isDisabled: .Some(.Const(true)),
                }),
                ui.field({
                    label: .Const("name"),
                    kind: .Text,
                    value: name,
                    styles: [],
                    isDisabled: .Some(.Const(true)),
                }),
                ui.toggle({
                    label: .Const("done"),
                    kind: .Checkbox,
                    isOn: done,
                    styles: [],
                    isDisabled: .Some(.Const(true)),
                }),
            ],
        }),
    );
    assert.containsText(
        render(ctx, tree).markup(),
        "e 0 \ne 1 disabled:true\nt 2 save\ne 1 class:lay-row wrap-wrap ac-center\nt 2 name\ne 2 field:text;disabled:true\nt 3 ada\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row ac-center w-r1 h-r1 shrink-0 am-start;checked:false;disabled:true\nt 2 done",
    );
    assert.containsText(
        render(ctx, tree).markup(),
        "e 0 \ne 1 disabled:true\nt 2 save\ne 1 class:lay-row wrap-wrap ac-center\nt 2 name\ne 2 field:text;disabled:true\nt 3 ada\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row ac-center w-r1 h-r1 shrink-0 am-start;checked:false;disabled:true\nt 2 done",
    );
    assert.containsText(
        render(ctx, tree).markup(),
        "e 0 \ne 1 disabled:true\nt 2 save\ne 1 class:lay-row wrap-wrap ac-center\nt 2 name\ne 2 field:text;disabled:true\nt 3 ada\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row ac-center w-r1 h-r1 shrink-0 am-start;checked:false;disabled:true\nt 2 done",
    );
}

test "a disabled control refuses a press, a fill and a flip" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    // What a browser does with one: it is not dispatched to at all, so the
    // handler behind it cannot run and the signal behind it cannot move. A
    // handler that no-ops fixes neither the tab order nor what is announced,
    // which is why this is an attribute rather than a style.
    let pressed = signal(ctx, 0);
    let name = signal(ctx, "ada");
    let done = signal(ctx, false);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("save"),
                    styles: [],
                    onPress: .Some(fn(c) => { pressed.update(c, fn(n) => n + 1) }),
                    isDisabled: .Some(.Const(true)),
                }),
                ui.field({
                    label: .Const("name"),
                    kind: .Text,
                    value: name,
                    styles: [],
                    isDisabled: .Some(.Const(true)),
                }),
                ui.toggle({
                    label: .Const("done"),
                    kind: .Checkbox,
                    isOn: done,
                    styles: [],
                    isDisabled: .Some(.Const(true)),
                }),
            ],
        }),
    );
    let _ = page.press("save");
    let _ = page.fill("name", "grace");
    let _ = page.flip("done");
    assert.equal(pressed.get(ctx), 0);
    assert.equal(name.get(ctx), "ada");
    assert.isFalse(done.get(ctx));
}

test "whether a control refuses input may vary" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let busy = signal(ctx, true);
    let pressed = signal(ctx, 0);
    let page = render(
        ctx,
        ui.button({
            label: .Const("save"),
            styles: [],
            onPress: .Some(fn(c) => { pressed.update(c, fn(n) => n + 1) }),
            isDisabled: .Some(.Cell(busy)),
        }),
    );
    assert.containsText(page.markup(), "disabled");
    let _ = page.press("save");
    assert.equal(pressed.get(ctx), 0);
    let _ = busy.set(ctx, false);
    assert.isFalse(page.markup().contains("disabled"));
    let _ = page.press("save");
    assert.equal(pressed.get(ctx), 1);
}

test "On(.Disabled) fires from the control's own flag, in every state" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // The flag adds the state and never takes one away: a control whose flag is
    // set is unavailable whatever the snapshot was taken in, and a control
    // whose flag is clear is still what a `.Disabled` snapshot is asking about.
    let dim: [Style] = [.On(.Disabled, [.Opacity(0.5)])];
    let refusing = rooted(
        ctx,
        ui.button({
            label: .Const("save"),
            styles: dim,
            onPress: .Some(fn(_c) => ()),
            isDisabled: .Some(.Const(true)),
        }),
    );
    let pressable = rooted(
        ctx,
        ui.button({ label: .Const("save"), styles: dim, onPress: .Some(fn(_c) => ()) }),
    );
    assert.equal(
        ui.describe(ctx, refusing, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:disabled_op-0_5;disabled:true\nt 1 save",
    );
    assert.equal(
        ui.describe(ctx, pressable, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 \nt 1 save",
    );
    // The snapshot still reaches a control that holds no such flag, which is
    // the question `.Disabled` was always asking.
    assert.equal(
        ui.describe(ctx, pressable, .Disabled),
        "buri-scene 1\nviewport 800 fit\ne 0 class:disabled_op-0_5\nt 1 save",
    );
}

test "a toggle's own value decides its checked styles" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // buri#119: `describe` read `On(.Checked, ...)` off the snapshot's state, so
    // a page could not hold one toggle that is on and one that is off. A
    // browser decides `:checked` from the control's own property, which is the
    // signal the toggle is bound to — the same signal the mark is drawn from.
    let on: [Style] = [.On(.Checked, [.Background(.Rgb(40, 150, 60))])];
    let off = signal(ctx, false);
    let lit = signal(ctx, true);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Layout(.Column), .Group([])],
            children: [
                ui.toggle({
                    label: .Const("off"),
                    kind: .Switch,
                    isOn: off,
                    styles: on,
                }),
                ui.toggle({
                    label: .Const("on"),
                    kind: .Switch,
                    isOn: lit,
                    styles: on,
                }),
            ],
        }),
    );
    let hovered = ui.describe(ctx, tree, .Hover);
    assert.containsText(hovered, "checked:false");
    assert.containsText(hovered, "checked_bg-28963c;checked:true");
    // Exactly one of the two boxes is lit, in a state that names neither.
    assert.equal(hovered.split(ctx, "checked_bg-28963c").length(), 2);
    // The same two under a `.Checked` snapshot: the answer is still the
    // control's, so the one bound to `false` stays as it was.
    assert.equal(ui.describe(ctx, tree, .Checked), hovered);
}

test "the snapshot's Checked reaches what holds no answer of its own" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // Nothing but a toggle answers for `:checked`, so a box carrying
    // `On(.Checked, ...)` is still the snapshot's to decide.
    let box = rooted(
        ctx,
        ui.stack({ styles: [.On(.Checked, [.Opacity(0.25)])], children: [] }),
    );
    assert.equal(
        ui.describe(ctx, box, .Checked),
        "buri-scene 1\nviewport 800 fit\ne 0 class:checked_op-0_25",
    );
    assert.equal(ui.describe(ctx, box, .Hover), "buri-scene 1\nviewport 800 fit\ne 0 ");
}

test "a checked toggle answers the pointer's states as well as its own" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // A hovered, checked box matches both rules in a browser, and `State` being
    // one value is the snapshot's limitation rather than the element's.
    let both: [Style] = [
        .On(.Hover, [.Opacity(0.5)]),
        .On(.Checked, [.Background(.Rgb(40, 150, 60))]),
    ];
    let lit = signal(ctx, true);
    let scene = ui.describe(
        ctx,
        ui.toggle({
            label: .Const("on"),
            kind: .Switch,
            isOn: lit,
            styles: both,
            isDisabled: .Some(.Const(true)),
        }),
        .Hover,
    );
    assert.containsText(scene, "hover_op-0_5");
    assert.containsText(scene, "checked_bg-28963c");
    assert.containsText(scene, "checked:true");
    assert.containsText(scene, "disabled:true");
}

test "a field's kind is in the scene, and a password's value is never in it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let secret = signal(ctx, "hunter2");
    // `describe` used to drop the kind, so all six fields painted alike and a
    // snapshot of a password field held the secret as ordinary text. The kind
    // is the `type` the markup carries — `multiline` for the `textarea` that
    // has none — and it is what the painter masks a value on.
    assert.containsText(kindOf(ctx, .Text, secret), "field:text");
    assert.containsText(kindOf(ctx, .Multiline, secret), "field:multiline");
    assert.containsText(kindOf(ctx, .Password, secret), "field:password");
    assert.containsText(kindOf(ctx, .Email, secret), "field:email");
    assert.containsText(kindOf(ctx, .Number, secret), "field:number");
    assert.containsText(kindOf(ctx, .Search, secret), "field:search");
}

/// The scene document one field of a kind writes.
fn kindOf<C: Allocator>(ctx: C, kind: FieldKind, value: Signal<Str>): Str {
    ui.describe(
        ctx,
        ui.field({ label: .Const("secret"), kind: kind, value: value, styles: [] }),
        .Hover,
    )
}

test "a range field is a slider, and the browser drives it" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let volume = signal(ctx, 40.0);
    // The bounds are the kind's payload, so a slider cannot be built without
    // saying what it runs between — a reader is told that, and there is
    // nowhere else on `field` to put it. The one attribute buys the thumb, the
    // drag, the arrow and Home/End stepping, `role="slider"` and
    // `aria-valuenow`, `aria-valuemin` and `aria-valuemax`, none of which this
    // vocabulary could draw for itself.
    let page = render(
        ctx,
        ui.slider({
            label: .Const("Volume"),
            value: volume,
            min: 0.0,
            max: 100.0,
            styles: [],
            step: .Some(1.0),
        }),
    );
    assert.equal(
        page.markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Volume\ne 1 class:w-r12 h-r1 shrink-0;field:range;range:0.0 100.0 40.0",
    );
    // A slider binds a `Signal<Float>`: where the reader drags lands in the
    // signal, and the signal lands back on the input. Writing the signal is that
    // second direction, and the thumb the scene carries follows it.
    volume.set(ctx, 75.0);
    assert.equal(volume.get(ctx), 75.0);
    assert.containsText(page.markup(), "range:0.0 100.0 75.0");
}

test "a slider takes styles for the box around it, the way a field and a toggle do" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let volume = signal(ctx, 50.0);
    // `around` lands on the slider's `<label>` wrapper — the box a surrounding
    // stack lays out — so the words can sit above the track in a stretched
    // column, exactly as a labelled field's do. Without it the wrapper was the
    // widget's own `lay-row wrap-wrap ac-center` and nothing else.
    let tree = rooted(
        ctx,
        ui.slider({
            label: .Const("Volume"),
            value: volume,
            min: 0.0,
            max: 100.0,
            styles: [.Width(.Full), .Height(.Px(16))],
            around: .Some([.Layout(.Column), .AlignCross(.Stretch), .Grow(1), .Gap(.Px(8))]),
        }),
    );
    // The caller's arrangement beats the widget's default, the way a field's
    // `around` beats its wrapper's row.
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:wrap-wrap lay-col ac-stretch grow-1 gap-8\nt 1 Volume\ne 1 class:shrink-0 w-full h-16;field:range;range:0.0 100.0 50.0",
    );
    // The scene the painter reads carries the same wrapper.
    assert.containsText(
        ui.describe(ctx, tree, .Hover),
        "e 0 class:wrap-wrap lay-col ac-stretch grow-1 gap-8",
    );
    // A slider given no `around` keeps the widget's own default wrapper.
    assert.containsText(
        render(
            ctx,
            ui.slider({
                label: .Const("Bass"),
                value: signal(ctx, 20.0),
                min: 0.0,
                max: 100.0,
                styles: [],
            }),
        ).markup(),
        "e 0 class:lay-row wrap-wrap ac-center",
    );
}

test "fill on a slider writes a well-formed Float the signal can be compared against" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let watcher = context {
        Watch: observer(),
    };
    let volume = signal(ctx, 50.0);
    let rendered = render(
        ctx,
        ui.slider({ label: .Const("Volume"), value: volume, min: 0.0, max: 100.0, styles: [] }),
    );
    // `fill` types 80 into a slider over a `Signal<Float>`. What lands in the
    // signal has to be a `Float`: before this it was the raw `Str`, so `==` and
    // `Show` dispatched on the wrong tag — `80` was unequal to `80.0`.
    rendered.fill("Volume", "80");
    assert.equal(volume.get(watcher), 80.0);
    // And it shows with its point, the way every other `Float` does.
    assert.equal(str.format(ctx, "${volume.get(watcher)}"), "80.0");
    // The scene the painter reads carries the new value, whole.
    assert.containsText(rendered.markup(), "range:0.0 100.0 80.0");
    // A text field still takes what a reader types as the `Str` it is.
    let name = signal(ctx, "");
    let form = render(
        ctx,
        ui.field({ label: .Const("Name"), kind: .Text, value: name, styles: [] }),
    );
    form.fill("Name", "Ada");
    assert.equal(name.get(watcher), "Ada");
}

test "a range's bounds are in the scene, and its value is not a run of text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let volume = signal(ctx, 40.0);
    let inline = "class:lay-row wrap-wrap ac-center";
    let track = "class:w-r12 h-r1 shrink-0";
    // The painter places the thumb, so it is told the bounds and the value the
    // thumb sits at. It is not told the step: what an arrow key moves by is
    // never drawn, which is the rule that keeps `alt` out of a scene too. And
    // the value is a declaration rather than a `t` line, because a browser
    // draws a slider and never the number behind one.
    //
    // The size is in the scene for the reason the wrapper's arrangement is: the
    // sheet says it to a browser as a `:where(input[type=range])` rule, and the
    // painter reads only classes, so the vocabulary has to say it again.
    assert.equal(
        ui.describe(
            ctx,
            ui.slider({
                label: .Const("Volume"),
                value: volume,
                min: 0.0,
                max: 100.0,
                styles: [],
                step: .Some(1.0),
            }),
            .Hover,
        ),
        str.format(
            ctx,
            "buri-scene 1\nviewport 800 fit\ne 0 ${inline}\nt 1 Volume\ne 1 ${track};field:range;range:0.0 100.0 40.0",
        ),
    );
    // The bounds are the ones the program wrote, whatever they are, and a
    // value outside them is carried as written — clamping is the painter's and
    // the browser's, not the scene's.
    assert.containsText(
        ui.describe(
            ctx,
            ui.slider({
                label: .Const("Fine"),
                value: signal(ctx, 9.0),
                min: -1.5,
                max: 1.5,
                styles: [],
                step: .Some(0.25),
            }),
            .Hover,
        ),
        "field:range;range:-1.5 1.5 9.0",
    );
    // And the sheet carries the same size, weightless, so a `Width` class beats
    // it in a browser exactly as it beats it in the scene.
    assert.isTrue(
        stylesheet().contains(":where(input[type=range]){width:12rem;height:1rem;"),
    );
}

test "a range field's styles land on the input, and compose the way a control's do" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let volume = signal(ctx, 40.0);
    // Two edges naming different sides compose, the same edge is last-wins,
    // and a state and a position sit beside them — all on the input, which is
    // the thing a reader focuses and a browser disables.
    let styles: [Style] = [
        .PaddingEdge(.Start, .Px(8)),
        .PaddingEdge(.End, .Px(4)),
        .Width(.Px(120)),
        .Width(.Px(160)),
        .On(.Hover, [.Opacity(0.9)]),
        .Position(.Sticky),
    ];
    let tree = rooted(
        ctx,
        ui.slider({
            label: .Const("Volume"),
            value: volume,
            min: 0.0,
            max: 10.0,
            styles: styles,
            step: .Some(0.5),
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:lay-row wrap-wrap ac-center\nt 1 Volume\ne 1 class:h-r1 shrink-0 pe-start-8 pe-end-4 w-160 hover_op-0_9 pos-sticky;field:range;range:0.0 10.0 40.0",
    );
    assert.isTrue(stylesheet().contains(".hover_op-0_9:hover{opacity:0.9}"));
    // The caller's `Width` is last in the scene too, so the track's own twelve
    // lines lose to it the way the sheet's rule loses to the class — and the
    // height and the shrink it did not name are still the track's.
    assert.containsText(
        ui.describe(ctx, tree, .Hover),
        "class:h-r1 shrink-0 pe-start-8 pe-end-4 w-160 hover_op-0_9 pos-sticky;field:range;range:0.0 10.0 40.0",
    );
}

test "a control takes styles of its own, and they land on the control" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "ada");
    let done = signal(ctx, false);
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("go"),
                    styles: [.Padding(.Px(12)), .On(.Hover, [.Opacity(0.9)])],
                    onPress: .Some(fn(_c) => ()),
                }),
                ui.link({
                    dest: .Const("/prices"),
                    children: [],
                    styles: [.Foreground(.Rgb(9, 9, 9))],
                }),
                ui.field({
                    label: .Const("name"),
                    kind: .Text,
                    value: name,
                    styles: [.Radius(.Px(4))],
                }),
                ui.toggle({
                    label: .Const("done"),
                    kind: .Checkbox,
                    isOn: done,
                    styles: [.Width(.Px(20))],
                }),
            ],
        }),
    );
    // The classes are on the button, the anchor and the two inputs, never on a
    // wrapper. That is what makes a state work: a wrapper is not the thing that
    // is hovered, focused or disabled.
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:p-12 hover_op-0_9\nt 2 go\ne 1 class:fg-090909\ne 1 class:lay-row wrap-wrap ac-center\nt 2 name\ne 2 class:r-4;field:text\nt 3 ada\ne 1 class:lay-row wrap-wrap ac-center\ne 2 class:lay-row ac-center h-r1 shrink-0 am-start w-20;checked:false\nt 2 done",
    );
    assert.isTrue(stylesheet().contains(".hover_op-0_9:hover{opacity:0.9}"));
}

test "the sheet drops the chrome a browser draws by itself" {
    // Otherwise a styled button paints twice: its own background inside the
    // browser's bevel. The reset is `:where(...)`, which weighs nothing in the
    // cascade, so every class beats it wherever the two meet.
    let sheet = stylesheet();
    // A heading's level is its outline position and nothing else, so the size,
    // the weight and the margins a browser paints on one go too. The margin is
    // the half no ancestor could reach: it is not inherited, and the scene
    // document the headless painter reads has no counterpart for one.
    assert.isTrue(
        sheet.contains(
            ":where(h1,h2,h3,h4,h5,h6){font-size:inherit;font-weight:inherit;margin:0}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ":where(button){appearance:none;background:none;border:0;padding:0;font:inherit;color:inherit}",
        ),
    );
    assert.isTrue(sheet.contains(":where(a){color:inherit;text-decoration:none}"));
    // A checkbox has a reset of its own, because it is the one control that
    // draws a mark: `appearance:none` erases a browser's tick, and the rules
    // beside it put back one this vocabulary can paint.
    assert.isTrue(
        sheet.contains(
            ":where(input:not([type=checkbox]),textarea){appearance:none;background:none;border:0;padding:0;font:inherit;color:inherit}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ":where(input[type=checkbox]){appearance:none;background:none;border:0;padding:0;font:inherit;color:inherit;display:flex;flex-direction:row;align-items:center;justify-content:flex-start;width:1rem;height:1rem;flex-shrink:0}",
        ),
    );
    // A range is the other control that draws itself. The line above already
    // took a browser's slider away, so these put back one this vocabulary can
    // paint: a bar across the middle of the track, and a round thumb the
    // browser slides along it. Both are `currentColor`, so `Foreground` is the
    // one property that paints a slider.
    assert.isTrue(
        sheet.contains(
            ":where(input[type=range]){width:12rem;height:1rem;flex-shrink:0;background-image:linear-gradient(currentColor,currentColor);background-size:100% 25%;background-repeat:no-repeat;background-position:center}",
        ),
    );
    // Two rules and not one selector list: an unknown pseudo-element throws
    // the whole selector away, so a browser that knows only one has to meet it
    // on its own.
    assert.isTrue(
        sheet.contains(
            ":where(input[type=range])::-webkit-slider-thumb{appearance:none;-webkit-appearance:none;width:1rem;height:1rem;border-radius:9999px;background-color:currentColor}",
        ),
    );
    assert.isTrue(
        sheet.contains(
            ":where(input[type=range])::-moz-range-thumb{border:0;appearance:none;-webkit-appearance:none;width:1rem;height:1rem;border-radius:9999px;background-color:currentColor}",
        ),
    );
    // The document itself. A browser's own sheet puts eight pixels around
    // `<body>`, and `mount` renders into `<body>`, so without this every page
    // floats in a band of the browser's white on every route. Nothing in
    // `ui/style` can reach it: this vocabulary has no margin, and a margin is
    // not inherited, so no ancestor's style touches one.
    assert.isTrue(sheet.contains(":where(body){margin:0}"));
    // It opens the sheet, ahead of every class in it.
    let reset = assert.some(sheet.indexOf(":where(h1,"));
    let padding = assert.some(sheet.indexOf(".p-12{"));
    assert.isTrue(reset < padding);
}

test "a size is the whole box, so padding and a border sit inside it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // `.Width(.Full)` of a 200-pixel parent, with the padding and the border
    // inside the 200. CSS's own initial `content-box` would make this 234 and
    // hang 34 pixels of it out of the parent; the headless painter has always
    // measured the border box, and this is the declaration that makes the two
    // agree.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Width(.Px(200))],
            children: [
                ui.stack({
                    styles: [.Width(.Full), .Padding(.Px(16)), .BorderWidth(.Px(1))],
                    children: [ui.text({ content: .Const("inside") })],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:w-200\ne 1 class:w-full p-16 bw-1\nt 2 inside",
    );

    let sheet = stylesheet();
    assert.startsWith(sheet, "*,*::before,*::after{box-sizing:border-box}\n");
    // Ahead of the element resets as well as of every class, because it is the
    // box model the rest of the sheet is written against.
    let box = assert.some(sheet.indexOf("box-sizing"));
    let chrome = assert.some(sheet.indexOf(":where("));
    assert.isTrue(box < chrome);
    assert.isTrue(sheet.contains(".w-full{width:100%}"));
    assert.isTrue(sheet.contains(".p-16{padding:16px}"));
}

test "the reset breaks a word too long for its box the way the painter does" {
    let ctx = context {
        Ui: headless(),
    };
    // buri#79: the headless painter breaks a word wider than its box mid-word,
    // where CSS's own initial `overflow-wrap: normal` lets it overflow. The
    // reset says `overflow-wrap: break-word` once for every element, so a
    // browser breaks the same word the same way — `break-word` rather than
    // `anywhere` because the min-content width stays the longest word, which is
    // what the painter measures.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Width(.Px(180))],
            children: [ui.text({ content: .Const("x") })],
        }),
    );
    let _ = render(ctx, tree);
    let sheet = stylesheet();
    assert.isTrue(sheet.contains("*{overflow-wrap:break-word}"));
    // It sits with the box model, ahead of the element resets and the classes.
    let wrap = assert.some(sheet.indexOf("overflow-wrap"));
    let chrome = assert.some(sheet.indexOf(":where("));
    assert.isTrue(wrap < chrome);
}

test "a list has no marker until one is asked for" {
    let ctx = context {
        Ui: headless(),
    };
    // A navigation rail, written the accessible way. The role is what a reader
    // is told; the browser's disc and its forty-pixel indent are styling
    // nobody asked for, so the sheet drops both.
    let rail = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [],
                    children: [
                        ui.link({
                            dest: .Const("/a"),
                            children: [ui.text({ content: .Const("Alpha") })],
                            styles: [],
                        }),
                    ],
                    role: .Some(.ListItem),
                }),
            ],
            role: .Some(.List),
        }),
    );
    assert.equal(render(ctx, rail).markup(), "e 0 \ne 1 \ne 2 \nt 3 Alpha");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(":where(ul,ol){margin:0;padding:0;list-style:none}"));

    // And back again for a list that wants them, with room for them to hang
    // in. The class beats the reset, which is why the reset opens the sheet.
    let numbered = rooted(
        ctx,
        ui.stack({
            styles: [.PaddingEdge(.Start, .Px(24)), .ListMarker(.Decimal)],
            children: [
                ui.stack({
                    styles: [],
                    children: [ui.text({ content: .Const("first") })],
                    role: .Some(.ListItem),
                }),
            ],
            role: .Some(.List),
        }),
    );
    assert.equal(
        render(ctx, numbered).markup(),
        "e 0 class:pe-start-24 lm-decimal\ne 1 \nt 2 first",
    );
    assert.isTrue(sheet.contains(".lm-decimal{list-style-type:decimal}"));
    let reset = assert.some(sheet.indexOf(":where(ul,ol)"));
    let marker = assert.some(sheet.indexOf(".lm-decimal{"));
    assert.isTrue(reset < marker);
}

test "a toggle's own styles paint, because the reset takes the native control away" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let on = signal(ctx, true);
    // Basecoat's switch, as close as `toggle` gets. While the reset exempted a
    // checkbox from `appearance:none` a browser painted its own 16x16 square
    // over all of this: the radius was discarded outright and the background
    // was computed and never painted.
    let styles: [Style] = [
        .Width(.Px(32)),
        .Height(.Px(18)),
        .Radius(.Px(9999)),
        .Background(.Rgb(220, 220, 220)),
        .On(.Checked, [.Background(.Rgb(20, 20, 20))]),
    ];
    assert.equal(
        render(
            ctx,
            ui.toggle({
                label: .Const("Email me"),
                kind: .Switch,
                isOn: on,
                styles: styles,
            }),
        ).markup(),
        "e 0 class:lay-row wrap-wrap ac-center\ne 1 class:lay-row ac-center shrink-0 am-end w-32 h-18 r-9999 bg-dcdcdc checked_bg-141414;checked:true\ne 2 mark:thumb;height:100%;aspect-ratio:1\nt 1 Email me",
    );

    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".r-9999{border-radius:9999px}"));
    assert.isTrue(
        sheet.contains(".checked_bg-141414:checked{background-color:rgb(20,20,20)}"),
    );
    // The reset reaches the control, so nothing the program asked for is
    // painted over.
    assert.isTrue(sheet.contains(":where(input[type=checkbox]){appearance:none;"));

    // And the same styles are on the control's line of the scene document, one
    // level under the label that wraps it.
    assert.containsText(
        ui.describe(
            ctx,
            ui.toggle({
                label: .Const("Email me"),
                kind: .Switch,
                isOn: on,
                styles: styles,
            }),
            .Checked,
        ),
        "am-end w-32 h-18 r-9999 bg-dcdcdc checked_bg-141414",
    );
}

test "a container with no layout is the column the default promises" {
    let ctx = context {
        Ui: headless(),
    };
    // `Layout`'s doc says a container with no `Layout` stacks its children
    // downwards, and the headless painter has laid one out that way all along.
    // As CSS's `display:block` the alignments below would be computed and do
    // nothing, and the text would sit in the top-left corner of the box.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [
                .Width(.Px(40)),
                .Height(.Px(40)),
                .AlignMain(.Center),
                .AlignCross(.Center),
            ],
            children: [ui.text({ content: .Const("ok") })],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:w-40 h-40 am-center ac-center\nt 1 ok",
    );

    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ":where(div,nav,main,header,footer,aside,article,search,ul,li,hr,form,a,button){display:flex;flex-direction:column}",
        ),
    );
    // The four table elements are left out. A browser lays a table out itself,
    // and that is what the scene document mirrors for them.
    assert.isFalse(sheet.contains(",table,"));
    assert.isFalse(sheet.contains(",td)"));
    // It weighs nothing, so `row` still runs along the axis.
    let flow = assert.some(sheet.indexOf("flex-direction:column}\n"));
    let row = assert.some(sheet.indexOf(".lay-row{"));
    assert.isTrue(flow < row);
}

test "a designed focus ring replaces the platform's rather than joining it" {
    let ctx = context {
        Ui: headless(),
    };
    // A browser paints its own `outline` over whatever a program put on the
    // focused element, and `ui/style` has no `Outline` to turn one off with —
    // so without this the button below wears a grey band with Chrome's blue
    // rectangle around it.
    let ringed = rooted(
        ctx,
        ui.button({
            label: .Const("focus me"),
            styles: [.On(.Focus, [.BorderWidth(.Px(3))])],
            onPress: .Some(fn(_c) => ()),
        }),
    );
    assert.equal(render(ctx, ringed).markup(), "e 0 \nt 1 focus me");

    // A fade is not a ring: it is drawn *beside* the platform's, so the
    // platform's stays. So does a ring that only applies from a breakpoint
    // upwards, because there is a width at which it paints nothing.
    let faded = rooted(
        ctx,
        ui.button({
            label: .Const("dim"),
            styles: [.On(.Focus, [.Opacity(0.7)])],
            onPress: .Some(fn(_c) => ()),
        }),
    );
    let wide = rooted(
        ctx,
        ui.button({
            label: .Const("wide"),
            styles: [.At(.Small, [.On(.Focus, [.BorderWidth(.Px(2))])])],
            onPress: .Some(fn(_c) => ()),
        }),
    );
    assert.equal(render(ctx, faded).markup(), "e 0 \nt 1 dim");
    assert.equal(render(ctx, wide).markup(), "e 0 \nt 1 wide");

    // The suppression opens the sheet, so a class named in it is read before
    // the rule that draws it and a class left out of it is read after.
    let sheet = stylesheet();
    let outline = assert.some(sheet.indexOf("{outline:none}"));
    assert.isTrue(assert.some(sheet.indexOf(".focus_bw-3")) < outline);
    assert.isTrue(assert.some(sheet.indexOf(".focus_op-0_7")) > outline);
    assert.isTrue(assert.some(sheet.indexOf(".sm_focus_bw-2")) > outline);
    assert.isTrue(sheet.contains(":focus-visible{outline:none}"));
}

test "a separator is a rule the caller paints, and a picture is its own block" {
    let ctx = context {
        Ui: headless(),
    };
    // A browser's `<hr>` is a 1px `inset` border on all four edges, so a
    // hairline asked for one pixel paints three in two tones, and its automatic
    // inline margin shrinks it inside a column. A picture and an inlined
    // `<svg>` are the two leaves a browser leaves inline, so each hangs on the
    // text baseline beside whatever was written before it.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.stack({
                    styles: [.Height(.Px(1)), .Background(.Rgb(229, 229, 229))],
                    children: [],
                    role: .Some(.Separator),
                }),
                ui.image({
                    source: .Const("/logo.png"),
                    alt: .AccessibilityText(""),
                    styles: [],
                }),
            ],
        }),
    );
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 \ne 1 class:h-1 bg-e5e5e5\ne 1 image:/logo.png",
    );

    // An icon is artwork inlined as an `<svg>`, which a browser leaves inline
    // for the same reason, so the one rule names both elements.
    // The artwork is inlined wherever the icon sits, so the declaration is found
    // at its own depth: the `icon:` line the reset leaves inline.
    assert.containsText(
        render(ctx, ui.stack({ styles: [], children: [check([])] })).markup(),
        "icon:<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M20 6 9 17l-5-5'/></svg>",
    );

    let sheet = stylesheet();
    assert.isTrue(sheet.contains(":where(hr){border:0;margin:0}"));
    assert.isTrue(sheet.contains(":where(img,svg){display:block}"));
    // Both weigh nothing, so the caller's own hairline is the whole of what is
    // painted.
    let reset = assert.some(sheet.indexOf(":where(hr)"));
    let height = assert.some(sheet.indexOf(".h-1{"));
    assert.isTrue(reset < height);
}

test "a table collapses its borders, so a per-column hairline is one line across the row" {
    let ctx = context {
        Ui: headless(),
    };
    // A table ruled the way a design system rules one — a 1px top border on
    // each box — reads as a continuous line across the row in the painter's
    // picture. In a browser the UA default `border-collapse: separate` with a
    // 2px `border-spacing` would break that line at every column boundary, so
    // the reset collapses the borders and the two renderers draw one rule.
    let ruled: [Style] = [
        .Padding(.Px(8)),
        .BorderEdge(.Top, .Px(1)),
        .BorderColor(.Rgb(228, 228, 228)),
    ];
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Width(.Full)],
            children: [
                ui.stack({
                    styles: [],
                    children: [
                        ui.stack({
                            styles: ruled,
                            children: [ui.text({ content: .Const("Invoice") })],
                            role: .Some(.ColumnHeader),
                        }),
                        ui.stack({
                            styles: ruled,
                            children: [ui.text({ content: .Const("$250.00") })],
                            role: .Some(.Cell),
                        }),
                    ],
                    role: .Some(.TableRow),
                }),
            ],
            role: .Some(.Table),
        }),
    );
    // The row is a grid of even columns and each box carries the caller's own
    // top hairline, painted as one line across the row by both renderers.
    assert.equal(
        render(ctx, tree).markup(),
        "e 0 class:w-full\ne 1 display:grid;grid-template-columns:1fr 1fr\ne 2 class:fw-bold ta-center p-8 be-top-1 bc-e4e4e4\nt 3 Invoice\ne 2 class:p-8 be-top-1 bc-e4e4e4\nt 3 $250.00",
    );

    // The collapse is emitted because a `Table` role is in the tree — nothing
    // else puts a `:where(table)` rule in the sheet — and it is a `:where(...)`
    // rule, so it weighs nothing against a class.
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(":where(table){border-collapse:collapse}"));
}

test "a form is submitted, which is behaviour and so not a role" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let draft = signal(ctx, "");
    let added = signal(ctx, "");
    let page = render(
        ctx,
        ui.form({
            onSubmit: fn(c) => added.set(c, draft.get(c)),
            children: [
                ui.field({
                    label: .Const("what"),
                    kind: .Text,
                    value: draft,
                    styles: [],
                }),
            ],
            styles: [],
        }),
    );
    let _ = page.fill("what", "milk");
    let _ = page.submit(0);
    assert.equal(added.get(ctx), "milk");
}

test "a form of two fields is submitted through the button that is its action" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "");
    let email = signal(ctx, "");
    let sent = signal(ctx, "");
    let page = render(
        ctx,
        ui.form({
            onSubmit: fn(c) => sent.set(c, "sent"),
            children: [
                ui.field({
                    label: .Const("Name"),
                    kind: .Text,
                    value: name,
                    styles: [],
                }),
                ui.field({
                    label: .Const("Email"),
                    kind: .Email,
                    value: email,
                    styles: [],
                }),
                ui.button({ label: .Const("Send"), styles: [], kind: .Some(.Submit) }),
            ],
            styles: [],
        }),
    );
    // One button, and it is the form's action. That attribute is the whole of
    // what makes Enter work: a browser submits a form implicitly through its
    // submit button, and a form of two fields with none discards the keypress.
    assert.equal(page.count("button"), 1);
    // That the one button is the form's action — its `type="submit"` — is an
    // HTML attribute the scene does not carry; `ui/web`'s document pins it. The
    // behaviour is the claim here: submitting runs the form's handler.
    let _ = page.submit(0);
    assert.equal(sent.get(ctx), "sent");
}

test "a submit button pressed submits the form it is in" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let typed = signal(ctx, "");
    let sent = signal(ctx, "");
    let page = render(
        ctx,
        ui.form({
            onSubmit: fn(c) => sent.set(c, typed.get(c)),
            children: [
                ui.field({
                    label: .Const("Name"),
                    kind: .Text,
                    value: typed,
                    styles: [],
                }),
                ui.button({ label: .Const("Send"), styles: [], kind: .Some(.Submit) }),
            ],
            styles: [],
        }),
    );
    let _ = page.fill("Name", "Ada");
    // No handler of its own: submitting is the form's, and pressing the button
    // is the browser's own way of asking for it.
    let _ = page.press("Send");
    assert.equal(sent.get(ctx), "Ada");
}

test "a disabled submit button carries the flag, and neither a press nor Enter submits" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let sent = signal(ctx, false);
    let page = render(
        ctx,
        ui.form({
            onSubmit: fn(c) => sent.set(c, true),
            children: [
                ui.field({ label: .Const("Name"), kind: .Text, value: signal(ctx, ""), styles: [] }),
                ui.field({ label: .Const("Email"), kind: .Email, value: signal(ctx, ""), styles: [] }),
                ui.button({
                    label: .Const("Save"),
                    styles: [],
                    kind: .Some(.Submit),
                    isDisabled: .Some(.Const(true)),
                }),
            ],
            styles: [],
        }),
    );
    // The scene carries the flag now — `isDisabled` reaches a `.Submit` the way
    // it reaches an ordinary button, so the markup says `disabled:true`.
    assert.containsText(page.markup(), "disabled:true");
    // A press on a disabled submit does nothing: it is not dispatched to, so
    // the form's `onSubmit` never runs.
    let _ = page.press("Save");
    assert.isFalse(sent.get(ctx));
    // Nor does Enter: a disabled submit is not a submit control, and with two
    // fields there is no single-field implicit submission to fall back on, so
    // the form whose only action is disabled discards the keypress.
    let _ = page.submit(0);
    assert.isFalse(sent.get(ctx));
}

test "a submit button's disabled is reactive: clearing it lets the form submit" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let busy = signal(ctx, true);
    let sent = signal(ctx, false);
    let page = render(
        ctx,
        ui.form({
            onSubmit: fn(c) => sent.set(c, true),
            children: [
                ui.field({ label: .Const("Name"), kind: .Text, value: signal(ctx, ""), styles: [] }),
                ui.button({
                    label: .Const("Save"),
                    styles: [],
                    kind: .Some(.Submit),
                    isDisabled: .Some(.Cell(busy)),
                }),
            ],
            styles: [],
        }),
    );
    // Disabled while busy: pressing does nothing.
    let _ = page.press("Save");
    assert.isFalse(sent.get(ctx));
    // Clearing the signal re-enables it in place, and now the press submits.
    busy.set(ctx, false);
    assert.isFalse(page.markup().contains("disabled:true"));
    let _ = page.press("Save");
    assert.isTrue(sent.get(ctx));
}

test "a form of two fields with no submit button is not submitted at all" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "");
    let email = signal(ctx, "");
    let sent = signal(ctx, "");
    let page = render(
        ctx,
        ui.form({
            onSubmit: fn(c) => sent.set(c, "sent"),
            children: [
                ui.field({
                    label: .Const("Name"),
                    kind: .Text,
                    value: name,
                    styles: [],
                }),
                ui.field({
                    label: .Const("Email"),
                    kind: .Email,
                    value: email,
                    styles: [],
                }),
                ui.button({
                    label: .Const("Send"),
                    styles: [],
                    onPress: .Some(fn(_c) => ()),
                }),
            ],
            styles: [],
        }),
    );
    // An ordinary button is not a form's action, so this is the markup a
    // browser refuses to submit from the keyboard — and the double refuses it
    // too, because a double more permissive than the platform is a suite that
    // cannot catch a form nobody can send.
    // An ordinary button is not a form's action — `type="button"`, an HTML
    // attribute the scene does not carry (`ui/web`'s document pins it). The
    // behaviour is the claim: a form with no action discards the keypress.
    let _ = page.submit(0);
    assert.equal(sent.get(ctx), "");
}

// --- a dialog ------------------------------------------------------------------------

test "a dialog is a panel its signal opens and shuts" {
    let ctx = context {
        Ui: headless(),
    };
    let open = signal(ctx, true);
    let panel = rooted(
        ctx,
        ui.dialog({
            isOpen: open,
            label: .Const("Delete this?"),
            children: [ui.text({ content: .Const("Are you sure?") })],
            styles: [],
        }),
    );
    let page = render(ctx, panel);
    // A `<dialog>`, because the three things a modal needs from the platform —
    // the scroll lock, the inertness of what is behind, and the focus trap —
    // are the browser's own and no style says any of them. The label is the
    // accessible name, the rule a button's label follows.
    assert.equal(
        page.markup(),
        "e 0 class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0 lay-row am-center ac-center bg-000000a0_5\ne 1 \nt 2 Are you sure?",
    );
    // Shut, a browser draws none of a dialog, so the scene holds none: the
    // panel is gone rather than merely flagged, which is the whole of what frees
    // the page behind it.
    open.set(ctx, false);
    assert.equal(page.markup(), "");
    assert.equal(page.count("dialog"), 0);
    open.set(ctx, true);
    // Open again is the same markup, built afresh — a shut dialog is nothing in
    // the scene, not a hidden element, so there is nothing to keep across it.
    assert.equal(
        page.markup(),
        "e 0 class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0 lay-row am-center ac-center bg-000000a0_5\ne 1 \nt 2 Are you sure?",
    );
    assert.equal(page.count("dialog"), 1);
}

test "a dialog's styles land on the panel" {
    let ctx = context {
        Ui: headless(),
    };
    let open = signal(ctx, true);
    assert.equal(
        render(
            ctx,
            ui.dialog({
                isOpen: open,
                label: .Const("Settings"),
                children: [],
                styles: [.Padding(.Px(8)), .Radius(.Px(4))],
            }),
        ).markup(),
        "e 0 class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0 lay-row am-center ac-center bg-000000a0_5\ne 1 class:p-8 r-4",
    );
    // The panel's look is the styles', so the reset drops the bordered, padded
    // white card a browser draws a `<dialog>` as — and keeps the half no style
    // can say: the fixed position, the automatic margins that centre it, and
    // the `::backdrop` the widget paints its scrim with.
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(
            ":where(dialog){border:0;padding:0;background:none;color:inherit;max-width:none;max-height:none}",
        ),
    );
    // Open, it is a container like every other one; shut, it keeps a browser's
    // own `display:none`, which is why the rule hangs off `[open]`.
    assert.isTrue(
        sheet.contains(":where(dialog[open]){display:flex;flex-direction:column}"),
    );
    assert.isTrue(
        sheet.contains(":where(dialog)::backdrop{background-color:rgba(0,0,0,0.5)}"),
    );
}

test "a dialog's label may vary, and the panel follows it" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, true);
    let named = signal(ctx, "first");
    let page = render(
        ctx,
        ui.dialog({ isOpen: open, label: .Cell(named), children: [], styles: [] }),
    );
    assert.equal(
        page.markup(),
        "e 0 class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0 lay-row am-center ac-center bg-000000a0_5\ne 1 ",
    );
    named.set(ctx, "second");
    assert.equal(
        page.markup(),
        "e 0 class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0 lay-row am-center ac-center bg-000000a0_5\ne 1 ",
    );
}

test "an open dialog takes the rest of the page out of reach" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, true);
    let pressed = signal(ctx, "");
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("behind"),
                    styles: [],
                    onPress: .Some(fn(c) => pressed.set(c, "behind")),
                }),
                ui.dialog({
                    isOpen: open,
                    label: .Const("Confirm"),
                    children: [
                        ui.button({
                            label: .Const("inside"),
                            styles: [],
                            onPress: .Some(fn(c) => pressed.set(c, "inside")),
                        }),
                    ],
                    styles: [],
                }),
            ],
        }),
    );
    // What is behind an open modal is inert — a browser's top layer takes the
    // pointer, the keyboard and the announcement away from it — so the press
    // reaches nothing, the way it reaches nothing through a `Passthrough`.
    let _ = page.press("behind");
    assert.equal(pressed.get(ctx), "");
    let _ = page.press("inside");
    assert.equal(pressed.get(ctx), "inside");
    // And the other way round once it is shut: a shut dialog is nothing in the
    // scene, so its own control is gone and the page behind it is reachable
    // again — the press that was swallowed now lands.
    open.set(ctx, false);
    assert.equal(page.count("button"), 1);
    let _ = page.press("behind");
    assert.equal(pressed.get(ctx), "behind");
}

test "an open dialog refuses a fill, a flip and a submit behind it" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, true);
    let typed = signal(ctx, "");
    let ticked = signal(ctx, false);
    let sent = signal(ctx, 0);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.form({
                    onSubmit: fn(c) => sent.set(c, sent.get(c) + 1),
                    children: [
                        ui.field({
                            label: .Const("what"),
                            kind: .Text,
                            value: typed,
                            styles: [],
                        }),
                        ui.toggle({
                            label: .Const("done"),
                            kind: .Checkbox,
                            isOn: ticked,
                            styles: [],
                        }),
                    ],
                    styles: [],
                }),
                ui.dialog({
                    isOpen: open,
                    label: .Const("Confirm"),
                    children: [],
                    styles: [],
                }),
            ],
        }),
    );
    let _ = page.fill("what", "milk");
    let _ = page.flip("done");
    let _ = page.submit(0);
    assert.equal(typed.get(ctx), "");
    assert.isFalse(ticked.get(ctx));
    assert.equal(sent.get(ctx), 0);
    open.set(ctx, false);
    let _ = page.fill("what", "milk");
    let _ = page.flip("done");
    let _ = page.submit(0);
    assert.equal(typed.get(ctx), "milk");
    assert.isTrue(ticked.get(ctx));
    assert.equal(sent.get(ctx), 1);
}

test "an open dialog is a scrim and a panel, and a shut one is nothing at all" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let open = signal(ctx, true);
    let shut = signal(ctx, false);
    // A shut dialog paints nothing — not an empty box, nothing — because that
    // is what a browser draws of one.
    assert.equal(
        ui.describe(
            ctx,
            ui.stack({
                styles: [],
                children: [
                    ui.dialog({
                        isOpen: shut,
                        label: .Const("x"),
                        children: [ui.text({ content: .Const("gone") })],
                        styles: [.Padding(.Px(8))],
                    }),
                ],
            }),
            .Hover,
        ),
        "buri-scene 1\nviewport 800 fit\ne 0 ",
    );
    // An open one is the two things a browser draws: the `::backdrop` over the
    // page, and the panel centred on it. The scrim is pinned to the viewport
    // and centres what it holds, which is the arrangement the painter has for
    // what a browser gives a modal for free.
    let scrim =
        "class:pos-viewport pin-out pin-top-0 pin-bottom-0 pin-start-0 pin-end-0 lay-row am-center ac-center bg-000000a0_5";
    assert.equal(
        ui.describe(
            ctx,
            ui.dialog({
                isOpen: open,
                label: .Const("x"),
                children: [ui.text({ content: .Const("here") })],
                styles: [.Padding(.Px(8))],
            }),
            .Hover,
        ),
        str.format(
            ctx,
            "buri-scene 1\nviewport 800 fit\ne 0 ${scrim}\ne 1 class:p-8\nt 2 here",
        ),
    );
}

// --- a button that expands something -------------------------------------------------

test "a button that expands something says so, and whether it is open" {
    let ctx = context {
        Ui: headless(),
    };
    let open = signal(ctx, false);
    let page = render(
        ctx,
        ui.button({
            label: .Const("Menu"),
            styles: [],
            onPress: .Some(fn(_c) => ()),
            isExpanded: .Some(.Cell(open)),
        }),
    );
    // Collapsed, it announces the same as any button, because `aria-expanded`
    // is written only when it is `true` — the way `aria-invalid` is, so an
    // ordinary button carries no markup it did not ask for.
    assert.equal(page.markup(), "e 0 \nt 1 Menu");
    open.set(ctx, true);
    // Open, the button says a region it controls is expanded, which is what a
    // reader is never told when the trigger is a plain button beside a `choose`.
    assert.equal(page.markup(), "e 0 \nt 1 Menu");
}

test "aria-expanded is announced and not painted, so the scene carries none of it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.button({
            label: .Const("Menu"),
            styles: [.Padding(.Px(4))],
            onPress: .Some(fn(_c) => ()),
            isExpanded: .Some(.Const(true)),
        }),
    );
    // What a reader hears is not what a painter draws: the scene is the button's
    // own styles and its label, the same lines an unexpanded button writes.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:p-4\nt 1 Menu",
    );
}

// --- a progress bar --------------------------------------------------------------------

test "a progress bar announces the role, the bounds and how far along it is" {
    let ctx = context {
        Ui: headless(),
    };
    // The fill is the caller's own child; the widget adds the role and the
    // three `aria-value*` a reader needs, which a pair of nested `stack`s never
    // told anyone.
    let tree = rooted(
        ctx,
        ui.progress({
            label: .Const("Loading"),
            value: .Some(.Const(0.66)),
            styles: [.Width(.Full)],
            children: .Some([
                ui.stack({ styles: [.Width(.Percent(40.0))], children: [] }),
            ]),
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:w-full\ne 1 class:w-pc40");
}

test "a progress bar follows its value when it changes" {
    let ctx = context {
        Ui: headless(),
    };
    let done = signal(ctx, 0.4);
    let page = render(
        ctx,
        ui.progress({ label: .Const("Upload"), value: .Some(.Cell(done)), styles: [] }),
    );
    assert.equal(page.markup(), "e 0 ");
    // The value a reader hears is `aria-valuenow`, an attribute the scene does
    // not carry, so a write to it changes nothing the scene shows — the bar's
    // own markup is its children. `ui/web`'s document pins the announced value.
    let _ = done.set(ctx, 0.9);
    assert.equal(page.markup(), "e 0 ");
}

test "a progress bar paints its children and announces the rest" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // The role and the values are what a reader hears, not what a painter draws,
    // so the scene is the bar's own styles and the fill child inside it — the
    // same picture the nested boxes drew before the announcement was added.
    let tree = rooted(
        ctx,
        ui.progress({
            label: .Const("Loading"),
            value: .Some(.Const(0.4)),
            styles: [.Width(.Full)],
            children: .Some([
                ui.stack({ styles: [.Width(.Percent(40.0))], children: [] }),
            ]),
        }),
    );
    let scene = ui.describe(ctx, tree, .Hover);
    assert.equal(
        scene,
        "buri-scene 1\nviewport 800 fit\ne 0 class:w-full\ne 1 class:w-pc40",
    );
    assert.isFalse(scene.contains("progressbar"));
    assert.isFalse(scene.contains("valuenow"));
}

// --- a disclosure ----------------------------------------------------------------------

test "a disclosure is a details its summary opens and shuts" {
    let ctx = context {
        Ui: headless(),
    };
    let open = signal(ctx, true);
    let tree = rooted(
        ctx,
        ui.disclosure({
            summary: .Const("Details"),
            isOpen: open,
            children: [ui.text({ content: .Const("body") })],
            styles: [],
        }),
    );
    let page = render(ctx, tree);
    // A `<details>` with a `<summary>`, because the open-and-shut state, the
    // Enter and Space that toggle it, and what a reader is told are all the
    // browser's own — where a button beside a `choose` announces nothing.
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 Details\nt 1 body");
    // Shut is the same element without the flag, so opening it again is not
    // rebuilding it: the summary is one element either way.
    open.set(ctx, false);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 Details");
    assert.equal(page.count("details"), 1);
    let identity = page.identity("details", 0);
    open.set(ctx, true);
    assert.equal(page.identity("details", 0), identity);
}

test "a disclosure's styles land on the details, and the scene hides what is shut" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let open = signal(ctx, true);
    let tree = rooted(
        ctx,
        ui.disclosure({
            summary: .Const("More"),
            isOpen: open,
            children: [ui.text({ content: .Const("hidden") })],
            styles: [.Padding(.Px(8))],
        }),
    );
    // Open: the summary is drawn, then the children, inside the details' own
    // box — the styles land on the `<details>`.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:p-8\ne 1 \nt 2 More\nt 1 hidden",
    );
    // Shut: a browser draws the summary alone, so the scene leaves the rest out.
    open.set(ctx, false);
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:p-8\ne 1 \nt 2 More",
    );
}

// --- an outside press ------------------------------------------------------------------

test "an outside-press wrapper is a bare div around its children" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // It adds no visible element beyond its own wrapper: the styles and the
    // children are a stack's, and the press it watches for is the document's,
    // which no markup carries.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [.Padding(.Px(8))],
            children: [ui.text({ content: .Const("panel") })],
            onPressOutside: .Some(fn(c) => {
            }),
        }),
    );
    assert.equal(render(ctx, tree).markup(), "e 0 class:p-8\nt 1 panel");
    // And a picture of it is a picture of its children — the same `e` line and
    // the same child a stack of the same styles writes.
    assert.equal(
        ui.describe(ctx, tree, .Hover),
        "buri-scene 1\nviewport 800 fit\ne 0 class:p-8\nt 1 panel",
    );
}

test "an unstyled outside-press wrapper is exactly a stack" {
    let ctx = context {
        Ui: headless(),
    };
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.text({ content: .Const("x") })],
            onPressOutside: .Some(fn(c) => {
            }),
        }),
    );
    // No styles is no class, the way a bare stack has none.
    assert.equal(render(ctx, tree).markup(), "e 0 \nt 1 x");
}

test "a press inside does not fire, a press outside does, and disposal takes the listener" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let fired = signal(ctx, 0);
    let open = signal(ctx, true);
    // A dismissable overlay: the wrapper watches for a press outside the panel,
    // and the panel holds a control of its own. An `outside` button stands in
    // for the rest of the page.
    let tree = rooted(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("outside"),
                    styles: [],
                    onPress: .Some(fn(c) => {
                    }),
                }),
                ui.choose(
                    .Cell(open),
                    ui.stack({
                        styles: [],
                        children: [
                            ui.button({
                                label: .Const("inside"),
                                styles: [],
                                onPress: .Some(fn(c) => {
                                }),
                            }),
                        ],
                        onPressOutside: .Some(fn(c) => fired.update(c, fn(n) => n + 1)),
                    }),
                    ui.empty(),
                ),
            ],
        }),
    );
    let page = render(ctx, tree);
    // A press inside the subtree is not a press outside it, so the reader's
    // press on the panel's own control does not dismiss it.
    let _ = page.press("inside");
    assert.equal(fired.get(ctx), 0);
    // A press anywhere else fires the handler once.
    let _ = page.press("outside");
    assert.equal(fired.get(ctx), 1);
    // Shutting the `choose` disposes the subtree, and the document listener goes
    // with it: a press outside now reaches nothing, so the handler stays put.
    open.set(ctx, false);
    let _ = page.press("outside");
    assert.equal(fired.get(ctx), 1);
}

// --- the page a scene is painted on ----------------------------------------------------

test "a scene is a page 800 across and as tall as what it holds" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // 800 across is a viewport width: `At(.Sm)` and every percentage resolve
    // against it, so it is stated and never read off the tree. Down is `fit`,
    // which is the painter being told to take the height the paint came to —
    // so a short tree is a short picture and a tall one is not cut off.
    assert.equal(
        ui.describe(
            ctx,
            ui.stack({ styles: [.Padding(.Px(4))], children: [] }),
            .Hover,
        ),
        "buri-scene 1\nviewport 800 fit\ne 0 class:p-4",
    );
}

test "a scene may be laid out at a width of its own" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let tree = rooted(ctx, ui.stack({ styles: [.Padding(.Px(4))], children: [] }));
    assert.equal(
        ui.describeWide(ctx, tree, .Hover, 390),
        "buri-scene 1\nviewport 390 fit\ne 0 class:p-4",
    );
    // The width is the only thing that moves: the same tree at the page's own
    // width is the same document.
    assert.equal(
        ui.describeWide(ctx, tree, .Hover, 800),
        ui.describe(ctx, tree, .Hover),
    );
}

// --- reactivity in the tree ----------------------------------------------------------

test "text follows the cell it was given" {
    let ctx = context {
        Ui: headless(),
    };
    let label = signal(ctx, "before");
    let page = render(ctx, ui.text({ content: .Cell(label) }));
    assert.equal(page.text(), "before");
    let _ = label.set(ctx, "after");
    assert.equal(page.text(), "after");
}

test "a constant leaf registers nothing and never changes" {
    let ctx = context {
        Ui: headless(),
    };
    let unrelated = signal(ctx, 0);
    let page = render(ctx, ui.text({ content: .Const("fixed") }));
    let _ = unrelated.set(ctx, 1);
    assert.equal(page.text(), "fixed");
}

test "choose shows one subtree or the other" {
    let ctx = context {
        Ui: headless(),
    };
    let signedIn = signal(ctx, false);
    let page = render(
        ctx,
        ui.choose(
            .Cell(signedIn),
            ui.text({ content: .Const("welcome") }),
            ui.text({ content: .Const("sign in") }),
        ),
    );
    assert.equal(page.text(), "sign in");
    let _ = signedIn.set(ctx, true);
    assert.equal(page.text(), "welcome");
    let _ = signedIn.set(ctx, false);
    assert.equal(page.text(), "sign in");
}

test "the subtree choose removed is disposed with it" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let showing = signal(ctx, true);
    let n = signal(ctx, 1);
    let page = render(
        ctx,
        ui.choose(
            .Cell(showing),
            ui.text({ content: .Computed(fn(c) => "${log.note(n.get(c))}") }),
            ui.empty(),
        ),
    );
    assert.equal(log.noted(), [1]);
    let _ = n.set(ctx, 2);
    assert.equal(log.noted(), [1, 2]);

    // The subtree is gone, so what it created is gone: writing what it read is
    // no longer a reason for anything to run.
    let _ = showing.set(ctx, false);
    let _ = n.set(ctx, 3);
    assert.equal(log.noted(), [1, 2]);
    assert.equal(page.text(), "");
}

test "computed rebuilds its subtree from whatever it read" {
    let ctx = context {
        Ui: headless(),
    };
    let count = signal(ctx, 0);
    let page = render(
        ctx,
        ui.computed(fn(c) => {
            ui.text({
                content: .Const("head"),
                headingLevel: .Some(if (count.get(c) > 1) { 2 } else { 1 }),
            })
        }),
    );
    assert.equal(page.count("h1"), 1);
    assert.equal(page.count("h2"), 0);
    let _ = count.set(ctx, 5);
    assert.equal(page.count("h1"), 0);
    assert.equal(page.count("h2"), 1);
}

test "a computed subtree is rebuilt, and a leaf prop is not" {
    let ctx = context {
        Ui: headless(),
    };
    let n = signal(ctx, 0);

    // The coarse instrument: the whole subtree is built again, so the element
    // is a different one.
    let coarse = render(ctx, ui.computed(fn(c) => headingFor(n.get(c))));
    let first = coarse.identity("h1", 0);
    let _ = n.set(ctx, 1);
    assert.notEqual(coarse.identity("h1", 0), first);

    // The fine one: the same element, with one run of text changed.
    let fine = render(
        ctx,
        ui.text({ content: .Computed(fn(c) => "${n.get(c)}"), headingLevel: .Some(1) }),
    );
    let kept = fine.identity("h1", 0);
    let _ = n.set(ctx, 2);
    assert.equal(fine.identity("h1", 0), kept);
    assert.equal(fine.text(), "2");
}

// --- keyed lists ---------------------------------------------------------------------

test "each renders one row per item" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "b", "c"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.each(.Cell(items), itself, labelRow)],
            role: .Some(.List),
        }),
    );
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 a\ne 1 \nt 2 b\ne 1 \nt 2 c");
    assert.equal(page.count("li"), 3);
}

test "an empty list renders no rows" {
    let ctx = context {
        Ui: headless(),
    };
    let items: Signal<[Str]> = signal(ctx, []);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.each(.Cell(items), itself, labelRow)],
            role: .Some(.List),
        }),
    );
    assert.equal(page.count("li"), 0);
    let _ = items.set(ctx, ["only"]);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 only");
}

test "inserting a row keeps the rows that were already there" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "c"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.each(.Cell(items), itself, labelRow)],
            role: .Some(.List),
        }),
    );
    let a = page.identity("li", 0);
    let c = page.identity("li", 1);

    let _ = items.set(ctx, ["a", "b", "c"]);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 a\ne 1 \nt 2 b\ne 1 \nt 2 c");
    assert.equal(page.identity("li", 0), a);
    assert.notEqual(page.identity("li", 1), a);
    assert.equal(page.identity("li", 2), c);
}

test "removing a row keeps the others" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "b", "c"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.each(.Cell(items), itself, labelRow)],
            role: .Some(.List),
        }),
    );
    let a = page.identity("li", 0);
    let c = page.identity("li", 2);

    let _ = items.set(ctx, ["a", "c"]);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 a\ne 1 \nt 2 c");
    assert.equal(page.identity("li", 0), a);
    assert.equal(page.identity("li", 1), c);
}

test "reordering moves the rows rather than rebuilding them" {
    let ctx = context {
        Ui: headless(),
    };
    let items = signal(ctx, ["a", "b", "c"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [ui.each(.Cell(items), itself, labelRow)],
            role: .Some(.List),
        }),
    );
    let a = page.identity("li", 0);
    let b = page.identity("li", 1);
    let c = page.identity("li", 2);

    let _ = items.set(ctx, ["c", "a", "b"]);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 c\ne 1 \nt 2 a\ne 1 \nt 2 b");
    // Keyed: the same three elements, in the new order. This is the assertion
    // the whole `key` parameter exists for — with rows keyed by position, all
    // three would have been rebuilt and every one of these would fail.
    assert.equal(page.identity("li", 0), c);
    assert.equal(page.identity("li", 1), a);
    assert.equal(page.identity("li", 2), b);
}

test "a row that leaves takes what it created with it" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let n = signal(ctx, 1);
    let items = signal(ctx, ["kept", "leaving"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.each(.Cell(items), itself, fn(c, item, index) => {
                    ui.stack({
                        styles: [],
                        children: [
                            ui.text({
                                content: .Computed(fn(s) => {
                                    "${item} ${log.note(n.get(s))}"
                                }),
                            }),
                        ],
                        role: .Some(.ListItem),
                    })
                }),
            ],
            role: .Some(.List),
        }),
    );
    assert.equal(log.noted(), [1, 1]);

    // Both rows read `n`, so both re-run.
    let _ = n.set(ctx, 2);
    assert.equal(log.noted(), [1, 1, 2, 2]);

    // One row leaves. What it created is disposed with it, so the next write
    // runs one computation rather than two.
    let _ = items.set(ctx, ["kept"]);
    let _ = n.set(ctx, 3);
    assert.equal(log.noted(), [1, 1, 2, 2, 3]);
    assert.equal(page.text(), "kept 3");
}

test "a row keeps its own reactive leaf across a reorder" {
    let ctx = context {
        Ui: headless(),
    };
    let suffix = signal(ctx, "!");
    let items = signal(ctx, ["a", "b"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.each(.Cell(items), itself, fn(c, item, index) => {
                    ui.stack({
                        styles: [],
                        children: [
                            ui.text({
                                content: .Computed(fn(s) => "${item}${suffix.get(s)}"),
                            }),
                        ],
                        role: .Some(.ListItem),
                    })
                }),
            ],
            role: .Some(.List),
        }),
    );
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 a!\ne 1 \nt 2 b!");
    let _ = items.set(ctx, ["b", "a"]);
    let _ = suffix.set(ctx, "?");
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 b?\ne 1 \nt 2 a?");
}

test "a list nested in a list reconciles on its own" {
    let ctx = context {
        Ui: headless(),
    };
    let inner = signal(ctx, ["x"]);
    let outer = signal(ctx, ["a", "b"]);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.each(.Cell(outer), itself, fn(c, item, index) => {
                    ui.stack({
                        styles: [],
                        children: [
                            ui.text({ content: .Const(item) }),
                            ui.stack({
                                styles: [],
                                children: [ui.each(.Cell(inner), itself, labelRow)],
                                role: .Some(.List),
                            }),
                        ],
                        role: .Some(.ListItem),
                    })
                }),
            ],
            role: .Some(.List),
        }),
    );
    assert.equal(page.count("li"), 4);
    let _ = inner.set(ctx, ["x", "y"]);
    assert.equal(page.count("li"), 6);
    assert.equal(page.text(), "a x y b x y");
}

// --- derived lists and derived text ---------------------------------------------------

// buri-lang/buri#50, in the document. A `Scope` is an `Allocator`, so the list
// `each` walks may be a filtered view of a signal and the text a leaf shows may
// be formatted from one. Both are the shapes an app hits on its first screen.

fn isEven(value: Int): Bool {
    value % 2 == 0
}

/// A row of the derived list. The item's own text is formatted inside the leaf,
/// which is the second half of the issue: a number reaches a `ui.text` only if
/// the closure rendering it can allocate.
fn numberRow<C>(ctx: C, item: Int, index: Int): Node<C> {
    ui.stack({
        styles: [],
        children: [ui.text({ content: .Computed(fn(s) => str.format(s, "${item}")) })],
        role: .Some(.ListItem),
    })
}

/// The issue's program, word for word: a filtered `Prop<[Int]>` handed to
/// `each`, from a function with no context of its own.
fn evens<C>(xs: Signal<[Int]>): Node<C> {
    ui.each(.Computed(fn(s) => xs.get(s).filter(s, isEven)), fn(x) => "${x}", numberRow)
}

test "a derived list re-filters and re-renders when its signal is written" {
    let ctx = context {
        Ui: headless(),
    };
    let xs = signal(ctx, [1, 2, 3, 4]);
    let page = render(
        ctx,
        ui.stack({ styles: [], children: [evens(xs)], role: .Some(.List) }),
    );
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 2\ne 1 \nt 2 4");

    let _ = xs.set(ctx, [1, 2, 3, 4, 5, 6]);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 2\ne 1 \nt 2 4\ne 1 \nt 2 6");

    // Keyed, so the rows that survived the re-filter were moved rather than
    // rebuilt — the derivation is fine-grained, not a repaint.
    let two = page.identity("li", 0);
    let _ = xs.set(ctx, [2, 6]);
    assert.equal(page.markup(), "e 0 \ne 1 \nt 2 2\ne 1 \nt 2 6");
    assert.equal(page.identity("li", 0), two);
}

/// A gate whose row builder normalises what was typed and writes the correction
/// back into the very signal its key list reads — the shape buri#170 is about.
/// The row renders the text it was built with, so the tree shows what the each
/// last built.
fn correctingGate<C: Ui + Watch + Allocator>(value: Signal<Str>, log: Recorder): Node<C> {
    ui.each(
        .Computed(fn(s) => [value.get(s)]),
        fn(t) => t,
        fn(c, typed, _index) => {
            let _ = log.record(typed);
            // A closed call gets its missing slot filled in — a correction the
            // control makes to what the reader typed, written back to the signal
            // the key list reads.
            let _ = if (typed.endsWith("(")) {
                value.set(c, typed.concat(c, ")"))
            } else {
                ()
            };
            ui.text({ content: .Const(typed) })
        },
    )
}

test "an each row that corrects the signal its key list reads re-renders that row" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    let value = signal(ctx, "a");
    let log = recorder();
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.field({ label: .Const("Formula"), kind: .Text, value: value, styles: [] }),
                correctingGate(value, log),
            ],
        }),
    );
    // Typing an open paren: the field takes it, the gate's builder runs on it,
    // corrects the signal to the closed call, and the each re-runs on the
    // correction — building the row once more, this time with the closed text.
    let _ = page.fill("Formula", "Balance(");
    // The builder ran on the keystroke and again on its own correction, and not
    // a third, stale time: before the fix the graph replayed the superseded
    // keystroke, and a non-converging correction recursed until the stack blew.
    assert.equal(log.recorded(), ["a", "Balance(", "Balance()"]);
    // The correction reached the signal — other readers (the field) see it.
    assert.equal(value.get(ctx), "Balance()");
    // And the each's own subtree re-rendered the row: the tree shows the
    // corrected text, not the "Balance(" the reader typed. This is the headline
    // the reader's control could not fix before. The runs are the field's label,
    // the field's own value, then the gate's row — the last the each rebuilt.
    assert.equal(page.text(), "Formula Balance() Balance()");
}

test "formatted text follows the signal it was formatted from" {
    let ctx = context {
        Ui: headless(),
    };
    let n = signal(ctx, 1);
    let page = render(
        ctx,
        ui.text({ content: .Computed(fn(s) => str.format(s, "${n.get(s)} items")) }),
    );
    assert.equal(page.text(), "1 items");
    let _ = n.set(ctx, 12);
    assert.equal(page.text(), "12 items");
}

// buri-lang/buri#143, in the document. A handler that grows a list signal out
// of the list the cell already holds is the ordinary way to append, and every
// press has to reach the page — not the first one only.

fn appendRow<C: Allocator + Ui + Watch>(ctx: C, xs: Signal<[Str]>): () {
    let current = xs.get(ctx);
    let next = str.format(ctx, "x${current.length()}");
    xs.set(ctx, current.concat(ctx, [next]))
}

fn growable<C>(xs: Signal<[Str]>, add: fn(C) => ()): Node<C> {
    ui.stack({
        styles: [.Layout(.Column), .Group([])],
        children: [
            ui.button({ label: .Const("go"), styles: [], onPress: .Some(add) }),
            ui.stack({
                styles: [],
                children: [ui.each(.Cell(xs), itself, labelRow)],
                role: .Some(.List),
            }),
        ],
    })
}

test "each follows a get-then-set append on every press" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
        Allocator: alloc(),
    };
    let xs = signal(ctx, ["a", "b"]);
    let page = render(ctx, growable(xs, fn(c) => appendRow(c, xs)));
    assert.equal(page.text(), "go a b");
    let _ = page.press("go");
    assert.equal(page.text(), "go a b x2");
    let _ = page.press("go");
    assert.equal(page.text(), "go a b x2 x3");
    let _ = page.press("go");
    assert.equal(page.text(), "go a b x2 x3 x4");
    // The state and the document say the same thing, which is the half the
    // issue reported as a disagreement.
    assert.equal(xs.get(ctx), ["a", "b", "x2", "x3", "x4"]);
}

// --- batching ------------------------------------------------------------------------

test "one press is one update, however many signals it writes" {
    let ctx = context {
        Ui: headless(),
    };
    let log = recorder();
    let first = signal(ctx, 0);
    let second = signal(ctx, 0);
    let _ = watch(ctx, fn(s) => ignore(log.note(first.get(s) + second.get(s))));
    assert.equal(log.noted(), [0]);

    let page = render(
        ctx,
        ui.button({
            label: .Const("both"),
            styles: [],
            onPress: .Some(fn(c) => writeBoth(c, first, second)),
        }),
    );
    let _ = page.press("both");

    // Two writes, one pass over the watchers: the handler ran inside one
    // transaction. Two passes would have noted 1 and then 3.
    assert.equal(log.noted(), [0, 3]);
}

fn writeBoth<C: Ui>(ctx: C, first: Signal<Int>, second: Signal<Int>): () {
    let _ = first.set(ctx, 1);
    let _ = second.set(ctx, 2);
}

// --- the design's example ------------------------------------------------------------

// design/ui-reactivity.md, "Example", as written there: a pure component that
// cannot tell whether either of its props varies, an effectful one that owns
// the signal, and a handler that captures the signal and takes its context as a
// parameter. The badge's style is written out rather than reaching for a design
// token, because a token is resolved against a theme and `ui/theme` has no way
// to build one yet.

let badgeStyle: Style = .Group([
    .PaddingX(.Rem(0.5)),
    .Radius(.Px(6)),
    .Background(.Rgb(240, 240, 245)),
]);

fn badge<C>(title: Prop<Str>, count: Prop<Int>): Node<C> {
    ui.stack({
        styles: [.Layout(.Row), .Group([badgeStyle])],
        children: [
            ui.text({ content: title }),
            ui.text({ content: .Computed(fn(c) => "${count.read(c)}") }),
        ],
    })
}

fn counter<C: Ui>(ctx: C, label: Str): Node<C> {
    let count = signal(ctx, 0);

    ui.stack({
        styles: [.Layout(.Column), .Group([])],
        children: [
            ui.button({
                label: .Const(label),
                styles: [],
                onPress: .Some(fn(c) => count.update(c, fn(n) => n + 1)),
            }),
            badge(.Const(label), .Cell(count)),
            badge(.Const("doubled"), .Computed(fn(c) => count.get(c) * 2)),
        ],
    })
}

test "the counter counts, and both badges follow" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, counter(ctx, "clicks"));
    assert.equal(page.text(), "clicks clicks 0 doubled 0");
    let _ = page.press("clicks");
    assert.equal(page.text(), "clicks clicks 1 doubled 2");
    let _ = page.press("clicks");
    let _ = page.press("clicks");
    assert.equal(page.text(), "clicks clicks 3 doubled 6");
}
