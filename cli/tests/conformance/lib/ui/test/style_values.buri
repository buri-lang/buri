// A `Style` is an ordinary enum until it reaches a node. Matching one, passing
// it around, comparing it and naming it see the variant the source wrote; only
// a style a node is given becomes classes in the stylesheet.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Scope, Ui, Watch };
from "platform/effect/testing" import {
    alloc as testAlloc, headless, observer, render, stylesheet,
};
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/style" import * as style;
from "ui/style" import { Shadow, State, Style };

/// The variant a style is, as the source spells it: a show of its own.
fn kind(s: Style): Str {
    match (s) {
        .Group(_) => "Group",
        .On(_, _) => "On",
        .At(_, _) => "At",
        .When(_, _, _) => "When",
        .Computed(_) => "Computed",
        .Extracted(_) => "Extracted",
        .Layout(_) => "Layout",
        .AlignMain(_) => "AlignMain",
        .AlignCross(_) => "AlignCross",
        .AlignSelf(_) => "AlignSelf",
        .Wrap(_) => "Wrap",
        .Scroll(_) => "Scroll",
        .Grow(_) => "Grow",
        .Shrink(_) => "Shrink",
        .Span(_) => "Span",
        .Pin(_, _) => "Pin",
        .Position(_) => "Position",
        .Gap(_) => "Gap",
        .GapX(_) => "GapX",
        .GapY(_) => "GapY",
        .Padding(_) => "Padding",
        .PaddingX(_) => "PaddingX",
        .PaddingY(_) => "PaddingY",
        .PaddingEdge(_, _) => "PaddingEdge",
        .Width(_) => "Width",
        .Height(_) => "Height",
        .MinWidth(_) => "MinWidth",
        .MaxWidth(_) => "MaxWidth",
        .MinHeight(_) => "MinHeight",
        .MaxHeight(_) => "MaxHeight",
        .AspectRatio(_) => "AspectRatio",
        .Background(_) => "Background",
        .Foreground(_) => "Foreground",
        .BorderWidth(_) => "BorderWidth",
        .BorderEdge(_, _) => "BorderEdge",
        .BorderColor(_) => "BorderColor",
        .BorderStyle(_) => "BorderStyle",
        .Radius(_) => "Radius",
        .RadiusCorner(_, _) => "RadiusCorner",
        .Opacity(_) => "Opacity",
        .Shadow(_) => "Shadow",
        .Shadows(_) => "Shadows",
        .FontFamily(_) => "FontFamily",
        .FontSize(_) => "FontSize",
        .FontWeight(_) => "FontWeight",
        .Italic(_) => "Italic",
        .LineHeight(_) => "LineHeight",
        .LetterSpacing(_) => "LetterSpacing",
        .TextAlign(_) => "TextAlign",
        .TextCase(_) => "TextCase",
        .TextLine(_) => "TextLine",
        .TextWrap(_) => "TextWrap",
        .Truncate(_) => "Truncate",
        .Cursor(_) => "Cursor",
        .ListMarker(_) => "ListMarker",
        .Bleed(_, _) => "Bleed",
        .Translate(_, _) => "Translate",
        .Clip(_) => "Clip",
        .Passthrough(_) => "Passthrough",
        .BackdropBlur(_) => "BackdropBlur",
        .CaretColor(_) => "CaretColor",
        .VisuallyHidden => "VisuallyHidden",
        .Animation(_) => "Animation",
    }
}

/// The size a style holds, in pixels, or how many styles a group holds.
fn size(s: Style): Int {
    match (s) {
        .Width(.Px(n)) => n,
        .Padding(.Px(n)) => n,
        .Group(items) => items.length(),
        _ => -1,
    }
}

/// An equality of its own, by variant and size.
fn same(a: Style, b: Style): Bool {
    kind(a) == kind(b) && size(a) == size(b)
}

struct Card {
    style: Style,
}

fn widen(s: Style): Style {
    match (s) {
        .Width(.Px(n)) => .Width(.Px(n + 1)),
        other => other,
    }
}

fn styled<C>(): Node<C> {
    ui.stack({ styles: [.Width(.Px(321))], children: [] })
}

/// A generic helper, so both calls below share its body.
fn second<T>(xs: [T], fallback: T): T {
    match (xs.get(1)) {
        .Some(x) => x,
        .None => fallback,
    }
}

fn picked<C>(): Node<C> {
    ui.stack({
        styles: [second([.Width(.Px(5)), .Height(.Px(6))], .Width(.Px(7)))],
        children: [],
    })
}

trait Tinted {
    fn tint(self): Style;
}

enum Swatch {
    Red,
}

impl Tinted for Swatch {
    fn tint(self): Style {
        .On(.Hover, [.Background(.Rgb(200, 0, 0))])
    }
}

/// A node styled through a bound, so `tint` is called on a type not yet known.
fn tinted<C, T: Tinted>(t: T): Node<C> {
    ui.stack({ styles: [t.tint()], children: [] })
}

test "a static composition takes the arm that names it" {
    assert.equal(kind(.Group([])), "Group");
    assert.equal(kind(.On(.Hover, [.Width(.Px(1))])), "On");
    assert.equal(kind(.At(.Medium, [.Width(.Px(1))])), "At");
    assert.equal(kind(.When(.Const(true), [], [])), "When");
    assert.equal(kind(.Computed(fn(_scope) => [])), "Computed");
}

test "a static layout style takes the arm that names it" {
    assert.equal(kind(.Layout(.Row)), "Layout");
    assert.equal(kind(.AlignMain(.Center)), "AlignMain");
    assert.equal(kind(.AlignCross(.Start)), "AlignCross");
    assert.equal(kind(.AlignSelf(.End)), "AlignSelf");
    assert.equal(kind(.Wrap(true)), "Wrap");
    assert.equal(kind(.Scroll(.Y)), "Scroll");
    assert.equal(kind(.Grow(1)), "Grow");
    assert.equal(kind(.Shrink(0)), "Shrink");
    assert.equal(kind(.Span(2)), "Span");
    assert.equal(kind(.Pin(.Top, .Px(0))), "Pin");
    assert.equal(kind(.Position(.Sticky)), "Position");
}

test "a static spacing or size style takes the arm that names it" {
    assert.equal(kind(.Gap(.Px(4))), "Gap");
    assert.equal(kind(.GapX(.Px(4))), "GapX");
    assert.equal(kind(.GapY(.Px(4))), "GapY");
    assert.equal(kind(.Padding(.Px(4))), "Padding");
    assert.equal(kind(.PaddingX(.Px(4))), "PaddingX");
    assert.equal(kind(.PaddingY(.Px(4))), "PaddingY");
    assert.equal(kind(.PaddingEdge(.Start, .Px(4))), "PaddingEdge");
    assert.equal(kind(.Width(.Px(4))), "Width");
    assert.equal(kind(.Height(.Px(4))), "Height");
    assert.equal(kind(.MinWidth(.Px(4))), "MinWidth");
    assert.equal(kind(.MaxWidth(.Px(4))), "MaxWidth");
    assert.equal(kind(.MinHeight(.Px(4))), "MinHeight");
    assert.equal(kind(.MaxHeight(.Px(4))), "MaxHeight");
    assert.equal(kind(.AspectRatio(1.5)), "AspectRatio");
    assert.equal(kind(.Bleed(.Start, .Px(4))), "Bleed");
    assert.equal(kind(.Translate(.Px(1), .Px(2))), "Translate");
}

test "a static paint style takes the arm that names it" {
    let shadow: Shadow = {
        x: .Px(0),
        y: .Px(1),
        blur: .Px(2),
        spread: .Px(0),
        color: .Transparent,
    };
    assert.equal(kind(.Background(.Rgb(1, 2, 3))), "Background");
    assert.equal(kind(.Foreground(.Inherit)), "Foreground");
    assert.equal(kind(.BorderWidth(.Px(1))), "BorderWidth");
    assert.equal(kind(.BorderEdge(.Bottom, .Px(1))), "BorderEdge");
    assert.equal(kind(.BorderColor(.Transparent)), "BorderColor");
    assert.equal(kind(.BorderStyle(.Dashed)), "BorderStyle");
    assert.equal(kind(.Radius(.Px(3))), "Radius");
    assert.equal(kind(.RadiusCorner(.TopStart, .Px(3))), "RadiusCorner");
    assert.equal(kind(.Opacity(0.5)), "Opacity");
    assert.equal(kind(.Shadow(shadow)), "Shadow");
    assert.equal(kind(.Shadows([shadow])), "Shadows");
    assert.equal(kind(.BackdropBlur(.Px(2))), "BackdropBlur");
    assert.equal(kind(.CaretColor(.Inherit)), "CaretColor");
}

test "a static text or behavior style takes the arm that names it" {
    assert.equal(kind(.FontFamily(.Mono)), "FontFamily");
    assert.equal(kind(.FontSize(.Px(12))), "FontSize");
    assert.equal(kind(.FontWeight(.Bold)), "FontWeight");
    assert.equal(kind(.Italic(true)), "Italic");
    assert.equal(kind(.LineHeight(1.25)), "LineHeight");
    assert.equal(kind(.LetterSpacing(.Px(1))), "LetterSpacing");
    assert.equal(kind(.TextAlign(.Center)), "TextAlign");
    assert.equal(kind(.TextCase(.Upper)), "TextCase");
    assert.equal(kind(.TextLine(.Underline)), "TextLine");
    assert.equal(kind(.TextWrap(.Balance)), "TextWrap");
    assert.equal(kind(.Truncate(2)), "Truncate");
    assert.equal(kind(.Cursor(.Pointer)), "Cursor");
    assert.equal(kind(.ListMarker(.Disc)), "ListMarker");
    assert.equal(kind(.Clip(true)), "Clip");
    assert.equal(kind(.Passthrough(true)), "Passthrough");
    assert.equal(kind(.VisuallyHidden), "VisuallyHidden");
    assert.equal(kind(.Animation(.Spin)), "Animation");
}

test "a matched static style binds its payload" {
    let s: Style = .Width(.Px(12));
    let answer = match (s) {
        .Width(.Px(n)) => n,
        _ => 0,
    };
    assert.equal(answer, 12);
}

test "a static style passes through functions, fields and arrays unchanged" {
    let card = Card { style: .Padding(.Px(8)) };
    assert.equal(kind(card.style), "Padding");
    assert.equal(size(card.style), 8);
    assert.equal(size(widen(.Width(.Px(9)))), 10);
    let styles: [Style] = [.Width(.Px(1)), .Padding(.Px(2))];
    assert.equal(size(.Group(styles)), 2);
    match (styles.get(1)) {
        .Some(second) => assert.equal(kind(second), "Padding"),
        .None => assert.isTrue(false),
    }
}

test "static styles compare by what they hold" {
    assert.isTrue(same(.Width(.Px(3)), .Width(.Px(3))));
    assert.isFalse(same(.Width(.Px(3)), .Width(.Px(4))));
    assert.isFalse(same(.Width(.Px(3)), .Padding(.Px(3))));
}

test "a static style a node is given is still a class in the sheet" {
    let ctx = context {
        Ui: headless(),
    };
    let _ = render(ctx, styled());
    assert.isTrue(stylesheet().contains(".w-321{width:321px}"));
    assert.equal(kind(.Width(.Px(321))), "Width");
}

test "a style a trait method answers through a bound is a class in the sheet" {
    let ctx = context {
        Ui: headless(),
    };
    let _ = render(ctx, tinted(Swatch.Red));
    assert.isTrue(
        stylesheet().contains(".hover_bg-c80000:hover{background-color:rgb(200,0,0)}"),
    );
}

test "a generic helper a node reads through leaves its other callers' styles alone" {
    let ctx = context {
        Ui: headless(),
    };
    let _ = render(ctx, picked());
    assert.isTrue(stylesheet().contains(".h-6{height:6px}"));
    assert.equal(
        kind(second([.Width(.Px(5)), .Height(.Px(6))], .Width(.Px(7)))),
        "Height",
    );
}

fn roomy(): Style {
    .Padding(.Px(14))
}

test "a local a match reads and a node is given is the variant it names" {
    let ctx = context {
        Ui: headless(),
    };
    let s: Style = .Width(.Px(41));
    let _ = render(ctx, ui.stack({ styles: [s], children: [] }));
    assert.equal(kind(s), "Width");
    assert.equal(size(s), 41);
    assert.isTrue(same(s, .Width(.Px(41))));
    assert.isTrue(stylesheet().contains(".w-41{width:41px}"));
}

test "a field a match reads and a node is given is the variant it names" {
    let ctx = context {
        Ui: headless(),
    };
    let card = Card { style: .Height(.Px(43)) };
    let _ = render(ctx, ui.stack({ styles: [card.style], children: [] }));
    assert.equal(kind(card.style), "Height");
    assert.isTrue(stylesheet().contains(".h-43{height:43px}"));
}

test "a result a match reads and a node is given is the variant it names" {
    let ctx = context {
        Ui: headless(),
    };
    let s = roomy();
    let _ = render(ctx, ui.stack({ styles: [roomy(), s], children: [] }));
    assert.equal(kind(roomy()), "Padding");
    assert.equal(size(s), 14);
    assert.isTrue(stylesheet().contains(".p-14{padding:14px}"));
}

test "a style built from a local a node is given is a class in the sheet" {
    let ctx = context {
        Ui: headless(),
    };
    let n = 47;
    let _ = render(ctx, ui.stack({ styles: [.Width(.Px(n))], children: [] }));
    assert.isTrue(stylesheet().contains(".w-47{width:47px}"));
}

/// Reads its style and hands the same value to a node.
fn label<C>(s: Style): Node<C> {
    let wide = match (s) {
        .Width(.Px(n)) => n > 200,
        _ => false,
    };
    ui.stack({
        styles: [s],
        children: [
            ui.text({ content: .Const(if (wide) { "wide" } else { "narrow" }) }),
        ],
    })
}

test "a parameter a match reads and a node is given is the variant it names" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, label(.Width(.Px(321))));
    assert.equal(page.text(), "wide");
    assert.isTrue(page.markup().contains("w-321"));
    assert.isTrue(stylesheet().contains(".w-321{width:321px}"));
}

// --- a style a node is handed rather than written ------------------------------------

/// A node given the one style it is handed.
fn boxed<C>(s: Style): Node<C> {
    ui.stack({ styles: [s], children: [] })
}

/// A node given the one style it is handed, read as a value below.
fn held<C>(s: Style): Node<C> {
    ui.stack({ styles: [s], children: [] })
}

/// A node given the styles it is handed.
fn boxes<C>(styles: [Style]): Node<C> {
    ui.stack({ styles: styles, children: [] })
}

/// A node given the style a closure it is handed answers.
fn applied<C>(f: fn(Int) => Style): Node<C> {
    ui.stack({ styles: [f(22)], children: [] })
}

fn eighteen(ctx: Scope): [Style] {
    [.Width(.Px(18))]
}

/// A node given the style it is handed, or a fixed one.
fn either<C>(wide: Bool, s: Style): Node<C> {
    ui.stack({ styles: [if (wide) { s } else { .Width(.Px(1)) }], children: [] })
}

test "a style a parameter hands a node is its class" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, boxed(.Padding(.Px(8)))).markup(), "e 0 class:p-8");
    assert.equal(render(ctx, boxed(.Width(.Px(-3)))).markup(), "e 0 class:w-n3");
    assert.equal(render(ctx, boxed(.Truncate(0))).markup(), "e 0 class:trunc-0");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".p-8{padding:8px}"));
    assert.isTrue(sheet.contains(".w-n3{width:-3px}"));
}

test "styles a parameter hands a node are their classes, the last per property winning" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(
        render(
            ctx,
            boxes([.Padding(.Px(9)), .Width(.Px(10)), .Padding(.Px(11))]),
        ).markup(),
        "e 0 class:p-11 w-10",
    );
    assert.equal(render(ctx, boxes([])).markup(), "e 0 ");
    assert.isTrue(stylesheet().contains(".p-11{padding:11px}"));
}

test "a condition a parameter hands a node scopes its classes" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(
        render(ctx, boxed(.On(.Hover, [.Background(.Rgb(200, 0, 0))]))).markup(),
        "e 0 class:hover_bg-c80000",
    );
    assert.equal(
        render(ctx, boxed(.At(.Medium, [.Width(.Px(12))]))).markup(),
        "e 0 class:md_w-12",
    );
    let sheet = stylesheet();
    assert.isTrue(
        sheet.contains(".hover_bg-c80000:hover{background-color:rgb(200,0,0)}"),
    );
    assert.isTrue(sheet.contains(".md_w-12{width:12px}"));
}

test "a choice a parameter hands a node swaps its classes" {
    let ctx = context {
        Ui: headless(),
    };
    let wide = signal(ctx, false);
    let page = render(
        ctx,
        boxed(.When(.Cell(wide), [.Width(.Px(13))], [.Width(.Px(14))])),
    );
    assert.equal(page.markup(), "e 0 class:w-14");
    let _ = wide.set(ctx, true);
    assert.equal(page.markup(), "e 0 class:w-13");
}

test "a value known only at run time a parameter hands a node is a variable" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let n = signal(ctx, 15);
    assert.equal(
        render(ctx, boxed(.Width(.Px(n.get(ctx))))).markup(),
        "e 0 class:w-var;--buri-w:15px",
    );
    assert.isTrue(stylesheet().contains(".w-var{width:var(--buri-w)}"));
}

test "a style whose class ends in a digest is its class through a parameter" {
    let ctx = context {
        Ui: headless(),
    };
    let grid = render(
        ctx,
        boxed(.Layout(.Grid([.Fraction(1), .Fixed(.Px(20))]))),
    ).markup();
    let shadow = render(
        ctx,
        boxed(
            .Shadow(Shadow {
                x: .Px(0),
                y: .Px(1),
                blur: .Px(2),
                spread: .Px(0),
                color: .Rgb(0, 0, 0),
            }),
        ),
    ).markup();
    let family = render(ctx, boxed(.FontFamily(.Named("Inter")))).markup();
    let sheet = stylesheet();
    assert.isTrue(grid.startsWith("e 0 class:lay-grid-"));
    assert.isTrue(sheet.contains("{display:grid;grid-template-columns:1fr 20px}"));
    assert.isTrue(shadow.startsWith("e 0 class:sh-"));
    assert.isTrue(sheet.contains("{box-shadow:0px 1px 2px 0px rgb(0,0,0)}"));
    assert.isTrue(family.startsWith("e 0 class:ff-"));
    assert.isTrue(sheet.contains("{font-family:\"Inter\",ui-sans-serif,sans-serif}"));
}

test "a token a parameter hands a node is its class" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(
        render(ctx, boxed(.Background(style.token("cardlib", "surface")))).markup(),
        "e 0 class:bg-t_cardlib_surface",
    );
    let odd = render(
        ctx,
        boxed(.Background(style.token("card-lib", "surface"))),
    ).markup();
    assert.isTrue(odd.startsWith("e 0 class:bg-t_"));
    assert.isTrue(stylesheet().contains("{background-color:var(--card-lib-surface)}"));
}

/// The classes a box shows while `state` holds, as `describe` draws it.
fn under<C: Allocator>(ctx: C, node: Node<C>, state: State): Str {
    ui.describe(ctx, node, state).replace(ctx, "buri-scene 1\nviewport 800 fit\n", "")
}

test "every state and screen a parameter hands a node scopes its classes" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
    };
    assert.equal(
        under(ctx, boxed(.On(.Focus, [.Width(.Px(31))])), .Focus),
        "e 0 class:focus_w-31",
    );
    assert.equal(
        under(ctx, boxed(.On(.FocusWithin, [.Width(.Px(32))])), .FocusWithin),
        "e 0 class:focuswithin_w-32",
    );
    assert.equal(
        under(ctx, boxed(.On(.Active, [.Width(.Px(33))])), .Active),
        "e 0 class:active_w-33",
    );
    assert.equal(
        under(ctx, boxed(.On(.Disabled, [.Width(.Px(34))])), .Disabled),
        "e 0 class:disabled_w-34",
    );
    assert.equal(
        under(ctx, boxed(.On(.Checked, [.Width(.Px(35))])), .Checked),
        "e 0 class:checked_w-35",
    );
    assert.equal(
        under(ctx, boxed(.On(.Invalid, [.Width(.Px(36))])), .Invalid),
        "e 0 class:invalid_w-36",
    );
    assert.equal(
        render(ctx, boxed(.At(.Small, [.Width(.Px(37))]))).markup(),
        "e 0 class:sm_w-37",
    );
    assert.equal(
        render(ctx, boxed(.At(.Large, [.Width(.Px(38))]))).markup(),
        "e 0 class:lg_w-38",
    );
    assert.equal(
        render(ctx, boxed(.At(.ExtraLarge, [.Width(.Px(39))]))).markup(),
        "e 0 class:xl_w-39",
    );
    assert.equal(
        render(ctx, boxed(.Group([.Width(.Px(40))]))).markup(),
        "e 0 class:w-40",
    );
    assert.equal(render(ctx, boxed(.VisuallyHidden)).markup(), "e 0 class:vh-on");
    let sheet = stylesheet();
    assert.isTrue(sheet.contains(".focus_w-31:focus-visible{width:31px}"));
    assert.isTrue(sheet.contains(".invalid_w-36[aria-invalid=true]{width:36px}"));
}

test "an alignment a parameter hands a node is its class" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(
        render(ctx, boxed(.AlignMain(.SpaceBetween))).markup(),
        "e 0 class:am-between",
    );
    assert.equal(
        render(ctx, boxed(.AlignMain(.SpaceAround))).markup(),
        "e 0 class:am-around",
    );
    assert.equal(
        render(ctx, boxed(.AlignMain(.SpaceEvenly))).markup(),
        "e 0 class:am-evenly",
    );
    assert.equal(
        render(ctx, boxed(.AlignCross(.Start))).markup(),
        "e 0 class:ac-start",
    );
    assert.equal(
        render(ctx, boxed(.AlignCross(.Center))).markup(),
        "e 0 class:ac-center",
    );
    assert.equal(render(ctx, boxed(.AlignSelf(.End))).markup(), "e 0 class:as-end");
}

test "a shadow a parameter hands a node keeps its lengths and colour" {
    let ctx = context {
        Ui: headless(),
    };
    let token = render(
        ctx,
        boxed(
            .Shadow(Shadow {
                x: .Em(1.5),
                y: .Percent(2.0),
                blur: .Auto,
                spread: .Full,
                color: style.token("kit", "ink"),
            }),
        ),
    ).markup();
    let inherited = render(
        ctx,
        boxed(
            .Shadow(Shadow {
                x: .Px(0),
                y: .Px(2),
                blur: .Px(3),
                spread: .Px(0),
                color: .Inherit,
            }),
        ),
    ).markup();
    let faded = render(
        ctx,
        boxed(
            .Shadow(Shadow {
                x: .Px(0),
                y: .Px(3),
                blur: .Px(4),
                spread: .Px(0),
                color: style.token("kit", "ink").alpha(0.5),
            }),
        ),
    ).markup();
    let sheet = stylesheet();
    assert.isTrue(token.startsWith("e 0 class:sh-"));
    assert.isTrue(sheet.contains("{box-shadow:1.5em 2% auto 100% var(--kit-ink)}"));
    assert.isTrue(inherited.startsWith("e 0 class:sh-"));
    assert.isTrue(sheet.contains("{box-shadow:0px 2px 3px 0px inherit}"));
    assert.isTrue(faded.startsWith("e 0 class:sh-"));
    assert.isTrue(
        sheet.contains(
            "{box-shadow:0px 3px 4px 0px color-mix(in srgb,var(--kit-ink) 50%,transparent)}",
        ),
    );
}

test "a parameter's style that is not settled keeps the classes around it" {
    let ctx = context {
        Ui: headless(),
    };
    let wide = signal(ctx, false);
    let grouped = render(
        ctx,
        boxed(
            .Group([
                .When(.Cell(wide), [.Width(.Px(41))], [.Width(.Px(42))]),
                .Height(.Px(43)),
            ]),
        ),
    );
    assert.equal(grouped.markup(), "e 0 class:w-42 h-43");
    let hovered = render(
        ctx,
        boxed(.On(.Hover, [.When(.Cell(wide), [.Width(.Px(44))], [.Width(.Px(45))])])),
    );
    assert.equal(hovered.markup(), "e 0 class:hover_w-45");
    let medium = render(
        ctx,
        boxed(.At(.Medium, [.When(.Cell(wide), [.Width(.Px(46))], [.Width(.Px(47))])])),
    );
    assert.equal(medium.markup(), "e 0 class:md_w-47");
    let _ = wide.set(ctx, true);
    assert.equal(grouped.markup(), "e 0 class:w-41 h-43");
    assert.equal(hovered.markup(), "e 0 class:hover_w-44");
    assert.equal(medium.markup(), "e 0 class:md_w-46");
}

test "a colour channel out of range a parameter hands a node is written inline" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, boxed(.Background(.Rgb(300, 0, 0)))).markup();
    assert.isTrue(page.contains("300"));
}

test "a token with an empty name a parameter hands a node is digested" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, boxed(.Background(style.token("", "ink")))).markup();
    assert.isTrue(page.startsWith("e 0 class:bg-t_"));
}

test "a style a branch hands a node is its class" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, either(true, .Width(.Px(16)))).markup(), "e 0 class:w-16");
    assert.equal(render(ctx, either(false, .Width(.Px(17)))).markup(), "e 0 class:w-1");
}

test "a closure built elsewhere is what it answers" {
    let ctx = context {
        Ui: headless(),
    };
    let build = eighteen;
    assert.equal(
        render(ctx, ui.stack({ styles: [.Computed(build)], children: [] })).markup(),
        "e 0 class:w-18",
    );
    assert.equal(
        render(ctx, boxed(.Computed(fn(_scope) => [.Width(.Px(19))]))).markup(),
        "e 0 class:w-19",
    );
}

test "a closure built elsewhere and handed on is what it answers" {
    let ctx = context {
        Ui: headless(),
    };
    let build = eighteen;
    assert.equal(kind(.Computed(build)), "Computed");
    assert.equal(render(ctx, boxed(.Computed(build))).markup(), "e 0 class:w-18");
}

test "a style the compiler cannot follow to a node is a variable" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(
        render(ctx, applied(fn(n) => .Width(.Px(n)))).markup(),
        "e 0 class:w-var;--buri-w:22px",
    );
    let f = held;
    assert.equal(render(ctx, held(.Width(.Px(23)))).markup(), "e 0 class:w-23");
    assert.equal(
        render(ctx, f(.Width(.Px(21)))).markup(),
        "e 0 class:w-var;--buri-w:21px",
    );
}

/// A style written once for the whole module.
let snug: Style = .Width(.Px(24));

test "a module's style a parameter hands a node is its class" {
    let ctx = context {
        Ui: headless(),
    };
    assert.equal(render(ctx, held(snug)).markup(), "e 0 class:w-24");
}

test "a style a library function answers is what it holds" {
    let ctx = context {
        Ui: headless(),
    };
    let styles: [Style] = [.Width(.Px(25))];
    let picked = match (styles.get(0)) {
        .Some(s) => s,
        .None => .Width(.Px(26)),
    };
    assert.equal(render(ctx, held(picked)).markup(), "e 0 class:w-25");
}

/// `x`, read back from a signal, so the compiler cannot fold a style that holds it.
fn late<T, C: Ui + Watch>(ctx: C, x: T): T {
    signal(ctx, x).get(ctx)
}

/// What a box given `styles` renders as. Three ways of drawing it must agree:
/// the box as it is, the box from a style that computes the list (which it
/// re-runs whenever what that reads changes), and `describe`'s scene.
fn painted<C: Allocator + Ui>(ctx: C, styles: [Style]): Str {
    let once = render(ctx, boxes(styles)).markup();
    let computed = render(ctx, boxes([.Computed(fn(_scope) => styles)])).markup();
    let scene = ui.describe(ctx, boxes(styles), .Hover);
    if (once != computed) {
        "a computed list renders differently"
    } else if (scene != "buri-scene 1\nviewport 800 fit\n".concat(ctx, once)) {
        "describe renders differently"
    } else {
        once
    }
}

test "a layout style known only at run time writes itself out" {
    let ctx = context {
        Allocator: testAlloc(),
        Ui: headless(),
        Watch: observer(),
    };
    assert.equal(
        painted(ctx, [.Layout(late(ctx, .Column))]),
        "e 0 display:flex;flex-direction:column",
    );
    assert.equal(
        painted(ctx, [.Layout(late(ctx, .Row))]),
        "e 0 display:flex;flex-direction:row",
    );
    assert.equal(
        painted(ctx, [.Layout(late(ctx, .ColumnReverse))]),
        "e 0 display:flex;flex-direction:column-reverse",
    );
    assert.equal(
        painted(ctx, [.Layout(late(ctx, .RowReverse))]),
        "e 0 display:flex;flex-direction:row-reverse",
    );
    assert.equal(painted(ctx, [.Layout(late(ctx, .Layers))]), "e 0 display:grid");
    assert.equal(
        painted(ctx, [
            .Layout(late(ctx, .Grid([.Fraction(2), .Fixed(.Rem(1.5)), .Auto]))),
        ]),
        "e 0 display:grid;grid-template-columns:2fr 1.5rem auto",
    );
    assert.equal(painted(ctx, [.Wrap(late(ctx, true))]), "e 0 flex-wrap:wrap");
    assert.equal(painted(ctx, [.Wrap(late(ctx, false))]), "e 0 flex-wrap:nowrap");
    assert.equal(painted(ctx, [.Scroll(late(ctx, .X))]), "e 0 overflow-x:auto");
    assert.equal(painted(ctx, [.Scroll(late(ctx, .Y))]), "e 0 overflow-y:auto");
    assert.equal(painted(ctx, [.Scroll(late(ctx, .Both))]), "e 0 overflow:auto");
    assert.equal(
        painted(ctx, [.Span(late(ctx, 2))]),
        "e 0 class:span-var;--buri-span:span 2",
    );
}

