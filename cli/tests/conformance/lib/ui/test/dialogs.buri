// Where the focus goes as a dialog opens and shuts, the way a browser's modal
// dialog moves it: in to the first thing inside that takes it, and back to the
// element that had it before, however the dialog was shut. `language::pages`
// checks a browser does the same.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Ui, Watch };
from "platform/effect/testing" import { headless, observer, render };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/prop" import { Prop };
from "ui/signal" import { Signal, signal };
from "ui/style" import { Style };

/// A button named `Delete` that opens a dialog holding a button named `Done`,
/// which shuts it, and a button named `Other` beside them.
fn confirm<C: Ui>(open: Signal<Bool>, off: Prop<Bool>): Node<C> {
    ui.stack({
        styles: [],
        children: [
            ui.button({
                label: .Const("Delete"),
                styles: [],
                onPress: .Some(fn(c) => open.set(c, true)),
                isDisabled: .Some(off),
            }),
            ui.button({
                label: .Const("Other"),
                styles: [],
                onPress: .Some(fn(_c) => ()),
            }),
            ui.dialog({
                isOpen: open,
                label: .Const("Delete this?"),
                children: [
                    ui.button({
                        label: .Const("Done"),
                        styles: [],
                        onPress: .Some(fn(c) => open.set(c, false)),
                    }),
                ],
                styles: [],
            }),
        ],
    })
}

test "Escape gives the focus back to the button that opened the dialog" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(ctx, confirm(open, .Const(false)));
    let _ = page.press("Delete");
    let _ = page.focus("Done");
    let _ = page.key("Escape");
    assert.isFalse(open.get(ctx));
    assert.equal(page.focused(), "Delete");
}

test "a dialog its own button shuts gives the focus back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(ctx, confirm(open, .Const(false)));
    let _ = page.press("Delete");
    let _ = page.press("Done");
    assert.isFalse(open.get(ctx));
    assert.equal(page.focused(), "Delete");
}

test "a dialog the program shuts gives the focus back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(ctx, confirm(open, .Const(false)));
    let _ = page.focus("Delete");
    let _ = open.set(ctx, true);
    let _ = page.focus("Done");
    let _ = open.set(ctx, false);
    assert.equal(page.focused(), "Delete");
    // The next Tab goes on from there.
    let _ = page.tab();
    assert.equal(page.focused(), "Other");
}

test "a dialog that opened with nothing focused leaves nothing focused when it shuts" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, true);
    let page = render(ctx, confirm(open, .Const(false)));
    let _ = page.focus("Done");
    let _ = page.key("Escape");
    assert.equal(page.focused(), "");
}

test "the focus goes back only to an element that can still take it" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let off = signal(ctx, false);
    let page = render(ctx, confirm(open, .Cell(off)));
    let _ = page.press("Delete");
    let _ = page.focus("Done");
    let _ = off.set(ctx, true);
    let _ = page.key("Escape");
    assert.equal(page.focused(), "");
}

test "the opener's hasFocus and onFocus follow the focus back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let held = signal(ctx, false);
    let heard = signal(ctx, 0);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("Delete"),
                    styles: [],
                    onPress: .Some(fn(c) => open.set(c, true)),
                    hasFocus: .Some(held),
                    onFocus: .Some(fn(c, on) => {
                        if (on) { heard.update(c, fn(n) => n + 1) } else {}
                    }),
                }),
                ui.dialog({
                    isOpen: open,
                    label: .Const("Delete this?"),
                    children: [
                        ui.button({
                            label: .Const("Done"),
                            styles: [],
                            onPress: .Some(fn(c) => open.set(c, false)),
                        }),
                    ],
                    styles: [],
                }),
            ],
        }),
    );
    let _ = page.press("Delete");
    let _ = page.focus("Done");
    assert.isFalse(held.get(ctx));
    let _ = page.key("Escape");
    assert.isTrue(held.get(ctx));
    assert.equal(heard.get(ctx), 2);
}

/// A button named `Open` that opens a dialog holding `children`.
fn opens<C: Ui>(open: Signal<Bool>, children: [Node<C>]): Node<C> {
    ui.stack({
        styles: [],
        children: [
            ui.button({
                label: .Const("Open"),
                styles: [],
                onPress: .Some(fn(c) => open.set(c, true)),
            }),
            ui.dialog({
                isOpen: open,
                label: .Const("Details"),
                children: children,
                styles: [],
            }),
        ],
    })
}

/// A button named `name` that does nothing.
fn idle<C: Ui>(name: Str, off: Bool): Node<C> {
    ui.button({
        label: .Const(name),
        styles: [],
        onPress: .Some(fn(_c) => ()),
        isDisabled: .Some(.Const(off)),
    })
}

test "opening a dialog moves the focus to the first thing in it that takes it" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(
        ctx,
        opens(open, [
            ui.text({ content: .Const("Why?") }),
            ui.field({
                label: .Const("Reason"),
                kind: .Text,
                value: signal(ctx, ""),
                styles: [],
            }),
            idle("Done", false),
        ]),
    );
    let _ = page.press("Open");
    assert.equal(page.focused(), "Reason");
}

test "a dialog the program opens takes the focus too" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(ctx, opens(open, [idle("Done", false)]));
    let _ = page.focus("Open");
    let _ = open.set(ctx, true);
    assert.equal(page.focused(), "Done");
}

test "a dialog open from the start has the focus" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, true);
    let page = render(ctx, opens(open, [idle("Done", false)]));
    assert.equal(page.focused(), "Done");
}

test "opening a dialog passes over a disabled control" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(ctx, opens(open, [idle("Wait", true), idle("Done", false)]));
    let _ = page.press("Open");
    assert.equal(page.focused(), "Done");
}

test "opening a dialog focuses a box out of the tab order that takes the focus" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let held = signal(ctx, false);
    let page = render(
        ctx,
        opens(open, [
            ui.stack({
                styles: [],
                children: [ui.text({ content: .Const("Notes") })],
                hasFocus: .Some(held),
                isInFocusOrder: .Some(.Const(false)),
            }),
            idle("Done", false),
        ]),
    );
    let _ = page.press("Open");
    assert.equal(page.focused(), "Notes");
    assert.isTrue(held.get(ctx));
}

test "a dialog with nothing to focus takes the focus off the opener" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let held = signal(ctx, false);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("Open"),
                    styles: [],
                    onPress: .Some(fn(c) => open.set(c, true)),
                    hasFocus: .Some(held),
                }),
                ui.dialog({
                    isOpen: open,
                    label: .Const("Saved"),
                    children: [ui.text({ content: .Const("Saved.") })],
                    styles: [],
                }),
            ],
        }),
    );
    let _ = page.press("Open");
    assert.equal(page.focused(), "");
    assert.isFalse(held.get(ctx));
    // Shutting it still gives the focus back.
    let _ = page.key("Escape");
    assert.equal(page.focused(), "Open");
}

test "a dialog opened from inside a dialog takes the focus, and gives it back" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let first = signal(ctx, false);
    let second = signal(ctx, false);
    let page = render(
        ctx,
        opens(first, [
            ui.button({
                label: .Const("More"),
                styles: [],
                onPress: .Some(fn(c) => second.set(c, true)),
            }),
            ui.dialog({
                isOpen: second,
                label: .Const("More details"),
                children: [idle("Close", false)],
                styles: [],
            }),
        ]),
    );
    let _ = page.press("Open");
    assert.equal(page.focused(), "More");
    let _ = page.press("More");
    assert.equal(page.focused(), "Close");
    let _ = page.key("Escape");
    assert.equal(page.focused(), "More");
}

test "opening a disclosure leaves the focus on its summary" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let page = render(
        ctx,
        ui.disclosure({
            summary: .Const("More"),
            isOpen: open,
            children: [idle("Inside", false)],
            styles: [],
        }),
    );
    let _ = page.focus("More");
    let _ = page.key("Enter");
    assert.isTrue(open.get(ctx));
    assert.equal(page.focused(), "More");
}

/// A button named `Open` that opens a dialog inside a stack styled `styles`,
/// and a button named `Other` that counts its presses in `presses`.
fn tucked<C: Ui + Watch>(
    open: Signal<Bool>,
    presses: Signal<Int>,
    styles: [Style],
): Node<C> {
    ui.stack({
        styles: [],
        children: [
            ui.button({
                label: .Const("Open"),
                styles: [],
                onPress: .Some(fn(c) => open.set(c, true)),
            }),
            ui.button({
                label: .Const("Other"),
                styles: [],
                onPress: .Some(fn(c) => presses.set(c, presses.get(c) + 1)),
            }),
            ui.stack({
                styles: styles,
                children: [
                    ui.dialog({
                        isOpen: open,
                        label: .Const("Away"),
                        children: [idle("Lost", false)],
                        styles: [],
                    }),
                ],
            }),
        ],
    })
}

test "a dialog inside a removed stack leaves the focus and the page behind it alone" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let presses = signal(ctx, 0);
    let page = render(ctx, tucked(open, presses, [.Removed(true)]));
    let _ = page.press("Open");
    assert.isTrue(open.get(ctx));
    assert.equal(page.focused(), "Open");
    let _ = page.press("Other");
    assert.equal(presses.get(ctx), 1);
    assert.equal(page.focused(), "Other");
}

test "a dialog inside a stack removed from a breakpoint up is modal on the narrowest page" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let presses = signal(ctx, 0);
    let page = render(ctx, tucked(open, presses, [.At(.Medium, [.Removed(true)])]));
    let _ = page.press("Open");
    assert.equal(page.focused(), "Lost");
    let _ = page.press("Other");
    assert.equal(presses.get(ctx), 0);
}

// The `onFocus` a dialog's focus move runs is a handler like any other, run as
// if fired from the page: what it reads makes nothing re-run when it changes,
// and what it makes lasts as long as what a press makes.

/// A button named `Open` that opens a dialog holding a button named `Count`,
/// which counts its presses into `presses`. `Open` writes whether the pointer
/// is over it to `over`, and `onOpen` and `onCount` are the two buttons'
/// `onFocus`.
fn counts<C: Ui>(
    open: Signal<Bool>,
    over: Signal<Bool>,
    presses: Signal<Int>,
    onOpen: Option<fn(C, Bool) => ()>,
    onCount: Option<fn(C, Bool) => ()>,
): Node<C> {
    ui.stack({
        styles: [],
        children: [
            ui.button({
                label: .Const("Open"),
                styles: [],
                onPress: .Some(fn(c) => open.set(c, true)),
                onHover: .Some(fn(c, on) => over.set(c, on)),
                onFocus: onOpen,
            }),
            ui.dialog({
                isOpen: open,
                label: .Const("Details"),
                children: [
                    ui.button({
                        label: .Const("Count"),
                        styles: [],
                        onPress: .Some(fn(c) => presses.update(c, fn(n) => n + 1)),
                        onFocus: onCount,
                    }),
                ],
                styles: [],
            }),
        ],
    })
}

test "a press in a dialog counts when the opener's onFocus rewrote what its onHover then changes" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let over = signal(ctx, false);
    let presses = signal(ctx, 0);
    let page = render(
        ctx,
        counts(
            open,
            over,
            presses,
            .Some(fn(c, _on) => over.update(c, fn(h) => h)),
            .None,
        ),
    );
    let _ = page.press("Open");
    let _ = page.press("Count");
    assert.equal(presses.get(ctx), 1);
}

test "a press in a dialog counts when its own onFocus rewrote what the opener's onHover then changes" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let over = signal(ctx, false);
    let presses = signal(ctx, 0);
    let page = render(
        ctx,
        counts(
            open,
            over,
            presses,
            .None,
            .Some(fn(c, _on) => over.update(c, fn(h) => h)),
        ),
    );
    let _ = page.press("Open");
    let _ = page.press("Count");
    assert.equal(presses.get(ctx), 1);
}

test "a signal the opener's onFocus makes as a dialog shuts outlasts the dialog opening again" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let made: Signal<Option<Signal<Int>>> = signal(ctx, .None);
    let page = render(
        ctx,
        ui.stack({
            styles: [],
            children: [
                ui.button({
                    label: .Const("Open"),
                    styles: [],
                    onPress: .Some(fn(c) => open.set(c, true)),
                    onFocus: .Some(fn(c, on) => {
                        if (on) { made.set(c, .Some(signal(c, 42))) } else {}
                    }),
                }),
                ui.dialog({
                    isOpen: open,
                    label: .Const("Details"),
                    children: [
                        ui.button({
                            label: .Const("Done"),
                            styles: [],
                            onPress: .Some(fn(c) => open.set(c, false)),
                        }),
                    ],
                    styles: [],
                }),
            ],
        }),
    );
    let _ = page.press("Open");
    let _ = page.press("Done");
    let kept = made.get(ctx);
    open.set(ctx, true);
    match (kept) {
        .Some(s) => assert.equal(s.get(ctx), 42),
        .None => assert.isTrue(false),
    }
}

/// A button named `Open` that opens a dialog holding a button named `Inside`,
/// and a press outside the dialog shuts it. `Open` writes whether the pointer
/// is over it to `over`, and `onOpen` and `onInside` are the two buttons'
/// `onFocus`.
fn dismissable<C: Ui>(
    open: Signal<Bool>,
    over: Signal<Bool>,
    onOpen: Option<fn(C, Bool) => ()>,
    onInside: Option<fn(C, Bool) => ()>,
): Node<C> {
    ui.stack({
        styles: [],
        children: [
            ui.button({
                label: .Const("Open"),
                styles: [],
                onPress: .Some(fn(c) => open.set(c, true)),
                onHover: .Some(fn(c, on) => over.set(c, on)),
                onFocus: onOpen,
            }),
            ui.dialog({
                isOpen: open,
                label: .Const("Details"),
                children: [
                    ui.button({
                        label: .Const("Inside"),
                        styles: [],
                        onPress: .Some(fn(_c) => ()),
                        onFocus: onInside,
                    }),
                ],
                styles: [],
                onPressOutside: .Some(fn(c) => open.set(c, false)),
            }),
        ],
    })
}

test "a press in a dialog is not outside it when the opener's onFocus rewrote what its onHover then changes" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let over = signal(ctx, false);
    let page = render(
        ctx,
        dismissable(open, over, .Some(fn(c, _on) => over.update(c, fn(h) => h)), .None),
    );
    let _ = page.press("Open");
    let _ = page.press("Inside");
    assert.isTrue(open.get(ctx));
}

test "a press in a dialog is not outside it when its own onFocus rewrote what the opener's onHover then changes" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let open = signal(ctx, false);
    let over = signal(ctx, false);
    let page = render(
        ctx,
        dismissable(open, over, .None, .Some(fn(c, _on) => over.update(c, fn(h) => h))),
    );
    let _ = page.press("Open");
    let _ = page.press("Inside");
    assert.isTrue(open.get(ctx));
}
