// design/ui-reactivity.md, "Runtime". Every claim that section makes about
// auto-tracking is one assertion here:
//
//   - a signal reads back what was written, and `update` is read-then-write;
//   - a memo is lazy, caches, and recomputes only after a source it actually
//     read has changed;
//   - a watcher runs once when it is registered and again on every change,
//     and watchers run in the order they were registered;
//   - dependencies are re-collected per run, so a read behind a condition is
//     tracked exactly — the branch not taken creates no edge;
//   - `Prop.Const` registers nothing.
//
// The `Recorder` is how a computation says that it ran: a reactive closure
// receives a `Scope`, which grants reading the graph and nothing else, so it
// cannot write a signal and it cannot print.

from "core/testing/assert" import * as assert;
from "ui/effect" import { Scope, Ui, Watch };
from "ui/prop" import { memo, Prop };
from "ui/signal" import { Signal, signal, watch };
from "ui/testing" import { headless, observer, Recorder, recorder };

// --- helpers -----------------------------------------------------------------------

/// A reactive closure is `fn(Scope) => ()`, so anything it calls that answers a
/// value needs somewhere for the value to go.
fn ignore(value: Int): () {
    let _ = value;
}

/// Reads a prop twice inside one computation. A memo that recomputed per read
/// would be noted twice.
fn readTwice(ctx: Scope, p: Prop<Int>): Int {
    p.read(ctx) + p.read(ctx)
}

/// A read behind a condition. Which of `left` and `right` is read depends on a
/// third signal, which is the whole point: the edge to the other one must not
/// exist.
fn pick(ctx: Scope, useLeft: Signal<Bool>, left: Signal<Int>, right: Signal<Int>): Int {
    if (useLeft.get(ctx)) { left.get(ctx) } else { right.get(ctx) }
}

/// The `mapCtx` shape (SPEC 10.6): the handler takes its context as a
/// parameter, so it captures nothing effect-carrying and may freely capture a
/// `Signal`.
fn apply<C: Ui>(ctx: C, handler: fn(C) => ()): () {
    handler(ctx)
}

// --- signals -------------------------------------------------------------------------

test "a signal reads back what was written" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let n = signal(ctx, 1);
    assert.eq(n.get(ctx), 1);
    let _ = n.set(ctx, 7);
    assert.eq(n.get(ctx), 7);
}

test "update writes a function of the old value" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let n = signal(ctx, 10);
    let _ = n.update(ctx, fn(v) => v + 5);
    assert.eq(n.get(ctx), 15);
    let _ = n.update(ctx, fn(v) => v * 2);
    assert.eq(n.get(ctx), 30);
}

test "two signals are two cells" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let a = signal(ctx, 1);
    let b = signal(ctx, 2);
    let _ = a.set(ctx, 100);
    assert.eq(a.get(ctx), 100);
    assert.eq(b.get(ctx), 2);
}

test "a signal holds any type, not only numbers" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let name = signal(ctx, "ada");
    let _ = name.set(ctx, "grace");
    assert.eq(name.get(ctx), "grace");
}

test "a handler captures the signal and receives the context as a parameter" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let count = signal(ctx, 0);
    let _ = apply(ctx, fn(c) => count.update(c, fn(n) => n + 1));
    let _ = apply(ctx, fn(c) => count.update(c, fn(n) => n + 1));
    assert.eq(count.get(ctx), 2);
}

// --- watchers ------------------------------------------------------------------------

test "a watcher runs when it is registered" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 3);
    let _ = watch(ctx, fn(s) => ignore(log.note(n.get(s))));
    assert.eq(log.noted(), [3]);
}

test "a watcher runs again when something it read changes" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 3);
    let _ = watch(ctx, fn(s) => ignore(log.note(n.get(s))));
    let _ = n.set(ctx, 4);
    let _ = n.set(ctx, 5);
    assert.eq(log.noted(), [3, 4, 5]);
}

test "writing the value already there is not a change" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 3);
    let _ = watch(ctx, fn(s) => ignore(log.note(n.get(s))));
    let _ = n.set(ctx, 3);
    assert.eq(log.noted(), [3]);
}

test "a watcher that read nothing never runs again" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 3);
    let _ = watch(ctx, fn(s) => log.record("once"));
    let _ = n.set(ctx, 4);
    assert.eq(log.recorded(), ["once"]);
}

test "watchers run in the order they were registered" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 0);
    let _ = watch(ctx, fn(s) => firstOf(log, n.get(s)));
    let _ = watch(ctx, fn(s) => secondOf(log, n.get(s)));
    assert.eq(log.recorded(), ["first", "second"]);
    let _ = n.set(ctx, 1);
    assert.eq(log.recorded(), ["first", "second", "first", "second"]);
}

fn firstOf(log: Recorder, value: Int): () {
    let _ = log.record("first");
}

fn secondOf(log: Recorder, value: Int): () {
    let _ = log.record("second");
}

// --- memos ---------------------------------------------------------------------------

test "a memo nothing reads never runs" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 2);
    let doubled = memo(ctx, fn(s) => log.note(n.get(s) * 2));
    let _ = n.set(ctx, 3);
    assert.eq(log.noted().len(), 0);
}

test "reading a memo twice in one computation runs it once" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 2);
    let doubled = memo(ctx, fn(s) => log.note(n.get(s) * 2));
    let _ = watch(ctx, fn(s) => ignore(readTwice(s, doubled)));
    assert.eq(log.noted(), [4]);
}

test "a memo recomputes once per change to what it read" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 2);
    let doubled = memo(ctx, fn(s) => log.note(n.get(s) * 2));
    let _ = watch(ctx, fn(s) => ignore(doubled.read(s)));
    assert.eq(log.noted(), [4]);
    let _ = n.set(ctx, 5);
    assert.eq(log.noted(), [4, 10]);
    let _ = n.set(ctx, 5);
    assert.eq(log.noted(), [4, 10]);
}

test "a memo answers the value it computed" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 6);
    let doubled = memo(ctx, fn(s) => n.get(s) * 2);
    let _ = watch(ctx, fn(s) => ignore(log.note(doubled.read(s))));
    let _ = n.set(ctx, 7);
    assert.eq(log.noted(), [12, 14]);
}

test "a memo of a memo settles in one pass" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 1);
    let doubled = memo(ctx, fn(s) => n.get(s) * 2);
    let quadrupled = memo(ctx, fn(s) => doubled.read(s) * 2);
    let _ = watch(ctx, fn(s) => ignore(log.note(quadrupled.read(s))));
    let _ = n.set(ctx, 3);
    assert.eq(log.noted(), [4, 12]);
}

// --- exact tracking ------------------------------------------------------------------

test "a read behind a condition is tracked exactly" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let useLeft = signal(ctx, true);
    let left = signal(ctx, 1);
    let right = signal(ctx, 100);
    let _ = watch(ctx, fn(s) => ignore(log.note(pick(s, useLeft, left, right))));
    assert.eq(log.noted(), [1]);

    // `right` was not read on that run, so writing it is not a reason to run
    // again.
    let _ = right.set(ctx, 200);
    assert.eq(log.noted(), [1]);

    // Flipping the condition re-collects: `right` is read now and `left` is not.
    let _ = useLeft.set(ctx, false);
    assert.eq(log.noted(), [1, 200]);
    let _ = left.set(ctx, 2);
    assert.eq(log.noted(), [1, 200]);
    let _ = right.set(ctx, 300);
    assert.eq(log.noted(), [1, 200, 300]);
}

// --- props ---------------------------------------------------------------------------

test "a constant prop registers nothing" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let unrelated = signal(ctx, 0);
    let p: Prop<Int> = .Const(7);
    let _ = watch(ctx, fn(s) => ignore(log.note(p.read(s))));
    let _ = unrelated.set(ctx, 1);
    assert.eq(log.noted(), [7]);
}

test "a cell prop reads through to its signal" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 3);
    let p: Prop<Int> = .Cell(n);
    let _ = watch(ctx, fn(s) => ignore(log.note(p.read(s))));
    let _ = n.set(ctx, 4);
    assert.eq(log.noted(), [3, 4]);
}

test "a computed prop is a derivation, and needs no enclosing context to build" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let n = signal(ctx, 3);
    let p = plusOne(n);
    let _ = watch(ctx, fn(s) => ignore(log.note(p.read(s))));
    let _ = n.set(ctx, 10);
    assert.eq(log.noted(), [4, 11]);
}

/// Pure: no `ctx`, no bound. Building a derivation is what a component does,
/// and a component that only reads props has no context parameter at all
/// (SPEC 10.4).
fn plusOne(n: Signal<Int>): Prop<Int> {
    .Computed(fn(s) => n.get(s) + 1)
}

// --- the design's example ------------------------------------------------------------

// design/ui-reactivity.md, "Example". Everything reactive about the counter is
// here: an effectful component takes `ctx: C` bounded by `Ui` and creates a
// signal; a pure one derives from it without a context at all; the handler
// captures the signal and takes its context as a parameter. What is missing is
// the tree — `ui.column`, `ui.button`, `ui.text`, `ui.mount` — which is the
// next wave, so the component answers its signal instead of a `Node<C>`.

fn counter<C: Ui>(ctx: C, label: Str): Signal<Int> {
    signal(ctx, 0)
}

fn badge(count: Prop<Int>): Prop<Int> {
    .Computed(fn(c) => count.read(c) * 2)
}

test "the counter counts, and its doubled badge follows" {
    let ctx = context {
        Ui: headless(),
        Watch: observer(),
    };
    let log = recorder();
    let count = counter(ctx, "clicks");
    let doubled = badge(.Cell(count));
    let _ = watch(ctx, fn(s) => ignore(log.note(doubled.read(s))));

    let _ = apply(ctx, fn(c) => count.update(c, fn(n) => n + 1));
    let _ = apply(ctx, fn(c) => count.update(c, fn(n) => n + 1));

    assert.eq(count.get(ctx), 2);
    assert.eq(log.noted(), [0, 2, 4]);
}
