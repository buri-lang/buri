// `let _ = <Result>` is a hard type error (`result-discarded`), so `ignore` is
// the only way to drop one on purpose. That makes it the greppable escape
// hatch, and this lint is the grep — a warning, not an error, because dropping
// the failure may well be what was meant.
//
// **A print is not an exception**, and both shapes are here so that the rule's
// totality is what is pinned rather than a habit. `record()` is an ordinary
// fallible call; `io.println` is the commonest one there is, because `Stdout`
// answers `Result<(), IoError>` — and the rule does not tell them apart. The
// edits below remove both, one with `?` and one with `mapErr`, which are two of
// the answers the diagnostic names.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

fn record(): Result<(), Str> {
    .Ok(()
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let _ = record().ignore();
    let _ = io.println(ctx, "done").ignore();
    .Ok(())
}
