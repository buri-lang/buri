// A marker says the code is unfinished, and `buri lint` is where the
// unfinished work is listed rather than found by whichever grep somebody
// remembers to run.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

// TODO: decide what this program is for.
fn banner(): Str {
    "TODO is a marker in a comment and not in a string"
}

export fn main(host: NodeHost): Result<() Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, banner()).mapErr(fn(_e) => "could not write to standard output")
}
