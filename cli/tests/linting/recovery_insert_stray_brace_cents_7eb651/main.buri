// `cents` and `tax` are read below. `packer` is filled in at the one literal
// there is and read nowhere, and `note` is not filled in at all — `Option`
// field elision lets a literal leave it out, and a field the author no longer
// has to write is still a field nobody reads. Both are reported, and the
// second is the reason the rule asks about reads rather than about mentions:
// counting construction would have made an elided field used by the literal
// that does not mention it.
//
// Neither carries `export`, so neither is on the library's surface however
// published the type around it is. A field without `export` is private to the
// module that declares it, and this module is the whole of what could read it.

export struct Entry {
  export cents: I64,
  export tax: I64,
  packer: Str,
  note: Option<Str>,
}

export fn entry(cents: I64): Entry {
  Entry { cents, tax: 0@ , packer: "till" }
}

export fn total(e: Entry): I64 {
  e.cents + e.tax
}
