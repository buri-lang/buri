// `Ledger` and `entries` carry `export`, so whether they are exempt is decided
// by what `lib.buri` publishes — and the line that decides it did not resolve.
// Nothing is reported about either while that stands.
//
// `seal` carries no `export`, so it could never have been on the surface
// whatever that line said. The doubt does not reach it and it is reported at
// once, beside the error: a declaration the parser skipped and an import that
// did not resolve are both still text, and what a name is used by is read out
// of the text.

export struct Ledger {
  export entries: I64,
  seal: Str,


export fn ledger(entries: I64): Ledger {
  Ledger { entries, seal: "" }
}

export fn markupCents(cents: I64): I64 { cents + 5 }
