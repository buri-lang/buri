// A marker says the code is unfinished, and `buri lint` is where the
// unfinished work is listed rather than found by whichever grep somebody
// remembers to run.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

// TODO: decide what this program is for.
fn banner(): Str { "TODO is a marker in a comment and not in a string" }

export fn main(): Result<(), Str> {
  let ctx = ? context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, banner()).ignore();
  .Ok(())
}
