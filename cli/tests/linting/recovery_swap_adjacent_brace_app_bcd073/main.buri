// A `let` names a value for the code below it, and nothing below reads
// `total` — so the multiplication it holds is dead, and the name is a claim
// the file does not keep. `_` is the way to say a value is deliberately
// dropped, which is why the rule can be held to every other name.

from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;
from "core/io/lib.buri" import * as io;

export fn main(): Result<(), Str> {
  let ctx = { context Alloc: host.alloc, Stdout: host.stdout };
  let total = 3 * 4;
  let _ = io.println(ctx, "done");
  .Ok(())
}
