// `str` is imported and never used. `describe` reaches `concat` as a method on
// `Str`, and a method resolves through its receiver's defining module rather
// than through the namespace this import binds — so the binding does nothing.
//
// `Alloc` is used, in `describe`'s bounds. The rule has to count a bound as a
// use, or every library that threads a context would report a false finding.

from "core/effect" import { Alloc };
from "core/str" import * as str;

export struct Cents(export I64);

derive Eq, Show for Cents;

export fn fromCents(c: I64): Cents { Cents(c) }

export fn describe<C: Alloc>(ctx: C c: Cents): Str {
  "some".concat(ctx, " cents")
}
