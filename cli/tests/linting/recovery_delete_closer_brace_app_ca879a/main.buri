// A timeout kept as a count with its unit in the name, and the multiply that
// converts it: time-unit-conversion, at the constant and at each multiply. The
// parts-per-million denominator below is the same literal and is not a
// finding — a million is a million of something, and this rule reads the name
// beside it rather than the number.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

let NANOSECONDS_PER_MILLISECOND: I64 = 1_000_000;

let PPM_DENOMINATOR: Int = 1_000_000;

let IDLE_TIMEOUT_MILLIS: I64 = 30_000;

fn deadlineNanos(startedNanos: I64): I64 {
    startedNanos + IDLE_TIMEOUT_MILLIS * 1_000_000
}

fn elapsedMillis(nanoseconds: I64): I64 {
    nanoseconds / NANOSECONDS_PER_MILLISECOND
}

fn perMillion(count: Int, share: Int): Int {
    count * share / PPM_DENOMINATOR
}

// The million may come first, and it is the same conversion. A count of
// milliseconds times a thousand is not one: that is microseconds, and nothing
// in `core/time` is spelled that way.
fn graceNanos(): I64 {
    1_000_000 * IDLE_TIMEOUT_MILLIS
}

fn graceMicros(): I64 {
    IDLE_TIMEOUT_MILLIS * 1000
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let waited = elapsedMillis(deadlineNanos(0) + graceNanos() + graceMicros();
    io
        .println(ctx, "${waited} ${perMillion(2_000_000, 250)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
