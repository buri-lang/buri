//! Prints a banner. Module documentation is never a finding.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

// A line comment.
fn banner(): Str {
    /* A block comment. */
    "// a string /* that looks like */ a comment"
}

/* An outer block /* with a nested block */ inside it. */
/// The program's entry point. Declaration documentation is never a finding.
export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, banner().mapErr(fn(_e) => "could not write to standard output") // a trailing comment
}
//// Four slashes is an ordinary comment, not documentation.
