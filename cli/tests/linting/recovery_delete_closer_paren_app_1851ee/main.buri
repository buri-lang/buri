// Five branches wrapped around one another: the reader of the innermost one
// holds four conditions to get there. The `else if` ladder below is the same
// number of `if`s and is not a finding — it is one decision written flat.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

fn size(n: I64): Str {
  if (n > 0) {
    if (n > 10) {
      if (n > 100) {
        if (n > 1000) {
          if (n > 10000) { "huge" } else { "large" }
        } else { "big" }
      } else { "medium" }
    } else { "small" }
  } else { "none" }
}

fn ladder(n: I64): Str {
  if (n == 0) { "zero" } else if (n == 1) { "one" } else if (n == 2) { "two" } else { "more" }
}

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = io.println(ctx, "${size(5000} ${ladder(1)}");
  .Ok(())
}
