// `let _ = <Result>` is a hard type error (`result-discarded`), so `ignore` is
// the only way to drop one on purpose. That makes it the greppable escape
// hatch, and this lint is the grep — a warning, not an error, because dropping
// the failure may well be what was meant.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

fn record(): Result<(), Str> { .Ok(()) }

export fn main(): Result<extra (), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = record().ignore();
  let _ = io.println(ctx, "done");
  .Ok(())
}
