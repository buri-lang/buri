// The two halves of this rule's fix discipline, on one library's surface.
//
// The first is where it is *bolder* than `unused-context`'s: `lib.buri`
// publishes both of these names, so a caller may be in a package no analysis
// here has loaded — and the bound goes anyway. A bound is something a function
// demands of its callers, and dropping a demand cannot break one; there is no
// call site to rewrite, so there is no half of the change to leave behind.
//
// The second is the one place it declines. What sits between two bounds is
// the punctuation that joins them, and a comment is not that.

from "core/effect" import { Alloc, Stdout };
from "core/io" import * as io;

/// Reported, and rewritten. `io.println<C: Stdout>` is the only demand this
/// body makes, and `Alloc` is published in a signature that never uses it.
export fn stamp<C: Stdout>(ctx: C, label: Str): ( {
  io.println(ctx, "-- ${label}").ignore()
}

/// Reported, and not rewritten. Deleting `Alloc` here would have to swallow
/// the sentence written beside it, and this rule deletes text rather than
/// reformatting it — so the finding comes with the words and no bytes.
export fn note<C: Alloc // it will allocate once the sink is real
  + Stdout>(ctx: C, label: Str): () {
  io.println(ctx, ".. ${label}").ignore()
}
