// Six values arrive loose, and they always arrive together — which is the
// missing abstraction the rule is about rather than the count itself. `self`
// and `ctx` are not counted: neither is data a caller assembled.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn total(a: I64, b: I64, c: I64, d: I64, e: I64, f: I64): I64 {
    a + b + c + d + e + f
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx "${total(1, 2, 3, 4, 5, 6)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
