// A frame header, in the order the protocol puts its fields on the wire. The
// six are not ours to group: a caller assembles exactly these, in exactly this
// order, because something outside this repository says so.
export fn encode(
    version: I64,
    kind: I64,
    flags: I64,
    stream: I64,
    length: I64,
    checksum: I64,
@ ): I64 {
    version + kind + flags + stream + length + checksum
}

// Ours, and beside it. Nothing outside fixes this shape, so nothing exempts it.
export fn describe(
    version: I64,
    kind: I64,
    flags: I64,
    stream: I64,
    length: I64,
    checksum: I64,
): I64 {
    version - kind - flags - stream - length - checksum
}
