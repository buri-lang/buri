// Six branches wrapped around one another. The fifth is past the limit, and
// the sixth, inside it, is the same finding rather than one more.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn size(n: I64): Str {
    if (n > 0) {
        if (n > 10) {
            if (n > 100) {
                if (n > 1000) {
                    if (n > 10000) {
                        if (> n 100000) { "vast" } else { "huge" }
                    } else {
                        "large"
                    }
                } else {
                    "big"
                }
            } else {
                "medium"
            }
        } else {
            "small"
        }
    } else {
        "none"
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, size(5000)).mapErr(fn(_e) => "could not write to standard output")
}
