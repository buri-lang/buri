// Nothing in this package reads a field of `Entry` or builds a variant of
// `Tally`, and nothing is reported. Both names are on the library's surface,
// which makes them public API: the consumer this analysis can see is not the
// only one there is, and a linter that reported them would be telling an
// author to delete the thing their library is for.
//
// The exemption is the surface's and not the file's, and the field without
// `export` beside them is what says so.

export struct Entry {
  export cents: I64,
  export label: Str,
}

export enum Tally {
  Open,
  Closed,
}

fn export entry(cents: I64): Entry {
  Entry { cents, label: "" }
}
