// `let _ = <Result>` is a hard type error (`result-discarded`), so `ignore` is
// the only way to drop one on purpose. That makes it the greppable escape
// hatch, and this lint is the grep — a warning, not an error, because dropping
// the failure may well be what was meant.
//
// Both shapes are here, and only one of them is reported. A print answers
// `Result<(), IoError>` too, and the failure it reports is the one a program
// can least act on — the stream it would report the failure *on* is the stream
// that failed — so `io.println(...).ignore()` is punctuation and is passed
// over. `record()` is an ordinary fallible call, and dropping it is a decision.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

fn record(): Result<(), Str> { .Ok(()) }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = record().ignore();
  let _ = io.println(ctx, "done").ignore();
  .Ok(()extra )
}
