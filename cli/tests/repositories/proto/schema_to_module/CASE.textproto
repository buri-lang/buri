# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a .proto in a package is a generator's input: undeclared until a `generators` entry names it, hand-authored because `buri gen` cannot place it, keyed by its contents, and reachable only through lib.buri"

# A schema no entry hands to a tool is `unused-library`, exactly as a stray
# .buri is — and the fix names `generators` rather than `sources`. Nothing can
# read it either: the module a schema becomes is the one a generator handed
# back, and nothing ran one.
run {
  args: ["lint", "//lib/wire"]
  exit: 1
  golden: "undeclared.txt"
}

# `buri gen` leaves it alone. Which generator owns a file is not something the
# tool can derive — `generators` is hand-authored, like `visibility` and
# `outputs` — so the field it does manage, `sources`, is the whole of what it
# has to say here.
run {
  args: ["gen", "//lib/wire"]
  exit: 0
  golden: "gen.txt"
}

file {
  path: "lib/wire/BUILD.buri"
  golden: "regenerated.buri"
}

# The field that used to declare it is retired, and says so by name rather than
# as an unknown field somebody might read as their own typo.
edit {
  file: "lib/wire/BUILD.buri"
  replace: "library {"
  with: "library {\n    proto_sources: [\"point.proto\"]"
}

run {
  args: ["lint", "//lib/wire"]
  exit: 2
  golden: "retired.txt"
}

# So the entry is written by hand, which is the one step of this walkthrough
# that is a person's.
edit {
  file: "lib/wire/BUILD.buri"
  replace: "    proto_sources: [\"point.proto\"]"
  with: "    generators: [\n        { tool: \"std/codegen/proto\", inputs: [\"point.proto\"] },\n    ]"
}

run {
  args: ["gen", "//lib/wire", "--check"]
  exit: 0
  golden: "gen_again.txt"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}

# The generated module carries a `generate` action of its own, keyed on the
# schema's contents.
run {
  args: ["build", "//cmd/app", "--explain"]
  exit: 0
  golden: "explain.txt"
}

# The program built from it runs, and the bytes are the wire format's:
# field 1 varint 1 (0x08 0x01), field 2 varint 300 (0x10 0xac 0x02). Both are
# `Option`s, because edition 2026 tracks presence on a singular field.
run {
  args: ["run", "//cmd/app"]
  exit: 0
  golden: "run.txt"
}

# Nothing changed, so nothing is rebuilt.
run {
  args: ["build", "//cmd/app", "--explain"]
  exit: 0
  golden: "cached.txt"
}

# Editing the schema changes the key, and the artifact.
edit {
  file: "lib/wire/point.proto"
  replace: "int32 y = 2;"
  with: "int32 y = 3;"
}

run {
  args: ["run", "//cmd/app"]
  exit: 0
  golden: "after_edit.txt"
}

# A generated module is internal to the rule that declared the generator:
# another package reaches it the way it reaches any other internal module,
# through `lib.buri`.
edit {
  file: "cmd/app/main.buri"
  replace: "from \"//lib/wire\" import"
  with: "from \"//lib/wire/point.proto\" import"
}

run {
  args: ["build", "//cmd/app"]
  exit: 1
  golden: "internal.txt"
}
