from "core/bytes" import * as bytes;
from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/wire" import { decodePoint, defaultPoint, encodePoint, Point };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let p = Point { ..defaultPoint(), x: .Some(1), y: .Some(300) };
    let _ = io
        .println(ctx, bytes.toHex(ctx, encodePoint(ctx, p)))
        .mapErr(fn(_e) => "could not write to standard output")?;
    io
        .println(ctx, "${decodePoint(ctx, encodePoint(ctx, p)) == .Ok(p)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
