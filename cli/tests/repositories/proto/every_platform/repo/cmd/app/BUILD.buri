binary {
    dependencies: ["//lib/wire"]

    outputs: [
        { platform: "node", entries: [
            { name: "main", function: "mainForNode" },
        ] },
        { platform: "web", entries: [
            { name: "main", function: "mainForWeb" },
        ] },
        { platform: "//platform/cloudflare_worker", entries: [
            { name: "fetch", function: "handle" },
        ] },
        { platform: "native", variant: "linux-x86_64" },
        { platform: "native", variant: "macos-arm64" },
    ]
}
