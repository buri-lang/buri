// One program, five outputs. Everything below is written against the module
// `std/codegen/proto` produced, so each output that compiles is that module
// compiling for that platform.
from "core/bytes" import * as bytes;
from "core/effect" import { Alloc, Request, Response, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/net/http" import * as http;
from "//lib/wire" import { decodePoint, defaultPoint, encodePoint, Point };

fn hex<C: Alloc>(ctx: C): Str {
    let p = Point { ..defaultPoint(), x: .Some(1), y: .Some(300) };
    bytes.toHex(ctx, encodePoint(ctx, p))
}

/// The worker's entry. A page and a worker get no standard output, so the
/// answer travels back as the response body.
export fn handle(_request: Request): Response {
    let ctx = context { Alloc: host.alloc };
    http.text(ctx, hex(ctx))
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let p = Point { ..defaultPoint(), x: .Some(1), y: .Some(300) };
    let _ = io
        .println(ctx, hex(ctx))
        .mapErr(fn(_e) => "could not write to standard output")?;
    io
        .println(ctx, "${decodePoint(ctx, encodePoint(ctx, p)) == .Ok(p)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
