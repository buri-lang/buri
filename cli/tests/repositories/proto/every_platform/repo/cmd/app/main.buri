// One program, five outputs. Everything below is written against the module
// `std/codegen/proto` produced, so each output that compiles is that module
// compiling for that platform. Each platform hands its entry its own host, so
// each output enters through a function of its own and all of them share `run`.
from "core/bytes" import * as bytes;
from "core/host" import * as host;
from "core/io" import * as io;
from "core/net/http" import * as http;
from "native" import { NativeHost };
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Request, Response, Stdout };
from "web" import { WebHost };
from "//lib/wire" import { decodePoint, defaultPoint, encodePoint, Point };

fn hex<C: Allocator>(ctx: C): Str {
    let p = Point { ..defaultPoint(), x: .Some(1), y: .Some(300) };
    bytes.toHex(ctx, encodePoint(ctx, p))
}

/// The worker's entry. A page and a worker get no standard output, so the
/// answer travels back as the response body.
export fn handle(_request: Request): Response {
    let ctx = context {
        Allocator: host.alloc,
    };
    http.text(ctx, hex(ctx))
}

export fn main(host: NativeHost): Result<(), Str> {
    run(context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    })
}

export fn mainForNode(host: NodeHost): Result<(), Str> {
    run(context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    })
}

export fn mainForWeb(host: WebHost): Result<(), Str> {
    run(context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    })
}

fn run<C: Allocator + Stdout>(ctx: C): Result<(), Str> {
    let p = Point { ..defaultPoint(), x: .Some(1), y: .Some(300) };
    let _ = io
        .println(ctx, hex(ctx))
        .mapErr(fn(_e) => "could not write to standard output")?;
    io
        .println(ctx, "${decodePoint(ctx, encodePoint(ctx, p)) == .Ok(p)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
