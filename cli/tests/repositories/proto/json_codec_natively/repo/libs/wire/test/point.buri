from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/json" import * as json;
from "core/json" import { Json };
from "core/testing/assert" import * as assert;
from "//libs/wire" import { decodePointJson, defaultPoint, encodePointJson, Point };

/// The document a piece of text describes. Every text below is a literal, so
/// `.Null` is unreachable.
fn doc<C: Alloc>(ctx: C, source: Str): Json {
    match (json.parse(ctx, source)) {
        .Ok(v) => v,
        .Err(_e) => Json.Null,
    }
}

test "a point round-trips through JSON" {
    let ctx = context {
        Alloc: alloc(),
    };
    let p = Point { ..defaultPoint(), x: .Some(3) };
    let back = assert.ok(decodePointJson(ctx, encodePointJson(ctx, p)));
    assert.eq(back, p);
}

// The member the decoder reads is a JSON number, which reaches the generated
// code as an `F64` — so this is the case the suite is here for: `num.F64.toI64`
// answering `.Ok` on a value that is an integer and `.Err` on one that is not.
test "a fractional member is not an int32" {
    let ctx = context {
        Alloc: alloc(),
    };
    assert.eq(
        decodePointJson(ctx, doc(ctx, "{\"x\":2.5}")),
        .Err(.BadJson { path: "$.x", wanted: "an integer" }),
    );
}
