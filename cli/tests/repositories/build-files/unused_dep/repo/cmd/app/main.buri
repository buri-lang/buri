// Declares //lib/money and never touches it. The graph says this binary
// depends on money; the code says otherwise, and the graph is the thing that
// gets read by everyone who is not reading the code.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("no money here");
  .Ok(())
}
