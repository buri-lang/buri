// A page: the smallest program that binds the reactive graph, styles something
// statically, and mounts. It is here to pin what a WEB output *is* — three
// files, one of them loadable in a browser as it stands.
from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;
from "core/io/lib.buri" import * as io;
from "ui/effect/lib.buri" import { Event, Ui, Watch };
from "ui/node/lib.buri" import * as ui;
from "ui/node/lib.buri" import { Node };
from "ui/prop/lib.buri" import { Prop };
from "ui/signal/lib.buri" import { Signal, signal };
from "ui/style/lib.buri" import { Color, Style };

fn view<C: Ui>(ctx: C, count: Signal<Int>): Node<C> {
  ui.column(
    [.Gap(.Rem(0.5)), .Padding(.Rem(1.0)), .Background(.Rgb(240, 240, 245))],
    [
      ui.text(.Computed(fn(c) => "${count.get(c)}")),
      ui.button(.Const("add one"), fn(c, e) => count.update(c, fn(n) => n + 1)),
    ],
  )
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc: host.alloc,
    Stdout: host.stdout,
    Ui: host.ui,
    Watch: host.watch,
  };
  let count = signal(ctx, 0);
  let _ = io.println(ctx, "mounted");
  ui.mount(ctx, view(ctx, count), [])
}
