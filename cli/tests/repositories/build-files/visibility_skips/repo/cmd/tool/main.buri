// Reaches the co-located library through //cmd/tool. That edge is implicit —
// it is not in `dependencies` and could not be — so visibility never sees it.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//cmd/tool" import { render };
from "//cmd/tool/flags.buri" import { label };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "${label()}: ${render(1)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
