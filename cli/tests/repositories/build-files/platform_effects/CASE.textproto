# **Which effects a platform offers, decided while the file is being edited.**
#
# A platform's host type is the list of effects it offers: `WebHost` has no
# `fs`, so a page that reaches for one is a type error at the line that asked,
# reported by `buri lint`, `buri test` and the language server alike. The steps
# below are the whole matrix:
#
#   * the clean repository, which is most of the value — a library taking an
#     `FileSystemRead` bound, a suite built on `platform/effect/testing`'s test
#     implementations, and a page with both in its closure, none of which may
#     light up;
#   * a page reaching for `host.fs`, refused on the field, with a note naming
#     the platforms that do offer the effect;
#   * a binary with two outputs entering through one `main`: refused, because
#     the two platforms hand their entries different hosts;
#   * the same body on `node`, whose host has a filesystem, which compiles;
#   * a suite that declares `backends: [JS]` over a binary whose `outputs` say
#     `native`: it compiles, because a test never calls `main` and so never
#     needs the native host;
#   * a library that imports `platform/host` to build itself a filesystem,
#     refused as `host-import-outside-platform` — only a platform names the
#     backends' production values.
#
# `buri lint` rather than `buri build` throughout, on purpose: a lint builds no
# output, so a diagnostic recorded here is one that arrives before anything is
# produced.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "an effect a target's platform does not offer is a compile error, reported before anything is built"

# Nothing fires. A bound is not an authority, a test implementation is not a
# host, and a rule that declares no platforms commits to none.
run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}

# The page reaches for a filesystem its host does not have. The caret lands on
# the field, and the note says which platforms offer it.
edit {
  file: "cmd/page/main.buri"
  replace: "from \"core/io\" import * as io;"
  with: "from \"core/fs\" import { FileSystemRead };\nfrom \"core/io\" import * as io;"
}

edit {
  file: "cmd/page/main.buri"
  replace: "        Stdout: host.stdout,"
  with: "        Stdout: host.stdout,\n        FileSystemRead: host.fs,"
}

run {
  args: ["lint", "//cmd/page"]
  exit: 1
  golden: "page_has_no_fs.txt"
}

run {
  args: ["lint", "//cmd/page", "--error-format=json"]
  exit: 1
  golden: "page_has_no_fs.json"
}

# Two outputs entering through one `main`. Each platform hands its entry its
# own host, so one function can't serve both.
edit {
  file: "cmd/page/BUILD.buri"
  replace: "        { platform: \"web\" },"
  with: "        { platform: \"node\" },\n        { platform: \"web\" },"
}

run {
  args: ["lint", "//cmd/page"]
  exit: 1
  golden: "two_outputs.txt"
}

# And a page that compiles: the same body on `node`, whose host has `fs`, so
# the rule is shown firing and not firing over the same file.
edit {
  file: "cmd/page/BUILD.buri"
  replace: "        { platform: \"node\" },\n        { platform: \"web\" },"
  with: "        { platform: \"node\" },"
}

edit {
  file: "cmd/page/main.buri"
  replace: "from \"web\" import { WebHost };"
  with: "from \"node\" import { NodeHost };"
}

edit {
  file: "cmd/page/main.buri"
  replace: "export fn main(host: WebHost)"
  with: "export fn main(host: NodeHost)"
}

run {
  args: ["lint", "//cmd/page"]
  exit: 0
  golden: "js_grants_it.txt"
}

# A suite is where the platform comes from next. `outputs` says `native`, so
# `main` takes `NativeHost` and binds `Listen`; `test.backends` says JS. The
# suite compiles and passes, because a test never calls `main` and so never
# needs the host it takes.
edit {
  file: "cmd/page/BUILD.buri"
  replace: "        { platform: \"node\" },"
  with: "        { platform: \"native\", variant: \"linux-x86_64\" },"
}

edit {
  file: "cmd/page/main.buri"
  replace: "from \"node\" import { NodeHost };"
  with: "from \"native\" import { NativeHost };"
}

edit {
  file: "cmd/page/main.buri"
  replace: "export fn main(host: NodeHost)"
  with: "export fn main(host: NativeHost)"
}

edit {
  file: "cmd/page/main.buri"
  replace: "import { Allocator, Stdout };"
  with: "import { Allocator, Listen, Stdout };"
}

edit {
  file: "cmd/page/main.buri"
  replace: "        FileSystemRead: host.fs,"
  with: "        FileSystemRead: host.fs,\n        Listen: host.listen,"
}

edit {
  file: "cmd/page/BUILD.buri"
  replace: "        sources: [\"test/page.buri\"]"
  with: "        sources: [\"test/page.buri\"]\n        backends: [JS]"
}

run {
  args: ["test", "//cmd/page"]
  exit: 0
  golden: "suite_platform.txt"
}

# The library half. `lib/native` declares `backends: [NATIVE]` and imports
# `core/fs` — an effect *type*, legal everywhere. Naming the backend's own
# filesystem is refused before a platform is ever consulted: only a platform
# names the backends' production values.
edit {
  file: "lib/native/lib.buri"
  replace: "from \"core/fs\" import { FileSystemRead };"
  with: "from \"core/fs\" import { FileSystemRead };\nfrom \"platform/host\" import { HostFileSystem };"
}

run {
  args: ["lint", "//lib/native"]
  exit: 1
  golden: "library_cannot_import_the_host.txt"
}
