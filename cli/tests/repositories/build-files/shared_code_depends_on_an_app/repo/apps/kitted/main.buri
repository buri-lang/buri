from "core/io" import * as io;
from "platform/effect" import { Allocator, Stdout };
from "//platform/kit" import { KitHost };

export fn main(host: KitHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, "kitted").mapErr(fn(_e) => "could not write")
}
