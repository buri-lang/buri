// The case BUILD-FILES.md:374-386 calls out. The only import is //lib/ledger.
// `priceOf` returns a `Cents`, and `format` is one of its methods — a method
// resolves through its receiver's type rather than through scope, so this
// target depends on //lib/money and no import says so.

from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

from "//lib/ledger/lib.buri" import { priceOf };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("price: ${priceOf(3).format(ctx)}");
  .Ok(())
}
