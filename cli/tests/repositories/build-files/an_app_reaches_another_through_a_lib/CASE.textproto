# //apps/web depends only on //libs/bridge, and //libs/bridge depends on
# //apps/api. Every edge is visible, and no edge joins two apps, yet
# //apps/api's code would be linked into //apps/web. Shared code reaches no
# app, so building //apps/web is refused at //libs/bridge's edge, the one that
# is wrong.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "an app that reaches another app's library through a library in libs/: shared-depends-on-app at the library's edge, from the app's build"

run {
  args: ["build", "//apps/web"]
  exit: 1
  golden: "build.txt"
}

run {
  args: ["lint", "//apps/web"]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["test", "//apps/web"]
  exit: 1
  golden: "test.txt"
  stream: ERR
}
