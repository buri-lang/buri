# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a tool that imports a library its build file does not name: missing-dependency says to add it by hand, because `buri gen` leaves a tool's build file alone"

run {
  args: ["lint", "//tools/gen"]
  exit: 1
  golden: "lint.txt"
}

edit {
  file: "tools/gen/BUILD.buri"
  replace: "tool {"
  with: "tool {\n    dependencies: [\"//lib/money\"]"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
