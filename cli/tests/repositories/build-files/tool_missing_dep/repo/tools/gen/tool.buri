//! Generates nothing. It imports //lib/money, which `BUILD.buri` does not name.

from "core/tool" import { Generated, GenerateRequest };
from "platform/effect" import { Allocator };
from "//lib/money" import { Cents, fromCents };

export let PRICE: Cents = fromCents(450);

export fn generate<C: Allocator>(ctx: C, request: GenerateRequest<Str>): Generated {
    let shown = PRICE.show(ctx);
    Generated { modules: [], diagnostics: [], needs: [shown] }
}
