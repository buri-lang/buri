// A page whose editor is the code nothing else on it touches, so the editor
// ships in a file of its own. The worker beside it loads the same editor, and
// gets a chunk of its own: a chunk belongs to an artifact, and these are two.
from "core/effect" import { Allocator, Request, Response, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/lazy" import * as lazy;
from "core/net/http" import * as http;
from "core/str" import * as str;
from "//lib/report" import * as report;

fn markTheChunk<C: Allocator>(ctx: C, rows: Int): Str {
    str.format(ctx, "ONLY_IN_THE_CHUNK ${rows}")
}

fn editor<C: Allocator + Stdout>(ctx: C, rows: Int): () {
    io.println(ctx, markTheChunk(ctx, rows)).ignore()
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, "ONLY_IN_THE_PAGE").ignore();
    let open = lazy.load(editor);
    let _ = open(ctx, 3);
    let _ = io.println(ctx, report.render(ctx, 9)).ignore();
    .Ok(())
}

export fn fetch(request: Request): Response {
    let ctx = context {
        Allocator: host.alloc,
    };
    let write = lazy.load(markTheChunk);
    http.text(ctx, write(ctx, request.path().length()))
}
