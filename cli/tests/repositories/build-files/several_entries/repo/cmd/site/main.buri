// One binary, two ways in. The page enters at `main` and binds the reactive
// graph; the worker enters at `fetch` and binds nothing a page has. Each entry
// builds its own context, and neither is refused on the other's behalf.
from "core/effect" import { Allocator, Request, Response, Stdout };
from "core/host" import * as host;
from "core/net/http" import * as http;
from "ui/effect" import { Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };

fn view<C: Ui>(ctx: C, path: Str): Node<C> {
    ui.column([], [ui.text(.Const(path))])
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Ui: host.ui,
        Watch: host.watch,
    };
    ui.mount(ctx, view(ctx, "/"), [])
}

export fn fetch(request: Request): Response {
    let ctx = context {
        Allocator: host.alloc,
    };
    http.text(ctx, request.path())
}
