// One binary, two ways in. The page enters at `main` and binds the reactive
// graph from its host; the worker enters at `fetch` and binds its allocator
// from the repository platform's host. Each entry builds its own context, and
// neither is refused on the other's behalf.

from "core/net/http" import * as http;
from "platform/effect" import { Allocator, Request, Response, Stdout, Ui, Watch };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "web" import { WebHost };
from "//platform/cloudflare_worker" import { CloudflareHost };

fn view<C: Ui>(ctx: C, path: Str): Node<C> {
    ui.stack({
        styles: [.Layout(.Column)],
        children: [ui.text({ content: .Const(path) })],
    })
}

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Ui: host.ui,
        Watch: host.watch,
    };
    ui.mount(ctx, view(ctx, "/"), [])
}

export fn fetch(host: CloudflareHost, request: Request): Response {
    let ctx = context {
        Allocator: host.alloc,
    };
    http.text(ctx, request.path())
}
