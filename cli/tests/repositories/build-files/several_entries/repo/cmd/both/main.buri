// Two outputs, two entries. A page and a plain JavaScript program take
// different hosts, so each output enters through a function of its own, and
// both delegate to one function that takes `ctx`.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "web" import { WebHost };

derive Equal for Page;
/// Exported, and not a function. An output cannot enter through it.
export struct Page {
    title: Str,
}

export fn main(host: WebHost): Result<(), Str> {
    run(context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    })
}

export fn mainForNode(host: NodeHost): Result<(), Str> {
    run(context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    })
}

fn run<C: Allocator + Stdout>(ctx: C): Result<(), Str> {
    let _ = io.println(ctx, Page { title: "both" }.title).ignore();
    .Ok(())
}
