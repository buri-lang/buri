# **One app, several outputs.** A binary declares a page and a worker out of
# one `main.buri`, and the four claims that makes are all here.
#
#   * **Two artifacts, one per output.** The page is `.buri/out/web/`, the
#     worker is `.buri/out/platform/cloudflare_worker/`, and the worker's file is named
#     after its entry, `fetch`, because two outputs of one binary otherwise
#     write one path.
#   * **The platform calls a worker.** The worker is `//platform/cloudflare_worker`,
#     a repository platform whose `fetch.mjs` is the module's default export;
#     the page's module ends in the self-starting epilogue every other
#     JavaScript platform gets.
#   * **Each entry takes its own platform's host.** `main` takes `WebHost` and
#     binds `Ui: host.ui`; the worker's `fetch` takes `CloudflareHost`.
#   * **Dead code is eliminated per entry.** The worker never reaches the
#     reactive graph, so `mount` is not in its bytes; the page never reaches
#     `fetch`, so the worker's crossing is not in its.
#
#   * **`buri run` runs the page, and never the worker.** A worker is called by
#     its platform, once per request, so there is nothing to start. `//cmd/site`
#     runs its page; `//cmd/worker`, which declares a worker and nothing else,
#     is refused.
#
#   * **Two outputs take two entries.** `//cmd/both` is a page and a plain
#     JavaScript program, and `entries` sends the node output to `mainForNode`.
#     Pointing both outputs at `main` is refused: one function can't take two
#     hosts.
#
# Then the refusals, one per way `entries` can be wrong: an entry the platform
# does not have, a name the binary does not export, a name that is a keyword, a name that is exported and is not a
# function, a name that is not a name at all and the empty one, an entry with
# type parameters, and an entry whose host, parameter or answer is not the one
# its platform declares.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a binary declares several outputs, each entering through its own function, and each artifact holds only what its entry reaches"

run {
  args: ["build", "//cmd/site"]
  exit: 0
  golden: "built.txt"
}

# The worker is called, not started. Its whole surface is the default export.
file {
  path: ".buri/out/platform/cloudflare_worker/cmd/site/fetch.mjs"
  contains: "export default"
}

# And the page is started, not called.
file {
  path: ".buri/out/web/cmd/site/site.mjs"
  absent: "export default"
}

# Dead code elimination, per entry, read off the artifacts. `$crossRequestIn`
# is the worker's crossing and `$mount` is the page's; each artifact has
# exactly the one its own entry reaches.
file {
  path: ".buri/out/platform/cloudflare_worker/cmd/site/fetch.mjs"
  contains: "$crossRequestIn"
}

file {
  path: ".buri/out/web/cmd/site/site.mjs"
  absent: "$crossRequestIn"
}

# A page is three files, and a worker is one: there is no document to shell and
# no stylesheet to link.
file {
  path: ".buri/out/web/cmd/site/site.html"
  contains: "site.mjs"
}

# Built twice from two fresh sessions with the cache off. Two entries out of one
# set of sources is two monomorphizations, and both have to be functions of
# their inputs alone.
run {
  args: ["build", "//cmd/site", "--check-reproducible"]
  exit: 0
}

# A binary with a page and a worker runs the page, and `buri run` on a page is
# a server — so that claim moved to a tier that can talk to one:
# `build::serving::a_binary_with_a_worker_beside_its_page_serves_the_page`
# starts this same shape and reads the shell back off a socket. It used to be a
# row here, exiting 0 with nothing to show for it.
#
# A binary that is only a worker has nothing to start at all: its `fetch.mjs`
# is called by the worker runtime. The refusal says why rather than handing a
# JavaScript runtime a module that would sit there exporting a `fetch` nobody
# calls.
run {
  args: ["run", "//cmd/worker"]
  exit: 2
  golden: "no_worker_to_run.txt"
}

# Refusal one: an output naming a function `main.buri` does not export. The page
# lists what it does export, because the mistake is almost always a spelling.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\" }"
  with: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"handle\" }] }"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "no_such_entry.txt"
}

# …and when the spelling is close, the fix names the candidate rather than
# leaving it in a note the reader has to act on themselves.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"handle\" }] }"
  with: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"fetsh\" }] }"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "entry_is_a_near_miss.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"fetsh\" }] }"
  with: "{ platform: \"//platform/cloudflare_worker\" }"
}

# Refusal two: the entry is there and has the wrong shape. The platform
# declares `fetch(host: CloudflareHost, request: Request): Response`, and this
# one takes no host.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(host: CloudflareHost, request: Request): Response {\n    let ctx = context {\n        Allocator: host.alloc,\n    };\n    http.text(ctx, request.path())"
  with: "export fn fetch(request: Request): Response {\n    http.status(404)"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "fetch_takes_its_host.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Request): Response {\n    http.status(404)"
  with: "export fn fetch(host: CloudflareHost, request: Request): Response {\n    let ctx = context {\n        Allocator: host.alloc,\n    };\n    http.text(ctx, request.path())"
}

# Refusal three: an entry that could not be a function name at all. The
# compiler has nothing to look up, so the reader refuses it where it is written.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\" }"
  with: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"fetch handler\" }] }"
}

run {
  args: ["build", "//cmd/site"]
  exit: 2
  golden: "entry_is_not_a_name.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"fetch handler\" }] }"
  with: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"\" }] }"
}

run {
  args: ["build", "//cmd/site"]
  exit: 2
  golden: "entry_is_empty.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"\" }] }"
  with: "{ platform: \"//platform/cloudflare_worker\" }"
}

# And a `name` in `entries` the platform does not offer: a worker is entered
# through `fetch`, never `main`.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\" }"
  with: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"main\", function: \"fetch\" }] }"
}

run {
  args: ["build", "//cmd/site"]
  exit: 2
  golden: "no_such_platform_entry.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"main\", function: \"fetch\" }] }"
  with: "{ platform: \"//platform/cloudflare_worker\" }"
}

# An entry filled twice: the two items would disagree about its function.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\" }"
  with: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"fetch\" }, { name: \"fetch\", function: \"main\" }] }"
}

run {
  args: ["build", "//cmd/site"]
  exit: 2
  golden: "duplicate_entry.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "{ platform: \"//platform/cloudflare_worker\", entries: [{ name: \"fetch\", function: \"fetch\" }, { name: \"fetch\", function: \"main\" }] }"
  with: "{ platform: \"//platform/cloudflare_worker\" }"
}

# Refusal four: the entry has the right arity and the wrong argument. The
# platform hands it a `Request`, so nothing else can be the parameter.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(host: CloudflareHost, request: Request): Response {"
  with: "export fn fetch(host: CloudflareHost, request: Str): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request.path())"
  with: "    http.text(ctx, request)"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "fetch_takes_a_request_and_not_a_string.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(host: CloudflareHost, request: Str): Response {"
  with: "export fn fetch(host: CloudflareHost, request: Request): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request)"
  with: "    http.text(ctx, request.path())"
}

# And the answer is fixed too: a worker answers a `Response`, because that is
# what the platform declares.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(host: CloudflareHost, request: Request): Response {"
  with: "export fn fetch(host: CloudflareHost, request: Request): Str {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request.path())"
  with: "    request.path()"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "fetch_answers_a_response.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(host: CloudflareHost, request: Request): Str {"
  with: "export fn fetch(host: CloudflareHost, request: Request): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    request.path()"
  with: "    http.text(ctx, request.path())"
}

# **Two outputs, two entries.** A page and a plain JavaScript program take
# different hosts, so `//cmd/both`'s JavaScript program enters through
# `mainForNode`, and its artifact is named after it.
run {
  args: ["build", "//cmd/both"]
  exit: 0
  golden: "both_built.txt"
}

file {
  path: ".buri/out/node/cmd/both/mainForNode.mjs"
  contains: "mainForNode"
}

# One function can't be both: `main` takes `WebHost`, and the node output
# hands its entry a `NodeHost`.
edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: \"node\", entries: [\n            { name: \"main\", function: \"mainForNode\" },\n        ] }"
  with: "{ platform: \"node\" }"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "one_entry_two_platforms.txt"
}

edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: \"node\" }"
  with: "{ platform: \"node\", entries: [\n            { name: \"main\", function: \"mainForNode\" },\n        ] }"
}

# An entry the binary exports, and it is not a function. The entries table holds
# the exported free functions and nothing else, so a struct is as absent as a
# name nobody wrote.
edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: \"web\" }"
  with: "{ platform: \"web\", entries: [{ name: \"main\", function: \"Page\" }] }"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "entry_is_not_a_function.txt"
}

# A name that is a keyword reads as a name the reader will accept and the
# compiler will not find — which is the right answer, because no `main.buri` can
# export one.
edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: \"web\", entries: [{ name: \"main\", function: \"Page\" }] }"
  with: "{ platform: \"web\", entries: [{ name: \"main\", function: \"match\" }] }"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "entry_is_a_keyword.txt"
}

edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: \"web\", entries: [{ name: \"main\", function: \"match\" }] }"
  with: "{ platform: \"web\" }"
}

# An entry with type parameters. The runtime calls it, so there is nothing to
# infer them from.
edit {
  file: "cmd/both/main.buri"
  replace: "export fn main(host: WebHost): Result<(), Str> {"
  with: "export fn main<T>(host: WebHost): Result<(), Str> {"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "entry_has_type_parameters.txt"
}

edit {
  file: "cmd/both/main.buri"
  replace: "export fn main<T>(host: WebHost): Result<(), Str> {"
  with: "export fn main(host: WebHost): Result<(), Str> {"
}
