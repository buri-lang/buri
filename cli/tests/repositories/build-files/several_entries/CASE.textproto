# **One app, several outputs.** A binary declares a page and a worker out of
# one `main.buri`, and the four claims that makes are all here.
#
#   * **Two artifacts, one per output.** The page is `.buri/out/web/`, the
#     worker is `.buri/out/cloudflare-worker/`, and the worker's file is named
#     after its entry because two outputs of one binary otherwise write one
#     path.
#   * **The platform calls a worker.** Its module ends in a default export the
#     worker runtime invokes; the page's ends in the self-starting epilogue
#     every other JavaScript platform gets.
#   * **Each entry is checked against its own platform.** `main` binds
#     `Ui: host.ui`, which a worker does not grant; `fetch` builds a context of
#     its own beside it. Neither is refused, because a `core/host` name inside
#     an entry's body is checked against the outputs that enter through *that*
#     entry.
#   * **Dead code is eliminated per entry.** The worker never reaches the
#     reactive graph, so `mount` is not in its bytes; the page never reaches
#     `fetch`, so the worker's bridge is not in its.
#
#   * **`buri run` runs the page, and never the worker.** A worker is called by
#     its platform, once per request, so there is nothing to start. `//cmd/site`
#     runs its page; `//cmd/worker`, which declares a worker and nothing else,
#     is refused.
#
#   * **Two outputs may share one entry.** `//cmd/both` is a page and a plain
#     JavaScript program out of one `main`, and gets one artifact each. Its body
#     is then checked against *both* platforms, which is the per-entry rule read
#     from the other end.
#   * **A helper is not an entry.** The same `host.ui` that is fine inside
#     `main` is refused in a function beside it, naming the worker, because a
#     `core/host` name outside an entry's body is checked against every output.
#
# Then the refusals, one per way an `entry` can be wrong: a name the binary does
# not export, a name that is a keyword, a name that is exported and is not a
# function, a name that is not a name at all and the empty one, an entry with
# type parameters, and an entry whose parameter or answer is not the one its
# platform fixes.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a binary declares several outputs, each entering through its own function, and each artifact holds only what its entry reaches"

run {
  args: ["build", "//cmd/site"]
  exit: 0
  golden: "built.txt"
}

# The worker is called, not started. Its whole surface is the default export.
file {
  path: ".buri/out/cloudflare-worker/cmd/site/fetch.mjs"
  contains: "export default"
}

# And the page is started, not called.
file {
  path: ".buri/out/web/cmd/site/site.mjs"
  absent: "export default"
}

# Dead code elimination, per entry, read off the artifacts. `$fetchEntry` is
# the worker's bridge and `$mount` is the page's; each artifact has exactly the
# one its own entry reaches.
file {
  path: ".buri/out/cloudflare-worker/cmd/site/fetch.mjs"
  contains: "$fetchEntry"
}

file {
  path: ".buri/out/web/cmd/site/site.mjs"
  absent: "$fetchEntry"
}

# A page is three files, and a worker is one: there is no document to shell and
# no stylesheet to link.
file {
  path: ".buri/out/web/cmd/site/site.html"
  contains: "site.mjs"
}

# Built twice from two fresh sessions with the cache off. Two entries out of one
# set of sources is two monomorphizations, and both have to be functions of
# their inputs alone.
run {
  args: ["build", "//cmd/site", "--check-reproducible"]
  exit: 0
}

# A binary with a page and a worker runs the page, and `buri run` on a page is
# a server — so that claim moved to a tier that can talk to one:
# `build::serving::a_binary_with_a_worker_beside_its_page_serves_the_page`
# starts this same shape and reads the shell back off a socket. It used to be a
# row here, exiting 0 with nothing to show for it.
#
# A binary that is only a worker has nothing to start at all. The refusal
# says why rather than handing a JavaScript runtime a module that would sit
# there exporting a `fetch` nobody calls.
run {
  args: ["run", "//cmd/worker"]
  exit: 2
  golden: "no_worker_to_run.txt"
}

# Refusal one: an output naming a function `main.buri` does not export. The page
# lists what it does export, because the mistake is almost always a spelling.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "entry: \"fetch\""
  with: "entry: \"handle\""
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "no_such_entry.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "entry: \"handle\""
  with: "entry: \"fetch\""
}

# Refusal two: the entry is there and has the wrong shape. A worker's entry
# takes a request and answers a response, and this one runs itself.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Request): Response {"
  with: "export fn fetch(): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request.path())"
  with: "    http.text(ctx, \"you are nowhere\")"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "fetch_takes_a_request.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(): Response {"
  with: "export fn fetch(request: Request): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, \"you are nowhere\")"
  with: "    http.text(ctx, request.path())"
}

# Refusal three: an `entry` that could not be a function name at all. The
# compiler has nothing to look up, so the reader refuses it where it is written.
edit {
  file: "cmd/site/BUILD.buri"
  replace: "entry: \"fetch\""
  with: "entry: \"fetch handler\""
}

run {
  args: ["build", "//cmd/site"]
  exit: 2
  golden: "entry_is_not_a_name.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "entry: \"fetch handler\""
  with: "entry: \"\""
}

run {
  args: ["build", "//cmd/site"]
  exit: 2
  golden: "entry_is_empty.txt"
}

edit {
  file: "cmd/site/BUILD.buri"
  replace: "entry: \"\""
  with: "entry: \"fetch\""
}

# Refusal four: the entry has the right arity and the wrong argument. The
# platform hands it a `Request`, so nothing else can be the parameter.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Request): Response {"
  with: "export fn fetch(request: Str): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request.path())"
  with: "    http.text(ctx, request)"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "fetch_takes_a_request_and_not_a_string.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Str): Response {"
  with: "export fn fetch(request: Request): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request)"
  with: "    http.text(ctx, request.path())"
}

# And the answer is fixed too: a worker answers a `Response`, because that is
# what the platform reads off it.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Request): Response {"
  with: "export fn fetch(request: Request): Str {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    http.text(ctx, request.path())"
  with: "    request.path()"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "fetch_answers_a_response.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Request): Str {"
  with: "export fn fetch(request: Request): Response {"
}

edit {
  file: "cmd/site/main.buri"
  replace: "    request.path()"
  with: "    http.text(ctx, request.path())"
}

# **A helper is not an entry.** Per-entry checking is exactly the entry's own
# body: a `core/host` name anywhere else in `main.buri` is checked against every
# platform the outputs name, because any of them may reach it. So the same
# `host.ui` that is fine inside `main` is refused inside a function beside it,
# and the refusal names the worker.
edit {
  file: "cmd/site/main.buri"
  replace: "fn view<C: Ui>(ctx: C, path: Str): Node<C> {"
  with: "fn theUi(): () {\n    let _ = host.ui;\n    ()\n}\n\nfn view<C: Ui>(ctx: C, path: Str): Node<C> {"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "a_helper_is_not_an_entry.txt"
}

edit {
  file: "cmd/site/main.buri"
  replace: "fn theUi(): () {\n    let _ = host.ui;\n    ()\n}\n\nfn view<C: Ui>(ctx: C, path: Str): Node<C> {"
  with: "fn view<C: Ui>(ctx: C, path: Str): Node<C> {"
}

# **Two outputs, one entry.** Nothing says an entry belongs to one output.
# `//cmd/both` declares a page and a plain JavaScript program that are the same
# function, and gets one artifact each.
run {
  args: ["build", "//cmd/both"]
  exit: 0
  golden: "both_built.txt"
}

# And the body is then checked against *both* platforms, not either. `Ui` is
# granted on WEB and not on JS, so binding it here is refused naming the output
# that does not grant it — which is the per-entry rule read from the other end.
edit {
  file: "cmd/both/main.buri"
  replace: "from \"core/io\" import * as io;"
  with: "from \"core/io\" import * as io;\nfrom \"ui/effect\" import { Ui };"
}

edit {
  file: "cmd/both/main.buri"
  replace: "        Stdout: host.stdout,\n    };"
  with: "        Stdout: host.stdout,\n        Ui: host.ui,\n    };"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "one_entry_two_platforms.txt"
}

edit {
  file: "cmd/both/main.buri"
  replace: "        Stdout: host.stdout,\n        Ui: host.ui,\n    };"
  with: "        Stdout: host.stdout,\n    };"
}

edit {
  file: "cmd/both/main.buri"
  replace: "from \"core/io\" import * as io;\nfrom \"ui/effect\" import { Ui };"
  with: "from \"core/io\" import * as io;"
}

# An entry the binary exports, and it is not a function. The entries table holds
# the exported free functions and nothing else, so a struct is as absent as a
# name nobody wrote.
edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: WEB, entry: \"main\" }"
  with: "{ platform: WEB, entry: \"Page\" }"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "entry_is_not_a_function.txt"
}

# A name that is a keyword reads as a name the reader will accept and the
# compiler will not find — which is the right answer, because no `main.buri` can
# export one.
edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: WEB, entry: \"Page\" }"
  with: "{ platform: WEB, entry: \"match\" }"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "entry_is_a_keyword.txt"
}

edit {
  file: "cmd/both/BUILD.buri"
  replace: "{ platform: WEB, entry: \"match\" }"
  with: "{ platform: WEB, entry: \"main\" }"
}

# An entry with type parameters. The runtime calls it, so there is nothing to
# infer them from.
edit {
  file: "cmd/both/main.buri"
  replace: "export fn main(): Result<(), Str> {"
  with: "export fn main<T>(): Result<(), Str> {"
}

run {
  args: ["build", "//cmd/both"]
  exit: 1
  golden: "entry_has_type_parameters.txt"
}

edit {
  file: "cmd/both/main.buri"
  replace: "export fn main<T>(): Result<(), Str> {"
  with: "export fn main(): Result<(), Str> {"
}
