// Imports //lib/money, which `cmd/app/BUILD.buri` does not name in
// `dependencies`. The module resolves — the loader searches the workspace —
// so this builds, and the graph is a description of something other than the
// code until `buri lint` says so.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/money" import { fromCents };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "cents: ${fromCents(450).show(ctx)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
