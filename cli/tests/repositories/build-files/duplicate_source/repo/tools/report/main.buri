from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

// Through the library's entry point, which is the only way the binary may
// reach it (BUILD-FILES.md:301-305). What this case is about is one file
// listed twice, so nothing else here is allowed to fire.
from "//tools/report" import { render };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, render(0)).mapErr(fn(_e) => "could not write to standard output")
}
