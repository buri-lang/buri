// A second module of the library, reached by render.buri and not re-exported
// by lib.buri. It is exactly the sort of name a binary sitting in the same
// directory is tempted to reach for — and the rule says it may not, because
// the boundary belongs to the library rule rather than to the directory.

export fn verbose(n: I64): Str {
    if (n < 0) { "negative" } else { "some" }
}
