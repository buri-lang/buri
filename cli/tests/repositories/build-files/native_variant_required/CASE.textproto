# `native`'s `main` entry says `variant_required`, so an output of it names a
# variant. Every command that reads the build file refuses one that doesn't, at
# the output, listing the variants there are. A variant `native` doesn't declare
# lists them too.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "an output missing the variant its platform requires is refused by build, test and lint, listing the variants, and so is a variant the platform does not declare"

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "missing_variant.txt"
}

run {
  args: ["test", "//cmd/app"]
  exit: 2
  golden: "missing_variant_test.txt"
}

run {
  args: ["lint", "//cmd/app"]
  exit: 2
  golden: "missing_variant_lint.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"native\" },"
  with: "{ platform: \"native\", variant: \"linux-mips\" },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "unknown_variant.txt"
}
