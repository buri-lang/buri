# //apps/shop/web reaches //apps/shop/cart, a package of its own app, and
# //libs/money. //apps/shop/cart is generated by //tools/gen. None of that
# crosses into another app, so all of it builds.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "an app depending on its own packages, on libs/ and on a generator under tools/ is allowed"

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "lint.txt"
}

run {
  args: ["build", "//..."]
  exit: 0
}

run {
  args: ["run", "//apps/shop/web"]
  exit: 0
  golden: "run.txt"
  stream: OUT
}
