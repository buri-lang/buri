# Every spelling a build file wrote before platforms were strings is refused,
# with what replaced it. There is no migration tool: the fix in each refusal is
# the whole of the migration.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "each retired platform spelling is refused with `retired-platform`, each retired output field with `retired-output-field`, and the fix names what replaced it"

# The new spellings build, and the suite runs on the backend it names.
run {
  args: ["build", "//cmd/app"]
  exit: 0
}

run {
  args: ["test", "//lib/greet"]
  exit: 0
}

# Retired: an output for Linux.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: LINUX },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "linux.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: LINUX },"
  with: "{ platform: \"node\" },"
}

# Retired: an output for macOS, with its architecture.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: MACOS, arch: ARM64 },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "macos.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: MACOS, arch: ARM64 },"
  with: "{ platform: \"node\" },"
}

# Retired: a JavaScript output.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: JS },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "js.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: JS },"
  with: "{ platform: \"node\" },"
}

# Retired: a page.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: WEB },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "web.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: WEB },"
  with: "{ platform: \"node\" },"
}

# Retired: a Cloudflare Worker, which is a platform a repository writes now.
# The fix shows the shape of one and names the guide.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: CLOUDFLARE_WORKER },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "cloudflare_worker.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: CLOUDFLARE_WORKER },"
  with: "{ platform: \"node\" },"
}

# Retired: `arch` beside a variant.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: \"native\", variant: \"linux-arm64\", arch: ARM64 },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "arch.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"native\", variant: \"linux-arm64\", arch: ARM64 },"
  with: "{ platform: \"node\" },"
}

# Retired: a `js` block.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: \"node\", js { module: ESM } },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "js_block.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\", js { module: ESM } },"
  with: "{ platform: \"node\" },"
}

# Retired: `entry`.
edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\" },"
  with: "{ platform: \"node\", entry: \"main\" },"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "entry.txt"
}

edit {
  file: "cmd/app/BUILD.buri"
  replace: "{ platform: \"node\", entry: \"main\" },"
  with: "{ platform: \"node\" },"
}

# Retired: a suite's `platforms`.
edit {
  file: "lib/greet/BUILD.buri"
  replace: "        backends: [JS]"
  with: "        platforms: [JS]"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "test_platforms.txt"
}

edit {
  file: "lib/greet/BUILD.buri"
  replace: "        platforms: [JS]"
  with: "        backends: [JS]"
}

# Retired: a library's `platforms`.
edit {
  file: "lib/greet/BUILD.buri"
  replace: "    visibility: [\"//visibility:public\"]"
  with: "    visibility: [\"//visibility:public\"]\n    platforms: [LINUX, MACOS]"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "library_platforms.txt"
}

edit {
  file: "lib/greet/BUILD.buri"
  replace: "    visibility: [\"//visibility:public\"]\n    platforms: [LINUX, MACOS]"
  with: "    visibility: [\"//visibility:public\"]"
}

# Retired: a library's `platforms` naming the worker.
edit {
  file: "lib/greet/BUILD.buri"
  replace: "    visibility: [\"//visibility:public\"]"
  with: "    visibility: [\"//visibility:public\"]\n    platforms: [CLOUDFLARE_WORKER]"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "library_cloudflare_worker.txt"
}

edit {
  file: "lib/greet/BUILD.buri"
  replace: "    visibility: [\"//visibility:public\"]\n    platforms: [CLOUDFLARE_WORKER]"
  with: "    visibility: [\"//visibility:public\"]"
}

# Retired: a tag's `forbids`.
edit {
  file: "REPO.buri"
  replace: "    doc: \"runs in a web page\""
  with: "    doc: \"runs in a web page\"\n    forbids { platforms: [WEB] }"
}

run {
  args: ["build", "//cmd/app"]
  exit: 2
  golden: "tag_platforms.txt"
}

edit {
  file: "REPO.buri"
  replace: "    doc: \"runs in a web page\"\n    forbids { platforms: [WEB] }"
  with: "    doc: \"runs in a web page\""
}
