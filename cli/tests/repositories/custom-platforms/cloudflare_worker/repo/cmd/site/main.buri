// A worker that answers with what it was asked: every field of the request
// the runtime hands over, and a response with a header and a status of its own.

from "core/net/http" import * as http;
from "core/str" import * as str;
from "platform/effect" import { Allocator, Method, Request, Response };
from "//platform/cloudflare_worker" import { CloudflareHost };

export fn fetch(host: CloudflareHost, request: Request): Response {
    handle(
        context {
            Allocator: host.alloc,
        },
        request,
    )
}

export fn handle<C: Allocator>(ctx: C, request: Request): Response {
    match (request.path()) {
        // What was sent, read back off the request the runtime handed over.
        "/echo" => http.text(ctx, bodyOrExcuse(ctx, request)),
        "/query" => http.text(ctx, request.query()),
        "/header" => http.text(ctx, request.header("x-asked").withDefault("nothing")),
        // A header the worker writes, which the runtime has to carry back.
        "/tagged" => http.text(ctx, "tagged").withHeader(ctx, "x-answered", "yes"),
        // The answers that are not 200, one of them with no body allowed.
        "/missing" => http.status(404),
        "/broken" => http.status(500),
        "/empty" => http.status(204),
        other => http.text(ctx, str.format(ctx, "${verb(request.method)} ${other}")),
    }
}

/// Every method HTTP has, so a method the crossing drops is a line that
/// changed.
fn verb(method: Method): Str {
    match (method) {
        .Get => "GET",
        .Head => "HEAD",
        .Post => "POST",
        .Put => "PUT",
        .Patch => "PATCH",
        .Delete => "DELETE",
        .Options => "OPTIONS",
    }
}

fn bodyOrExcuse<C: Allocator>(ctx: C, request: Request): Str {
    match (http.bodyText(ctx, request.body)) {
        .Ok(text) => text,
        .Err(_e) => "not utf-8",
    }
}
