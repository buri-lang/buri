# The bundled platforms, `native`, `node` and `web`, are closed: adding one is
# a toolchain change, not a configuration change. So is `Backend`, and so are
# a platform's variants.
#
# Closed means an unknown name is rejected rather than ignored. Four places can
# write one — an output's `platform`, an output's `variant`, and a tag's
# `backends` and `platforms` — and all four are recorded, because a check that
# fires in some of them is a check nobody can rely on.
#
# Exit 2: an unreadable build file is the thing you asked *with* being wrong.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "an unknown platform, variant or backend is rejected in every place one can be written"

run {
  args: ["build", "//cmd/ok"]
  exit: 0
}

edit {
  file: "cmd/ok/BUILD.buri"
  replace: "platform: \"node\""
  with: "platform: \"windows\""
}

run {
  args: ["build", "//cmd/ok"]
  exit: 2
  golden: "unknown_platform.txt"
}

edit {
  file: "cmd/ok/BUILD.buri"
  replace: "platform: \"windows\""
  with: "platform: \"native\", variant: \"linux-riscv\""
}

run {
  args: ["build", "//cmd/ok"]
  exit: 2
  golden: "unknown_variant.txt"
}

edit {
  file: "cmd/ok/BUILD.buri"
  replace: "platform: \"native\", variant: \"linux-riscv\""
  with: "platform: \"node\""
}

# A tag's two lists. A near miss gets a "did you mean", because these are the
# lists a person types by hand rather than ones the generator writes.
edit {
  file: "REPO.buri"
  replace: "can be written.\n"
  with: "can be written.\n\ntag {\n  name: \"server\"\n  requires { backends: [NATIVEE] }\n}\n"
}

run {
  args: ["build", "//cmd/ok"]
  exit: 2
  golden: "unknown_tag_backend.txt"
}

edit {
  file: "REPO.buri"
  replace: "backends: [NATIVEE]"
  with: "platforms: [\"nod\"]"
}

run {
  args: ["build", "//cmd/ok"]
  exit: 2
  golden: "unknown_tag_platform.txt"
}

# And the fix each of them named.
edit {
  file: "REPO.buri"
  replace: "platforms: [\"nod\"]"
  with: "platforms: [\"node\"]"
}

run {
  args: ["build", "//cmd/ok"]
  exit: 0
}
