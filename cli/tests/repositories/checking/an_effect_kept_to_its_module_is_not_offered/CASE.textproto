# `//platform/effect/quiet` declares `effect Quiet` without `export`, and the
# program binds `Quiet` in a context. The name is unknown here, and the report
# doesn't offer to import it from a module that keeps it to itself.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "binding an effect another module keeps private is an unknown effect, with no import offered"

run {
  args: ["build", "//cmd/app"]
  exit: 1
  golden: "refused.txt"
}
