// A cart, a method kept to this module, and an enum that isn't exported but
// reaches other modules through `pick` and `describe`.

export struct Cart(Int);

impl Cart {
    fn audit(self): Int {
        self.0
    }

    export fn total(self): Int {
        self.0 * 2
    }
}

enum Size {
    Small,
    Large { inches: Int },
}

export fn pick(): Size {
    .Large { inches: 3 }
}

export fn describe(s: Size): Int {
    match (s) {
        .Small => 1,
        .Large { inches } => inches,
    }
}
