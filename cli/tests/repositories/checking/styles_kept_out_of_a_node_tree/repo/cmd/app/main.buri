// A program that loads `ui/style` and never `ui/node` builds styles and
// draws no tree.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "ui/style" import { Style };

fn label(styles: [Style]): Str {
    match (styles) {
        [] => "no styles",
        _ => "styled",
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, label([.Width(.Full)])).ignore();
    .Ok(())
}
