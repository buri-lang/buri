// An or-pattern inside another binds its names for the outer alternative,
// so `w` here is one name across all three ways the first arm can match.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

enum Shape {
    Rect(Int, Int),
    Frame(Int),
    Dot(Int),
}

fn pick(s: Shape, n: Int): Int {
    match ((s, n)) {
        (.Rect(w, _) | .Frame(w), 1) | (.Dot(w), _) => w,
        (_, k) => k,
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let picked =
        "${pick(.Frame(3), 1)} ${pick(.Dot(4), 9)} ${pick(.Rect(5, 6), 1)} ${pick(
            .Frame(3),
            2,
        )}";
    io.println(ctx, picked).mapErr(fn(_e) => "could not write to standard output")
}
