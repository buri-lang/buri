# A website: one `main.buri`, a page and a worker, and the document that goes
# between them.
#
#   * **The worker renders.** `fetch` builds the tree, renders it to HTML with
#     `web.render`, and `web.shell` writes the document with the state embedded
#     in it. Both artifacts come out of one build.
#   * **The page resumes.** `main` calls `web.resume`, which takes over the
#     markup the worker sent and picks the state back up. It renders nothing.
#   * **Each artifact holds its own half.** The worker never resumes and the
#     page never renders a document, so neither carries the other's half. That
#     is per-entry dead code elimination, read off the bytes.
#   * **`Location` is the page's alone.** The last edit binds it in the
#     worker's context, which is the one thing this feature adds to the grant
#     table and the one thing it must not widen.
#
# What this case cannot do is *run* either artifact: a worker is called by its
# platform and a page needs a document, and no `buri` command is either.
# `language::a_website_is_rendered_by_its_worker_and_resumed_by_its_page` is the
# tier that does, driving both from a JavaScript module.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a worker renders the tree to a document with its state in it, and the page resumes on top of what it sent"

run {
  args: ["build", "//cmd/site"]
  exit: 0
  golden: "built.txt"
}

# The worker's half: the renderer that writes the markup, and the shell around
# it. `$ui_web_render` is that renderer.
file {
  path: ".buri/out/cloudflare-worker/cmd/site/fetch.mjs"
  contains: "$ui_web_render"
}

file {
  path: ".buri/out/cloudflare-worker/cmd/site/fetch.mjs"
  absent: "$ui_web_resume"
}

# The page's half, and neither of the worker's. A page that carried the
# server's renderer would be shipping the server.
file {
  path: ".buri/out/web/cmd/site/main.mjs"
  contains: "$ui_web_resume"
}

file {
  path: ".buri/out/web/cmd/site/main.mjs"
  absent: "$ui_web_render"
}

# The address bar is a cell of the same graph, so the page carries it and the
# worker has never heard of it.
file {
  path: ".buri/out/web/cmd/site/main.mjs"
  contains: "$host_HostLocation_path"
}

file {
  path: ".buri/out/cloudflare-worker/cmd/site/fetch.mjs"
  absent: "$host_HostLocation_path"
}

# The negative twin. `Location` is granted on WEB and on nothing else, and a
# worker that asks for the address bar is refused where it asked — not because
# the page beside it is fine, but because a worker has no address of its own.
edit {
  file: "cmd/site/main.buri"
  replace: "export fn fetch(request: Request): Response {\n    let ctx = context {\n        Alloc: host.alloc,\n    };"
  with: "export fn fetch(request: Request): Response {\n    let ctx = context {\n        Alloc: host.alloc,\n        Location: host.location,\n    };"
}

run {
  args: ["build", "//cmd/site"]
  exit: 1
  golden: "no_address_bar.txt"
}
