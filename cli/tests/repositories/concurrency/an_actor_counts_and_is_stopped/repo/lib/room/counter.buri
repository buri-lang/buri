// A counter, as `core/actor`'s own module header writes one.

from "core/actor" import { Actor, Stepped };
from "core/effect" import { Allocator, Stdout, Tasks };
from "core/io" import * as io;

export enum CounterMessage {
    Increment,
    /// Multiplies before it adds, so the *order* the messages arrived in is
    /// visible in the answer rather than only their number.
    Add(Int),
    Get,
}

derive Equal, Show for CounterAnswer;
export enum CounterAnswer {
    Done,
    Count(Int),
}

export fn counter<C: Allocator + Stdout + Tasks>(
    initial: Int,
): Actor<C, Int, CounterMessage, CounterAnswer> {
    Actor {
        state: initial,
        onStop: .Some(fn(c, count) => {
            let _ = io.println(c, "final ${count}").ignore();
            ()
        }),
        step: fn(c, count, message) => {
            match (message) {
                .Increment => Stepped { state: count + 1, answer: .Done },
                .Add(n) => Stepped { state: count * 10 + n, answer: .Done },
                .Get => Stepped { state: count, answer: .Count(count) },
            }
        },
    }
}
