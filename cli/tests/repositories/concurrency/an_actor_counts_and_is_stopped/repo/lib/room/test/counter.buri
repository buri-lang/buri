// The suite reaches its own library the way a dependent does — by the
// package's surface — and reaches `core/host/testing` because it is a test
// source and nothing else may.

from "core/actor" import * as actor;
from "core/actor" import { Address };
from "core/effect" import { Alloc, Stdout, Tasks };
from "core/host/testing" import { alloc, stdout, tasks };
from "core/testing/assert" import * as assert;
from "//lib/room" import { counter, CounterAnswer, CounterMessage };

/// Sends `left` messages, one at a time. Every one of them runs the mailbox
/// down before it answers, so the box never grows past the one being stepped.
fn pump<C: Alloc + Stdout + Tasks>(
    ctx: C,
    address: Address<C, Int, CounterMessage, CounterAnswer>,
    left: Int,
): Int {
    if (left <= 0) {
        0
    } else {
        let _ = address.sendMessage(ctx, .Increment).ignore();
        pump(ctx, address, left - 1)
    }
}

test "one sender's messages arrive in the order it sent them" {
    let ctx = context {
        Alloc: alloc(),
        Stdout: stdout(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Increment).ignore();
    let _ = counted.sendMessage(ctx, .Add(2)).ignore();
    let _ = counted.sendMessage(ctx, .Add(3)).ignore();
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(123)));
    assert.eq(counted.stop(ctx), .Ok(()));
}

test "a stop finds the mailbox empty, whatever was sent into it" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    // `stop` discards what is still waiting, and nothing is: sixty-five posts,
    // sixty-five steps, and the hook sees every one of them.
    let counted = actor.start(ctx, counter(0));
    let _ = pump(ctx, counted, 65);
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 65\n");
}

test "more messages than the default mailbox holds still all arrive" {
    let ctx = context {
        Alloc: alloc(),
        Stdout: stdout(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = pump(ctx, counted, 65);
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(65)));
    assert.eq(counted.stop(ctx), .Ok(()));
}

test "onStop runs once, with the final state" {
    let sink = stdout();
    let ctx = context {
        Alloc: alloc(),
        Stdout: sink,
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    let _ = counted.sendMessage(ctx, .Add(4)).ignore();
    assert.eq(counted.sendMessage(ctx, .Get), .Ok(.Count(4)));
    assert.eq(sink.captured(), "");
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(sink.captured(), "final 4\n");
    assert.eq(counted.stop(ctx), .Err(.Stopped));
    assert.eq(sink.captured(), "final 4\n");
}

test "everything after a stop is refused" {
    let ctx = context {
        Alloc: alloc(),
        Stdout: stdout(),
        Tasks: tasks(),
    };
    let counted = actor.start(ctx, counter(0));
    assert.eq(counted.stop(ctx), .Ok(()));
    assert.eq(counted.sendMessage(ctx, .Increment), .Err(.Stopped));
    assert.eq(counted.sendMessage(ctx, .Get), .Err(.Stopped));
}
