// A room, as a function bounded by `Sockets` and nothing else.
//
// Nothing here has ever seen a listener, which is the point: a socket is an
// inert handle, so pushing on one needs the authority to write and no authority
// to accept. There is no "is this socket open" here either, and that is the
// same decision from the other side — `isOpen` is the double's, because a
// program that could ask would be a program racing the far side.

from "core/effect" import { Alloc, Sockets };
from "core/net/server" import { Message, Socket };

/// Pushes `message` at every socket in the room and answers how many it was
/// handed to.
///
/// The count is what the room *pushed*, not what arrived: `send` never waits,
/// and a socket that has already gone takes the message and drops it.
export fn broadcast<C: Alloc + Sockets>(ctx: C, room: [Socket], message: Message): Int {
    let _pushed = room.mapCtx(ctx, fn(c, socket) => {
        let _sent = socket.send(c, message);
        0
    });
    room.len()
}
