// A binary reaches a library by its surface, exactly as another library does.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/ledger" import { entries, total };
from "//lib/money" import { show };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "total ${show(ctx, total(entries()))}")
        .mapErr(fn(_e) => "could not write to standard output")
}
