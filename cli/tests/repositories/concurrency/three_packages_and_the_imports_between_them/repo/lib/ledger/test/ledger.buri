// A suite names its own library the way a dependent does, and reaches the
// testing surface by the path a `testing` segment makes test-only.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/ledger" import { entries, total };
from "//lib/ledger/testing" import { sample };
from "//lib/money" import { fromCents, show };

test "the total is the sum of what is in the ledger" {
    assert.equal(total(entries()), fromCents(3650));
}

test "a fixture from the testing surface is an ordinary entry" {
    assert.equal(total([sample()]), fromCents(1));
}

test "a dependency's own function is reachable through its surface" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(show(ctx, total(entries())), "3650c");
}
