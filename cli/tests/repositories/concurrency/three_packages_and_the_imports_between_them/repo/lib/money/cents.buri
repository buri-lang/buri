from "core/str" import * as str;
from "platform/effect" import { Allocator };

derive Equal, Show for Cents;
export struct Cents(export Int);

export fn fromCents(amount: Int): Cents {
    Cents(amount)
}

export fn show<C: Allocator>(ctx: C, amount: Cents): Str {
    str.format(ctx, "${amount.0}c")
}
