// Four tasks send to one counter whose step sleeps while it holds the state.
// Then a step sends to its own actor, directly and from a fan-out it made.

from "core/actor" import * as actor;
from "core/actor" import { Actor, Address, Stepped };
from "core/effect" import { Allocator, Clock, Stdout, Tasks };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/tasks" import * as tasks;
from "core/time" import * as time;

enum Counting<C> {
    Increment,
    Reenter(fn(C) => Int),
    Get,
}

/// A counter whose `Increment` sleeps, so the state is out while the other
/// senders post. `Reenter` runs a function the sender handed it, which is how a
/// step reaches its own actor without a recursive type.
fn counter<C: Allocator + Clock + Tasks>(): Actor<C, Int, Counting<C>, Int> {
    Actor {
        state: 0,
        step: fn(c, count, message) => {
            match (message) {
                .Increment => {
                    let _ = time.sleep(c, time.milliseconds(5));
                    Stepped { state: count + 1, answer: count + 1 }
                },
                .Reenter(f) => {
                    let call = f;
                    Stepped { state: count, answer: call(c) }
                },
                .Get => Stepped { state: count, answer: count },
            }
        },
    }
}

/// Sends `left` increments, and answers how many were refused.
fn sending<C: Allocator + Clock + Tasks>(
    ctx: C,
    mailbox: Address<C, Int, Counting<C>, Int>,
    left: Int,
    refused: Int,
): Int {
    if (left <= 0) {
        refused
    } else {
        let now = match (mailbox.sendMessage(ctx, .Increment)) {
            .Ok(_count) => refused,
            .Err(_gone) => refused + 1,
        };
        sending(ctx, mailbox, left - 1, now)
    }
}

fn counted<C: Allocator + Clock + Tasks>(
    ctx: C,
    mailbox: Address<C, Int, Counting<C>, Int>,
): Int {
    match (mailbox.sendMessage(ctx, .Get)) {
        .Ok(count) => count,
        .Err(_gone) => -1,
    }
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Clock: host.clock,
        Stdout: host.stdout,
        Tasks: host.tasks,
    };
    let mailbox = actor.start(ctx, counter());
    let senders = [0, 1, 2, 3];
    let refusals = tasks.parallel(ctx, senders, fn(c, _i, _sender) => {
        sending(c, mailbox, 2, 0)
    });
    let _ = io.println(ctx, "refused ${refusals.sum()}").ignore();
    let _ = io.println(ctx, "stepped ${counted(ctx, mailbox)}").ignore();

    // A step that sends to its own actor is refused at once, and so is a task
    // that step fanned out. Neither message is lost: the loop already running
    // steps all three before it puts the state back.
    let started = time.monotonic(ctx);
    let direct = mailbox.sendMessage(
        ctx,
        .Reenter(fn(c) => {
            match (mailbox.sendMessage(c, .Increment)) {
                .Ok(_count) => 1,
                .Err(_gone) => 0,
            }
        }),
    );
    let fanned = mailbox.sendMessage(
        ctx,
        .Reenter(fn(c) => {
            let sent = tasks.parallel(c, [0, 1], fn(c2, _i, _n) => {
                match (mailbox.sendMessage(c2, .Increment)) {
                    .Ok(_count) => 1,
                    .Err(_gone) => 0,
                }
            });
            sent.sum()
        }),
    );
    let quick = time.elapsed(ctx, started).milliseconds() < 5000;
    let _ = io.println(ctx, "direct answered ${direct.withDefault(-1)}").ignore();
    let _ = io.println(ctx, "fanned answered ${fanned.withDefault(-1)}").ignore();
    let _ = io.println(ctx, "refused at once ${quick}").ignore();
    let _ = io.println(ctx, "stepped ${counted(ctx, mailbox)}").ignore();
    let _ = io.println(ctx, "stopped ${mailbox.stop(ctx).isOk()}").ignore();
    .Ok(())
}
