// Every spelling of "this print answered a Result and I have decided what that
// means", in the order a reader meets them.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

/// The context is a parameter, and the effect is performed by handing it to a
/// function that declares it.
fn announce<C: Alloc + Stdout>(ctx: C, label: Str): Result<(), Str> {
    io
        .println(ctx, "-- ${label}")
        .mapErr(fn(_e) => "could not write to standard output")
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    // Nothing follows from a failed write here, and saying so is the whole of
    // what `.ignore()` is for.
    let _ = io.println(ctx, "one").ignore();
    // The caller is a `Result` of its own, so the failure is carried.
    let _ = announce(ctx, "two")?;
    // And where the two ends are different types, a `match` says which is
    // which — the shape `buri init`'s own template writes.
    match (io.println(ctx, "three")) {
        .Ok(_) => .Ok(()),
        .Err(_) => .Err("could not write to standard output"),
    }
}
