# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a tool rule lives under the repository's tools/ directory: a nested //tools/db/schema generates, and a tool rule in the old //tool/db/seed is refused with the path it moves to"

# A tool two directories under `tools/`, and libraries outside it.
run {
  args: ["build", "//lib/app", "//tools/db/schema", "//tool/db/seed"]
  exit: 0
}

# The same package holding a tool rule instead: refused before anything builds.
edit {
  file: "tool/db/seed/BUILD.buri"
  replace: "library {}\n"
  with: "tool {\n    generate {}\n}\n"
}

run {
  args: ["build", "//lib/app"]
  exit: 2
  golden: "outside.txt"
}
