from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Stdout };
from "//lib/edges" import { edges };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Stdout: host.stdout,
    };
    let failed = fn(_e) => "could not print";
    let e = edges;
    let _ = io
        .println(ctx, "${e.v2fa} ${e.type_} ${e.value} ${e.maybe} ${e.level} ${e.num}")
        .mapErr(failed)?;
    let _ = io
        .println(
            ctx,
            "${e.inferred} ${e.ints} ${e.floats} ${e.flags} ${e.words} ${e.none}",
        )
        .mapErr(failed)?;
    let _ = io
        .println(
            ctx,
            "${e.empty} ${e.first} ${e.second} ${e.closed} ${e.control} ${e.below} ${e.under}",
        )
        .mapErr(failed)?;
    let _ = io.println(ctx, "${e.nothing == ()} ${e.units.isSome()}").mapErr(failed)?;
    io.println(ctx, "${e.shape} ${e.shapes}").mapErr(failed)
}
