//! One module, `tables`, holding the SQL for every table the inputs declare.

from "core/buri/ast" import * as ast;
from "core/effect" import { Allocator };
from "core/str" import * as str;
from "core/tool" import { Generated, GenerateRequest };
from "//tool/database_schema_codegen/emit.buri" import { table };
from "//tool/database_schema_codegen/json" import { Config };

export fn generate<C: Allocator>(ctx: C, request: GenerateRequest<Config>): Generated {
    let statements = request
        .inputs
        .mapCtx(ctx, fn(c, input) => {
            input.value.tables.mapCtx(c, fn(c2, t) => table(c2, t)).join(c, "; ")
        })
        .join(ctx, "; ");
    // Every value as it arrived, typed.
    let shown = request
        .inputs
        .mapCtx(ctx, fn(c, input) => str.format(c, "${input.value}"))
        .join(ctx, "; ");
    Generated {
        modules: [
            (
                "tables",
                ast.Module {
                    items: [text("sql", statements), text("shown", shown)],
                    docs: [],
                },
            ),
        ],
        diagnostics: [],
        needs: [],
    }
}

/// `export let <name>: Str = <value>;`
fn text(name: Str, value: Str): ast.Item {
    let ty = ast.Name { text: "Str", origin: ast.nowhere() };
    ast.Item {
        kind: .Let(ast.LetDecl {
            name: ast.Name { text: name, origin: ast.nowhere() },
            ty: ast.Type { kind: .Named(ty, []), origin: ast.nowhere() },
            value: ast.Expr { kind: .Str(value), origin: ast.nowhere() },
            exported: true,
            docs: [],
        }),
        origin: ast.nowhere(),
    }
}
