from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Stdout };
from "//lib/orders" import { shown, sql };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, sql).mapErr(fn(_e) => "could not print")?;
    io.println(ctx, shown).mapErr(fn(_e) => "could not print")
}
