from "core/effect" import { Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/routes" import { shown, table };

export fn main(): Result<(), Str> {
    let ctx = context {
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, table).mapErr(fn(_e) => "could not print")?;
    io.println(ctx, shown).mapErr(fn(_e) => "could not print")
}
