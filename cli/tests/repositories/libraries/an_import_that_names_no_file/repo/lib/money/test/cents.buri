// A suite reaches its own library the way its dependents do: `//lib/money` is
// what `cmd/app/main.buri` writes, and it is what this file writes. Its own
// testing surface is the same. Both of these are correct, and both are one
// segment away from the refusal in `parse.buri`.

from "//lib/money" import { fromCents, isSmall };
from "//lib/money/testing" import { sample };
from "core/testing/assert" import * as assert;

test "a hundred cents is not small" {
  assert.isFalse(isSmall(fromCents(100)));
}

test "the sample is not small either" {
  assert.isFalse(isSmall(sample()));
}
