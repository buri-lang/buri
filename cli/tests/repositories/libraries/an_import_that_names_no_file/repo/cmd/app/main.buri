// This import is *correct*, and it is the same string the test source three
// files away is refused for writing. A path that leaves the package names the
// package; //cmd/app is not //lib/money, so //lib/money is what it writes.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/money" import { fromCents };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, fromCents(450).format(ctx))
        .mapErr(fn(_e) => "could not write to standard output")
}
