# The old spelling, refused, with the new one named.
#
# `//lib/money` used to be how you wrote the library's surface. It names no
# file, so it is no longer a module path at all, and the toolchain says so with
# `import-path-without-a-file` — and then says which file: the note and the
# `fix` edit both carry "//lib/money/lib.buri", derived by resolving the old
# path the old way rather than by appending a suffix to a string.
#
# That matters here in a way a synthetic example cannot show: this repository
# also has `lib/money/cents.buri`, so "//lib/money/cents" would have to become
# "//lib/money/cents.buri" and "//lib/money" has to become
# "//lib/money/lib.buri". One rule cannot produce both from the text; the
# resolver produces both from the layout.
#
# The last two steps are the fix applied by hand, and the build going green:
# what the code action and `buri lint --fix` write is the same string, and a
# suggestion nobody can act on is not a fix.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "an import that names no file is refused, and the diagnostic names the file it meant"

run {
  args: ["build", "//cmd/app"]
  exit: 1
  golden: "build.txt"
}

run {
  args: ["build", "//cmd/app", "--error-format=json", "--force"]
  exit: 1
  golden: "build.json"
}

# The fix, applied. `lint --fix` would write exactly this.
edit {
  file: "cmd/app/main.buri"
  replace: "from \"//lib/money\" import { fromCents };"
  with: "from \"//lib/money/lib.buri\" import { fromCents };"
}

run {
  args: ["build", "//cmd/app"]
  exit: 0
}
