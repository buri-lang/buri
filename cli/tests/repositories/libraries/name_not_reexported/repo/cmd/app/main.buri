// `rawValue` is exported by //lib/money/cents and is not on the library's
// surface, so importing it from //lib/money names something that, from here,
// does not exist.

from "core/effect" import { Allocator, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/money" import { fromCents, rawValue };

export fn main(): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "${rawValue(fromCents(450))}")
        .mapErr(fn(_e) => "could not write to standard output")
}
