// The positive control for the fake: the test binary does reach it, and the
// marker is a real string a real program can print.

from "core/testing/assert" import * as assert;
from "//cmd/app/main.buri" import { banner };
from "//lib/widget/testing" import { fakeWidget };

test "the fake is reachable from a test source" {
    assert.equal(fakeWidget(), "WIDGET-TESTING-ONLY-MARKER");
    assert.equal(banner(), "WIDGET-PRODUCTION-MARKER");
}
