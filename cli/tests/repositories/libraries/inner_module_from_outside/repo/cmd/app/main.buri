// Reaches past lib.buri into a module inside the library. //lib/money/cents is
// a real module and this is a real path; it is simply not this package's to
// name (LIBRARIES.md:80-89).

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/money/cents.buri" import { fromCents };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, fromCents(450).format(ctx))
        .mapErr(fn(_e) => "could not write to standard output")
}
