// The good half. `format` is on //lib/money's surface, so the method resolves
// here. `toCents` is not, and the edit in CASE.textproto adds a call to it.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

from "//lib/money" import { fromCents };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  io.println(ctx, fromCents(450).format(ctx)).mapErr(fn(_e) => "could not write to standard output")
}
