// The entry point, and this binary's surface for its own tests: the suite sees
// what this file exports and nothing more.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

// Re-exported so the suite can reach it. Everything else in routes.buri stays
// inside the binary.
from "//cmd/tool/routes.buri" export { route };

from "//cmd/tool/routes.buri" import { route };

export fn banner(): Str {
    "tool"
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "${banner()}: ${route("/health")}")
        .mapErr(fn(_e) => "could not write to standard output")
}
