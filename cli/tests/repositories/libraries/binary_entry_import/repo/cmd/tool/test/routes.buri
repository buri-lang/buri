// A binary's suite addresses the target under test by its module path, which
// is the one place `//cmd/tool/main` may be written (TESTING.md, "Testing a
// binary").

from "core/testing/assert" import * as assert;
from "//cmd/tool/main.buri" import { banner, route };

test "the entry point's own exports are what the suite sees" {
    assert.eq(banner(), "tool");
    assert.eq(route("/nope"), "fallback");
}
