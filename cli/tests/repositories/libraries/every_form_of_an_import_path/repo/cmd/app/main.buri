from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//cmd/app/routes.buri" import { total };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, "${total()}").mapErr(fn(_e) => "could not write to standard output")
}

/// What the suite calls. `main` takes a host, and a test has none to hand it.
export fn name(): Str {
    "app"
}
