//! The testing surface. From outside this package it is `//lib/money/testing`
//! — a module, and the same string as the label a `test.dependencies`
//! declares. From here, inside the package, `lib.buri` is a file beside it.

from "//lib/money" import { Cents, fromCents };

/// A round figure, for a suite that needs one and does not care which.
export fn sample(): Cents {
    fromCents(1905)
}
