# Every shape a module path takes, in one repository that builds.
#
#   //lib/money/lib.buri            a library's surface
#   //lib/money/cents.buri          a module inside it, from inside it
#   //lib/money/testing/lib.buri    the testing surface, from a test source
#   //cmd/app/main.buri             a binary's entry point, from its own suite
#   //lib/wire/point.proto          a schema — already a file, and unchanged
#   core/effect/lib.buri            the standard library, bare root and all
#   from "..." export { ... }       a re-export, which takes a path like any
#                                   other import
#
# Then the two ways a path that *does* name a file can still name nothing:
# a file that is not there, and a directory that has no `lib.buri` in it. Both
# are `module-not-found` and both name the file they looked for, which is the
# property the whole change is for — the diagnostic can say the file because
# the path was the file.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "every shape of module path in one repository that builds, and the two ways a path that names a file can still name nothing"

run {
  args: ["build", "//...", "--output=js"]
  exit: 0
}

run {
  args: ["test", "//..."]
  exit: 0
  golden: "test.txt"
}

# A file that is not there.
edit {
  file: "cmd/app/routes.buri"
  replace: "from \"//lib/money/lib.buri\" import { Cents, fromCents };"
  with: "from \"//lib/money/nope.buri\" import { Cents, fromCents };"
}

run {
  args: ["build", "//cmd/app", "--output=js"]
  exit: 1
  golden: "no_such_file.txt"
}

# A directory with no `lib.buri` in it. `lib/money/notes/` holds a Buri file
# and no surface, which under the old spelling was a path that resolved to a
# file nobody had written; it still is, and the message still names it.
edit {
  file: "cmd/app/routes.buri"
  replace: "from \"//lib/money/nope.buri\" import { Cents, fromCents };"
  with: "from \"//lib/money/notes/lib.buri\" import { Cents, fromCents };"
}

run {
  args: ["build", "//cmd/app", "--output=js"]
  exit: 1
  golden: "no_such_surface.txt"
}
