// A production source importing a repository `testing/` surface. Declared in
// `dependencies` rather than in `test.dependencies`, so the graph permits it
// and the language must not.

from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

from "//lib/money/testing/lib.buri" import { sample };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println(sample().format(ctx));
  .Ok(())
}
