// A production source importing a repository `testing/` surface. Declared in
// `dependencies` rather than in `test.dependencies`, so the graph permits it
// and the language must not.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/money/testing" import { sample };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, sample().format(ctx))
        .mapErr(fn(_e) => "could not write to standard output")
}
