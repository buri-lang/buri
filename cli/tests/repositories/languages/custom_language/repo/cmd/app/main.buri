from "core/effect" import { Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/colors" import { count };

export fn main(): Result<(), Str> {
    let ctx = context {
        Stdout: host.stdout,
    };
    io.println(ctx, "${count} colors").mapErr(fn(_e) => "could not print")
}
