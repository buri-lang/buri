from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Stdout };
from "//lib/deploy" import { Server, server };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Stdout: host.stdout,
    };
    let typed: Server = server;
    io.println(ctx, "${typed}").mapErr(fn(_e) => "could not print")
}
