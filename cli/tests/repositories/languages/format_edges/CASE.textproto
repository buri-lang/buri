# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "buri format at the edges of each language it lays out: a byte-order mark, a tab, a comment where a line ends, between a name and its value, inside a list, after the last value or with no line break at the end; empty and commented blocks and lists; every number and string spelling; options with nested values and comments; an empty file in each, and files that do not read, left as they are"

# The checked-in REPO.buri is formatted, as every one is; these undo it.
edit {
  file: "REPO.buri"
  replace: "# Two tags"
  with: "\n\n# Two tags"
}

edit {
  file: "REPO.buri"
  replace: "tag {\n    name: \"a\"\n}\n\ntag {"
  with: "tag { name: \"a\" }\ntag {"
}

edit {
  file: "REPO.buri"
  replace: "}\n\nlint {"
  with: "}\nlint {"
}

run {
  args: ["format"]
  exit: 0
  golden: "format.txt"
}

file {
  path: "lib/fmt/edges.proto"
  golden: "edges.proto"
}

file {
  path: "lib/fmt/edges.txtpb"
  golden: "edges.txtpb"
}

file {
  path: "lib/fmt/edges.jsonc"
  golden: "edges.jsonc"
}

file {
  path: "lib/fmt/broken_comment.proto"
  golden: "broken_comment.proto"
}

file {
  path: "REPO.buri"
  golden: "REPO.buri"
}

# A fixed point: a second format changes nothing, and only the files that do
# not read are reported.
run {
  args: ["format", "--check"]
  exit: 1
  golden: "check.txt"
}
