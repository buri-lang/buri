from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

from "//lib/ledger" import { entry, label, zero };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };
  let _ = ctx.println("${label(entry("coffee", zero()))}");
  .Ok(())
}
