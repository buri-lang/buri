from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

from "//lib/ledger" import { entry, label, zero };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };
  let _ = io.println(ctx, "${label(entry("coffee", zero()))}").ignore();
  .Ok(())
}
