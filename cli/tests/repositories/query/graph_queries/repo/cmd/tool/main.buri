from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;

from "//lib/money" import { fromCents };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };
  let _ = io.println(ctx, "${fromCents(450).value}").ignore();
  .Ok(())
}
