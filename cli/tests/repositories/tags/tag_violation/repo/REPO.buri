# The whole tag vocabulary, and the whole of build policy. A build file says
# what its code *is*; these blocks say what follows from that.
# `forbids` is symmetric, so stating it once here is the same as stating it on
# `client`.
tag {
    name: "server"
    doc: "runs on infrastructure we operate"

    forbids {
        tags: ["client"]
    }

    requires {
        platforms: [LINUX, MACOS]
    }
}

tag {
    name: "client"
    doc: "ships to a user's machine or browser"
}

tag {
    name: "browser"
    doc: "runs in a web page, and nowhere else"

    requires {
        platforms: [JS]
    }
}
