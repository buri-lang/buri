// Neither branch below contains both tags. `//lib/left` reaches only server
// code and `//lib/right` only client code; they never reach each other. The
// conflict exists only in the union at this binary, which is what makes tags a
// property of the closure rather than of a path through it.

from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

from "//lib/left/lib.buri" import { vialeft };
from "//lib/right/lib.buri" import { viaright };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("${vialeft()} ${viaright()}");
  .Ok(())
}
