// Neither branch below contains both tags. `//lib/left` reaches only server
// code and `//lib/right` only client code; they never reach each other. The
// conflict exists only in the union at this binary, which is what makes tags a
// property of the closure rather than of a path through it.

from "core/io" import * as io;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/left" import { vialeft };
from "//lib/right" import { viaright };

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "${vialeft()} ${viaright()}")
        .mapErr(fn(_e) => "could not write to standard output")
}
