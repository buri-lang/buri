from "core/net/http" import * as http;
from "core/str" import * as str;
from "platform/effect" import { Allocator, Request, Response };
from "//lib/anyjs" import { greeting };
from "//lib/edge" import { region };
from "//platform/cloudflare_worker" import { CloudflareHost };

export fn fetch(host: CloudflareHost, _request: Request): Response {
    let ctx = context {
        Allocator: host.alloc,
    };
    http.text(ctx, str.format(ctx, "${greeting()} from the ${region()}"))
}
