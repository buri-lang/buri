# A tag's `forbids` is read like its `requires`: an unknown backend or
# platform is rejected with a near miss, each is listed once, and a tag cannot
# both require and forbid the same one.
#
# Exit 2: an unreadable REPO.buri is the thing you asked *with* being wrong.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "forbids rejects an unknown backend or platform, a duplicate, and one the same tag requires"

run {
  args: ["build", "//lib/ok"]
  exit: 2
  golden: "duplicate.txt"
  stream: ERR
}

edit {
  file: "REPO.buri"
  replace: "backends: [JS, JS]"
  with: "backends: [JSS]"
}

run {
  args: ["build", "//lib/ok"]
  exit: 2
  golden: "unknown.txt"
  stream: ERR
}

edit {
  file: "REPO.buri"
  replace: "backends: [JSS]"
  with: "platforms: [\"wbe\"]"
}

run {
  args: ["build", "//lib/ok"]
  exit: 2
  golden: "unknown_platform.txt"
  stream: ERR
}

edit {
  file: "REPO.buri"
  replace: "platforms: [\"wbe\"]\n    }\n"
  with: "backends: [JS]\n    }\n\n    requires {\n        backends: [NATIVE, JS]\n    }\n"
}

run {
  args: ["build", "//lib/ok"]
  exit: 2
  golden: "contradiction.txt"
  stream: ERR
}

run {
  args: ["build", "//lib/ok", "--error-format=json"]
  exit: 2
  golden: "contradiction.json"
  stream: ERR
}

# The fix the diagnostic names: keep JS on one side only.
edit {
  file: "REPO.buri"
  replace: "backends: [NATIVE, JS]"
  with: "backends: [NATIVE]"
}

run {
  args: ["build", "//lib/ok"]
  exit: 0
}
