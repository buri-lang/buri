# A platform is admitted when every whitelist in the closure names it — a tag's
# `requires`, a library's `backends` and `platforms` — and no tag in the
# closure forbids it. `server` admits the JavaScript backend's platforms,
# `headless` forbids `web`, so `//cmd/daemon` admits the rest.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "requires and forbids combine across a closure: every whitelist, minus every forbidden platform"

run {
  args: ["query", "platforms(//cmd/daemon)"]
  exit: 0
  golden: "platforms.txt"
}

# The whitelist admits `web`; the forbid list is what rules it out.
run {
  args: ["lint", "//cmd/daemon"]
  exit: 1
  golden: "lint.txt"
}

# A library's own `platforms` minus its tag's forbidden ones can be nothing.
edit {
  file: "lib/poll/BUILD.buri"
  replace: "backends: [JS]"
  with: "platforms: [\"web\"]"
}

run {
  args: ["query", "platforms(//lib/poll)"]
  exit: 0
  golden: "nothing.txt"
}

run {
  args: ["lint", "//lib/poll"]
  exit: 1
  golden: "unsatisfiable.txt"
}

edit {
  file: "lib/poll/BUILD.buri"
  replace: "platforms: [\"web\"]"
  with: "backends: [JS]"
}

edit {
  file: "cmd/daemon/BUILD.buri"
  replace: "platform: \"web\""
  with: "platform: \"node\""
}

# The entry takes the host of the platform it now builds for.
edit {
  file: "cmd/daemon/main.buri"
  replace: "from \"web\" import { WebHost };"
  with: "from \"node\" import { NodeHost };"
}

edit {
  file: "cmd/daemon/main.buri"
  replace: "host: WebHost"
  with: "host: NodeHost"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
