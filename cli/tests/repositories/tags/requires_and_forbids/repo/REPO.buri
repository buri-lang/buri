# `server` admits the JavaScript backend; `headless` rules `web` out. A
# closure carrying both admits what is left.
tag {
    name: "server"
    doc: "runs on infrastructure we operate"

    requires {
        backends: [JS]
    }
}

tag {
    name: "headless"
    doc: "has no document to draw into"

    forbids {
        platforms: ["web"]
    }
}
