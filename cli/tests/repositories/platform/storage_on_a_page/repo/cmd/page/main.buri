// A page that counts its own visits, and remembers the last two.
//
// `visit` is everything the page does, so the suite and the built page run the
// same code: the suite against `web/storage/testing`, the page against
// IndexedDB.

from "core/bytes" import * as bytes;
from "core/io" import * as io;
from "core/str" import * as str;
from "platform/effect" import { Allocator, Stdout };
from "web" import { WebHost };
from "web/storage" import * as storage;
from "web/storage" import { Storage, StorageError };

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Storage: host.storage,
    };
    let _ = match (visit(ctx)) {
        .Ok(()) => (),
        .Err(.QuotaExceeded) => io.println(ctx, "storage is full").ignore(),
        .Err(.Refused(why)) => io.println(ctx, "storage refused: ${why}").ignore(),
    };
    .Ok(())
}

/// Reads the visit count, writes the next one, and keeps the two latest
/// visits under `visit/`.
export fn visit<C: Allocator + Stdout + Storage>(ctx: C): Result<(), StorageError> {
    let count = match (storage.get(ctx, "count")?) {
        .Some(text) => bytes.fromUtf8Lossy(ctx, text).toInt().withDefault(0),
        .None => 0,
    };
    let next = count + 1;
    let _ = storage.set(ctx, "count", bytes.toUtf8(ctx, str.format(ctx, "${next}")))?;
    let _ = storage.set(ctx, str.format(ctx, "visit/${next}"), bytes.toUtf8(ctx, "seen"))?;
    let _ = storage.delete(ctx, str.format(ctx, "visit/${count - 1}"))?;
    let kept = storage.keys(ctx, "visit/")?.join(ctx, " ");
    let _ = io.println(ctx, "visit ${next}, keeping ${kept}").ignore();
    .Ok(())
}
