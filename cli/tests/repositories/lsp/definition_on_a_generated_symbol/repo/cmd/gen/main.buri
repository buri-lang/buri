//! A generator: one line of JSON in, one line of JSON out.
//!
//! It reads a `units.txt` of `name value` lines and writes a module declaring
//! each name as an exported `Int`. Every declaration carries an **anchor**: the
//! region of the printed module it occupies, against the bytes of the line it
//! was written from. That is what the language server reads a generated
//! symbol's origin out of.
//!
//! Four line shapes, which is the whole of the format:
//!
//! ```text
//! # prose            a comment, printed nowhere — the input's doc comment
//! width 3            `export let width: Int = 3;`, anchored at this line
//! width 3 # prose    the same; the prose is not printed and is still anchored
//! ~any buri source   printed as written, anchored nowhere
//! ```
//!
//! The `~` line is what makes "no origin" a thing a case can ask for: text a
//! generator made up rather than read has nowhere to send a reader, and every
//! behaviour has to say so rather than guess.
//!
//! Anchors count **UTF-8 bytes**, which is the unit the protocol fixes and not
//! the unit `Str.length` counts — so a line is measured through `core/bytes`
//! rather than by character, and an input written in more than ASCII lands
//! where it was written.

from "core/bytes" import * as bytes;
from "core/effect" import { Allocator, Stdin, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/json" import * as json;
from "core/json" import { Json };
from "core/list" import * as list;
from "core/str" import * as str;

export fn main(): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdin: host.stdin,
        Stdout: host.stdout,
    };
    let line = io.readLine(ctx).okOr("the generator was handed no request")?;
    let request = json.parse(ctx, line).mapErr(fn(_e) => "the request is not JSON")?;
    let inputs = allInputs(ctx, request).okOr("the request names no input")?;
    io
        .println(ctx, "${json.stringify(ctx, respond(ctx, inputs))}")
        .mapErr(fn(_e) => "could not write the response")
}

/// One printed piece of the module: the text, and the input bytes it came from.
/// An empty `file` is a piece that came from nowhere.
struct Piece {
    text: Str,
    file: Str,
    start: Int,
    end: Int,
}

fn respond<C: Allocator>(ctx: C, inputs: [(Str, Str)]): Json {
    let pieces = inputs.mapCtx(ctx, fn(c, i) => piecesOf(c, i.0, i.1)).flatten(ctx);
    let source = pieces.mapCtx(ctx, fn(_c, p) => p.text).join(ctx, "");
    .Object([
        (
            "modules",
            .Array([
                .Object([
                    ("name", .Str("units")),
                    ("text", .Str(source)),
                    ("anchors", .Array(anchorsOf(ctx, pieces))),
                ]),
            ]),
        ),
        ("diagnostics", .Array(list.empty())),
    ])
}

/// Every line, printed, carrying the offset of the line it came from.
///
/// One fold with a running offset rather than a sum over the lines above each
/// one: the offset of a line is the sum of every line before it and the newline
/// each ended with, and counting it once is both the cheaper answer and the one
/// that cannot go out of step with the printing.
fn piecesOf<C: Allocator>(ctx: C, path: Str, text: Str): [Piece] {
    text
        .lines(ctx)
        .foldCtx(
            ctx,
            fn(c, acc: (Int, [Piece]), line) => {
                let next = acc.0 + byteLen(c, line) + 1;
                match (piece(c, path, line, acc.0)) {
                    .None => (next, acc.1),
                    .Some(p) => (next, acc.1.push(c, p)),
                }
            },
            (0, list.empty()),
        ).1
}

fn piece<C: Allocator>(ctx: C, path: Str, line: Str, at: Int): Option<Piece> {
    if (line.isEmpty() || line.startsWith("#")) {
        .None
    } else if (line.startsWith("~")) {
        .Some(Piece {
            text: str.format(ctx, "${line.slice(1, line.length())}\n"),
            file: "",
            start: 0,
            end: 0,
        })
    } else {
        let split = line.splitOnce(" ")?;
        // The anchor is the whole line, prose and all — a `#` after the value
        // is written about the declaration, so it is part of where it came
        // from. Which is also what puts a character outside ASCII inside an
        // anchor, where counting bytes and counting UTF-16 units disagree.
        let value = split.1
            .splitOnce("#")
            .map(fn(v) => v.0)
            .withDefault(split.1)
            .trim();
        .Some(Piece {
            text: str.format(ctx, "export let ${split.0}: Int = ${value};\n"),
            file: path,
            start: at,
            end: at + byteLen(ctx, line),
        })
    }
}

/// The same fold over what was printed: each piece's region of the module is
/// where the piece before it ended.
fn anchorsOf<C: Allocator>(ctx: C, pieces: [Piece]): [Json] {
    pieces.foldCtx(
        ctx,
        fn(c, acc: (Int, [Json]), p) => {
            let next = acc.0 + byteLen(c, p.text);
            if (p.file.isEmpty()) {
                (next, acc.1)
            } else {
                (next, acc.1.push(c, anchor(p, acc.0, next)))
            }
        },
        (0, list.empty()),
    ).1
}

fn anchor(p: Piece, start: Int, end: Int): Json {
    .Object([
        ("start", .Num(start.toF64())),
        ("end", .Num(end.toF64())),
        ("file", .Str(p.file)),
        ("span", span(p.start, p.end)),
    ])
}

fn span(start: Int, end: Int): Json {
    .Object([("start", .Num(start.toF64())), ("end", .Num(end.toF64()))])
}

/// UTF-8 bytes, which is what an anchor counts. `Str.length` counts scalar values,
/// and the two differ exactly where a wrong answer is invisible in a golden
/// written in ASCII.
fn byteLen<C: Allocator>(ctx: C, s: Str): Int {
    bytes.toUtf8(ctx, s).length()
}

fn allInputs<C: Allocator>(ctx: C, request: Json): Option<[(Str, Str)]> {
    field(request, "inputs")
        .andThen(fn(v) => asArray(v))
        .andThenCtx(ctx, fn(c, items) => {
            items.mapOptionCtx(c, fn(_c, pair) => asPair(pair))
        })
}

fn field(value: Json, name: Str): Option<Json> {
    match (value) {
        .Object(fields) => fields.find(fn(f) => f.0 == name).map(fn(f) => f.1),
        _ => .None,
    }
}

fn asArray(value: Json): Option<[Json]> {
    match (value) {
        .Array(items) => .Some(items),
        _ => .None,
    }
}

fn asStr(value: Json): Option<Str> {
    match (value) {
        .Str(s) => .Some(s),
        _ => .None,
    }
}

fn asPair(value: Json): Option<(Str, Str)> {
    let items = asArray(value)?;
    let path = items.get(0).andThen(fn(v) => asStr(v))?;
    let text = items.get(1).andThen(fn(v) => asStr(v))?;
    .Some((path, text))
}
