# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "four keystrokes in a row do not queue four sweeps: one runs, one waits, and the rest are superseded before their turn comes — counted on the `$/logTrace` work line and on what `buri/awaitAnalysis` reports"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
