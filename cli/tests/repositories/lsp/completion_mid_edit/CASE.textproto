# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "completion in a buffer mid-edit: a word that only looks like an import, slashes that are not comments, locals above the cursor, a bare dot in a match arm, a literal's spread, literal heads it cannot name, and a file with no analysis"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
