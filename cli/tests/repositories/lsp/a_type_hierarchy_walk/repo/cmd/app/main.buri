from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;
from "//lib/promo/lib.buri" import { discount };
from "//lib/shop/lib.buri" import { listing };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let owed: I64 = listing("plain", 100).cents() + discount(20).cents();
    let _ = ctx.println("owed: ${owed.show(ctx)}");
    .Ok(())
}
