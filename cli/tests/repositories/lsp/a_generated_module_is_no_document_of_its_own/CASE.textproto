# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "`unused-import` and `dead-code` step around a generated module — nobody can act on a finding about text a tool prints — and the generated text is never a file the report names, because it is not a document an editor could open"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
