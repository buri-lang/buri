# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# The generator prints an import nothing uses and an export nothing reaches —
# `unused-import` and `dead-code` in any file a person wrote. Both step around a
# generated module, because the edit either lint asks for is an edit to text the
# next build rewrites.
#
# The other half is that the module is not a file. Nothing in the report below
# names it, and nothing can: it has no path, so no client can open one. Both
# claims are true today by accident of that missing path, and this is what makes
# a change that gives a generated module one fail loudly.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/wire/plate.buri\" export { plate };\nfrom \"//lib/wire/units\" export { width };\n"}}}
# Clean: the two lints found their subjects and left them alone. A lint that
# stopped stepping around them lands here, on `units.txt` or on the `generators`
# entry, which is where a finding about generated code goes.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri"}}}
# Every file of the repository, which is the list the report walks. Six files on
# disk, and no seventh — `//lib/wire/units` is not among them.
{"jsonrpc": "2.0", "id": 3, "method": "workspace/diagnostic", "params": {"previousResultIds": []}}
# The twin. The same unused import and the same unreached export, written by
# hand into a file that is on disk — and both lints fire, on the lines a person
# can edit. So the silence above is the lints stepping around generated text
# rather than the lints being off.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/plate.buri", "languageId": "buri", "version": 1, "text": "from \"core/list\" import * as list;\n\nexport fn plate(): Int { 1 }\n\nexport fn helper(): Int { 0 }\n"}}}
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/plate.buri"}}}
{"jsonrpc": "2.0", "id": 5, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
