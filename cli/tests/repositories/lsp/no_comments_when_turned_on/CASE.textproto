# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "with no_comments turned on in REPO.buri, didOpen publishes a no-comments finding for the ordinary comment and none for the doc comment or the comment-like string"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
