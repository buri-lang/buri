# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "hover, references, type hints and signature help at the edges: a local named like a namespace, fields of two variants, a wildcard pattern, a local inside a module-level let, and a method the toolchain declares"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
