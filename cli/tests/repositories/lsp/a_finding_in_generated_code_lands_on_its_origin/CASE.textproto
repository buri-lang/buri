# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a compile error inside generated code is published where a person can act on it: on the input line it was generated from, and — for text the generator anchored nowhere — on the `generators` entry that ran the tool"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
