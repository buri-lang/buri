# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a code action is for the file it was asked about: a finding in another source of the same library is not offered, whether the range covers its bytes or the client echoed its code"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
