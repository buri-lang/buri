# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ and repo2/ below are Buri repositories.

doc: "two repositories holding the same file each answer a hover from their own analysis, not from the other's"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
