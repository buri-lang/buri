# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# The three entries of a list `buri format` wrapped, each on its own line and
# the cursor in the middle of the label rather than on its quote.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 3, "character": 19}}}
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 4, "character": 17}}}
# A package nested inside the package that depends on it.
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 5, "character": 18}}}
# The same label from the `testing` block, on one line this time.
{"jsonrpc": "2.0", "id": 5, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 17, "character": 32}}}
# The opening quote and the last character of a label are both inside it.
{"jsonrpc": "2.0", "id": 6, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 5, "character": 9}}}
{"jsonrpc": "2.0", "id": 7, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 5, "character": 25}}}
# A source of each rule, and a tag: the two that already worked, so that the
# case says the two halves agree.
{"jsonrpc": "2.0", "id": 8, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 1, "character": 19}}}
{"jsonrpc": "2.0", "id": 9, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 11, "character": 26}}}
{"jsonrpc": "2.0", "id": 10, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 16, "character": 26}}}
{"jsonrpc": "2.0", "id": 11, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 7, "character": 14}}}
# `//visibility:public` is a label that names no package.
{"jsonrpc": "2.0", "id": 12, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 8, "character": 25}}}
# An empty list has nothing in it to point at.
{"jsonrpc": "2.0", "id": 13, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/probe/BUILD.buri"}, "position": {"line": 12, "character": 23}}}
{"jsonrpc": "2.0", "id": 14, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
