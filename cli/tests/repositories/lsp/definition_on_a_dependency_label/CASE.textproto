# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "every string in a build file that names something: a wrapped list of dependency labels, a label naming a package nested inside another, a testing surface, a source, a tag, and the label that names no package at all"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
