# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# `REPO.buri` here has a misspelled field in its `lint` block, and that finding
# is about the repository's own file: no analysis produces it, so no publish
# carries it, and the lint pass refuses to run at all. Without a message none of
# that is visible — the build-graph findings simply stop arriving and nothing
# says why.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# Opening a file is the first thing that has to open the repository, so this is
# where it is said.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri", "languageId": "buri", "version": 1, "text": "//! What a shop sells.\n\n/// One thing for sale.\nexport struct Item {\n  /// What the label on the shelf says.\n  export name: Str,\n  /// What it costs, in whole cents.\n  export price: I64,\n}\n\n/// What one of them costs.\nexport fn ticket(item: Item): I64 {\n  item.price\n}\n"}}}
# And it is said once. A repository nobody has edited is in the state it was in
# a moment ago, and repeating the message on every request would be noise a
# reader learns to ignore.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri"}, "position": {"line": 11, "character": 12}}}
# What the front end knows still works: the packages loaded, and only the
# repository's configuration did not. This is the whole reason the failure is
# invisible without a message — nothing on screen looks wrong.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri"}, "position": {"line": 12, "character": 8}}}
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/documentSymbol", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri"}}}
{"jsonrpc": "2.0", "id": 5, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
