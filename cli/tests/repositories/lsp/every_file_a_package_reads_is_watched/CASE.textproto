# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "the server asks to be told about every file, so a generator input that is a `.txt` and a stray `.lines` beside one are seen, and each change re-analyses only the package it is in (buri-lang/buri#284)"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
