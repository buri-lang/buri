# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
# A `!` line is the harness acting as the editor would; see harness/case.rs.
#
# `//lib/schemas` hands `a.txt` to `//tools/embed` and `//lib/words` hands it
# `w.lines`. The watcher registered covers both extensions, and each change
# below re-analyses only the package it landed in, though all three are open.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "trace": "verbose", "capabilities": {"textDocument": {"diagnostic": {}}, "workspace": {"didChangeWatchedFiles": {"dynamicRegistration": true}, "diagnostics": {"refreshSupport": true}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "id": "buri/watchers", "result": null}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/schemas/schemas.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/schemas/files\" import { A_TXT };\n\n/// The text of a.txt.\nexport fn a(): Str {\n    A_TXT\n}\n"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/words/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/words/files\" export { W_LINES };\n"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/other/lib.buri", "languageId": "buri", "version": 1, "text": "/// One.\nexport fn one(): Int {\n    1\n}\n"}}}
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/words/BUILD.buri"}}}
# A stray `.lines` file appears beside the input.
!wait 2
!move staging/extra.lines lib/words/extra.lines
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/lib/words/extra.lines", "type": 1}]}}
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/words/BUILD.buri"}, "previousResultId": "1"}}
# And goes away.
!wait 3
!move lib/words/extra.lines staging/extra.lines
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/lib/words/extra.lines", "type": 3}]}}
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/words/BUILD.buri"}, "previousResultId": "2"}}
# The `.txt` input goes away: no module, so `A_TXT` names nothing.
!wait 4
!move lib/schemas/a.txt staging/a.txt
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/lib/schemas/a.txt", "type": 3}]}}
{"jsonrpc": "2.0", "id": 5, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/schemas/schemas.buri"}}}
# And comes back.
!wait 5
!move staging/a.txt lib/schemas/a.txt
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/lib/schemas/a.txt", "type": 1}]}}
{"jsonrpc": "2.0", "id": 6, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/schemas/schemas.buri"}}}
# A file nothing reads changes: nothing is analysed, published or refreshed.
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/lib/other/notes.txt", "type": 2}]}}
{"jsonrpc": "2.0", "id": 7, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
