# What an editor offers while a `//...` import path is being typed.
#
# Each candidate is in the one form an import of it is written in, so the list
# is not one kind of thing: a `.buri` on the end means a file inside this
# package, and no extension means a surface, wherever it lives.
#
#   * this package's own surfaces, as modules — `//lib/money`,
#     `//lib/money/testing` — because a suite reaches its own library the way
#     its dependents do;
#   * every other file this package owns, as a file: inside a package every
#     module is reachable, and the file being typed is as likely to be the one
#     next door as the surface;
#   * a declared dependency, as its label and nothing else — that label *is*
#     the module path, and its inner modules are an `internal-import`, so
#     offering one would be offering an error;
#   * the standard library, as the module paths its table holds
#     (`import_completion` covers that half).
#
# And two things deliberately absent: a test source, which is a module nobody
# may name, and the file doing the typing, which cannot import itself. A
# completion list is a claim about what would compile, so a row that would not
# is worse than a row that is missing.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "what an editor offers while a //... import path is being typed: a surface as a module, a file of this package as a file"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
