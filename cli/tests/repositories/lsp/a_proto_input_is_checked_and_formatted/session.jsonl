# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# The schema checks, so opening it publishes nothing to fix.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/point.proto", "languageId": "proto", "version": 1, "text": "edition = \"2026\";\n\nmessage Point {\n    int32 x = 1;\n    int32 y = 2;\n}\n"}}}
# A field number used twice is found at once, on the second field.
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/point.proto", "version": 2}, "contentChanges": [{"text": "edition = \"2026\";\n\nmessage Point {\n    int32 x = 1;\n    int32 y = 1;\n}\n"}]}}
# A type that names nothing, and a statement that does not parse.
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/point.proto", "version": 3}, "contentChanges": [{"text": "edition = \"2026\";\n\nmessage Point {\n    int32 x = 1;\n    Depth z = 3;\n    int32 = 4;\n}\n"}]}}
# Put right, and the file is clean again.
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/point.proto", "version": 4}, "contentChanges": [{"text": "edition=\"2026\";\nmessage Point{int32 x=1;int32 y=2;}\n"}]}}
# Formatting answers with the built-in layout.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/formatting", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/point.proto"}, "options": {"tabSize": 4, "insertSpaces": true}}}
{"jsonrpc": "2.0", "id": 3, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
