# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "opening and saving a buffer in one target leaves the findings of a buffer in another target on screen, because every open buffer's own target is asked rather than only the one that prompted the analysis"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
