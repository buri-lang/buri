# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# `//lib/wire` runs `std/codegen/proto` over `point.proto`. `Point` is a
# `message` in that file and the generator anchored the struct it wrote on it;
# `defaultPoint` is a name the generator made up, anchored nowhere. Both are
# ordinary names in the buffer below, and the whole case is that the server
# tells them apart — which is a thing it could not do while the `.proto`
# generator was Rust and recorded no origins at all.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/wire/point.proto\" import { defaultPoint, Point };\n\n/// The origin, as the schema spells it.\nexport fn zero(): Point {\n    defaultPoint()\n}\n"}}}
# The line the case is for: `Point` came from `point.proto`, so that is where
# the editor is sent — at the bytes of the `message` it was written from.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri"}, "position": {"line": 3, "character": 20}}}
# And the other half. `defaultPoint` is spelled nowhere in the schema, so there
# is nowhere to send anybody — `null`, rather than a guess at a line.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri"}, "position": {"line": 4, "character": 6}}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
