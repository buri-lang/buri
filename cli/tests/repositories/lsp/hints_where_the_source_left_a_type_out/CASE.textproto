# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "inlay hints name the type of every binding that wrote none and the parameter of every argument that reads as an unlabelled one, and stay silent everywhere the source already says it"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
