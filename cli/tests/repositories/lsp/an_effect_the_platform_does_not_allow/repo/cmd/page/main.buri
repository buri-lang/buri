// A page that asks for nothing a page does not have. The session opens this
// file with the reach for a filesystem added, which is where the diagnostic
// comes from.

from "core/io" import * as io;
from "platform/effect" import { Allocator, Stdout };
from "web" import { WebHost };

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, "a page").mapErr(fn(_e) => "write failed")
}
