# One JSON-RPC request per line. `<scratch>` becomes the copied repository,
# and `<scratch2>` the second one — a sibling directory, because a repository
# nested inside another is not a second root.
#
# The client names one folder and knows how to name more, so it is a client
# this server may be told about a change to them.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"capabilities": {"workspace": {"workspaceFolders": true}}, "workspaceFolders": [{"uri": "file://<scratch>", "name": "money"}]}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri", "languageId": "buri", "version": 1, "text": "/// A whole number of cents. The field is not exported, so arithmetic on the\n/// underlying integer is not reachable from outside this module.\nexport struct Cents(I64);\n\nderive Eq, Show for Cents;\n\nexport fn fromCents(c: I64): Cents { Cents(c) }\n\nexport fn double(c: Cents): Cents { fromCents(c.0 + c.0) }\n"}}}
# A buffer from a repository the client has not opened. It is a real file in a
# real repository, and the server holds its text — what it does not have is a
# folder saying that repository is open.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch2>/lib/weather/celsius.buri", "languageId": "buri", "version": 1, "text": "/// A whole number of degrees. Nothing in the other repository of this case\n/// declares a name anything like it, so an answer about this file could not\n/// have come from there.\nexport struct Celsius(I64);\n\nderive Eq, Show for Celsius;\n\nexport fn fromCelsius(d: I64): Celsius { Celsius(d) }\n\nexport fn warmer(c: Celsius): Celsius { fromCelsius(c.0 + 1) }\n"}}}
# `fromCelsius` on its own declaration line, and the answer is nothing: a file
# outside every open folder is answered about by no repository rather than by
# whichever one happened to be first.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch2>/lib/weather/celsius.buri"}, "position": {"line": 7, "character": 12}}}
# The query reaches one repository, because one is open.
{"jsonrpc": "2.0", "id": 3, "method": "workspace/symbol", "params": {"query": "from"}}
# The second folder is added, and every open buffer is asked again — which of
# them the server can say anything about has just changed.
{"jsonrpc": "2.0", "method": "workspace/didChangeWorkspaceFolders", "params": {"event": {"added": [{"uri": "file://<scratch2>", "name": "weather"}], "removed": []}}}
# The same request, at the same position, now answers out of the repository
# that owns the file.
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch2>/lib/weather/celsius.buri"}, "position": {"line": 7, "character": 12}}}
# The call inside `warmer` resolves within the second repository, and the
# location it answers with is in that repository's tree.
{"jsonrpc": "2.0", "id": 5, "method": "textDocument/definition", "params": {"textDocument": {"uri": "file://<scratch2>/lib/weather/celsius.buri"}, "position": {"line": 9, "character": 44}}}
# The workspace is both folders now, so the query is asked of both.
{"jsonrpc": "2.0", "id": 6, "method": "workspace/symbol", "params": {"query": "from"}}
# And the first repository still answers exactly as it did.
{"jsonrpc": "2.0", "id": 7, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri"}, "position": {"line": 6, "character": 12}}}
# The first folder is closed. Its buffer stays open in the editor and stops
# being a file this server can say anything about.
{"jsonrpc": "2.0", "method": "workspace/didChangeWorkspaceFolders", "params": {"event": {"added": [], "removed": [{"uri": "file://<scratch>", "name": "money"}]}}}
{"jsonrpc": "2.0", "id": 8, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri"}, "position": {"line": 6, "character": 12}}}
{"jsonrpc": "2.0", "id": 9, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
