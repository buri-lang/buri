# One JSON-RPC request per line. The harness adds the Content-Length framing,
# and turns `<scratch>` into wherever the copy of repo/ landed.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri", "languageId": "buri", "version": 1, "text": "//! Three shapes nothing needs, one of each kind the linter knows about.\n\n/// Nothing writes this name down anywhere else and nothing builds one.\nstruct Ledger {\n  entries: I64,\n}\n\n/// `Increment` is named by the arm below; `Decrement` is named by nothing, and\n/// the `_` arm names no variant at all.\nenum Step {\n  Increment,\n  Decrement,\n}\n\n/// `cents` is read below. `packer` is written at the one literal there is and\n/// read nowhere, and it carries no `export`, so the surface does not cover it.\nexport struct Entry {\n  export cents: I64,\n  packer: Str,\n}\n\nexport fn entry(cents: I64): Entry {\n  Entry { cents, packer: \"till\" }\n}\n\nexport fn apply(s: Step, n: I64): I64 {\n  match (s) {\n    .Increment => n + 1 + entry(n).cents,\n    _ => n,\n  }\n}\n"}}}
{"jsonrpc": "2.0", "id": 2, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
