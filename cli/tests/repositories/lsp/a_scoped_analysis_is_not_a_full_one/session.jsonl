# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# `//lib/shop` is one target of two files. `catalog.buri` has an error in a
# function *body*, which is the only phase a scoped analysis skips — every
# signature is elaborated either way. So the error is the witness: a report
# built from a scoped analysis would not carry it.
#
# At `verbose`, so the golden holds the work each request did.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "trace": "verbose"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# One buffer. The open runs the target's two whole-closure passes and
# publishes `catalog.buri`'s error along with `cart.buri`'s clean list.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/shop/catalog.buri\" import { listed };\n\n/// What the basket comes to, in whole cents.\nexport fn total(count: I64): I64 { count * listed() }\n"}}}
# A hover, before anything moved: the open's analysis checked every body in
# the closure, which is a superset of what this needs. `analyses 0`.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri"}, "position": {"line": 3, "character": 11}}}
# A keystroke.
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri", "version": 2}, "contentChanges": [{"text": "from \"//lib/shop/catalog.buri\" import { listed };\n\n/// What the basket comes to, in whole cents.\nexport fn total(count: I64): I64 { count * listed() }\n\n// A keystroke, appended so that nothing above it moves.\n"}]}}
# The same hover again. Nothing in the cache holds, so this is one analysis —
# and a scoped one: only `cart.buri`'s bodies are checked.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri"}, "position": {"line": 3, "character": 11}}}
# A second question about the same file, and a third about a different
# position in it: `analyses 0` both times. The scoped answer is filed under
# the closure it read, like any other, so the questions after a keystroke are
# free until the next one.
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/documentHighlight", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri"}, "position": {"line": 3, "character": 11}}}
{"jsonrpc": "2.0", "id": 5, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri"}, "position": {"line": 3, "character": 40}}}
# The line the case is for. `catalog.buri` is the same target as `cart.buri`,
# so the entry a shared cache would hand this pull is the scoped analysis of
# `cart.buri` — which checked no body in this file and would report it clean.
# The pull is a whole-closure question, says `analyses 1, lints 1`, and its
# report carries the error.
{"jsonrpc": "2.0", "id": 6, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri"}}}
# And back the other way: the pull's whole analysis is a superset of what a
# position query needs, so the hover after it is free again.
{"jsonrpc": "2.0", "id": 7, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/cart.buri"}, "position": {"line": 3, "character": 11}}}
{"jsonrpc": "2.0", "id": 8, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
