# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "the server keeps the hover analyses of the last eight files asked about: a ninth file pushes out the oldest, which a second hover works out again, while the newest is answered from what was kept"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
