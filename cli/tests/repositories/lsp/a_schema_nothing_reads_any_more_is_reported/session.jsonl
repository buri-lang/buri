# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
# A `!` line is the harness acting as the editor would; see harness/case.rs.
#
# `//libs/b`'s data file names `libs/a/shared.schema.json` as its schema, and
# then names `//libs/a`'s own one instead. No file `//libs/a` reads moves.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {"textDocument": {"diagnostic": {"relatedDocumentSupport": true}}, "workspace": {"didChangeWatchedFiles": {"dynamicRegistration": true}, "diagnostics": {"refreshSupport": true}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "id": "buri/watchers", "result": null}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/libs/a/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//libs/a/own.schema.json\" export { Own };\n"}}}
# Clean: `//libs/b` reads the schema.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/libs/a/BUILD.buri"}}}
{"jsonrpc": "2.0", "id": 3, "method": "workspace/diagnostic", "params": {"previousResultIds": []}}
# It stops: the schema is stray.
!wait 3
!move libs/b/b.json staging/b.json.shared
!move staging/b.json.own libs/b/b.json
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/libs/b/b.json", "type": 2}]}}
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/libs/a/BUILD.buri"}, "previousResultId": "1"}}
{"jsonrpc": "2.0", "id": 5, "method": "workspace/diagnostic", "params": {"previousResultIds": []}}
# And starts again.
!wait 5
!move libs/b/b.json staging/b.json.own
!move staging/b.json.shared libs/b/b.json
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/libs/b/b.json", "type": 2}]}}
{"jsonrpc": "2.0", "id": 6, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/libs/a/BUILD.buri"}, "previousResultId": "4"}}
{"jsonrpc": "2.0", "id": 7, "method": "workspace/diagnostic", "params": {"previousResultIds": []}}
{"jsonrpc": "2.0", "id": 8, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
