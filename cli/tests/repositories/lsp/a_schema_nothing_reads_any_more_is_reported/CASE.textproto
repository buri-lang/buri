# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a schema another package's data file stops naming is reported by the server's unused-source, in the build file's pulled report, its result id and the workspace report, and one it names again is not (buri-lang/buri#281)"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
