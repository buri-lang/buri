# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "the empty completion: a quote nobody closed, a path prefix nothing starts with, and a module that does not exist — and the one list a prefix does not shorten, because the client filters it against the range each item replaces"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
