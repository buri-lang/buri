# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# This client accepts the lens refresh and neither of the other two, which is
# what makes the session a test of the family rather than of the table: the
# fingerprint is computed once for all three, and each is gated on its own
# `refreshSupport`.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {"workspace": {"codeLens": {"refreshSupport": true}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# Opening records the state the lenses are about. Nothing has gone stale yet,
# so nothing is asked for.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/counter/test/counter.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/counter/lib.buri\" import { Tally, counter, twice };\nfrom \"core/testing/assert/lib.buri\" import * as assert;\n\ntest \"counter reads the total\" {\n  let tally = Tally { total: 1 };\n  assert.eq(counter(tally), 1);\n}\n\ntest \"twice is two of them\" {\n  let tally = Tally { total: 3 };\n  assert.eq(twice(tally), 6);\n}\n"}}}
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/codeLens", "params": {"textDocument": {"uri": "file://<scratch>/lib/counter/test/counter.buri"}}}
# A keystroke — a third `test`. Lenses are not recomputed here: the client
# asks for those when it wants them, and nothing is published because the
# buffer parses.
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "file://<scratch>/lib/counter/test/counter.buri", "version": 2}, "contentChanges": [{"text": "from \"//lib/counter/lib.buri\" import { Tally, counter, twice };\nfrom \"core/testing/assert/lib.buri\" import * as assert;\n\ntest \"counter reads the total\" {\n  let tally = Tally { total: 1 };\n  assert.eq(counter(tally), 1);\n}\n\ntest \"twice is two of them\" {\n  let tally = Tally { total: 3 };\n  assert.eq(twice(tally), 6);\n}\n\ntest \"a tally of nothing is nothing\" {\n  let tally = Tally { total: 0 };\n  assert.eq(counter(tally), 0);\n}\n"}]}}
# The save. The fingerprint has moved since the open, so the refresh goes out
# after the diagnostics — and only the lens one, because that is the only
# family this client claimed.
{"jsonrpc": "2.0", "method": "textDocument/didSave", "params": {"textDocument": {"uri": "file://<scratch>/lib/counter/test/counter.buri"}}}
# The client answers, as it must for any request a server sends.
{"jsonrpc": "2.0", "id": "buri/codeLensRefresh/1", "result": null}
# And there are three lenses now, which is exactly the change a refresh exists
# to tell a client about: nothing else would have made it ask again.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/codeLens", "params": {"textDocument": {"uri": "file://<scratch>/lib/counter/test/counter.buri"}}}
# A second save with nothing edited in between. The fingerprint is where the
# last one left it, so this one is silent.
{"jsonrpc": "2.0", "method": "textDocument/didSave", "params": {"textDocument": {"uri": "file://<scratch>/lib/counter/test/counter.buri"}}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
