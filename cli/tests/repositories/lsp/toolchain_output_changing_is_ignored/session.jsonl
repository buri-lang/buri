# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
# A `!` line is the harness acting as the editor would; see harness/case.rs.
#
# The server watches every file, so a build in a terminal reports everything
# it writes under `.buri`. None of it is read by an analysis.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "trace": "verbose", "capabilities": {"textDocument": {"diagnostic": {}}, "workspace": {"didChangeWatchedFiles": {"dynamicRegistration": true}, "diagnostics": {"refreshSupport": true}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "id": "buri/watchers", "result": null}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/libs/shapes/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//libs/shapes/square.schema.json\" export { Square };\n"}}}
# A file in no repository has no target to remember findings for.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file:///nowhere/loose.buri", "languageId": "buri", "version": 1, "text": "export fn one(): Int {\n    1\n}\n"}}}
# A build's output, the repository's history, and a file in no repository:
# nothing is hashed, analysed, published or refreshed.
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/.buri/out/node/shapes.js", "type": 1}, {"uri": "file://<scratch>/.buri/cache/ab/cdef", "type": 2}, {"uri": "file://<scratch>/.buri/link/key", "type": 3}, {"uri": "file://<scratch>/.git/index", "type": 2}, {"uri": "file:///nowhere/notes.txt", "type": 2}]}}
# One file an analysis can read among them, and the open closures are hashed.
{"jsonrpc": "2.0", "method": "workspace/didChangeWatchedFiles", "params": {"changes": [{"uri": "file://<scratch>/.buri/out/node/shapes.js", "type": 2}, {"uri": "file://<scratch>/libs/shapes/square.schema.json", "type": 2}]}}
{"jsonrpc": "2.0", "id": 2, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
