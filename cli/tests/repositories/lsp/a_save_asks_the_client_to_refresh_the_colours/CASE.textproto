# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a save that moved the analysis fingerprint asks a client that offered refreshSupport to fetch its semantic tokens again, and a save that moved nothing is silent"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
