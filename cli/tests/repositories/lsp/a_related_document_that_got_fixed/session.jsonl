# A pull client that claims `relatedDocumentSupport`, an error in the library
# the pulled file imports, and the fix for it.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {"textDocument": {"diagnostic": {"relatedDocumentSupport": true}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# The library buffer, opened with an error in it that is not on disk.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri", "languageId": "buri", "version": 1, "text": "export struct Cents(export I64);\n\nderive Eq, Show for Cents;\n\nexport fn fromCents(c: I64): Cents { \"not a Cents\" }\n"}}}
