doc: "the trace level a client sets in initialize and changes with $/setTrace, and the $/logTrace lines it turns on and off"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
