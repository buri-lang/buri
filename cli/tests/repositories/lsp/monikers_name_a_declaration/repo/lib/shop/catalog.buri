//! What a shop sells, and what can be said about it.

/// How much of an item is on the shelf.
export enum Stock {
    /// None left at all.
    Out,
    /// The number still on the shelf.
    OnHand { count: I64 },
}

/// One thing for sale.
export struct Item {
    /// What the label on the shelf says.
    export name: Str,
    /// What it costs, in whole cents.
    export price: I64,
    export stock: Stock,
}

/// Something with a price in whole cents.
export trait Priced {
    /// What one of them costs.
    fn cents(self): I64;
}

impl Priced for Item {
    fn cents(self): I64 {
        self.price
    }
}

/// How many of a thing are on the shelf.
fn held(stock: Stock): I64 {
    match (stock) {
        .Out => 0,
        .OnHand { count } => count,
    }
}

/// What the whole shelf is worth, counting only what is in stock.
export fn worth(items: [Item]): I64 {
    items.fold(fn(running, item) => running + held(item.stock) * item.price, 0)
}

/// An item nobody has stocked yet.
export fn listing(name: Str, price: I64): Item {
    Item { name: name, price: price, stock: Stock.Out }
}
