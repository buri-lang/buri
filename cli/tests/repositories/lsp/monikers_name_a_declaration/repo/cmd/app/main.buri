from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;
from "//lib/shop/lib.buri" import { currency, listing, worth };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let shelf = [listing("plain", 100)];
    let _ = ctx.println("${worth(shelf).show(ctx)} ${currency}");
    .Ok(())
}
