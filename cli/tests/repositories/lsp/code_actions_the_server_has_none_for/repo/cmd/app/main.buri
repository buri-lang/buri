// Imports two libraries `cmd/app/BUILD.buri` does not name in `dependencies`,
// and declares a function that asks for a context it never reads.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/extra" import { one };
from "//lib/money" import { fromCents };

fn width<C: Allocator>(ctx: C, label: Str): Int {
    label.length()
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let w = width(ctx, "label");
    io
        .println(ctx, "cents: ${fromCents(450 + one() + w).show(ctx)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
