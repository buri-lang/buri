{"jsonrpc": "2.0", "id": 4, "method": "textDocument/codeAction", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/main.buri"}, "context": {"diagnostics": []}, "range": {"start": {"line": 6, "character": 0}, "end": {"line": 7, "character": 40}}}}
