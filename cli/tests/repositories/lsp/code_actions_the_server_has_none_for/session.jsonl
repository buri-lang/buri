# A range with no start, and one whose end is not a position, say no more than none.
{"jsonrpc": "2.0", "id": 8, "method": "textDocument/codeAction", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/main.buri"}, "range": {"end": {"line": 0, "character": 0}}, "context": {"diagnostics": []}}}
