{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# Every finding in the file, from a client that echoed none back.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/codeAction", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/main.buri"}, "context": {"diagnostics": []}, "range": {"start": {"line": 0, "character": 0}, "end": {"line": 30, "character": 0}}}}
# The blank line between the imports' findings and the unused context's: a
# range that touches neither the findings above it nor the ones below it.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/codeAction", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/main.buri"}, "context": {"diagnostics": []}, "range": {"start": {"line": 8, "character": 0}, "end": {"line": 8, "character": 0}}}}
# Two findings of `missing-dependency` in one package have one answer, the build
