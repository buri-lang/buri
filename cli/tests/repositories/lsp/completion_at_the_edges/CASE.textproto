# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "completion at the edges: a package at the repository root, an import clause already closed, a slash inside a string, a spread, a file no target lists, and a value whose type supplies an effect"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
