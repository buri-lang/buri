# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a test source is a source: a call inside a test block resolves to the function it calls, the sentence a test is named by resolves to nothing, and a written type answers whether it is declared here or built in"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
