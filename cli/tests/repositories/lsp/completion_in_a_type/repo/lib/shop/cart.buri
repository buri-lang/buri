//! What is in the basket.

from "//lib/shop/catalog.buri" import * as catalog;
from "core/order" import { Order, int };

/// One item, for a basket with nothing in it.
export fn sample(): catalog.Item {
  catalog.listing("nothing")
}

/// Which of two prices is the larger.
export fn larger(a: I64, b: I64): Order {
  int(a, b)
}
