// The type error: `total` promises an `I64` and hands back a `Str`. That is
// the front end's half of what a pull about this file answers with.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

export fn total(): I64 {
    "not a number"
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "total: ${total().show(ctx)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
