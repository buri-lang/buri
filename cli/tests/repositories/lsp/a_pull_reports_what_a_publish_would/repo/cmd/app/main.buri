// The type error: `total` promises an `I64` and hands back a `Str`. That is
// the front end's half of what a pull about this file answers with.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;

export fn total(): I64 { "not a number" }

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = ctx.println("total: ${total().show(ctx)}");
  .Ok(())
}
