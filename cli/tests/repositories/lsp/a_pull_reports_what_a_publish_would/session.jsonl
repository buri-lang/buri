# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# This client asks for related documents, which is the protocol's field for
# what this toolchain does constantly: report a fact about one file while
# checking another.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {"textDocument": {"diagnostic": {"relatedDocumentSupport": true}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# The push, which is unchanged and still happens. Two files hear about it: the
# one with the type error, and the build file the lint finding is about.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/main.buri", "languageId": "buri", "version": 1, "text": "// The type error: `total` promises an `I64` and hands back a `Str`. That is\n// the front end's half of what a pull about this file answers with.\n\nfrom \"core/effect\" import { Alloc, Stdout };\nfrom \"core/host\" import * as host;\n\nexport fn total(): I64 { \"not a number\" }\n\nexport fn main(): Result<(), Str> {\n  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };\n  let _ = ctx.println(\"total: ${total().show(ctx)}\");\n  .Ok(())\n}\n"}}}
# The pull, about the same file. `items` is the type error, byte for byte what
# the publish above carried, and `relatedDocuments` holds the finding the same
# two passes made about the build file.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/main.buri"}}}
# The same two findings, asked about from the other end. `severity: 1` on an
# `unused-library` is `REPO.buri`'s `fail_on_finding`: every finding from the
# catalogue is an error here, and a pulled report wears the severity the
# terminal prints for exactly the reason a pushed one does — one producer.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file://<scratch>/cmd/app/BUILD.buri"}}}
# A file in no open repository. Nothing is known about it, and an empty full
# report says so — with no `resultId`, because there is no analysis behind it
# for a later request to quote.
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "file:///nowhere/absent.buri"}}}
# The two malformed ones. A `DocumentDiagnosticReport` has no null among its
# shapes, so neither of these can be answered with a result at all: what goes
# back is the protocol's own `-32602 InvalidParams`.
{"jsonrpc": "2.0", "id": 5, "method": "textDocument/diagnostic", "params": {}}
{"jsonrpc": "2.0", "id": 6, "method": "textDocument/diagnostic", "params": {"textDocument": {"uri": "untitled:Untitled-1"}}}
{"jsonrpc": "2.0", "id": 7, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
