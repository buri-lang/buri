# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "completion and hover in build files at the edges: comments, stray braces and colons, labels for the root library and a testing surface, tags with no doc, and the values of bool and string fields"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
