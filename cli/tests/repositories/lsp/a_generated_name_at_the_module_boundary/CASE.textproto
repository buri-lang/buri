# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "every editor request a person makes about a generated name at the seam it leaves its rule through: the re-export line, the import path with no file behind it, the name and the type on either side of the package boundary, the uses of it, and the rename that is refused"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
