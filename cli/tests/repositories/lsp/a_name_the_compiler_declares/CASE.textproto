# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a name the compiler declares itself — the `I64` type and its `show` method — has no file to point at, so every request that wants a place for it answers with nothing rather than with a place that is not there"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
