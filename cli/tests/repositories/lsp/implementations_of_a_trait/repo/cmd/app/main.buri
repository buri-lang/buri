from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/promo" import { discount };
from "//lib/shop" import { listing };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let owed: I64 = listing("plain", 100).cents() + discount(20).cents();
    let _ = io.println(ctx, "owed: ${owed.show(ctx)}").ignore();
    .Ok(())
}
