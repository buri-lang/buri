# The same file, asked by a client that named its content formats and left
# `markdown` out of them.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {"textDocument": {"hover": {"contentFormat": ["plaintext"]}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri", "languageId": "buri", "version": 1, "text": "from \"core/effect\" import { Alloc };\n\n/// A whole number of cents. The field is not exported, so arithmetic on the\n/// underlying integer is not reachable from outside this module.\nexport struct Cents(I64);\n\nderive Eq, Show for Cents;\n\nexport fn fromCents(c: I64): Cents { Cents(c) }\n\nexport fn double(c: Cents): Cents { fromCents(c.0 + c.0) }\n"}}}
# The signature comes back without the fence a client that cannot render one
# would print as three literal backticks.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri"}, "position": {"line": 8, "character": 12}}}
# And the doc comment under it is the same prose either way: what the fence
# marked was the signature, and the `///` lines were never markdown of ours.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/cents.buri"}, "position": {"line": 4, "character": 16}}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
