# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# A function declared with no body has nothing in it to call.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/prepareCallHierarchy", "params": {"textDocument": {"uri": "file://<scratch>/lib/roots/roots.buri"}, "position": {"line": 8, "character": 14}}}
# The item is copied out of the answer above, as a client sends it back.
{"jsonrpc": "2.0", "id": 3, "method": "callHierarchy/outgoingCalls", "params": {"item": {"data": {"position": {"character": 10, "line": 8}, "uri": "file://<scratch>/lib/roots/roots.buri"}, "detail": "//lib/roots/roots.buri", "kind": 12, "name": "bare", "range": {"end": {"character": 32, "line": 8}, "start": {"character": 0, "line": 8}}, "selectionRange": {"end": {"character": 14, "line": 8}, "start": {"character": 10, "line": 8}}, "uri": "file://<scratch>/lib/roots/roots.buri"}}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
