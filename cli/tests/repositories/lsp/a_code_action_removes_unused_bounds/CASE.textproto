# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a quick fix that answers two findings at once: `unused-context-bound` on either of a parameter's two dead bounds carries the one rewrite that removes both, because the separators they would each delete are the same bytes"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}

# What the client wrote.
file {
  path: "lib/one/announce.buri"
  golden: "announce.buri"
}
