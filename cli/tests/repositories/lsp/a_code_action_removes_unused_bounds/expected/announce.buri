from "core/io" import * as io;
from "platform/effect" import { Allocator, Clock, IoError, Stdout };

/// `io.println` asks for `Stdout` and for nothing else, so two of the three
/// bounds are a demand on every caller for a capability nothing here uses.
export fn announce<C: Stdout>(
    ctx: C,
    label: Str,
): Result<(), IoError> {
    io.println(ctx, "-- ${label}")
}
