# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a build-file finding `buri gen` writes nothing for has no code action: a `missing-dependency` in a tool package, whose build file gen leaves as written, and an `unused-source` gen cannot place"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
