# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": null}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# No folder named, and no way to ask for one: the repository is the one the
# server was started in, so hover answers.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/stock/shelf.buri", "languageId": "buri", "version": 1, "text": "/// How many items one shelf holds.\nexport fn size(): I64 {\n    12\n}\n"}}}
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/stock/shelf.buri"}, "position": {"line": 1, "character": 11}}}
{"jsonrpc": "2.0", "id": 3, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
