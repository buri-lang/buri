# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a save that moved the analysis fingerprint asks the client to pull its diagnostics again, only a client that claimed workspace.diagnostics.refreshSupport is asked, and a save that changed nothing is silent"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
