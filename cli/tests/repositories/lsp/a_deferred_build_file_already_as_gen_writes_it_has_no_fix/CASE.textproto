# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a client that defers edits to resolve is offered `buri gen`'s build file only where gen would change it: not for a file already as gen writes it, nor for one gen cannot place"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
