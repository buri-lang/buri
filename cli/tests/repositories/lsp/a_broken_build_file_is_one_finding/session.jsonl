# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# A build file with a value missing, opened: the error is published once. The
# file is both the one that prompted the publish and one of the open buffers,
# and it is one squiggle either way.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/BUILD.buri", "languageId": "buri", "version": 1, "text": "library {\n    sources: \n}\n"}}}
{"jsonrpc": "2.0", "id": 2, "method": "workspace/symbol", "params": {"query": "zz"}}
# The same for the repository's own file.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/REPO.buri", "languageId": "buri", "version": 1, "text": "tag {\n    name: \n}\n"}}}
{"jsonrpc": "2.0", "id": 3, "method": "workspace/symbol", "params": {"query": "zz"}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
