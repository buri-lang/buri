# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a hint handed back to inlayHint/resolve comes out with the declaration it is about rendered as a tooltip and a location on the label part that names it, and a hint about something with no file comes out unchanged"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
