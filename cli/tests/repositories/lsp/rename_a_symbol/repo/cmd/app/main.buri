from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

from "//lib/shop/lib.buri" import { Item, listing as offer, subtotal, defaultPrice };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let plain: Item = offer("plain", defaultPrice);
  let _ = ctx.println("total: ${subtotal([plain]).show(ctx)}");
  .Ok(())
}
