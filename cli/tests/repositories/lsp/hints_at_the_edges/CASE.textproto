doc: "inlay hints for the arguments and bindings at the edges of the rules, and resolving hints whose data names nothing a location can be given for"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
