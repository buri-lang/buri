from "core/testing/assert" import * as assert;
from "//lib/counter" import { counter, Tally, twice };

test "counter reads the total" {
    let tally = Tally { total: 1 };
    assert.equal(counter(tally), 1);
}

test "twice is two of them" {
    let tally = Tally { total: 3 };
    assert.equal(twice(tally), 6);
}

test "counter is off by one" {
    let tally = Tally { total: 2 };
    assert.equal(counter(tally), 3);
}
