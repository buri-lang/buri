# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "workspace/executeCommand runs the one test a lens names, through the same buri test a terminal would, and reports the transcript as a log message and the verdict as a shown one"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
