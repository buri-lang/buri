# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ and repo2/ below are Buri repositories.

doc: "two repositories that go stale together are swept one after the other by the one worker, and the second waiting does not stop the first"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
