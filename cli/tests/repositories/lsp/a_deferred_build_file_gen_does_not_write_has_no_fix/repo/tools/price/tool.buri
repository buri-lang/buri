//! No modules, and a price worked out with `//lib/money` on the way — which
//! `tools/price/BUILD.buri` does not name in `dependencies`.

from "core/tool" import { Generated, GenerateRequest };
from "platform/effect" import { Allocator };
from "//lib/money" import { fromCents };

export fn generate<C: Allocator>(ctx: C, request: GenerateRequest<Str>): Generated {
    let price = fromCents(450);
    Generated { modules: [], diagnostics: [], needs: [] }
}
