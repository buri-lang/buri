# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a question about one file gets the same answer from the full analysis of its target, kept after a diagnostics pull, as from the scoped one a single request builds, though the full one holds every other file's bodies too"

# No `didOpen`: an unopened file is read from disk, and leaving the buffers out
# keeps the golden about the answers rather than about the diagnostics.
run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
