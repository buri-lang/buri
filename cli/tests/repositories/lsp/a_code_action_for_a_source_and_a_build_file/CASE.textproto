# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "the two code-action sources that `missing-dep` does not reach: the other two build-file findings `buri gen` answers, and a finding that carries its own bytes — offered, applied, and gone"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
