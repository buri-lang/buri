# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# `units.txt` writes two units. `width` has two lines of prose above it and
# `depth` has none, and neither line reaches the generated module — the
# generator prints declarations and nothing else. So the only place the prose
# can come from is the input, read at the span the anchor names.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>", "capabilities": {"textDocument": {"hover": {"contentFormat": ["markdown"]}}}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/wire/units\" import { depth, width };\n\n/// The face of the plate.\nexport fn area(): Int {\n    width * depth\n}\n"}}}
# The signature the generator printed, and the sentences the input wrote above
# the line it printed it from.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri"}, "position": {"line": 4, "character": 5}}}
# `depth` has nothing written above it, so the signature is the whole answer —
# the server does not go looking one line further up and take `width`'s.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri"}, "position": {"line": 4, "character": 13}}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
