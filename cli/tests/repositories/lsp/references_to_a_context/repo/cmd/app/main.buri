from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;

/// What this program is allowed to do.
context Program {
  Alloc: host.alloc,
  Stdout: host.stdout,
}

export fn main(): Result<(), Str> {
  let ctx = Program();
  let _ = ctx.println("one");
  let again = Program();
  let _ = again.println("two");
  .Ok(())
}
