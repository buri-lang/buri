# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a context declaration is a symbol like any other: its uses, its highlights, its hover and where it was declared — asked from both ends, which used to give two different answers because the constructor generated for it shares the name's span"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
