# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# `Square` names one field and is given two values: hovering it is still the variant.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/geo/shape.buri"}, "position": {"line": 7, "character": 10}}}
# The second value fills no field, so it is hovered as the number it is.
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://<scratch>/lib/geo/shape.buri"}, "position": {"line": 7, "character": 20}}}
{"jsonrpc": "2.0", "id": 4, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
