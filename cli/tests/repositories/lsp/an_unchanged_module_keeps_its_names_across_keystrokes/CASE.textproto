# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "unused-type and unused-import across keystrokes: a module no keystroke touched answers from the names its kept text holds, and each finding comes and goes with the text of the module it is about"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
