# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "the notifications this server has nothing to do about — a save it is warned of, a configuration it has no settings for, the four a notebook sends, and an inbound `$/progress` whose token deliberately carries the number of the request that follows it — and the request afterwards that shows ignoring one is neither dropping the connection nor cancelling anything"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
