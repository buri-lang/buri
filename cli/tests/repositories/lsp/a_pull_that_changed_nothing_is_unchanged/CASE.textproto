# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a pull quoting the result id it was last given is answered unchanged, an edit issues a new id, and a stale id is answered in full — and a client that did not ask for related documents is not sent any"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
