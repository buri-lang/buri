// A type error that stays where it is: every edit this case makes is appended
// below, so a report that moved is a report about a different repository state
// rather than about a different line.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

export fn total(): I64 {
    "not a number"
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "total: ${total().show(ctx)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
