# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a file no rule lists is loaded by no analysis, so hover and completion after a dot have nothing to say and completion offers the words in the file, before and after another file of its package is analysed"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
