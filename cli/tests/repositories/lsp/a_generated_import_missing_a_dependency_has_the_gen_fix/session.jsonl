# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
#
# The generator's module imports //lib/extra, which `lib/wire/BUILD.buri` does
# not list. Its import has no origin in any input, so the finding is about the
# generated module itself, a file no editor holds. `buri lint --fix` answers it
# by regenerating the build file of the package that declared the generator,
# and so does the fix offered here.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/wire/units\" export { extra };\n"}}}
# The fix is the whole BUILD.buri `buri gen` would write, which lists
# //lib/extra.
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/codeAction", "params": {"textDocument": {"uri": "file://<scratch>/lib/wire/lib.buri"}, "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 0}}, "context": {"diagnostics": [{"code": "missing-dependency", "message": "//lib/wire/units imports //lib/extra, which is not in dependencies", "range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 1}}}]}}}
{"jsonrpc": "2.0", "id": 3, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
