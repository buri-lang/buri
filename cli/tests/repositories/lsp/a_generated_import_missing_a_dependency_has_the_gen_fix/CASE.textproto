# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a generated module that imports a library its rule doesn't list is answered as `buri lint --fix` answers it: the fix is the `BUILD.buri` `buri gen` would write for the package that declared the generator"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
