# One JSON-RPC request per line. `<scratch>` becomes the copied repository.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"rootUri": "file://<scratch>"}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
# Addresses at the edges of a comment: one closing a block comment, one glued to
# the word before it, a scheme with nothing after it, and one that runs to the
# very end of the file. An import path that names no package gets no link.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri", "languageId": "buri", "version": 1, "text": "//! What a shop sells.\n//!\n//! Prices follow https://example.org/pricing, which is the rule here.\n\nfrom \"//lib/money\" import { Cents };\n\nfrom \"//lib/nowhere\" import { Gone };\n\n/* see https://example.org/a*/\n// glued:xhttps://example.org/b, bare https:// and\n// The shelf-edge format is at http://example.com/shelves and nowhere else.\n\n/// One thing for sale, priced as <https://example.org/pricing#cents> says.\nexport struct Item {\n    export name: Str,\n    export price: Cents,\n}\n\n/// Where to buy one.\nexport fn shopfront(): Str {\n    \"https://example.org/shop\"\n}\n\n// last https://example.org/end"}}}
{"jsonrpc": "2.0", "id": 2, "method": "textDocument/documentLink", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/catalog.buri"}}}
# A file no target lists yet, and a file in no package at all: the addresses in
# their comments are links all the same.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/stray.buri", "languageId": "buri", "version": 1, "text": "from \"//lib/money\" import { Cents };\n// see https://example.org/stray\n"}}}
{"jsonrpc": "2.0", "id": 3, "method": "textDocument/documentLink", "params": {"textDocument": {"uri": "file://<scratch>/lib/shop/stray.buri"}}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/notes.buri", "languageId": "buri", "version": 1, "text": "// see https://example.org/notes\n"}}}
{"jsonrpc": "2.0", "id": 4, "method": "textDocument/documentLink", "params": {"textDocument": {"uri": "file://<scratch>/notes.buri"}}}
# Colours for comments with Windows line endings, a block comment nested in
# another across lines, and a line comment and an unclosed block comment that
# run to the end of the file.
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/lib.buri", "languageId": "buri", "version": 1, "text": "// head\r\n/* outer /* inner */\r\n still outer */\r\nexport fn one(): I64 {\r\n    1\r\n}\r\n// tail"}}}
{"jsonrpc": "2.0", "id": 5, "method": "textDocument/semanticTokens/full", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/lib.buri"}}}
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/lib.buri", "version": 2}, "contentChanges": [{"text": "// head\r\nexport fn one(): I64 {\r\n    1\r\n}\r\n/* open"}]}}
{"jsonrpc": "2.0", "id": 6, "method": "textDocument/semanticTokens/full", "params": {"textDocument": {"uri": "file://<scratch>/lib/money/lib.buri"}}}
