# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "addresses at the edges of comments, links in files with no target, and colours for Windows line endings, nested and unclosed comments, and deltas that cut a head or a tail"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
