# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "the two formats an editor asks for without being told to: the declaration a typed `}` closes, and the whole file a save is about to write — which is the same answer `textDocument/formatting` gives, because it is the same function"

run {
  args: ["lsp"]
  exit: 0
  stdin: "session.jsonl"
  stream: OUT
  golden: "session.txt"
}
