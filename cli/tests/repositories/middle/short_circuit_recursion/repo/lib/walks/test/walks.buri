from "core/str" import * as str;

// Tests only.
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

// Each helper owns `k`, which only the inner operand reads.
fn andOr<C: Allocator>(ctx: C, n: Int): Bool {
    let k = str.format(ctx, "k${n}");
    n >= 0 && (k == "k0" || andOr(ctx, n - 1))
}

fn orAnd<C: Allocator>(ctx: C, n: Int): Bool {
    let k = str.format(ctx, "k${n}");
    n < 0 || k != "k0" && orAnd(ctx, n - 1)
}

fn deeper<C: Allocator>(ctx: C, n: Int): Bool {
    let k = str.format(ctx, "k${n}");
    n >= 0 && (k == "k0" || n > 0 && deeper(ctx, n - 1))
}

// `k` is read by the inner operand and handed to the recursion as well.
fn carried<C: Allocator>(ctx: C, label: Str, n: Int): Bool {
    let k = str.format(ctx, "${label}");
    n >= 0 && (k == "k0" || carried(ctx, k, n - 1))
}

fn inArm<C: Allocator>(ctx: C, n: Int): Bool {
    let k = str.format(ctx, "k${n}");
    n >= 0
        && match (n) {
            99 => false,
            _ => k == "k0" || inArm(ctx, n - 1),
        }
}

test "a helper recursing on the right of a nested short-circuit" {
    let ctx = alloc();
    assert.isTrue(andOr(ctx, 5));
    assert.isFalse(andOr(ctx, -1));
    assert.isFalse(orAnd(ctx, 5));
    assert.isTrue(orAnd(ctx, -1));
    assert.isTrue(deeper(ctx, 5));
    assert.isFalse(deeper(ctx, -1));
}

test "a helper handing the string it read on to the recursion" {
    let ctx = alloc();
    assert.isTrue(carried(ctx, "k0", 3));
    assert.isFalse(carried(ctx, "x", 3));
}

test "a helper recursing in a match arm under a short-circuit" {
    let ctx = alloc();
    assert.isTrue(inArm(ctx, 5));
    assert.isFalse(inArm(ctx, -1));
}
