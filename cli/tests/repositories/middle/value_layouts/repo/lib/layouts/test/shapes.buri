}

fn many(): Many {
    Many {
        f0: "0",
        f1: "1",
        f2: "2",
        f3: "3",
        f4: "4",
        f5: "5",
        f6: "6",
        f7: "7",
        f8: "8",
        f9: "9",
        f10: "10",
        f11: "11",
        f12: "12",
        f13: "13",
        f14: "14",
        f15: "15",
        f16: "16",
        f17: "17",
        f18: "18",
        f19: "19",
        f20: "20",
        f21: "21",
        f22: "22",
        f23: "23",
        f24: "24",
        f25: "25",
        f26: "26",
        f27: "27",
        f28: "28",
        f29: "29",
        f30: "30",
        f31: "31",
        f32: "32",
        f33: "33",
        f34: "34",
        f35: "35",
        f36: "36",
        f37: "37",
        f38: "38",
        f39: "39",
        f40: "40",
        f41: "41",
        f42: "42",
        f43: "43",
        f44: "44",
        f45: "45",
        f46: "46",
        f47: "47",
        f48: "48",
        f49: "49",
        f50: "50",
        f51: "51",
        f52: "52",
        f53: "53",
        f54: "54",
        f55: "55",
        f56: "56",
        f57: "57",
        f58: "58",
        f59: "59",
        f60: "60",
        f61: "61",
        f62: "62",
        f63: "63",
        f64: "64",
        f65: "65",
        f66: "66",
        f67: "67",
        f68: "68",
        f69: "69",
    }
}

fn relabel(m: Many): Many {
    Many { ..m, f1: "one", f68: "sixty-eight" }
}

test "a functional update of a struct wider than sixty-four fields" {
    let m = relabel(many());
    assert.equal(m.f0, "0");
    assert.equal(m.f1, "one");
    assert.equal(m.f67, "67");
    assert.equal(m.f68, "sixty-eight");
    assert.equal(m.f69, "69");
}
