// Tests only.
from "core/testing/assert" import * as assert;

enum Never {}

fn value(r: Result<Int, Never>): Int {
    match (r) {
        .Ok(n) => n,
        .Err(never) => {
            match (never) {
            }
        },
    }
}

test "a result whose error type has no values" {
    let r: Result<Int, Never> = .Ok(4);
    assert.equal(value(r), 4);
}

// Seventy fields: more than a 64-bit mask of them.
struct Many {
    f0: Str,
    f1: Str,
    f2: Str,
    f3: Str,
    f4: Str,
    f5: Str,
    f6: Str,
    f7: Str,
    f8: Str,
