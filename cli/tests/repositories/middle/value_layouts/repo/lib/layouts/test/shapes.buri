    f27: Str,
    f28: Str,
    f29: Str,
    f30: Str,
    f31: Str,
    f32: Str,
    f33: Str,
    f34: Str,
    f35: Str,
    f36: Str,
    f37: Str,
    f38: Str,
    f39: Str,
    f40: Str,
    f41: Str,
    f42: Str,
    f43: Str,
