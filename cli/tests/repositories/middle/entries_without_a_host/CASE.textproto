# A repository platform's entries whose first parameter is no host: an
# `Option`, a list, `core/number`'s `RangeError`, and three structs another
# platform declares. Each builds to a module of its own;
# `build::middle::an_entry_without_a_host_answers_its_caller` calls them.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "entries whose first parameter is no host build for their platform"

run {
  args: ["build", "//cmd/app"]
  exit: 0
  golden: "built.txt"
}
