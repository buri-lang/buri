// Entries whose first parameter is no host: an `Option`, a list, a struct of
// `core/number`'s, and three structs another platform declares, of a `Str`, of
// a list, of a struct and of an `Option`.
from "core/number" import { RangeError };
from "//platform/other" import { Maybe, Named, Tagged, Wrapped };

export fn pick(choice: Option<Int>, fallback: Int): Int;

export fn greet(who: Named, greeting: Str): Str;

export fn tag(tagged: Tagged, extra: Str): Int;

export fn total(xs: [Int], extra: Int): Int;

export fn explain(error: RangeError, extra: Str): Str;

export fn unwrap(wrapped: Wrapped, extra: Str): Str;

export fn peek(maybe: Maybe, extra: Int): Int;
