// A platform whose structs another platform's entries take first.
from "platform/host" import { HostAllocator };

export struct OtherHost {
    export alloc: HostAllocator,
}

export struct Named {
    export name: Str,
}

export struct Tagged {
    export tags: [Str],
}

export struct Wrapped {
    export named: Named,
}

export struct Maybe {
    export value: Option<Int>,
}

export fn start(host: OtherHost): Result<(), Str>;
