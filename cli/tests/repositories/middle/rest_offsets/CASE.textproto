# Recursions over `[x, ..rest]` that hand `rest` back to themselves: over a
# list nothing else holds and one another name still reads, returning the list
# or handing it to a call partway through and reading it again after, handing
# it on unchanged, taking another list in its place, reading another list each
# step, dropping the head on two ways round, and walking or swapping two at
# once, plus a rest returned without a loop, a rest read by a call on one way
# round, and a tuple returned whole. Both backends run every block, with the
# heap checked natively.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a recursion over a list's rest answers as before and leaves every other holder's view as it was"

run {
  args: ["test", "//lib/rest", "--force"]
  exit: 0
  golden: "test.txt"
}
