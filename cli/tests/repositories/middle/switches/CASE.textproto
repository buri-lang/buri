# Matches the lowering turns into a jump table, and the ones it must not: a
# guard on the first arm, and a lambda that binds around a list pattern. Both
# backends run every block.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "switch-shaped matches answer alike on both backends"

run {
  args: ["test", "//lib/sw", "--force"]
  exit: 0
  golden: "test.txt"
}
