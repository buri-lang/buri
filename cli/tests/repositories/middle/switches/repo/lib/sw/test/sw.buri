// Tests only.
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

enum Light {
    Red,
    Amber,
    Green,
}

fn wait(l: Light, night: Bool): Int {
    match (l) {
        .Red if night => 5,
        .Red => 30,
        .Amber => 3,
        .Green => 0,
    }
}

test "a guarded first arm on a plain enum" {
    assert.equal(wait(Light.Red, true), 5);
    assert.equal(wait(Light.Red, false), 30);
    assert.equal(wait(Light.Amber, false), 3);
    assert.equal(wait(Light.Green, true), 0);
}

test "a lambda binds around a list pattern" {
    let ctx = context {
        Allocator: alloc(),
    };
    let floor = 1;
    let lists = [[1, 2], [], [7]];
    let sizes = lists.map(ctx, fn(xs) => {
        match (xs) {
            all @ [_, ..] => all.length() + floor,
            [] => 0,
        }
    });
    assert.equal(sizes, [3, 0, 2]);
}
