        t62: [62],
        t63: [63],
        t64: [64],
        t65: [65],
    }
}

fn half(n: Int): Result<Int, Str> {
    if (n % 2 == 0) { .Ok(n / 2) } else { .Err("odd") }
}

// The replaced field is read, but only borrowed, before the replacement can
// leave early.
fn counted(w: Wide, k: Int): Result<Wide, Str> {
    .Ok(Wide { ..w, t0: [w.t0.length(), half(k)?] })
}

test "a functional update of a record past sixty-four fields can leave early" {
    match (counted(wide(), 4)) {
        .Ok(w) => {
            assert.equal(w.t0, [1, 2]);
            assert.equal(w.t65, [65]);
        },
        .Err(_) => assert.equal(true, false),
    };
    assert.equal(counted(wide(), 3).isOk(), false);
}
