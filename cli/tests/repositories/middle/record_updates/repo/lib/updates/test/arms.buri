// Tests only.
from "core/orderedmap" import * as orderedmap;
from "core/orderedmap" import { OrderedMap };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

enum Op {
    Put(Int),
    Delete(Int),
}

struct Node {
    applied: Int,
    store: OrderedMap<Int, Int>,
}

fn node<C: Allocator>(ctx: C): Node {
    Node {
        applied: 0,
        store: orderedmap.empty<Int, Int>().insert(ctx, 1, 1).insert(ctx, 2, 1),
    }
}

// Every arm reads the map: one reads a count and inserts it back, one removes.
fn direct<C: Allocator>(ctx: C, n: Node, op: Op): Node {
    Node {
        ..n,
        applied: n.applied + 1,
        store: match (op) {
            .Put(k) => n.store.insert(ctx, k, n.store.get(k).withDefault(0) + 1),
            .Delete(k) => n.store.remove(ctx, k),
        },
    }
}

// An `if` inside an arm, one that reads the map and one that doesn't.
fn branched<C: Allocator>(ctx: C, n: Node, op: Op): Node {
    Node {
        ..n,
        applied: n.applied + 1,
        store: match (op) {
            .Put(k) => {
                n
                    .store
                    .insert(
                        ctx,
                        k,
                        n.store.get(k).withDefault(0) + if (k < 0) { 0 } else { 1 },
                    )
            },
            .Delete(k) => if (k < 0) { n.store } else { n.store.remove(ctx, k) },
        },
    }
}

// A guard reads the map.
fn guarded<C: Allocator>(ctx: C, n: Node, op: Op): Node {
    Node {
        ..n,
        applied: n.applied + 1,
        store: match (op) {
            .Put(k) if n.store.has(k) => {
                n.store.insert(ctx, k, n.store.get(k).withDefault(0) + 1)
            },
            .Put(k) => n.store.insert(ctx, k, 1),
            .Delete(k) => n.store.remove(ctx, k),
        },
    }
}

// A condition puts the map's size in a list, and an arm matches on the key.
fn sized<C: Allocator>(ctx: C, n: Node, op: Op): Node {
    Node {
        ..n,
        applied: n.applied + 1,
        store: match (op) {
            .Put(k) => {
                n
                    .store
                    .insert(
                        ctx,
                        k,
                        n.store.get(k).withDefault(0)
                            + match (k) {
                                0 => 1,
                                _ => k / k,
                            },
                    )
            },
            .Delete(k) => {
                if ([n.store.size].length() < 0) {
                    n.store
                } else {
                    n.store.remove(ctx, k)
                }
            },
        },
    }
}

// A match on the map's size.
fn scrutinized<C: Allocator>(ctx: C, n: Node, op: Op): Node {
    Node {
        ..n,
        applied: n.applied + 1,
        store: match (op) {
            .Put(k) => n.store.insert(ctx, k, n.store.get(k).withDefault(0) + 1),
            .Delete(k) => {
                match (n.store.size) {
                    0 => n.store,
                    _ => n.store.remove(ctx, k),
                }
            },
        },
    }
}

// Called from two places, so it stays a call.
fn holds(m: OrderedMap<Int, Int>, k: Int): Bool {
    match (m.get(k)) {
        .Some(v) => v > 0 || k < 0,
        .None => false,
    }
}

// The map goes whole to `holds`, then to `insert` on one path and nowhere
// else on the other.
fn shared<C: Allocator>(ctx: C, n: Node, op: Op): Node {
    Node {
        ..n,
        applied: n.applied + 1,
        store: match (op) {
            .Put(k) => {
                if (holds(n.store, k)) {
                    n.store.insert(ctx, k, n.store.get(k).withDefault(0) + 1)
                } else {
                    orderedmap.empty<Int, Int>()
                }
            },
            .Delete(k) => n.store.remove(ctx, k),
        },
    }
}

fn counts(n: Node): [Int] {
    [
        n.applied,
        n.store.length(),
        n.store.get(1).withDefault(0),
        n.store.get(2).withDefault(0),
    ]
}

test "a map field changed in each arm of a match keeps the old record's map" {
    let ctx = context {
        Allocator: alloc(),
    };
    let start = node(ctx);
    let put = direct(ctx, start, .Put(1));
    let gone = direct(ctx, put, .Delete(2));
    assert.equal(counts(put), [1, 2, 2, 1]);
    assert.equal(counts(gone), [2, 1, 2, 0]);
    assert.equal(counts(start), [0, 2, 1, 1]);
    let put = branched(ctx, start, .Put(1));
    let gone = branched(ctx, put, .Delete(2));
    assert.equal(counts(gone), [2, 1, 2, 0]);
    assert.equal(counts(branched(ctx, gone, .Delete(-1))), [3, 1, 2, 0]);
    assert.equal(counts(start), [0, 2, 1, 1]);
}

test "a map field read in a guard, a condition, a scrutinee or a call before an arm keeps every view" {
    let ctx = context {
        Allocator: alloc(),
    };
    let start = node(ctx);
    let put = guarded(ctx, start, .Put(1));
    assert.equal(counts(guarded(ctx, put, .Put(3))), [2, 3, 2, 1]);
    let put = sized(ctx, start, .Put(2));
    assert.equal(counts(sized(ctx, put, .Delete(1))), [2, 1, 0, 2]);
    let put = scrutinized(ctx, start, .Put(1));
    let gone = scrutinized(ctx, put, .Delete(1));
    assert.equal(counts(scrutinized(ctx, gone, .Delete(2))), [3, 0, 0, 0]);
    assert.equal(counts(scrutinized(ctx, node(ctx), .Delete(5))), [1, 2, 1, 1]);
    let put = shared(ctx, start, .Put(1));
    assert.equal(counts(shared(ctx, put, .Put(3))), [2, 0, 0, 0]);
    assert.equal(counts(put), [1, 2, 2, 1]);
    assert.equal(holds(put.store, 1), true);
    assert.equal(counts(start), [0, 2, 1, 1]);
}
