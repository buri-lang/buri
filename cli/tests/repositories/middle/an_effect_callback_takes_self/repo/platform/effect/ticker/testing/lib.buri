from "//platform/effect/ticker" import { Ticker };

// Runs the callback once, at once, with twice the number.
export struct TestTicker {}

impl Ticker for TestTicker {
    fn every(self, n: Int, run: fn(TestTicker, Int) => Int): Int {
        run(self, n * 2)
    }
}

export fn ticker(): TestTicker {
    TestTicker {}
}

// Runs the callback with the number it was handed.
export struct FnTicker<F> {
    f: F,
}

impl<P, A> Ticker for FnTicker<fn(P) => A> {
    fn every(self, n: Int, run: fn(FnTicker<fn(P) => A>, Int) => Int): Int {
        run(self, n)
    }
}

export fn fnTicker<P, A>(f: fn(P) => A): FnTicker<fn(P) => A> {
    FnTicker { f: f }
}
