# `F32.toI128` through `buri test`, natively. Both native backends used to
# refuse it by name; the conformance corpus has the edge values.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a single-precision float into a 128-bit integer runs natively"

run {
  args: ["test", "//lib/conv", "--force"]
  exit: 0
  golden: "pass.txt"
}
