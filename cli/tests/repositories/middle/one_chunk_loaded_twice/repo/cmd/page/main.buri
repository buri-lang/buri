// A page that loads its editor from two places. Both share one chunk.

from "core/io" import * as io;
from "core/lazy" import * as lazy;
from "core/str" import * as str;
from "platform/effect" import { Allocator, Stdout };
from "web" import { WebHost };

fn editor<C: Allocator + Stdout>(ctx: C, rows: Int): () {
    io.println(ctx, str.format(ctx, "ONLY_IN_THE_CHUNK ${rows}")).ignore()
}

export fn main(host: WebHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let open = lazy.load(editor);
    let again = lazy.load(editor);
    let _ = open(ctx, 3);
    let _ = again(ctx, 4);
    .Ok(())
}
