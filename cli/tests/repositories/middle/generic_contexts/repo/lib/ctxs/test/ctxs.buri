// Tests only.
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

// A context built inside a generic function binds a type parameter.
fn wrap<C: Allocator>(ctx: C): [Int] {
    let inner = context {
        Allocator: ctx,
    };
    [1, 2].map(inner, fn(x) => x * 2)
}

fn rewrap<C: Allocator>(ctx: C): [Int] {
    let inner = context {
        Allocator: ctx,
    };
    wrap(inner)
}

test "contexts built over a type parameter" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(wrap(alloc()), [2, 4]);
    assert.equal(rewrap(alloc()), [2, 4]);
    assert.equal(rewrap(ctx), [2, 4]);
}
