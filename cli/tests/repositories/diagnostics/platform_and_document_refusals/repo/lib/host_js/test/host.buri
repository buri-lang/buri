from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Location };
from "platform/effect/testing" import { alloc };
from "ui/web" import * as web;
from "web" import { HostLocation, HostStorage };
from "web/storage" import * as storage;
from "web/storage" import { Storage };

test "the address bar and the store are the browser's" {
    let ctx = context { Allocator: alloc(), Location: HostLocation {}, Storage: HostStorage {} };
    let _ = web.route(ctx);
    assert.isTrue(storage.keys(ctx, "draft/").isOk());
}
