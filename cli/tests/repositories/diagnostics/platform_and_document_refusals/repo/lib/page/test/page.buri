from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless };
from "ui/node" import * as ui;
from "ui/web" import * as web;

test "a page needs a document" {
    let ctx = context { Allocator: alloc(), Ui: headless() };
    let root = ui.text({ content: .Const("hi") });
    web.title(ctx, .Const("Home"));
    assert.equal(web.render(root), "hi");
    assert.isTrue(web.state(ctx).isNone());
    assert.isTrue(web.resume(ctx, root).isOk());
    assert.isTrue(ui.mount(ctx, root, []).isOk());
}
