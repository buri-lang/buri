// Random bytes sealed under a random key.
from "core/crypto" import * as crypto;
from "core/io" import * as io;
from "core/secret" import * as secret;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Entropy, Stdout };

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Entropy: host.entropy,
    };
    let key = crypto.randomBytes(ctx, 32);
    io.println(ctx, "${crypto.seal(ctx, secret.of(key), [], []).length()}").mapErr(fn(_e) => "could not write")
}
