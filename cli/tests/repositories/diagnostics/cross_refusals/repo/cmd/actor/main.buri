// An actor counting what it is sent.
from "core/actor" import * as actor;
from "core/io" import * as io;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout, Tasks };

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Tasks: host.tasks,
    };
    let counter = actor.start(
        ctx,
        actor.Actor {
            state: 0,
            step: fn(_c, total, n) => actor.Stepped { state: total + n, answer: total + n },
            onStop: .None,
        },
    );
    match (counter.sendMessage(ctx, 2)) {
        .Ok(total) => io.println(ctx, "${total}").mapErr(fn(_e) => "could not write"),
        .Err(_e) => .Err("the actor stopped"),
    }
}
