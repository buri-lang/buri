// A timer set and cancelled inside a task scope.
from "core/io" import * as io;
from "core/tasks" import * as tasks;
from "core/time" import * as time;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout, Tasks };

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Tasks: host.tasks,
    };
    let _ = tasks.scope(ctx, fn(c, scope) => tasks.spawn(c, scope, fn(_c) => ()));
    let timer = tasks.after(ctx, time.milliseconds(1000), fn(_c) => ());
    let _ = tasks.cancel(ctx, timer);
    io.println(ctx, "done").mapErr(fn(_e) => "could not write")
}
