# `check_during_build: true` moves *when* the catalogue runs, and nothing else.
# `buri build` and `buri test` report the same finding `buri lint` does, and
# both still exit 0 — a repository that wanted the finding to stop the command
# has a second field to write, and this one has not written it.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "check_during_build alone: build and test report the catalogue's findings and still exit 0"

run {
  args: ["build", "//lib/money", "--verbose"]
  exit: 0
  golden: "build.txt"
}

run {
  args: ["test", "//lib/money"]
  exit: 0
  golden: "test.txt"
}

# The finding's own fix: the multiplication was dead, so it goes with the name.
edit {
  file: "lib/money/cents.buri"
  replace: "  let doubled = n * 2;\n"
  with: ""
}

run {
  args: ["build", "//...", "--verbose"]
  exit: 0
  golden: "clean_build.txt"
}

run {
  args: ["test", "//..."]
  exit: 0
  golden: "clean_test.txt"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean_lint.txt"
}
