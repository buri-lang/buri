// `str` is imported and never used, and the file beside this one does not
// parse. The finding here is the one a reader would lose if a syntax error
// anywhere in the package were a reason to stop reporting.

from "core/str" import * as str;
from "platform/effect" import { Allocator };

export fn describe<C: Allocator>(ctx: C): Str {
    "some".concat(ctx, " cents")
}
