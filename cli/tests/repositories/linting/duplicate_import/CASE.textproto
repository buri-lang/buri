# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "one module named by two named import statements: duplicate-import, and the namespace clause beside it that has no single statement to merge into"

run {
  args: ["lint", "//cmd/app"]
  exit: 0
  golden: "lint.txt"
}

run {
  args: ["lint", "//cmd/app", "--error-format=json"]
  exit: 0
  golden: "lint.json"
}

# Merging is the whole fix, and it is one statement naming both.
edit {
  file: "cmd/app/main.buri"
  replace: "from \"core/effect\" import { Alloc };\nfrom \"core/effect\" import { Stdout };\n"
  with: "from \"core/effect\" import { Alloc, Stdout };\n"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
