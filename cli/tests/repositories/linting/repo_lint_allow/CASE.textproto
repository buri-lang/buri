# `lint { allow { … } }`: one declaration, named in the one file everybody
# reads, that a rule is not asked about. Four runs — the finding, the exemption,
# the exemption gone stale, and the exemption that does not read.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a six-parameter API fixed from outside is refused, exempted by name in REPO.buri, and refused again the moment the name stops matching"

# Both functions are the same shape, and both are findings.
run {
  args: ["lint", "//..."]
  exit: 1
  golden: "refused.txt"
}

edit {
  file: "REPO.buri"
  replace: "# Nothing written yet: the whole catalogue runs over the whole repository."
  with: "lint {\n    allow {\n        # The frame header is the protocol's, field for field. Grouping it\n        # would not change what a caller assembles, and the order is not\n        # ours to change.\n        too_many_parameters: [\"//lib/wire:encode\"]\n    }\n}"
}

# `encode` is gone and `describe` beside it is not: the rule is still on, for
# everything but the one declaration this repository argued about.
run {
  args: ["lint", "//..."]
  exit: 1
  golden: "allowed.txt"
}

# An exemption that names nothing exempts nothing. That is the whole of what
# happens when the declaration is renamed and the file is not: the finding comes
# back, which is the safe direction for it to fail in.
edit {
  file: "REPO.buri"
  replace: "//lib/wire:encode"
  with: "//lib/wire:enkode"
}

run {
  args: ["lint", "//..."]
  exit: 1
  golden: "stale.txt"
}

# A label that is not a label is a file that does not read, rather than a rule
# quietly off.
edit {
  file: "REPO.buri"
  replace: "//lib/wire:enkode"
  with: "lib/wire:encode"
}

run {
  args: ["lint", "//..."]
  exit: 2
  golden: "not_a_label.txt"
}
