# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a context that asks for effects its body never exercises: unused-context-bound, five findings beside the three ways of using a bound, and the fix that trims the bound lists"

run {
  args: ["lint", "//..."]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//...", "--error-format=json"]
  exit: 1
  golden: "lint.json"
}

# Five findings, three declarations, and four rewrites: `shout`'s two bounds are
# one piece of text with one `+` between them, so the removal is computed once
# and both of the findings about that parameter carry it. Applying it once
# answers both. `tally`'s two are apart, with `Stdout` staying between them, so
# each takes its own `+` and the two deletions are separate.
run {
  args: ["lint", "//...", "--fix"]
  exit: 0
  golden: "fix.txt"
}

file {
  path: "cmd/app/main.buri"
  golden: "main.buri"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}

# The property a rewriting tool has to earn: what it wrote is still a program.
run {
  args: ["build", "//cmd/app"]
  exit: 0
  golden: "build.txt"
}
