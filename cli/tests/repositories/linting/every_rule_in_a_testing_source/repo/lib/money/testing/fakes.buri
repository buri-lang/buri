// A test-only helper module, written the way one really goes wrong. Every rule
// in the catalogue's general half fires here once, and each is the same rule
// the library one directory up is held to.

// TODO: these fakes are not finished.

from "core/effect" import { Allocator };
from "core/effect" import { IoError, Stdout };
from "core/io" import * as io;
from "core/order" import { Order };
from "core/str" import * as str;
from "//lib/money" import { Cents, fromCents };

let HEX_DIGITS: Str = "0123456789abcdef";

let NANOSECONDS_PER_MILLISECOND: I64 = 1_000_000;

struct Ledger {
    entries: I64,
    note: Str,
}

struct Receipt {
    total: I64,
}

enum Shade {
    Light,
    Dark,
}

// On the testing surface, and read only by another package's suite. A fixture
// is written for somebody else's test, so the surface is what keeps it alive.
export struct Fixture {
    export label: Str,
}

export fn aFixture(): Fixture {
    Fixture { label: "f" }
}

// Exported, not on the testing surface, and named by nothing beside it:
// reached by nobody, exactly as the same shape in a library source is.
export fn stale(): I64 {
    1
}

fn total(a: I64, b: I64, c: I64, d: I64, e: I64, f: I64): I64 {
    a + b + c + d + e + f
}

fn compareInts(left: Int, right: Int): Order {
    if (left < right) { .Less } else if (left > right) { .Greater } else { .Equal }
}

fn width<C: Allocator>(ctx: C, label: Str): Int {
    label.length()
}

fn announce<C: Allocator + Stdout>(ctx: C, label: Str): Result<(), IoError> {
    io.println(ctx, "-- ${label}")
}

fn drop<C: Stdout>(ctx: C, line: Str): () {
    let _ = io.println(ctx, line).ignore();
}

fn byHand<C: Stdout>(ctx: C, line: Str): () {
    match (io.println(ctx, line)) {
        .Ok(_written) => (),
        .Err(_error) => (),
    }
}

fn depth(n: I64): Str {
    if (n > 0) {
        if (n > 10) {
            if (n > 100) {
                if (n > 1000) {
                    if (n > 10000) { "huge" } else { "large" }
                } else {
                    "big"
                }
            } else {
                "medium"
            }
        } else {
            "small"
        }
    } else {
        "none"
    }
}

fn tally(count: I64): Str {
    let apples = count * 3;
    let pears = apples + 2;
    let plums = pears + 4;
    let fruit = apples + pears + plums;
    let bread = fruit + 6;
    let butter = bread + 3;
    let cheese = butter * 2;
    let dairy = butter + cheese;
    let beans = dairy + 5;
    let rice = beans * 2;
    let pasta = rice + 7;
    let staples = beans + rice + pasta;
    let tea = staples + 1;
    let coffee = tea * 3;
    let juice = coffee + 2;
    let drinks = tea + coffee + juice;
    let soap = drinks + 4;
    let brush = soap + 2;
    let paper = brush * 2;
    let household = soap + brush + paper;
    let basket = fruit + staples + drinks + household;
    let delivery = basket / 10;
    let packing = delivery + 2;
    let handling = packing * 2;
    let carriage = delivery + packing + handling;
    let subtotal = basket + carriage;
    let levy = subtotal / 5;
    let duty = levy + 3;
    let surcharge = duty * 2;
    let charges = levy + duty + surcharge;
    let gross = subtotal + charges;
    let loyalty = gross / 20;
    let voucher = loyalty + 4;
    let coupon = voucher * 2;
    let discounts = loyalty + voucher + coupon;
    let net = gross - discounts;
    let rounding = net / 100;
    let adjusted = net + rounding;
    let credit = adjusted / 50;
    let owed = adjusted - credit;
    let banked = owed / 25;
    let due = owed - banked;
    if (due > 0) { "owing" } else { "settled" }
}

// On the testing surface, and called only by the suite next door.
export fn fakeCents<C: Allocator + Stdout>(ctx: C): Cents {
    let unread = total(1, 2, 3, 4, 5, 6);
    let ledger = Ledger { entries: 2, note: "unread" };
    let shade: Shade = .Light;
    let _ = drop(ctx, "one");
    let _ = byHand(ctx, "two");
    let _ = announce(ctx, "three").ignore();
    let _ = compareInts(1, 2);
    let _ = match (shade) {
        _ => (),
    };
    let counted = ledger.entries
        + width(ctx, depth(5))
        + tally(7).length()
        + HEX_DIGITS.length()
        + NANOSECONDS_PER_MILLISECOND;
    fromCents(counted)
}
