# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "an import and a local whose only evidence sits inside a declaration that did not check: the error is the whole report, because a rule reading a body the checker stopped in would be reporting the gap"

run {
  args: ["lint", "//lib/money"]
  exit: 1
  golden: "lint.txt"
}

# The unknown name is the whole mistake. With it written the declaration is read, and
# `spare` is reported for being bound and never used — the finding the report
# above was right to be silent about.
edit {
  file: "lib/money/cents.buri"
  replace: "fromInt(ctx, one)"
  with: "fromInt(ctx, 1)"
}

run {
  args: ["lint", "//lib/money"]
  exit: 1
  golden: "in_view.txt"
}

edit {
  file: "lib/money/cents.buri"
  replace: "    let spare = 7;\n"
  with: ""
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
