// Two findings' worth of evidence sits inside the declaration that did not
// check: `fromInt` is imported and used only in these arms, and `spare` is
// bound here and read nowhere. Neither is reported, because neither is known
// — the checker stopped at the unknown name and what it skipped is not evidence
// of anything. The edit in the manifest writes the name right and both come
// into view, which is what says the silence was scoped rather than lucky.

from "core/str" import { fromInt };
from "platform/effect" import { Allocator };

export fn describe<C: Allocator>(ctx: C, n: I64): Str {
  let spare = 7;
  match (n) {
    1 => fromInt(ctx, one),
    _ => fromInt(ctx, 2),
  }
}
