# A rule written `false` in `REPO.buri` is off everywhere at once: `buri lint`
# does not report it, and neither does the pass `check_during_build` runs
# during `buri build` and `buri test`. It is dropped rather than downgraded,
# and never dropped in silence — the report says which rule went.
#
# The second `lint` is the same command over the same tree, so its findings
# come out of the lint record written by the first. It is recorded against the
# *same* golden: a record holds what the catalogue found, and which rules this
# repository runs is applied after the record is read back, so a cached run and
# a cold one cannot disagree about a rule that is off.
#
# The last two steps turn the rule back on. That is the half a filtered report
# cannot fake: if the record had been written with the finding already dropped,
# or if a `REPO.buri` edit could leave a record reachable, the finding would
# stay missing here.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "one rule turned off in REPO.buri: no command reports it, every command says which rule that was, and turning it back on brings it back"

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "lint.txt"
}

# The same answer out of the record the run above wrote.
run {
  args: ["lint", "//..."]
  exit: 0
  golden: "lint.txt"
}

run {
  args: ["build", "//lib/money", "--verbose"]
  exit: 0
  golden: "build.txt"
}

run {
  args: ["test", "//lib/money"]
  exit: 0
  golden: "test.txt"
}

# The rule goes back on. Nothing else about the repository moves.
edit {
  file: "REPO.buri"
  replace: "unused_variable: false"
  with: "unused_variable: true"
}

run {
  args: ["lint", "//..."]
  exit: 1
  golden: "lint_on.txt"
}

# And with `fail_on_finding`, the finding it was hiding stops the build.
run {
  args: ["build", "//lib/money", "--verbose"]
  exit: 1
  golden: "build_on.txt"
}
