// The two findings this rule reports and declines to rewrite. Both are real —
// neither body reads the context it declares — and in both the call sites are
// somewhere the analysis in front of the fix cannot reach: past the library's
// surface for one, and inside a type for the other.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/label" import { stamp };

/// Reported, and not rewritten. `plain` is handed to `apply` as a value, so
/// its shape is the one `fn(C, Str) => Int` asked for rather than the one its
/// body needs: deleting the parameter would change the type and leave the call
/// exactly where it was.
fn plain<C: Alloc>(ctx: C, label: Str): Int {
    label.len()
}

/// Not reported. Handing the context to a function-typed parameter is one of
/// the three ways of using one.
fn apply<C: Alloc>(ctx: C, measure: fn(C, Str) => Int, label: Str): Int {
    measure(ctx, label)
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let label = "ledger";
    io
        .println(ctx, "${apply(ctx, plain, label)} and ${stamp(ctx, label)}")
        .mapErr(fn(_e) => "could not write to standard output")
}
