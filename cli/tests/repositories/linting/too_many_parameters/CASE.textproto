# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "six loose parameters that always travel together: too-many-parameters, and the struct that is the fix the diagnostic names"

run {
  args: ["lint", "//cmd/app"]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//cmd/app", "--error-format=json"]
  exit: 1
  golden: "lint.json"
}

# The entity, not a shorter list: the three values that travel together get a
# name, and the signature takes two of those instead of six numbers.
edit {
  file: "cmd/app/main.buri"
  replace: "fn total(a: I64, b: I64, c: I64, d: I64, e: I64, f: I64): I64 {\n  a + b + c + d + e + f\n}"
  with: "struct Triple(I64, I64, I64);\n\nfn total(x: Triple, y: Triple): I64 {\n  x.0 + x.1 + x.2 + y.0 + y.1 + y.2\n}"
}

edit {
  file: "cmd/app/main.buri"
  replace: "total(1, 2, 3, 4, 5, 6)"
  with: "total(Triple(1, 2, 3), Triple(4, 5, 6))"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
