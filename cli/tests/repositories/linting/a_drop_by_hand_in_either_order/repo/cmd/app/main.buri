from "node" import { NodeHost };
from "platform/effect" import { Stdout };
from "//lib/say" import {
    sayAgainOnError, sayAnyway, sayErrorFirst, sayUnlessEmpty, sayUnlessQuiet,
};

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Stdout: host.stdout,
    };
    let _ = sayErrorFirst(ctx, "one");
    let _ = sayUnlessQuiet(ctx, "two", false);
    let _ = sayAgainOnError(ctx, "three");
    let _ = sayAnyway(ctx, "four");
    let _ = sayUnlessEmpty(ctx, "five");
    .Ok(())
}
