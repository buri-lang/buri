from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;

from "//lib/label" import { note, stamp };

export fn main(): Result<(), Str> {
  let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
  let _ = stamp(ctx, "ledger").mapErr(fn(_e) => "could not write to standard output")?;
  note(ctx, "ledger").mapErr(fn(_e) => "could not write to standard output")
}
