# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "lint --fix with a package at the repository root: its own unused-context is fixed with the files named from the root, and a file no rule lists one directory down goes into that package's BUILD.buri rather than the root's"

run {
  args: ["lint", "//..."]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//...", "--fix"]
  exit: 0
  golden: "fix.txt"
}

file {
  path: "main.buri"
  golden: "main.buri"
}

file {
  path: "lib/words/BUILD.buri"
  golden: "BUILD.buri"
}

file {
  path: "BUILD.buri"
  golden: "root.BUILD.buri"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
