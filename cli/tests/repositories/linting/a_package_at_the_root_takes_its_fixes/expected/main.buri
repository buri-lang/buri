// A package at the repository root, whose files are named from the root.
// `width` declares a context and never reads it, and `--fix` deletes the
// parameter and the argument here as it would one directory down.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };
from "//lib/words" import { word };

fn width<C: Allocator>(label: Str): Int {
    label.length()
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    io
        .println(ctx, "${word()} is ${width(word())} wide")
        .mapErr(fn(_e) => "could not write to standard output")
}
