// One arm without its `,`. This package is the one that does not parse; the
// package beside it is the one whose findings must still arrive.

export struct Route {
    export name: Str,
}

export fn route(path: Str): Route {
  match (path) {
    "/health" => Route { name: "health" }
    _ => Route { name: "fallback" },
  }
}
