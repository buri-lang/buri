// A test source with the same two mistakes, one of them written the way only a
// test source can write it: a context is built here, and one of its keys names
// an effect that no longer exists.

from "core/effect" import { Alloc };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/db" import { stamp };
from "//lib/db/testing" import { fakeStamp };

test "a tenant is stamped with its region" {
    let ctx = context {
        Alloc: alloc(),
        Fs: alloc(),
    };
    let region: Str = 1;
    assert.eq(stamp(ctx, region), fakeStamp(ctx, region));
}
