// The third file, which parses. `str` is imported and never used and `spare`
// is bound and never read, and both are still reported with two of its three
// siblings broken: recovery is per file, and a second broken file is not a
// second reason to stop.

from "core/str" import * as str;
from "//lib/money/routes.buri" import { Route };

export fn describe(r: Route): Str {
    let spare = 3;
    r.name
}
