// A function that answers an `Order` by comparing two primitives with `<` and
// `>` has written `core/order`'s own body out: hand-rolled-comparator.
// `compareInts` is `order.int` and `compareBools` is `order.bool`, character
// for character.
//
// The three below them are not findings, and each is a different reason.
// `compareDescending` maps `<` to `.Greater`: it is a reversed order and means
// something else, so it is not a copy of anything — `order.reverse` is what it
// wants. `compareFloats` has a fourth branch, which is a total order over
// `NaN` that `order.float` does not answer. `compareOctets` is over a `U8`,
// and `order.int` takes an `Int`: a fix that would not type-check is not one
// this rule offers.

from "core/io" import * as io;
from "core/math" import * as math;
from "core/order" import { Order };
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn compareInts(left: Int, right: Int): Order {
    if (left < right) { .Less } else if (left > right) { .Greater } else { .Equal }
}

fn compareBools(left: Bool, right: Bool): Order {
    if (left == right) { .Equal } else if (left) { .Greater } else { .Less }
}

fn compareDescending(left: Int, right: Int): Order {
    if (left < right) { .Greater } else if (left > right) { .Less } else { .Equal }
}

fn compareFloats(left: Float, right: Float): Order {
    if (left < right) {
        .Less
    } else if (left > right) {
        .Greater
    } else if (math.isNan(left)) {
        if (math.isNan(right)) { .Equal } else { .Greater }
    } else if (math.isNan(right)) {
        .Less
    } else {
        .Equal
    }
}

fn compareOctets(left: U8, right: U8): Order {
    if (left < right) { .Less } else if (left > right) { .Greater } else { .Equal }
}

// None of the rest are findings either. Each is one step off a chain the rule
// knows: a second comparison of other operands or with another operator, a
// chain with no second comparison, a branch answering the wrong variant, a
// condition that is a call or a negation, the `Bool` chain over integers, and
// the `Bool` chain testing the wrong operand or answering the wrong variants.

fn compareSwappedOperands(left: Int, right: Int): Order {
    if (left < right) { .Less } else if (right > left) { .Greater } else { .Equal }
}

fn compareAgainstZero(left: Int, right: Int): Order {
    if (left < right) { .Less } else if (left > 0) { .Greater } else { .Equal }
}

fn compareAtLeast(left: Int, right: Int): Order {
    if (left < right) { .Less } else if (left >= right) { .Greater } else { .Equal }
}

fn compareMixed(left: Int, right: Int, low: Float, high: Float): Order {
    if (left < right) { .Less } else if (low > high) { .Greater } else { .Equal }
}

fn compareTwoWays(left: Int, right: Int): Order {
    if (left < right) { .Less } else { .Greater }
}

fn compareEqualInTheMiddle(left: Int, right: Int): Order {
    if (left < right) { .Less } else if (left > right) { .Equal } else { .Greater }
}

fn compareNan(left: Float, right: Float): Order {
    if (math.isNan(left)) { .Less } else if (left > right) { .Greater } else { .Equal }
}

fn compareIntsByEquality(left: Int, right: Int): Order {
    if (left == right) { .Equal } else if (left > right) { .Greater } else { .Less }
}

fn compareNegated(left: Bool, right: Bool): Order {
    if (!left) { .Less } else if (right) { .Greater } else { .Equal }
}

fn compareBoolsByTheRight(left: Bool, right: Bool): Order {
    if (left == right) { .Equal } else if (right) { .Greater } else { .Less }
}

fn compareBoolsWithItself(left: Bool, right: Bool): Order {
    if (left == left) { .Equal } else if (left) { .Greater } else { .Less }
}

fn compareBoolsLessFirst(left: Bool, right: Bool): Order {
    if (left == right) { .Equal } else if (left) { .Less } else { .Greater }
}

fn compareBoolsLessOnEqual(left: Bool, right: Bool): Order {
    if (left == right) { .Less } else if (left) { .Greater } else { .Equal }
}

fn compareBoolsNeverLess(left: Bool, right: Bool): Order {
    if (left == right) { .Equal } else if (left) { .Greater } else { .Equal }
}

fn label(ordered: Order): Str {
    match (ordered) {
        .Less => "less",
        .Equal => "equal",
        .Greater => "greater",
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let said = [
        label(compareInts(1, 2)),
        label(compareBools(true, false)),
        label(compareDescending(1, 2)),
        label(compareFloats(1.0, 2.0)),
        label(compareOctets(1, 2)),
        label(compareSwappedOperands(1, 2)),
        label(compareAgainstZero(1, 2)),
        label(compareAtLeast(1, 2)),
        label(compareMixed(1, 2, 1.0, 2.0)),
        label(compareTwoWays(1, 2)),
        label(compareEqualInTheMiddle(1, 2)),
        label(compareNan(1.0, 2.0)),
        label(compareIntsByEquality(1, 2)),
        label(compareNegated(true, false)),
        label(compareBoolsByTheRight(true, false)),
        label(compareBoolsWithItself(true, false)),
        label(compareBoolsLessFirst(true, false)),
        label(compareBoolsLessOnEqual(true, false)),
        label(compareBoolsNeverLess(true, false)),
    ];
    io
        .println(ctx, said.join(ctx, " "))
        .mapErr(fn(_e) => "could not write to standard output")
}
