# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a nanoseconds-per-millisecond constant and a timeout multiplied out in place: time-unit-conversion, three times with the million on either side, with a parts-per-million denominator of the same literal beside them that is not a finding"

run {
  args: ["lint", "//cmd/app"]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//cmd/app", "--error-format=json"]
  exit: 1
  golden: "lint.json"
}

# What the diagnostic names: the unit moves out of the names and into the
# type. `core/time` holds both conversions, and the million that was never
# about time stays exactly where it was.

edit {
  file: "cmd/app/main.buri"
  replace: "from \"core/io\" import * as io;\n"
  with: "from \"core/io\" import * as io;\nfrom \"core/time\" import * as time;\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "let NANOSECONDS_PER_MILLISECOND: I64 = 1_000_000;\n\n"
  with: ""
}

edit {
  file: "cmd/app/main.buri"
  replace: "let IDLE_TIMEOUT_MILLIS: I64 = 30_000;\n\n"
  with: ""
}

edit {
  file: "cmd/app/main.buri"
  replace: "    startedNanos + IDLE_TIMEOUT_MILLIS * 1_000_000\n"
  with: "    startedNanos + time.seconds(30).nanoseconds()\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "    nanoseconds / NANOSECONDS_PER_MILLISECOND\n"
  with: "    time.nanoseconds(nanoseconds).milliseconds()\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "    1_000_000 * IDLE_TIMEOUT_MILLIS\n"
  with: "    time.seconds(30).nanoseconds()\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "    IDLE_TIMEOUT_MILLIS * 1000\n"
  with: "    time.seconds(30).microseconds()\n"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}

# A `*` with nothing before it, as the first thing in the file: there is no
# operand on its left to read a unit from, and the file is reported as broken.
edit {
  file: "cmd/app/main.buri"
  replace: "// A timeout kept as a count"
  with: "* 1_000_000\n// A timeout kept as a count"
}

run {
  args: ["lint", "//..."]
  exit: 1
  golden: "star.txt"
}
