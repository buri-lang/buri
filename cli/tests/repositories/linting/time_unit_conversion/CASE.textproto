# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a nanoseconds-per-millisecond constant and a timeout multiplied out in place: time-unit-conversion, twice, with a parts-per-million denominator of the same literal beside them that is not a finding"

run {
  args: ["lint", "//cmd/app"]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//cmd/app", "--error-format=json"]
  exit: 1
  golden: "lint.json"
}

# What the diagnostic names: the unit moves out of the names and into the
# type. `core/time` holds both conversions, and the million that was never
# about time stays exactly where it was.

edit {
  file: "cmd/app/main.buri"
  replace: "from \"core/io\" import * as io;\n"
  with: "from \"core/io\" import * as io;\nfrom \"core/time\" import * as time;\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "let NANOS_PER_MILLISECOND: I64 = 1_000_000;\n\n"
  with: ""
}

edit {
  file: "cmd/app/main.buri"
  replace: "let IDLE_TIMEOUT_MILLIS: I64 = 30_000;\n\n"
  with: ""
}

edit {
  file: "cmd/app/main.buri"
  replace: "    startedNanos + IDLE_TIMEOUT_MILLIS * 1_000_000\n"
  with: "    startedNanos + time.seconds(30).nanos()\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "    nanos / NANOS_PER_MILLISECOND\n"
  with: "    time.nanos(nanos).millis()\n"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
