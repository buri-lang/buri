# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a body past the forty-line limit, beside the two tables of the same length the limit does not count"

run {
  args: ["lint", "//cmd/app"]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//cmd/app", "--error-format=json"]
  exit: 1
  golden: "lint.json"
}

# The seam, not a cut at line forty: the body stops pricing the basket and
# starts charging for it, so each half is a function that can be named.
edit {
  file: "cmd/app/main.buri"
  replace: "    let subtotal = basket + carriage;\n"
  with: "    charged(basket + carriage)\n}\n\nfn charged(subtotal: I64): Str {\n"
}

# The table and the match are untouched and still forty-five lines each, so a
# clean repository is the record that neither of them counts.
run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
