# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a body past the forty-line limit: oversized-function, and the seam the table splits at"

run {
  args: ["lint", "//cmd/app"]
  exit: 1
  golden: "lint.txt"
}

run {
  args: ["lint", "//cmd/app", "--error-format=json"]
  exit: 1
  golden: "lint.json"
}

# The seam, not a cut at line forty: the units are one table and everything
# above nineteen is another, so each half is a function that can be named.
edit {
  file: "cmd/app/main.buri"
  replace: "        20 => \"twenty\",\n        21 => \"twenty-one\",\n        22 => \"twenty-two\",\n        23 => \"twenty-three\",\n        24 => \"twenty-four\",\n        25 => \"twenty-five\",\n        26 => \"twenty-six\",\n        27 => \"twenty-seven\",\n        28 => \"twenty-eight\",\n        29 => \"twenty-nine\",\n        30 => \"thirty\",\n        31 => \"thirty-one\",\n        32 => \"thirty-two\",\n        33 => \"thirty-three\",\n        34 => \"thirty-four\",\n        35 => \"thirty-five\",\n        _ => \"many\",\n"
  with: "_ => beyondNineteen(n),\n"
}

edit {
  file: "cmd/app/main.buri"
  replace: "fn spell(n: I64): Str {\n"
  with: "fn beyondNineteen(n: I64): Str {\n  match (n) {\n    20 => \"twenty\",\n    21 => \"twenty-one\",\n    22 => \"twenty-two\",\n    23 => \"twenty-three\",\n    24 => \"twenty-four\",\n    25 => \"twenty-five\",\n    26 => \"twenty-six\",\n    27 => \"twenty-seven\",\n    28 => \"twenty-eight\",\n    29 => \"twenty-nine\",\n    30 => \"thirty\",\n    31 => \"thirty-one\",\n    32 => \"thirty-two\",\n    33 => \"thirty-three\",\n    34 => \"thirty-four\",\n    35 => \"thirty-five\",\n    _ => \"many\",\n  }\n}\n\nfn spell(n: I64): Str {\n"
}

run {
  args: ["lint", "//..."]
  exit: 0
  golden: "clean.txt"
}
