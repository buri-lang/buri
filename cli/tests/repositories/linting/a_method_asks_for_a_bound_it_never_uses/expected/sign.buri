// A method's own bound is asked about the way a function's is, and a bound on
// the `impl`'s parameter is not asked about at all.

from "core/io" import * as io;
from "platform/effect" import { Allocator, IoError, Stdout };
from "//lib/sign/marks.buri" import { FLAG, POST };

export struct Sign {
    text: Str,
}

export fn sign(text: Str): Sign {
    Sign { text: text }
}

impl Sign {
    /// The finding. `io.println` asks for `Stdout` alone, so `Allocator` is a
    /// demand on every caller of this method for nothing.
    export fn hang<C: Stdout>(self, ctx: C): Result<(), IoError> {
        io.println(ctx, "${POST} ${self.text}")
    }
}

export struct Banner {
    text: Str,
}

export fn banner(text: Str): Banner {
    Banner { text: text }
}

/// Not a finding. `C` belongs to the block, so its bounds are a demand every
/// method in it shares, and one method's body cannot say a bound is spare.
impl<C: Allocator + Stdout> Banner {
    export fn fly(self, ctx: C): Result<(), IoError> {
        io.println(ctx, "${FLAG} ${self.text}")
    }
}
