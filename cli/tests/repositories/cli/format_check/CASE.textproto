# `buri format --check` is the CI form: it reports what would change and
# rewrites nothing. That "and rewrites nothing" is the half a passing exit code
# cannot show, so the file's own bytes are recorded before and after.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "format --check reports without rewriting; format rewrites source and build files alike; formatting is a fixed point"

# Both files are checked in badly formatted on purpose: `main.buri` is source,
# and `cmd/f/BUILD.buri` is a build file whose fields are in the wrong order and
# indented by the wrong amount. One command formats both, so `--check` must
# report both.
run {
  args: ["format", "--check"]
  exit: 1
  golden: "check_reports.txt"
}

# And must have left them exactly as it found them.
file {
  path: "cmd/f/main.buri"
  golden: "ugly.buri"
}

file {
  path: "cmd/f/BUILD.buri"
  golden: "ugly_build.buri"
}

run {
  args: ["format"]
  exit: 0
}

file {
  path: "cmd/f/main.buri"
  golden: "formatted.buri"
}

# The schema's field order — `sources` before `outputs` — a four-space indent,
# and the comment still on the block it was written above.
file {
  path: "cmd/f/BUILD.buri"
  golden: "formatted_build.buri"
}

# A fixed point: formatting formatted source changes nothing.
run {
  args: ["format", "--check"]
  exit: 0
}

# And formatting preserved the meaning, not merely the syntax.
run {
  args: ["build", "//cmd/f"]
  exit: 0
}
