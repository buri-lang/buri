# Two declared outputs. `--output` selects one of them; with no selector every
# one of them is built. `{{CROSS_VARIANT}}` is a variant that is not this
# host's, filled in by the harness — see cli/tests/harness/case.rs.
binary {
    outputs: [
        { platform: "node" },
        { platform: "native", variant: "{{CROSS_VARIANT}}" },
    ]
}
