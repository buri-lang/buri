# `buri gen` writes the fields that restate the sources and no others. That
# split is the whole design of the command, and it is two claims: the six
# managed fields come back derived, and everything else — `tags`, `platforms`,
# `timeout_seconds`, `visibility`, `test.data`, `test.platforms`, and every
# comment — comes back saying exactly what it said.
#
# `lib/money/BUILD.buri` starts as CLI.md says a package may start: the policy
# written out and the rule otherwise empty. So the recorded file is also the
# answer to "what does `gen` produce from nothing", and the second half of the
# case takes one managed field away again and shows `--check` reporting it
# without writing.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "gen derives the six managed fields, preserves every other field and comment, and --check reports without writing"

run {
  args: ["gen", "//lib/money"]
  exit: 0
  golden: "gen.txt"
}

# The whole file, because the claim is about what did *not* change as much as
# about what did.
file {
  path: "lib/money/BUILD.buri"
  golden: "regenerated.buri"
}

# "It leaves the file exactly as `buri format` would" — so the two never fight
# over a file. Nothing in the repository would change, including the one `gen`
# just wrote.
run {
  args: ["format", "--check"]
  exit: 0
}

# Idempotent: a second run finds nothing to do and says nothing.
run {
  args: ["gen", "//lib/money"]
  exit: 0
  golden: "idempotent.txt"
}

run {
  args: ["gen", "--check", "//lib/money"]
  exit: 0
}

# The derived build file is not merely stable, it is *right*: lint agrees with
# it and the suite the derived `test.sources` names actually runs.
run {
  args: ["lint", "//..."]
  exit: 0
  golden: "lint.txt"
}

run {
  args: ["test", "//lib/money"]
  exit: 0
  golden: "test.txt"
}

# Now take a managed field away. A field the tool manages is replaced whole
# rather than merged, so this is what hand-editing `sources` is worth.
edit {
  file: "lib/money/BUILD.buri"
  replace: "sources: [\"cents.buri\", \"parse.buri\"]"
  with: "sources: [\"parse.buri\"]"
}

run {
  args: ["gen", "--check", "//lib/money"]
  exit: 1
  golden: "check.txt"
}

# And `--check` wrote nothing, which is the half the exit code cannot show.
file {
  path: "lib/money/BUILD.buri"
  golden: "stale.buri"
}

run {
  args: ["gen", "//lib/money"]
  exit: 0
  golden: "regen_again.txt"
}

# Byte for byte the file from before the edit — the same golden, deliberately.
file {
  path: "lib/money/BUILD.buri"
  golden: "regenerated.buri"
}
