from "core/testing/assert/lib.buri" import * as assert;
from "//lib/money/lib.buri" import { fromCents, isBlank };
from "//lib/money/testing/lib.buri" import { sample };
from "//lib/util/testing/lib.buri" import { blank };

test "cents keep the value they were made with" {
    assert.eq(fromCents(5).value, 5);
}

test "the sample fixture is the sample amount" {
    assert.eq(sample().value, 1905);
}

test "a blank memo is blank" {
    assert.isTrue(isBlank(blank()));
}
