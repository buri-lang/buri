//! One module, `files`, with an exported `Str` per input holding its text.

from "core/buri/ast" import * as ast;
from "core/tool" import { Generated, GenerateRequest };
from "platform/effect" import { Allocator };

export fn generate<C: Allocator>(ctx: C, request: GenerateRequest<Str>): Generated {
    let items = request
        .inputs
        .mapCtx(ctx, fn(c, input) => {
            let file = input.path.split(c, "/").last().withDefault(input.path);
            constant(file.toLower(c).replace(c, ".", "_"), input.value)
        });
    Generated {
        modules: [("files", ast.Module { items: items, docs: [] })],
        diagnostics: [],
        needs: [],
    }
}

/// `export let <name>: Str = "<text>";`
fn constant(name: Str, text: Str): ast.Item {
    let str = ast.Name { text: "Str", origin: ast.nowhere() };
    ast.Item {
        kind: .Let(ast.LetDecl {
            name: ast.Name { text: name, origin: ast.nowhere() },
            ty: ast.Type { kind: .Named(str, []), origin: ast.nowhere() },
            value: ast.Expr { kind: .Str(text), origin: ast.nowhere() },
            exported: true,
            docs: [],
        }),
        origin: ast.nowhere(),
    }
}
