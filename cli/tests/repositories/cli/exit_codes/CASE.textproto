# CLI.md fixes three exit codes: 0 success, 1 "the thing you asked about is
# wrong", 2 "the thing you asked *with* is wrong". The distinction is the whole
# point of having two failure codes, so it is worth pinning — and unlike the
# assertion this replaces, the message each prints is recorded too.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "exit 0, 1 and 2 distinguish success, bad code, and a bad invocation"

# 0: it worked.
run {
  args: ["build", "//cmd/ok"]
  exit: 0
}

# 1: the code is wrong.
edit {
  file: "cmd/ok/main.buri"
  replace: "\"fine\""
  with: "notAName"
}

run {
  args: ["build", "//cmd/ok"]
  exit: 1
  golden: "type_error.txt"
}

edit {
  file: "cmd/ok/main.buri"
  replace: "notAName"
  with: "\"fine\""
}

# 2: the invocation is wrong. Six ways to ask for something that is not there
# or not a thing, each recorded, because "exit 2" without a message is a
# toolchain refusing to say what it wanted.
run {
  args: ["build", "//cmd/nope"]
  exit: 2
  golden: "no_such_target.txt"
}

run {
  args: ["build", "lib/relative"]
  exit: 2
  golden: "relative_label.txt"
}

run {
  args: ["frobnicate"]
  exit: 2
  golden: "unknown_command.txt"
}

run {
  args: ["build", "--nonsense"]
  exit: 2
  golden: "unknown_flag.txt"
}

run {
  args: ["query", "wat(//cmd/ok)"]
  exit: 2
  golden: "unknown_query.txt"
}

# And a sixth, which is `--output` asked of `buri test`. The flag is spelled the
# way `buri build` spells it and asks a different question: a suite runs on a
# **platform**, not on an output some rule declared, so the set is closed and
# the refusal names the whole of it.
#
# It is 2 rather than 1 because nothing was compiled to be wrong about, and it
# is refused rather than defaulted because a run that quietly used the default
# would report a pass for a backend nobody chose.
run {
  args: ["test", "//cmd/ok", "--output=nonsense"]
  exit: 2
  golden: "no_such_platform.txt"
  stream: ERR
}

# An unparseable build file is also the thing you asked *with*, not the thing
# you asked about: there is no program yet to be wrong.
edit {
  file: "cmd/ok/BUILD.buri"
  replace: "binary {\n    outputs: [\n        { platform: JS },\n    ]\n}\n"
  with: "binary {\n  sources: [\n"
}

run {
  args: ["build", "//cmd/ok"]
  exit: 2
  golden: "unparseable_build_file.txt"
}
