# One `native` platform, two variants. Each variant builds into a directory of
# its own, `.buri/out/native/<variant>/`, and `buri run` runs the one this
# machine is.
#
# The cross variant is listed first, so a `run` that took the first native
# output would try to start a program this machine cannot run.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "two native variants build into two directories, and `buri run` runs the host's"

run {
  args: ["run", "//cmd/app"]
  exit: 0
  golden: "ran.txt"
  stream: OUT
}

path {
  path: ".buri/out/native/{{HOST_VARIANT}}/cmd/app/app"
  exists: true
}

# A Linux artifact builds on any host and a macOS one only on a macOS host, so
# the two hosts answer the cross variant differently and each step names the
# host it is about. A mac builds its cross variant (Linux) beside the host's.
run {
  args: ["build", "//cmd/app", "--output=native/{{CROSS_VARIANT}}"]
  exit: 0
  host: MACOS
}

path {
  path: ".buri/out/native/{{CROSS_VARIANT}}/cmd/app/app"
  exists: true
  host: MACOS
}

# A Linux host's cross variant is macOS, which it cannot build: the build is
# refused, and the refusal leaves nothing in the cross variant's directory.
run {
  args: ["build", "//cmd/app", "--output=native/{{CROSS_VARIANT}}"]
  exit: 1
  host: LINUX
}

path {
  path: ".buri/out/native/{{CROSS_VARIANT}}/cmd/app/app"
  exists: false
  host: LINUX
}

path {
  path: ".buri/out/native/{{HOST_VARIANT}}/cmd/app/app"
  exists: true
}

