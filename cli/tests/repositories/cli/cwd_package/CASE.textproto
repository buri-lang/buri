# "With no argument, commands operate on the package containing the working
# directory." A claim about scope, so the only way to check it is to stand
# somewhere and find that the rest of the repository was left alone.
#
# `cmd/app` carries an `unused-import`, which is an error `buri lint` reports:
# every no-argument run below happens inside `lib/money` and none of them may
# mention it, and the run from the root at the end does. A scoped command that
# could not have said anything is a scoped command that proves nothing.
#
# `buri gen` is the one command the rule does not cover — with no argument it
# means `//...` — and it is not run here. `cli/gen_whole_repository` is where
# that exception is recorded.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a command with no target operates on the package containing the working directory, and on nothing else"

run {
  args: ["build"]
  cwd: "lib/money"
  exit: 0
  golden: "build_in_money.txt"
}

run {
  args: ["test"]
  cwd: "lib/money"
  exit: 0
  golden: "test_in_money.txt"
}

# The one that carries the evidence: clean here, and the repository is not.
run {
  args: ["lint"]
  cwd: "lib/money"
  exit: 0
  golden: "lint_in_money.txt"
}

# The same forms from inside the other package, so that "the package
# containing the working directory" is shown twice rather than once in a
# repository that has one answer anyway.
run {
  args: ["build"]
  cwd: "cmd/app"
  exit: 0
  golden: "build_in_app.txt"
}

run {
  args: ["lint"]
  cwd: "cmd/app"
  exit: 1
  golden: "lint_in_app.txt"
}

# A directory that is not a package and holds no build file. There is nothing
# to operate on, and saying so is the answer — naming a package is the fix.
run {
  args: ["build"]
  cwd: "lib"
  exit: 2
  golden: "no_package.txt"
}

# From the root, the whole repository — and the finding the scoped runs were
# right not to report.
run {
  args: ["lint", "//..."]
  exit: 1
  golden: "lint_all.txt"
}
