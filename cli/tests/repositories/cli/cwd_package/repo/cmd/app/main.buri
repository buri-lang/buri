from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;

// Imported and never used: an `unused-import`, which is an error and which
// `buri lint` reports. It is here so that a lint run scoped to //lib/money has
// something it must *not* report.
from "//lib/money" import { fromCents };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };
  let _ = ctx.println("app");
  .Ok(())
}
