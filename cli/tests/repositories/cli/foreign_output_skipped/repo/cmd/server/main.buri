from "core/io" import * as io;
from "core/net/http" import * as http;
from "core/net/server" import * as server;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Listen, Stdout, Tasks };

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Listen: host.listen,
        Stdout: host.stdout,
        Tasks: host.tasks,
    };
    let plan = server.Server {
        port: 0,
        onRequest: fn(c, request) => http.text(c, request.path()),
        requestLimit: .Some(1),
        idleTimeout: .None,
    };
    match (server.bind(ctx, plan)) {
        .Err(e) => .Err(server.errorText(e)),
        .Ok(listener) => {
            let _ = io.println(ctx, "port ${listener.port}").ignore();
            server.run(ctx, listener, plan).mapErr(server.errorText).map(fn(_ok) => ())
        },
    }
}
