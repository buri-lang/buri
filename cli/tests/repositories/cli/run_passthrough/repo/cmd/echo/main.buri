// A binary that says what it was given and then decides its own exit code.
//
// It also reads a file relative to the working directory, which is what makes
// this a test of `buri run` rather than of the backend: everything before
// `run` in the pipeline is hermetic, and this program is handed the real
// filesystem and the real environment.

from "core/effect" import { Alloc, Env, Proc, Stdout };
from "core/fs" import { FsRead };
from "core/env" import * as env;
from "core/fs" import * as fs;
from "core/host" import * as host;
from "core/io" import * as io;
from "core/path" import * as path;
from "core/proc" import * as proc;

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
        Env: host.env,
        FsRead: host.fsRead,
        Proc: host.proc,
    };
    let args = env.args(ctx);
    let _ = io
        .println(ctx, "argc ${args.len()}")
        .mapErr(fn(_e) => "could not write to standard output")?;
    let _ = io
        .println(ctx, "argv ${args.join(ctx, " ")}")
        .mapErr(fn(_e) => "could not write to standard output")?;
    let note = match (fs.readText(ctx, path.of(ctx, "note.txt"))) {
        .Ok(text) => text.trim(),
        .Err(_) => "no note",
    };
    let _ = io
        .println(ctx, "note ${note}")
        .mapErr(fn(_e) => "could not write to standard output")?;

    // `if` is an expression, so both branches produce the same `()`.
    let _ = if (args.any(fn(a) => a == "--fail")) { proc.exit(ctx, 3) } else { () };
    .Ok(())
}
