from "core/effect" import { Alloc, Env, Stdout };
from "core/env" import * as env;
from "core/host" import * as host;

// The binary's surface for its own test suite.
from "//tools/report/flags" export { Flags, parseFlags };

from "//tools/report/flags" import { parseFlags };

from "//tools/report" import { render };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
    Env:    host.env,
  };
  let flags = parseFlags(env.args(ctx));
  let _ = ctx.println("${render(ctx, 1905)} ${flags.title}");
  .Ok(())
}
