from "core/effect/lib.buri" import { Alloc, Env, Stdout };
from "core/env/lib.buri" import * as env;
from "core/host/lib.buri" import * as host;

// The binary's surface for its own test suite.
from "//tools/report/flags.buri" export { Flags, parseFlags };

from "//tools/report/flags.buri" import { parseFlags };

from "//tools/report/lib.buri" import { render };

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
    Env:    host.env,
  };
  let flags = parseFlags(env.args(ctx));
  let _ = ctx.println("${render(ctx, 1905)} ${flags.title}");
  .Ok(())
}
