from "core/env" import * as env;
from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Environment, Stdout };

// The binary's surface for its own test suite.
from "//tools/report/flags.buri" export { Flags, parseFlags };

from "//tools/report/flags.buri" import { parseFlags };

from "//tools/report" import { render };

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Environment: host.env,
    };
    let flags = parseFlags(env.arguments(ctx));
    io
        .println(ctx, "${render(ctx, 1905)} ${flags.title}")
        .mapErr(fn(_e) => "could not write to standard output")
}
