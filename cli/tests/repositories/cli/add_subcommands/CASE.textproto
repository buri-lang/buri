# `buri add` is a namespace, and `buri add skills` is the one thing under it.
#
# Three claims, and the two refusals are as much of the contract as the run
# that works:
#
#   * `buri add` alone lists what it can be asked for and exits 2 — the same
#     answer `buri` alone gives, one level down;
#   * `buri add skills` writes the skills, and a second run rewrites them,
#     which is the upgrade path;
#   * `buri add-skills`, the spelling before this one, is *gone* — no alias,
#     no hidden entry — and the error names its replacement, which is what
#     somebody holding a script from the last release needs to read.
#
# The refusals come first so that the `.agent/skills` check between them and
# the run that works means something: a refusal that had written the skills
# anyway would pass every later step.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "add is a namespace: skills writes them, and the hyphenated spelling is gone"

run {
  args: ["add"]
  exit: 2
  golden: "no_subcommand.txt"
}

# A subcommand that does not exist is answered the way an unknown command is:
# what was wrong, the nearest real spelling, then the list.
run {
  args: ["add", "skils"]
  exit: 2
  golden: "misspelled.txt"
}

# The old spelling. It fails as any unknown command does — and says what to
# type instead, which `nearest` cannot: a rename is not a typo.
run {
  args: ["add-skills"]
  exit: 2
  golden: "old_spelling.txt"
}

# Nothing above wrote anything. Without this, every step below would pass for
# a refusal that installed the skills first.
path {
  path: ".agent/skills"
  exists: false
}

run {
  args: ["add", "skills"]
  exit: 0
  golden: "wrote.txt"
}

file {
  path: ".agent/skills/buri-cli/SKILL.md"
  contains: "name: buri-cli"
}

# Re-running is the upgrade: the same five, reported as rewritten.
run {
  args: ["add", "skills"]
  exit: 0
  golden: "overwrote.txt"
}

# The directory argument, named explicitly. `.` is where the two runs above
# already wrote, so the same five lines come back.
run {
  args: ["add", "skills", "."]
  exit: 0
  golden: "overwrote.txt"
}

run {
  args: ["add", "skills", "nowhere"]
  exit: 2
  golden: "not_a_directory.txt"
}

# One directory or none. Two is the invocation being wrong.
run {
  args: ["add", "skills", ".", "."]
  exit: 2
  golden: "two_directories.txt"
}
