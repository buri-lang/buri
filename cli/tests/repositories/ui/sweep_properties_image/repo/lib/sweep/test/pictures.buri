// One picture per family of `ui/style` properties, over an `image` in a styled
// box — `ui.image` takes no styles of its own, and its source is one the
// painter cannot load, so it draws the placeholder.
//
// Resting state throughout: no style here is inside an `On`, so the
// state a snapshot is taken in contributes nothing to any of them.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/sweep" import {
    gapPage, paddingPage, runsPage, sizePage, surfacePage, typePage,
};

test "the surface properties, on a image" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "image-surface", surfacePage(), .Hover, []);
}

test "the type properties, on a image" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "image-type", typePage(), .Hover, []);
}

test "how a run of text is set, on a image" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "image-runs", runsPage(), .Hover, []);
}

test "the paddings, on a image" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "image-padding", paddingPage(), .Hover, []);
}

test "the gaps, and the mark beside a child, on a image" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "image-gap", gapPage(), .Hover, []);
}

test "the sizing properties, on a image" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "image-size", sizePage(), .Hover, []);
}
