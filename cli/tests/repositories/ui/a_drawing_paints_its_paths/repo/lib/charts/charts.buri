//! A card with a week of sales drawn as a sparkline.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/shape" import * as shape;
from "ui/shape" import { Segment };

/// The week's points, in a drawing `100` units wide and `40` tall.
fn points(): [Segment] {
    [
        .MoveTo(0.0, 32.0),
        .LineTo(20.0, 24.0),
        .LineTo(40.0, 28.0),
        .LineTo(60.0, 6.0),
        .LineTo(80.0, 14.0),
        .LineTo(100.0, 10.0),
    ]
}

/// The same points, closed along the bottom edge.
fn area(): [Segment] {
    [
        .MoveTo(0.0, 40.0),
        .LineTo(0.0, 32.0),
        .LineTo(20.0, 24.0),
        .LineTo(40.0, 28.0),
        .LineTo(60.0, 6.0),
        .LineTo(80.0, 14.0),
        .LineTo(100.0, 10.0),
        .LineTo(100.0, 40.0),
        .Close,
    ]
}

/// The area under the line, then the line over it in the card's text colour.
export fn card<C>(): Node<C> {
    ui.stack({
        styles: [
            .Padding(.Px(16)),
            .Background(.Rgb(255, 255, 255)),
            .Foreground(.Rgb(30, 90, 200)),
        ],
        children: [
            ui.drawing({
                alt: .AccessibilityText("Sales this week"),
                size: .Const((100.0, 40.0)),
                styles: [.Width(.Px(200)), .Height(.Px(80))],
                shapes: [
                    shape.path({
                        segments: .Const(area()),
                        fill: .Some(.Const(.Rgba(30, 90, 200, 0.25))),
                    }),
                    shape.path({
                        segments: .Const(points()),
                        stroke: .Some(.Const(.Inherit)),
                        strokeWidth: .Some(.Const(2.0)),
                    }),
                ],
            }),
        ],
    })
}
