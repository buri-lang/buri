from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui };
from "ui/node" import { describe };
from "ui/testing" import { headless };
from "//lib/site" import { site };

test "a computation answers the tree it captured" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    assert.equal(
        describe(ctx, site(ctx, 3), .Checked),
        "buri-scene 1\nviewport 800 600\ne 0 class:lay-col\nt 1 page 0\nt 1 page 1\nt 1 page 2",
    );
}
