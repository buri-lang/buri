from "ui/node" import * as ui;
from "ui/node" import { Node };

/// The page every picture is drawn on: eight hundred wide with nothing inset
/// either side, so a boundary in a picture is a number off the viewport's own
/// edge.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.PaddingY(.Px(6)), .Gap(.Px(8)), .FontSize(.Px(13))])], children: rows })
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.Gap(.Px(2))])], children: [
        ui.stack({ styles: [.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], children: [
            ui.text({ content: .Const(label) }),
        ] }),
        demo,
    ] })
}

/// Every `Track` there is, across the whole eight hundred: exactly this
/// wide, a share of what is left, and as wide as the content needs.
export fn tracks<C>(): Node<C> {
    page([
        band(
            "Fixed(.Px(160)) three times",
            ui.stack({ styles: [
                    .Layout(
                        .Grid([.Fixed(.Px(160)), .Fixed(.Px(160)), .Fixed(.Px(160))]),
                    ),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
                ] }),
        ),
        band(
            "Fraction(1) three times",
            ui.stack({ styles: [.Layout(.Grid([.Fraction(1), .Fraction(1), .Fraction(1)]))], children: [
                ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
            ] }),
        ),
        band(
            "Auto three times",
            ui.stack({ styles: [.Layout(.Grid([.Auto, .Auto, .Auto]))], children: [
                ui.stack({ styles: [
                        .Background(.Rgb(200, 40, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("narrow") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 150, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("a middling cell") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("the widest cell of the three") })] }),
            ] }),
        ),
    ])
}

/// The last row is the one to read with a ruler: an eighty-pixel track,
/// then one share against two, so the boundaries land at 80 and 320 of 800.
export fn fractions<C>(): Node<C> {
    page([
        band(
            "Fraction(1), Fraction(2)",
            ui.stack({ styles: [.Layout(.Grid([.Fraction(1), .Fraction(2)]))], children: [
                ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
            ] }),
        ),
        band(
            "Fraction(2), Fraction(1)",
            ui.stack({ styles: [.Layout(.Grid([.Fraction(2), .Fraction(1)]))], children: [
                ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
            ] }),
        ),
        band(
            "Fraction(1) three times",
            ui.stack({ styles: [.Layout(.Grid([.Fraction(1), .Fraction(1), .Fraction(1)]))], children: [
                ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
            ] }),
        ),
        band(
            "Fixed(.Px(80)), Fraction(1), Fraction(2)",
            ui.stack({ styles: [.Layout(.Grid([.Fixed(.Px(80)), .Fraction(1), .Fraction(2)]))], children: [
                ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
            ] }),
        ),
    ])
}

/// A share is a share of what the fixed and the content-sized tracks left,
/// which is the whole of what makes a mixed grid different from three of a
/// kind.
export fn mixedTracks<C>(): Node<C> {
    page([
        band(
            "Fixed(.Px(120)), Auto, Fraction(1)",
            ui.stack({ styles: [.Layout(.Grid([.Fixed(.Px(120)), .Auto, .Fraction(1)]))], children: [
                ui.stack({ styles: [
                        .Background(.Rgb(200, 40, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("fixed") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 150, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("auto") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("fraction") })] }),
            ] }),
        ),
        band(
            "Auto, Fraction(1), Fixed(.Px(100))",
            ui.stack({ styles: [.Layout(.Grid([.Auto, .Fraction(1), .Fixed(.Px(100))]))], children: [
                ui.stack({ styles: [
                        .Background(.Rgb(200, 40, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("fixed") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 150, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("auto") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("fraction") })] }),
            ] }),
        ),
        band(
            "Fraction(1), Fixed(.Px(200)), Fraction(3)",
            ui.stack({ styles: [.Layout(.Grid([.Fraction(1), .Fixed(.Px(200)), .Fraction(3)]))], children: [
                ui.stack({ styles: [
                        .Background(.Rgb(200, 40, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("fixed") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 150, 40)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("auto") })] }),
                ui.stack({ styles: [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                    ], children: [ui.text({ content: .Const("fraction") })] }),
            ] }),
        ),
    ])
}

/// `Span` over four even tracks of two hundred. The first block covers as
/// many as it asks for and the three behind it shuffle along.
export fn span<C>(): Node<C> {
    page([
        band(
            "Span(1) on the first cell",
            ui.stack({ styles: [
                    .Layout(
                        .Grid([.Fraction(1), .Fraction(1), .Fraction(1), .Fraction(1)]),
                    ),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(30)), .Span(1)], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(30))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(30))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(230, 160, 20)), .Height(.Px(30))], children: [] }),
                ] }),
        ),
        band(
            "Span(2) on the first cell",
            ui.stack({ styles: [
                    .Layout(
                        .Grid([.Fraction(1), .Fraction(1), .Fraction(1), .Fraction(1)]),
                    ),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(30)), .Span(2)], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(30))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(30))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(230, 160, 20)), .Height(.Px(30))], children: [] }),
                ] }),
        ),
        band(
            "Span(3) on the first cell",
            ui.stack({ styles: [
                    .Layout(
                        .Grid([.Fraction(1), .Fraction(1), .Fraction(1), .Fraction(1)]),
                    ),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(30)), .Span(3)], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(30))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(30))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(230, 160, 20)), .Height(.Px(30))], children: [] }),
                ] }),
        ),
    ])
}

/// A gap in a grid comes out of the room the shares divide, so three even
/// tracks get narrower as the gap grows.
export fn gridGaps<C>(): Node<C> {
    page([
        band(
            "Fraction(1) three times, Gap(.Px(0))",
            ui.stack({ styles: [
                    .Layout(.Grid([.Fraction(1), .Fraction(1), .Fraction(1)])),
                    .Gap(.Px(0)),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
                ] }),
        ),
        band(
            "Fraction(1) three times, Gap(.Px(12))",
            ui.stack({ styles: [
                    .Layout(.Grid([.Fraction(1), .Fraction(1), .Fraction(1)])),
                    .Gap(.Px(12)),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
                ] }),
        ),
        band(
            "Fraction(1) three times, Gap(.Px(40))",
            ui.stack({ styles: [
                    .Layout(.Grid([.Fraction(1), .Fraction(1), .Fraction(1)])),
                    .Gap(.Px(40)),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(200, 40, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 150, 40)), .Height(.Px(36))], children: [] }),
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(36))], children: [] }),
                ] }),
        ),
    ])
}
