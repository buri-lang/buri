# `Layout(.Grid)` and its `Track`s: `Fixed`, `Fraction` and `Auto`, three of a
# kind and then mixed, plus `Span` and what a gap takes out of the shares.
#
# `grid-fractions.png`'s last row is the one to read with a ruler: an
# eighty-pixel fixed track, then one share against two over the seven hundred
# and twenty that are left, so the boundaries land at 80 and 320 of 800.
#
# There is no `MinMax` track in `ui/style`; the three above are the whole enum.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "every kind of grid track, the three of them mixed, what a share of the leftover room is worth, `Span`, and what a gap takes out of the shares"

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 0
  golden: "pass.txt"
}

# A run that matched leaves no difference behind.
path { path: "lib/scenes/test/__snapshots__/grid-tracks.diff.png"  exists: false }

# A snapshot nobody has recorded yet fails, and the report says how to
# record one rather than showing a difference against nothing.
edit {
  file: "lib/scenes/test/grid.buri"
  replace: "\"grid-tracks\""
  with: "\"never-recorded\""
}

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 1
  golden: "missing.txt"
}

path { path: "lib/scenes/test/__snapshots__/never-recorded.png"  exists: false }

# `--update` records the one that was missing and rewrites the rest, and
# the run after it compares against what it just wrote.
run {
  args: ["test", "//lib/scenes", "--update", "--force"]
  exit: 0
  golden: "recorded.txt"
}

path { path: "lib/scenes/test/__snapshots__/never-recorded.png"  exists: true }

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 0
  golden: "again.txt"
}

# The negative twin: one label in the last picture, and the difference
# image on disk beside the golden it did not match.
edit {
  file: "lib/scenes/scenes.buri"
  replace: "Fraction(1) three times, Gap(.Px(0))"
  with: "Fraction(1) three times, no Gap"
}

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/scenes/test/__snapshots__/grid-gaps.diff.png"  exists: true }
path { path: "lib/scenes/test/__snapshots__/grid-tracks.diff.png"  exists: false }
