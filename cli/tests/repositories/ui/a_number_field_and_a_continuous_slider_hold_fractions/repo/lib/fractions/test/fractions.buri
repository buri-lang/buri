// A number field and a slider with no step hold fractions, painted. A browser
// draws each thumb where the snapshot does, rather than snapped to a step of
// one, because the page's markup says `step="any"`:
// `repositories::snapshots_render_as_pages` mounts this in a browser and
// fails on a control off its step.

from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "ui/node" import * as ui;
from "//lib/fractions" import { form };

test "number fields and sliders with no step hold fractions" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let scene = ui.describe(ctx, form(ctx), .Checked);
    assert.containsText(scene, "field:number");
    assert.containsText(scene, "range:0.0 2.0 0.5");
    snapshot(ctx, "fractions", form(ctx), .Checked, []);
}
