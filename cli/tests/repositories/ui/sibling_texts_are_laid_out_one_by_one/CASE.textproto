# Three sibling texts in a column are three lines, and in a row three words
# side by side, each text laid out on its own. The pages built from these
# snapshots check that a browser lays each text out on its own too: written
# bare, a browser runs sibling texts into one box (buri#357).
#
# The last step changes one text. A painter that drew no text would pass it;
# this one fails and leaves the diff.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "sibling texts are laid out one by one in a column and in a row, and a changed text fails the golden"

run {
  args: ["test", "//lib/figures", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/figures/test/__snapshots__/column.diff.png"  exists: false }

edit {
  file: "lib/figures/test/texts.buri"
  replace: ".Const(\"$600k\")"
  with: ".Const(\"$700k\")"
}

run {
  args: ["test", "//lib/figures", "--force"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/figures/test/__snapshots__/column.diff.png"  exists: true }
