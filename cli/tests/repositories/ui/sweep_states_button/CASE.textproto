# Button, in every state: six pictures of one tree — the resting one, and one
# per `State`.
#
# The rows are the five states `snapshot` accepts, plus the rest that has no
# variant to name it. The columns are `Background`, `Foreground`, `Border`,
# `Opacity` and `Shadow`, then all five at once, then the control that answers
# to nothing — so a picture says which element responded and how, with the cell
# that did not beside the ones that did.
#
# A button is the widget a browser paints most of by itself, so the sheet opens
# with `:where(button){appearance:none;background:none;border:0;padding:0;
# font:inherit;color:inherit}`. The painter reads a scene document rather than a
# DOM and never draws that chrome in the first place, so the `bare` row is a
# button with nothing on it — and a bevel appearing there would be the bug.
#
# The negative twin moves one number in one cell of the hover palette. Exactly
# one of the six goldens changes, which is what the state pictures rest on:
# they are six documents, not six copies of one.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a button answering to every state, five properties to a column, with the browser chrome the sheet resets, painted and compared against six goldens with the whole record-and-fail lifecycle over them"

run {
  args: ["test", "//lib/button", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/button/test/__snapshots__/button-resting.diff.png"  exists: false }

# A snapshot nobody has recorded yet says how to record one.
edit {
  file: "lib/button/test/states.buri"
  replace: "snapshot(ctx, \"button-resting\""
  with: "snapshot(ctx, \"never-recorded\""
}

run {
  args: ["test", "//lib/button", "--force"]
  exit: 1
  golden: "missing.txt"
}

path { path: "lib/button/test/__snapshots__/never-recorded.png"  exists: false }

run {
  args: ["test", "//lib/button", "--update", "--force"]
  exit: 0
  golden: "recorded.txt"
}

path { path: "lib/button/test/__snapshots__/never-recorded.png"  exists: true }

run {
  args: ["test", "//lib/button", "--force"]
  exit: 0
  golden: "again.txt"
}

# One number in the hover palette, and only the hover picture moves.
edit {
  file: "lib/button/scenes.buri"
  replace: ".Background(.Rgb(214, 44, 44))"
  with: ".Background(.Rgb(214, 44, 84))"
}

run {
  args: ["test", "//lib/button", "--force"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/button/test/__snapshots__/button-hover.diff.png"  exists: true }
path { path: "lib/button/test/__snapshots__/button-focus.diff.png"  exists: false }
