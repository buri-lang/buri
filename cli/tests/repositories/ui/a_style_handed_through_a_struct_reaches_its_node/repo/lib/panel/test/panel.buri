from "core/testing/assert" import * as assert;
from "platform/effect" import { Ui };
from "platform/effect/testing" import { headless, render, stylesheet };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Style };
from "//lib/panel" import { box, BoxProps, plain };

/// What a box written in this module is given.
struct CardProps<C> {
    children: [Node<C>],
    styles: Option<[Style]>,
}

/// A box written in this module, given whatever styles it is handed.
fn card<C>(props: CardProps<C>): Node<C> {
    ui.stack({
        styles: [.Group(props.styles.withDefault([]))],
        children: props.children,
    })
}

test "a style handed through a struct built in another module reaches its node" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(
        ctx,
        box(BoxProps {
            children: [ui.text({ content: .Const("Some words") })],
            styles: .Some([.MinWidth(.Px(288))]),
        }),
    );
    assert.equal(page.markup(), "e 0 class:bg-c8c8ff minw-288\nt 1 Some words");
    assert.isTrue(stylesheet().contains(".minw-288{min-width:288px}"));
}

test "a style handed through a struct built in its own module reaches its node" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(
        ctx,
        card(CardProps { children: [], styles: .Some([.MinWidth(.Px(287))]) }),
    );
    assert.equal(page.markup(), "e 0 class:minw-287");
    assert.isTrue(stylesheet().contains(".minw-287{min-width:287px}"));
}

test "a style list handed straight to another module's node reaches it" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, plain([], [.MinWidth(.Px(286))]));
    assert.equal(page.markup(), "e 0 class:bg-c8c8ff minw-286");
    assert.isTrue(stylesheet().contains(".minw-286{min-width:286px}"));
}
