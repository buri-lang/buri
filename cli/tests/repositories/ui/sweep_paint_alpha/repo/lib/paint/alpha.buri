//! What `Color.alpha` is worth in pixels: every colour slot `ui/style` has, at
//! five fractions, written out and as a design token.
//!
//! The two pages are the same grid twice. A colour written out fades to a plain
//! `rgba` the compiler works out; a token cannot be blended until a theme says
//! what it is worth, so it stays a token inside a `color-mix`. The point of the
//! second page is that the two look alike wherever a theme binds the token to
//! the first page's colour — and that everything about the fade still follows
//! the theme when it does not.
//!
//! Every cell's styles are a literal, so every one of them is a class in the
//! stylesheet rather than an inline declaration.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Color, Shadow, Style, token };
from "ui/theme" import { Theme, themed };

/// This package's vocabulary: one token, faded five ways.
export enum Token {
    /// The one colour every slot on the token page is painted in.
    Ring,
}

impl Token {
    /// The custom property this token is, which is what a style holds.
    export fn color(self): Color {
        match (self) {
            .Ring => token("swept", "ring"),
        }
    }
}

/// This package's tokens, resolved by `mapping`.
export fn themedBy(mapping: fn(Token) => Color): Theme {
    themed([(Token.Ring.color(), mapping(.Ring))])
}

/// The colour the literal page is painted in, faded.
fn written(a: Float): Color {
    Color.Rgb(200, 40, 40).alpha(a)
}

/// The same colour as a token, faded.
fn ring(a: Float): Color {
    Token.Ring.color().alpha(a)
}

/// A shadow that is a ring, so a colour is a band around the box rather than a
/// smudge under it.
fn cast(colour: Color): Shadow {
    Shadow { x: .Px(0), y: .Px(0), blur: .Px(0), spread: .Px(6), color: colour }
}

/// A colour written out, faded, in each of the four slots that take one.
export fn literalPage<C>(): Node<C> {
    page([
        ui.text(.Const("written out")),
        header(),
        band("Background", [
            subject([.Background(written(0.0))]),
            subject([.Background(written(0.2))]),
            subject([.Background(written(0.5))]),
            subject([.Background(written(0.8))]),
            subject([.Background(written(1.0))]),
        ]),
        band("Foreground", [
            subject([.FontWeight(.Bold), .Foreground(written(0.0))]),
            subject([.FontWeight(.Bold), .Foreground(written(0.2))]),
            subject([.FontWeight(.Bold), .Foreground(written(0.5))]),
            subject([.FontWeight(.Bold), .Foreground(written(0.8))]),
            subject([.FontWeight(.Bold), .Foreground(written(1.0))]),
        ]),
        band("BorderColor", [
            subject([.BorderWidth(.Px(6)), .BorderColor(written(0.0))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(written(0.2))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(written(0.5))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(written(0.8))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(written(1.0))]),
        ]),
        band("Shadow's colour", [
            subject([.Shadow(cast(written(0.0)))]),
            subject([.Shadow(cast(written(0.2)))]),
            subject([.Shadow(cast(written(0.5)))]),
            subject([.Shadow(cast(written(0.8)))]),
            subject([.Shadow(cast(written(1.0)))]),
        ]),
    ])
}

/// The same grid with a token in place of the colour. What a theme binds the
/// token to is the only difference between this page's four goldens.
export fn tokenPage<C>(): Node<C> {
    page([
        ui.text(.Const("a design token")),
        header(),
        band("Background", [
            subject([.Background(ring(0.0))]),
            subject([.Background(ring(0.2))]),
            subject([.Background(ring(0.5))]),
            subject([.Background(ring(0.8))]),
            subject([.Background(ring(1.0))]),
        ]),
        band("Foreground", [
            subject([.FontWeight(.Bold), .Foreground(ring(0.0))]),
            subject([.FontWeight(.Bold), .Foreground(ring(0.2))]),
            subject([.FontWeight(.Bold), .Foreground(ring(0.5))]),
            subject([.FontWeight(.Bold), .Foreground(ring(0.8))]),
            subject([.FontWeight(.Bold), .Foreground(ring(1.0))]),
        ]),
        band("BorderColor", [
            subject([.BorderWidth(.Px(6)), .BorderColor(ring(0.0))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(ring(0.2))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(ring(0.5))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(ring(0.8))]),
            subject([.BorderWidth(.Px(6)), .BorderColor(ring(1.0))]),
        ]),
        band("Shadow's colour", [
            subject([.Shadow(cast(ring(0.0)))]),
            subject([.Shadow(cast(ring(0.2)))]),
            subject([.Shadow(cast(ring(0.5)))]),
            subject([.Shadow(cast(ring(0.8)))]),
            subject([.Shadow(cast(ring(1.0)))]),
        ]),
    ])
}

/// One picture: the title, the fractions named once, and a band per slot.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column(
        [
            .Gap(.Px(6)),
            .Padding(.Px(14)),
            .Background(.Rgb(255, 255, 255)),
            .Foreground(.Rgb(20, 20, 20)),
            .FontSize(.Px(12)),
        ],
        rows,
    )
}

/// The fractions, named once at the top rather than under every band.
fn header<C>(): Node<C> {
    ui.row([.Gap(.Px(14)), .PaddingEdge(.Start, .Px(96))], [
        label("0.0"),
        label("0.2"),
        label("0.5"),
        label("0.8"),
        label("1.0"),
    ])
}

fn label<C>(text: Str): Node<C> {
    ui.stack([.Width(.Px(82))], [ui.text(.Const(text))])
}

/// One slot's band: its name in a fixed track, its cells in the rest.
fn band<C>(name: Str, cells: [Node<C>]): Node<C> {
    ui.row([.Gap(.Px(14)), .AlignCross(.Center), .Height(.Px(100))], [
        ui.stack([.Width(.Px(82))], [ui.text(.Const(name))]),
        ui.row([.Gap(.Px(14)), .AlignCross(.Center)], cells),
    ])
}

/// The subject every cell holds: one box of text, on a ground pale enough that
/// a fifth of a colour is still visible on it.
fn subject<C>(styles: [Style]): Node<C> {
    ui.stack(
        [
            .Width(.Px(82)),
            .Padding(.Px(8)),
            .Radius(.Px(4)),
            .Background(.Rgb(246, 246, 248)),
            .Foreground(.Rgb(24, 24, 27)),
            .Group(styles),
        ],
        [ui.text(.Const("Ada"))],
    )
}
