// `State.FocusWithin` — the container's state rather than the element's.
//
// The shape is an input group: the wrapper owns the hairline, the ring and the
// rounding, and the control inside it is bare. `Focus` is `:focus-visible` on
// the element itself, and a container is never that, so the two are painted
// side by side on every page here.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { Signal };
from "ui/style" import { Shadow, Style };

/// The page every picture is drawn on.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column([.PaddingY(.Px(8)), .Gap(.Px(12)), .FontSize(.Px(13))], rows)
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.column([.Gap(.Px(2))], [
        ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
            ui.text(.Const(label)),
        ]),
        demo,
    ])
}

/// The ring: a spread with no blur, which is a halo around the box rather than
/// a slab behind it.
fn ring(): Shadow {
    Shadow {
        x: .Px(0),
        y: .Px(0),
        blur: .Px(0),
        spread: .Px(3),
        color: .Rgba(64, 110, 220, 0.5),
    }
}

/// The wrapper's own styles: the box, and what it does while something inside
/// it has the keyboard.
fn wrapper(): [Style] {
    [
        .Layout(.Row),
        .AlignCross(.Center),
        .Gap(.Px(6)),
        .PaddingX(.Px(10)),
        .Height(.Px(36)),
        .Width(.Px(340)),
        .Radius(.Px(8)),
        .BorderWidth(.Px(1)),
        .BorderColor(.Rgb(200, 200, 210)),
        .Background(.Rgb(255, 255, 255)),
        .On(.FocusWithin, [.BorderColor(.Rgb(64, 110, 220)), .Shadow(ring())]),
    ]
}

/// A fixed run of text, for a prefix and a suffix.
fn affix<C>(text: Str): Node<C> {
    ui.stack([.Shrink(0), .Foreground(.Rgb(120, 120, 132))], [ui.text(.Const(text))])
}

/// The group: a prefix, a bare field and a suffix, reading as one control.
fn group<C>(site: Signal<Str>): Node<C> {
    ui.stack(wrapper(), [
        affix("https://"),
        ui.field(
            .Const("Site"),
            .Text,
            [],
            [.Grow(1)],
            site,
            .Const(false),
            .Const(false),
        ),
        affix(".com"),
    ])
}

/// The same box with the ring written on `Focus` instead — the state an element
/// has of its own. A container is never focus-visible, so a browser never fires
/// this one on the wrapper; the painter puts a whole document into a state, so
/// what this row says is which class the document carried.
fn onFocus<C>(site: Signal<Str>): Node<C> {
    ui.stack(
        [
            .Layout(.Row),
            .AlignCross(.Center),
            .Gap(.Px(6)),
            .PaddingX(.Px(10)),
            .Height(.Px(36)),
            .Width(.Px(340)),
            .Radius(.Px(8)),
            .BorderWidth(.Px(1)),
            .BorderColor(.Rgb(200, 200, 210)),
            .Background(.Rgb(255, 255, 255)),
            .On(.Focus, [.BorderColor(.Rgb(210, 80, 40)), .Shadow(ring())]),
        ],
        [
            affix("https://"),
            ui.field(
                .Const("Site"),
                .Text,
                [],
                [.Grow(1)],
                site,
                .Const(false),
                .Const(false),
            ),
            affix(".com"),
        ],
    )
}

/// A plain card that rings the same way, to say the state is not a control's:
/// any container can be the thing the keyboard is inside.
fn card<C>(site: Signal<Str>): Node<C> {
    ui.stack(
        [
            .Padding(.Px(10)),
            .Gap(.Px(8)),
            .Width(.Px(340)),
            .Radius(.Px(8)),
            .Background(.Rgb(244, 244, 248)),
            .On(.Hover, [.Background(.Rgb(250, 242, 224))]),
            .On(.FocusWithin, [.Background(.Rgb(228, 236, 252)), .Shadow(ring())]),
        ],
        [
            ui.stack([], [ui.text(.Const("Where does it live?"))]),
            ui.field(.Const("Site"), .Text, [], [], site, .Const(false), .Const(false)),
        ],
    )
}

/// The three rows every picture holds, so the same tree is painted in each
/// state and the difference between the pictures is the state alone.
export fn rows<C>(site: Signal<Str>): Node<C> {
    page([
        ui.text(.Const("an input group, a group ringed on Focus, and a card")),
        band("On(.FocusWithin, ...) on the wrapper", group(site)),
        band("On(.Focus, ...) on the same wrapper", onFocus(site)),
        band("On(.FocusWithin, ...) on a card around a field", card(site)),
    ])
}

/// The same three with no `On` group at all, which is what a resting picture
/// is: `State` has no resting variant, so `snapshot` cannot ask for one.
export fn resting<C>(site: Signal<Str>): Node<C> {
    page([
        ui.text(.Const("an input group, a group ringed on Focus, and a card")),
        band("On(.FocusWithin, ...) on the wrapper", bare(site)),
        band("On(.Focus, ...) on the same wrapper", bare(site)),
        band("On(.FocusWithin, ...) on a card around a field", bareCard(site)),
    ])
}

/// The wrapper with nothing to answer with.
fn bare<C>(site: Signal<Str>): Node<C> {
    ui.stack(
        [
            .Layout(.Row),
            .AlignCross(.Center),
            .Gap(.Px(6)),
            .PaddingX(.Px(10)),
            .Height(.Px(36)),
            .Width(.Px(340)),
            .Radius(.Px(8)),
            .BorderWidth(.Px(1)),
            .BorderColor(.Rgb(200, 200, 210)),
            .Background(.Rgb(255, 255, 255)),
        ],
        [
            affix("https://"),
            ui.field(
                .Const("Site"),
                .Text,
                [],
                [.Grow(1)],
                site,
                .Const(false),
                .Const(false),
            ),
            affix(".com"),
        ],
    )
}

/// The card with nothing to answer with.
fn bareCard<C>(site: Signal<Str>): Node<C> {
    ui.stack(
        [
            .Padding(.Px(10)),
            .Gap(.Px(8)),
            .Width(.Px(340)),
            .Radius(.Px(8)),
            .Background(.Rgb(244, 244, 248)),
        ],
        [
            ui.stack([], [ui.text(.Const("Where does it live?"))]),
            ui.field(.Const("Site"), .Text, [], [], site, .Const(false), .Const(false)),
        ],
    )
}
