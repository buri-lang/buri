test "on" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let scene = ui.describe(ctx, responsive(ctx), .Checked);
    assert.containsText(scene, "checked_bg-");
    assert.containsText(scene, "checked_fg-");
    assert.containsText(scene, "checked_bw-");
    assert.containsText(scene, "checked_bc-");
    assert.containsText(scene, "checked_op-");
    assert.containsText(scene, "checked_sh-");
    assert.isFalse(scene.contains("hover_"));
    assert.isFalse(scene.contains("focus_"));
    assert.isFalse(scene.contains("active_"));
    assert.isFalse(scene.contains("disabled_"));
    snapshot(ctx, "toggle-checked", responsive(ctx), .Checked, []);
}
