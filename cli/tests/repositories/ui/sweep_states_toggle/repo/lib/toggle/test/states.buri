// Toggle, in every state — six pictures of one tree, and the classes behind each.
//
// The `describe` assertion beside every picture is what says a state golden is
// no copy of the resting one: the hovered document carries the `hover_`
// classes and none of the other four states', and the resting document
// carries no state class at all.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/testing" import { headless, snapshot };
from "//lib/toggle" import { responsive, resting };

test "at rest" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let scene = ui.describe(ctx, resting(ctx), .Hover);
    assert.isFalse(scene.contains("hover_"));
    assert.isFalse(scene.contains("focus_"));
    assert.isFalse(scene.contains("active_"));
    assert.isFalse(scene.contains("disabled_"));
    assert.isFalse(scene.contains("checked_"));
    snapshot(ctx, "toggle-resting", resting(ctx), .Hover, []);
}

test "hovered" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let scene = ui.describe(ctx, responsive(ctx), .Hover);
    assert.containsText(scene, "hover_bg-");
    assert.containsText(scene, "hover_fg-");
    assert.containsText(scene, "hover_bw-");
    assert.containsText(scene, "hover_bc-");
    assert.containsText(scene, "hover_op-");
    assert.containsText(scene, "hover_sh-");
    assert.isFalse(scene.contains("focus_"));
    assert.isFalse(scene.contains("active_"));
    assert.isFalse(scene.contains("disabled_"));
    assert.isFalse(scene.contains("checked_"));
    snapshot(ctx, "toggle-hover", responsive(ctx), .Hover, []);
}

