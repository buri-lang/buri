from "core/testing/assert" import * as assert;
from "platform/effect" import { Ui };
from "platform/effect/testing" import { headless, render, stylesheet };
from "//lib/sheet" import { spaced };

test "a second program's style handed four calls deep is a class of its node" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(ctx, spaced([.MinWidth(.Px(23))]));
    assert.equal(page.markup(), "e 0 class:minw-23 gap-5 h-3 p-2");
    assert.isTrue(stylesheet().contains(".minw-23{min-width:23px}"));
}
