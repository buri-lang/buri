from "core/testing/assert" import * as assert;
from "platform/effect" import { Ui };
from "platform/effect/testing" import { headless, render, stylesheet };
from "//lib/shell" import { Look, outer, plain };

test "a style handed three calls deep is a class of its node" {
    let ctx = context {
        Ui: headless(),
    };
    let page = render(
        ctx,
        outer(Look { children: [plain()], styles: [.Width(.Px(17))] }),
    );
    assert.equal(page.markup(), "e 0 class:w-17 h-3 p-2\ne 1 class:w-9");
    assert.isTrue(stylesheet().contains(".w-17{width:17px}"));
}
