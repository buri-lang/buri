from "ui/node" import * as ui;
from "ui/node" import { Node };

/// The page every picture is drawn on: eight hundred wide with nothing inset
/// either side, so a boundary in a picture is a number off the viewport's own
/// edge.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.PaddingY(.Px(6)), .Gap(.Px(8)), .FontSize(.Px(13))])], children: rows })
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.Gap(.Px(2))])], children: [
        ui.stack({ styles: [.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], children: [
            ui.text({ content: .Const(label) }),
        ] }),
        demo,
    ] })
}

/// How narrow a run can be *made* is not how wide it wants to be. A
/// sentence breaks at its spaces; a word that will not fit is not split, so
/// its own width is the floor. Two even tracks stay even under both, and
/// two automatic ones do not.
export fn wrapping<C>(): Node<C> {
    page([
        band(
            "a sentence in a hundred and eighty",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180))], children: [
                ui.text({ content: .Const(
                        "A sentence long enough that it has to break somewhere, twice over.",
                    ) }),
            ] }),
        ),
        band(
            "one long word in a hundred and eighty",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180))], children: [
                ui.text({ content: .Const("Donaudampfschiffahrtsgesellschaftskapitaenswitwe") }),
            ] }),
        ),
        band(
            "Fraction(1), Fraction(1) — a sentence beside the long word",
            ui.stack({ styles: [.Layout(.Grid([.Fraction(1), .Fraction(1)])), .Gap(.Px(8))], children: [
                ui.stack({ styles: [.Background(.Rgb(232, 232, 238))], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
                ui.stack({ styles: [.Background(.Rgb(230, 160, 20))], children: [
                    ui.text({ content: .Const("Donaudampfschiffahrtsgesellschaftskapitaenswitwe") }),
                ] }),
            ] }),
        ),
        band(
            "Auto, Auto — the same two",
            ui.stack({ styles: [.Layout(.Grid([.Auto, .Auto])), .Gap(.Px(8))], children: [
                ui.stack({ styles: [.Background(.Rgb(232, 232, 238))], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
                ui.stack({ styles: [.Background(.Rgb(230, 160, 20))], children: [
                    ui.text({ content: .Const("Donaudampfschiffahrtsgesellschaftskapitaenswitwe") }),
                ] }),
            ] }),
        ),
    ])
}

/// Every `Align`, as `TextAlign` on a paragraph three hundred wide. The
/// three distributions and `Stretch` all mean justified, because a line of
/// text has no leftover room to hand out any other way.
export fn textAlign<C>(): Node<C> {
    page([
        band(
            "TextAlign(.Start)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.Start),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextAlign(.Center)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.Center),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextAlign(.End)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(300)), .TextAlign(.End)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextAlign(.Stretch)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.Stretch),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextAlign(.SpaceBetween)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.SpaceBetween),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextAlign(.SpaceAround)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.SpaceAround),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextAlign(.SpaceEvenly)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.SpaceEvenly),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
    ])
}

/// `LineHeight` as a multiple of the text size, over the same two lines.
/// Nothing set is `normal`, which is 1.2.
export fn lineHeight<C>(): Node<C> {
    page([
        band(
            "no LineHeight at all",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180))], children: [
                ui.text({ content: .Const(
                        "A sentence long enough that it has to break somewhere, twice over.",
                    ) }),
            ] }),
        ),
        band(
            "LineHeight(1.0)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .LineHeight(1.0)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "LineHeight(1.5)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .LineHeight(1.5)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "LineHeight(2.5)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .LineHeight(2.5)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
    ])
}

/// `Truncate` says show at most this many lines and end the last one with
/// an ellipsis; zero means no limit. Four lines of text in a box a hundred
/// and eighty wide, asked for one, two and three of them.
///
/// The last band is the negative twin: a run that already fits in two lines,
/// asked for two, keeps its own last word. An ellipsis on that one would say
/// the painter appends one whether or not it cut anything.
export fn truncate<C>(): Node<C> {
    page([
        band(
            "Truncate(0)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(0)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "Truncate(1)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(1)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "Truncate(2)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(2)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "Truncate(3)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(3)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "Truncate(2) on a run that already fits",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(2)], children: [ui.text({ content: .Const("A sentence that breaks once, and no more.") })] }),
        ),
    ])
}

/// Every `TextWrap`. `NoWrap` never breaks, so the line runs out of the
/// box; `Balance` breaks where `Wrap` does but evens the lines out.
export fn textWrap<C>(): Node<C> {
    page([
        band(
            "TextWrap(.Wrap)",
            ui.stack({ styles: [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .TextWrap(.Wrap)], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextWrap(.NoWrap)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(180)),
                    .TextWrap(.NoWrap),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
        band(
            "TextWrap(.Balance)",
            ui.stack({ styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(180)),
                    .TextWrap(.Balance),
                ], children: [
                    ui.text({ content: .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ) }),
                ] }),
        ),
    ])
}
