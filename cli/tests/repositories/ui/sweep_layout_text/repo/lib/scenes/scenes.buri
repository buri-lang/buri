from "ui/node" import * as ui;
from "ui/node" import { Node };

/// The page every picture is drawn on: eight hundred wide with nothing inset
/// either side, so a boundary in a picture is a number off the viewport's own
/// edge.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column([.PaddingY(.Px(6)), .Gap(.Px(8)), .FontSize(.Px(13))], rows)
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.column([.Gap(.Px(2))], [
        ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
            ui.text(.Const(label)),
        ]),
        demo,
    ])
}

/// How narrow a run can be *made* is not how wide it wants to be. A
/// sentence breaks at its spaces; a word that will not fit is not split, so
/// its own width is the floor. Two even tracks stay even under both, and
/// two automatic ones do not.
export fn wrapping<C>(): Node<C> {
    page([
        band(
            "a sentence in a hundred and eighty",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Width(.Px(180))], [
                ui.text(
                    .Const(
                        "A sentence long enough that it has to break somewhere, twice over.",
                    ),
                ),
            ]),
        ),
        band(
            "one long word in a hundred and eighty",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Width(.Px(180))], [
                ui.text(.Const("Donaudampfschiffahrtsgesellschaftskapitaenswitwe")),
            ]),
        ),
        band(
            "Fraction(1), Fraction(1) — a sentence beside the long word",
            ui.stack([.Layout(.Grid([.Fraction(1), .Fraction(1)])), .Gap(.Px(8))], [
                ui.stack([.Background(.Rgb(232, 232, 238))], [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ]),
                ui.stack([.Background(.Rgb(230, 160, 20))], [
                    ui.text(.Const("Donaudampfschiffahrtsgesellschaftskapitaenswitwe")),
                ]),
            ]),
        ),
        band(
            "Auto, Auto — the same two",
            ui.stack([.Layout(.Grid([.Auto, .Auto])), .Gap(.Px(8))], [
                ui.stack([.Background(.Rgb(232, 232, 238))], [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ]),
                ui.stack([.Background(.Rgb(230, 160, 20))], [
                    ui.text(.Const("Donaudampfschiffahrtsgesellschaftskapitaenswitwe")),
                ]),
            ]),
        ),
    ])
}

/// Every `Align`, as `TextAlign` on a paragraph three hundred wide. The
/// three distributions and `Stretch` all mean justified, because a line of
/// text has no leftover room to hand out any other way.
export fn textAlign<C>(): Node<C> {
    page([
        band(
            "TextAlign(.Start)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.Start),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextAlign(.Center)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.Center),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextAlign(.End)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(300)), .TextAlign(.End)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextAlign(.Stretch)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.Stretch),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextAlign(.SpaceBetween)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.SpaceBetween),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextAlign(.SpaceAround)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.SpaceAround),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextAlign(.SpaceEvenly)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(300)),
                    .TextAlign(.SpaceEvenly),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
    ])
}

/// `LineHeight` as a multiple of the text size, over the same two lines.
/// Nothing set is `normal`, which is 1.2.
export fn lineHeight<C>(): Node<C> {
    page([
        band(
            "no LineHeight at all",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Width(.Px(180))], [
                ui.text(
                    .Const(
                        "A sentence long enough that it has to break somewhere, twice over.",
                    ),
                ),
            ]),
        ),
        band(
            "LineHeight(1.0)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .LineHeight(1.0)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "LineHeight(1.5)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .LineHeight(1.5)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "LineHeight(2.5)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .LineHeight(2.5)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
    ])
}

/// `Truncate` says show at most this many lines and end the last one with
/// an ellipsis; zero means no limit. Four lines of text in a box a hundred
/// and eighty wide, asked for one, two and three of them.
export fn truncate<C>(): Node<C> {
    page([
        band(
            "Truncate(0)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(0)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "Truncate(1)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(1)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "Truncate(2)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(2)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "Truncate(3)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .Truncate(3)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over. A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
    ])
}

/// Every `TextWrap`. `NoWrap` never breaks, so the line runs out of the
/// box; `Balance` breaks where `Wrap` does but evens the lines out.
export fn textWrap<C>(): Node<C> {
    page([
        band(
            "TextWrap(.Wrap)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Width(.Px(180)), .TextWrap(.Wrap)],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextWrap(.NoWrap)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(180)),
                    .TextWrap(.NoWrap),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
        band(
            "TextWrap(.Balance)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Width(.Px(180)),
                    .TextWrap(.Balance),
                ],
                [
                    ui.text(
                        .Const(
                            "A sentence long enough that it has to break somewhere, twice over.",
                        ),
                    ),
                ],
            ),
        ),
    ])
}
