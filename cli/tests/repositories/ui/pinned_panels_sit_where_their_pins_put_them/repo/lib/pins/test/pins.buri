// Each scene beside its twin: both tests of a pair compare against one
// golden, so a panel the pins place anywhere else fails its scene.

from "platform/effect" import { Allocator, Ui, Watch };
from "platform/effect/testing" import { alloc, headless, observer, snapshot };
from "//lib/pins" import { anchored, computed, late, pinned, tip, tipTwin };

test "a pinned panel hangs below its anchor from the start edge" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "below",
        anchored([
            .Pin(.Top, .Px(32)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
        ]),
        .Checked,
        [],
    );
}

test "the box pinned the plain way where the panel below goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "below",
        pinned([
            .Pin(.Top, .Px(32)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
        ]),
        .Checked,
        [],
    );
}

test "a pinned panel hangs below its anchor from the end edge" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "below-end",
        anchored([
            .Pin(.Top, .Percent(100.0)),
