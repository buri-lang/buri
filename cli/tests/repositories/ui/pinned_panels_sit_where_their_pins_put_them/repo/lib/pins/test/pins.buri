test "a tooltip's bubble hangs below its trigger from the start edge" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "tooltip", tip([.Width(.Px(160)), .Height(.Px(80))]), .Hover, []);
}

test "the box pinned the plain way where the bubble goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "tooltip",
        tipTwin([
            .Pin(.Top, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
        ]),
        .Hover,
        [],
    );
}

test "a tooltip's bubble a pin moves hangs where the pin puts it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "tooltip-moved",
        tip([.Pin(.Top, .Px(40)), .Width(.Px(160)), .Height(.Px(80))]),
        .Hover,
        [],
    );
}

test "the box pinned the plain way where the moved bubble goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "tooltip-moved",
        tipTwin([
            .Pin(.Top, .Px(40)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
        ]),
        .Hover,
        [],
    );
}
