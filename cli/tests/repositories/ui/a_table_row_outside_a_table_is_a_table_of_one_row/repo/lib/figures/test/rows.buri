// A table row with no table, which is a table of one row. Nothing in this file
// names `.Table`.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "ui/node" import * as ui;

test "a table row outside a table" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "lone-row",
        ui.stack({
            role: .Some(.TableRow),
            styles: [.TextWrap(.NoWrap)],
            children: [
                ui.stack({
                    role: .Some(.Cell),
                    styles: [],
                    children: [
                        ui.text({ content: .Const("$550k") }),
                        ui.text({ content: .Const("$600k") }),
                    ],
                }),
                ui.stack({
                    styles: [],
                    children: [ui.text({ content: .Const("Total") })],
                }),
            ],
        }),
        .Hover,
        [],
    );
}
