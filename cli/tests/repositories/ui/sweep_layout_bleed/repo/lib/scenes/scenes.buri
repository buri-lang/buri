/// The same bleed on every primitive that takes a `[Style]`, out of a ground
/// padded by twelve.
///
/// A field's and a toggle's styles are the input's, so what leaves the padding
/// there is the control and not the label around it. An image takes no styles
/// of its own, so its bleed goes where a style for one goes anyway: on the box
/// around it.
export fn bleedPrimitives<C: Ui>(ctx: C): Node<C> {
    let typed = signal(ctx, "ada");
    let ticked = signal(ctx, true);
    page([
        band(
            "stack",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.stack(
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    [ui.text(.Const("stack"))],
                ),
            ]),
        ),
        band(
            "heading",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.heading(
                    2,
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    .Const("heading"),
                ),
            ]),
        ),
        band(
            "button",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.button(
                    .Const("button"),
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    [],
                    fn(_c, _e) => (),
                ),
            ]),
        ),
        band(
            "link",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.link(
                    .Const("/there"),
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    [ui.text(.Const("link"))],
                ),
            ]),
        ),
        band(
            "region",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.region(
                    .ListItem,
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    [ui.text(.Const("region"))],
                ),
            ]),
        ),
        band(
            "image",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.stack(
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                        .Height(.Px(24)),
                    ],
                    [ui.image(.Const("/absent.png"), .Const("absent"))],
                ),
            ]),
        ),
        band(
            "field",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.field(
                    .Const("field"),
                    .Text,
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    [],
                    typed,
                ),
            ]),
        ),
        band(
            "toggle",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Padding(.Px(12))], [
                ui.toggle(
                    .Const("toggle"),
                    .Checkbox,
                    [
                        .Background(.Rgb(40, 40, 200)),
                        .Foreground(.Rgb(255, 255, 255)),
                        .Padding(.Px(4)),
                        .Bleed(.Start, .Px(12)),
                    ],
                    [],
                    ticked,
                ),
            ]),
        ),
    ])
}
