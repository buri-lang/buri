// `Translate(Length, Length)`.
//
// Every box on these pages sits in a slot the layout gave it, drawn as an
// outline. A translate moves the box and leaves the slot — and its neighbours —
// exactly where they were, which is the whole reason a press is written this
// way rather than as a padding that reflows the row.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Length, Style };

/// The page every picture is drawn on.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column([.PaddingY(.Px(8)), .Gap(.Px(12)), .FontSize(.Px(13))], rows)
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.column([.Gap(.Px(2))], [
        ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
            ui.text(.Const(label)),
        ]),
        demo,
    ])
}

/// A dashed outline the size of the box inside it, so a shift reads against the
/// room the layout actually gave it.
fn slot<C>(inner: Node<C>): Node<C> {
    ui.stack(
        [
            .Width(.Px(80)),
            .Height(.Px(40)),
            .BorderWidth(.Px(1)),
            .BorderStyle(.Dashed),
            .BorderColor(.Rgb(170, 170, 180)),
        ],
        [inner],
    )
}

/// The box that moves: filled, filling its slot, at a 16px text size so an em
/// is sixteen pixels.
fn moved<C>(extra: [Style]): Node<C> {
    ui.stack(
        [
            .Width(.Full),
            .Height(.Full),
            .FontSize(.Px(16)),
            .Background(.Rgb(150, 170, 200)),
            .Group(extra),
        ],
        [],
    )
}

/// One slot, with the box inside it shifted by `x` and `y`.
fn shifted<C>(x: Length, y: Length): Node<C> {
    slot(moved([.Translate(x, y)]))
}

/// Every unit a translate takes, one to a slot, with the slot it left behind
/// still drawn. The last two are the degenerate ones — `Auto` is not a distance
/// and moves nothing, and `Full` is the box's own size along each axis.
export fn units<C>(): Node<C> {
    page([
        ui.text(
            .Const(
                "Translate, one value to a slot; the dashes are where the layout put it",
            ),
        ),
        band(
            "none, Px(12) across, Px(12) down, Px(-12)/Px(-12)",
            ui.stack([.Layout(.Row), .Gap(.Px(24)), .Padding(.Px(16))], [
                slot(moved([])),
                shifted(.Px(12), .Px(0)),
                shifted(.Px(0), .Px(12)),
                shifted(.Px(-12), .Px(-12)),
            ]),
        ),
        band(
            "Rem(1) across, Em(1) across at 16px, Percent(50) across, Percent(-25) down",
            ui.stack([.Layout(.Row), .Gap(.Px(24)), .Padding(.Px(16))], [
                shifted(.Rem(1.0), .Px(0)),
                shifted(.Em(1.0), .Px(0)),
                shifted(.Percent(50.0), .Px(0)),
                shifted(.Px(0), .Percent(-25.0)),
            ]),
        ),
        band(
            "Auto/Auto — not a distance, so nothing moves — then Full across",
            ui.stack([.Layout(.Row), .Gap(.Px(24)), .Padding(.Px(16))], [
                shifted(.Auto, .Auto),
                shifted(.Full, .Px(0)),
            ]),
        ),
    ])
}

/// Four boxes in a row, the middle one shifted. Nothing beside it moves, which
/// is the difference between a translate and a padding.
export fn neighbours<C>(): Node<C> {
    page([
        ui.text(.Const("one of four moved, and the other three where they were")),
        band(
            "the second shifted eight down and eight across",
            ui.stack([.Layout(.Row), .Gap(.Px(12)), .Padding(.Px(16))], [
                slot(moved([])),
                slot(moved([.Translate(.Px(8), .Px(8))])),
                slot(moved([])),
                slot(moved([])),
            ]),
        ),
        band(
            "and the same row with the second padded instead — the row reflows",
            ui.stack([.Layout(.Row), .Gap(.Px(12)), .Padding(.Px(16))], [
                slot(moved([])),
                ui.stack([.PaddingEdge(.Start, .Px(8)), .PaddingEdge(.Top, .Px(8))], [
                    slot(moved([])),
                ]),
                slot(moved([])),
                slot(moved([])),
            ]),
        ),
        band(
            "a shifted box carries its children with it",
            ui.stack([.Layout(.Row), .Gap(.Px(12)), .Padding(.Px(16))], [
                slot(
                    ui.stack(
                        [
                            .Width(.Full),
                            .Height(.Full),
                            .Padding(.Px(6)),
                            .Background(.Rgb(150, 170, 200)),
                            .Foreground(.Rgb(255, 255, 255)),
                            .Translate(.Px(16), .Px(10)),
                        ],
                        [ui.text(.Const("both"))],
                    ),
                ),
            ]),
        ),
    ])
}

/// What the issue is about: a button that sinks a pixel under the press, and
/// the row around it holding still. Painted at rest and under `.Active`, so the
/// pair is the record.
export fn press<C>(): Node<C> {
    page([
        ui.text(.Const("active:translate-y-px, the press every design system writes")),
        band(
            "three buttons, all of them under one `On(.Active, ...)`",
            ui.stack([.Layout(.Row), .Gap(.Px(10)), .Padding(.Px(16))], [
                sinking("Save"),
                sinking("Cancel"),
                sinking("Delete"),
            ]),
        ),
        band(
            "a rule under them, so the shift is a pixel off something",
            ui.stack(
                [.Height(.Px(2)), .Width(.Px(300)), .Background(.Rgb(200, 200, 210))],
                [],
            ),
        ),
    ])
}

/// One button that sinks a pixel while it is held.
fn sinking<C>(label: Str): Node<C> {
    ui.button(
        .Const(label),
        [
            .PaddingX(.Px(14)),
            .PaddingY(.Px(8)),
            .Radius(.Px(8)),
            .Background(.Rgb(24, 24, 27)),
            .Foreground(.Rgb(255, 255, 255)),
            .On(.Active, [.Translate(.Px(0), .Px(1))]),
        ],
        [],
        fn(_c, _e) => (),
        .Const(false),
    )
}
