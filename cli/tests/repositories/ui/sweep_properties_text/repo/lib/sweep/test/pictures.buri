// One picture per family of `ui/style` properties, over a run of `text`,
// styled by the stack around it — `ui.text` takes no styles of its own, so the
// container is where a property goes.
//
// Resting state throughout: no style here is inside an `On`, so the
// state a snapshot is taken in contributes nothing to any of them.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/sweep" import {
    gapPage, paddingPage, runsPage, sizePage, surfacePage, typePage,
};

test "the surface properties, on a text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "text-surface", surfacePage(), .Hover, []);
}

test "the type properties, on a text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "text-type", typePage(), .Hover, []);
}

test "how a run of text is set, on a text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "text-runs", runsPage(), .Hover, []);
}

test "the paddings, on a text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "text-padding", paddingPage(), .Hover, []);
}

test "the gaps, and the mark beside a child, on a text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "text-gap", gapPage(), .Hover, []);
}

test "the sizing properties, on a text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "text-size", sizePage(), .Hover, []);
}
