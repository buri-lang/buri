# A pinned panel shifts back onto the page (#365).
#
# A `PinAnchor` panel near the page's edge ran past it. Each scene shares a
# golden with a twin that pins a plain box where the panel should land: a
# `Shift` panel slid back from the end edge, from the start edge, up from the
# bottom, on both axes, centred on its anchor, and wider than the page; one
# with no `Shift` that runs past the edge; one that shifts and then flips; two
# whose pin runs past the anchor and off the page; and one whose styles are
# computed.
#
# The last step moves the shifted panel's twin back to its anchor's start
# edge, and that test fails.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a pinned panel with a Shift slides back onto the page, each scene beside a twin pinned the plain way, and a twin left unshifted fails the golden"

run {
  args: ["test", "//lib/shift", "--force"]
  exit: 0
  golden: "pass.txt"
}

edit {
  file: "lib/shift/test/shift.buri"
  replace: "pinned(40, 600, [\n            .Pin(.Top, .Percent(100.0)),\n            .Pin(.Start, .Px(-100)),\n            .Width(.Px(300)),\n            .Height(.Px(80)),\n        ]),\n        .Checked,\n        [],\n    );\n}\n\ntest \"a panel with no shift"
  with: "pinned(40, 600, [\n            .Pin(.Top, .Percent(100.0)),\n            .Pin(.Start, .Px(0)),\n            .Width(.Px(300)),\n            .Height(.Px(80)),\n        ]),\n        .Checked,\n        [],\n    );\n}\n\ntest \"a panel with no shift"
}

run {
  args: ["test", "//lib/shift", "--force"]
  exit: 1
  golden: "changed.txt"
}
