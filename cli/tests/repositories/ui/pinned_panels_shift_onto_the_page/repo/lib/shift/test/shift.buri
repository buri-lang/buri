test "a panel that shifts onto the page can still flip" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "flip-shift",
        anchored(160, 600, [
            .Pin(.Top, .Percent(100.0)),
            .Width(.Px(400)),
            .Height(.Px(80)),
            .Fallback(.FlipBlock),
            .Shift(.X),
        ]),
        .Checked,
        [],
    );
}

test "the box pinned the plain way where the panel flip-shift goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "flip-shift",
        pinned(160, 600, [
            .Pin(.Bottom, .Percent(100.0)),
            .Pin(.Start, .Px(-200)),
            .Width(.Px(400)),
            .Height(.Px(80)),
        ]),
        .Checked,
        [],
    );
}

