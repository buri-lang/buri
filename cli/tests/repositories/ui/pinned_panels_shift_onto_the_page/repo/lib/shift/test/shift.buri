// Each scene beside its twin: both tests of a pair compare against one
// golden, so a panel placed anywhere else fails its scene.

from "platform/effect" import { Allocator, Ui, Watch };
from "platform/effect/testing" import { alloc, headless, observer, snapshot };
from "//lib/shift" import { anchored, computed, pinned };

test "a panel that runs past the page's end edge shifts back onto it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "shift-x",
        anchored(40, 600, [
            .Pin(.Top, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(300)),
            .Height(.Px(80)),
            .Shift(.X),
        ]),
        .Checked,
        [],
    );
}

test "the box pinned the plain way where the panel shift-x goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "shift-x",
        pinned(40, 600, [
            .Pin(.Top, .Percent(100.0)),
            .Pin(.Start, .Px(-100)),
            .Width(.Px(300)),
            .Height(.Px(80)),
        ]),
        .Checked,
        [],
    );
}

