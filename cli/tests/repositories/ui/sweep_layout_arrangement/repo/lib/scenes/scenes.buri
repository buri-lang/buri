from "ui/node" import * as ui;
from "ui/node" import { Node };

/// The page every picture is drawn on: eight hundred wide with nothing inset
/// either side, so a boundary in a picture is a number off the viewport's own
/// edge.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column([.PaddingY(.Px(6)), .Gap(.Px(8)), .FontSize(.Px(13))], rows)
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.column([.Gap(.Px(2))], [
        ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
            ui.text(.Const(label)),
        ]),
        demo,
    ])
}

/// Every `Layout` a container can take, over one list of three blocks: down
/// the page, along it, and one over another.
export fn directions<C>(): Node<C> {
    page([
        band(
            "Layout(.Column)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(.Column),
                    .Width(.Px(320)),
                    .Height(.Px(100)),
                ],
                [
                    ui.stack(
                        [
                            .Background(.Rgb(200, 40, 40)),
                            .Width(.Px(120)),
                            .Height(.Px(44)),
                        ],
                        [],
                    ),
                    ui.stack(
                        [
                            .Background(.Rgb(40, 150, 40)),
                            .Width(.Px(80)),
                            .Height(.Px(30)),
                        ],
                        [],
                    ),
                    ui.stack(
                        [
                            .Background(.Rgb(40, 40, 200)),
                            .Width(.Px(40)),
                            .Height(.Px(16)),
                        ],
                        [],
                    ),
                ],
            ),
        ),
        band(
            "Layout(.Row)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(.Row),
                    .Width(.Px(320)),
                    .Height(.Px(100)),
                ],
                [
                    ui.stack(
                        [
                            .Background(.Rgb(200, 40, 40)),
                            .Width(.Px(120)),
                            .Height(.Px(44)),
                        ],
                        [],
                    ),
                    ui.stack(
                        [
                            .Background(.Rgb(40, 150, 40)),
                            .Width(.Px(80)),
                            .Height(.Px(30)),
                        ],
                        [],
                    ),
                    ui.stack(
                        [
                            .Background(.Rgb(40, 40, 200)),
                            .Width(.Px(40)),
                            .Height(.Px(16)),
                        ],
                        [],
                    ),
                ],
            ),
        ),
        band(
            "Layout(.Layers)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(.Layers),
                    .Width(.Px(320)),
                    .Height(.Px(100)),
                ],
                [
                    ui.stack(
                        [
                            .Background(.Rgb(200, 40, 40)),
                            .Width(.Px(120)),
                            .Height(.Px(44)),
                        ],
                        [],
                    ),
                    ui.stack(
                        [
                            .Background(.Rgb(40, 150, 40)),
