/// Three blocks of eighty in eight hundred, then three of two hundred in
/// three hundred.
export fn growShrink<C>(): Node<C> {
    page([
        band(
            "Grow(0) on all three",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Layout(.Row), .Gap(.Px(8))], [
                ui.stack(
                    [.Background(.Rgb(200, 40, 40)), .Width(.Px(80)), .Height(.Px(20))],
                    [],
