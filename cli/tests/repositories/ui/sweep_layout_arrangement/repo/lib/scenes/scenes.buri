/// Every `Align`, as `AlignCross`. The third block has no height of its
/// own, so `Stretch` is the row where it fills the container.
export fn alignCross<C>(): Node<C> {
    page([
        band(
            "AlignCross(.Start)",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(.Row),
                    .AlignCross(.Start),
                    .Gap(.Px(8)),
                    .Height(.Px(48)),
