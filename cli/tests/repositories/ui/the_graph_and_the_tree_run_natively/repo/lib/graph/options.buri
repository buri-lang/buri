from "ui/node" import * as ui;
from "ui/node" import { Node };

/// A filtered option list: an `each` whose rows are a `choose`.
///
/// This is the ordinary way to leave a row out without allocating, because the
/// row builder is handed a `Scope` and a `Scope` cannot allocate. The `choose`
/// nested inside the `each` is the shape of it, and the reason this component
/// exists here at all.
export fn options<C>(items: [Str], keep: Str): Node<C> {
    ui.stack(
        [],
        [
            ui.each(
                .Const(items),
                fn(item) => item,
                fn(_ctx, item, _index) => {
                    ui.choose(.Const(item == keep), ui.text(.Const(item)), ui.nothing())
                },
            ),
        ],
    )
}
