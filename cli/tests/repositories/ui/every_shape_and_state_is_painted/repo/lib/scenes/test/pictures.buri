// A picture, and an overlay pinned to the page.
//
// An image carries its source, so a painter that fetches nothing still draws
// the two data URIs it can read and a placeholder box for every source it
// cannot. Without that the row below is a blank page, and before #85 it was a
// row of identical grey boxes.
//
// `Position(.PinViewport)` is measured against the page, so a dock written
// three boxes deep sits in the page's corner rather than at the top left.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/testing" import { headless, snapshot };

/// An eight-pixel PNG, written out whole: a page fetches its images and a
/// snapshot may not, so a data URI is the only source there is.
let icon: Str =
    "data:image/png;base64,";

/// The vector form this vocabulary offers, drawn by the painter's own
/// rasterizer. Its semicolons are the reason a declaration value escapes them.
let glyph: Str =
    "data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23e70000' stroke-width='2'%3E%3Cpath d='M5 12h14M12 5v14'/%3E%3C/svg%3E";

/// One icon in a box of its own, the way a component library ships one.
fn framed<C>(source: Str): Node<C> {
    ui.stack([.Width(.Px(24)), .Height(.Px(24))], [
        ui.image(.Const(source), .Const("")),
    ])
}

/// A row of icons, a picture at its own size, and a glyph in a box far larger
/// than it — which keeps its own twenty-four units and sits in the corner.
fn pictures<C>(): Node<C> {
    ui.column([.Padding(.Px(24)), .Gap(.Px(16))], [
        ui.row([.Gap(.Px(8))], [
            framed(icon),
            framed(glyph),
            framed(glyph),
            framed(icon),
        ]),
        ui.image(.Const(icon), .Const("the icon at the size it is")),
        ui.stack([.Width(.Px(220)), .Height(.Px(64))], [
            ui.image(.Const(glyph), .Const("a glyph in a box far larger than it")),
        ]),
    ])
}

/// A page with a dock pinned to the bottom right of the *viewport*, written
/// three boxes deep so that where it lands says which box it was measured
/// against.
fn docked<C>(): Node<C> {
    ui.column([.Padding(.Px(24)), .Gap(.Px(8))], [
        ui.text(.Const("the page")),
        ui.stack([.Padding(.Px(16)), .Background(.Rgb(235, 240, 235))], [
            ui.stack([.Padding(.Px(16))], [
                ui.text(.Const("three boxes in")),
                ui.stack(
                    [
                        .Position(.PinViewport),
                        .Pin(.Bottom, .Px(24)),
                        .Pin(.End, .Px(24)),
                        .Padding(.Px(16)),
                        .Radius(.Px(8)),
                        .Background(.Rgb(30, 30, 45)),
                        .Foreground(.Rgb(255, 255, 255)),
                    ],
                    [ui.text(.Const("saved"))],
                ),
            ]),
        ]),
    ])
}

test "a picture is a picture and not a hole in the page" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "pictures", pictures(), .Checked, []);
}

test "an overlay pinned to the viewport sits in the viewport's corner" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "pinned-dock", docked(), .Checked, []);
}
