// A table, painted twice.
//
// The four table roles are an arrangement as well as a meaning: a row divides
// into one column per cell, so the second row's cells line up under the first's.
// Without that every cell is on a line of its own and a column that stopped
// aligning could not fail a golden.
//
// Twice, because the rows carry an `On(.Hover)` background: the hovered picture
// and the resting one are two pictures of one tree.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/testing" import { headless, snapshot };

/// Three columns and three rows, the second and third of which have to line up
/// under the first.
fn invoices<C>(): Node<C> {
    ui.stack({ styles: [.Width(.Px(480)), .BorderWidth(.Px(1)), .BorderColor(.Rgb(180, 180, 190))], children: [
            ui.stack({ styles: [
                    .Background(.Rgb(235, 235, 242)),
                    .On(.Hover, [.Background(.Rgb(250, 210, 120))]),
                ], children: [
                    ui.stack({ styles: [.Padding(.Px(8))], children: [
                        ui.text({ content: .Const("Invoice") }),
                    ], role: .Some(.ColumnHeader) }),
                    ui.stack({ styles: [.Padding(.Px(8))], children: [
                        ui.text({ content: .Const("Amount") }),
                    ], role: .Some(.ColumnHeader) }),
                    ui.stack({ styles: [.Padding(.Px(8))], children: [
                        ui.text({ content: .Const("Status") }),
                    ], role: .Some(.ColumnHeader) }),
                ], role: .Some(.TableRow) }),
            ui.stack({ styles: [.On(.Hover, [.Background(.Rgb(250, 240, 205))])], children: [
                ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("INV-001") })], role: .Some(.RowHeader) }),
                ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("$250.00") })], role: .Some(.Cell) }),
                ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("Paid") })], role: .Some(.Cell) }),
            ], role: .Some(.TableRow) }),
            ui.stack({ styles: [.On(.Hover, [.Background(.Rgb(250, 240, 205))])], children: [
                ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("INV-002") })], role: .Some(.RowHeader) }),
                ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("$1,020.00") })], role: .Some(.Cell) }),
                ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("Due") })], role: .Some(.Cell) }),
            ], role: .Some(.TableRow) }),
        ], role: .Some(.Table) })
}

test "a table paints as a table" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "table", invoices(), .Checked, []);
}

test "a hovered table paints hovered" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "table-hovered", invoices(), .Hover, []);
}
