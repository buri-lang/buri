from "platform/effect" import { Allocator, Location, Ui };
from "platform/effect/testing" import { address, alloc, headless, snapshot };
from "//lib/rows" import { rows };

test "every row is painted" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Location: address(headless(), "/"),
    };
    snapshot(ctx, "rows", rows(), .Hover, []);
}
