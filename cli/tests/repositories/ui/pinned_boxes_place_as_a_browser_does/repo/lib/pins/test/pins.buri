                .Position(.Flow),
                .Width(.Px(200)),
                .Height(.Px(100)),
                .Padding(.Px(10)),
                grey(),
            ],
            [
                frame([.Width(.Px(100)), .Height(.Px(50)), blue()], []),
                fitted(25, 30, 150),
            ],
        ),
        .Hover,
        [],
    );
}

