test "padded-percent-sizes: sizes measure from a box a percentage of its parent's content" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "padded-percent-sizes",
        stage([
            frame([.Width(.Px(200)), .Padding(.Px(8)), grey()], [
                frame(
                    [
                        .Position(.Flow),
                        .Width(.Percent(50.0)),
                        .Height(.Px(100)),
                        blue(),
                    ],
                    [sizes()],
                ),
            ]),
        ]),
        .Hover,
        [],
    );
}

test "padded-percent-sizes: sizes measure from a box a percentage of its parent's content, the twin: a box pinned over it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
