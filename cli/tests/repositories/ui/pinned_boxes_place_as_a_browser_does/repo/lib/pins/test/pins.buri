    snapshot(
        ctx,
        "anchor-grandparent-edges",
        frame(
            [
                .Position(.Flow),
                .Width(.Px(200)),
                .Height(.Px(100)),
                .Padding(.Px(10)),
                grey(),
            ],
            [
                frame([.Width(.Px(100)), .Height(.Px(50)), blue()], [
                    red(20, [.Position(.PinAnchor)]),
                ]),
            ],
        ),
        .Hover,
        [],
    );
}

