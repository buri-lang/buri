// Pinned boxes the painter once placed or cut where a browser doesn't. Each
// scene shares its golden with a twin that gets the same picture another way.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/style" import { Style };

fn frame<C>(styles: [Style], children: [Node<C>]): Node<C> {
    ui.stack({ styles: styles, children: children })
}

// A positioned box 300 by 200 at the page's corner.
fn stage<C>(children: [Node<C>]): Node<C> {
    frame([.Position(.Flow), .Width(.Px(300)), .Height(.Px(200))], children)
}

// A transparent box pinned over `width` by `height` at `start`, `top`.
fn over<C>(
    start: Int,
    top: Int,
    width: Int,
    height: Int,
    children: [Node<C>],
): Node<C> {
    frame(
        [
            .Pin(.Top, .Px(top)),
            .Pin(.Start, .Px(start)),
            .Width(.Px(width)),
            .Height(.Px(height)),
        ],
        children,
    )
}

// A red box 30 by 40, pinned 10 down and `start` across, with `extra`.
fn red<C>(start: Int, extra: [Style]): Node<C> {
    frame(
        [
            .Pin(.Top, .Px(10)),
            .Pin(.Start, .Px(start)),
            .Width(.Px(30)),
            .Height(.Px(40)),
            .Background(.Rgb(255, 0, 0)),
            .Group(extra),
        ],
        [],
    )
}

// A red box pinned by both edges in each axis, with `extra`.
fn both<C>(extra: [Style]): Node<C> {
    frame(
        [
            .Pin(.Top, .Px(10)),
            .Pin(.Bottom, .Px(20)),
            .Pin(.Start, .Px(30)),
            .Pin(.End, .Px(40)),
            .Background(.Rgb(255, 0, 0)),
            .Group(extra),
        ],
        [],
    )
}

// A red box at the corner, sized by percentages, with `extra`.
fn sizes<C>(extra: [Style]): Node<C> {
    frame(
        [
            .Pin(.Top, .Px(0)),
            .Pin(.Start, .Px(0)),
            .Width(.Percent(50.0)),
            .Height(.Percent(25.0)),
            .Background(.Rgb(255, 0, 0)),
            .Group(extra),
        ],
        [],
    )
}

// A red box 30 by 40 with `extra`, which pins nothing.
fn loose<C>(extra: [Style]): Node<C> {
    frame(
        [
            .Width(.Px(30)),
            .Height(.Px(40)),
            .Background(.Rgb(255, 0, 0)),
            .Group(extra),
        ],
        [],
    )
}

// A red box 40 tall holding three boxes 50 by 10 in a wrapping row, with no
// width of its own, and `extra`.
fn fit<C>(extra: [Style]): Node<C> {
    frame(
        [
            .Layout(.Row),
            .Wrap(true),
            .Height(.Px(40)),
            .Background(.Rgb(255, 0, 0)),
            .Group(extra),
        ],
        [
            frame([.Width(.Px(50)), .Height(.Px(10))], []),
            frame([.Width(.Px(50)), .Height(.Px(10))], []),
            frame([.Width(.Px(50)), .Height(.Px(10))], []),
        ],
    )
}

// What `fit` draws, `width` wide and pinned at `start`, `top`.
fn fitted<C>(start: Int, top: Int, width: Int): Node<C> {
    fit([.Pin(.Top, .Px(top)), .Pin(.Start, .Px(start)), .Width(.Px(width))])
}

fn grey(): Style {
    .Background(.Rgb(220, 220, 220))
}

fn blue(): Style {
    .Background(.Rgb(200, 200, 255))
}

// Moves a box 40 across and 20 down.
fn moved(): Style {
    .Translate(.Px(40), .Px(20))
}

// A grey box 200 by 100 with `extra`.
fn card<C>(extra: [Style], children: [Node<C>]): Node<C> {
    frame([.Width(.Px(200)), .Height(.Px(100)), grey(), .Group(extra)], children)
}

// A blue box 100 by 50 with `extra`.
fn trigger<C>(extra: [Style], children: [Node<C>]): Node<C> {
    frame([.Width(.Px(100)), .Height(.Px(50)), blue(), .Group(extra)], children)
}

// An open dialog 200 by 100.
fn dialog<C: Ui>(ctx: C, children: [Node<C>]): Node<C> {
    ui.dialog({
        isOpen: signal(ctx, true),
        label: .Const("Pins"),
        children: children,
        styles: [.Width(.Px(200)), .Height(.Px(100)), .Background(.Rgb(255, 255, 255))],
    })
}

// A red box 40 tall with no width of its own, holding `children`, with
// `extra`.
fn fitAround<C>(extra: [Style], children: [Node<C>]): Node<C> {
    frame([.Height(.Px(40)), .Background(.Rgb(255, 0, 0)), .Group(extra)], children)
}

// Lays a box out as a wrapping row.
fn wrapping(): Style {
    .Group([.Layout(.Row), .Wrap(true)])
}

// A blue box 10 tall with `extra`, holding `children`.
fn part<C>(extra: [Style], children: [Node<C>]): Node<C> {
    frame([.Height(.Px(10)), blue(), .Group(extra)], children)
}

// A box 50 by 10.
fn fifty<C>(): Node<C> {
    frame([.Width(.Px(50)), .Height(.Px(10))], [])
}

// A blue box half as wide as its parent, beside two boxes 50 wide.
fn halves<C>(): [Node<C>] {
    [part([.Width(.Percent(50.0))], []), fifty(), fifty()]
}

test "bordered-both: both edges measure from inside the border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "bordered-both",
        stage([
            frame(
                [
                    .Position(.Flow),
                    .Width(.Px(200)),
                    .Height(.Px(100)),
                    .Padding(.Px(8)),
                    .BorderWidth(.Px(5)),
                    grey(),
                ],
                [both([])],
            ),
        ]),
        .Hover,
        [],
    );
}

test "bordered-both: both edges measure from inside the border, the twin: a box pinned over the padding box" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
