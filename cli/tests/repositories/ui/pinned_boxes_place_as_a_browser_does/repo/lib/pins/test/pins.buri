test "padded-height-both: both edges measure from a box as tall as its padding and flow" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "padded-height-both",
        stage([
            frame([.Position(.Flow), .Width(.Px(200)), .Padding(.Px(8)), grey()], [
                frame([.Height(.Px(20))], []),
                both(),
            ]),
        ]),
        .Hover,
        [],
    );
}

test "padded-height-both: both edges measure from a box as tall as its padding and flow, the twin: a box pinned over it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "padded-height-both",
        stage([
            frame([.Width(.Px(200)), .Padding(.Px(8)), grey()], [
                frame([.Height(.Px(20))], []),
            ]),
            over(0, 0, 200, 36, [both()]),
        ]),
        .Hover,
        [],
    );
}

