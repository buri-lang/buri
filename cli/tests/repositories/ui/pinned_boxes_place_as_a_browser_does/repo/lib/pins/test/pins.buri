        stage([
            frame([.Width(.Px(200)), .Padding(.Px(8)), grey()], [
                frame([.Width(.Percent(50.0)), .Height(.Px(100)), blue()], []),
            ]),
            over(8, 8, 92, 100, [sizes()]),
        ]),
        .Hover,
        [],
    );
}

test "clip-between: a clip between a pinned box and its positioned box cuts nothing" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "clip-between",
        stage([
            frame([.Clip(true), .Width(.Px(50)), .Height(.Px(50)), blue()], [red(60)]),
        ]),
        .Hover,
        [],
    );
}

test "clip-between: a clip between a pinned box and its positioned box cuts nothing, the twin: the box pinned beside the clip" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "clip-between",
        stage([
            frame([.Clip(true), .Width(.Px(50)), .Height(.Px(50)), blue()], []),
            red(60),
        ]),
        .Hover,
        [],
    );
}

