test "clip-unpositioned: a clip around a box pinned to the page cuts nothing" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "clip-unpositioned",
        frame([], [
            frame([.Clip(true), .Width(.Px(50)), .Height(.Px(50)), blue()], [red(60)]),
        ]),
        .Hover,
        [],
    );
}

test "clip-unpositioned: a clip around a box pinned to the page cuts nothing, the twin: the box pinned beside the clip" {
