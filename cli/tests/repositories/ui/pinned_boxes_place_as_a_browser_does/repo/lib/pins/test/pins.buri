test "clip-outside: a clip outside a pinned box's positioned box cuts it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "clip-outside",
        frame([.Clip(true), .Width(.Px(200)), .Height(.Px(100))], [
            frame([.Position(.Flow), .Width(.Px(300)), .Height(.Px(100))], [
                frame([.Clip(true), .Width(.Px(50)), .Height(.Px(50)), blue()], [
                    red(180),
                ]),
            ]),
        ]),
        .Hover,
        [],
    );
}

test "clip-outside: a clip outside a pinned box's positioned box cuts it, the twin: the box pinned beside the inner clip" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "clip-outside",
        frame([.Clip(true), .Width(.Px(200)), .Height(.Px(100))], [
            frame([.Position(.Flow), .Width(.Px(300)), .Height(.Px(100))], [
                frame([.Clip(true), .Width(.Px(50)), .Height(.Px(50)), blue()], []),
                red(180),
            ]),
        ]),
        .Hover,
        [],
    );
}
