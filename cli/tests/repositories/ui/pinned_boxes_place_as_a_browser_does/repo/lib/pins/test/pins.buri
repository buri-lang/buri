        "bordered-both",
        stage([
            frame(
                [
                    .Width(.Px(200)),
                    .Height(.Px(100)),
                    .Padding(.Px(8)),
                    .BorderWidth(.Px(5)),
                    grey(),
                ],
                [],
            ),
            over(5, 5, 190, 90, [both([])]),
        ]),
        .Hover,
        [],
    );
}

