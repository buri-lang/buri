test "viewport-translated-both: a box held to the viewport measures from a translated box" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "viewport-translated-both",
        frame(
            [.Translate(.Px(0), .Px(0)), .Width(.Px(200)), .Height(.Px(100)), grey()],
            [
                frame([.Position(.Flow), .Width(.Px(100)), .Height(.Px(50)), blue()], [
                    both([.Position(.PinViewport)]),
                ]),
            ],
        ),
        .Hover,
        [],
    );
}

