# `Figures`, painted both ways over one right-aligned column of totals:
#
#   * **Tabular.** Every digit is as wide as every other, so the decimal
#     points and the digits of "1,111.11", "8,888.88" and "10,000.00" stand
#     one under another.
#   * **Proportional.** Each digit is as wide as its shape, so the row of ones
#     is narrower than the row of eights and its digits drift out of line.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a column of totals with tabular figures lines its digits up, and with proportional figures does not"

run {
  args: ["test", "//lib/totals", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/totals/test/__snapshots__/totals-tabular.diff.png"  exists: false }
path { path: "lib/totals/test/__snapshots__/totals-proportional.diff.png"  exists: false }
