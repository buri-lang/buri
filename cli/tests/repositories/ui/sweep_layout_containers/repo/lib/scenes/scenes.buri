/// A browser marks and indents a `ul` by itself, so the first two columns
/// are the assertion that nothing here does.
export fn lists<C>(): Node<C> {
    page([
        band(
            "region(.List) holding three region(.ListItem)s",
            ui.stack({
                styles: [.Layout(.Row), .Gap(.Px(50))],
                children: [
                    ui.stack({
                        styles: [.Layout(.Column), .Gap(.Px(4))],
                        children: [
                            ui.stack({
                                styles: [
                                    .FontSize(.Px(11)),
