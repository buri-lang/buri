/// A browser marks and indents a `ul` by itself, so the first two columns
/// are the assertion that nothing here does.
export fn lists<C>(): Node<C> {
    page([
        band(
            "region(.List) holding three region(.ListItem)s",
            ui.stack([.Layout(.Row), .Gap(.Px(50))], [
                ui.stack([.Layout(.Column), .Gap(.Px(4))], [
                    ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
                        ui.text(.Const("no ListMarker at all")),
                    ]),
                    ui.region(.List, [.PaddingEdge(.Start, .Px(28)), .Gap(.Px(2))], [
                        ui.region(.ListItem, [], [ui.text(.Const("Alpha"))]),
                        ui.region(.ListItem, [], [ui.text(.Const("Beta"))]),
                        ui.region(.ListItem, [], [ui.text(.Const("Gamma"))]),
                    ]),
                ]),
                ui.stack([.Layout(.Column), .Gap(.Px(4))], [
                    ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
                        ui.text(.Const("ListMarker(.None)")),
                    ]),
                    ui.region(
                        .List,
                        [
                            .PaddingEdge(.Start, .Px(28)),
                            .Gap(.Px(2)),
                            .ListMarker(.None),
                        ],
                        [
                            ui.region(.ListItem, [], [ui.text(.Const("Alpha"))]),
                            ui.region(.ListItem, [], [ui.text(.Const("Beta"))]),
                            ui.region(.ListItem, [], [ui.text(.Const("Gamma"))]),
                        ],
                    ),
                ]),
                ui.stack([.Layout(.Column), .Gap(.Px(4))], [
                    ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
                        ui.text(.Const("ListMarker(.Disc)")),
                    ]),
                    ui.region(
                        .List,
                        [
                            .PaddingEdge(.Start, .Px(28)),
                            .Gap(.Px(2)),
                            .ListMarker(.Disc),
                        ],
                        [
                            ui.region(.ListItem, [], [ui.text(.Const("Alpha"))]),
                            ui.region(.ListItem, [], [ui.text(.Const("Beta"))]),
                            ui.region(.ListItem, [], [ui.text(.Const("Gamma"))]),
                        ],
                    ),
                ]),
                ui.stack([.Layout(.Column), .Gap(.Px(4))], [
                    ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
                        ui.text(.Const("ListMarker(.Decimal)")),
                    ]),
                    ui.region(
                        .List,
                        [
                            .PaddingEdge(.Start, .Px(28)),
                            .Gap(.Px(2)),
                            .ListMarker(.Decimal),
                        ],
                        [
                            ui.region(.ListItem, [], [ui.text(.Const("Alpha"))]),
                            ui.region(.ListItem, [], [ui.text(.Const("Beta"))]),
                            ui.region(.ListItem, [], [ui.text(.Const("Gamma"))]),
                        ],
                    ),
                ]),
            ]),
        ),
    ])
}

/// A row divides into one even track per cell, so the second row's cells
/// line up under the first's — and a row of four divides into four.
export fn tables<C>(): Node<C> {
    page([
        band(
            "a header row, then two rows of three",
            ui.region(
                .Table,
                [
                    .Width(.Px(520)),
                    .BorderWidth(.Px(1)),
                    .BorderColor(.Rgb(150, 150, 160)),
                ],
                [
                    ui.region(.TableRow, [.Background(.Rgb(232, 232, 238))], [
                        ui.region(.ColumnHeader, [.Padding(.Px(6))], [
                            ui.text(.Const("Invoice")),
                        ]),
                        ui.region(.ColumnHeader, [.Padding(.Px(6))], [
                            ui.text(.Const("Amount")),
                        ]),
                        ui.region(.ColumnHeader, [.Padding(.Px(6))], [
                            ui.text(.Const("Status")),
                        ]),
                    ]),
                    ui.region(.TableRow, [], [
                        ui.region(.RowHeader, [.Padding(.Px(6))], [
                            ui.text(.Const("INV-001")),
                        ]),
                        ui.region(.Cell, [.Padding(.Px(6))], [
                            ui.text(.Const("$250.00")),
                        ]),
                        ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("Paid"))]),
                    ]),
                    ui.region(.TableRow, [], [
                        ui.region(.RowHeader, [.Padding(.Px(6))], [
                            ui.text(.Const("INV-002")),
                        ]),
                        ui.region(.Cell, [.Padding(.Px(6))], [
                            ui.text(.Const("$1,020.00")),
                        ]),
                        ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("Due"))]),
                    ]),
                ],
            ),
        ),
        band(
            "a row of two over a row of four",
            ui.region(.Table, [.Width(.Px(520))], [
                ui.region(.TableRow, [], [
                    ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("one"))]),
                    ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("two"))]),
                ]),
                ui.region(.TableRow, [], [
                    ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("one"))]),
                    ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("two"))]),
                    ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("three"))]),
                    ui.region(.Cell, [.Padding(.Px(6))], [ui.text(.Const("four"))]),
                ]),
            ]),
        ),
    ])
}

/// `each` is the one constructor whose children the walk asks for rather
/// than being handed, so its rows have to take the container's layout like
/// any others.
export fn eachRows<C>(): Node<C> {
    page([
        band(
            "each under Layout(.Column)",
            ui.stack(
                [.Background(.Rgb(232, 232, 238)), .Layout(.Column), .Gap(.Px(4))],
                [rows()],
            ),
        ),
        band(
            "each under Layout(.Row)",
            ui.stack([.Background(.Rgb(232, 232, 238)), .Layout(.Row), .Gap(.Px(8))], [
                rows(),
            ]),
        ),
        band(
            "each under a grid of four even tracks",
            ui.stack(
                [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(
                        .Grid([.Fraction(1), .Fraction(1), .Fraction(1), .Fraction(1)]),
                    ),
                    .Gap(.Px(8)),
                ],
                [rows()],
            ),
        ),
    ])
}
