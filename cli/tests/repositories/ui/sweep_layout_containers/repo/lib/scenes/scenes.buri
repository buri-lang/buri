from "ui/node" import * as ui;
from "ui/node" import { Node };

/// The page every picture is drawn on: eight hundred wide with nothing inset
/// either side, so a boundary in a picture is a number off the viewport's own
/// edge.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column([.PaddingY(.Px(6)), .Gap(.Px(8)), .FontSize(.Px(13))], rows)
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.column([.Gap(.Px(2))], [
        ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
            ui.text(.Const(label)),
        ]),
        demo,
    ])
}

/// Four keyed rows, built through `each` — the one constructor whose children
/// the walk asks for rather than being handed.
fn rows<C>(): Node<C> {
    ui.each(
        .Const(["one", "two", "three", "four"]),
        fn(label) => label,
        fn(_c, label, _at) => {
            ui.stack(
                [
                    .Background(.Rgb(40, 40, 200)),
                    .Foreground(.Rgb(255, 255, 255)),
                    .Padding(.Px(4)),
                ],
                [ui.text(.Const(label))],
            )
        },
    )
}

/// A role is what a reader is told and not what a painter draws, so every
/// cell here should be the same picture — except the table roles, whose
/// whole point is an arrangement.
export fn roles<C>(): Node<C> {
    page([
        band(
            "region(role, [.Layout(.Row), .Gap(.Px(4))], two blocks)",
            ui.stack(
                [
                    .Layout(
                        .Grid([
                            .Fraction(1),
                            .Fraction(1),
                            .Fraction(1),
                            .Fraction(1),
                            .Fraction(1),
                            .Fraction(1),
                        ]),
                    ),
                    .Gap(.Px(6)),
                ],
                [
                    ui.stack([.Layout(.Column), .Gap(.Px(2))], [
                        ui.stack([.FontSize(.Px(10)), .Foreground(.Rgb(90, 90, 100))], [
                            ui.text(.Const("Navigation")),
                        ]),
                        ui.stack(
                            [
                                .Background(.Rgb(232, 232, 238)),
                                .Padding(.Px(4)),
                                .Height(.Px(30)),
                            ],
