/// A row divides into one even track per cell, so the second row's cells
/// line up under the first's — and a row of four divides into four.
export fn tables<C>(): Node<C> {
    page([
        band(
            "a header row, then two rows of three",
            ui.stack({
                styles: [
                    .Width(.Px(520)),
                    .BorderWidth(.Px(1)),
                    .BorderColor(.Rgb(150, 150, 160)),
                ],
                children: [
                    ui.stack({
                        styles: [.Background(.Rgb(232, 232, 238))],
                        children: [
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("Invoice") })],
                                role: .Some(.ColumnHeader),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("Amount") })],
                                role: .Some(.ColumnHeader),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("Status") })],
                                role: .Some(.ColumnHeader),
                            }),
                        ],
                        role: .Some(.TableRow),
                    }),
                    ui.stack({
                        styles: [],
                        children: [
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("INV-001") })],
                                role: .Some(.RowHeader),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("$250.00") })],
                                role: .Some(.Cell),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("Paid") })],
                                role: .Some(.Cell),
                            }),
                        ],
                        role: .Some(.TableRow),
                    }),
                    ui.stack({
                        styles: [],
                        children: [
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("INV-002") })],
                                role: .Some(.RowHeader),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("$1,020.00") })],
                                role: .Some(.Cell),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("Due") })],
                                role: .Some(.Cell),
                            }),
                        ],
                        role: .Some(.TableRow),
                    }),
                ],
                role: .Some(.Table),
            }),
        ),
        band(
            "a row of two over a row of four",
            ui.stack({
                styles: [.Width(.Px(520))],
                children: [
                    ui.stack({
                        styles: [],
                        children: [
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("one") })],
                                role: .Some(.Cell),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("two") })],
                                role: .Some(.Cell),
                            }),
                        ],
                        role: .Some(.TableRow),
                    }),
                    ui.stack({
                        styles: [],
                        children: [
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("one") })],
                                role: .Some(.Cell),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("two") })],
                                role: .Some(.Cell),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("three") })],
                                role: .Some(.Cell),
                            }),
                            ui.stack({
                                styles: [.Padding(.Px(6))],
                                children: [ui.text({ content: .Const("four") })],
                                role: .Some(.Cell),
                            }),
                        ],
                        role: .Some(.TableRow),
                    }),
                ],
                role: .Some(.Table),
            }),
        ),
    ])
}

/// `each` is the one constructor whose children the walk asks for rather
/// than being handed, so its rows have to take the container's layout like
/// any others.
export fn eachRows<C>(): Node<C> {
    page([
        band(
            "each under Layout(.Column)",
            ui.stack({
                styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(.Column),
                    .Gap(.Px(4)),
                ],
                children: [rows()],
            }),
        ),
        band(
            "each under Layout(.Row)",
            ui.stack({
                styles: [.Background(.Rgb(232, 232, 238)), .Layout(.Row), .Gap(.Px(8))],
                children: [rows()],
            }),
        ),
        band(
            "each under a grid of four even tracks",
            ui.stack({
                styles: [
                    .Background(.Rgb(232, 232, 238)),
                    .Layout(
                        .Grid([.Fraction(1), .Fraction(1), .Fraction(1), .Fraction(1)]),
                    ),
                    .Gap(.Px(8)),
                ],
                children: [rows()],
            }),
        ),
    ])
}
