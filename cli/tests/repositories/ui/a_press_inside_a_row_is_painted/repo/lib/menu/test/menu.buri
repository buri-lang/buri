from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import {
    alloc, headless, render, snapshot, snapshotWide,
};
from "//lib/menu" import { rows };

test "the rows built shut" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "shut", rows(false), .Checked, []);
}

test "the rows built open" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "open", rows(true), .Checked, []);
    snapshotWide(ctx, "open-phone", rows(true), .Checked, [], 390);
}

test "a press inside each row paints that row's menu open" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let page = render(ctx, rows(false));
    page.press("Apples");
    page.press("Pears");
    assert.isTrue(page.text().contains("Menu is open"));
    page.snapshot("open", []);
}

test "a press inside each row paints that row's menu open on a phone" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let page = render(ctx, rows(false));
    page.press("Apples");
    page.press("Pears");
    page.snapshotWide("open-phone", [], 390);
}
