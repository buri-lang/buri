// `BackdropBlur`, the blur a modal scrim casts on the page behind it.
//
// Every demo lays a scrim over a field split hard down the middle — dark on the
// start, light on the end. What a picture reads is that middle boundary: with
// no blur it is a sharp line under the wash, and a wider radius smears it into a
// grey ramp that grows with the radius, which is what `backdrop-filter: blur`
// means. The scrim is the layer the page separates behind; it paints over the
// blur it cast.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Style };

/// The page every picture is drawn on: eight hundred wide, nothing inset either
/// side.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column([.PaddingY(.Px(6)), .Gap(.Px(10)), .FontSize(.Px(13))], rows)
}

/// One row of a picture: the value it shows, and the demo that shows it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.column([.Gap(.Px(3))], [
        ui.stack([.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], [
            ui.text(.Const(label)),
        ]),
        demo,
    ])
}

/// The patterned page a scrim sits over: two blocks meeting at a hard vertical
/// edge, so a blur has an edge to soften.
fn field<C>(): Node<C> {
    ui.row([.Width(.Px(240)), .Height(.Px(80))], [
        ui.stack([.Background(.Rgb(30, 30, 55)), .Width(.Px(120)), .Height(.Full)], []),
        ui.stack(
            [.Background(.Rgb(235, 235, 245)), .Width(.Px(120)), .Height(.Full)],
            [],
        ),
    ])
}

/// The field with `scrim` laid over it, sharing one cell so the scrim paints
/// over the page it blurs.
fn over<C>(scrim: Node<C>): Node<C> {
    ui.stack([.Layout(.Layers), .Width(.Px(240)), .Height(.Px(80))], [field(), scrim])
}

/// A stack scrim carrying `extra`, sized to cover the field.
fn scrim<C>(extra: [Style]): Node<C> {
    ui.stack([.Width(.Full), .Height(.Full), .Group(extra)], [])
}

/// The tenth of black a dialog washes the page in.
fn tenth(): Style {
    .Background(.Rgba(0, 0, 0, 0.1))
}

/// The sweep of radii: nothing, then wider and wider, over one field. The
/// boundary is sharp at `.Px(0)` and a broader grey ramp at every step up.
export fn radii<C>(): Node<C> {
    page([
        band("no BackdropBlur", over(scrim([tenth()]))),
        band("BackdropBlur(.Px(0))", over(scrim([tenth(), .BackdropBlur(.Px(0))]))),
        band("BackdropBlur(.Px(2))", over(scrim([tenth(), .BackdropBlur(.Px(2))]))),
        band("BackdropBlur(.Px(4))", over(scrim([tenth(), .BackdropBlur(.Px(4))]))),
        band("BackdropBlur(.Px(8))", over(scrim([tenth(), .BackdropBlur(.Px(8))]))),
        band("BackdropBlur(.Px(16))", over(scrim([tenth(), .BackdropBlur(.Px(16))]))),
    ])
}

/// The picture the issue is about: a tenth of black separates the panel from
/// the page only once the page is blurred. A tenth alone barely marks it, a
/// tenth over a blur reads as a panel, and the half of black beside them is the
/// heavier wash a scrim reaches for without a blur.
export fn wash<C>(): Node<C> {
    page([
        band("a tenth of black, no blur", over(scrim([tenth()]))),
        band(
            "a tenth of black and BackdropBlur(.Px(6))",
            over(scrim([tenth(), .BackdropBlur(.Px(6))])),
        ),
        band(
            "a half of black, no blur",
            over(scrim([.Background(.Rgba(0, 0, 0, 0.5))])),
        ),
        band(
            "BackdropBlur(.Px(8)) under a rounded scrim",
            over(scrim([tenth(), .BackdropBlur(.Px(8)), .Radius(.Px(20))])),
        ),
    ])
    // A blur clipped to a rounded scrim: the softened page stops at the
    // corner the radius names, the way a browser clips a backdrop filter.
}

/// The scrim on every primitive that holds children. Each blurs the field the
/// same, because the blur is a style and lands on whatever element carries it.
export fn primitives<C>(): Node<C> {
    let styles: [Style] = [
        .Width(.Full),
        .Height(.Full),
        tenth(),
        .BackdropBlur(.Px(8)),
    ];
    page([
        band("stack", over(ui.stack(styles, []))),
        band("region(.Article)", over(ui.region(.Article, styles, []))),
        band("link", over(ui.link(.Const("/panel"), styles, []))),
        band("form", over(ui.form(fn(_c, _e) => (), styles, []))),
    ])
}
