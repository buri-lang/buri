// One picture per family of `ui/style` properties, over a `heading`, whose
// level is the outline and whose size is the styles.
//
// Resting state throughout: no style here is inside an `On`, so the
// state a snapshot is taken in contributes nothing to any of them.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/sweep" import {
    gapPage, paddingPage, runsPage, sizePage, surfacePage, typePage,
};

test "the surface properties, on a heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "heading-surface", surfacePage(), .Hover, []);
}

test "the type properties, on a heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "heading-type", typePage(), .Hover, []);
}

test "how a run of text is set, on a heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "heading-runs", runsPage(), .Hover, []);
}

test "the paddings, on a heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "heading-padding", paddingPage(), .Hover, []);
}

test "the gaps, and the mark beside a child, on a heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "heading-gap", gapPage(), .Hover, []);
}

test "the sizing properties, on a heading" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "heading-size", sizePage(), .Hover, []);
}
