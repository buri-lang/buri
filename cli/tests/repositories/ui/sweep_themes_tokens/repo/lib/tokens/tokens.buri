//! Every colour slot `ui/style` has, as a design token, on every primitive
//! that can carry one.

from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/signal" import { signal };
from "ui/style" import { Color, Shadow, Style, token };
from "ui/theme" import { Theme, themed };

/// This package's closed vocabulary: one token per colour a style can name.
export enum Token {
    /// `Background`.
    Surface,
    /// `Foreground`.
    Ink,
    /// `BorderColor`.
    Edge,
    /// `Shadow`'s colour.
    Cast,
}

impl Token {
    /// The custom property this token is, which is what a style holds.
    export fn color(self): Color {
        match (self) {
            .Surface => token("swept", "surface"),
            .Ink => token("swept", "ink"),
            .Edge => token("swept", "edge"),
            .Cast => token("swept", "cast"),
        }
    }
}

/// This package's tokens, resolved by `mapping`.
///
/// One binding per token, so adding a token here stops every consumer
/// compiling until it says what the new one is worth.
export fn themedBy(mapping: fn(Token) => Color): Theme {
    themed([
        (Token.Surface.color(), mapping(.Surface)),
        (Token.Ink.color(), mapping(.Ink)),
        (Token.Edge.color(), mapping(.Edge)),
        (Token.Cast.color(), mapping(.Cast)),
    ])
}

/// Every colour a token and no colour written out, so every coloured pixel is
/// the theme's decision.
let painted: [Style] = [
    .Padding(.Px(10)),
    .Background(Token.Surface.color()),
    .Foreground(Token.Ink.color()),
    .BorderWidth(.Px(4)),
    .BorderColor(Token.Edge.color()),
    .Shadow(Shadow {
        x: .Px(6),
        y: .Px(6),
        blur: .Px(0),
        spread: .Px(0),
        color: Token.Cast.color(),
    }),
];

/// One labelled row: the label in a fixed track, the sample in the rest.
fn labelled<C>(label: Str, sample: Node<C>): Node<C> {
    ui.stack({ styles: [.Layout(.Grid([.Fixed(.Px(140)), .Fraction(1)])), .Gap(.Px(12))], children: [
        ui.stack({ styles: [.FontSize(.Px(12))], children: [ui.text({ content: .Const(label) })] }),
        sample,
    ] })
}

/// A card, a heading, a button, a field and a list, each painted in the same
/// four tokens — so one picture says what all four are worth on all five.
export fn page<C: Ui>(ctx: C): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.Padding(.Px(16)), .Gap(.Px(14)), .FontSize(.Px(16))])], children: [
        labelled(
            "card",
            ui.stack({ styles: [.Group(painted), .Width(.Px(220))], children: [
                ui.text({ content: .Const("every colour a token") }),
            ] }),
        ),
        labelled(
            "heading",
            ui.text({ content: .Const("Ada"), headingLevel: .Some(2), styles: .Some([.Group(painted), .FontSize(.Px(22)), .FontWeight(.Bold)]) }),
        ),
        labelled(
            "button",
            ui.button({ label: .Const("press"), styles: painted, onPress: .Some(fn(_c) => ()) }),
        ),
        labelled(
            "field",
            ui.field({ label: .Const("name"), kind: .Text, value: signal(ctx, "Ada"), styles: painted }),
        ),
        labelled(
            "list",
            ui.stack({ styles: [.Group(painted), .PaddingEdge(.Start, .Px(28)), .ListMarker(.Disc)], children: [
                    ui.stack({ styles: [], children: [ui.text({ content: .Const("one") })], role: .Some(.ListItem) }),
                    ui.stack({ styles: [], children: [ui.text({ content: .Const("two") })], role: .Some(.ListItem) }),
                ], role: .Some(.List) }),
        ),
    ] })
}
