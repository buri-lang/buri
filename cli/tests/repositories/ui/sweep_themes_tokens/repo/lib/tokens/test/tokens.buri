// One tree, five theme lists.
//
// The tree holds no colour of its own, so what separates these five goldens is
// only what each `snapshot` was handed: a light mapping, a dark one, a list
// that binds one token of the four, two lists where the second rebinds two of
// the first's, and a chain that goes through another package's tokens.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/style" import { Color, token };
from "ui/testing" import { headless, snapshot };
from "ui/theme" import { themed };
from "//lib/tokens" import { page, themedBy, Token };

/// The app's light mapping.
fn light(t: Token): Color {
    match (t) {
        .Surface => .Rgb(250, 250, 252),
        .Ink => .Rgb(20, 20, 24),
        .Edge => .Rgb(200, 60, 60),
        .Cast => .Rgb(120, 120, 160),
    }
}

/// And its dark one.
fn dark(t: Token): Color {
    match (t) {
        .Surface => .Rgb(24, 24, 28),
        .Ink => .Rgb(240, 240, 245),
        .Edge => .Rgb(60, 200, 120),
        .Cast => .Rgb(10, 10, 20),
    }
}

test "light" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "tokens-light", page(ctx), .Hover, [themedBy(light)]);
}

test "dark" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "tokens-dark", page(ctx), .Hover, [themedBy(dark)]);
}

test "a token no theme bound" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    // One of the four. The other three are what an unresolved `var()` is worth
    // to each property that reads one, which is a picture and not a guess.
    snapshot(ctx, "tokens-unbound", page(ctx), .Hover, [
        themed([(Token.Surface.color(), .Rgb(250, 250, 252))]),
    ]);
}

test "the second list rebinds two of the first's" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "tokens-layered", page(ctx), .Hover, [
        themedBy(light),
        themed([
            (Token.Surface.color(), .Rgb(255, 240, 200)),
            (Token.Ink.color(), .Rgb(120, 20, 20)),
        ]),
    ]);
}

test "a token worth another package's token" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "tokens-chained", page(ctx), .Hover, [
        themed([
            (Token.Surface.color(), token("app", "bg")),
            (Token.Ink.color(), token("app", "fg")),
            (Token.Edge.color(), .Rgb(200, 60, 60)),
            (Token.Cast.color(), .Rgb(120, 120, 160)),
        ]),
        themed([
            (token("app", "bg"), .Rgb(200, 230, 255)),
            (token("app", "fg"), .Rgb(10, 40, 80)),
        ]),
    ]);
}
