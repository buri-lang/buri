// One page under an open dialog: drawn below `.Medium` and not from it up,
// where what holds it is removed, and drawn inside a stack hidden any other
// way.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot, snapshotWide };
from "ui/signal" import { signal };
from "//lib/held" import { hidden, narrowOnly };

test "below .Medium the dialog is drawn over the page" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshotWide(ctx, "held-narrow", narrowOnly(signal(ctx, true)), .Checked, [], 390);
}

test "from .Medium up the dialog is removed with what holds it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshotWide(ctx, "held-wide", narrowOnly(signal(ctx, true)), .Checked, [], 800);
}

test "a dialog inside a stack hidden any other way is drawn over the page" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "held-hidden", hidden(signal(ctx, true)), .Checked, []);
}
