// Three pictures, one per rule: a border is inside the box, a border with no
// colour is the foreground, and an outer shadow is outside the box.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/edges" import { currentColour, ring, widths };

test "a border of any width sits inside the box" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-border-widths", widths(), .Hover, []);
}

test "a border with no colour of its own draws in the foreground" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-current-colour", currentColour(), .Hover, []);
}

test "an outer shadow is painted outside the box that cast it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-focus-ring", ring(), .Hover, []);
}
