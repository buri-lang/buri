// One picture, in this package's own `test/__snapshots__`.

from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/testing" import { headless, snapshot };

test "the one panel" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "panel",
        ui.stack({
            styles: [
                .Layout(.Column),
                .Group([.Padding(.Px(16)), .Background(.Rgb(230, 220, 210))]),
            ],
            children: [
                ui.text({
                    content: .Const("one"),
                    headingLevel: .Some(2),
                    styles: .Some([]),
                }),
            ],
        }),
        .Hover,
        [],
    );
}
