// One picture, in this package's own `test/__snapshots__`.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "ui/node" import * as ui;

test "the two panel" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "panel",
        ui.stack({
            styles: [
                .Layout(.Column),
                .Group([.Padding(.Px(16)), .Background(.Rgb(210, 220, 230))]),
            ],
            children: [
                ui.text({
                    content: .Const("two"),
                    headingLevel: .Some(2),
                    styles: .Some([]),
                }),
            ],
        }),
        .Hover,
        [],
    );
}
