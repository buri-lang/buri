// Each scene with its base value written in place, then the same scene with
// the value handed through a parameter. Both of a pair compare against one
// golden, so a value a breakpoint overrides only when written in place fails.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "//lib/open" import {
    bleedByParameter, bleedWritten, borderEdgeByParameter, borderEdgeWritten,
    borderWidthByParameter, borderWidthWritten, dashedByParameter, dashedWritten,
    fontFamilyByParameter, fontFamilyWritten, gridByParameter, gridWritten,
    paddingEdgeByParameter, paddingEdgeWritten, pinByParameter, pinWritten,
    radiusCornerByParameter, radiusCornerWritten, translateByParameter,
    translateWritten, truncateByParameter, truncateWritten, untruncatedByParameter,
    untruncatedWritten,
};

test "a pin written in place gives way to a breakpoint" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "pin", pinWritten(), .Checked, []);
}

test "a pin handed through a parameter gives way to a breakpoint" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "pin", pinByParameter(), .Checked, []);
}

