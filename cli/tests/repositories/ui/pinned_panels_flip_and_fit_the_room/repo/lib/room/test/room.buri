test "a panel that fits and flips opens on the roomier side, cut to it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "fit-flip",
        anchored(150, 200, [
            .Pin(.Top, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(300)),
            .FitRoom(.Y),
            .Fallback(.FlipBlock),
        ]),
        .Checked,
        [],
    );
}

test "the box pinned the plain way where the panel fit-flip goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "fit-flip",
        pinned(150, 200, [
            .Pin(.Bottom, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(150)),
        ]),
        .Checked,
        [],
    );
}

test "a tooltip's bubble with no room below its trigger flips above it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "tooltip",
        tip(160, [.Width(.Px(160)), .Height(.Px(80))]),
        .Hover,
        [],
    );
}

test "the box pinned the plain way where the tooltip goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "tooltip",
        tipTwin(160, [
            .Pin(.Bottom, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
        ]),
        .Hover,
        [],
    );
}
