test "a panel too tall for the room below its anchor is cut to it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "fit-down",
        anchored(40, 200, [
            .Pin(.Top, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(300)),
            .FitRoom(.Y),
        ]),
        .Checked,
        [],
    );
}

test "the box pinned the plain way where the panel fit-down goes" {
    let ctx = context {
