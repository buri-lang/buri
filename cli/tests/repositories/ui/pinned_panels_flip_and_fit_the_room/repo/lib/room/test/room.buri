    snapshot(
        ctx,
        "flip-inline",
        anchored(40, 600, [
            .Pin(.Top, .Px(0)),
            .Pin(.Start, .Percent(100.0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
            .Fallback(.FlipInline),
        ]),
        .Checked,
        [],
