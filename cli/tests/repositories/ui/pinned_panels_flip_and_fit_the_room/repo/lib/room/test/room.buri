// Each scene beside its twin: both tests of a pair compare against one
// golden, so a panel placed anywhere else fails its scene.

from "platform/effect" import { Allocator, Ui, Watch };
from "platform/effect/testing" import { alloc, headless, observer, snapshot };
from "//lib/room" import { anchored, computed, pinned, tip, tipTwin };

test "a panel with no room below its anchor flips above it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "flip-block",
        anchored(160, 200, [
            .Pin(.Top, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
            .Fallback(.FlipBlock),
        ]),
        .Checked,
        [],
    );
}

test "the box pinned the plain way where the panel flip-block goes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(
        ctx,
        "flip-block",
        pinned(160, 200, [
            .Pin(.Bottom, .Percent(100.0)),
            .Pin(.Start, .Px(0)),
            .Width(.Px(160)),
            .Height(.Px(80)),
        ]),
        .Checked,
        [],
    );
}

