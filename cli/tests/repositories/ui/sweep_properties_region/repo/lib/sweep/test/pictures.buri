// One picture per family of `ui/style` properties, over a `region` with a
// plain role, which paints as a stack does because a role paints nothing.
//
// Resting state throughout: no style here is inside an `On`, so the
// state a snapshot is taken in contributes nothing to any of them.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/sweep" import {
    gapPage, paddingPage, runsPage, sizePage, surfacePage, typePage,
};

test "the surface properties, on a region" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "region-surface", surfacePage(), .Hover, []);
}

test "the type properties, on a region" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "region-type", typePage(), .Hover, []);
}

test "how a run of text is set, on a region" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "region-runs", runsPage(), .Hover, []);
}

test "the paddings, on a region" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "region-padding", paddingPage(), .Hover, []);
}

test "the gaps, and the mark beside a child, on a region" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "region-gap", gapPage(), .Hover, []);
}

test "the sizing properties, on a region" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "region-size", sizePage(), .Hover, []);
}
