# One column of the `properties` sweep: every `ui/style` property that paints
# over an `icon`, at three to five values each — and then the two pictures the
# constructor exists for.
#
# An icon's artwork is *in* the tree, so unlike an `image` it takes styles of
# its own and they land on the `<svg>` itself. Seven pictures: the surface
# properties, the sizing ones, the paddings, where the colour comes from at rest
# and hovered, and one drawing under a light theme and a dark one.
#
# **The colour pictures are the issue** (buri-lang/buri#98). `Foreground` on the
# row paints the label and the glyph together; a wrapper's colour reaches
# through `Inherit`; an `On(.Hover)` moves it; a button with a mark and a word
# in it washes both at once, because there is one element being hovered; and
# beside each icon is the same drawing as a `data:` URI in an `image`, which
# stays black — an `<img>`'s source is a document of its own, and no rule on the
# page reaches inside it. That contrast is the whole reason there are two
# constructors.
#
# The lifecycle is `sweep_properties_image`'s: every golden compares, a renamed
# snapshot is reported as missing rather than as a difference, `--update`
# records it, the run after that compares against what it wrote, and an edit
# fails the comparison. Only the first run paints the whole suite; the runs
# after it are `--filter`ed to the one picture they are about, because painting
# seven 800 by 600 pages over and over is most of what this case would cost the
# bar.
#
# **Two negative twins, and each is a different claim.** One colour on the
# *row* — not on the icon — has to move the glyph's pixels, which is false for
# every icon that is a baked-in data URI. And the two theme lists swapped have
# to fail both theme goldens, which is the half a second copy of the artwork
# used to pay for.
#
# **Two of these pictures are pinned as painted rather than as right**, and one
# filed bug is why. Re-record them when it closes.
#
#   * #86 — a `Width` or a `Height` is a border box, so the padding sits inside
#     it. Visible everywhere the box page puts a padding against the subject's
#     thirty pixels, and on the surface page's `BorderWidth` band, where the
#     drawing shrinks as the border grows instead of the box growing around it.
#
# And one band is one picture across its values on purpose: an `AspectRatio` on
# a drawing that has a size of its own does nothing, because an auto height is
# that drawing's height — which is what a page does with a replaced element too.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "every ui/style property that paints over an `icon`, at three to five values each, plus where its colour comes from and what a theme does to it, as 7 pictures with the whole record-and-fail lifecycle over them"

run {
  args: ["test", "//lib/sweep", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/sweep/test/__snapshots__/icon-colour.diff.png"  exists: false }
path { path: "lib/sweep/test/__snapshots__/icon-light.diff.png"  exists: false }

# A snapshot nobody has recorded yet is reported as missing, with the command
# that records one, rather than as a difference against nothing.
edit {
  file: "lib/sweep/test/pictures.buri"
  replace: "\"icon-surface\""
  with: "\"never-recorded\""
}

run {
  args: ["test", "//lib/sweep", "--force", "--filter=surface"]
  exit: 1
  golden: "missing.txt"
}

path { path: "lib/sweep/test/__snapshots__/never-recorded.png"  exists: false }

run {
  args: ["test", "//lib/sweep", "--update", "--force", "--filter=surface"]
  exit: 0
  golden: "recorded.txt"
}

path { path: "lib/sweep/test/__snapshots__/never-recorded.png"  exists: true }

run {
  args: ["test", "//lib/sweep", "--force", "--filter=surface"]
  exit: 0
  golden: "again.txt"
}

# The first twin: a colour written on the row, which reaches the glyph only
# because the drawing is in the tree.
edit {
  file: "lib/sweep/scenes.buri"
  replace: "labelled(\"red\", .Rgb(200, 30, 30)),"
  with: "labelled(\"red\", .Rgb(30, 120, 60)),"
}

run {
  args: ["test", "//lib/sweep", "--force", "--filter=at rest"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/sweep/test/__snapshots__/icon-colour.diff.png"  exists: true }

# The second: the same drawing under the other theme each, which has to fail
# both goldens. If a theme reached no pixel of the artwork, the light golden
# would still match the dark tree and this step would pass.
edit {
  file: "lib/sweep/test/pictures.buri"
  replace: "snapshot(ctx, \"icon-light\", themePage(), .Focus, [themedBy(light)]);"
  with: "snapshot(ctx, \"icon-light\", themePage(), .Focus, [themedBy(dark)]);"
}

edit {
  file: "lib/sweep/test/pictures.buri"
  replace: "snapshot(ctx, \"icon-dark\", themePage(), .Focus, [themedBy(dark)]);"
  with: "snapshot(ctx, \"icon-dark\", themePage(), .Focus, [themedBy(light)]);"
}

run {
  args: ["test", "//lib/sweep", "--force", "--filter=drawing"]
  exit: 1
  golden: "swapped.txt"
}

path { path: "lib/sweep/test/__snapshots__/icon-light.diff.png"  exists: true }
path { path: "lib/sweep/test/__snapshots__/icon-dark.diff.png"  exists: true }
