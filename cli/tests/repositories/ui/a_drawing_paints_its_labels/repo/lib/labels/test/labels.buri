// The card as a picture: three bars, each with its month's name under it,
// and the names alone in an SVG image.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "//lib/labels" import { card, picture };

test "each month's name is centred under its bar" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "labels", card(("Jan", "Feb", "Mar")), .Checked, []);
}

test "the space around a name is not drawn" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "labels", card(("  Jan \n", " Feb  ", "\nMar  ")), .Checked, []);
}

test "an SVG image paints its text" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "picture", picture(), .Checked, []);
}
