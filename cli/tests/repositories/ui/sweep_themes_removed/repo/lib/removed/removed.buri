//! A header that removes one part below `.Medium` and another from it up.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Style };

/// A block of colour with a word in it.
fn block<C>(styles: [Style], words: Str): Node<C> {
    ui.stack({
        styles: [
            .Group(styles),
            .Padding(.Px(8)),
            .Foreground(.Rgb(255, 255, 255)),
            .FontSize(.Px(13)),
        ],
        children: [ui.text({ content: .Const(words) })],
    })
}

/// A menu button only below `.Medium`, links only from it up, and a block
/// after both, so a removed part's gap shows if it still takes one.
export fn header<C>(): Node<C> {
    ui.stack({
        styles: [.Layout(.Row), .Padding(.Px(16)), .Gap(.Px(10))],
        children: [
            block(
                [.Background(.Rgb(200, 60, 60)), .At(.Medium, [.Removed(true)])],
                "Menu",
            ),
            ui.stack({
                styles: [
                    .Layout(.Row),
                    .Gap(.Px(6)),
                    .Removed(true),
                    .At(.Medium, [.Removed(false)]),
                ],
                children: [
                    block([.Background(.Rgb(40, 160, 80))], "Home"),
                    block([.Background(.Rgb(40, 160, 80))], "Reports"),
                ],
            }),
            block([.Background(.Rgb(60, 90, 200))], "After"),
        ],
    })
}
