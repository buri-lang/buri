// One header painted either side of `.Medium`: the red menu only on the
// narrow page, the green links only on the wide one, and the blue block
// straight after whichever is there.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshotWide };
from "//lib/removed" import { header };

test "below .Medium the links are removed" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshotWide(ctx, "removed-narrow", header(), .Hover, [], 390);
}

test "from .Medium up the menu is removed" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshotWide(ctx, "removed-wide", header(), .Hover, [], 800);
}
