from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot, snapshotWide };
from "//lib/card" import { card };

test "a card with another name" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "card", card(.Const("Grace")), .Hover, []);
}

test "a narrow card" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshotWide(ctx, "card", card(.Const("Ada")), .Hover, [], 390);
}
