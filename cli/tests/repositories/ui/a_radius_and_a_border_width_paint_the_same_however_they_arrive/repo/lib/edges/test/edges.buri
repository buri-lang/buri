test "a negative edge width written in place draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "unbordered", edgeNegativeWritten(), .Checked, []);
}

test "a `Full` radius read back from a signal is a pill" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "pill", pillLate(ctx), .Checked, []);
}

test "a `Full` corner read back from a signal is a quarter of a pill" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "corner", cornerLate(ctx), .Checked, []);
}

test "a percentage border width read back from a signal draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "unbordered", percentLate(ctx), .Checked, []);
}

test "an `Auto` border width read back from a signal draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "unbordered", autoLate(ctx), .Checked, []);
