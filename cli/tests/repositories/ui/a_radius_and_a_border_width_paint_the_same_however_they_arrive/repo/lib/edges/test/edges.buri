// Each scene with its values written in place, then the same scene with them
// read back from a signal. Both of a pair compare against one golden, so a
// value that paints differently for how it arrived fails.

from "platform/effect" import { Allocator, Ui, Watch };
from "platform/effect/testing" import { alloc, headless, observer, snapshot };
from "//lib/edges" import {
    autoLate, autoWritten, cornerLate, cornerWritten, edgeNegativeLate,
    edgeNegativeWritten, edgePercentLate, edgePercentWritten, fullLate, fullWritten,
    negativeLate, negativeWritten, percentLate, percentWritten, pillLate, pillWritten,
    unbordered,
};

test "a `Full` radius written in place is a pill" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "pill", pillWritten(), .Checked, []);
}

test "a `Full` corner written in place is a quarter of a pill" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "corner", cornerWritten(), .Checked, []);
}

test "a border style with no width draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "unbordered", unbordered(), .Checked, []);
}

test "a percentage border width written in place draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "unbordered", percentWritten(), .Checked, []);
}

test "an `Auto` border width written in place draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "unbordered", autoWritten(), .Checked, []);
}

test "a `Full` border width written in place draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "unbordered", fullWritten(), .Checked, []);
}

test "a negative border width written in place draws no border" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "unbordered", negativeWritten(), .Checked, []);
