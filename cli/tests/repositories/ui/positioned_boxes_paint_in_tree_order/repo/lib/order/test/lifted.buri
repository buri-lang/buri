// A box that is positioned, or that is a stacking context of its own, paints
// with the pinned boxes in tree order, after the flow. Each scene beside its
// twin, which paints the same picture in plain tree order.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "//lib/order" import { afterPin, afterPinTwin, beforeFlow, beforeFlowTwin };

test "a box positioned in the flow paints over the pinned field written before it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "relative-after-pin", afterPin(0), .Checked, []);
}

test "the same square pinned, for a box positioned in the flow after a pinned field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "relative-after-pin", afterPinTwin(0), .Checked, []);
}

test "a box positioned in the flow paints over the box in the flow written after it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "relative-before-flow", beforeFlow(0), .Checked, []);
}

test "the same boxes in tree order, for a box positioned in the flow before the flow" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "relative-before-flow", beforeFlowTwin(0), .Checked, []);
}

