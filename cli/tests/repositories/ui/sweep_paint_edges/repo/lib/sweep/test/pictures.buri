// One picture per claim `BorderEdge` and `RadiusCorner` make: every value,
// composed, against the whole-box property each of them narrows, on every
// primitive, and the two controls the pair was asked for.
//
// Resting state throughout: no style here is inside an `On`, so the state a
// snapshot is taken in contributes nothing to any of them.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/sweep" import { borderPage, groupPage, primitivesPage, radiusPage };

test "a border named edge by edge" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-border", borderPage(), .Hover, []);
}

test "a radius named corner by corner" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-radius", radiusPage(), .Hover, []);
}

test "an edge and a corner on every primitive that paints chrome" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-primitives", primitivesPage(ctx), .Hover, []);
}

test "the joined group and the row rule the pair was asked for" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "edges-group", groupPage(), .Hover, []);
}
