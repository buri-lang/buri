// A parent's state style against the child's own.
//
// Seven columns: five properties one at a time, all five at once, and the
// control that answers to nothing. `responsive` carries an `On` group for
// every state; `resting` is the same tree with the groups gone, which is what
// a resting picture is — `State` has no resting variant, so `snapshot` cannot
// ask for one.
//
// The last row is the same control with no styles under the state's, so a
// picture also says what the sheet's reset left behind.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Color, Shadow, Style };

/// One cast: the same offset, and a blur and a colour per state.
fn cast(blur: Int, colour: Color): Shadow {
    Shadow { x: .Px(4), y: .Px(4), blur: .Px(blur), spread: .Px(0), color: colour }
}

/// `Background`, one colour per state.
fn backgroundStates(): [Style] {
    [
        .On(.Hover, [.Background(.Rgb(214, 44, 44))]),
        .On(.Focus, [.Background(.Rgb(40, 150, 60))]),
        .On(.Active, [.Background(.Rgb(48, 64, 200))]),
        .On(.Disabled, [.Background(.Rgb(132, 132, 132))]),
        .On(.Checked, [.Background(.Rgb(232, 188, 36))]),
    ]
}

/// `Foreground`, one colour per state.
fn foregroundStates(): [Style] {
    [
        .On(.Hover, [.Foreground(.Rgb(150, 20, 20))]),
        .On(.Focus, [.Foreground(.Rgb(16, 90, 32))]),
        .On(.Active, [.Foreground(.Rgb(20, 28, 120))]),
        .On(.Disabled, [.Foreground(.Rgb(88, 88, 88))]),
        .On(.Checked, [.Foreground(.Rgb(122, 96, 8))]),
    ]
}

/// `BorderWidth` and `BorderColor`, one pair per state.
fn borderStates(): [Style] {
    [
        .On(.Hover, [.BorderWidth(.Px(6)), .BorderColor(.Rgb(214, 44, 44))]),
        .On(.Focus, [.BorderWidth(.Px(4)), .BorderColor(.Rgb(40, 150, 60))]),
        .On(.Active, [.BorderWidth(.Px(8)), .BorderColor(.Rgb(48, 64, 200))]),
        .On(.Disabled, [.BorderWidth(.Px(3)), .BorderColor(.Rgb(132, 132, 132))]),
        .On(.Checked, [.BorderWidth(.Px(10)), .BorderColor(.Rgb(232, 188, 36))]),
    ]
}

/// `Opacity`, one fraction per state.
fn opacityStates(): [Style] {
    [
        .On(.Hover, [.Opacity(0.85)]),
        .On(.Focus, [.Opacity(0.7)]),
        .On(.Active, [.Opacity(0.55)]),
        .On(.Disabled, [.Opacity(0.4)]),
        .On(.Checked, [.Opacity(0.25)]),
    ]
}

/// `Shadow`, one cast per state.
fn shadowStates(): [Style] {
    [
        .On(.Hover, [.Shadow(cast(6, .Rgb(214, 44, 44)))]),
        .On(.Focus, [.Shadow(cast(8, .Rgb(40, 150, 60)))]),
        .On(.Active, [.Shadow(cast(10, .Rgb(48, 64, 200)))]),
        .On(.Disabled, [.Shadow(cast(12, .Rgb(132, 132, 132)))]),
        .On(.Checked, [.Shadow(cast(14, .Rgb(232, 188, 36)))]),
    ]
}

/// All five at once, which is the same classes the five columns above ask for
/// one at a time.
fn allStates(): [Style] {
    [
        .Group(backgroundStates()),
        .Group(foregroundStates()),
        .Group(borderStates()),
        .Group(opacityStates()),
        .Group(shadowStates()),
    ]
}

/// `Background`, one colour per state.
fn childBackgroundStates(): [Style] {
    [
        .On(.Hover, [.Background(.Rgb(250, 130, 130))]),
        .On(.Focus, [.Background(.Rgb(120, 220, 140))]),
        .On(.Active, [.Background(.Rgb(140, 160, 250))]),
        .On(.Disabled, [.Background(.Rgb(210, 210, 210))]),
        .On(.Checked, [.Background(.Rgb(250, 232, 150))]),
    ]
}

/// `Foreground`, one colour per state.
fn childForegroundStates(): [Style] {
    [
        .On(.Hover, [.Foreground(.Rgb(255, 226, 226))]),
        .On(.Focus, [.Foreground(.Rgb(226, 255, 232))]),
        .On(.Active, [.Foreground(.Rgb(226, 232, 255))]),
        .On(.Disabled, [.Foreground(.Rgb(246, 246, 246))]),
        .On(.Checked, [.Foreground(.Rgb(255, 249, 214))]),
    ]
}

/// `BorderWidth` and `BorderColor`, one pair per state.
fn childBorderStates(): [Style] {
    [
        .On(.Hover, [.BorderWidth(.Px(3)), .BorderColor(.Rgb(250, 130, 130))]),
        .On(.Focus, [.BorderWidth(.Px(5)), .BorderColor(.Rgb(120, 220, 140))]),
        .On(.Active, [.BorderWidth(.Px(7)), .BorderColor(.Rgb(140, 160, 250))]),
        .On(.Disabled, [.BorderWidth(.Px(9)), .BorderColor(.Rgb(210, 210, 210))]),
        .On(.Checked, [.BorderWidth(.Px(11)), .BorderColor(.Rgb(250, 232, 150))]),
    ]
}

/// `Opacity`, one fraction per state.
fn childOpacityStates(): [Style] {
    [
        .On(.Hover, [.Opacity(0.6)]),
        .On(.Focus, [.Opacity(0.5)]),
        .On(.Active, [.Opacity(0.45)]),
        .On(.Disabled, [.Opacity(0.35)]),
        .On(.Checked, [.Opacity(0.3)]),
    ]
}

/// `Shadow`, one cast per state.
fn childShadowStates(): [Style] {
    [
        .On(.Hover, [.Shadow(cast(5, .Rgb(250, 130, 130)))]),
        .On(.Focus, [.Shadow(cast(7, .Rgb(120, 220, 140)))]),
        .On(.Active, [.Shadow(cast(9, .Rgb(140, 160, 250)))]),
        .On(.Disabled, [.Shadow(cast(11, .Rgb(210, 210, 210)))]),
        .On(.Checked, [.Shadow(cast(13, .Rgb(250, 232, 150)))]),
    ]
}

/// All five at once, which is the same classes the five columns above ask for
/// one at a time.
fn childAllStates(): [Style] {
    [
        .Group(childBackgroundStates()),
        .Group(childForegroundStates()),
        .Group(childBorderStates()),
        .Group(childOpacityStates()),
        .Group(childShadowStates()),
    ]
}

/// A box inside a box, each with the base under its own `extra`.
fn styled<C>(parentExtra: [Style], childExtra: [Style]): Node<C> {
    ui.stack(
        [
            .Padding(.Px(10)),
            .Background(.Rgb(150, 170, 200)),
            .Foreground(.Rgb(24, 24, 24)),
            .BorderWidth(.Px(2)),
            .BorderColor(.Rgb(70, 90, 120)),
            .Radius(.Px(4)),
            .Width(.Full),
            .Group(parentExtra),
        ],
        [
            ui.stack(
                [
                    .Padding(.Px(6)),
                    .Background(.Rgb(110, 135, 180)),
                    .Radius(.Px(3)),
                    .Width(.Full),
                    .Group(childExtra),
                ],
                [ui.text(.Const("in"))],
            ),
        ],
    )
}

/// The same pair with nothing under the parent's `extra`.
fn bare<C>(parentExtra: [Style]): Node<C> {
    ui.stack([.Group(parentExtra)], [ui.stack([], [ui.text(.Const("in"))])])
}

/// One label cell.
fn label<C>(text: Str): Node<C> {
    ui.stack([], [ui.text(.Const(text))])
}

/// One row: a label track, then one cell per column.
fn grid<C>(cells: [Node<C>]): Node<C> {
    ui.stack(
        [
            .Layout(
                .Grid([
                    .Fixed(.Px(74)),
                    .Fraction(1),
                    .Fraction(1),
                    .Fraction(1),
                    .Fraction(1),
                    .Fraction(1),
                    .Fraction(1),
                    .Fraction(1),
                ]),
            ),
            .Gap(.Px(8)),
            .AlignCross(.Start),
        ],
        cells,
    )
}

/// The column names.
fn headings<C>(): Node<C> {
    grid([
        label(""),
        label("background"),
        label("foreground"),
        label("border"),
        label("opacity"),
        label("shadow"),
        label("all five"),
        label("none"),
    ])
}

/// The page: a title and the rows under it.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.column(
        [
            .Padding(.Px(12)),
            .Gap(.Px(8)),
            .FontSize(.Px(11)),
            .Background(.Rgb(255, 255, 255)),
        ],
        rows,
    )
}

/// Only the parent answers.
fn parentRow<C>(): Node<C> {
    grid([
        label("parent"),
        styled(backgroundStates(), []),
        styled(foregroundStates(), []),
        styled(borderStates(), []),
        styled(opacityStates(), []),
        styled(shadowStates(), []),
        styled(allStates(), []),
        styled([], []),
    ])
}

/// Only the child answers.
fn childRow<C>(): Node<C> {
    grid([
        label("child"),
        styled([], childBackgroundStates()),
        styled([], childForegroundStates()),
        styled([], childBorderStates()),
        styled([], childOpacityStates()),
        styled([], childShadowStates()),
        styled([], childAllStates()),
        styled([], []),
    ])
}

/// Both answer, in colours that tell them apart.
fn bothRow<C>(): Node<C> {
    grid([
        label("both"),
        styled(backgroundStates(), childBackgroundStates()),
        styled(foregroundStates(), childForegroundStates()),
        styled(borderStates(), childBorderStates()),
        styled(opacityStates(), childOpacityStates()),
        styled(shadowStates(), childShadowStates()),
        styled(allStates(), childAllStates()),
        styled([], []),
    ])
}

/// The same row with nothing to answer with.
fn restingRow<C>(name: Str): Node<C> {
    grid([
        label(name),
        styled([], []),
        styled([], []),
        styled([], []),
        styled([], []),
        styled([], []),
        styled([], []),
        styled([], []),
    ])
}

/// The control with no styles under the state's.
fn bareRow<C>(): Node<C> {
    grid([
        label("bare"),
        bare(backgroundStates()),
        bare(foregroundStates()),
        bare(borderStates()),
        bare(opacityStates()),
        bare(shadowStates()),
        bare(allStates()),
        bare([]),
    ])
}

/// The same bare row with nothing to answer with.
fn bareRestingRow<C>(): Node<C> {
    grid([
        label("bare"),
        bare([]),
        bare([]),
        bare([]),
        bare([]),
        bare([]),
        bare([]),
        bare([]),
    ])
}

/// Every element answering to every state, one property to a column.
export fn responsive<C>(): Node<C> {
    page([
        ui.text(.Const("a parent's state style against the child's own")),
        headings(),
        parentRow(),
        childRow(),
        bothRow(),
        bareRow(),
    ])
}

/// The same tree with no `On` group anywhere: what it looks like at rest,
/// whatever state it is painted in.
export fn resting<C>(): Node<C> {
    page([
        ui.text(.Const("a parent's state style against the child's own")),
        headings(),
        restingRow("parent"),
        restingRow("child"),
        restingRow("both"),
        bareRestingRow(),
    ])
}
