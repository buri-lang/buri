# A parent's state style against the child's own: six pictures of one tree — the resting one, and one
# per `State`.
#
# The rows are the five states `snapshot` accepts, plus the rest that has no
# variant to name it. The columns are `Background`, `Foreground`, `Border`,
# `Opacity` and `Shadow`, then all five at once, then the control that answers
# to nothing — so a picture says which element responded and how, with the cell
# that did not beside the ones that did.
#
# Three rows: the parent answers, the child answers, both answer. `Background`,
# `BorderWidth` and `Shadow` are each element's own, so a child's paints over
# its parent's; `Foreground` inherits until the child sets one; `Opacity` is the
# only one that compounds, because the painter multiplies it into every colour
# the subtree paints instead of compositing the subtree as a group.
#
# The negative twin moves one number in one cell of the hover palette. Exactly
# one of the six goldens changes, which is what the state pictures rest on:
# they are six documents, not six copies of one.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a parent's state style against the child's own, over every state and all five properties, painted and compared against six goldens with the whole record-and-fail lifecycle over them"

run {
  args: ["test", "//lib/nested", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/nested/test/__snapshots__/nested-resting.diff.png"  exists: false }

# A snapshot nobody has recorded yet says how to record one.
edit {
  file: "lib/nested/test/states.buri"
  replace: "snapshot(ctx, \"nested-resting\""
  with: "snapshot(ctx, \"never-recorded\""
}

run {
  args: ["test", "//lib/nested", "--force"]
  exit: 1
  golden: "missing.txt"
}

path { path: "lib/nested/test/__snapshots__/never-recorded.png"  exists: false }

run {
  args: ["test", "//lib/nested", "--update", "--force"]
  exit: 0
  golden: "recorded.txt"
}

path { path: "lib/nested/test/__snapshots__/never-recorded.png"  exists: true }

run {
  args: ["test", "//lib/nested", "--force"]
  exit: 0
  golden: "again.txt"
}

# One number in the hover palette, and only the hover picture moves.
edit {
  file: "lib/nested/scenes.buri"
  replace: ".Background(.Rgb(214, 44, 44))"
  with: ".Background(.Rgb(214, 44, 84))"
}

run {
  args: ["test", "//lib/nested", "--force"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/nested/test/__snapshots__/nested-hover.diff.png"  exists: true }
path { path: "lib/nested/test/__snapshots__/nested-focus.diff.png"  exists: false }
