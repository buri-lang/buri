// A picture is a picture, a picture that is not there is a box, and neither is
// a hole in the page.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "//lib/pictures" import { sizes, sources };

test "one row per kind of source" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "images-sources", sources(), .Hover, []);
}

test "one row per size the box around a picture declares" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "images-sizes", sizes(), .Hover, []);
}
