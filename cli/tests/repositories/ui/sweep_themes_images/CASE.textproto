# What an image paints when nothing may be fetched.
#
# Two pictures. `describe` used to drop an image's source entirely, so every
# golden holding an icon was a blank page of the right geometry
# (buri-lang/buri#61); these are the two that would go blank again.
#
# **One row per kind of source.** A `data:` URI holding a PNG this painter's
# own reader accepts is the only source there is: it paints, in four
# quadrants, at its own sixteen pixels. Five sources it cannot read — an SVG
# data URI, an address, a path, no source at all, and a PNG URI whose body is
# not a PNG — each paint the same framed grey box, because a picture that is
# not there is better shown as a box than as nothing.
#
# **One row per size the box declares.** `ui.image` takes no styles, so what
# sizes a picture is the box around it, and the two halves answer differently:
# a source that was read has a size of its own and keeps it, sitting at the top
# left of whatever box it is in; a source that was not has none, so the
# placeholder fills the box instead of collapsing. The last row of each half is
# the one with no box at all — sixteen pixels for the picture, the whole grid
# cell for the placeholder.
#
# The row in a box **shorter** than the picture is the painter's own documented
# simplification made visible: an element with no `display` lays out as a flex
# column, so a picture that does not fit is squashed into the room it was
# given rather than overflowing the way a block box would (`paint.rs`, "Two
# deliberate simplifications"). It is the one row here whose pixels a browser
# would disagree with, and it is labelled so nobody has to guess.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a data-URI PNG the painter reads, five sources it cannot, and what the box around each one does to its size"

run {
  args: ["test", "//lib/pictures", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/pictures/test/__snapshots__/images-sources.diff.png"  exists: false }
path { path: "lib/pictures/test/__snapshots__/images-sizes.diff.png"  exists: false }

# A snapshot nobody has recorded yet fails, and the report says how to record
# one rather than showing a difference against nothing.
edit {
  file: "lib/pictures/test/pictures.buri"
  replace: "snapshot(ctx, \"images-sources\", sources(), .Hover, []);"
  with: "snapshot(ctx, \"never-recorded\", sources(), .Hover, []);"
}

run {
  args: ["test", "//lib/pictures", "--force"]
  exit: 1
  golden: "missing.txt"
}

path { path: "lib/pictures/test/__snapshots__/never-recorded.png"  exists: false }

# `--update` records the one that was missing and rewrites the rest, and the
# run after it compares against what it just wrote.
run {
  args: ["test", "//lib/pictures", "--update", "--force"]
  exit: 0
  golden: "recorded.txt"
}

path { path: "lib/pictures/test/__snapshots__/never-recorded.png"  exists: true }

run {
  args: ["test", "//lib/pictures", "--force"]
  exit: 0
  golden: "again.txt"
}

# The negative twin: one edit, and the pictures it reaches fail while the
# pictures it does not reach stay clean.
edit {
  file: "lib/pictures/pictures.buri"
  replace: ".BorderWidth(.Px(2)), .BorderColor(.Rgb(120, 120, 130))"
  with: ".BorderWidth(.Px(2)), .BorderColor(.Rgb(200, 40, 40))"
}

run {
  args: ["test", "//lib/pictures", "--force"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/pictures/test/__snapshots__/images-sources.diff.png"  exists: false }
path { path: "lib/pictures/test/__snapshots__/images-sizes.diff.png"  exists: true }
