# `Clip`, both values, on every primitive that holds a child — four pictures on
# the eight-hundred-wide page the viewport is.
#
# The amber box is the parent and the blue one is the child that runs past it,
# so a picture reads as: is the blue painted outside the amber, and where the
# amber is rounded, does the blue square the corner off.
#
# `clip-overflow` is the one to read first. `Clip(true)` and `Scroll(.Both)`
# paint the same picture, and that is the finding rather than a redundancy:
# what the new property buys is not a different picture, it is not becoming a
# scroll container a keyboard can land in. Its last two rows are the green
# child that is too *tall*, which is the other axis under the one property.
#
# `clip-against-scroll` is the conflict slot. `Clip` and `Scroll` are two
# properties over one CSS declaration, so both classes land on the element and
# the sheet's order decides; `Clip` is declared later, so `Clip` is the answer
# whichever order the program wrote them in. Its first two rows are
# `Clip(false)` — the value that says *visible* — beside a `Scroll` that asked
# to clip, and they paint the overflow, which is the finding: a scroll under a
# clip is not a clip. The last two rows are the same property twice, where last
# wins on the element instead.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "what a box paints of a child that does not fit, the corners a rounded parent cuts it to, the declaration a clip and a scroll share, and both values on every primitive that holds children"

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 0
  golden: "pass.txt"
}

# A run that matched leaves no difference behind.
path { path: "lib/scenes/test/__snapshots__/clip-overflow.diff.png"  exists: false }

# A snapshot nobody has recorded yet fails, and the report says how to record
# one rather than showing a difference against nothing.
edit {
  file: "lib/scenes/test/clip.buri"
  replace: "\"clip-overflow\""
  with: "\"never-recorded\""
}

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 1
  golden: "missing.txt"
}

path { path: "lib/scenes/test/__snapshots__/never-recorded.png"  exists: false }

run {
  args: ["test", "//lib/scenes", "--update", "--force"]
  exit: 0
  golden: "recorded.txt"
}

path { path: "lib/scenes/test/__snapshots__/never-recorded.png"  exists: true }

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 0
  golden: "again.txt"
}

# The negative twin: one radius in one row of one picture, and only that
# picture moves.
edit {
  file: "lib/scenes/scenes.buri"
  replace: "band(\"Radius(.Px(20)) and Clip(true)\", holder([.Radius(.Px(20)), .Clip(true)])),"
  with: "band(\"Radius(.Px(20)) and Clip(true)\", holder([.Radius(.Px(6)), .Clip(true)])),"
}

run {
  args: ["test", "//lib/scenes", "--force"]
  exit: 1
  golden: "changed.txt"
}

path { path: "lib/scenes/test/__snapshots__/clip-corners.diff.png"  exists: true }
# Still being compared under its own name, and still matching.
path { path: "lib/scenes/test/__snapshots__/clip-primitives.diff.png"  exists: false }
