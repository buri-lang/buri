// `Clip`, both values, on everything that can hold a child that does not fit.
//
// The amber box is the parent and the blue one is the child that runs past it.
// What a picture reads is whether the blue is painted outside the amber, and —
// where the parent is rounded — whether the blue squares the corner off.

from "ui/node" import * as ui;
from "ui/node" import { Node };
from "ui/style" import { Style };

/// The page every picture is drawn on: eight hundred wide with nothing inset
/// either side, so a boundary in a picture is a number off the viewport's own
/// edge.
fn page<C>(rows: [Node<C>]): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.PaddingY(.Px(6)), .Gap(.Px(8)), .FontSize(.Px(13))])], children: rows })
}

/// One row of a picture: the value it shows, and the boxes that show it.
fn band<C>(label: Str, demo: Node<C>): Node<C> {
    ui.stack({ styles: [.Layout(.Column), .Group([.Gap(.Px(2))])], children: [
        ui.stack({ styles: [.FontSize(.Px(11)), .Foreground(.Rgb(90, 90, 100))], children: [
            ui.text({ content: .Const(label) }),
        ] }),
        demo,
    ] })
}

/// The child that does not fit: wider than whatever holds it, and short
/// enough that the amber shows underneath.
fn oversized<C>(): Node<C> {
    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Width(.Px(260)), .Height(.Px(24))], children: [] })
}

/// The child that does not fit the other way: taller than what holds it.
///
/// `Shrink(0)` is what makes it overflow rather than be squeezed — a column
/// gives up the height it has to before anything runs past an edge.
fn toolong<C>(): Node<C> {
    ui.stack({ styles: [
            .Background(.Rgb(20, 130, 90)),
            .Width(.Px(120)),
            .Height(.Px(64)),
            .Shrink(0),
        ], children: [] })
}

/// A box a hundred and eighty by forty, with `extra` on it and the oversized
/// child inside.
fn holder<C>(extra: [Style]): Node<C> {
    ui.stack({ styles: [
            .Background(.Rgb(230, 160, 20)),
            .Width(.Px(180)),
            .Height(.Px(40)),
            .Group(extra),
        ], children: [oversized()] })
}

/// What each value does with a child that runs past the box, and what `Scroll`
/// does beside them.
export fn overflow<C>(): Node<C> {
    page([
        band("no Clip at all", holder([])),
        band("Clip(false)", holder([.Clip(false)])),
        band("Clip(true)", holder([.Clip(true)])),
        band("Scroll(.Both)", holder([.Scroll(.Both)])),
        band(
            "a child taller than the box, under Clip(true)",
            ui.stack({ styles: [
                    .Background(.Rgb(230, 160, 20)),
                    .Width(.Px(180)),
                    .Height(.Px(40)),
                    .Clip(true),
                ], children: [toolong()] }),
        ),
        band(
            "the same child with no Clip",
            ui.stack({ styles: [.Background(.Rgb(230, 160, 20)), .Width(.Px(180)), .Height(.Px(40))], children: [toolong()] }),
        ),
    ])
    // `Scroll` clips too, at the cost of a region a keyboard can land in.
    // The two pictures agree, which is the point: what `Clip` buys is not
    // a different picture, it is not becoming a scroll container.
    // Down the page as well as across it: one property, both axes. The
    // clipped one comes first, so the one that runs past its box has
    // nothing under it to run into.
}

/// The card: the radius rounds the parent, and the clip is what stops a
/// full-bleed child squaring the corner off again.
export fn corners<C>(): Node<C> {
    page([
        band(
            "Radius(.Px(20)) with no Clip — the child squares the corner",
            holder([.Radius(.Px(20))]),
        ),
        band("Radius(.Px(20)) and Clip(true)", holder([.Radius(.Px(20)), .Clip(true)])),
        band(
            "Radius(.Percent(50.0)) and Clip(true)",
            holder([.Radius(.Percent(50.0)), .Clip(true)]),
        ),
        band(
            "a card whose banner runs edge to edge",
            ui.stack({ styles: [
                    .Background(.Rgb(230, 160, 20)),
                    .Width(.Px(240)),
                    .Radius(.Px(16)),
                    .Clip(true),
                ], children: [
                    ui.stack({ styles: [.Background(.Rgb(40, 40, 200)), .Height(.Px(48))], children: [] }),
                    ui.stack({ styles: [.Padding(.Px(8))], children: [ui.text({ content: .Const("Ada Lovelace") })] }),
                ] }),
        ),
    ])
    // The card the issue is about: a picture that reaches every edge, cut
    // to the corners its parent has.
}

/// Two properties over one declaration. `Clip` is declared after `Scroll`, so
/// the sheet writes its rule later and `Clip` decides — whichever order the
/// program wrote them in. The first two rows are `Clip(false)`, which is the
/// value that says *visible*, so an element that asked a `Scroll` to clip
/// paints its overflow anyway.
export fn against<C>(): Node<C> {
    page([
        band("Scroll(.Both) then Clip(false)", holder([.Scroll(.Both), .Clip(false)])),
        band("Clip(false) then Scroll(.Both)", holder([.Clip(false), .Scroll(.Both)])),
        band("Clip(true) then Clip(false)", holder([.Clip(true), .Clip(false)])),
        band("Clip(false) then Clip(true)", holder([.Clip(false), .Clip(true)])),
    ])
}

/// Every primitive that holds children, clipped and then not. The clipped one
/// is first in each row so that the one that overflows runs into empty page
/// rather than over its neighbour.
///
/// A `heading`, a `button` and a `text` hold a run of text rather than a box,
/// and `Truncate` is the property that cuts one of those.
export fn primitives<C>(): Node<C> {
    page([
        band("stack", ui.stack({ styles: [.Layout(.Row), .Group([.Gap(.Px(12))])], children: [holder([.Clip(true)]), holder([])] })),
        band(
            "region(.Article)",
            ui.stack({ styles: [.Layout(.Row), .Group([.Gap(.Px(12))])], children: [
                ui.stack({ styles: [
                        .Background(.Rgb(230, 160, 20)),
                        .Width(.Px(180)),
                        .Height(.Px(40)),
                        .Clip(true),
                    ], children: [oversized()], role: .Some(.Article) }),
                ui.stack({ styles: [
                        .Background(.Rgb(230, 160, 20)),
                        .Width(.Px(180)),
                        .Height(.Px(40)),
                    ], children: [oversized()], role: .Some(.Article) }),
            ] }),
        ),
        band(
            "link",
            ui.stack({ styles: [.Layout(.Row), .Group([.Gap(.Px(12))])], children: [
                ui.link({ dest: .Const("/a"), styles: [
                        .Background(.Rgb(230, 160, 20)),
                        .Width(.Px(180)),
                        .Height(.Px(40)),
                        .Clip(true),
                    ], children: [oversized()] }),
                ui.link({ dest: .Const("/b"), styles: [
                        .Background(.Rgb(230, 160, 20)),
                        .Width(.Px(180)),
                        .Height(.Px(40)),
                    ], children: [oversized()] }),
            ] }),
        ),
        band(
            "form",
            ui.stack({ styles: [.Layout(.Row), .Group([.Gap(.Px(12))])], children: [
                ui.form({ onSubmit: fn(_c) => (), children: [oversized()], styles: [
                        .Background(.Rgb(230, 160, 20)),
                        .Width(.Px(180)),
                        .Height(.Px(40)),
                        .Clip(true),
                    ] }),
                ui.form({ onSubmit: fn(_c) => (), children: [oversized()], styles: [
                        .Background(.Rgb(230, 160, 20)),
                        .Width(.Px(180)),
                        .Height(.Px(40)),
                    ] }),
            ] }),
        ),
    ])
}
