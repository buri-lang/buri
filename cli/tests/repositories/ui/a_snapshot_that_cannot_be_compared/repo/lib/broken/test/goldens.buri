// And three ways a golden is not one: nobody recorded it, it is not a whole
// picture, and two blocks named it.
//
// The last is a rule rather than a mistake. A snapshot names a *file*, so two
// blocks that name one share it: `--update` leaves the picture the later block
// painted, and the earlier one then reads a golden that is not its own.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/node" import * as ui;
from "ui/testing" import { headless, snapshot };

test "a golden nobody has recorded" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "never-recorded", ui.text(.Const("Ada")), .Hover, []);
}

test "a golden that is not a whole picture" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "truncated", ui.text(.Const("Ada")), .Hover, []);
}

test "one name, and this block painted first" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "shared", ui.text(.Const("first")), .Hover, []);
}

test "one name, and this block painted second" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "shared", ui.text(.Const("second")), .Hover, []);
}
