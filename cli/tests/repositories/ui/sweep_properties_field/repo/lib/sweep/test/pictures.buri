// One picture per family of `ui/style` properties, over a `field`, whose
// styles land on the input rather than on the label beside it.
//
// Resting state throughout: no style here is inside an `On`, so the
// state a snapshot is taken in contributes nothing to any of them.

from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "ui/effect" import { Ui };
from "ui/testing" import { headless, snapshot };
from "//lib/sweep" import {
    gapPage, kindsPage, paddingPage, runsPage, sizePage, surfacePage, typePage,
};

test "the surface properties, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-surface", surfacePage(ctx), .Hover, []);
}

test "the type properties, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-type", typePage(ctx), .Hover, []);
}

test "how a run of text is set, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-runs", runsPage(ctx), .Hover, []);
}

test "the paddings, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-padding", paddingPage(ctx), .Hover, []);
}

test "the gaps, and the mark beside a child, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-gap", gapPage(ctx), .Hover, []);
}

test "the sizing properties, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-size", sizePage(ctx), .Hover, []);
}

test "the six kinds a field can be, on a field" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "field-kinds", kindsPage(ctx), .Hover, []);
}
