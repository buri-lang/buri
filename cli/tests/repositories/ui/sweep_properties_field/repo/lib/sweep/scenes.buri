            cell("50%", subject(ctx, [.Width(.Percent(50.0))], "Ada")),
            cell("full", subject(ctx, [.Width(.Full)], "Ada")),
            cell("auto", subject(ctx, [.Width(.Auto)], "Ada")),
        ]),
        band("Height", 145, [
            cell("10px", subject(ctx, [.Height(.Px(10))], "Ada")),
            cell("40px", subject(ctx, [.Height(.Px(40))], "Ada")),
            cell("4rem", subject(ctx, [.Height(.Rem(4.0))], "Ada")),
            cell("50%", subject(ctx, [.Height(.Percent(50.0))], "Ada")),
            cell("auto", subject(ctx, [.Height(.Auto)], "Ada")),
        ]),
        band("MinWidth", 145, [
            cell("0px", subject(ctx, [.MinWidth(.Px(0))], "Ada")),
            cell("30px", subject(ctx, [.MinWidth(.Px(30))], "Ada")),
            cell("60px", subject(ctx, [.MinWidth(.Px(60))], "Ada")),
            cell("full", subject(ctx, [.MinWidth(.Full)], "Ada")),
        ]),
        band("MaxWidth", 145, [
            cell(
                "16px",
                subject(ctx, [.Width(.Full), .MaxWidth(.Px(16))], "Ada Byron"),
            ),
            cell(
                "40px",
                subject(ctx, [.Width(.Full), .MaxWidth(.Px(40))], "Ada Byron"),
            ),
            cell(
                "60px",
                subject(ctx, [.Width(.Full), .MaxWidth(.Px(60))], "Ada Byron"),
            ),
            cell("full", subject(ctx, [.Width(.Full), .MaxWidth(.Full)], "Ada Byron")),
        ]),
        band("MinHeight", 145, [
            cell("0px", subject(ctx, [.MinHeight(.Px(0))], "Ada")),
            cell("20px", subject(ctx, [.MinHeight(.Px(20))], "Ada")),
            cell("44px", subject(ctx, [.MinHeight(.Px(44))], "Ada")),
            cell("4rem", subject(ctx, [.MinHeight(.Rem(4.0))], "Ada")),
        ]),
        band("MaxHeight", 145, [
            cell(
                "8px",
                subject(
                    ctx,
                    [.Width(.Full), .MaxHeight(.Px(8))],
                    "Ada Byron counted the engine",
                ),
            ),
            cell(
                "24px",
                subject(
                    ctx,
                    [.Width(.Full), .MaxHeight(.Px(24))],
                    "Ada Byron counted the engine",
                ),
            ),
            cell(
                "60px",
                subject(
                    ctx,
                    [.Width(.Full), .MaxHeight(.Px(60))],
                    "Ada Byron counted the engine",
                ),
            ),
            cell(
                "full",
                subject(
                    ctx,
                    [.Width(.Full), .MaxHeight(.Full)],
                    "Ada Byron counted the engine",
                ),
            ),
        ]),
        band("AspectRatio", 145, [
            cell(
                "0.5",
                subject(
                    ctx,
                    [.Height(.Auto), .Width(.Px(40)), .AspectRatio(0.5)],
                    "Ada",
                ),
            ),
            cell(
                "1.0",
                subject(
                    ctx,
                    [.Height(.Auto), .Width(.Px(40)), .AspectRatio(1.0)],
                    "Ada",
                ),
            ),
            cell(
                "2.0",
                subject(
                    ctx,
                    [.Height(.Auto), .Width(.Px(40)), .AspectRatio(2.0)],
                    "Ada",
                ),
            ),
            cell(
                "3.0",
                subject(
                    ctx,
                    [.Height(.Auto), .Width(.Px(40)), .AspectRatio(3.0)],
                    "Ada",
                ),
            ),
        ]),
        band("Scroll", 145, [
            cell(
                "none",
                subject(
                    ctx,
                    [.Width(.Px(48)), .Height(.Px(22))],
                    "Ada Byron counted the engine",
                ),
            ),
            cell(
                "x",
                subject(
                    ctx,
                    [.Width(.Px(48)), .Height(.Px(22)), .Scroll(.X)],
                    "Ada Byron counted the engine",
                ),
            ),
            cell(
                "y",
                subject(
                    ctx,
                    [.Width(.Px(48)), .Height(.Px(22)), .Scroll(.Y)],
                    "Ada Byron counted the engine",
                ),
            ),
            cell(
                "both",
                subject(
                    ctx,
                    [.Width(.Px(48)), .Height(.Px(22)), .Scroll(.Both)],
                    "Ada Byron counted the engine",
                ),
            ),
        ]),
    ])
}

/// The six kinds a field can be, styled the same and at rest.
export fn kindsPage<C: Ui>(ctx: C): Node<C> {
    page([
        band("FieldKind: text, multiline, password", 145, [
            cell("text", kind(ctx, .Text)),
            cell("multiline", kind(ctx, .Multiline)),
            cell("password", kind(ctx, .Password)),
        ]),
        band("FieldKind: email, number, search", 145, [
            cell("email", kind(ctx, .Email)),
            cell("number", kind(ctx, .Number)),
            cell("search", kind(ctx, .Search)),
        ]),
    ])
}

/// One field of a given kind, over the base every subject carries.
fn kind<C: Ui>(ctx: C, of: FieldKind): Node<C> {
    ui.field(.Const("Name"), of, base([]), signal(ctx, "Ada"))
}

/// One picture: two columns of bands, one band per property.
fn page<C>(bands: [Node<C>]): Node<C> {
    ui.stack(
        [
            .Layout(.Grid([.Fraction(1), .Fraction(1)])),
            .Gap(.Px(2)),
            .Padding(.Px(4)),
            .Background(.Rgb(255, 255, 255)),
            .Foreground(.Rgb(20, 20, 20)),
            .FontSize(.Px(11)),
        ],
        bands,
    )
}

/// One property's band: its name, then a cell per value, clipped to
/// `height` so a value that grows stays inside its own row.
fn band<C>(name: Str, height: Int, cells: [Node<C>]): Node<C> {
    ui.stack(
        [
            .Height(.Px(height)),
            .Scroll(.Both),
            .Padding(.Px(3)),
            .Background(.Rgb(243, 244, 247)),
        ],
        [ui.text(.Const(name)), ui.row([.Gap(.Px(6)), .AlignCross(.Start)], cells)],
    )
}

/// One value: its label, and the primitive carrying it. The cell does
/// not stretch its children, so a box is as wide as it asked to be.
fn cell<C>(label: Str, inner: Node<C>): Node<C> {
    ui.column([.Width(.Px(72)), .Gap(.Px(1)), .AlignCross(.Start)], [
        ui.text(.Const(label)),
        inner,
    ])
}

/// The subject every cell holds: a `field`, whose styles land on the input
/// rather than on the label beside it.
fn subject<C: Ui>(ctx: C, styles: [Style], words: Str): Node<C> {
    ui.field(.Const("Name"), .Text, base(styles), signal(ctx, words))
}

/// What every subject carries before the cell's own styles, which come
/// last so the property under test wins.
fn base(styles: [Style]): [Style] {
    [
        .Background(.Rgb(206, 218, 240)),
        .Foreground(.Rgb(18, 18, 28)),
        .Padding(.Px(2)),
        .Group(styles),
    ]
}
