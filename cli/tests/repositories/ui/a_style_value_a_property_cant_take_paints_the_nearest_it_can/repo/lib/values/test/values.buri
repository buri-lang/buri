test "a negative radius" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "radius-negative", holder(.Radius(.Px(-6))), .Hover, []);
    snapshot(ctx, "radius-negative", holder(.Radius(late(ctx, .Px(-6)))), .Hover, []);
}

test "a shadow offset by auto and a percentage" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    let shadow = Shadow {
        x: .Auto,
        y: .Percent(50.0),
        blur: .Px(4),
        spread: .Full,
        color: .Rgb(0, 0, 0),
    };
    snapshot(ctx, "shadow-offsets", holder(.Shadow(shadow)), .Hover, []);
    snapshot(ctx, "shadow-offsets", holder(.Shadow(late(ctx, shadow))), .Hover, []);
}

test "an auto translate" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "translate-auto", gridded(.Translate(.Auto, .Px(4))), .Hover, []);
    snapshot(
        ctx,
        "translate-auto",
        gridded(.Translate(late(ctx, .Auto), .Px(4))),
        .Hover,
        [],
    );
}

