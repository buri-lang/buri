test "the nearest values a property takes" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "padding-negative", holder(.Padding(.Px(0))), .Hover, []);
    snapshot(ctx, "padding-auto", holder(.PaddingX(.Px(0))), .Hover, []);
    snapshot(ctx, "gap-negative", holder(.Gap(.Px(0))), .Hover, []);
    snapshot(ctx, "width-negative", holder(.Width(.Px(0))), .Hover, []);
    snapshot(ctx, "max-width-auto", holder(.Grow(0)), .Hover, []);
    snapshot(ctx, "radius-negative", holder(.Radius(.Px(0))), .Hover, []);
    snapshot(
        ctx,
        "shadow-offsets",
        holder(
            .Shadow(Shadow {
                x: .Px(0),
                y: .Px(0),
                blur: .Px(4),
                spread: .Px(0),
                color: .Rgb(0, 0, 0),
            }),
        ),
        .Hover,
        [],
    );
    snapshot(ctx, "translate-auto", gridded(.Translate(.Px(0), .Px(4))), .Hover, []);
    snapshot(ctx, "span-zero", gridded(.Span(1)), .Hover, []);
    snapshot(ctx, "shrink-negative", rowed(.Shrink(0)), .Hover, []);
    snapshot(ctx, "font-size-negative", worded(.FontSize(.Px(0))), .Hover, []);
    snapshot(ctx, "font-size-auto", worded(.FontSize(.Em(1.0))), .Hover, []);
    snapshot(ctx, "letter-spacing-auto", worded(.LetterSpacing(.Px(0))), .Hover, []);
    snapshot(ctx, "line-height-negative", worded(.LineHeight(0.0)), .Hover, []);
    snapshot(ctx, "aspect-ratio-zero", holder(.Grow(0)), .Hover, []);
    snapshot(ctx, "backdrop-negative", holder(.BackdropBlur(.Px(0))), .Hover, []);
    snapshot(
        ctx,
        "track-negative",
        holder(.Layout(.Grid([.Fraction(0), .Fraction(1)]))),
        .Hover,
        [],
    );
}
