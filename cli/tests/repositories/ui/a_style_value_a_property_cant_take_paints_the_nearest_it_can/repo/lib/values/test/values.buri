// A value a property can't take, written in place and read back from a
// signal, paints what the nearest value it can take paints. The tests that
// paint that nearest value come last, so they're the ones that record each
// golden.

from "platform/effect" import { Allocator, Ui, Watch };
from "platform/effect/testing" import { alloc, headless, observer, snapshot };
from "ui/style" import { Shadow };
from "//lib/values" import { gridded, holder, late, rowed, worded };

test "a negative padding" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "padding-negative", holder(.Padding(.Px(-4))), .Hover, []);
    snapshot(ctx, "padding-negative", holder(.Padding(late(ctx, .Px(-4)))), .Hover, []);
}

test "an auto padding" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
        Watch: observer(),
    };
    snapshot(ctx, "padding-auto", holder(.PaddingX(.Auto)), .Hover, []);
    snapshot(ctx, "padding-auto", holder(.PaddingX(late(ctx, .Auto))), .Hover, []);
}

