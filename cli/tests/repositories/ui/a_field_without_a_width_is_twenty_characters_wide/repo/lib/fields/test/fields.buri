// Each scene beside its twin: both tests of a pair compare against one
// golden. A field that names no width is as wide as a browser makes it:
// twenty of its face's average characters, and for an `<input>` what the
// face's glyph box runs past one of them. One line tall, or two for a
// textarea.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "ui/node" import * as ui;
from "ui/style" import { Style };
from "//lib/fields" import { after, named, plain };

test "a field in a row is twenty characters wide and one line tall" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "row",
        ui.stack({
            styles: [.Layout(.Row), .AlignCross(.Start)],
            children: [named(ctx, .Text, [.Background(.Rgb(255, 0, 0))]), after()],
        }),
        .Hover,
        [],
    );
}

test "the boxes laid out the plain way where the row scene puts them" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "row",
        ui.stack({
            styles: [.Layout(.Row), .AlignCross(.Start)],
            children: [plain(183, .Rem(1.2)), after()],
        }),
        .Hover,
        [],
    );
}

test "each kind of single-line field is twenty characters wide" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    let red: [Style] = [.Background(.Rgb(255, 0, 0))];
    snapshot(
        ctx,
        "kinds",
        ui.stack({
            styles: [.Layout(.Column), .AlignCross(.Start)],
            children: [
                named(ctx, .Password, red),
                named(ctx, .Email, red),
                named(ctx, .Number, red),
                named(ctx, .Search, red),
            ],
        }),
        .Hover,
        [],
    );
}

test "the boxes laid out the plain way where the kinds scene puts them" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "kinds",
        ui.stack({
            styles: [.Layout(.Column), .AlignCross(.Start)],
            children: [
                plain(183, .Rem(1.2)),
                plain(183, .Rem(1.2)),
                plain(183, .Rem(1.2)),
                plain(183, .Rem(1.2)),
            ],
        }),
        .Hover,
        [],
    );
}

