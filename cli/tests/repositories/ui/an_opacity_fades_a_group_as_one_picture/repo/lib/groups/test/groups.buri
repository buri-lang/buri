// Each faded group beside its twin, the same picture with nothing in it
// overlapping: both tests of a pair compare against one golden, so a group
// whose overlap paints darker than the rest fails.
//
// The last two have no twin. A faded scrim's blur and a faded item's list mark
// are each pinned by a golden of their own.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "//lib/groups" import {
    blurFaded, borderFaded, borderTwin, columnFaded, columnReverseFaded,
    columnReverseTwin, columnTwin, drawingFaded, drawingTwin, fixedFaded, fixedTwin,
    gridFaded, gridTwin, iconFaded, iconTwin, imageFaded, imageTwin, layersFaded,
    layersTwin, markedFaded, pinnedFaded, pinnedTwin, rowFaded, rowReverseFaded,
    rowReverseTwin, rowTwin, strokeFaded, strokeTwin,
};

test "two overlapping squares in a faded layer stack read as one grey" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "layers", layersFaded(), .Checked, []);
}

test "the same grey as a faded layer stack with nothing overlapping" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "layers", layersTwin(), .Checked, []);
}

