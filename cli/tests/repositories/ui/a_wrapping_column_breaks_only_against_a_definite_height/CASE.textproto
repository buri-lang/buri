# A column that wraps, beside a twin that lays its boxes out the plain way
# (#162). Both tests of a pair compare against one golden. A browser breaks a
# wrapping column into a second track only against a definite height (its own
# percentage of a definite parent's, stretched across a row of definite
# height, or flexed in a column of definite height below its content) or a
# maximum height, and keeps one track otherwise. Wrapping rows, and both
# directions reversed, are here too.
#
# `a_wrapping_column_breaks_only_against_a_definite_height` in
# build/repositories.rs checks that a browser puts each scene's boxes where
# its twin puts them.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "a wrapping column breaks into tracks against a definite or maximum height, and keeps one track otherwise, in the painter and in a browser"

run {
  args: ["test", "//lib/wrap", "--force"]
  exit: 0
  golden: "pass.txt"
}

path { path: "lib/wrap/test/__snapshots__/maximum.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/maximum-reversed.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/percent.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/stretched.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/shrunk.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/content.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/grown.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/maximum-percent.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/row.diff.png"  exists: false }
path { path: "lib/wrap/test/__snapshots__/row-reversed.diff.png"  exists: false }
