test "a wrapping column in a column of definite height keeps one track" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "content",
        ui.stack({
            styles: [.Layout(.Column), .Height(.Px(90))],
            children: [
                ui.stack({
                    styles: [
                        .Layout(.Column),
                        .Wrap(true),
                        .Gap(.Px(8)),
                        .Width(.Px(88)),
                    ],
                    children: boxes(),
                }),
            ],
        }),
        .Hover,
        [],
    );
}

