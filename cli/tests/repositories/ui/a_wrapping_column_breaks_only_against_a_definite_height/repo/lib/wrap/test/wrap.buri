test "a wrapping column shrunk to a column of definite height breaks against it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "shrunk",
        ui.stack({
            styles: [.Layout(.Column), .Height(.Px(90))],
            children: [
                ui.stack({
                    styles: [
                        .Layout(.Column),
                        .Wrap(true),
                        .Gap(.Px(8)),
                        .Width(.Px(88)),
                        .Grow(1),
                        .MinHeight(.Px(0)),
                    ],
                    children: boxes(),
                }),
            ],
        }),
        .Hover,
        [],
    );
}

test "the tracks laid out the plain way where the shrunk scene puts them" {
