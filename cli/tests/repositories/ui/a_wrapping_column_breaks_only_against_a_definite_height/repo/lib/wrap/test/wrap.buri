// Each scene beside its twin: both tests of a pair compare against one
// golden. A column that wraps breaks into a second track only against a
// definite height or a maximum one, as a browser breaks it.

from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { alloc, headless, snapshot };
from "ui/node" import * as ui;
from "//lib/wrap" import { boxes, square, tracks };

test "a wrapping column with a maximum height breaks against it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "maximum",
        ui.stack({
            styles: [
                .Layout(.Column),
                .Wrap(true),
                .Gap(.Px(8)),
                .Width(.Px(88)),
                .MaxHeight(.Px(90)),
            ],
            children: boxes(),
        }),
        .Hover,
        [],
    );
}

test "the tracks laid out the plain way where the maximum scene puts them" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(ctx, "maximum", tracks(), .Hover, []);
}

test "a wrapping column reversed with a maximum height breaks against it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "maximum-reversed",
        ui.stack({
            styles: [
                .Layout(.ColumnReverse),
                .Wrap(true),
                .Gap(.Px(8)),
                .Width(.Px(88)),
                .MaxHeight(.Px(90)),
            ],
            children: boxes(),
        }),
        .Hover,
        [],
    );
}

test "the tracks laid out the plain way where the reversed scene puts them" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "maximum-reversed",
        ui.stack({
            styles: [.Layout(.Row), .Gap(.Px(8)), .AlignCross(.End), .Height(.Px(88))],
            children: [
                ui.stack({
                    styles: [.Layout(.ColumnReverse), .Gap(.Px(8))],
                    children: [square(.Rgb(255, 0, 0)), square(.Rgb(0, 0, 255))],
                }),
                ui.stack({
                    styles: [.Layout(.Column)],
                    children: [square(.Rgb(0, 160, 0))],
                }),
            ],
        }),
        .Hover,
        [],
    );
}

test "a wrapping column a whole definite height tall breaks against it" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "percent",
        ui.stack({
            styles: [.Layout(.Column), .Height(.Px(90))],
            children: [
                ui.stack({
                    styles: [
                        .Layout(.Column),
                        .Wrap(true),
                        .Gap(.Px(8)),
                        .Width(.Px(88)),
                        .Height(.Percent(100.0)),
                    ],
                    children: boxes(),
                }),
            ],
        }),
        .Hover,
        [],
    );
}

test "the tracks laid out the plain way where the percent scene puts them" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "percent",
        ui.stack({
            styles: [.Layout(.Column), .Height(.Px(90))],
            children: [tracks()],
        }),
        .Hover,
        [],
    );
}

