// A box 40px wide and 20px tall painted `colour`, with `extra` styles.
fn half<C>(colour: Color, extra: [Style]): Node<C> {
    ui.stack({
        styles: [.Width(.Px(40)), .Height(.Px(20)), .Group(extra), .Background(colour)],
        children: [],
    })
}

test "a wrapping column under a maximum shrinks in a column of definite height and breaks against what it gets" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "capped-shrunk",
        ui.stack({
            styles: [.Layout(.Column), .Height(.Px(60))],
            children: [
                ui.stack({
                    styles: [
                        .Layout(.Column),
                        .Wrap(true),
                        .Gap(.Px(8)),
                        .Width(.Px(136)),
                        .MaxHeight(.Px(90)),
                        .MinHeight(.Px(0)),
                    ],
                    children: boxes(),
                }),
            ],
        }),
        .Hover,
        [],
    );
}

test "the boxes in a row the plain way where the capped-shrunk scene puts them" {
    let ctx = context {
        Allocator: alloc(),
        Ui: headless(),
    };
    snapshot(
        ctx,
        "capped-shrunk",
        ui.stack({
            styles: [.Layout(.Column), .Height(.Px(60))],
            children: [
                ui.stack({ styles: [.Layout(.Row), .Gap(.Px(8))], children: boxes() }),
            ],
        }),
        .Hover,
        [],
    );
}

