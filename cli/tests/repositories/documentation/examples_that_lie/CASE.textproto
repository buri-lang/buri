# A page whose examples claim what their code doesn't do: one that
# doesn't compile, a `fail` that compiles, a transcript that's wrong, a
# lint that isn't reported, a package or repository that isn't there.
# The blocks that do what they claim pass beside them.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "an example that does not do what its page says fails `buri docs test`"

run {
  args: ["docs", "test", "page.md"]
  exit: 1
  golden: "test.txt"
}
