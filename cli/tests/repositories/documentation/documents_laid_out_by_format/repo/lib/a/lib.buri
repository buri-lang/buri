//! A library whose comments show code.
//!
//! ```buri
//! export fn   first(): I64 { 1 }
//! ```

/// Twice what it's given.
///
/// ```buri
/// # from "core/io" import * as io;
/// export fn  four(): I64 {
///     2 * 2
/// }
/// ```
///
/// ```buri
/// export fn five(): I64 {
///     5
/// }
/// ```
///
/// ```buri
/// # export fn six(): I64 {
/// let   x = 6;
/// # let z = 2;
/// x
/// # }
/// ```
export fn double(n: I64): I64 {
    n * 2
}
