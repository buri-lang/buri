// `Hermetic`'s `Fs` is `data()`, so the declared golden files are there and
// nothing else on disk is. `test/golden/absent.txt` is declared and missing,
// which the in-memory filesystem reports as empty.

from "//lib/report/lib.buri" import { footer, render, trailer };
from "core/fs/lib.buri" import * as fs;
from "core/testing/assert/lib.buri" import * as assert;
from "core/testing/context/lib.buri" import { Hermetic };

test "renders the statement" {
  let ctx = Hermetic();
  let want = assert.ok(fs.readText(ctx, "test/golden/statement.txt"));
  assert.eq(render(), want);
}

// The expected side here is a literal that happens to be byte-for-byte the
// contents of test/golden/notdata.txt, which `test.data` does not list. If
// `--accept` went by contents rather than by the declaration, this is the
// assertion that would rewrite a file nobody declared.
test "the trailer is not a golden file" {
  assert.eq(trailer(), "2 entries");
}

// And the expected side here is what `test/golden/absent.txt` would hold if it
// existed, which is nothing. If `--accept` wrote it, this assertion would pass
// on the next run — so the recording of that run is what says it did not.
test "the footer has no golden file to write" {
  assert.eq(footer(), "");
}
