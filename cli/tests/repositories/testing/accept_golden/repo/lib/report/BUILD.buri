# `data` is the whole of what the runner's in-memory `Fs` contains, and it is
# also the whole of what `--accept` may rewrite.
#
# Two of the three golden paths in this package are deliberately awkward:
# `notdata.txt` exists on disk and is not declared here, and `absent.txt` is
# declared here and does not exist on disk. Each one is a bound on `--accept`
# that a wrong implementation would cross.
library {
    sources: ["render.buri"]

    test {
        sources: ["test/render.buri"]
        data: ["test/golden/statement.txt", "test/golden/absent.txt"]
    }
}
