# TESTING.md:360-368. Rewriting a golden file is not something a hermetic
# action may do, so `buri test --accept` is a separate mode: it runs the suites
# outside the cache, writes the actual value into the declared `data` files
# whose contents an assertion expected, prints a diff for each, and leaves
# everything else about the run unchanged — including the verdict, because what
# `--accept` changes is the source tree and not whether the tests passed.
#
# Three bounds, and each one is checked by something that would fail loudly if
# it were crossed:
#
#   * only a file listed in `data`. `notdata.txt` holds exactly the string the
#     second assertion expected, so an implementation that matched on contents
#     rather than on the declaration would rewrite it. It is recorded
#     afterwards, unchanged.
#   * never a file that does not exist. `absent.txt` *is* declared, and is not
#     on disk; the in-memory filesystem reports it as empty, and the third
#     assertion expects exactly that. If `--accept` created it, that assertion
#     would pass on the last run of this case — so the last recording is what
#     says it did not.
#   * everything else unchanged. The `--accept` run still fails and still
#     reports both failures, and the ordinary run after it passes the one test
#     whose golden moved and no others.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "buri test --accept rewrites the declared golden a failing assertion expected, prints the diff, creates nothing, touches nothing undeclared, and leaves the verdict alone"

# The stale golden, and the failure format the spec's `Running` section shows:
# target, file, test name, actual, expected, source location.
run {
  args: ["test", "//lib/report", "--force"]
  exit: 1
  golden: "stale.txt"
  stream: OUT
}

run {
  args: ["test", "//lib/report", "--accept"]
  exit: 1
  golden: "accept.txt"
  stream: OUT
}

file {
  path: "lib/report/test/golden/statement.txt"
  golden: "statement.txt"
}

file {
  path: "lib/report/test/golden/notdata.txt"
  golden: "notdata.txt"
}

# One test passes now, and the two that were about files `--accept` may not
# write still fail — in the same words, because nothing about them moved.
run {
  args: ["test", "//lib/report", "--force"]
  exit: 1
  golden: "after.txt"
  stream: OUT
}
