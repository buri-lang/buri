from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/lazily" import { render };

test "a lazily loaded builder answers what it always did" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(render(ctx, 12), "report over 12 rows");
}
