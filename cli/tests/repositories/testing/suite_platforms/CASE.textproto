# TAGS.md:266-291. A suite that must run in more than one place lists the
# backends it runs on, one run each — and the platform a run builds must be one
# the target admits. Asking for a run the target's tags rule out is an error,
# not a skip, which is the whole difference between a policy and a preference:
# a skip would let a suite quietly stop covering the backend it was written
# for.
#
# `NATIVE` runs on this machine's own variant, so the platform the diagnostic
# names is `native` on every host.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "test { backends: [...] } runs the suite once per backend; a backend the target does not admit is an error rather than a skip"

run {
  args: ["test", "//lib/codec", "--force"]
  exit: 0
  golden: "js.txt"
  stream: OUT
}

# `NATIVE` is not in `browser`'s whitelist, so it is not the suite's to ask
# for. The diagnostic is the target's, because the restriction is the
# target's.
edit {
  file: "lib/codec/BUILD.buri"
  replace: "backends: [JS]"
  with: "backends: [JS, NATIVE]"
}

run {
  args: ["test", "//lib/codec", "--force"]
  exit: 1
  golden: "not_admitted.txt"
  stream: ERR
}

run {
  args: ["test", "//lib/codec", "--force", "--error-format=json"]
  exit: 1
  golden: "not_admitted.json"
  stream: ERR
}

# Now the tag admits it, and the suite runs on both backends.
edit {
  file: "lib/codec/BUILD.buri"
  replace: "    tags: [\"browser\"]\n"
  with: ""
}

run {
  args: ["test", "//lib/codec", "--force"]
  exit: 0
  golden: "both.txt"
  stream: OUT
}
