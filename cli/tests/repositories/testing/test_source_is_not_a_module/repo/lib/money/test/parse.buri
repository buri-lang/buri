// A private helper, which is the right answer while only one suite wants it.
// The moment a second one does, it belongs in a library listed in
// `test.dependencies` — not in a file the other suite imports.

from "//lib/money/lib.buri" import { fromCents };
from "core/testing/assert/lib.buri" import * as assert;

fn digits(n: I64): I64 { n }

test "parses text" {
  assert.eq(fromCents(digits(1905)), 1905);
}
