# TESTING.md:342-347. `test { timeout_seconds: N }` bounds the whole suite, not
# one test: when it fires the run is killed, so no test in it has a result and
# the diagnostic says so rather than picking one to blame.
#
# Nothing in a test blocks on I/O, so the only way to run forever is a loop
# with no exit — which is what `spin` is, and what the edit at the bottom takes
# away.
#
# **The two halves ask opposite things of a budget, so each declares its own.**
# The runner's clock is wall time from the spawn of the suite's process, with
# no reading of processor time or run state to tell a starved suite from a
# stuck one. The half that must be *exceeded* therefore runs a program that
# never finishes: the kill is certain and the elapsed time irrelevant, which
# leaves its number free to be small. The half that must *finish* needs the
# reverse — a bound so far above its own work that no scheduling delay reaches
# it, because under a wall clock that margin is the whole of what makes the
# pass deterministic. Sharing one number cost this case a flake: the finishing
# half spent 5.3s of a 5s budget starting a binary that then ran one
# comparison, with three test binaries going at once.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a suite that runs past its declared timeout_seconds is killed and reported as the suite's failure, not one test's"

run {
  args: ["test", "//lib/spin", "--force"]
  exit: 1
  golden: "timeout.txt"
  stream: ERR
}

# The negative twin: a base case, and a declaration that lets it through.
edit {
  file: "lib/spin/spin.buri"
  replace: "export fn spin(n: I64): I64 {\n    spin(n + 1)\n}"
  with: "export fn spin(n: I64): I64 {\n    if (n == 0) { 0 } else { spin(n - 1) }\n}"
}

# Ten minutes for one comparison — a bound, not a measurement. Four orders of
# magnitude above the work and above anything a machine charges to start a
# process, so the only run that reaches it is one that stopped.
edit {
  file: "lib/spin/BUILD.buri"
  replace: "timeout_seconds: 1"
  with: "timeout_seconds: 600"
}

run {
  args: ["test", "//lib/spin", "--force"]
  exit: 0
  golden: "clean.txt"
  stream: OUT
}
