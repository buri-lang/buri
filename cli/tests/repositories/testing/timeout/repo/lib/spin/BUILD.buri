# One second, because the suite below never finishes. `spin` is a loop with no
# exit, so the runner kills it whatever this number is, and the number only
# decides how long the case waits for a verdict it already knows.
#
# The twin at the bottom of `CASE.textproto` has the opposite job and raises
# this rather than reusing it: the budget is wall time from the spawn
# (`commands::test::execute`), so a suite that must *finish* inside one needs a
# bound no loaded machine can reach — and a bound nothing can reach is one this
# half could never exceed. One number cannot do both jobs. It used to try, and
# three test binaries at once made the finishing half miss five seconds by
# three tenths.
library {
    sources: ["spin.buri"]

    test {
        sources: ["test/spin.buri"]
        timeout_seconds: 1
    }
}
