from "core/json" import * as json;
from "core/json" import { DecodeError, FromJson, Json };
from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };

derive Equal, Show, FromJson for Point;
struct Point {
    x: Int,
    y: Int,
}

test "a point is read back from its JSON" {
    let ctx = context {
        Allocator: alloc(),
    };
    let read: Result<Point, DecodeError> = json.decode(
        ctx,
        json.parse(ctx, "{\"x\":1,\"y\":2}").withDefault(Json.Null),
    );
    assert.equal(read.show(ctx), ".Ok(Point { x: 1, y: 2 })");
}
