# A long JavaScript suite reports every test once, and the failures in the
# order the tests are written.
#
# Tests 02 and 03 are next to each other and 60 is the last: a report out of
# order could put 03 before 02, and one that lost records would count fewer
# than sixty.

# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a long JavaScript suite reports every test once, in source order"

run {
  args: ["test", "//lib/count", "--force"]
  exit: 1
  golden: "fail.txt"
  stream: OUT
}

# The negative twin: the library made right, so all sixty pass.
edit {
  file: "lib/count/count.buri"
  replace: "if (n == 2 || n == 3 || n == 60) { n } else { n * 2 }"
  with: "n * 2"
}

run {
  args: ["test", "//lib/count", "--force"]
  exit: 0
  golden: "pass.txt"
  stream: OUT
}
