// A suite whose values come from `core/host/testing`'s doubles, run by
// `buri test` — which is what puts a linked test binary under the runtime's
// heap audit, so a block this suite drops on the floor is an exit status
// rather than nothing at all.
//
// Three blocks, one shape each, and none of them is about the doubles: they are
// the three ways `middle::rc` used to lose a block a program was still holding,
// written here through the values a test source actually gets them from.

from "core/effect" import { Allocator, Environment };
from "core/env" import * as environment;
from "core/fs" import * as fs;
from "core/fs" import { FileSystemRead, FileSystemWrite };
from "core/host/testing" import { alloc, env, fs as memory, renameFile };
from "core/path" import * as path;
from "core/testing/assert" import * as assert;
from "//lib/ledger" import { empty, folded };

// A value a double answered with, discarded by a binding that names nothing.
test "a read whose answer the test throws away" {
    let disk = memory().files([("a", "A")]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: disk,
    };
    let _ = assert.ok(fs.readText(ctx, path.of(ctx, "a")));
    assert.equal(assert.ok(disk.read("a")), "A");
}

// A `?` that leaves `core/fs`'s `writeAtomic` with the temporary path it built
// still in hand.
test "an atomic write whose rename the plan fails" {
    let disk = memory()
        .files([("db", "old")])
        .faults([renameFile("db.tmp", "db").fails(.CrossDevice)]);
    let ctx = context {
        Allocator: alloc(),
        FileSystemRead: disk,
        FileSystemWrite: disk,
    };
    assert.equal(assert.err(fs.writeAtomic(ctx, path.of(ctx, "db"), [1])), .CrossDevice);
    assert.equal(assert.ok(fs.readText(ctx, path.of(ctx, "db"))), "old");
}

// The argument strings a double answered with, folded through a `..acc` update
// that replaces the list it grew out of.
test "the arguments folded into an accumulator" {
    let ctx = context {
        Allocator: alloc(),
        Environment: env().withArguments(["one", "two", "three"]),
    };
    let end = folded(ctx, environment.arguments(ctx), 0, empty());
    assert.equal(end.words.length(), 3);
    assert.equal(end.last, "three");
}
