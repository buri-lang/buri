from "core/effect" import { Allocator };
from "core/host/testing" import { alloc };
from "core/testing/assert" import * as assert;
from "//lib/astbug" import { roundTrip };

test "an alias round trips" {
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(roundTrip(ctx, "export type Id = Int;\n"), "export type Id = Int;\n");
}
