# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a `//!` written below a declaration is a mistake between declarations rather than inside one, so buri format leaves the whole file as written and --check fails, while buri build says the module doc must come first"

run {
  args: ["format"]
  exit: 0
  golden: "format.txt"
}

file {
  path: "lib/notes/lib.buri"
  golden: "lib.buri"
}

run {
  args: ["format", "--check"]
  exit: 1
  golden: "check.txt"
}

run {
  args: ["build", "//lib/notes"]
  exit: 1
  golden: "build.txt"
}
