//! A generator whose shape is whatever the first line of its input says.
//!
//! One tool rather than eight, because what the case is about is how the build
//! takes an answer rather than how a generator computes one: a word in
//! `mode.txt` picks the answer, and every step of the case is one edit to that
//! word.
//!
//! The modes: `two` hands back two modules, one importing the other; `noisy`
//! writes a line on standard error first; `chatty` writes two extra lines on
//! standard output ahead of the response; `late` answers and *then* exits
//! non-zero; `zero` hands back no modules at all; `shadow`, `surface` and
//! `taken` each name a module something else already names.

from "core/effect" import { Alloc, Stderr, Stdin, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/json" import * as json;
from "core/json" import { Json };
from "core/list" import * as list;

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stderr: host.stderr,
        Stdin: host.stdin,
        Stdout: host.stdout,
    };
    let line = io.readLine(ctx).okOr("the generator was handed no request")?;
    let request = json.parse(ctx, line).mapErr(fn(_e) => "the request is not JSON")?;
    let inputs = allInputs(ctx, request).okOr("the request names no input list")?;
    let mode = modeOf(inputs);
    let _ = noise(ctx, mode)?;
    let _ = io
        .println(ctx, "${json.stringify(ctx, respond(ctx, mode))}")
        .mapErr(fn(_e) => "could not write the response")?;
    if (mode == "late") {
        .Err("the generator answered and then changed its mind")
    } else {
        .Ok(())
    }
}

/// What the tool says on its way to answering.
fn noise<C: Stderr + Stdout>(ctx: C, mode: Str): Result<(), Str> {
    if (mode == "noisy") {
        io
            .eprintln(ctx, "the generator has something to say")
            .mapErr(fn(_e) => "stderr")
    } else if (mode == "chatty") {
        let _ = io
            .println(ctx, "a line the tool wrote before its answer")
            .mapErr(fn(_e) => "stdout")?;
        io.println(ctx, "").mapErr(fn(_e) => "stdout")
    } else {
        .Ok(())
    }
}

/// The entry with no inputs is handed an empty list, and answers `none`.
fn modeOf(inputs: [(Str, Str)]): Str {
    match (inputs.get(0)) {
        .Some(first) => first.1.trim(),
        .None => "none",
    }
}

fn respond<C: Alloc>(ctx: C, mode: Str): Json {
    .Object([
        ("modules", .Array(modules(ctx, mode))),
        ("diagnostics", .Array(list.empty())),
    ])
}

fn modules<C: Alloc>(ctx: C, mode: Str): [Json] {
    if (mode == "none") {
        [wrote("nothing", "export let nothing: Int = 0;\n")]
    } else if (mode == "zero") {
        list.empty()
    } else {
        pair(ctx).concat(ctx, extra(mode))
    }
}

/// The two modules every mode but `zero` and `none` hands back: `right` imports
/// `left`, which is one generated module reaching another.
fn pair<C: Alloc>(ctx: C): [Json] {
    let importing = "from \"//lib/wire/left\" import { leftValue };\n\n".concat(
        ctx,
        "export let rightValue: Int = leftValue * 2;\n",
    );
    [wrote("left", "export let leftValue: Int = 7;\n"), wrote("right", importing)]
}

/// A third module, named after something else, for the three collisions.
fn extra(mode: Str): [Json] {
    if (mode == "shadow") {
        [wrote("spare.buri", "export let spare: Int = 99;\n")]
    } else if (mode == "surface") {
        [wrote("lib.buri", "export let spare: Int = 99;\n")]
    } else if (mode == "taken") {
        [wrote("nothing", "export let nothing: Int = 99;\n")]
    } else {
        list.empty()
    }
}

fn wrote(name: Str, text: Str): Json {
    .Object([
        ("name", .Str(name)),
        ("text", .Str(text)),
        ("anchors", .Array(list.empty())),
    ])
}

fn allInputs<C: Alloc>(ctx: C, request: Json): Option<[(Str, Str)]> {
    field(request, "inputs")
        .andThen(fn(v) => asArray(v))
        .andThenCtx(ctx, fn(c, items) => {
            items.mapOptionCtx(c, fn(_c, pair) => asPair(pair))
        })
}

fn field(value: Json, name: Str): Option<Json> {
    match (value) {
        .Object(fields) => fields.find(fn(f) => f.0 == name).map(fn(f) => f.1),
        _ => .None,
    }
}

fn asArray(value: Json): Option<[Json]> {
    match (value) {
        .Array(items) => .Some(items),
        _ => .None,
    }
}

fn asStr(value: Json): Option<Str> {
    match (value) {
        .Str(s) => .Some(s),
        _ => .None,
    }
}

fn asPair(value: Json): Option<(Str, Str)> {
    let items = asArray(value)?;
    let path = items.get(0).andThen(fn(v) => asStr(v))?;
    let text = items.get(1).andThen(fn(v) => asStr(v))?;
    .Some((path, text))
}
