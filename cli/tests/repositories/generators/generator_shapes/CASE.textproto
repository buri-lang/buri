# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "what a generator may hand back and what it may not: no modules, two of them with one importing the other, an entry with no inputs at all, a tool that crashes before answering — and the three names a generated module is not allowed to take"

# Two modules from one entry, `right` importing `left`; a second entry with no
# inputs at all, whose module is `nothing`; and a hand-written source beside
# them. One program reads all four.
run {
  args: ["run", "//cmd/app"]
  exit: 0
  golden: "two.txt"
}

# A tool that stops before it answers is reported where the entry is written,
# and the rule has no modules from it.
edit {
  file: "lib/wire/mode.txt"
  replace: "two"
  with: "crash"
}

run {
  args: ["build", "//lib/wire"]
  exit: 1
  golden: "crash.txt"
}

# A generator that produced no modules leaves nothing to import, and the import
# says so where it is written — never an empty module that resolves to nothing.
edit {
  file: "lib/wire/mode.txt"
  replace: "crash"
  with: "zero"
}

run {
  args: ["build", "//lib/wire"]
  exit: 1
  golden: "zero.txt"
}

# A generated module may not take a source file's name. The file wins, so
# `spare` still means what `spare.buri` says.
edit {
  file: "lib/wire/mode.txt"
  replace: "zero"
  with: "shadow"
}

run {
  args: ["run", "//cmd/app"]
  exit: 1
  golden: "shadow.txt"
}

# `lib.buri` above all: a library's whole public surface, which a generator that
# took it over would decide.
edit {
  file: "lib/wire/mode.txt"
  replace: "shadow"
  with: "surface"
}

run {
  args: ["run", "//cmd/app"]
  exit: 1
  golden: "surface.txt"
}

# And the same rule between two entries of one rule: the first to name it keeps
# it, and the second is reported where it is written.
edit {
  file: "lib/wire/mode.txt"
  replace: "surface"
  with: "taken"
}

run {
  args: ["run", "//cmd/app"]
  exit: 1
  golden: "taken.txt"
}

# And back. Five failures in a row leave nothing behind: the tool answers, the
# rule's previous answer goes with it, and the program runs again.
edit {
  file: "lib/wire/mode.txt"
  replace: "taken"
  with: "two"
}

run {
  args: ["run", "//cmd/app"]
  exit: 0
  golden: "recovered.txt"
}
