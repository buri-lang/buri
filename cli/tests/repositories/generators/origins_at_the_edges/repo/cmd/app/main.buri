from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//cmd/app/units" import { edge };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    io.println(ctx, "${edge}").mapErr(fn(_e) => "could not write")
}
