# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "what a `generators` entry may name and what it may not: a bare built-in name, no tool at all, a tool this toolchain does not ship, a label that is no tool rule, and an input that is not there"

# The shape everything below is one edit away from.
run {
  args: ["run", "//cmd/app"]
  exit: 0
  golden: "clean.txt"
}

# A generator *is* its tool, so an entry with none names nothing to run.
edit {
  file: "lib/wire/BUILD.buri"
  replace: "{ tool: \"proto\", inputs: [\"point.proto\"] },"
  with: "{ inputs: [\"point.proto\"] },"
}

# Exit 2, not 1: a build file that does not read is a bad invocation rather
# than code that does not compile (CLI.md).
run {
  args: ["build", "//lib/wire"]
  exit: 2
  golden: "no_tool.txt"
}

# A name that is not a `//label` names a tool the toolchain ships: `json`,
# `proto` and `textproto`. Exit 2, as for any build file naming nothing.
edit {
  file: "lib/wire/BUILD.buri"
  replace: "{ inputs: [\"point.proto\"] },"
  with: "{ tool: \"std/codegen/thrift\", inputs: [\"point.proto\"] },"
}

run {
  args: ["build", "//lib/wire"]
  exit: 2
  golden: "not_shipped.txt"
}

# A `//label` names a `tool` rule. A library is a target and not a program, so
# it is refused where a tool that does not exist would be.
edit {
  file: "lib/wire/BUILD.buri"
  replace: "{ tool: \"std/codegen/thrift\", inputs: [\"point.proto\"] },"
  with: "{ tool: \"//lib/wire\", inputs: [\"point.proto\"] },"
}

run {
  args: ["build", "//lib/wire"]
  exit: 2
  golden: "not_a_tool.txt"
}

# An input is a declared source like any other: no globs, and a path that names
# nothing is `unknown-source` with the field it was written in.
edit {
  file: "lib/wire/BUILD.buri"
  replace: "{ tool: \"//lib/wire\", inputs: [\"point.proto\"] },"
  with: "{ tool: \"proto\", inputs: [\"gone.proto\"] },"
}

run {
  args: ["build", "//lib/wire"]
  exit: 1
  golden: "no_input.txt"
}
