# Testing or building one target runs the generators it reads, and no others.
#
# `//lib/wire` generates a module with a tool of this repository's own,
# `//tools/gen`, and nothing `//lib/plain` builds or tests reads it. So
# `buri test //lib/plain` and `buri build //lib/plain` never build that tool:
# its program, which `buri` compiles into `.buri/out/tools` the first time a
# command runs it, is not there afterwards. `//...` reads everything, and the
# negative twin at the bottom shows the same command building the tool once it
# tests `//lib/wire` too.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "testing or building one target runs only the generators it reads"

run {
  args: ["test", "//lib/plain"]
  exit: 0
  golden: "plain.txt"
}

path {
  path: ".buri/out/tools"
  exists: false
}

run {
  args: ["build", "//lib/plain"]
  exit: 0
}

path {
  path: ".buri/out/tools"
  exists: false
}

# The negative twin: the whole repository reads `//lib/wire`'s module, so its
# tool is built and run.
run {
  args: ["test", "//..."]
  exit: 0
  golden: "everything.txt"
}

path {
  path: ".buri/out/tools"
  exists: true
}
