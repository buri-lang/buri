//! A generator: one line of JSON in, one line of JSON out.
//!
//! It reads `name value` a line and writes a module declaring each name as an
//! exported `Int`. A line it cannot read is a diagnostic pointing at that line
//! in the input; inputs that declare nothing between them are a diagnostic with
//! no origin at all, which lands on the `generators` entry instead.
//!
//! `main` names `Alloc`, `Stdin` and `Stdout` and nothing else, which is what
//! makes what it writes a function of what it was handed.

from "core/effect" import { Alloc, Stdin, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/json" import * as json;
from "core/json" import { Json };
from "core/list" import * as list;
from "core/str" import * as str;

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdin: host.stdin,
        Stdout: host.stdout,
    };
    let line = io.readLine(ctx).okOr("the generator was handed no request")?;
    let request = json.parse(ctx, line).mapErr(fn(_e) => "the request is not JSON")?;
    let inputs = allInputs(ctx, request).okOr("the request names no input")?;
    io
        .println(ctx, "${json.stringify(ctx, respond(ctx, inputs))}")
        .mapErr(fn(_e) => "could not write the response")
}

/// One declaration read off one line: what to write, and where it came from.
struct Read {
    file: Str,
    text: Str,
    start: Int,
    end: Int,
}

fn respond<C: Alloc>(ctx: C, inputs: [(Str, Str)]): Json {
    let reads = inputs.mapCtx(ctx, fn(c, i) => readsOf(c, i.0, i.1)).flatten(ctx);
    let source = reads.mapCtx(ctx, fn(_c, r) => r.text).join(ctx, "");
    let bad = inputs.mapCtx(ctx, fn(c, i) => badLines(c, i.0, i.1)).flatten(ctx);
    .Object([
        (
            "modules",
            .Array([
                .Object([
                    ("name", .Str("units")),
                    ("text", .Str(source)),
                    ("anchors", .Array(anchorsOf(ctx, reads))),
                ]),
            ]),
        ),
        ("diagnostics", .Array(bad.concat(ctx, nothingDeclared(ctx, reads)))),
    ])
}

fn readsOf<C: Alloc>(ctx: C, path: Str, text: Str): [Read] {
    text.lines(ctx).filterMapCtx(ctx, fn(c, line) => declaration(c, path, text, line))
}

/// One `export let` per readable line, and where in the input it was written.
fn declaration<C: Alloc>(ctx: C, path: Str, whole: Str, line: Str): Option<Read> {
    let trimmed = line.trim();
    let split = trimmed.splitOnce(" ")?;
    let value = split.1.trim().toInt()?;
    let start = whole.indexOf(trimmed)?;
    .Some(Read {
        file: path,
        text: str.format(ctx, "export let ${split.0}: Int = ${value};\n"),
        start: start,
        end: start + trimmed.len(),
    })
}

/// One anchor per declaration: its region of the generated text, against the
/// line of the input it came from. A region starts where everything printed
/// before it ended.
///
/// One fold carrying a running offset, rather than re-measuring at each index
/// what was printed before it. Linear instead of quadratic, shorter to read,
/// and it never slices a list grown by `push` — which is the shape `slice`
/// miscompiles on today.
fn anchorsOf<C: Alloc>(ctx: C, reads: [Read]): [Json] {
    reads.foldCtx(
        ctx,
        fn(c, acc: (Int, [Json]), r) => {
            (acc.0 + r.text.len(), acc.1.push(c, anchor(r, acc.0)))
        },
        (0, list.empty()),
    ).1
}

fn anchor(r: Read, start: Int): Json {
    .Object([
        ("start", .Num(start.toF64())),
        ("end", .Num((start + r.text.len()).toF64())),
        ("file", .Str(r.file)),
        ("span", span(r.start, r.end)),
    ])
}

fn span(start: Int, end: Int): Json {
    .Object([("start", .Num(start.toF64())), ("end", .Num(end.toF64()))])
}

/// A line that is not `name value`, reported where it is written.
fn badLines<C: Alloc>(ctx: C, path: Str, text: Str): [Json] {
    text
        .lines(ctx)
        .filterMapCtx(ctx, fn(c, line) => {
            let trimmed = line.trim();
            if (trimmed.isEmpty() || declaration(c, path, text, line).isSome()) {
                .None
            } else {
                let start = text.indexOf(trimmed).withDefault(0);
                .Some(
                    diagnostic(
                        "units-unreadable-line",
                        str.format(c, "`${trimmed}` is not `name value`"),
                        .Object([
                            ("file", .Str(path)),
                            ("span", span(start, start + trimmed.len())),
                        ]),
                    ),
                )
            }
        })
}

/// Inputs that declare nothing between them. There is no line to point at, so
/// the diagnostic carries no origin and lands on the `generators` entry.
fn nothingDeclared<C: Alloc>(ctx: C, reads: [Read]): [Json] {
    if (reads.isEmpty()) {
        [
            diagnostic(
                "units-declares-nothing",
                str.format(ctx, "no input declares a unit"),
                .Null,
            ),
        ]
    } else {
        list.empty()
    }
}

fn diagnostic(code: Str, message: Str, origin: Json): Json {
    .Object([
        ("code", .Str(code)),
        ("message", .Str(message)),
        ("note", .Null),
        ("fix", .Null),
        ("origin", origin),
    ])
}

fn allInputs<C: Alloc>(ctx: C, request: Json): Option<[(Str, Str)]> {
    field(request, "inputs")
        .andThen(fn(v) => asArray(v))
        .andThenCtx(ctx, fn(c, items) => {
            items.mapOptionCtx(c, fn(_c, pair) => asPair(pair))
        })
}

fn field(value: Json, name: Str): Option<Json> {
    match (value) {
        .Object(fields) => fields.find(fn(f) => f.0 == name).map(fn(f) => f.1),
        _ => .None,
    }
}

fn asArray(value: Json): Option<[Json]> {
    match (value) {
        .Array(items) => .Some(items),
        _ => .None,
    }
}

fn asStr(value: Json): Option<Str> {
    match (value) {
        .Str(s) => .Some(s),
        _ => .None,
    }
}

fn asPair(value: Json): Option<(Str, Str)> {
    let items = asArray(value)?;
    let path = items.get(0).andThen(fn(v) => asStr(v))?;
    let text = items.get(1).andThen(fn(v) => asStr(v))?;
    .Some((path, text))
}
