from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//lib/wire" import { probeGenerated, probeTwin };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };
    let a = probeGenerated(ctx, 7);
    let b = probeTwin(ctx, 7);
    let c = probeGenerated(ctx, 1);
    let d = probeTwin(ctx, 1);
    io
        .println(ctx, "${a} ${b} ${c} ${d} same=${a == b && c == d}")
        .mapErr(fn(_e) => "could not write to standard output")
}
