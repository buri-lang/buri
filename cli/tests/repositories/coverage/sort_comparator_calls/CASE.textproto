# `buri test --coverage=mcdc`: what a sort's comparator covered, whichever
# backend runs it. An engine's sort may call the comparator a different number
# of times for the same list from one run to the next, as JavaScript's does
# while its compiler warms up, so the hit counts in `lcov.info` are the
# engine's. Which outcomes happened is the suite's: every run shows the same
# branches and conditions, `rank`'s `.Equal` never taken, on JavaScript with
# and without `--release` and natively.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs.

doc: "--coverage=mcdc reports the same coverage of a sort's comparator however often the engine calls it"

run {
  args: ["test", "//lib/ranking", "--coverage=mcdc", "--output=js"]
  exit: 0
  golden: "mcdc.txt"
  stream: OUT
}

run {
  args: ["test", "//lib/ranking", "--coverage=mcdc", "--output=js", "--release"]
  exit: 0
  golden: "mcdc.txt"
  stream: OUT
}

run {
  args: ["test", "//lib/ranking", "--coverage=mcdc"]
  exit: 0
  golden: "mcdc.txt"
  stream: OUT
}
