from "core/testing/assert" import * as assert;
from "platform/effect" import { Allocator };
from "platform/effect/testing" import { alloc };
from "//lib/d" import { Box, Point, Shape };

test "points" {
    let p = Point { x: 1, y: 2 };
    assert.equal(p == Point { x: 1, y: 2 }, true);
    assert.equal(p == Point { x: 3, y: 2 }, false);
    assert.equal(p < Point { x: 1, y: 3 }, true);
}

test "shapes" {
    let p = Point { x: 1, y: 2 };
    assert.equal(Shape.Dot(p) == Shape.Dot(p), true);
    assert.equal(Shape.Line(p, p) == Shape.Empty, false);
    let ctx = context {
        Allocator: alloc(),
    };
    assert.equal(Shape.Dot(p).show(ctx), ".Dot(Point { x: 1, y: 2 })");
}

test "boxes" {
    assert.equal(Box { inner: 1, label: "a" } == Box { inner: 1, label: "b" }, false);
    assert.equal(
        Box { inner: "x", label: "a" } == Box { inner: "y", label: "a" },
        false,
    );
}
