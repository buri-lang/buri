from "core/bits" import * as bits;

let PER_ROW: Int = 4;

export fn half(n: Int): Int {
    n / 2
}

export fn column(n: Int): Int {
    n % PER_ROW
}

export fn middle<T>(items: [T]): Int {
    items.length() / 2
}

export fn rows(n: Int): Int {
    n / (PER_ROW + 1)
}

export fn pages<T>(items: [T]): Int {
    items.length() / (PER_ROW * 2 - 3)
}

export fn high(n: U64): U64 {
    bits.shiftRightU64(n, 56)
}

export fn wide<T>(items: [T]): Int {
    bits.shiftLeft(items.length(), PER_ROW * 15)
}

export fn past(n: U8): U8 {
    bits.shiftLeftU8(n, 8)
}

export fn share(n: Int, d: Int): Int {
    n / d
}

export fn spread(n: Int, d: Int): Int {
    (n + 1) / (d + 1)
}
