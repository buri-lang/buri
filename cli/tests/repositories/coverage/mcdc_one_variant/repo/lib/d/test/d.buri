from "core/testing/assert" import * as assert;
from "//lib/d" import { Stopped, Tagged };

test "stopped" {
    assert.equal(Stopped.Stopped == Stopped.Stopped, true);
}

test "tagged" {
    assert.equal(Tagged.Tagged(1, 2) == Tagged.Tagged(1, 2), true);
    assert.equal(Tagged.Tagged(1, 2) == Tagged.Tagged(3, 2), false);
    assert.equal(Tagged.Tagged(1, 2) < Tagged.Tagged(1, 3), true);
    assert.equal(Tagged.Tagged(1, 2) < Tagged.Tagged(0, 3), false);
}
