export fn sign(n: Int): Str {
    if (n < 0) { "negative" } else { "not negative" }
}

export fn abs(n: Int): Int {
    if (n < 0) { 0 - n } else { n }
}

export fn name(n: Int): Str {
    match (n) {
        0 => "zero",
        1 => "one",
        _ => "many",
    }
}

export fn plusOne(n: Option<Int>): Option<Int> {
    let k = n?;
    .Some(k + 1)
}

export fn orZero(n: Option<Int>): Int {
    n.withDefault(0)
}

export fn notBoth(a: Bool, b: Bool): Bool {
    if (!(a && b)) { true } else { false }
}

export fn farAbove(n: Int): Bool {
    if (
        n + 1000000000 + 1000000000 + 1000000000 + 1000000000 + 1000000000 + 1000000000
            > 0
    ) {
        true
    } else {
        false
    }
}

export fn guardedByMatch(n: Int, flag: Bool): Str {
    match (n) {
        0 if match (flag) {
            true => true,
            false => false,
        } => { "zero" },
        _ => "other",
    }
}
