from "core/io" import * as io;
from "core/lazy" import * as lazy;
from "core/time" import * as time;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Clock, Stdout };

fn ping<C: Allocator + Clock + Stdout>(ctx: C, n: Int): Int {
    if (n <= 0) {
        0
    } else {
        let _ = time.sleep(ctx, time.milliseconds(1));
        pong(ctx, n - 1)
    }
}

fn pong<C: Allocator + Clock + Stdout>(ctx: C, n: Int): Int {
    if (n <= 0) {
        1
    } else {
        let _ = io.println(ctx, "pong ${n}").ignore();
        ping(ctx, n - 1)
    }
}

fn waits<C: Allocator + Clock + Stdout>(ctx: C, n: Int): Int {
    let _ = time.sleep(ctx, time.milliseconds(1));
    let _ = io.println(ctx, "waited for ${n}").ignore();
    n
}

fn runsAtOnce<C: Allocator + Clock + Stdout>(ctx: C, n: Int): Int {
    n + 1
}

fn choose<C: Allocator + Clock + Stdout>(ctx: C, wait: Bool): Int {
    let f = if (wait) { waits } else { runsAtOnce };
    f(ctx, 5)
}

fn countDown<C: Allocator + Clock + Stdout>(ctx: C, n: Int): Int {
    if (n <= 0) {
        7
    } else {
        let _ = time.sleep(ctx, time.milliseconds(1));
        countDown(ctx, n - 1)
    }
}

fn start<C: Allocator + Clock + Stdout>(ctx: C, n: Int): Int {
    if (n > 100) { 0 } else { countDown(ctx, n * 2) }
}

fn depth(n: Int): Int {
    if (n == 0) { 0 } else { 1 + depth(n - 1) }
}

fn report<C: Allocator + Stdout>(ctx: C, n: Int): () {
    io.println(ctx, "depth(${n}) = ${depth(n)}").ignore()
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
        Clock: host.clock,
    };
    let _ = io.println(ctx, "ping(ctx, 4) = ${ping(ctx, 4)}").ignore();
    let _ = io.println(ctx, "choose(ctx, true) = ${choose(ctx, true)}").ignore();
    let _ = io.println(ctx, "choose(ctx, false) = ${choose(ctx, false)}").ignore();
    let _ = io.println(ctx, "start(ctx, 3) = ${start(ctx, 3)}").ignore();
    let split = lazy.load(report);
    let _ = split(ctx, 3);
    .Ok(())
}
