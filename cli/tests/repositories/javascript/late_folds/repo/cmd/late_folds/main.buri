// `0.negate() == 0` is `true` only once the backend has inlined `negate`, so
// the middle end can't fold it away first. `big` recurses, so it is never
// inlined and stays a call, which no fold may drop. `at` reads a list, so
// its answer is unknown until the program runs.

from "core/io" import * as io;
from "core/number" import * as number;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn big(n: Int): Bool {
    if (n > 1000) { big(n - 1) } else { n > 10 }
}

fn at(xs: [Int], i: Int): Int {
    match (xs.get(i)) {
        .Some(k) => k,
        .None => 0,
    }
}

fn yes(): Bool {
    0.negate() == 0
}

fn no(): Bool {
    0.negate() != 0
}

fn yesIsCall(a: Int): Bool {
    yes() == big(a)
}

fn callAndYes(a: Int): Bool {
    big(a) && yes()
}

fn callAndNo(a: Int): Bool {
    big(a) && no()
}

fn callOrNo(a: Int): Bool {
    big(a) || no()
}

fn callOrYes(a: Int): Bool {
    big(a) || yes()
}

fn pickYesYes(a: Int): Bool {
    if (big(a)) { yes() } else { yes() }
}

fn pickNoNo(a: Int): Bool {
    if (big(a)) { no() } else { no() }
}

fn pickYesNo(a: Int): Bool {
    if (big(a)) { 0.negate() == 0 } else { 0.negate() != 0 }
}

fn pickZeroes(a: Int): Int {
    if (big(a)) { 0.negate() } else { 0 }
}

fn notNotCall(a: Int): Bool {
    !(!big(a))
}

fn notLessPick(a: Int, b: Int, x: Int, y: Int): Int {
    if (!(a < b)) { x } else { y }
}

fn sharedElseCall(a: Int, b: Int, x: Int, y: Int): Int {
    if (big(a)) { if (big(b)) { x } else { y } } else { y }
}

fn sharedThenCall(t: Bool, b: Int, x: Int, y: Int): Int {
    if (t) { x } else { if (big(b)) { x } else { y } }
}

fn pickedAndYes(t: Bool, a: Int, b: Int): Bool {
    if (t) { a < b } else { a > b } && yes()
}

fn pickedCallAndYes(t: Bool, a: Int, b: Int): Bool {
    if (t) { a < b } else { big(b) } && yes()
}

fn pickedCallFirstAndYes(t: Bool, a: Int, b: Int): Bool {
    if (t) { big(b) } else { a < b } && yes()
}

fn countdown(n: Int, xs: [Int], acc: Int): Int {
    if (n <= 0) {
        acc
    } else {
        countdown(
            match (xs.get(n)) {
                .Some(k) => k,
                .None => n - 1,
            },
            xs,
            acc + n,
        )
    }
}

fn swapped(a: Int, b: Int, n: Int): Int {
    let p = (a, b);
    let q = (p.0 + 1, p.1 * 2);
    let r = (q.1, q.0);
    if (n > 1000) { swapped(a, b, n - 1) } else { r.0 * 10 + r.1 }
}

fn eighteen(): I32 {
    let z: I32 = 18;
    z.negate()
}

fn complementAndNegation(x: I32): I32 {
    ~x & x.negate()
}

fn wideAnd(): I128 {
    number.maxValue<I128>() & 5
}

fn narrowOr(): I8 {
    number.minValue<I8>() | 1
}

fn noisy<C: Allocator + Stdout>(ctx: C, n: Int): Int {
    if (n > 1000) {
        noisy(ctx, n - 1)
    } else {
        let _ = io.println(ctx, "noisy ran").ignore();
        7
    }
}

fn pick(xs: [Int], i: Int): Int {
    let v = match (xs.get(i)) {
        .Some(k) => k,
        .None => 0,
    };
    if (v > 1000) { pick(xs, i + 1) } else { v * 2 }
}

fn notANumber(n: Int): F64 {
    if (n > 1000) {
        notANumber(n - 1)
    } else {
        number.maxValue<F64>() * 2.0 - number.maxValue<F64>() * 2.0
    }
}

fn quiet<C: Allocator + Stdout>(ctx: C, n: Int): () {
    match (n) {
        1 => io.println(ctx, "one").ignore(),
        2 => io.println(ctx, "two").ignore(),
        3 => io.println(ctx, "three").ignore(),
        4 => io.println(ctx, "four").ignore(),
        _ => (),
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let xs = [20, 1, 3, 4];
    let n20 = at(xs, 0);
    let n1 = at(xs, 1);
    let n3 = at(xs, 2);
    let n4 = at(xs, 3);
    let t = n1 == 1;
    let f = n1 == 2;
    let _ = io.println(ctx, "yesIsCall(20) = ${yesIsCall(n20)}").ignore();
    let _ = io.println(ctx, "callAndYes(20) = ${callAndYes(n20)}").ignore();
    let _ = io.println(ctx, "callAndNo(20) = ${callAndNo(n20)}").ignore();
    let _ = io.println(ctx, "callOrNo(1) = ${callOrNo(n1)}").ignore();
    let _ = io.println(ctx, "callOrYes(1) = ${callOrYes(n1)}").ignore();
    let _ = io.println(ctx, "pickYesYes(1) = ${pickYesYes(n1)}").ignore();
    let _ = io.println(ctx, "pickNoNo(20) = ${pickNoNo(n20)}").ignore();
    let _ = io.println(ctx, "pickYesNo(20) = ${pickYesNo(n20)}").ignore();
    let _ = io.println(ctx, "pickZeroes(20) = ${pickZeroes(n20)}").ignore();
    let _ = io.println(ctx, "notNotCall(20) = ${notNotCall(n20)}").ignore();
    let _ = io
        .println(ctx, "notLessPick(1, 4, 3, 20) = ${notLessPick(n1, n4, n3, n20)}")
        .ignore();
    let _ = io
        .println(
            ctx,
            "sharedElseCall(20, 1, 3, 4) = ${sharedElseCall(n20, n1, n3, n4)}",
        )
        .ignore();
    let _ = io
        .println(
            ctx,
            "sharedThenCall(false, 1, 3, 4) = ${sharedThenCall(f, n1, n3, n4)}",
        )
        .ignore();
    let _ = io
        .println(ctx, "pickedAndYes(true, 1, 3) = ${pickedAndYes(t, n1, n3)}")
        .ignore();
    let _ = io
        .println(
            ctx,
            "pickedCallAndYes(false, 1, 20) = ${pickedCallAndYes(f, n1, n20)}",
        )
        .ignore();
    let _ = io
        .println(
            ctx,
            "pickedCallFirstAndYes(true, 1, 20) = ${pickedCallFirstAndYes(t, n1, n20)}",
        )
        .ignore();
    let _ = io
        .println(
            ctx,
            "countdown(3, [0, 0, 0, 1], 0) = ${countdown(n3, [0, 0, 0, n1], 0)}",
        )
        .ignore();
    let _ = io.println(ctx, "swapped(1, 3, 4) = ${swapped(n1, n3, n4)}").ignore();
    let _ = io.println(ctx, "eighteen() / 3 = ${eighteen() / 3}").ignore();
    let _ = io
        .println(ctx, "complementAndNegation(6) = ${complementAndNegation(6)}")
        .ignore();
    let _ = io.println(ctx, "wideAnd() = ${wideAnd()}").ignore();
    let _ = io.println(ctx, "narrowOr() = ${narrowOr()}").ignore();
    let _ = io
        .println(ctx, "noisy(ctx, 3) & 0 = ${noisy(ctx, 3) & 0.negate()}")
        .ignore();
    let _ = io.println(ctx, "pick(xs, 1) = ${pick(xs, 1)}").ignore();
    let _ = io.println(ctx, "notANumber(3) = ${notANumber(3)}").ignore();
    let _ = quiet(ctx, n3);
    let _ = quiet(ctx, n20);
    .Ok(())
}
