// Two equality tests on one value, joined by `&&`. Only two different
// constants rule each other out; a second variable can hold the same value.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn twoConstants(a: Int): Bool {
    a == 1 && a == 2
}

fn oneConstantTwice(a: Int): Bool {
    a == 1 && a == 1
}

fn twoValues(a: Int, b: Int): Bool {
    a == 1 && b == 2
}

fn variableFirst(a: Int, b: Int): Bool {
    a == b && a == 1
}

fn variableSecond(a: Int, b: Int): Bool {
    a == 1 && a == b
}

fn twoTexts(s: Str): Bool {
    s == "a" && s == "b"
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, "twoConstants(1) = ${twoConstants(1)}").ignore();
    let _ = io.println(ctx, "oneConstantTwice(1) = ${oneConstantTwice(1)}").ignore();
    let _ = io.println(ctx, "twoValues(1, 2) = ${twoValues(1, 2)}").ignore();
    let _ = io.println(ctx, "variableFirst(1, 1) = ${variableFirst(1, 1)}").ignore();
    let _ = io.println(ctx, "variableSecond(1, 1) = ${variableSecond(1, 1)}").ignore();
    let _ = io.println(ctx, "variableSecond(1, 2) = ${variableSecond(1, 2)}").ignore();
    let _ = io.println(ctx, "twoTexts(\"a\") = ${twoTexts("a")}").ignore();
    .Ok(())
}
