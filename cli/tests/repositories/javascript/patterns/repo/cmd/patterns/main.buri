from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

derive Equal for P;
struct P {
    x: Int,
    y: Int,
}

derive Equal for E;
enum E {
    A(Int),
    B(Int, Int),
}

fn differs(a: P, b: P): Bool {
    a != b
}

fn differsE(a: E, b: E): Bool {
    a != b
}

fn whole(p: (Int, Int)): Int {
    let all @ (a, b) = p;
    all.0 + a + b
}

fn either(e: E): Int {
    match (e) {
        .A(n) | .B(n, _) => n,
    }
}

fn eitherOne(e: E): Int {
    match (e) {
        .A(n @ 1) | .B(n @ 1, _) => n * 10,
        .A(n) | .B(_, n) => n,
    }
}

fn pick(xs: [Option<Int>], i: Int): Int {
    match (xs[i]) {
        .Some(.Some(v)) => v,
        .Some(.None) => -1,
        .None => -2,
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let xs: [Option<Int>] = [.Some(1), .None];
    let _ = io
        .println(ctx, "differs = ${differs(P { x: 1, y: 2 }, P { x: 1, y: 3 })}")
        .ignore();
    let _ = io.println(ctx, "differsE = ${differsE(.A(1), .A(1))}").ignore();
    let _ = io.println(ctx, "whole((3, 4)) = ${whole((3, 4))}").ignore();
    let _ = io.println(ctx, "either(.B(5, 6)) = ${either(.B(5, 6))}").ignore();
    let _ = io.println(ctx, "eitherOne(.A(1)) = ${eitherOne(.A(1))}").ignore();
    let _ = io.println(ctx, "eitherOne(.B(2, 7)) = ${eitherOne(.B(2, 7))}").ignore();
    let _ = io.println(ctx, "pick(xs, 0) = ${pick(xs, 0)}").ignore();
    let _ = io.println(ctx, "pick(xs, 1) = ${pick(xs, 1)}").ignore();
    let _ = io.println(ctx, "pick(xs, 5) = ${pick(xs, 5)}").ignore();
    .Ok(())
}
