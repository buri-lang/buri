# Patterns that bind a whole value and its parts, alternatives that bind the
# same names, and an index into a list of options. Debug and release both
# minify.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "patterns bind the whole and its parts, and an index into a list of options reads the option"

run {
  args: ["run", "//cmd/patterns"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}

run {
  args: ["run", "--release", "//cmd/patterns"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}
