# Matches over one value that become a `switch`: integers, floats and text,
# with a value and in statement position, and a nested match on the same
# value whose arm repeats one the outer match already took, which keeps its
# chain. Debug and release both minify.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "matches over one value become a switch only when every label is distinct"

run {
  args: ["run", "//cmd/switch_chains"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}

run {
  args: ["run", "--release", "//cmd/switch_chains"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}
