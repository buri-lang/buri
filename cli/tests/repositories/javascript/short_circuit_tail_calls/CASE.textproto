# A self tail call on the right of `&&` and `||`, inside an `if`, on
# either branch. Debug and release both minify.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a tail call under a short circuit loops on whichever branch it sits"

run {
  args: ["run", "//cmd/short_circuit_tail_calls"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}

run {
  args: ["run", "--release", "//cmd/short_circuit_tail_calls"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}
