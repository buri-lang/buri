from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn allSmall(xs: [Int], i: Int): Bool {
    i >= xs.length()
        || xs.get(i).withDefault(0) < 10
            && if (i % 2 == 0) { allSmall(xs, i + 1) } else { allSmall(xs, i + 2) }
}

fn anyBigOnOdd(xs: [Int], i: Int): Bool {
    i < xs.length()
        && (xs.get(i).withDefault(0) > 10
            || if (i % 2 == 0) { false } else { anyBigOnOdd(xs, i + 1) })
}

fn anyBigOnEven(xs: [Int], i: Int): Bool {
    i < xs.length()
        && (xs.get(i).withDefault(0) > 10
            || if (i % 2 == 0) { anyBigOnEven(xs, i + 1) } else { false })
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let small = [1, 2, 3, 4, 5];
    let big = [1, 2, 3, 40, 5];
    let _ = io.println(ctx, "allSmall(small, 0) = ${allSmall(small, 0)}").ignore();
    let _ = io.println(ctx, "allSmall(big, 0) = ${allSmall(big, 0)}").ignore();
    let _ = io.println(ctx, "anyBigOnOdd(big, 1) = ${anyBigOnOdd(big, 1)}").ignore();
    let _ = io.println(ctx, "anyBigOnOdd(big, 0) = ${anyBigOnOdd(big, 0)}").ignore();
    let _ = io.println(ctx, "anyBigOnEven(big, 0) = ${anyBigOnEven(big, 0)}").ignore();
    let _ = io
        .println(ctx, "anyBigOnEven([20], 0) = ${anyBigOnEven([20], 0)}")
        .ignore();
    .Ok(())
}
