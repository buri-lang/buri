# Booleans the minifier folds, against a comparison and against a call,
# which is never syntactically a boolean. Debug and release both minify.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "boolean folds keep what the program means, in debug and release"

run {
  args: ["run", "//cmd/boolean_folds"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}

run {
  args: ["run", "--release", "//cmd/boolean_folds"]
  exit: 0
  stream: OUT
  golden: "run.txt"
}
