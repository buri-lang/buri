// Float arithmetic the minifier folds into a constant it then has to print:
// both infinities, NaN of either sign, a number shortest in exponent form,
// a remainder by zero, which JavaScript answers and the folder leaves alone,
// a choice between `-0` and `0`, which are different values but equal ones,
// and an integer zero negated, which has no sign to carry into a float.

from "core/io" import * as io;
from "core/number" import * as number;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn huge(): F64 {
    number.maxValue<F64>() * 2.0
}

fn tiny(): F64 {
    0.0 - number.maxValue<F64>() * 2.0
}

fn notANumber(): F64 {
    number.maxValue<F64>() * 2.0 - number.maxValue<F64>() * 2.0
}

fn negatedNotANumber(): F64 {
    -(number.maxValue<F64>() * 2.0 - number.maxValue<F64>() * 2.0)
}

fn small(): F64 {
    0.000000000001 * 0.5
}

fn remainderByZero(a: F64): F64 {
    a % 0.0
}

fn bothZeroes(x: F64): Int {
    if (x == 0.0) { if (x == 0.0.negate()) { 1 } else { 2 } } else { 2 }
}

fn at(xs: [F64], i: Int): F64 {
    match (xs.get(i)) {
        .Some(x) => x,
        .None => 5.0,
    }
}

fn negatedToFloat(xs: [I32]): F64 {
    match (xs.get(0)) {
        .Some(x) => x.negate().toF64(),
        .None => 1.0,
    }
}

fn signedZero(negative: Bool): F64 {
    if (negative) { 0.0.negate() } else { 0.0 }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = io.println(ctx, "huge() = ${huge()}").ignore();
    let _ = io.println(ctx, "tiny() = ${tiny()}").ignore();
    let _ = io.println(ctx, "notANumber() = ${notANumber()}").ignore();
    let _ = io.println(ctx, "negatedNotANumber() = ${negatedNotANumber()}").ignore();
    let _ = io.println(ctx, "small() = ${small()}").ignore();
    let _ = io.println(ctx, "remainderByZero(5.0) = ${remainderByZero(5.0)}").ignore();
    let _ = io
        .println(ctx, "1 / signedZero(true) = ${1.0 / signedZero(true)}")
        .ignore();
    let _ = io
        .println(ctx, "1 / signedZero(false) = ${1.0 / signedZero(false)}")
        .ignore();
    let _ = io
        .println(ctx, "1 / negatedToFloat([0]) = ${1.0 / negatedToFloat([0])}")
        .ignore();
    let zeroes = [0.0, 0.0.negate(), 1.0];
    let _ = io.println(ctx, "bothZeroes(0.0) = ${bothZeroes(at(zeroes, 0))}").ignore();
    let _ = io.println(ctx, "bothZeroes(-0.0) = ${bothZeroes(at(zeroes, 1))}").ignore();
    let _ = io.println(ctx, "bothZeroes(1.0) = ${bothZeroes(at(zeroes, 2))}").ignore();
    .Ok(())
}
