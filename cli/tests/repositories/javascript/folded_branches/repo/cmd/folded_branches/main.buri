from "core/io" import * as io;
from "core/order" import { Order };
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn big(n: Int): Bool {
    n > 10
}

fn guarded(n: Int, m: Int): Int {
    let x = match (n) {
        k if k > m => 1,
        k if big(k) => 2,
        _ => 3,
    };
    x * 10 + n
}

fn guardedTail(n: Int, m: Int): Int {
    match (n) {
        k if k > m => guardedTail(k - 1, m),
        k if big(k) => 2,
        _ => 3,
    }
}

fn guardedPick(xs: [Int], i: Int): Int {
    let v = match (xs.get(i)) {
        .Some(k) if k > 2 => k,
        .Some(k) => k + 100,
        .None => 0,
    };
    v
}

// `0.negate() == 0` is only known once the backend has inlined `negate`,
// so each of these is a tail-call loop until then.
fn settled(n: Int): Int {
    if (0.negate() == 0) { n } else { settled(n - 1) }
}

fn settledBranch<C: Allocator + Stdout>(ctx: C, n: Int): Int {
    if (0.negate() == 0) {
        if (n > 0) {
            let _ = io.println(ctx, "positive").ignore();
            n
        } else {
            let _ = io.println(ctx, "not positive").ignore();
            0
        }
    } else {
        settledBranch(ctx, n - 1)
    }
}

fn settledOnce<C: Allocator + Stdout>(ctx: C, n: Int): Int {
    if (0.negate() == 0) {
        let _ = io.println(ctx, "once").ignore();
        n
    } else {
        settledOnce(ctx, n - 1)
    }
}

fn double(x: Int): Int {
    x * 2
}

fn addOne(x: Int): Int {
    x + 1
}

fn swapped(f: fn(Int) => Int, g: fn(Int) => Int, n: Int, acc: Int): Int {
    if (n == 0) { acc } else { swapped(g, f, n - 1, acc + f(n)) }
}

fn walk(p: (Int, Int), n: Int): Int {
    if (n <= 0) { p.0 } else { walk((p.1, p.0 + p.1), n - p.0) }
}

fn steps(a: Int, n: Int): Int {
    if (n <= 0) { a } else { steps(a + 1, if (a > 3) { n - 2 } else { n - 1 }) }
}

fn stepsBack(a: Int, n: Int): Int {
    if (n <= 0) { a } else { stepsBack(a + 1, if (n > 5) { n - a } else { n - 1 }) }
}

fn rank(o: Order): Int {
    match (o) {
        .Less => 0,
        .Equal => 1,
        .Greater => 2,
    }
}

fn ordered(a: Int, b: Int): Int {
    rank(a.compare(b + 1)) * 3 + rank((a + 1).compare(b))
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let xs = [1, 5];
    let _ = io.println(ctx, "guarded(5, 3) = ${guarded(5, 3)}").ignore();
    let _ = io.println(ctx, "guarded(20, 30) = ${guarded(20, 30)}").ignore();
    let _ = io.println(ctx, "guarded(1, 3) = ${guarded(1, 3)}").ignore();
    let _ = io.println(ctx, "guardedTail(9, 3) = ${guardedTail(9, 3)}").ignore();
    let _ = io.println(ctx, "guardedPick(xs, 0) = ${guardedPick(xs, 0)}").ignore();
    let _ = io.println(ctx, "guardedPick(xs, 1) = ${guardedPick(xs, 1)}").ignore();
    let _ = io.println(ctx, "guardedPick(xs, 9) = ${guardedPick(xs, 9)}").ignore();
    let _ = io.println(ctx, "settled(5) = ${settled(5)}").ignore();
    let _ = io
        .println(ctx, "settledBranch(ctx, 3) = ${settledBranch(ctx, 3)}")
        .ignore();
    let _ = io
        .println(ctx, "settledBranch(ctx, -3) = ${settledBranch(ctx, -3)}")
        .ignore();
    let _ = io.println(ctx, "settledOnce(ctx, 2) = ${settledOnce(ctx, 2)}").ignore();
    let _ = io
        .println(
            ctx,
            "swapped(double, addOne, 4, 0) = ${swapped(double, addOne, 4, 0)}",
        )
        .ignore();
    let _ = io.println(ctx, "walk((1, 1), 10) = ${walk((1, 1), 10)}").ignore();
    let _ = io.println(ctx, "steps(0, 10) = ${steps(0, 10)}").ignore();
    let _ = io.println(ctx, "stepsBack(0, 10) = ${stepsBack(0, 10)}").ignore();
    let _ = io.println(ctx, "ordered(3, 2) = ${ordered(3, 2)}").ignore();
    .Ok(())
}
