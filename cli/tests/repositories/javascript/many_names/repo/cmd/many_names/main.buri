// Each constant pair is a shared top-level constant, so the program has over
// three hundred top-level names. `walk` keeps 26 locals alive, each read
// twice, and recurses, so it is never inlined.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn walk(n: Int): Int {
    let v0 = n * 3;
    let v1 = (v0 + v0 / 2) % 1000 + 1;
    let v2 = (v1 + v1 / 2) % 1000 + 2;
    let v3 = (v2 + v2 / 2) % 1000 + 3;
    let v4 = (v3 + v3 / 2) % 1000 + 4;
    let v5 = (v4 + v4 / 2) % 1000 + 5;
    let v6 = (v5 + v5 / 2) % 1000 + 6;
    let v7 = (v6 + v6 / 2) % 1000 + 7;
    let v8 = (v7 + v7 / 2) % 1000 + 8;
    let v9 = (v8 + v8 / 2) % 1000 + 9;
    let v10 = (v9 + v9 / 2) % 1000 + 10;
    let v11 = (v10 + v10 / 2) % 1000 + 11;
    let v12 = (v11 + v11 / 2) % 1000 + 12;
    let v13 = (v12 + v12 / 2) % 1000 + 13;
    let v14 = (v13 + v13 / 2) % 1000 + 14;
    let v15 = (v14 + v14 / 2) % 1000 + 15;
    let v16 = (v15 + v15 / 2) % 1000 + 16;
    let v17 = (v16 + v16 / 2) % 1000 + 17;
    let v18 = (v17 + v17 / 2) % 1000 + 18;
    let v19 = (v18 + v18 / 2) % 1000 + 19;
    let v20 = (v19 + v19 / 2) % 1000 + 20;
    let v21 = (v20 + v20 / 2) % 1000 + 21;
    let v22 = (v21 + v21 / 2) % 1000 + 22;
    let v23 = (v22 + v22 / 2) % 1000 + 23;
    let v24 = (v23 + v23 / 2) % 1000 + 24;
    let v25 = (v24 + v24 / 2) % 1000 + 25;
    if (n > 1000) { walk(n - 1) } else { v25 }
}

