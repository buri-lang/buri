# A context that owns a reference count, handed to a timer the runtime runs
# later. The debug backend names the call it can't compile and runs nothing.
# JavaScript runs the same suite. A step is handed one too, and runs: see
# stencil/a_step_is_handed_a_counted_context.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a timer whose context owns a count is refused by name on the debug backend and runs on JavaScript"

run {
  args: ["test", "//lib/steps", "--force"]
  exit: 1
  golden: "refused.txt"
}

edit {
  file: "lib/steps/BUILD.buri"
  replace: "backends: [NATIVE]"
  with: "backends: [JS]"
}

run {
  args: ["test", "//lib/steps", "--force"]
  exit: 0
  golden: "javascript.txt"
}
