from "core/tasks" import * as tasks;
from "core/testing/assert" import * as assert;
from "core/time" import * as time;
from "platform/effect" import { Allocator, Region, Tasks };
from "platform/effect/testing" import { tasks };

// An allocator that owns a `Str`, so a context binding it owns a count.
struct Named {
    name: Str,
}

impl Allocator for Named {
    fn allocate(self, bytes: Int): Region {
        Region(bytes + self.name.length())
    }
}

test "a step is handed a context that owns a count" {
    let ctx = context {
        Allocator: Named { name: "pool" },
        Tasks: tasks(),
    };
    assert.equal(tasks.parallel(ctx, [1, 2], fn(c, i, x) => x + i), [1, 3]);
    // A second element type: a second copy of the step, refused the same way.
    assert.equal(tasks.parallel(ctx, [true], fn(c, i, b) => !b), [false]);
}

test "a timer is handed a context that owns a count" {
    let ctx = context {
        Allocator: Named { name: "pool" },
        Tasks: tasks(),
    };
    let _ = tasks.after(ctx, time.milliseconds(1), fn(c) => ());
}
