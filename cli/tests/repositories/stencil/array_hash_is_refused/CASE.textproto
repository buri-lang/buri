# A derived `Hash` over a list field has no body in the debug backend. The
# build names what it can't compile and runs nothing, rather than writing a
# program that fails when it gets there. JavaScript runs the same suite.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "a derived hash over a list is refused by name on the debug backend and runs on JavaScript"

run {
  args: ["test", "//lib/ids", "--force"]
  exit: 1
  golden: "refused.txt"
}

edit {
  file: "lib/ids/BUILD.buri"
  replace: "backends: [NATIVE]"
  with: "backends: [JS]"
}

run {
  args: ["test", "//lib/ids", "--force"]
  exit: 0
  golden: "javascript.txt"
}
