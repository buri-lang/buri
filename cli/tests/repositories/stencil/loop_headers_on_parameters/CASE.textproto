# Loops whose test compares two parameters, so the loop's header is the
# comparison and the branch alone: one whose way back swaps two values, and
# one whose test result is read twice. Both backends run every block.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "loops tested on two parameters agree on both backends"

run {
  args: ["test", "//lib/loops", "--force"]
  exit: 0
  golden: "test.txt"
}
