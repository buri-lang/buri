# Loops that carry several values from pass to pass: integers and F32s that
# rotate, more of them than the debug backend's fused copy-and-jump takes, a
# float that accumulates, and a list loop inside a recursive one. Both backends
# run every block.
#
# Schema: the repository-case manifest, cli/tests/harness/case.rs. Textproto,
# but not a Buri file: only repo/ below is a Buri repository.

doc: "loops that rotate many values, and a loop inside a loop, agree on both backends"

run {
  args: ["test", "//lib/loops", "--force"]
  exit: 0
  golden: "test.txt"
}
