from "core/testing/assert" import * as assert;

fn rotateThree(n: Int, a: Int, b: Int, c: Int): Int {
    if (n == 0) { a * 100 + b * 10 + c } else { rotateThree(n - 1, b, c, a) }
}

fn manyParams(n: Int, a: Int, b: Int, c: Int, d: Int, e: Int, f: Int): Int {
    if (n == 0) {
        a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
    } else {
        manyParams(n - 1, b, c, d, e, f, a)
    }
}

fn outerSum(n: Int, acc: Int, xs: [Int]): Int {
    if (n == 0) {
        acc
    } else {
        outerSum(n - 1, acc + xs.fold(fn(s, x) => s + x * n, 0), xs)
    }
}

test "three values rotate on each pass" {
    assert.equal(rotateThree(1, 1, 2, 3), 231);
    assert.equal(rotateThree(3, 1, 2, 3), 123);
}

test "a loop with more than four changing parameters rotates them all" {
    assert.equal(manyParams(0, 1, 2, 3, 4, 5, 6), 91);
    assert.equal(manyParams(1, 1, 2, 3, 4, 5, 6), 2 + 6 + 12 + 20 + 30 + 6);
    assert.equal(manyParams(6, 1, 2, 3, 4, 5, 6), 91);
}

test "a list loop inside a recursive loop" {
    assert.equal(outerSum(3, 0, [1, 2, 3]), 6 * 3 + 6 * 2 + 6 * 1);
}
