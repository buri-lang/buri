from "core/testing/assert" import * as assert;

enum Tree {
    Leaf,
    Node(Tree, Int, Tree),
}

fn build(d: Int): Tree {
    if (d == 0) { Tree.Leaf } else { Tree.Node(build(d - 1), d, build(d - 1)) }
}

fn sum(t: Tree): Int {
    match (t) {
        .Leaf => 1,
        .Node(l, v, r) => sum(l) + v + sum(r),
    }
}

