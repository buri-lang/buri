test "a tree's leaves" {
    assert.equal(sum(build(3)), 8 + 4 * 1 + 2 * 2 + 3);
}

test "seventy fieldless variants, wrapped" {
    assert.equal(index(Many.Wrap(Many.Wrap(pick(3)))), 2003);
    assert.equal(index(Many.Wrap(Many.Wrap(pick(16)))), 2016);
    assert.equal(index(Many.Wrap(Many.Wrap(pick(69)))), 2069);
}
