// The surface of the vendored schemas.
//
// Two generated modules, and this file is what lets the testee name anything in
// them: a `.proto` module is internal to the rule that declared it, exactly as
// a hand-written one is. Nothing here is written by hand except the list.

from "//lib/conformance/conformance.proto" export {
    ConformanceRequest, ConformanceRequest_Payload, ConformanceResponse,
    ConformanceResponse_Result, decodeConformanceRequest, defaultConformanceRequest,
    defaultConformanceResponse, encodeConformanceResponse, TestCategory, WireFormat,
};

from "//lib/conformance/test_messages_proto3.proto" export {
    decodeTestAllTypesProto3, decodeTestAllTypesProto3Json, defaultTestAllTypesProto3,
    encodeTestAllTypesProto3, encodeTestAllTypesProto3Json, TestAllTypesProto3,
};
