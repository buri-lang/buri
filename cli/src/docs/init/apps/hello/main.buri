// The entry point. The context it builds is this program's entire effect
// budget: it can allocate and it can print, and nothing else.

from "core/effect" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "//libs/greeting" import { greeting };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };

    // An effect is performed by handing the context to a function, and printing
    // answers `Result<(), IoError>` — a closed pipe is a thing that happens. A
    // program that does not care writes `.ignore()`; this one says so instead.
    match (io.println(ctx, greeting())) {
        .Ok(_) => .Ok(()),
        .Err(_) => .Err("could not write to standard output"),
    }
}
