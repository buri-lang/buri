// The entry point. The context it builds is this program's entire effect
// budget: it can allocate and it can print, and nothing else.

from "core/effect/lib.buri" import { Alloc, Stdout };
from "core/host/lib.buri" import * as host;
from "//libs/greeting/lib.buri" import { greeting };

export fn main(): Result<(), Str> {
    let ctx = context {
        Alloc: host.alloc,
        Stdout: host.stdout,
    };

    let _ = ctx.println(greeting());
    .Ok(())
}
