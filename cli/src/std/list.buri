//! core/list — the defining module of `[T]`.
//!
//! The split that runs through this file is the one SPEC 10.5 draws: an
//! operation whose result size is fixed is pure, and an operation whose result
//! size depends on runtime data names `Alloc`. `len` and `fold` are pure;
//! `map` and `filter` are not, and say so in their signatures.
//!
//! Everything here takes its collection as `self`, so it is callable as a
//! method with no import: receiver first, context second, everything else
//! after (SPEC 10.7).

from "core/cap" import { Alloc };
from "core/order" import { Order, Ord };

// --- Pure: no context parameter at all --------------------------------------

impl<T> [T] {
  export fn len(self: [T]): Int;

  export fn isEmpty(self: [T]): Bool {
    self.len() == 0
  }

  /// Indexing yields `Option<T>`. There is no way to index out of bounds and no
  /// way to panic by indexing — the single largest ergonomic tax in the
  /// language, charged on purpose.
  export fn get(self: [T], index: Int): Option<T>;

  export fn first(self: [T]): Option<T> {
    self.get(0)
  }

  export fn last(self: [T]): Option<T> {
    self.get(self.len() - 1)
  }

  /// A fold produces one value rather than a new collection, so it allocates
  /// nothing and needs no context.
  export fn fold<B>(self: [T], f: fn(B, T) => B, init: B): B;

  /// The `*Ctx` variant, for a step that needs an effect. A lambda may not
  /// capture one (SPEC 10.6), so the context is threaded through instead.
  export fn foldCtx<B, C>(self: [T], ctx: C, f: fn(C, B, T) => B, init: B): B;

  /// Stops at the first `.Err`, which is how a fallible fold is written
  /// without an early exit.
  export fn foldResult<B, E>(
    self: [T],
    f: fn(B, T) => Result<B, E>,
    init: B,
  ): Result<B, E>;

  export fn any(self: [T], pred: fn(T) => Bool): Bool;

  export fn all(self: [T], pred: fn(T) => Bool): Bool;

  export fn find(self: [T], pred: fn(T) => Bool): Option<T>;

  export fn findIndex(self: [T], pred: fn(T) => Bool): Option<Int>;
}

impl<T: Eq> [T] {
  export fn contains(self: [T], needle: T): Bool {
    self.any(fn(x) => x == needle)
  }
}

impl<T> [T] {
  export fn count(self: [T], pred: fn(T) => Bool): Int;
}

// --- Deterministic: bounded by <C: Alloc> ------------------------------------

impl<A> [A] {
  export fn map<B, C: Alloc>(self: [A], ctx: C, f: fn(A) => B): [B];

  export fn mapCtx<B, C: Alloc>(self: [A], ctx: C, f: fn(C, A) => B): [B];
}

impl<T> [T] {
  export fn filter<C: Alloc>(self: [T], ctx: C, keep: fn(T) => Bool): [T];

  export fn filterCtx<C: Alloc>(self: [T], ctx: C, keep: fn(C, T) => Bool): [T];

  export fn concat<C: Alloc>(self: [T], ctx: C, other: [T]): [T];

  export fn push<C: Alloc>(self: [T], ctx: C, item: T): [T];

  export fn reverse<C: Alloc>(self: [T], ctx: C): [T];

  /// Ordering is a value you pass, so the tie-break is explicit and reviewable.
  /// The sort is stable.
  export fn sortBy<C: Alloc>(self: [T], ctx: C, order: fn(T, T) => Order): [T];
}

impl<T: Ord> [T] {
  export fn sort<C: Alloc>(self: [T], ctx: C): [T] {
    self.sortBy(ctx, fn(a, b) => a.compare(b))
  }
}

impl<T> [T] {
  export fn take<C: Alloc>(self: [T], ctx: C, n: Int): [T];

  export fn drop<C: Alloc>(self: [T], ctx: C, n: Int): [T];

  export fn slice<C: Alloc>(self: [T], ctx: C, start: Int, end: Int): [T];
}

impl<A> [A] {
  export fn zip<B, C: Alloc>(self: [A], ctx: C, other: [B]): [(A, B)];
}

impl<T> [[T]] {
  export fn flatten<C: Alloc>(self: [[T]], ctx: C): [T];
}

impl [Str] {
  /// Declared here rather than in `core/str` because its receiver is `[Str]`,
  /// and a method lives in its receiver type's defining module.
  export fn join<C: Alloc>(self: [Str], ctx: C, separator: Str): Str;
}

export fn empty<T>(): [T];

/// `[from, from+1, ..., to-1]`. Counting without a loop and without a `Range`
/// type — SPEC 15.1 records why neither exists.
export fn range<C: Alloc>(ctx: C, start: Int, end: Int): [Int];

export fn repeat<T, C: Alloc>(ctx: C, item: T, times: Int): [T];

// --- Numeric folds ------------------------------------------------------------

impl [Int] {
  export fn sum(self: [Int]): Int {
    self.fold(fn(acc, x) => acc + x, 0)
  }
}

impl [Float] {
  export fn sumFloat(self: [Float]): Float {
    self.fold(fn(acc, x) => acc + x, 0.0)
  }
}

impl<T: Ord> [T] {
  export fn maximum(self: [T]): Option<T> {
    self.fold(
      fn(best, x) => match (best) {
        .None => .Some(x),
        .Some(b) => if (x > b) { .Some(x) } else { .Some(b) },
      },
      .None,
    )
  }

  export fn minimum(self: [T]): Option<T> {
    self.fold(
      fn(best, x) => match (best) {
        .None => .Some(x),
        .Some(b) => if (x < b) { .Some(x) } else { .Some(b) },
      },
      .None,
    )
  }
}
