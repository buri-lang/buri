// core/cap — the effect declarations.
//
// An effect is an interface declared with `effect` instead of `trait`. Its
// methods are the operations it grants. Only platform modules may declare
// effects, so the set of things a Buri program can do to the world is fixed by
// its platform rather than open-ended (SPEC 10.1).
//
// Two rules separate an effect from an ordinary trait:
//   - its implementors are effect-carrying, and so may be passed only as
//     `self` or `ctx`;
//   - no type may implement both an effect and a trait.

/// A region of memory. `Alloc` is a *resource* effect: it can fail and it
/// costs something, but it is not observable, which is what makes a function
/// bounded only by `Alloc` deterministic (SPEC 10.5).
export struct Region(export I64);

export effect Alloc {
  fn allocate(self: Self, bytes: Int): Region;
}

export effect Stdout {
  fn print(self: Self, text: Template): ();
  fn println(self: Self, text: Template): ();
}

export effect Stderr {
  fn eprint(self: Self, text: Template): ();
  fn eprintln(self: Self, text: Template): ();
}

export effect Stdin {
  fn readLine(self: Self): Option<Str>;
}

export effect Fs {
  fn readFile(self: Self, path: Str): Result<Str, IoError>;
  fn writeFile(self: Self, path: Str, body: Str): Result<(), IoError>;
  fn fileExists(self: Self, path: Str): Bool;
  fn readDir(self: Self, path: Str): Result<[Str], IoError>;
}

export effect Net {
  fn fetch(self: Self, method: Str, url: Str, body: Str): Result<NetResponse, NetError>;
}

export effect Clock {
  fn nowMillis(self: Self): I64;
  fn sleepMillis(self: Self, millis: Int): ();
}

export effect Rand {
  fn nextInt(self: Self, lo: Int, hi: Int): Int;
  fn nextFloat(self: Self): Float;
}

export effect Env {
  fn variable(self: Self, name: Str): Option<Str>;
  fn arguments(self: Self): [Str];
}

export effect Proc {
  fn exitWith(self: Self, code: Int): ();
}

/// Declared here rather than in `core/fs` so that the effect signature above
/// can name it without `core/cap` depending on a module that depends on it.
export enum IoError {
  export NotFound,
  export PermissionDenied,
  export ReadOnly,
  export AlreadyExists,
  export NotADirectory,
  export Other(Str),
}

export enum NetError {
  export Timeout,
  export Refused,
  export BadUrl(Str),
  export Transport(Str),
}

export struct NetResponse {
  export status: Int,
  export body: Str,
}

derive Eq, Show for IoError;
derive Eq, Show for NetError;
derive Eq, Show for NetResponse;
derive Eq, Show for Region;
