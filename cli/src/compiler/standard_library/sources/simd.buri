//! core/simd — fixed-width vectors.
//!
//! **On the JavaScript backend these are scalar and buy no speed.** There is no
//! SIMD reachable from a plain `.mjs` artifact: SIMD.js was removed years ago,
//! and WebAssembly's vectors are not addressable from JavaScript. Every
//! operation here is four ordinary arithmetic operations in a row.
//!
//! What it buys is the shape. A kernel written against `F32x4` is written
//! lane-wise, with no loop-carried dependency and no aliasing, which is the form
//! a backend with vector registers can lower directly. Porting it later changes
//! this module and nothing that uses it. A fold over a list is not portable that
//! way, because a fold says "in this order".
//!
//! Do not benchmark against a scalar loop expecting a win; there is not one
//! today.
//!
//! **Every operation is pure.** A vector is four numbers in a struct — a fixed
//! size, known at compile time — so nothing here allocates and nothing takes a
//! context (SPEC 10.5).
//!
//! ```buri run
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/simd" import * as simd;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let position = simd.f32x4(1.0, 2.0, 3.0, 0.0);
//!     let velocity = simd.f32x4(0.5, -0.5, 1.0, 0.0);
//!     // No loop and no ordering: the shape a backend with vector registers can
//!     // lower directly.
//!     let stepped = position.add(velocity.scale(2.0));
//!     let _ = io
//!         .println(ctx, "${stepped.lane(0)} ${stepped.lane(1)} ${stepped.dot(stepped)}")
//!         .ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 2.0 1.0 30.0
//! ```

from "core/bits" import * as bits;
from "core/math" import * as math;
from "core/number" import * as number;

derive Eq, Show for F32x4;
/// Four floats.
export struct F32x4 {
    export x: Float,
    export y: Float,
    export z: Float,
    export w: Float,
}

derive Eq, Show for I32x4;
/// Four integers.
export struct I32x4 {
    export x: Int,
    export y: Int,
    export z: Int,
    export w: Int,
}

/// The same value in every lane.
export fn splatF(v: Float): F32x4 {
    F32x4 { x: v, y: v, z: v, w: v }
}

export fn splatI(v: Int): I32x4 {
    I32x4 { x: v, y: v, z: v, w: v }
}

export fn f32x4(x: Float, y: Float, z: Float, w: Float): F32x4 {
    F32x4 { x: x, y: y, z: z, w: w }
}

export fn i32x4(x: Int, y: Int, z: Int, w: Int): I32x4 {
    I32x4 { x: x, y: y, z: z, w: w }
}

export let ZERO_F: F32x4 = F32x4 { x: 0.0, y: 0.0, z: 0.0, w: 0.0 };

export let ZERO_I: I32x4 = I32x4 { x: 0, y: 0, z: 0, w: 0 };

impl F32x4 {
    /// Lane 0 to 3. Out of range is lane 0 rather than an error.
    export fn lane(self, i: Int): Float {
        if (i == 1) {
            self.y
        } else if (i == 2) {
            self.z
        } else if (i == 3) {
            self.w
        } else {
            self.x
        }
    }

    export fn withLane(self, i: Int, v: Float): F32x4 {
        if (i == 1) {
            F32x4 { ..self, y: v }
        } else if (i == 2) {
            F32x4 { ..self, z: v }
        } else if (i == 3) {
            F32x4 { ..self, w: v }
        } else {
            F32x4 { ..self, x: v }
        }
    }

    export fn add(self, o: F32x4): F32x4 {
        F32x4 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, w: self.w + o.w }
    }

    export fn sub(self, o: F32x4): F32x4 {
        F32x4 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, w: self.w - o.w }
    }

    export fn mul(self, o: F32x4): F32x4 {
        F32x4 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z, w: self.w * o.w }
    }

    export fn div(self, o: F32x4): F32x4 {
        F32x4 { x: self.x / o.x, y: self.y / o.y, z: self.z / o.z, w: self.w / o.w }
    }

    export fn scale(self, k: Float): F32x4 {
        self.mul(splatF(k))
    }

    export fn min(self, o: F32x4): F32x4 {
        F32x4 {
            x: if (self.x < o.x) { self.x } else { o.x },
            y: if (self.y < o.y) { self.y } else { o.y },
            z: if (self.z < o.z) { self.z } else { o.z },
            w: if (self.w < o.w) { self.w } else { o.w },
        }
    }

    export fn max(self, o: F32x4): F32x4 {
        F32x4 {
            x: if (self.x > o.x) { self.x } else { o.x },
            y: if (self.y > o.y) { self.y } else { o.y },
            z: if (self.z > o.z) { self.z } else { o.z },
            w: if (self.w > o.w) { self.w } else { o.w },
        }
    }

    export fn abs(self): F32x4 {
        F32x4 {
            x: math.absFloat(self.x),
            y: math.absFloat(self.y),
            z: math.absFloat(self.z),
            w: math.absFloat(self.w),
        }
    }

    export fn neg(self): F32x4 {
        F32x4 { x: -self.x, y: -self.y, z: -self.z, w: -self.w }
    }

    export fn sqrt(self): F32x4 {
        F32x4 {
            x: math.sqrt(self.x),
            y: math.sqrt(self.y),
            z: math.sqrt(self.z),
            w: math.sqrt(self.w),
        }
    }

    /// The lanes added together. A horizontal reduction, which is the one thing
    /// a vector unit is bad at.
    export fn sum(self): Float {
        self.x + self.y + self.z + self.w
    }

    export fn dot(self, o: F32x4): Float {
        self.mul(o).sum()
    }

    /// The lane-wise comparison, as a mask of 1 and 0 rather than booleans —
    /// which is what a vector unit produces and what `select` consumes.
    export fn lessThan(self, o: F32x4): I32x4 {
        I32x4 {
            x: if (self.x < o.x) { 1 } else { 0 },
            y: if (self.y < o.y) { 1 } else { 0 },
            z: if (self.z < o.z) { 1 } else { 0 },
            w: if (self.w < o.w) { 1 } else { 0 },
        }
    }

    export fn equalTo(self, o: F32x4): I32x4 {
        I32x4 {
            x: if (self.x == o.x) { 1 } else { 0 },
            y: if (self.y == o.y) { 1 } else { 0 },
            z: if (self.z == o.z) { 1 } else { 0 },
            w: if (self.w == o.w) { 1 } else { 0 },
        }
    }
}

/// `mask` lane non-zero takes from `a`, zero takes from `b`. Branch-free, which
/// is why the comparisons produce a mask rather than a `Bool`.
export fn selectF(mask: I32x4, a: F32x4, b: F32x4): F32x4 {
    F32x4 {
        x: if (mask.x != 0) { a.x } else { b.x },
        y: if (mask.y != 0) { a.y } else { b.y },
        z: if (mask.z != 0) { a.z } else { b.z },
        w: if (mask.w != 0) { a.w } else { b.w },
    }
}

impl I32x4 {
    export fn lane(self, i: Int): Int {
        if (i == 1) {
            self.y
        } else if (i == 2) {
            self.z
        } else if (i == 3) {
            self.w
        } else {
            self.x
        }
    }

    export fn withLane(self, i: Int, v: Int): I32x4 {
        if (i == 1) {
            I32x4 { ..self, y: v }
        } else if (i == 2) {
            I32x4 { ..self, z: v }
        } else if (i == 3) {
            I32x4 { ..self, w: v }
        } else {
            I32x4 { ..self, x: v }
        }
    }

    export fn add(self, o: I32x4): I32x4 {
        I32x4 { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, w: self.w + o.w }
    }

    export fn sub(self, o: I32x4): I32x4 {
        I32x4 { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, w: self.w - o.w }
    }

    export fn mul(self, o: I32x4): I32x4 {
        I32x4 { x: self.x * o.x, y: self.y * o.y, z: self.z * o.z, w: self.w * o.w }
    }

    export fn min(self, o: I32x4): I32x4 {
        I32x4 {
            x: if (self.x < o.x) { self.x } else { o.x },
            y: if (self.y < o.y) { self.y } else { o.y },
            z: if (self.z < o.z) { self.z } else { o.z },
            w: if (self.w < o.w) { self.w } else { o.w },
        }
    }

    export fn max(self, o: I32x4): I32x4 {
        I32x4 {
            x: if (self.x > o.x) { self.x } else { o.x },
            y: if (self.y > o.y) { self.y } else { o.y },
            z: if (self.z > o.z) { self.z } else { o.z },
            w: if (self.w > o.w) { self.w } else { o.w },
        }
    }

    export fn sum(self): Int {
        self.x + self.y + self.z + self.w
    }

    export fn dot(self, o: I32x4): Int {
        self.mul(o).sum()
    }

    export fn and(self, o: I32x4): I32x4 {
        I32x4 { x: self.x & o.x, y: self.y & o.y, z: self.z & o.z, w: self.w & o.w }
    }

    export fn or(self, o: I32x4): I32x4 {
        I32x4 { x: self.x | o.x, y: self.y | o.y, z: self.z | o.z, w: self.w | o.w }
    }

    export fn xor(self, o: I32x4): I32x4 {
        I32x4 { x: self.x ^ o.x, y: self.y ^ o.y, z: self.z ^ o.z, w: self.w ^ o.w }
    }

    /// True when every lane is non-zero — the usual way to consume a mask.
    export fn allTrue(self): Bool {
        self.x != 0 && self.y != 0 && self.z != 0 && self.w != 0
    }

    export fn anyTrue(self): Bool {
        self.x != 0 || self.y != 0 || self.z != 0 || self.w != 0
    }

    export fn toFloat(self): F32x4 {
        F32x4 {
            x: self.x.toF64(),
            y: self.y.toF64(),
            z: self.z.toF64(),
            w: self.w.toF64(),
        }
    }
}

// --- Reductions, loads and the rest of the mask vocabulary --------------------------

impl F32x4 {
    /// The smallest of the four lanes.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn floorOf(v: simd.F32x4): Float {
    ///     v.minLane()
    /// }
    /// ```
    ///
    /// A horizontal reduction, like `sum`, so it is the one shape a vector unit
    /// is bad at.
    ///
    /// **A `NaN` lane is passed over.** `minLane` answers the smallest of the
    /// lanes that are numbers, wherever in the vector the `NaN`s sit, and a
    /// `NaN` only when every lane is one. The lane-wise `min` does *not* do
    /// this: it is written as one comparison a vector unit has an instruction
    /// for, so a `NaN` in its argument comes straight through.
    export fn minLane(self): Float {
        smaller(smaller(self.x, self.y), smaller(self.z, self.w))
    }

    /// The largest of the four lanes.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn ceilingOf(v: simd.F32x4): Float {
    ///     v.maxLane()
    /// }
    /// ```
    ///
    /// `minLane`'s twin, and a `NaN` lane is passed over there too.
    export fn maxLane(self): Float {
        larger(larger(self.x, self.y), larger(self.z, self.w))
    }

    /// `self * multiplier + addend`, lane by lane.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn step(position: simd.F32x4, velocity: simd.F32x4, dt: Float): simd.F32x4 {
    ///     velocity.mulAdd(simd.splatF(dt), position)
    /// }
    /// ```
    ///
    /// **Two roundings, not one.** This is the multiply and the add written
    /// together, not a fused multiply-add: an FMA rounds once and would answer
    /// different bits on a backend that has the instruction and a backend that
    /// does not.
    export fn mulAdd(self, multiplier: F32x4, addend: F32x4): F32x4 {
        self.mul(multiplier).add(addend)
    }

    /// Each lane truncated toward zero.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn bucket(v: simd.F32x4): simd.I32x4 {
    ///     v.toInt()
    /// }
    /// ```
    ///
    /// Total, which `x.toI64()` is not: a `NaN` lane becomes `0` and a lane past
    /// either end of `Int` stops at that end. That is the saturating rule a
    /// vector unit's own conversion has, and it means a vector of any four
    /// floats converts.
    export fn toInt(self): I32x4 {
        I32x4 {
            x: laneToInt(self.x),
            y: laneToInt(self.y),
            z: laneToInt(self.z),
            w: laneToInt(self.w),
        }
    }
}

/// The smaller of two lanes, with a `NaN` passed over rather than answered.
///
/// Both comparisons are false at a `NaN` either side, so neither branch picks
/// one and the third test says which of the two to keep. Two `NaN`s leave a
/// `NaN`, which is the only answer there is.
fn smaller(a: Float, b: Float): Float {
    if (a < b) { a } else if (b < a) { b } else if (math.isNan(a)) { b } else { a }
}

/// `smaller`, the other way round.
fn larger(a: Float, b: Float): Float {
    if (a > b) { a } else if (b > a) { b } else if (math.isNan(a)) { b } else { a }
}

/// One lane's float truncated to an `Int`, saturating rather than wrapping.
///
/// The two bounds are tested before the conversion rather than after: `2^63` is
/// not an `Int`, so there is no value to test afterwards.
fn laneToInt(v: Float): Int {
    let whole = math.trunc(v);
    if (math.isNan(whole)) {
        0
    } else if (whole >= 9223372036854775808.0) {
        number.maxValue<Int>()
    } else if (whole <= -9223372036854775808.0) {
        number.minValue<Int>()
    } else {
        whole.wrapToI64()
    }
}

impl I32x4 {
    /// The lane-wise comparison, as a mask of 1 and 0 — `F32x4.lessThan`'s twin.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn under(v: simd.I32x4, limit: simd.I32x4): simd.I32x4 {
    ///     v.lessThan(limit)
    /// }
    /// ```
    export fn lessThan(self, o: I32x4): I32x4 {
        I32x4 {
            x: if (self.x < o.x) { 1 } else { 0 },
            y: if (self.y < o.y) { 1 } else { 0 },
            z: if (self.z < o.z) { 1 } else { 0 },
            w: if (self.w < o.w) { 1 } else { 0 },
        }
    }

    /// The lane-wise equality, as a mask of 1 and 0.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn matching(a: simd.I32x4, b: simd.I32x4): simd.I32x4 {
    ///     a.equalTo(b)
    /// }
    /// ```
    export fn equalTo(self, o: I32x4): I32x4 {
        I32x4 {
            x: if (self.x == o.x) { 1 } else { 0 },
            y: if (self.y == o.y) { 1 } else { 0 },
            z: if (self.z == o.z) { 1 } else { 0 },
            w: if (self.w == o.w) { 1 } else { 0 },
        }
    }

    /// A mask inverted: every non-zero lane becomes `0` and every zero lane
    /// becomes `1`.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn outside(v: simd.I32x4, limit: simd.I32x4): simd.I32x4 {
    ///     v.lessThan(limit).not()
    /// }
    /// ```
    ///
    /// **The mask's negation, not the bit pattern's.** Every comparison here
    /// produces `1` or `0` and `select` reads "non-zero", so a bitwise
    /// complement would turn `1` into `-2`, which still selects. `xor` with a
    /// splat of `-1` is the bitwise complement when that is what you want.
    export fn not(self): I32x4 {
        I32x4 {
            x: if (self.x == 0) { 1 } else { 0 },
            y: if (self.y == 0) { 1 } else { 0 },
            z: if (self.z == 0) { 1 } else { 0 },
            w: if (self.w == 0) { 1 } else { 0 },
        }
    }

    /// Every lane shifted left by `count`.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn doubled(v: simd.I32x4): simd.I32x4 {
    ///     v.shl(1)
    /// }
    /// ```
    ///
    /// A lane is an `Int`, so this is `bits.shl` four times and a `count` at or
    /// beyond 64 aborts, exactly as that one does.
    export fn shl(self, count: Int): I32x4 {
        I32x4 {
            x: bits.shl(self.x, count),
            y: bits.shl(self.y, count),
            z: bits.shl(self.z, count),
            w: bits.shl(self.w, count),
        }
    }

    /// Every lane shifted right by `count`, logically: the vacated places fill
    /// with zeros, whatever the sign was.
    ///
    /// ```buri
    /// from "core/simd" import * as simd;
    ///
    /// export fn halved(v: simd.I32x4): simd.I32x4 {
    ///     v.shr(1)
    /// }
    /// ```
    ///
    /// `bits.shr` four times, so a `count` at or beyond 64 aborts.
    export fn shr(self, count: Int): I32x4 {
        I32x4 {
            x: bits.shr(self.x, count),
            y: bits.shr(self.y, count),
            z: bits.shr(self.z, count),
            w: bits.shr(self.w, count),
        }
    }
}

/// Four consecutive floats from a list, or `.None` when they are not all there.
///
/// ```buri
/// from "core/simd" import * as simd;
///
/// export fn head(xs: [Float]): Option<simd.F32x4> {
///     simd.loadF32x4(xs, 0)
/// }
/// ```
///
/// A short tail is `.None` rather than a padded vector, so a kernel decides for
/// itself what to do with the remainder.
export fn loadF32x4(items: [Float], at: Int): Option<F32x4> {
    items
        .get(at)
        .andThen(fn(x) => {
            items
                .get(at + 1)
                .andThen(fn(y) => {
                    items
                        .get(at + 2)
                        .andThen(fn(z) => {
                            items
                                .get(at + 3)
                                .map(fn(w) => F32x4 { x: x, y: y, z: z, w: w })
                        })
                })
        })
}

/// Four consecutive integers from a list, or `.None` when they are not all
/// there.
///
/// ```buri
/// from "core/simd" import * as simd;
///
/// export fn headInts(xs: [Int]): Option<simd.I32x4> {
///     simd.loadI32x4(xs, 0)
/// }
/// ```
///
/// `loadF32x4`'s twin, with the same rule about a short tail.
export fn loadI32x4(items: [Int], at: Int): Option<I32x4> {
    items
        .get(at)
        .andThen(fn(x) => {
            items
                .get(at + 1)
                .andThen(fn(y) => {
                    items
                        .get(at + 2)
                        .andThen(fn(z) => {
                            items
                                .get(at + 3)
                                .map(fn(w) => I32x4 { x: x, y: y, z: z, w: w })
                        })
                })
        })
}

/// `selectF` over integers: a `mask` lane that is non-zero takes from
/// `whenTrue`, a zero one from `whenFalse`.
///
/// ```buri
/// from "core/simd" import * as simd;
///
/// export fn clampLow(v: simd.I32x4, floorAt: simd.I32x4): simd.I32x4 {
///     simd.selectI(v.lessThan(floorAt), floorAt, v)
/// }
/// ```
export fn selectI(mask: I32x4, whenTrue: I32x4, whenFalse: I32x4): I32x4 {
    I32x4 {
        x: if (mask.x != 0) { whenTrue.x } else { whenFalse.x },
        y: if (mask.y != 0) { whenTrue.y } else { whenFalse.y },
        z: if (mask.z != 0) { whenTrue.z } else { whenFalse.z },
        w: if (mask.w != 0) { whenTrue.w } else { whenFalse.w },
    }
}
