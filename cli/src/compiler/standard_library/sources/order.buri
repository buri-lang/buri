//! core/order — `Order`, and the four traits every type is expected to be able
//! to opt into.
//!
//! Conformance is nominal: declaring a method that happens to match one of
//! these signatures does not make a type conform. An `impl` or a `derive` is
//! what does (SPEC 5.12.1).

from "core/effect" import { Allocator };

derive Equal, Show for Order;
export enum Order {
    Less,
    Equal,
    Greater,
}

/// `a == b` and `a != b` are `Equal.equal`. Equality is structural, never
/// referential: Buri has no references, so there is no identity to compare.
export trait Equal {
    fn equal(self, other: Self): Bool;
}

/// `<` `<=` `>` `>=` are `Ordered.compare`. The built-in orders are the same on
/// every backend: numbers by value, `Bool` with `false` below `true`, `Char` by
/// scalar value, and `Str` lexicographically by scalar value. `core/str` states
/// that last one in full.
export trait Ordered {
    fn compare(self, other: Self): Order;
}

/// Rendering allocates, so `show` names `Allocator` and nothing else. An
/// implementation provably cannot read a file or open a socket.
export trait Show {
    fn show<C: Allocator>(self, ctx: C): Str;
}

export trait Hash {
    fn hash(self): U64;
}

impl Order {
    export fn flip(self): Order {
        match (self) {
            .Less => .Greater,
            .Equal => .Equal,
            .Greater => .Less,
        }
    }
}

/// Reverses a comparator, for `sortBy`. The argument is a function value
/// rather than an effect, so the lambda may capture it (SPEC 10.6).
export fn reverse<T>(compare: fn(T, T) => Order): fn(T, T) => Order {
    fn(a, b) => compare(b, a)
}

/// Reverses a comparator when `descending` is true, and hands it back
/// untouched when it is false. The direction of a sort is usually data: a
/// column's `ORDER BY ... DESC`, a flag on a request.
export fn reverseIf<T>(
    descending: Bool,
    compare: fn(T, T) => Order,
): fn(T, T) => Order {
    if (descending) { reverse(compare) } else { compare }
}

/// Compares by a key rather than by the whole value: `cmp(key(a), key(b))`.
///
/// Both arguments are function values, so you can build a comparator at runtime.
/// A lambda may capture one, because a function value carries no effect (SPEC
/// 10.6).
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/order" import * as order;
///
/// struct Row {
///     name: Str,
///     score: Int,
/// }
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let rows = [
///         Row { name: "b", score: 2 },
///         Row { name: "a", score: 2 },
///         Row { name: "c", score: 1 },
///     ];
///     // By score descending, then by name — the tie-break is a second
///     // comparator rather than a longer `match`.
///     let by = order.chain([
///         order.reverseIf(true, order.by(fn(r: Row) => r.score, order.int)),
///         order.by(fn(r: Row) => r.name, order.str),
///     ]);
///     let names = rows.sortBy(ctx, by).map(ctx, fn(r) => r.name).join(ctx, " ");
///     let _ = io.println(ctx, names).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// a b c
/// ```
export fn by<T, K>(key: fn(T) => K, compare: fn(K, K) => Order): fn(T, T) => Order {
    fn(a, b) => compare(key(a), key(b))
}

/// Comparators in priority order: the first that does not answer `.Equal`
/// decides, and an empty list answers `.Equal` for every pair. `Order.then` is
/// the two-comparator case written by hand.
export fn chain<T>(comparators: [fn(T, T) => Order]): fn(T, T) => Order {
    fn(a, b) => chainAt(comparators, 0, a, b)
}

/// Walks by index rather than folding: a fold's lambda would have to capture `a`
/// and `b`, and a lambda may not capture a value whose type could be a context,
/// which an unbounded `T` could (SPEC 10.6).
fn chainAt<T>(comparators: [fn(T, T) => Order], at: Int, a: T, b: T): Order {
    match (comparators.get(at)) {
        .None => .Equal,
        .Some(cmp) => {
            match (cmp(a, b)) {
                .Equal => chainAt(comparators, at + 1, a, b),
                decided => decided,
            }
        },
    }
}

impl Order {
    export fn isLess(self): Bool {
        match (self) {
            .Less => true,
            .Equal => false,
            .Greater => false,
        }
    }

    export fn isEqual(self): Bool {
        match (self) {
            .Less => false,
            .Equal => true,
            .Greater => false,
        }
    }
}

/// A comparator value, for `sortBy`.
export fn int(a: Int, b: Int): Order {
    if (a < b) { .Less } else if (a > b) { .Greater } else { .Equal }
}

export fn float(a: Float, b: Float): Order {
    if (a < b) { .Less } else if (a > b) { .Greater } else { .Equal }
}

/// Every `Float` ordered, with `NaN` last and nothing left `.Equal` by
/// accident.
///
/// `float` is IEEE's, and IEEE leaves a `NaN` unordered against everything:
/// `NaN < x`, `NaN > x` and `x > NaN` are all false (SPEC 6.2). So `float`
/// answers `.Equal` for a pair it could not order, and a `sortBy` over data
/// holding one silently keeps whatever order it found. Sort with this comparator
/// when the data can hold a `NaN` — and floats that came from arithmetic can.
///
/// **`-0.0` and `0.0` compare `.Equal`, and so do any two `NaN`s.** This is the
/// total order Buri's `==` describes, not IEEE's `totalOrder` predicate: `==` is
/// an equivalence relation here, and `-0.0 == 0.0` and `NaN == NaN` are both
/// true (SPEC 6.2).
export fn totalFloat(a: Float, b: Float): Order {
    if (a < b) {
        .Less
    } else if (a > b) {
        .Greater
    } else if (a == b) {
        .Equal
    } else if (isNan(a)) {
        .Greater
    } else {
        .Less
    }
}

/// Whether `x` is a `NaN`, asked without reaching for `core/math`: every
/// compilation loads this module, and not every one loads `core/math`.
///
/// `x != x` is not the question, because SPEC 6.2 makes `==` an equivalence
/// relation and `NaN == NaN` is true. The *ordering* operators are still IEEE's,
/// and `x >= x` holds of every other value, both infinities included.
fn isNan(x: Float): Bool {
    let ordered = x >= x;
    ordered == false
}

/// Lexicographic by Unicode scalar value, which for a valid string is UTF-8 byte
/// order. This is `core/str`'s `compare`. Every `<` on a `Str`, every
/// `[Str].sort` and every `OrderedMap<Str, _>` uses the same order.
///
/// It is not JavaScript's `<`, which orders by UTF-16 code unit and so puts every
/// astral character below every character in U+E000..U+FFFF. Both backends answer
/// the scalar order.
export fn str(a: Str, b: Str): Order {
    a.compare(b)
}

export fn bool(a: Bool, b: Bool): Order {
    if (a == b) { .Equal } else if (a) { .Greater } else { .Less }
}

/// By scalar value, the same order `<` on a `Char` gives.
export fn char(a: Char, b: Char): Order {
    int(a.toU32().toI64(), b.toU32().toI64())
}

impl Order {
    /// Chains two comparisons: the second decides only when the first is `Equal`.
    export fn then(self, next: Order): Order {
        match (self) {
            .Equal => next,
            other => other,
        }
    }
}
