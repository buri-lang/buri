//! core/set — a hash set.
//!
//! A `Map<T, ()>`, which is what a set is. Everything true of `core/map` is true
//! here: expected-constant membership, an insert that copies the bucket spine,
//! and an iteration order that follows the hashes, which you should not rely on.
//!
//! It is a wrapper rather than an alias so that `insert` takes one argument
//! instead of two, and so that `union` can exist.
//!
//! ```buri run
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/list" import * as list;
//! from "core/set" import * as set;
//! from "core/str" import * as str;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let a = set.of(ctx, [1, 2, 2, 3]);
//!     let b = set.of(ctx, [3, 4]);
//!     // Sorted for printing: the iteration order follows the hashes, and is
//!     // deliberately not something to rely on.
//!     let all = a.union(ctx, b).toList(ctx).sort(ctx);
//!     let shown = all.mapCtx(ctx, fn(c, i) => str.fromInt(c, i)).join(ctx, " ");
//!     let _ = io.println(ctx, "${a.length()} unique, union ${shown}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 3 unique, union 1 2 3 4
//! ```

from "core/effect" import { Allocator };
from "core/list" import * as list;
from "core/map" import * as map;
from "core/map" import { Map };

export struct Set<T> {
    entries: Map<T, ()>,
}

/// The empty set. Pure, for the same reason `map.empty` is.
export fn empty<T>(): Set<T> {
    Set { entries: map.empty<T, ()>() }
}

/// A set holding the given items, duplicates collapsed.
export fn of<T: Hash + Equal, C: Allocator>(ctx: C, items: [T]): Set<T> {
    items.foldCtx(ctx, fn(c, acc, x) => acc.insert(c, x), empty<T>())
}

impl<T: Hash + Equal> Set<T> {
    export fn length(self): Int {
        self.entries.length()
    }

    export fn isEmpty(self): Bool {
        self.entries.isEmpty()
    }

    export fn has(self, item: T): Bool {
        self.entries.has(item)
    }

    export fn insert<C: Allocator>(self, ctx: C, item: T): Set<T> {
        Set { entries: self.entries.insert(ctx, item, ()) }
    }

    export fn remove<C: Allocator>(self, ctx: C, item: T): Set<T> {
        Set { entries: self.entries.remove(ctx, item) }
    }

    /// Every member, in no particular order.
    export fn toList<C: Allocator>(self, ctx: C): [T] {
        self.entries.keys(ctx)
    }

    export fn union<C: Allocator>(self, ctx: C, other: Set<T>): Set<T> {
        other.toList(ctx).foldCtx(ctx, fn(c, acc, x) => acc.insert(c, x), self)
    }

    export fn intersect<C: Allocator>(self, ctx: C, other: Set<T>): Set<T> {
        let theirs = other;
        let kept = self.toList(ctx).filterCtx(ctx, fn(_c, x) => theirs.has(x));
        of(ctx, kept)
    }

    /// The members of `self` that are not in `other`.
    export fn difference<C: Allocator>(self, ctx: C, other: Set<T>): Set<T> {
        let theirs = other;
        let kept = self.toList(ctx).filterCtx(ctx, fn(_c, x) => !theirs.has(x));
        of(ctx, kept)
    }

    export fn isSubsetOf<C: Allocator>(self, ctx: C, other: Set<T>): Bool {
        let theirs = other;
        self.toList(ctx).all(fn(x) => theirs.has(x))
    }

    /// Whether every member of `other` is also in `self`. `isSubsetOf` read
    /// from the other end.
    export fn isSupersetOf<C: Allocator>(self, ctx: C, other: Set<T>): Bool {
        other.isSubsetOf(ctx, self)
    }

    /// The members in exactly one of the two.
    export fn symmetricDifference<C: Allocator>(self, ctx: C, other: Set<T>): Set<T> {
        self.difference(ctx, other).union(ctx, other.difference(ctx, self))
    }

    /// Whether the two share no member at all.
    ///
    /// **It builds no set.** `intersect` then `isEmpty` allocates the whole
    /// intersection to ask a yes-or-no question; this walks the smaller side and
    /// stops at the first member the other one holds.
    export fn isDisjointFrom<C: Allocator>(self, ctx: C, other: Set<T>): Bool {
        // Walk the shorter list against the other's constant-time membership.
        if (self.length() <= other.length()) {
            let theirs = other;
            self.toList(ctx).all(fn(x) => !theirs.has(x))
        } else {
            let mine = self;
            other.toList(ctx).all(fn(x) => !mine.has(x))
        }
    }

    /// The members `keep` answers true for.
    export fn filter<C: Allocator>(self, ctx: C, keep: fn(T) => Bool): Set<T> {
        of(ctx, self.toList(ctx).filterCtx(ctx, fn(_c, x) => keep(x)))
    }

    /// Same members, whatever order either was built in.
    export fn equals<C: Allocator>(self, ctx: C, other: Set<T>): Bool {
        self.length() == other.length() && self.isSubsetOf(ctx, other)
    }
}

/// The list with later duplicates dropped, the first of each kept and the order
/// left alone.
///
/// **O(n).** It carries a set of what it has seen, so each element costs one
/// expected-constant membership test — where `core/list`'s `uniqueBy` asks
/// about everything already kept and costs O(n²) comparisons. That one takes a
/// comparison function and works on anything; this one needs `Hash + Equal`.
///
/// A free function rather than a method on `[T]`, for `map.groupBy`'s reason:
/// `core/list` is the bottom of the dependency order and cannot name a `Set`.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/set" import * as set;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let names = ["ana", "bo", "ana", "cy", "bo"];
///     let once = set.distinct(ctx, names).join(ctx, " ");
///     let _ = io.println(ctx, once).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// ana bo cy
/// ```
export fn distinct<T: Hash + Equal, C: Allocator>(ctx: C, xs: [T]): [T] {
    let (kept, _seen) = xs.foldCtx(
        ctx,
        fn(c, acc: ([T], Set<T>), x) => {
            let (out, seen) = acc;
            if (seen.has(x)) { acc } else { (out.push(c, x), seen.insert(c, x)) }
        },
        (list.empty<T>(), empty<T>()),
    );
    kept
}

/// [`distinct`] over a key: the first element answering each key is kept, and
/// the rest go. O(n), and one `key` call per element.
export fn distinctBy<A, K: Hash + Equal, C: Allocator>(
    ctx: C,
    xs: [A],
    key: fn(A) => K,
): [A] {
    let (kept, _seen) = xs.foldCtx(
        ctx,
        fn(c, acc: ([A], Set<K>), x) => {
            let (out, seen) = acc;
            let k = key(x);
            if (seen.has(k)) { acc } else { (out.push(c, x), seen.insert(c, k)) }
        },
        (list.empty<A>(), empty<K>()),
    );
    kept
}
