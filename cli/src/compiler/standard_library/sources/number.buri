//! core/number — the defining module of every integer and float type.
//!
//! Two names, one set of types. `Int` and `Float` are aliases for `I64` and
//! `F64`, not a separate tier, so everyday code and code that names an exact
//! width interoperate with no conversion at the boundary.
//!
//! Each is its own width, and every backend holds that whole width. On a
//! native backend a width is a width and arithmetic is two's complement. On the
//! JavaScript backend the widths up to 32 bits are a `number` and the widths at
//! 64 bits and above are a `BigInt`, which is exact but is a heap value: code
//! on a hot path that does not need the range can say `I32` and get the
//! cheaper one.
//!
//! Overflow and underflow are undefined behaviour (SPEC 6.2), and that is where
//! the two still part: a width wraps and a `BigInt` does not. `Wrapping`,
//! `Checked` and `Saturating` are the three ways to ask for a defined answer at
//! the boundary, and each means the same thing everywhere.
//!
//! The compiler declares the conversion methods — `toI64`, `wrapToU8`, and the
//! rest, one per source-and-target pair — on the primitive types themselves.
//! They resolve by the receiver's type, so `i32.toI64()` and `i64.toI32()` are
//! different operations with different return types. `buri query` and the
//! language reference list them. SPEC 6.2.1 gives the three shapes:
//!
//!   x.toT()      where every value fits  -> T
//!   x.toT()      where it might not      -> Result<T, RangeError>
//!   x.wrapToT()  modular                 -> T
//!
//! The compiler also declares, per primitive: `abs`, `signum`, `compare`, `eq`,
//! `show`, `hash`, the operator-trait methods, and the `Checked`, `Wrapping` and
//! `Saturating` method sets.

from "core/bits" import * as bits;
from "core/character" import * as character;
from "core/effect" import { Allocator };
from "core/list" import * as list;
from "core/order" import { Eq, Ord, Order, Show };
from "core/str" import * as str;

derive Eq, Show for RangeError;
/// The error a narrowing conversion returns. A conversion's return type says
/// whether it can fail; the choice of operator does not.
export struct RangeError {
    export value: Str,
    export target: Str,
}

// --- The operator traits ------------------------------------------------------
//
// An operator implementation cannot allocate or perform an effect: `a + b` has
// no argument position through which a context could be passed. So you cannot
// write an expensive `+` in this language.

export trait Add {
    fn add(self, other: Self): Self;
}

export trait Sub {
    fn sub(self, other: Self): Self;
}

export trait Mul {
    fn mul(self, other: Self): Self;
}

export trait Div {
    fn div(self, other: Self): Self;
}

export trait Rem {
    fn rem(self, other: Self): Self;
}

export trait Neg {
    fn neg(self): Self;
}

// --- Integer-specific interfaces ------------------------------------------------
//
// Named for what they provide, not for the representation behind them. Every
// built-in integer type satisfies all three; the float types satisfy `Bounded`
// only.

export trait Bounded {
    fn minValue(): Self;
    fn maxValue(): Self;
}

/// Every one of these answers `.None` rather than a value the type cannot hold.
/// `.None` means out of the type's range and nothing else, so `.Some(v)` always
/// promises that `v` is the answer (SPEC 6.2.2).
export trait Checked {
    fn checkedAdd(self, rhs: Self): Option<Self>;
    fn checkedSub(self, rhs: Self): Option<Self>;
    fn checkedMul(self, rhs: Self): Option<Self>;
    fn checkedDiv(self, rhs: Self): Option<Self>;
    /// `.None` on a zero divisor, and on nothing else: a remainder is always
    /// smaller than what it came from, so it cannot leave the type's range.
    /// `minValue.checkedRemainder(-1)` is `.Some(0)`, where the matching
    /// division is `.None`.
    fn checkedRemainder(self, other: Self): Option<Self>;
    /// `.None` at `minValue`, whose negation is one past `maxValue`, and at
    /// every non-zero value of an unsigned type.
    fn checkedNegate(self): Option<Self>;
    /// `.None` on overflow and on a negative exponent, which is a fraction.
    /// `checkedPower(0)` is `.Some(1)` at every base.
    ///
    /// The exponent is an `Int` whatever `Self` is: it counts multiplications
    /// rather than being one of the values multiplied.
    fn checkedPower(self, exponent: Int): Option<Self>;
}

export trait Wrapping {
    fn wrappingAdd(self, rhs: Self): Self;
    fn wrappingSub(self, rhs: Self): Self;
    fn wrappingMul(self, rhs: Self): Self;
}

/// Clamps to the type's own bounds, which at 64 bits and above are themselves
/// rounded: `maxValue<I64>()` is the nearest `number` to I64's maximum, not that
/// maximum. Use `Checked` where the difference matters.
export trait Saturating {
    fn saturatingAdd(self, rhs: Self): Self;
    fn saturatingSub(self, rhs: Self): Self;
    fn saturatingMul(self, rhs: Self): Self;
}

// --- Free functions -------------------------------------------------------------
//
// These are generic over a bound rather than declared per type, so there is
// one of each and no overloading.

export fn min<T: Ord>(a: T, b: T): T {
    if (a.compare(b) == Order.Greater) { b } else { a }
}

export fn max<T: Ord>(a: T, b: T): T {
    if (a.compare(b) == Order.Less) { b } else { a }
}

export fn clamp<T: Ord>(lo: T, hi: T, x: T): T {
    min(hi, max(lo, x))
}

// --- Floor division and the Euclidean remainder ---------------------------------
//
// `Int` only. Rounding toward negative infinity is a fact about the integers;
// on a float, `math.floor(a / b)` says the same thing.
//
// Both abort on a zero divisor, because both are written in terms of `/` and `%`
// and that is what those do (SPEC 6.2).

/// `a / b` rounded toward negative infinity rather than toward zero, so the
/// quotient does not jump at the origin: `divFloor(-1, 2)` is `-1` where
/// `-1 / 2` is `0`.
///
/// **Pairs with `remEuclid` only for a positive `b`.** The two round differently
/// below zero — `divFloor` follows the sign of the divisor and `remEuclid` is
/// never negative — so `divFloor(a, b) * b + remEuclid(a, b)` is `a` when
/// `b > 0` and need not be when `b < 0`.
///
/// Aborts if `b` is zero, exactly as `a / b` does.
export fn divFloor(a: Int, b: Int): Int {
    let q = a / b;
    let r = a % b;
    // `%` takes the sign of the dividend, so a non-zero remainder whose sign
    // disagrees with the divisor is a quotient `/` rounded the other way.
    if (r == 0) {
        q
    } else if (b > 0) {
        if (r < 0) { q - 1 } else { q }
    } else if (r > 0) {
        q - 1
    } else {
        q
    }
}

/// The remainder that is never negative: `remEuclid(a, b)` is at least zero and
/// less than `b.abs()` for every non-zero `b`, where `a % b` takes the sign of
/// `a`.
///
/// This is `(x % n + n) % n` written once, and correct for a negative `n` as
/// well, which that idiom is not.
///
/// Aborts if `b` is zero, exactly as `a % b` does.
export fn remEuclid(a: Int, b: Int): Int {
    let r = a % b;
    if (r >= 0) { r } else if (b < 0) { r - b } else { r + b }
}

/// `Bounded`'s methods take no `self`, so you reach them through these rather
/// than through a receiver: `number.maxValue<U8>()`.
export fn minValue<T: Bounded>(): T;

export fn maxValue<T: Bounded>(): T;

// --- Hexadecimal ------------------------------------------------------------------
//
// The other direction — hexadecimal text back to a number — is
// `str.toRadix(text, 16)`.

/// `x` in lowercase hexadecimal, zero-padded to at least `width` digits.
///
/// **A bit pattern, not a signed numeral.** The digits are `x`'s 64-bit two's
/// complement, so `toHex(ctx, -1, 0)` is `ffffffffffffffff` and not `-1`, and
/// `toHex(ctx, x, 16)` is the sixteen digits of a `U64` whichever end of the
/// range `x` came from.
///
/// `width` is a floor and never truncates: a value needing more digits than
/// asked for gets them. `width` at or below zero asks for the shortest form,
/// which is one digit for zero.
export fn toHex<C: Allocator>(ctx: C, x: Int, width: Int): Str {
    let digits = max(width, significantNibbles(x, 16));
    str.fromChars(
        ctx,
        list
            .range(ctx, 0, digits)
            .map(ctx, fn(i) => {
                let shift = (digits - 1 - i) * 4;
                // Past the width of the type there is nothing left but the padding,
                // and `shr` at or beyond 64 has no answer to give.
                let nibble = if (shift >= 64) {
                    0
                } else {
                    lowNibble(bits.shr(x, shift))
                };
                character.fromDigit(nibble, 16).withDefault('0')
            }),
    )
}

/// The lowest four bits of a value, as a number from 0 to 15. A shift up and
/// back rather than `% 16`, because the input is a logical shift of a possibly
/// negative `Int` and `%` keeps the sign.
fn lowNibble(x: Int): Int {
    bits.shr(bits.shl(x, 60), 60)
}

/// How many hexadecimal digits `x` needs, counting down from `upper` — 16 for
/// any negative number, since its top bit is set, and never fewer than one.
fn significantNibbles(x: Int, upper: Int): Int {
    if (upper <= 1) {
        1
    } else if (bits.shr(x, (upper - 1) * 4) != 0) {
        upper
    } else {
        significantNibbles(x, upper - 1)
    }
}

// --- Integer arithmetic ----------------------------------------------------------
//
// `Int` only, and every one written out of `/`, `%` and `Checked`. `math.pow`
// is the `Float` answer to `power` and rounds; these do not.

/// `base` raised to `exponent`, or `.None` when the answer is not an `Int`.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn cube(x: Int): Option<Int> {
///     number.power(x, 3)
/// }
/// ```
///
/// A negative exponent is `.None` — the answer is a fraction and `Int` holds
/// none. `power(0, 0)` is `.Some(1)`, the empty product.
///
/// Exponentiation by squaring, so it costs about `log2(exponent)`
/// multiplications, and every one of them is `checkedMul` rather than `*`.
export fn power(base: Int, exponent: Int): Option<Int> {
    if (exponent < 0) { .None } else { squaring(base, exponent, 1) }
}

/// One round of squaring: fold the low bit of `exponent` into `acc`, square the
/// base, halve the exponent.
///
/// The square is taken only when a further round needs it, so `power(x, 1)`
/// never asks whether `x * x` fits.
fn squaring(base: Int, exponent: Int, acc: Int): Option<Int> {
    if (exponent == 0) {
        .Some(acc)
    } else {
        let folded = if (exponent % 2 == 1) {
            acc.checkedMul(base)
        } else {
            .Some(acc)
        };
        folded.andThen(fn(a) => {
            let half = exponent / 2;
            if (half == 0) {
                .Some(a)
            } else {
                base.checkedMul(base).andThen(fn(b) => squaring(b, half, a))
            }
        })
    }
}

/// The largest number that divides both, never negative.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn simplify(top: Int, bottom: Int): (Int, Int) {
///     let g = number.greatestCommonDivisor(top, bottom);
///     if (g == 0) { (top, bottom) } else { (top / g, bottom / g) }
/// }
/// ```
///
/// `greatestCommonDivisor(0, 0)` is `0`. Sign is ignored, so `(-12, 18)` and
/// `(12, 18)` both answer `6`.
///
/// **Three pairs answer a negative number**, and only these three:
/// `(minValue, 0)`, `(0, minValue)` and `(minValue, minValue)`. Each one's
/// common divisor is `2^63`, which is not an `Int`, so what comes back is
/// `minValue` — the bit pattern of that magnitude read as a signed number.
export fn greatestCommonDivisor(a: Int, b: Int): Int {
    magnitude(euclid(a, b))
}

/// Euclid's algorithm, tail-recursive.
///
/// `±1` is answered rather than divided into, because `minValue % -1` is the
/// one remainder a machine has no room for.
fn euclid(a: Int, b: Int): Int {
    if (b == 0) { a } else if (b == 1 || b == -1) { 1 } else { euclid(b, a % b) }
}

/// `|x|`, with `minValue` left alone: its magnitude is not an `Int`.
fn magnitude(x: Int): Int {
    if (x < 0 && x != minValue<Int>()) { 0 - x } else { x }
}

/// The smallest positive number both divide, or `.None` when it is not an
/// `Int`.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn together(everyA: Int, everyB: Int): Option<Int> {
///     number.leastCommonMultiple(everyA, everyB)
/// }
/// ```
///
/// A zero either side answers `.Some(0)`. Sign is ignored, as it is for
/// `greatestCommonDivisor`.
export fn leastCommonMultiple(a: Int, b: Int): Option<Int> {
    if (a == 0 || b == 0) {
        .Some(0)
    } else {
        // Divide before multiplying, so what is tested for overflow is the
        // answer rather than `a * b`, which leaves the range far sooner.
        let scaled = a / greatestCommonDivisor(a, b);
        scaled
            .checkedMul(b)
            .andThen(fn(p) => {
                if (p == minValue<Int>()) { .None } else { .Some(magnitude(p)) }
            })
    }
}

/// The quotient that pairs with `remEuclid`, so
/// `divideEuclidean(a, b) * b + remEuclid(a, b)` is `a` for every non-zero `b`
/// — a negative one included, where `divFloor` and `remEuclid` part company.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn week(day: Int): Int {
///     number.divideEuclidean(day, 7)
/// }
/// ```
///
/// Aborts on a zero divisor, exactly as `a / b` does.
export fn divideEuclidean(dividend: Int, divisor: Int): Int {
    let q = dividend / divisor;
    if (dividend % divisor >= 0) { q } else if (divisor > 0) { q - 1 } else { q + 1 }
}

/// `dividend / divisor` rounded toward positive infinity, so
/// `divideCeiling(7, 2)` is `4` where `7 / 2` is `3`.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn pages(items: Int, perPage: Int): Int {
///     number.divideCeiling(items, perPage)
/// }
/// ```
///
/// Aborts on a zero divisor, exactly as `a / b` does.
export fn divideCeiling(dividend: Int, divisor: Int): Int {
    let q = dividend / divisor;
    let r = dividend % divisor;
    if (r == 0) { q } else if ((r > 0) == (divisor > 0)) { q + 1 } else { q }
}

/// Both halves of a division in one call: `(dividend / divisor,
/// dividend % divisor)`, truncated toward zero as the two operators are.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn hoursAndMinutes(minutes: Int): (Int, Int) {
///     number.quotientRemainder(minutes, 60)
/// }
/// ```
///
/// Aborts on a zero divisor, exactly as `a / b` does.
export fn quotientRemainder(dividend: Int, divisor: Int): (Int, Int) {
    (dividend / divisor, dividend % divisor)
}

/// The largest `r` with `r * r <= value`, or `.None` for a negative `value`.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn side(area: Int): Option<Int> {
///     number.integerSquareRoot(area)
/// }
/// ```
///
/// Exact, which `math.sqrt(x.toF64())` stops being above `2^53`.
///
/// Newton's method from a power of two above the answer: about six divisions
/// for a small number and never more than thirty-three.
export fn integerSquareRoot(value: Int): Option<Int> {
    if (value < 0) {
        .None
    } else if (value == 0) {
        .Some(0)
    } else {
        // Half the bit length, rounded up. At or above the root for every
        // `value`, and at most `2^32`, so `x + value / x` stays inside `Int`.
        .Some(newton(value, bits.shl(1, (65 - bits.leadingZeros(value)) / 2)))
    }
}

/// Newton's iteration, which descends to the root and then stops falling.
fn newton(value: Int, x: Int): Int {
    let next = (x + value / x) / 2;
    if (next >= x) { x } else { newton(value, next) }
}

/// `|a - b|`, without the sign question either subtraction alone would raise.
///
/// ```buri
/// from "core/number" import * as number;
///
/// export fn apart(a: Int, b: Int): Int {
///     number.absoluteDifference(a, b)
/// }
/// ```
///
/// The difference itself still has to be an `Int`:
/// `absoluteDifference(maxValue, minValue)` is `2^64 - 1`, and overflow is
/// undefined (SPEC 6.2).
export fn absoluteDifference(a: Int, b: Int): Int {
    if (a >= b) { a - b } else { b - a }
}

/// `value` written in `radix`, base 2 to base 36, with lowercase letters past
/// nine.
///
/// ```buri
/// from "core/effect" import { Allocator };
/// from "core/number" import * as number;
///
/// export fn binary<C: Allocator>(ctx: C, n: Int): Str {
///     number.toRadix(ctx, n, 2)
/// }
/// ```
///
/// **A signed numeral, not a bit pattern.** `toRadix(ctx, -5, 2)` is `-101`
/// where `toHex(ctx, -5, 0)` is the two's complement. `str.toRadix` reads back
/// exactly what this writes.
///
/// A radix outside 2 to 36 is clamped into it: there is no digit alphabet past
/// either end, and the signature has no room to say so.
export fn toRadix<C: Allocator>(ctx: C, value: Int, radix: Int): Str {
    let base = clamp(2, 36, radix);
    if (value == 0) {
        "0"
    } else {
        // Counted down from zero rather than up from the magnitude, because
        // `minValue`'s magnitude is not an `Int` and its digits still are.
        let below = if (value < 0) { value } else { 0 - value };
        let digits = countDown(ctx, below, base, []);
        str.fromChars(ctx, if (value < 0) { ['-'].concat(ctx, digits) } else { digits })
    }
}

/// The digits of a number at or below zero, most significant first.
fn countDown<C: Allocator>(ctx: C, n: Int, base: Int, acc: [Char]): [Char] {
    let digit = character.fromDigit(0 - n % base, base).withDefault('0');
    let rest = n / base;
    let next = [digit].concat(ctx, acc);
    if (rest == 0) { next } else { countDown(ctx, rest, base, next) }
}
