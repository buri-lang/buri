//! core/num — the defining module of every integer and float type.
//!
//! Two names, one set of types. `Int` and `Float` are aliases for `I64` and
//! `F64`, not a separate tier, so everyday code and code that names an exact
//! width interoperate with no conversion at the boundary.
//!
//! Each is its own width, and every backend holds that whole width. On a
//! native backend a width is a width and arithmetic is two's complement. On the
//! JavaScript backend the widths up to 32 bits are a `number` and the widths at
//! 64 bits and above are a `BigInt`, which is exact but is a heap value: code
//! on a hot path that does not need the range can say `I32` and get the
//! cheaper one.
//!
//! Overflow and underflow are undefined behaviour (SPEC 6.2), and that is where
//! the two still part: a width wraps and a `BigInt` does not. `Wrapping`,
//! `Checked` and `Saturating` are the three ways to ask for a defined answer at
//! the boundary, and each means the same thing everywhere.
//!
//! The conversion methods — `toI64`, `wrapToU8`, and the rest, one per
//! source-and-target pair — are declared by the compiler on the primitive types
//! themselves rather than written out here. They are methods, resolved by the
//! receiver's type, so `i32.toI64()` and `i64.toI32()` are different operations
//! with different return types and no overloading is involved. `buri query` and
//! the language reference list them; SPEC 6.2.1 gives the three shapes:
//!
//!   x.toT()      where every value fits  -> T
//!   x.toT()      where it might not      -> Result<T, RangeError>
//!   x.wrapToT()  modular                 -> T
//!
//! Also declared by the compiler, per primitive: `abs`, `signum`, `compare`,
//! `eq`, `show`, `hash`, the operator-trait methods, and the `Checked`,
//! `Wrapping` and `Saturating` method sets.

from "core/bits" import * as bits;
from "core/char" import * as char;
from "core/effect" import { Alloc };
from "core/list" import * as list;
from "core/order" import { Eq, Ord, Order, Show };
from "core/str" import * as str;

derive Eq, Show for RangeError;
/// The error a narrowing conversion returns. Whether a conversion can fail is
/// visible in its return type rather than in the choice of operator.
export struct RangeError {
    export value: Str,
    export target: Str,
}

// --- The operator traits ------------------------------------------------------
//
// An operator implementation cannot allocate or perform an effect: `a + b` has
// no argument position through which a context could be passed. You cannot
// write an expensive `+` in this language, which is why operator traits are
// safe here in a way they are not elsewhere.

export trait Add {
    fn add(self, other: Self): Self;
}

export trait Sub {
    fn sub(self, other: Self): Self;
}

export trait Mul {
    fn mul(self, other: Self): Self;
}

export trait Div {
    fn div(self, other: Self): Self;
}

export trait Rem {
    fn rem(self, other: Self): Self;
}

export trait Neg {
    fn neg(self): Self;
}

// --- Integer-specific interfaces ------------------------------------------------
//
// Named for what they provide, not for the representation behind them. Every
// built-in integer type satisfies all three; the float types satisfy `Bounded`
// only.

export trait Bounded {
    fn minValue(): Self;
    fn maxValue(): Self;
}

/// Every one of these answers `.None` rather than a value the type cannot
/// hold, which means outside the type's range and nothing else — every backend
/// represents every value of every integer type. So `.Some(v)` is always a
/// promise that `v` is the answer, which is the whole reason to reach for
/// `Checked` over `+` (SPEC 6.2.2).
export trait Checked {
    fn checkedAdd(self, rhs: Self): Option<Self>;
    fn checkedSub(self, rhs: Self): Option<Self>;
    fn checkedMul(self, rhs: Self): Option<Self>;
    fn checkedDiv(self, rhs: Self): Option<Self>;
}

export trait Wrapping {
    fn wrappingAdd(self, rhs: Self): Self;
    fn wrappingSub(self, rhs: Self): Self;
    fn wrappingMul(self, rhs: Self): Self;
}

/// Clamps to the type's own bounds, which at 64 bits and above are themselves
/// rounded — `maxValue<I64>()` is the nearest `number` to I64's maximum, not
/// that maximum. Use `Checked` where the difference matters.
export trait Saturating {
    fn saturatingAdd(self, rhs: Self): Self;
    fn saturatingSub(self, rhs: Self): Self;
    fn saturatingMul(self, rhs: Self): Self;
}

// --- Free functions -------------------------------------------------------------
//
// These are generic over a bound rather than declared per type, so there is
// one of each and no overloading.

export fn min<T: Ord>(a: T, b: T): T {
    if (a.compare(b) == Order.Greater) { b } else { a }
}

export fn max<T: Ord>(a: T, b: T): T {
    if (a.compare(b) == Order.Less) { b } else { a }
}

export fn clamp<T: Ord>(lo: T, hi: T, x: T): T {
    min(hi, max(lo, x))
}

// --- Floor division and the Euclidean remainder ---------------------------------
//
// `Int` only, and generic over nothing. `/` and `%` are the operator traits of
// SPEC 6.2 and every numeric type has them, but rounding toward negative
// infinity is a fact about the integers: on a float `math.floor(a / b)` is the
// same idea written where it belongs, and on an unsigned type there is no
// second answer for these to give. So these two take `Int` and say so, rather
// than taking a `T: Div + Rem + Ord` that would compile at `F64` and mean
// something else.
//
// Both abort on a zero divisor, because both are written in terms of `/` and
// `%` and that is what those do (SPEC 6.2): there is no answer to give, and an
// `Option` in the signature would put a `.withDefault` at every call site of a
// function that cannot fail for any divisor a caller meant to pass.

/// `a / b` rounded toward negative infinity rather than toward zero, so the
/// quotient does not jump at the origin: `divFloor(-1, 2)` is `-1` where
/// `-1 / 2` is `0`.
///
/// **Pairs with `remEuclid` only for a positive `b`**, which is every caller in
/// `core/date` and the case this exists for. The two round differently below
/// zero — `divFloor` follows the sign of the divisor and `remEuclid` is never
/// negative — so `divFloor(a, b) * b + remEuclid(a, b)` is `a` when `b > 0` and
/// need not be when `b < 0`.
///
/// Aborts if `b` is zero, exactly as `a / b` does.
export fn divFloor(a: Int, b: Int): Int {
    let q = a / b;
    let r = a % b;
    // `%` takes the sign of the dividend, so a non-zero remainder whose sign
    // disagrees with the divisor is a quotient `/` rounded the other way.
    if (r == 0) {
        q
    } else if (b > 0) {
        if (r < 0) { q - 1 } else { q }
    } else if (r > 0) {
        q - 1
    } else {
        q
    }
}

/// The remainder that is never negative: `remEuclid(a, b)` is at least zero and
/// less than `b.abs()` for every non-zero `b`, where `a % b` takes the sign of
/// `a`.
///
/// This is what a program means by "which day of the week", "which bucket" or
/// "which digit" — `(x % n + n) % n` written once, and correct for a negative
/// `n` as well, which that idiom is not.
///
/// Aborts if `b` is zero, exactly as `a % b` does.
export fn remEuclid(a: Int, b: Int): Int {
    let r = a % b;
    if (r >= 0) { r } else if (b < 0) { r - b } else { r + b }
}

/// `Bounded`'s methods take no `self`, so they are reached through these
/// rather than through a receiver: `num.maxValue<U8>()`.
export fn minValue<T: Bounded>(): T;

export fn maxValue<T: Bounded>(): T;

// --- Hexadecimal ------------------------------------------------------------------
//
// The other direction — hexadecimal text back to a number — is
// `str.toRadix(text, 16)`, on `Str` because that is where a parse of a string
// belongs. This half is here rather than in `core/str` for the same reason:
// `toHex` is a fact about a number, and `str.fromInt` is the base-ten case of
// exactly this.

/// `x` in lowercase hexadecimal, zero-padded to at least `width` digits.
///
/// **A bit pattern, not a signed numeral.** The digits are `x`'s 64-bit two's
/// complement, so `toHex(ctx, -1, 0)` is `ffffffffffffffff` and not `-1`. That
/// is what a hexadecimal view of a number is for, and it is what makes
/// `toHex(ctx, x, 16)` the sixteen digits of a `U64` whichever end of the range
/// `x` came from.
///
/// `width` is a floor and never truncates: a value needing more digits than
/// asked for gets them, so no call of this can silently lose the top of a
/// number. `width` at or below zero asks for the shortest form, which is one
/// digit for zero.
export fn toHex<C: Alloc>(ctx: C, x: Int, width: Int): Str {
    let digits = max(width, significantNibbles(x, 16));
    str.fromChars(
        ctx,
        list
            .range(ctx, 0, digits)
            .map(ctx, fn(i) => {
                let shift = (digits - 1 - i) * 4;
                // Past the width of the type there is nothing left but the padding,
                // and `shr` at or beyond 64 has no answer to give.
                let nibble = if (shift >= 64) {
                    0
                } else {
                    lowNibble(bits.shr(x, shift))
                };
                char.fromDigit(nibble, 16).withDefault('0')
            }),
    )
}

/// The lowest four bits of a value, as a number from 0 to 15. Written as a
/// shift up and back rather than as `% 16`, because the input here is a
/// logical shift of a possibly negative `Int` and `%` keeps the sign.
fn lowNibble(x: Int): Int {
    bits.shr(bits.shl(x, 60), 60)
}

/// How many hexadecimal digits `x` needs, counting down from `upper` — 16 for
/// any negative number, since its top bit is set, and never fewer than one.
fn significantNibbles(x: Int, upper: Int): Int {
    if (upper <= 1) {
        1
    } else if (bits.shr(x, (upper - 1) * 4) != 0) {
        upper
    } else {
        significantNibbles(x, upper - 1)
    }
}
