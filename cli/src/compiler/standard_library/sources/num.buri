//! core/num — the defining module of every integer and float type.
//!
//! Two names, one set of types. `Int` and `Float` are aliases for `I64` and
//! `F64`, not a separate tier, so everyday code and code that names an exact
//! width interoperate with no conversion at the boundary.
//!
//! Each is its own width, and what that costs depends on where the program
//! runs. On a native backend a width is a width and arithmetic is two's
//! complement. On the JavaScript backend every one of them is a `number`, which
//! represents every integer up to 2^53 exactly and nothing above it. Overflow
//! and underflow are undefined behaviour (SPEC 6.2), so both are inside what
//! the language promises, and the difference between them is why it promises
//! nothing: pinning either would be pinning a backend. Where a program needs an
//! exact answer above 2^53 whichever backend it is on, `core/bits` computes on
//! the bit pattern rather than the value.
//!
//! The conversion methods — `toI64`, `wrapToU8`, and the rest, one per
//! source-and-target pair — are declared by the compiler on the primitive types
//! themselves rather than written out here. They are methods, resolved by the
//! receiver's type, so `i32.toI64()` and `i64.toI32()` are different operations
//! with different return types and no overloading is involved. `buri query` and
//! the language reference list them; SPEC 6.2.1 gives the three shapes:
//!
//!   x.toT()      where every value fits  -> T
//!   x.toT()      where it might not      -> Result<T, RangeError>
//!   x.wrapToT()  modular                 -> T
//!
//! Also declared by the compiler, per primitive: `abs`, `signum`, `compare`,
//! `eq`, `show`, `hash`, the operator-trait methods, and the `Checked` and
//! `Wrapping` method sets.

from "core/order" import { Eq, Ord, Order, Show };

/// The error a narrowing conversion returns. Whether a conversion can fail is
/// visible in its return type rather than in the choice of operator.
export struct RangeError {
  export value: Str,
  export target: Str,
}

derive Eq, Show for RangeError;

// --- The operator traits ------------------------------------------------------
//
// An operator implementation cannot allocate or perform an effect: `a + b` has
// no argument position through which a context could be passed. You cannot
// write an expensive `+` in this language, which is why operator traits are
// safe here in a way they are not elsewhere.

export trait Add {
  fn add(self, other: Self): Self;
}

export trait Sub {
  fn sub(self, other: Self): Self;
}

export trait Mul {
  fn mul(self, other: Self): Self;
}

export trait Div {
  fn div(self, other: Self): Self;
}

export trait Rem {
  fn rem(self, other: Self): Self;
}

export trait Neg {
  fn neg(self): Self;
}

// --- Integer-specific interfaces ------------------------------------------------
//
// Named for what they provide, not for the representation behind them. Every
// built-in integer type satisfies all three; the float types satisfy `Bounded`
// only.

export trait Bounded {
  fn minValue(): Self;
  fn maxValue(): Self;
}

/// Every one of these answers `.None` rather than a value the type cannot
/// hold. "Cannot hold" means outside the type's range, and — on a backend that
/// does not represent every value of the type exactly — above what it does
/// represent: on JavaScript that is 2^53, where a `number` stops being an
/// integer. So `.Some(v)` is always a promise that `v` is the answer, which is
/// the whole reason to reach for `Checked` over `+`, and a backend that cannot
/// keep the promise declines to make it (SPEC 6.2.2).
export trait Checked {
  fn checkedAdd(self, rhs: Self): Option<Self>;
  fn checkedSub(self, rhs: Self): Option<Self>;
  fn checkedMul(self, rhs: Self): Option<Self>;
  fn checkedDiv(self, rhs: Self): Option<Self>;
}

export trait Wrapping {
  fn wrappingAdd(self, rhs: Self): Self;
  fn wrappingSub(self, rhs: Self): Self;
  fn wrappingMul(self, rhs: Self): Self;
}

/// Clamps to the type's own bounds, which at 64 bits and above are themselves
/// rounded — `maxValue<I64>()` is the nearest `number` to I64's maximum, not
/// that maximum. Use `Checked` where the difference matters.
export trait Saturating {
  fn saturatingAdd(self, rhs: Self): Self;
  fn saturatingSub(self, rhs: Self): Self;
  fn saturatingMul(self, rhs: Self): Self;
}

// --- Free functions -------------------------------------------------------------
//
// These are generic over a bound rather than declared per type, so there is
// one of each and no overloading.

export fn min<T: Ord>(a: T, b: T): T {
  if (a.compare(b) == Order.Greater) { b } else { a }
}

export fn max<T: Ord>(a: T, b: T): T {
  if (a.compare(b) == Order.Less) { b } else { a }
}

export fn clamp<T: Ord>(lo: T, hi: T, x: T): T {
  min(hi, max(lo, x))
}

/// `Bounded`'s methods take no `self`, so they are reached through these
/// rather than through a receiver: `num.maxValue<U8>()`.
export fn minValue<T: Bounded>(): T;
export fn maxValue<T: Bounded>(): T;
