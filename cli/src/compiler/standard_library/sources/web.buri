//! ui/web — a website: rendered on the server, resumed on the page.
//!
//! A website in Buri is one binary with two entries. A worker answers the
//! request: it builds the tree, renders it to HTML, and sends the document with
//! the state it rendered from embedded in it. A page picks that document up: it
//! reads the state back out, builds the same tree from it, and resumes on top of
//! the markup that arrived.
//!
//! ```buri
//! from "core/effect" import { Alloc };
//! from "core/json" import { Json };
//! from "core/net/http" import * as http;
//! from "core/net/http" import { Response };
//! from "ui/node" import * as ui;
//! from "ui/node" import { Node };
//! from "ui/prop" import { Prop };
//! from "ui/web" import * as web;
//!
//! /// The whole site, as one function of the path. The worker calls it with
//! /// `.Const(request.path())`; the page calls it with `web.route(ctx)`.
//! fn page<C>(path: Prop<Str>): Node<C> {
//!     ui.region(.Main, [], [ui.heading(1, [], path)])
//! }
//!
//! fn answer<C: Alloc>(ctx: C, path: Str, state: Json): Response {
//!     http.html(ctx, web.shell(ctx, path, web.render(page(.Const(path))), state))
//! }
//! ```
//!
//! **There is one renderer.** `render` is the one `mount` uses, pointed at a
//! document the runtime supplies rather than at a browser's, so what the worker
//! writes is what the page would have built.
//!
//! **A resumed page is live, and is not rebuilt.** `resume` runs that same
//! renderer against the document the reader is already looking at: each element
//! and each run of text is the one the server wrote, and what the walk adds is
//! the handlers and the computations. So a button works, a signal re-renders
//! the smallest thing that read it, and nothing flashes.
//!
//! **Routing is ordinary Buri.** There is no route table and no matcher: a page
//! function takes the path as a `Prop<Str>` and matches on it. The worker passes
//! `.Const(request.path())`, which reads once and registers nothing; the page
//! passes `route`, which re-runs what read it when the reader navigates.
//!
//! Everything here is JavaScript's. A native artifact has no document under it
//! and no address bar over it, so a native build that reaches one of these
//! stops at code generation naming the operation.

from "core/effect" import { Alloc };
from "core/json" import * as json;
from "core/json" import { Json };
from "ui/effect" import { Location, Ui, Watch };
from "ui/node" import { Node };
from "ui/prop" import { Prop };

// --- The server's half ---------------------------------------------------------

/// The tree as HTML: every element in order, every prop read once, every style
/// on the element it belongs to.
///
/// Reactivity is resolved rather than registered: a `Computed` prop is read
/// once, a `choose` renders the branch its condition takes, and an `each`
/// renders the rows the list has. Handlers are never called, because what this
/// answers is text.
///
/// An element that holds nothing still writes its closing tag — `<main></main>`
/// — except for the ones HTML says hold nothing, which close themselves:
/// `<img />`, `<input />`, `<hr />`. A parser reads `<main />` as an opening tag
/// and puts the rest of the page inside it.
export fn render<C>(root: Node<C>): Str;

/// The document `body` goes in, with `state` and the `path` it was rendered at
/// embedded in it for the page to pick up.
///
/// The state is written as JSON in a `<script id="buri-state">`, which a
/// browser neither runs nor renders, and `resume` reads it back. Every `<` in it
/// is written `\u003c`, which JSON reads back as `<`, so a string holding
/// `</script>` closes nothing.
///
/// `path` is the address this tree was rendered for — `request.path()` on a
/// worker. It rides on the same script as `data-path`, and `resume` refuses a
/// page whose address is somewhere else. Without it, two routes that render the
/// same *shape* resume into each other, and the reader is left looking at one
/// page's markup with another page's handlers on it.
///
/// The stylesheet the compiler extracted goes in the head. A resumed page keeps
/// the styles the server sent it.
export fn shell<C: Alloc>(ctx: C, path: Str, body: Str, state: Json): Str {
    let embedded = json.stringify(ctx, state).replace(ctx, "<", "\\u003c");
    let sheet = stylesheet();
    let styles = if (sheet == "") {
        ""
    } else {
        ["<style>", sheet, "</style>"].join(ctx, "")
    };
    [
        "<!doctype html>\n<html>\n<head><meta charset=\"utf-8\" />",
        styles,
        "</head>\n<body>",
        body,
        "<script id=\"buri-state\" type=\"application/json\" data-path=\"",
        attribute(ctx, path),
        "\">",
        embedded,
        "</script></body>\n</html>\n",
    ].join(ctx, "")
}

/// A string as the value of an attribute. `&` goes first, or the escapes escape
/// each other.
fn attribute<C: Alloc>(ctx: C, text: Str): Str {
    text
        .replace(ctx, "&", "&amp;")
        .replace(ctx, "<", "&lt;")
        .replace(ctx, ">", "&gt;")
        .replace(ctx, "\"", "&quot;")
}

/// The stylesheet the compiler extracted for this artifact.
///
/// Private: the one place it belongs is the document `shell` builds.
fn stylesheet(): Str;

// --- The page's half -----------------------------------------------------------

/// Takes over the page the server sent, with `root` — the tree the worker
/// rendered — made live on top of it.
///
/// The markup stays exactly as it arrived. Nothing here creates an element or a
/// run of text: the renderer walks `root` against the document, takes the node
/// already sitting where each one belongs, and adds the handlers and the
/// computations that re-run when a signal changes.
///
/// Build `root` from the state the worker sent, which `state` answers before
/// this is called. A tree built from something else does not match the markup.
///
/// What the markup says is its *shape*: an element that is not there, one that
/// is not the same element, or one the tree never accounted for. A run of text
/// or an attribute that differs is written rather than refused, because a page
/// renders from a state that is allowed to have moved on.
///
/// Resume once. A second call walks markup the first one has already taken
/// over, and answers the same `.Err`.
///
/// **The address is checked first.** `shell` writes the path it rendered beside
/// the state, and a page whose address is somewhere else is refused naming both
/// — because two routes that render the same shape would otherwise resume into
/// each other. A query string and a fragment are not part of a path and are not
/// compared: `Request.path` and the address bar both leave them out. Markup no
/// `shell` wrote carries no path, and only the shape is checked.
///
/// `.Err` three times: a platform with nowhere to resume — a browser whose
/// document has no body yet, or a JavaScript host with no document at all — a
/// page at an address the server did not render, and a tree that is not what the
/// markup says.
export fn resume<C: Ui>(ctx: C, root: Node<C>): Result<(), Str>;

/// The state the server embedded, as the JSON text `shell` was given.
///
/// `.None` on a page no server rendered. Read it with `json.parse` and
/// `json.decode`, which is the same pair the worker encoded it with, and build
/// the tree `resume` takes out of what comes back.
export fn state<C: Ui>(ctx: C): Option<Str>;

/// The path of the page's address now, as `/guide/routing`.
///
/// The same cell `route` wraps, read once. A page that only wants to know where
/// it is needs no prop for it.
export fn path<C: Location + Watch>(ctx: C): Str {
    ctx.read(ctx.path())
}

/// The path, as a value that varies.
///
/// This is the argument a page function takes. `choose`, `computed` and every
/// prop built out of it re-run when the reader navigates, and nothing else
/// does, so navigation re-renders the smallest thing that read the path rather
/// than the page.
export fn route<C: Location>(ctx: C): Prop<Str> {
    let id = ctx.path();
    .Computed(fn(scope) => scope.read(id))
}
