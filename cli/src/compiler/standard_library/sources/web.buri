//! ui/web — a website: rendered on the server, resumed on the page.
//!
//! A website in Buri is one binary with two entries. A worker answers the
//! request: it builds the tree, renders it to HTML, and sends the document with
//! the state it rendered from embedded in it. A page picks that document up: it
//! reads the state back out, builds the same tree from it, and resumes on top of
//! the markup that arrived.
//!
//! ```buri
//! from "core/effect" import { Allocator };
//! from "core/json" import { Json };
//! from "core/net/http" import * as http;
//! from "core/net/http" import { Response };
//! from "ui/node" import * as ui;
//! from "ui/node" import { Node };
//! from "ui/prop" import { Prop };
//! from "ui/web" import * as web;
//!
//! /// The whole site, as one function of the path. The worker calls it with
//! /// `.Const(request.path())`; the page calls it with `web.route(ctx)`.
//! fn page<C>(path: Prop<Str>): Node<C> {
//!     ui.region(.Main, [], [ui.heading(1, [], path)])
//! }
//!
//! fn answer<C: Allocator>(ctx: C, path: Str, state: Json): Response {
//!     let document = web.Document { ..web.defaultDocument(), title: "Buri" };
//!     http.html(
//!         ctx,
//!         web.shell(ctx, path, document, web.render(page(.Const(path))), state),
//!     )
//! }
//! ```
//!
//! **There is one renderer.** `render` is the one `mount` uses, pointed at a
//! document the runtime supplies rather than at a browser's, so what the worker
//! writes is what the page would have built.
//!
//! **A resumed page is live, and is not rebuilt.** `resume` runs that same
//! renderer against the document the reader is already looking at: each element
//! and each run of text is the one the server wrote, and what the walk adds is
//! the handlers and the computations. So a button works, a signal re-renders
//! the smallest thing that read it, and nothing flashes.
//!
//! **Routing is ordinary Buri.** There is no route table and no matcher: a page
//! function takes the path as a `Prop<Str>` and matches on it. The worker passes
//! `.Const(request.path())`, which reads once and registers nothing; the page
//! passes `route`, which re-runs what read it when the reader navigates.
//!
//! **A page navigates itself.** `navigate` puts an address in the address bar
//! and writes the cell `route` wraps, and `replace` does the same in place of
//! the entry the reader is on. Nothing is fetched and nothing is rebuilt but
//! what read the path, so every signal the program holds survives — which is
//! what a link cannot do.
//!
//! **A link can navigate too.** `routeLink` is an `<a href>` whose plain
//! left-click does what `navigate` does rather than loading a document, while a
//! middle-click or a ⌘-click is left to the browser. So in-app navigation keeps
//! everything an anchor is — the status bar, "open in new tab", and a reader's
//! "link" — which a `button` calling `navigate` throws away.
//!
//! The document half is JavaScript's. A native artifact has nothing to render
//! into, so a native build that reaches `render`, `shell`, `resume`, `state` or
//! `title` stops at code generation naming the operation. `path`, `route`,
//! `navigate`, `replace` and `routeLink` are ordinary Buri over the graph, and
//! run wherever a `Location` does.

from "core/effect" import { Allocator };
from "core/json" import * as json;
from "core/json" import { Json };
from "ui/effect" import { Location, Ui, Watch };
from "ui/node" import * as node;
from "ui/node" import { Node };
from "ui/prop" import { Prop };
from "ui/style" import { Style };

// --- The server's half ---------------------------------------------------------

/// The tree as HTML: every element in order, every prop read once, every style
/// on the element it belongs to.
///
/// Reactivity is resolved rather than registered: a `Computed` prop is read
/// once, a `choose` renders the branch its condition takes, and an `each`
/// renders the rows the list has. Handlers are never called, because what this
/// answers is text.
///
/// An element that holds nothing still writes its closing tag — `<main></main>`
/// — except for the ones HTML says hold nothing, which close themselves:
/// `<img />`, `<input />`, `<hr />`. A parser reads `<main />` as an opening tag
/// and puts the rest of the page inside it.
export fn render<C>(root: Node<C>): Str;

/// What a document says about itself: the name of the tab and the language the
/// page is written in.
///
/// A struct rather than more parameters on `shell`, because a head grows and a
/// call site should not have to be rewritten each time it does. Build one from
/// `defaultDocument` and write the fields this page differs in:
///
/// ```buri role=std
/// # from "ui/web" import * as web;
///
/// export fn document(): web.Document {
///     web.Document { ..web.defaultDocument(), title: "Buri Design" }
/// }
/// ```
export struct Document {
    /// The tab, the bookmark, the history entry, and what a screen reader
    /// announces the document as. Escaped, so a title is text and not markup.
    export title: Str,
    /// The BCP 47 tag on `<html lang="…">`: what language the page is in, which
    /// is what a screen reader picks a voice from and what a translator reads.
    export lang: Str,
}

/// A document with nothing said about it yet: no title, and English.
///
/// Routing is a match, so a page names its own tab by writing the one field it
/// differs in over this.
export fn defaultDocument(): Document {
    Document { title: "", lang: "en" }
}

/// The document `body` goes in, with `state` and the `path` it was rendered at
/// embedded in it for the page to pick up.
///
/// The state is written as JSON in a `<script id="buri-state">`, which a
/// browser neither runs nor renders, and `resume` reads it back. Every `<` in it
/// is written `\u003c`, which JSON reads back as `<`, so a string holding
/// `</script>` closes nothing.
///
/// `path` is the address this tree was rendered for — `request.path()` on a
/// worker. It rides on the same script as `data-path`, and `resume` refuses a
/// page whose address is somewhere else. Without it, two routes that render the
/// same *shape* resume into each other, and the reader is left looking at one
/// page's markup with another page's handlers on it.
///
/// `document` says what the head says about the page: its `title` names the tab
/// and its `lang` names the language. A viewport meta comes with them, because
/// a page without one is laid out for a desktop and then shrunk on a phone.
///
/// The stylesheet the compiler extracted goes in the head. A resumed page keeps
/// the styles the server sent it.
export fn shell<C: Allocator>(
    ctx: C,
    path: Str,
    document: Document,
    body: Str,
    state: Json,
): Str {
    let embedded = json.stringify(ctx, state).replace(ctx, "<", "\\u003c");
    let sheet = stylesheet();
    let styles = if (sheet == "") {
        ""
    } else {
        ["<style>", sheet, "</style>"].join(ctx, "")
    };
    [
        "<!doctype html>\n<html lang=\"",
        attribute(ctx, document.lang),
        "\">\n<head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><title>",
        escaped(ctx, document.title),
        "</title>",
        styles,
        "</head>\n<body>",
        body,
        "<script id=\"buri-state\" type=\"application/json\" data-path=\"",
        attribute(ctx, path),
        "\">",
        embedded,
        "</script></body>\n</html>\n",
    ].join(ctx, "")
}

/// A string as text between tags. `&` goes first, or the escapes escape each
/// other. A quote and an apostrophe mean nothing there and are left alone.
fn escaped<C: Allocator>(ctx: C, text: Str): Str {
    text.replace(ctx, "&", "&amp;").replace(ctx, "<", "&lt;").replace(ctx, ">", "&gt;")
}

/// A string as the value of an attribute: the same three, and the quote that
/// would end it.
fn attribute<C: Allocator>(ctx: C, text: Str): Str {
    escaped(ctx, text).replace(ctx, "\"", "&quot;")
}

/// The stylesheet the compiler extracted for this artifact.
///
/// Private: the one place it belongs is the document `shell` builds.
fn stylesheet(): Str;

// --- The page's half -----------------------------------------------------------

/// Takes over the page the server sent, with `root` — the tree the worker
/// rendered — made live on top of it.
///
/// The markup stays exactly as it arrived. Nothing here creates an element or a
/// run of text: the renderer walks `root` against the document, takes the node
/// already sitting where each one belongs, and adds the handlers and the
/// computations that re-run when a signal changes.
///
/// Build `root` from the state the worker sent, which `state` answers before
/// this is called. A tree built from something else does not match the markup.
///
/// What the markup says is its *shape*: an element that is not there, one that
/// is not the same element, or one the tree never accounted for. A run of text
/// or an attribute that differs is written rather than refused, because a page
/// renders from a state that is allowed to have moved on.
///
/// Resume once. A second call walks markup the first one has already taken
/// over, and answers the same `.Err`.
///
/// **The address is checked first.** `shell` writes the path it rendered beside
/// the state, and a page whose address is somewhere else is refused naming both
/// — because two routes that render the same shape would otherwise resume into
/// each other. A query string and a fragment are not part of a path and are not
/// compared: `Request.path` and the address bar both leave them out. Markup no
/// `shell` wrote carries no path, and only the shape is checked.
///
/// `.Err` three times: a platform with nowhere to resume — a browser whose
/// document has no body yet, or a JavaScript host with no document at all — a
/// page at an address the server did not render, and a tree that is not what the
/// markup says.
export fn resume<C: Ui>(ctx: C, root: Node<C>): Result<(), Str>;

/// The state the server embedded, as the JSON text `shell` was given.
///
/// `.None` on a page no server rendered. Read it with `json.parse` and
/// `json.decode`, which is the same pair the worker encoded it with, and build
/// the tree `resume` takes out of what comes back.
export fn state<C: Ui>(ctx: C): Option<Str>;

/// Names the tab, and renames it whenever the reader navigates.
///
/// This is the page's half of `Document.title`. A worker names the tab in the
/// document it sends; a page that mounts arrives at an `.html` carrying the
/// artifact's name and nothing about the route, so it says its own.
///
/// `text` is a `Prop<Str>`, so it follows the route the way the tree does: a
/// `.Const` names the tab once, and a computation over `route` renames it on
/// every navigation. Routing is a match, so a title is a match too.
///
/// ```buri role=std
/// # from "ui/effect" import { Location, Ui };
/// # from "ui/web" import * as web;
///
/// export fn name<C: Location + Ui>(ctx: C): () {
///     let path = web.route(ctx);
///     web.title(
///         ctx,
///         .Computed(fn(scope) => {
///             match (path.read(scope)) {
///                 "/about" => "About — Buri",
///                 _other => "Buri",
///             }
///         }),
///     )
/// }
/// ```
export fn title<C: Ui>(ctx: C, text: Prop<Str>): () {
    ctx.watch(fn(scope) => setTitle(text.read(scope)))
}

/// Writes the document's title, once, with no reactivity of its own.
///
/// Private: `title` is the door, because the watch around this is what keeps
/// the tab named after the route rather than after the mount.
fn setTitle(text: Str): ();

/// The path of the page's address now, as `/guide/routing`.
///
/// The same cell `route` wraps, read once. A page that only wants to know where
/// it is needs no prop for it.
export fn path<C: Location + Watch>(ctx: C): Str {
    ctx.read(ctx.path())
}

/// The path, as a value that varies.
///
/// This is the argument a page function takes. `choose`, `computed` and every
/// prop built out of it re-run when the reader navigates, and nothing else
/// does, so navigation re-renders the smallest thing that read the path rather
/// than the page.
export fn route<C: Location>(ctx: C): Prop<Str> {
    let id = ctx.path();
    .Computed(fn(scope) => scope.read(id))
}

/// Goes to `path` without loading a document: a new history entry, and the cell
/// `route` wraps written.
///
/// This is what a page does instead of following a link. The tree stays where
/// it is, every signal in the program keeps its value, and what re-renders is
/// the smallest thing that read the path — so an app whose state is a store of
/// signals survives its own navigation, which a link cannot manage.
///
/// The entry goes on the history first and the cell after it, so anything the
/// write wakes reads an address bar that already agrees with it.
///
/// `path` is an address on this site, as `/guide/routing`. Nothing here reaches
/// another origin: that is a link, and a reader deserves to see where one goes.
export fn navigate<C: Location + Ui>(ctx: C, path: Str): () {
    let _ = ctx.push(path);
    ctx.write(ctx.path(), path)
}

/// The same, replacing the entry the reader is on rather than adding one.
///
/// What a redirect wants. A page that sends the reader on from an address it
/// has no route for should not leave that address behind Back, because pressing
/// it would send them straight on again.
export fn replace<C: Location + Ui>(ctx: C, path: Str): () {
    let _ = ctx.replace(path);
    ctx.write(ctx.path(), path)
}

/// A link that navigates without loading a document.
///
/// The other half of a router. `navigate` is what a page does *instead* of
/// following a link; this is that same navigation *as* a link — a real
/// `<a href>` to `dest`, so a reader keeps everything an anchor is: middle-click
/// and ⌘-click open it in a new tab, the status bar previews where it goes,
/// "copy link address" copies it, and a screen reader announces it as a link
/// rather than as an action. A `ui.button` calling `navigate` is none of those.
///
/// A plain left-click is the page's: it does exactly what `navigate` does — a
/// history entry, the cell `route` wraps written, and the tree left where it
/// is — so every signal the program holds survives the address changing, which
/// is the whole reason to route rather than link. Every modified click is the
/// browser's: the middle button, and ⌘, Ctrl, Shift or Alt with the left one,
/// fall through to the anchor and open a tab or a window the way a reader who
/// held that key down asked them to.
///
/// `dest` is an address on this site, the same as `navigate`'s `path`. A link
/// to another origin is an ordinary `ui.link`: it *is* a document load, and a
/// reader following one is leaving.
///
/// It wants `Location` and `Ui` because a plain click navigates, and that is
/// what navigating needs. A `native` build has no document to click in, so one
/// that mounts a `routeLink` renders the anchor and its plain click does
/// nothing there.
export fn routeLink<C: Location + Ui>(
    dest: Prop<Str>,
    styles: [Style],
    children: [Node<C>],
): Node<C> {
    node.routeLink(dest, styles, children, fn(c, to) => navigate(c, to))
}
