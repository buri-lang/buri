//! core/net/http — HTTP over the `Network` effect.
//!
//! `Request` and `Response` are declared in `core/effect` and re-exported here.
//! This module holds the things that build them *out of text*.
//!
//! * **free functions make a message** — `request`, `textRequest`, `status`,
//!   `ok`, `text`, `json`, `html`. They read `http.text(ctx, "pong")` and
//!   `http.status(404)` at the call site.
//! * **`with*` methods change one** — `withHeader`, `withBody`, `withStatus`,
//!   `withMethod`. Each answers a new value, so you build a message by chaining
//!   and never by mutation.
//!
//! A struct literal always works too — both types export every field — and it is
//! what to write when you know every field at once.
//!
//! ```buri
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/net/http" import * as http;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let reply = http.text(ctx, "pong").withHeader(ctx, "X-Served-By", "buri");
//!     let kind = reply.header("content-type").withDefault("none");
//!     let _ = io.println(ctx, "${reply.status} ${kind}").ignore();
//!     .Ok(())
//! }
//! ```

from "core/effect" import { Allocator, Header, Method, Network, NetError, Request, Response };

from "core/effect" export { Header, Method, NetError, Request, Response };

from "core/bytes" import * as bytes;

from "core/bytes" import { Utf8Error };

from "core/bytes" export { Utf8Error };

from "core/list" import * as list;

from "core/net/url" import * as url;

from "core/path" import { Path };

from "core/str" import * as str;

from "core/time" import { Duration };

// --- Building a request -------------------------------------------------------

/// A request with no headers and an empty body.
export fn request(method: Method, url: Str): Request {
    Request { method: method, url: url, headers: [], body: [], timeoutMillis: 0 }
}

/// The same, with a text body encoded as UTF-8.
export fn textRequest<C: Allocator>(ctx: C, method: Method, url: Str, body: Str): Request {
    Request {
        method: method,
        url: url,
        headers: [],
        body: bytes.toUtf8(ctx, body),
        timeoutMillis: 0,
    }
}

// --- Building a response ------------------------------------------------------

/// A status and nothing else: no headers, empty body. `http.status(404)`.
export fn status(code: Int): Response {
    Response { status: code, headers: [], body: [] }
}

/// `200` with a text body and **no** `content-type`, for a caller that will
/// set its own.
export fn ok<C: Allocator>(ctx: C, body: Str): Response {
    Response { status: 200, headers: [], body: bytes.toUtf8(ctx, body) }
}

/// `200 text/plain; charset=utf-8`.
export fn text<C: Allocator>(ctx: C, body: Str): Response {
    ok(ctx, body).withHeader(ctx, "content-type", "text/plain; charset=utf-8")
}

/// `200 application/json`. It writes the body as given, without validating it:
/// encoding is `core/json`'s job.
export fn json<C: Allocator>(ctx: C, body: Str): Response {
    ok(ctx, body).withHeader(ctx, "content-type", "application/json")
}

/// `200 text/html; charset=utf-8`. `ui/web`'s `shell` writes the document it
/// takes.
export fn html<C: Allocator>(ctx: C, body: Str): Response {
    ok(ctx, body).withHeader(ctx, "content-type", "text/html; charset=utf-8")
}

// --- Bodies -------------------------------------------------------------------

/// A message body decoded as UTF-8, strictly: `http.bodyText(ctx, reply.body)`.
///
/// It is `bytes.fromUtf8` under an HTTP name, so reading a response needs no
/// second import. A body that is not text fails here rather than turning into
/// U+FFFD.
export fn bodyText<C: Allocator>(ctx: C, body: [U8]): Result<Str, Utf8Error> {
    bytes.fromUtf8(ctx, body)
}

// --- Sending ------------------------------------------------------------------

/// Sends the request as written. Needs only `Network`, since nothing here
/// allocates.
export fn send<C: Network>(ctx: C, request: Request): Result<Response, NetError> {
    ctx.fetch(request)
}

export fn get<C: Allocator + Network>(ctx: C, url: Str): Result<Response, NetError> {
    send(ctx, request(.Get, url))
}

export fn post<C: Allocator + Network>(
    ctx: C,
    url: Str,
    body: Str,
): Result<Response, NetError> {
    send(ctx, textRequest(ctx, .Post, url, body))
}

/// A sentence for a `NetError`. It is a free function because `NetError`
/// belongs to `core/effect`.
export fn errorText(e: NetError): Str {
    match (e) {
        .Timeout => "the request timed out",
        .Refused => "the connection was refused",
        .BadUrl(_u) => "the url could not be parsed",
        .Transport(_m) => "the transport failed",
        .Aborted => "the request was called off",
    }
}

// --- Cookies --------------------------------------------------------------------

/// The `name=value` pairs of a request's `Cookie` field.
///
/// ```buri
/// from "core/effect" import { Allocator };
/// from "core/net/http" import * as http;
/// from "core/net/http" import { Request };
///
/// export fn session<C: Allocator>(ctx: C, request: Request): Option<Str> {
///     http.cookies(ctx, request).find(fn(kv) => kv.0 == "session").map(fn(kv) => kv.1)
/// }
/// ```
///
/// Values come back **as sent**: a client that percent-encoded one is a client
/// whose encoding is yours to undo. No `Cookie` field is no cookies.
export fn cookies<C: Allocator>(ctx: C, request: Request): [(Str, Str)] {
    match (request.header("cookie")) {
        .None => list.empty<(Str, Str)>(),
        .Some(field) => field.split(ctx, ";").filterMap(ctx, fn(one) => crumb(one)),
    }
}

/// One `name=value` of a `Cookie` field. `.None` for a piece with no `=`, which
/// is what a trailing `;` leaves.
fn crumb(one: Str): Option<(Str, Str)> {
    match (one.trim().splitOnce("=")) {
        .None => .None,
        .Some((name, value)) => {
            if (name == "") { .None } else { .Some((name, value)) }
        },
    }
}

derive Equal, Show for SameSite;
/// What a cookie says about cross-site requests.
export enum SameSite {
    Strict,
    Lax,
    None,
}

derive Equal, Show for Cookie;
/// A cookie a server sets. Everything optional is `.None`, which is what leaving
/// the attribute off the field means.
///
/// There is no `domain` and no `expires`. A cookie with no `Domain` goes back to
/// the host that set it, which is what a server wants nine times in ten, and
/// `Max-Age` is `Expires` without a clock or a date format in the way.
export struct Cookie {
    export name: Str,
    export value: Str,
    export path: Option<Str>,
    export maxAge: Option<Duration>,
    export httpOnly: Bool,
    export secure: Bool,
    export sameSite: Option<SameSite>,
}

/// One more `set-cookie` field on a response.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/net/http" import * as http;
/// from "core/net/http" import { Cookie };
/// from "core/time" import * as time;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let reply = http.withCookie(ctx, http.status(204), Cookie {
///         name: "session",
///         value: "abc",
///         path: .Some("/"),
///         maxAge: .Some(time.hours(1)),
///         httpOnly: true,
///         secure: true,
///         sameSite: .Some(.Lax),
///     });
///     let field = reply.header("set-cookie").withDefault("none");
///     let _ = io.println(ctx, "${field}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// session=abc; Path=/; Max-Age=3600; HttpOnly; Secure; SameSite=Lax
/// ```
///
/// The name and the value go out **as given**: a value holding a `;` or a space
/// is not escaped here, because escaping it would change what the client sends
/// back. `url.encodeComponent` is what to wrap it in.
export fn withCookie<C: Allocator>(ctx: C, response: Response, cookie: Cookie): Response {
    response.withHeader(ctx, "set-cookie", cookieText(ctx, cookie))
}

/// A `Cookie` as the field value it becomes.
fn cookieText<C: Allocator>(ctx: C, cookie: Cookie): Str {
    let seconds = match (cookie.maxAge) {
        .None => Option.None,
        .Some(age) => Option.Some(str.fromInt(ctx, age.seconds())),
    };
    let sameSite = match (cookie.sameSite) {
        .None => Option.None,
        .Some(rule) => Option.Some(sameSiteText(rule)),
    };
    let parts = [
        str.format(ctx, "${cookie.name}=${cookie.value}"),
        attribute(ctx, "Path", cookie.path),
        attribute(ctx, "Max-Age", seconds),
        if (cookie.httpOnly) { "HttpOnly" } else { "" },
        if (cookie.secure) { "Secure" } else { "" },
        attribute(ctx, "SameSite", sameSite),
    ];
    parts.filter(ctx, fn(part) => part != "").join(ctx, "; ")
}

fn attribute<C: Allocator>(ctx: C, name: Str, value: Option<Str>): Str {
    match (value) {
        .None => "",
        .Some(given) => str.format(ctx, "${name}=${given}"),
    }
}

fn sameSiteText(rule: SameSite): Str {
    match (rule) {
        .Strict => "Strict",
        .Lax => "Lax",
        .None => "None",
    }
}

// --- Forms ----------------------------------------------------------------------

/// A request whose body is `application/x-www-form-urlencoded`.
///
/// ```buri
/// from "core/effect" import { Allocator };
/// from "core/net/http" import * as http;
/// from "core/net/http" import { Request };
///
/// export fn signIn<C: Allocator>(ctx: C, who: Str): Request {
///     http.formRequest(ctx, .Post, "https://example.com/session", [("user", who)])
/// }
/// ```
///
/// Each half is percent-encoded by `core/net/url`, so a value holding a `&` or an
/// `=` survives the trip.
export fn formRequest<C: Allocator>(
    ctx: C,
    method: Method,
    target: Str,
    fields: [(Str, Str)],
): Request {
    textRequest(ctx, method, target, url.encodeQuery(ctx, fields)).withHeader(
        ctx,
        "content-type",
        "application/x-www-form-urlencoded",
    )
}

/// The fields of an `application/x-www-form-urlencoded` body.
///
/// ```buri
/// from "core/bytes" import { Utf8Error };
/// from "core/effect" import { Allocator };
/// from "core/net/http" import * as http;
/// from "core/net/http" import { Request };
///
/// export fn submitted<C: Allocator>(
///     ctx: C,
///     request: Request,
/// ): Result<[(Str, Str)], Utf8Error> {
///     http.formBody(ctx, request.body)
/// }
/// ```
///
/// `url.parseQuery`'s rules: a `+` is a space, an escape that is not one stays
/// where it is, and an empty pair is dropped. The one way it fails is a body
/// that is not UTF-8.
export fn formBody<C: Allocator>(ctx: C, body: [U8]): Result<[(Str, Str)], Utf8Error> {
    match (bytes.fromUtf8(ctx, body)) {
        .Err(e) => .Err(e),
        .Ok(query) => .Ok(url.parseQuery(ctx, query)),
    }
}

// --- Reading a message ----------------------------------------------------------

/// The `content-type` of a response, as its media type and its parameters.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/net/http" import * as http;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let found = http.contentType(ctx, http.html(ctx, "<p>hi</p>"));
///     let kind = found.map(fn(pair) => pair.0).withDefault("none");
///     let charset = found
///         .andThen(fn(pair) => pair.1.find(fn(kv) => kv.0 == "charset"))
///         .map(fn(kv) => kv.1)
///         .withDefault("none");
///     let _ = io.println(ctx, "${kind} ${charset}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// text/html utf-8
/// ```
///
/// The media type and every parameter name are lowercased, because both are
/// case-insensitive. A parameter value keeps its case, and a quoted one loses
/// its quotes. `.None` when there is no `content-type` at all.
export fn contentType<C: Allocator>(
    ctx: C,
    response: Response,
): Option<(Str, [(Str, Str)])> {
    match (response.header("content-type")) {
        .None => .None,
        .Some(field) => {
            let pieces = field.split(ctx, ";");
            let kind = pieces.first().withDefault("").trim().toLower(ctx);
            .Some(
                (
                    kind,
                    pieces
                        .drop(ctx, 1)
                        .filterMapCtx(ctx, fn(c, one) => parameter(c, one)),
                ),
            )
        },
    }
}

/// One `name=value` of a `content-type`, with the quotes taken off the value.
fn parameter<C: Allocator>(ctx: C, one: Str): Option<(Str, Str)> {
    match (one.splitOnce("=")) {
        .None => .None,
        .Some((name, value)) => {
            let trimmed = value.trim();
            let quoted = trimmed.length() >= 2
                && trimmed.startsWith("\"")
                && trimmed.endsWith("\"");
            let bare = if (quoted) {
                trimmed.slice(1, trimmed.length() - 1)
            } else {
                trimmed
            };
            .Some((name.trim().toLower(ctx), bare))
        },
    }
}

/// The media type a file name suggests, for a handler serving a directory.
///
/// ```buri
/// from "core/net/http" import * as http;
/// from "core/path" import { Path };
///
/// export fn kind(file: Path): Str {
///     http.contentTypeFor(file).withDefault("application/octet-stream")
/// }
/// ```
///
/// Pure, so the extension is compared **as it is spelled**: `page.html` is
/// `text/html` and `page.HTML` is `.None`. A served tree is lowercase, and
/// lowercasing here would need a context this signature does not have.
///
/// `.None` for a name with no extension and for one this list does not know —
/// `application/octet-stream` is the caller's decision rather than a fact about
/// the file.
export fn contentTypeFor(file: Path): Option<Str> {
    match (file.extension()) {
        .None => .None,
        .Some(extension) => mediaType(extension),
    }
}

fn mediaType(extension: Str): Option<Str> {
    match (extension) {
        "html" => .Some("text/html; charset=utf-8"),
        "htm" => .Some("text/html; charset=utf-8"),
        "css" => .Some("text/css; charset=utf-8"),
        "js" => .Some("text/javascript; charset=utf-8"),
        "mjs" => .Some("text/javascript; charset=utf-8"),
        "json" => .Some("application/json"),
        "txt" => .Some("text/plain; charset=utf-8"),
        "md" => .Some("text/markdown; charset=utf-8"),
        "csv" => .Some("text/csv; charset=utf-8"),
        "xml" => .Some("application/xml"),
        "svg" => .Some("image/svg+xml"),
        "png" => .Some("image/png"),
        "jpg" => .Some("image/jpeg"),
        "jpeg" => .Some("image/jpeg"),
        "gif" => .Some("image/gif"),
        "webp" => .Some("image/webp"),
        "ico" => .Some("image/x-icon"),
        "woff" => .Some("font/woff"),
        "woff2" => .Some("font/woff2"),
        "ttf" => .Some("font/ttf"),
        "otf" => .Some("font/otf"),
        "wasm" => .Some("application/wasm"),
        "pdf" => .Some("application/pdf"),
        "zip" => .Some("application/zip"),
        "gz" => .Some("application/gzip"),
        "mp3" => .Some("audio/mpeg"),
        "wav" => .Some("audio/wav"),
        "mp4" => .Some("video/mp4"),
        "webm" => .Some("video/webm"),
        _ => .None,
    }
}

/// The reason phrase for a status code.
///
/// ```buri
/// from "core/net/http" import * as http;
///
/// export fn line(code: Int): Str {
///     http.statusText(code)
/// }
/// ```
///
/// Every code RFC 9110 registers, and the class for anything else — so
/// `statusText(499)` is `"Client Error"` rather than an empty string. A number
/// outside 100 to 599 is `"Unknown"`.
export fn statusText(code: Int): Str {
    match (code) {
        100 => "Continue",
        101 => "Switching Protocols",
        102 => "Processing",
        103 => "Early Hints",
        200 => "OK",
        201 => "Created",
        202 => "Accepted",
        203 => "Non-Authoritative Information",
        204 => "No Content",
        205 => "Reset Content",
        206 => "Partial Content",
        300 => "Multiple Choices",
        301 => "Moved Permanently",
        302 => "Found",
        303 => "See Other",
        304 => "Not Modified",
        307 => "Temporary Redirect",
        308 => "Permanent Redirect",
        400 => "Bad Request",
        401 => "Unauthorized",
        402 => "Payment Required",
        403 => "Forbidden",
        404 => "Not Found",
        405 => "Method Not Allowed",
        406 => "Not Acceptable",
        407 => "Proxy Authentication Required",
        408 => "Request Timeout",
        409 => "Conflict",
        410 => "Gone",
        411 => "Length Required",
        412 => "Precondition Failed",
        413 => "Content Too Large",
        414 => "URI Too Long",
        415 => "Unsupported Media Type",
        416 => "Range Not Satisfiable",
        417 => "Expectation Failed",
        421 => "Misdirected Request",
        422 => "Unprocessable Content",
        426 => "Upgrade Required",
        428 => "Precondition Required",
        429 => "Too Many Requests",
        431 => "Request Header Fields Too Large",
        451 => "Unavailable For Legal Reasons",
        500 => "Internal Server Error",
        501 => "Not Implemented",
        502 => "Bad Gateway",
        503 => "Service Unavailable",
        504 => "Gateway Timeout",
        505 => "HTTP Version Not Supported",
        511 => "Network Authentication Required",
        _ => statusClass(code),
    }
}

fn statusClass(code: Int): Str {
    if (code >= 100 && code < 200) {
        "Informational"
    } else if (code >= 200 && code < 300) {
        "Successful"
    } else if (code >= 300 && code < 400) {
        "Redirection"
    } else if (code >= 400 && code < 500) {
        "Client Error"
    } else if (code >= 500 && code < 600) {
        "Server Error"
    } else {
        "Unknown"
    }
}
