//! core/effect — the effect declarations.
//!
//! An effect is an interface declared with `effect` instead of `trait`. Its
//! methods are the operations it grants. Only platform modules may declare
//! effects, so a program's platform fixes what that program can do to the
//! world (SPEC 10.1).
//!
//! Two rules separate an effect from an ordinary trait:
//!   - its implementors are effect-carrying, so they may be passed only as
//!     `self` or `ctx`;
//!   - no type may implement both an effect and a trait.

derive Eq, Show for Region;
/// A region of memory. `Alloc` is a *resource* effect: it can fail and it costs
/// something, but nobody can observe it. That is what keeps a function bounded
/// only by `Alloc` deterministic (SPEC 10.5).
export struct Region(export I64);

/// What allocating costs, as a **definition**.
///
/// | Operation | Charge, in bytes |
/// |---|---|
/// | a `[T]` of `n` elements | `16 + n * stride(T)` |
/// | a `Str` of `n` UTF-8 bytes | `16 + n` |
/// | a `Str` view — `slice`, `trim`, `splitOnce` | `0` |
/// | a closure environment of fields `F` | `16 + size(record(F))` |
/// | a heap-promoted struct, tuple or enum payload | `0` |
/// | `allocate(ctx, n)` | `n` |
///
/// The charge comes from the *types*, computed from the layout in
/// `design/native/VALUE-MODEL.md` §5, so the same program charges the same
/// number on every backend and every platform. It never measures what an
/// allocator did.
///
/// A **view charges nothing** because `slice`, `trim` and `splitOnce` are
/// declared without an `Alloc` bound. A **fixed-size construction charges
/// nothing** even where the implementation heap-allocates, because SPEC 10.5
/// says fixed-size construction never requires `Alloc`.
///
/// Change a row and you break observable behaviour. `core/alloc` counts the
/// charges, and it says which of these rows an allocator hears about today.
export effect Alloc {
    fn allocate(self, bytes: Int): Region;
}

/// Writing to standard output.
///
/// **Every operation answers `Result<(), IoError>`**: a closed pipe, a full
/// disk and a revoked permission are all things that happen to a print.
///
/// You have to look at the `Result`. Discarding one is `result-discarded`, in
/// both of the two places a value can be dropped, and `buri lint` reports every
/// one as `discarded-result`. A program that does not care says so:
///
/// ```text
/// io.println(ctx, "ready").ignore();
/// ```
///
/// A program that does care answers instead, and `mapErr` carries the `IoError`
/// into whatever error type it uses.
export effect Stdout {
    fn print(self, text: Template): Result<(), IoError>;
    fn println(self, text: Template): Result<(), IoError>;
    /// Octets, written through unchanged.
    ///
    /// `print` takes a `Template` and the platform encodes it; this takes bytes
    /// and the platform encodes nothing.
    fn writeBytes(self, b: [U8]): Result<(), IoError>;
}

/// Writing to standard error, on `Stdout`'s terms, `Result` included. The two
/// streams fail in the same ways.
export effect Stderr {
    fn eprint(self, text: Template): Result<(), IoError>;
    fn eprintln(self, text: Template): Result<(), IoError>;
}

export effect Stdin {
    fn readLine(self): Option<Str>;
    /// Exactly `n` octets, or fewer at end of input — `.None` when there were
    /// none at all.
    ///
    /// Blocks until the octets arrive. `readLine` reads the input to its end,
    /// so a program using it cannot answer before the other side has finished
    /// speaking; this is how a request/response protocol over a pipe is
    /// written.
    fn readBytes(self, n: Int): Option<[U8]>;
}

// `Fs` is not here. It split into `FsRead` and `FsWrite`, and the platform
// module `core/fs` declares both: every method of both names a `Path`, and this
// module sits below `core/path`.

export effect Net {
    /// One request, one response. `Request` and `Response` are declared below,
    /// and they are the same two types `core/net/http` re-exports and a server
    /// hands its handler.
    fn fetch(self, request: Request): Result<Response, NetError>;
}

export effect Clock {
    fn nowMillis(self): I64;
    fn sleepMillis(self, millis: Int): ();
}

/// Uniform numbers, and **only** uniform ones.
///
/// This effect promises a *distribution* and nothing about unpredictability.
/// The host runs xoshiro256++ natively and `Math.random` on JavaScript, and an
/// observer who has seen enough output of either can predict the rest.
///
/// A program that needs unpredictability names `Entropy` below. A program that
/// wants a generator it can *replay* uses `core/random`'s `Gen`: a seeded value
/// rather than an effect, with the same distribution and the same numbers
/// twice.
export effect Rand {
    fn nextInt(self, lo: Int, hi: Int): Int;
    fn nextFloat(self): Float;
}

/// Octets nobody can predict, from the operating system's own generator.
///
/// **This is not `Rand` with a better distribution.** `Rand` promises
/// *uniformity*, a claim about the shape of a sequence. This promises
/// *unpredictability*, a claim about somebody who has already seen part of one.
/// A seeded generator keeps the first promise and cannot keep the second — and
/// `core/host/testing`'s `rand()` is seeded deliberately, so that a hermetic
/// test gets the same numbers every run. A program minting a session token
/// needs this one.
///
/// The source is the platform's: `getrandom(2)` or `getentropy(2)` behind
/// `cli/runtime`, and `crypto.getRandomValues` on JavaScript.
///
/// `core/crypto` is the door, not `core/random`.
export effect Entropy {
    /// `count` octets, each drawn from the platform's generator.
    ///
    /// **A failure aborts rather than answering.** Every other fallible
    /// operation on this page returns a `Result`, and this one does not: an
    /// ignored `.Err` here is a guessable key with no symptom, and fewer octets
    /// than were asked for is the one answer that must never reach a caller.
    ///
    /// A negative `count` aborts. Zero is the empty list.
    fn bytes(self, count: Int): [U8];
}

/// The process's environment: its variables and the arguments it was started
/// with.
///
/// `args` and not `arguments`: `core/env` exports `args(ctx)` and is the only
/// caller of this method. A type's methods are one map keyed by name, so the
/// name `arguments` is left for `core/host/testing`'s `TestEnv` builder, where
/// `env().arguments([...])` is how a test says what the arguments are.
export effect Env {
    fn variable(self, name: Str): Option<Str>;
    fn args(self): [Str];

    /// Where the process is running, as text. `core/env` turns it into a
    /// `Path`.
    fn currentDirectory(self): Str;

    /// Every variable, as `(name, value)` pairs, in the platform's own order.
    ///
    /// `allVariables` and not `variables`, for the reason `args` is not
    /// `arguments`: a type's methods are one map keyed by name, and
    /// `core/host/testing`'s `TestEnv` already spends `variables` on the
    /// builder a test writes its environment with.
    fn allVariables(self): [(Str, Str)];

    /// The operating system's short name, lower case: `"linux"`, `"macos"`.
    ///
    /// The one fact about the platform that no variable carries honestly, and
    /// the reason this effect has a third method rather than two.
    fn operatingSystemName(self): Str;
}

export effect Proc {
    fn exitWith(self, code: Int): ();
}

/// Running a piece of a program more than once at a time.
///
/// `parallel` is the whole of it. There is no detached spawn and no handle to
/// join: a task takes the caller's context, runs while the caller waits, and has
/// finished before `parallel` returns. A task that outlived the call would
/// outlive the context that granted it.
///
/// **Results come back in the order the items were given**, whatever order the
/// tasks finished in, and the `Int` is the item's own index. That is a promise
/// rather than an implementation detail.
///
/// **The context is a parameter of its own, and the closure names it.** A task
/// receives the caller's *whole* context. It arrives as a parameter rather than
/// by capture because an effect-carrying value may be passed only as `self` or
/// `ctx` (SPEC 10.6).
///
/// It is deliberately **not** spelled `Self`. `Self` is the type implementing
/// this effect, and it grants this one effect, so a step handed `Self` could not
/// read a clock, print a line or allocate.
///
/// The receiver and `ctx` are the same value at every call site the standard
/// library has: `core/tasks`'s `parallel` writes `ctx.parallel(ctx, …)`. The
/// effect dispatches on the first, and the work happens with the second.
///
/// **Granted on every platform, WEB included.**
///
/// How much of it runs at once belongs to the platform and not to this
/// signature. JavaScript starts the tasks together and awaits them together, on
/// one thread. The native runtime fans them out onto its carrier pool, and they
/// run at the same time on as many processors. The development backend has a
/// single Buri stack to hold their frames in and runs the tasks in index order
/// on the calling carrier. All three answer the same list. `core/tasks` has the
/// table.
export effect Tasks {
    /// Runs `f` over every item and answers the results in the items' order,
    /// handing every step `ctx` — the caller's whole context.
    fn parallel<C, A, B>(self, ctx: C, items: [A], f: fn(C, Int, A) => B): [B];
}

/// Accepting connections.
///
/// `Net` is "I make requests"; this is "I accept them". Two authorities, so two
/// grants: a program that fetches a URL has not thereby earned the right to hold
/// a port open. `Sockets` is declared beside this one and granted with it, since
/// a platform that accepts connections can write back on them.
///
/// **Seven operations, and none of them is the loop.** `listenBind` opens the
/// port and says how many handlers it will host on it, `listenAccept` waits for
/// the next connection with a whole request on it, `listenRequest` reads that
/// request, `listenRespond` answers it, and `listenClose` gives the port back.
/// `listenUpgrade` turns a connection into a socket where the client asked for
/// one, and `listenReceive` waits for the next thing to arrive on that socket.
/// The loops over them belong to `core/net/server` and are written in Buri, and
/// that decides every other shape here:
///
///   * **the handler runs under the caller's own context.** `serve` calls it
///     directly, so a handler may allocate, print, read a clock or start a task
///     — every authority its `C` carries — without any of that crossing this
///     effect.
///   * **there may be several loops at once.** `core/net/server`'s `run` fans
///     the loop out with `Tasks.parallel`, one worker per handler the acceptor
///     will host, so a slow handler holds up its own connection and nothing
///     else. Each worker says which request it is answering: `listenAccept`
///     answers a connection, and `listenRespond` names that connection.
///   * **the runtime keeps no Buri value between calls.** Every value here is
///     built, handed over and finished with inside one call.
///
/// **Accepting and reading are two calls.** `listenAccept` is where a server
/// spends its idle life: it waits, it is the one call in this effect that can
/// wait forever, and it is the one a shutdown has to be able to interrupt.
/// `listenRequest` waits on nothing — the request was framed and read whole
/// before the connection was handed out.
///
/// Nothing calls these methods directly. `core/net/server` does, and a program
/// hands *that* module a `Server` value carrying every knob.
///
/// The methods carry a prefix for `Sockets`' reason, one declaration down: a
/// bare `bind` or `accept` would claim an ordinary verb out of the namespace
/// every effect bound beside this one shares.
///
/// **A socket is `Listen`'s to hand out and `Sockets`' to write on.** Accepting a
/// connection and reading what arrives on it is one authority however the bytes
/// are framed, so the upgrade and the receive live here. Pushing on a socket is
/// the other, and it *outlives* the loop that accepted it.
///
/// **A `Listener` is inert data, not a resource**, and so is an accepted
/// connection: integers copied freely, meaningful only to the acceptor that
/// minted them. `port` rides on it because the bind is what discovers the port —
/// a `ListenOptions.port` of `0` asks the operating system to choose one. A
/// handle from another acceptor, or one already closed, is a `.Err(ServeError)`
/// and never a crash.
///
/// **Every knob is its own parameter, and "unset" is part of the encoding.** A
/// `Server`'s `.None` fields become an empty `Str` and a negative `Int` on the
/// way here, so the runtime picks the defaults it knows it can honour.
///
/// Two knobs do not cross at all and stay the acceptor's own constants: how long
/// one connection may take to send its head, and the largest body it will read.
/// `Serve` is where they land if a program ever needs to name them.
///
/// **How many handlers a listener hosts is not in the plan either.** It is an
/// answer rather than a setting, so it rides back on `Listener`.
///
/// **Granted on LINUX and MACOS**, together with `Sockets`, and never on `JS` or
/// `WEB`: a page does not hold a port open.
export effect Listen {
    /// Opens a port, and answers with it.
    ///
    /// `address` is `""` for "the runtime chooses", `port` is `0` for "the
    /// operating system chooses", `plan` is `[]` for the same, and each `Int`
    /// knob is negative for it. `Listener.port` is what the operating system
    /// actually gave.
    ///
    /// `.AddressInUse`, `.AddressNotAvailable` and `.PermissionDenied` are the
    /// three the operating system reports by name. `.Unsupported` is a protocol
    /// this toolchain's runtime does not speak, which is a fact about how the
    /// toolchain was built rather than about the program. `.Transport` is a
    /// certificate the plan named and the runtime could not use — read at the
    /// bind, once, so that a server with a certificate it cannot present does
    /// not start.
    fn listenBind(
        self,
        address: Str,
        port: Int,
        plan: [Serve],
        requestLimit: Int,
        idleTimeoutMillis: Int,
    ): Result<Listener, ServeError>;

    /// The next connection on this listener with a whole request on it.
    ///
    /// Waits. The `Int` is the connection, opaque on `Listener`'s terms: what
    /// `listenRequest` reads and what `listenRespond` answers.
    ///
    /// `.Err(.Closed)` is how a listener says it will answer no more — its
    /// request limit is spent, it has been closed, or **the platform was asked
    /// to stop and has finished draining**. It is the ordinary end of a server
    /// rather than a failure, which is why `core/net/server`'s `run` turns that
    /// one cause into `.Ok(())`. `.Err(.Timeout)` is the idle deadline expiring
    /// with nobody connected.
    ///
    /// A graceful shutdown stops the platform taking new connections, lets the
    /// requests already in flight be answered, and only then answers this with
    /// `.Closed`. So a server that was asked to stop ends the same way a server
    /// that spent its request limit does.
    ///
    /// A connection that speaks nonsense never surfaces here: the runtime
    /// answers a malformed request itself. Every connection this answers has a
    /// whole request already read off it.
    fn listenAccept(self, handle: Int): Result<Int, ServeError>;

    /// The request that arrived on a connection `listenAccept` answered with.
    ///
    /// Does not wait: the request was read whole before the connection was
    /// handed out. `.Err(.Closed)` is a connection that has already been
    /// answered, or one whose listener was closed under it.
    fn listenRequest(self, connection: Int): Result<Request, ServeError>;

    /// Answers one accepted request, named by its connection, with a
    /// `Response`'s three fields.
    ///
    /// One response per accepted request, paired **by identifier and not by
    /// position**: several workers on one listener means as many outstanding
    /// requests as there are workers.
    ///
    /// A connection nobody is holding — one already answered, or one whose
    /// listener was closed under it — is `.Ok(())` and writes nothing.
    fn listenRespond(
        self,
        connection: Int,
        status: Int,
        headers: [Header],
        body: [U8],
    ): Result<(), ServeError>;

    /// Gives the port back.
    ///
    /// Closing twice is not an error: the second call has nothing to do.
    fn listenClose(self, handle: Int): ();

    /// Turns an accepted connection into a socket, if that is what the client
    /// asked for.
    ///
    /// The `Int` is the socket, on `listenAccept`'s terms: opaque, minted by the
    /// acceptor, and the thing `Sockets`' three methods name. A socket is not
    /// answered with a `Response`, so a connection this upgrades is one
    /// `listenRespond` will never be called for.
    ///
    /// **`.Err` is the ordinary answer and not a failure.** A request that is not
    /// an upgrade, an upgrade this acceptor cannot complete, a transport that
    /// cannot carry one — all of them leave the connection exactly as it was,
    /// still holding its request and still answerable. So `core/net/server` reads
    /// any `.Err` here as "this is an ordinary request" and hands it to
    /// `onRequest`. It is the one call in this effect whose `.Err` is not a
    /// reason to stop.
    fn listenUpgrade(self, connection: Int): Result<Int, ServeError>;

    /// The next thing to arrive on a socket, once one has.
    ///
    /// **Waits**, as `listenAccept` does, and it is the second call in this
    /// effect that can wait forever. It is also where the socket's outbound
    /// buffer is flushed: a message another task enqueued while this socket's own
    /// loop was busy goes out when the loop next asks what arrived. That is what
    /// makes `socketSendText` a call that never waits.
    ///
    /// **One caller per socket, and that is the ordering rule.** The events on
    /// one socket go to whoever asks, in the order they arrived, and
    /// `core/net/server` asks from one task per socket. So the hooks on a socket
    /// run in order by construction rather than by a lock.
    ///
    /// **`.Closed` is the last answer a socket gives**, and after it the socket
    /// is gone: a message sent to it is dropped, and asking again is
    /// `.Err(.Closed)`.
    ///
    /// `.Err` is a socket that is already gone — closed, never opened, or its
    /// listener closed under it — and a loop reads it as an abnormal end and
    /// reports it to the close hook.
    fn listenReceive(self, socket: Int): Result<Received, ServeError>;
}

/// Writing to a connection somebody else accepted.
///
/// A websocket is not a request and a response, so the authority to push on one
/// is neither `Listen` nor `Net`. It is separate because it *outlives* the
/// handler: a socket handle can go to an actor and be pushed to from there long
/// after the request that opened it returned.
///
/// **Every method here names the noun it acts on**, and that is a rule rather
/// than a style. Method lookup through a context searches every bound effect and
/// reports two matches as `ambiguous-trait-method`, so an effect that claims a
/// common verb makes that verb unusable for every effect bound beside it.
/// `Ui.read` and `Watch.read` are the shipped cautionary case: the two are meant
/// to be bound together, and `ctx.read(id)` is ambiguous for everyone who does.
/// The `socket…` prefix reserves a namespace instead of a word.
///
/// **The operations are declared, rather than this being a marker effect.**
/// Anyone may write a type satisfying an effect (SPEC 10.9), which is safe only
/// because a hand-written `Stdout` writes nowhere. A hand-written `Sockets`
/// satisfying a marker would be a key to operations somebody else implemented.
///
/// A socket is an `Int` handle here and `core/net/server` wraps it in a
/// `Socket`. The close code is an `Int` for the same reason: `CloseReason` is an
/// enum in the module above, and wire codes never appear in Buri code.
///
/// **Granted on every platform**, because there are two ways to come by a
/// socket and only one of them is a server's. `listenUpgrade` mints one on
/// `LINUX` and `MACOS`; `WebSocketClient.connectSocket` mints one everywhere, a
/// page included.
///
/// A handle that names no open socket counts as one that has already gone, so a
/// made-up handle and a spent one are deliberately indistinguishable.
export effect Sockets {
    /// Enqueues a text frame. Never waits: the frame goes to the socket's
    /// outbound buffer, and a socket whose buffer is full is closed rather than
    /// its writer blocked.
    ///
    /// **Enqueued and not sent.** The bytes leave when the socket's own loop
    /// next asks what arrived (`listenReceive`), so a message pushed from an
    /// actor is on its way as soon as that loop is between messages.
    /// `Serve.SocketBuffer` is how deep the queue is; overflowing it closes the
    /// socket, and the loop hears about that like any other close.
    fn socketSendText(self, socket: Int, text: Str): ();
    /// Enqueues a binary frame, on `socketSendText`'s terms. Two operations
    /// rather than one, because they are two framings on the wire.
    fn socketSendBytes(self, socket: Int, body: [U8]): ();
    /// Closes the socket, with the wire code and reason the far side is told. A
    /// message sent afterwards is dropped rather than refused: the other end may
    /// already be gone, so "did this arrive" was never answerable here.
    fn socketClose(self, socket: Int, code: Int, reason: Str): ();
}

/// Being a WebSocket client rather than a WebSocket server.
///
/// `Listen` is the accepting half: a program that holds a port, takes a
/// connection, and upgrades it. This is the other half — a program that dials
/// somebody else's socket and reads what they push at it. Dialling out is not
/// accepting in, so they are two authorities.
///
/// **Two methods, and they are `listenUpgrade` and `listenReceive` from the
/// other end.** The first mints a socket, the second waits for what arrives on
/// it, and everything between them — the framing, the masking, the ping and the
/// pong, the close handshake — is the platform's exactly as it is for a server.
/// `core/net/websocket` is the module a program calls, and its `Client` carries
/// the same three hooks `core/net/server`'s `WebSocket` does.
///
/// **Writing on the socket is `Sockets`' and not this effect's.** A socket
/// minted here is the same inert handle a server's is, so a client that pushes
/// says `C: WebSocketClient + Sockets`.
///
/// **Every method names the noun it acts on**, on `Sockets`' rule.
///
/// **Granted on LINUX, MACOS, JS, WEB and CLOUDFLARE_WORKER** — every platform.
/// Dialling out is what a page does; it is holding a port open that a page
/// cannot do, and a worker is in the same position. On WEB and
/// CLOUDFLARE_WORKER the two methods suspend without holding the event loop.
export effect WebSocketClient {
    /// Dials `url` and completes the opening handshake, answering the socket and
    /// the response that opened it.
    ///
    /// **Waits.** A name is resolved, a connection is made, and on `wss://` a
    /// TLS handshake happens before a byte of WebSocket is spoken.
    ///
    /// `url` is `ws://…` or `wss://…`. Any other scheme is
    /// `.Err(.Unsupported)`; a connection that could not be made, a server that
    /// answered something other than `101`, and a handshake whose
    /// `sec-websocket-accept` did not check out are `.Err(.Transport)` with a
    /// sentence saying which.
    ///
    /// **On LINUX and MACOS this runtime writes the handshake and checks every
    /// clause of the answer itself.** Everywhere else the platform's own
    /// `WebSocket` owns it, and how strictly it checks is that engine's
    /// decision — `node` refuses a `101` that signs another handshake's key and
    /// `bun` accepts it. A page never sees the key it sent, so there is nothing
    /// here to check it with.
    ///
    /// **Headers and a subprotocol are not arguments here.** A program that
    /// wants either builds the URL and reads the answer: `Connected` carries the
    /// response's own header fields, where a negotiated subprotocol arrives.
    fn connectSocket(self, url: Str): Result<Connected, ServeError>;

    /// The next thing to arrive on a socket this effect minted.
    ///
    /// **Waits**, and it is `listenReceive` from the other end — the same
    /// `Received`, the same three frames, the same rule that `.Closed` is the
    /// last answer a socket gives and that asking again is `.Err(.Closed)`. It
    /// flushes the outbound queue on its way in for the same reason, which is
    /// what makes `socketSendText` a call that never waits on a client socket
    /// either.
    ///
    /// **One caller per socket**, on `listenReceive`'s terms.
    fn connectReceive(self, socket: Int): Result<Received, ServeError>;
}

derive Eq, Show for IoError;
/// Declared here rather than in `core/fs` because the three stream effects above
/// answer it too. `core/fs` re-exports it, so a program that only reads files
/// names one module.
export enum IoError {
    NotFound,
    PermissionDenied,
    ReadOnly,
    AlreadyExists,
    NotADirectory,
    /// A rename whose two paths are on different filesystems — the one case
    /// where the operation is a copy and therefore not atomic. A caller that
    /// wanted atomicity has to tell this apart from a failure it can retry.
    CrossDevice,
    Other(Str),
}

derive Eq, Show for NetError;
export enum NetError {
    Timeout,
    Refused,
    BadUrl(Str),
    Transport(Str),
    /// The request was called off before an answer arrived — a cancelled task, a
    /// closed connection, a deadline the caller set. Distinct from `Timeout`,
    /// which is the *transport* giving up: this one is the program's own doing,
    /// and a caller that retries a `Timeout` should not retry this.
    Aborted,
}

derive Eq, Show for Protocol;
/// An HTTP version a server may be asked to speak.
///
/// The **declaration order is the ABI**: the variant index is what crosses to
/// the runtime — `cli/runtime/net.rs`'s `Protocol` is this list transcribed — so
/// a variant may be appended and never reordered. `Method` travels the same way
/// and for the same reason.
///
/// A `Server` naming a protocol its toolchain's runtime was not built with is
/// refused when it binds, with `.Unsupported` and a message naming the build
/// switch. The refusal is at run time on purpose: nothing about the program is
/// wrong, and a server that only ever speaks HTTP/1.1 should still run.
export enum Protocol {
    Http1,
    Http2,
    Http3,
}

derive Eq, Show for Serve;
/// One thing a listener is being asked for — **the bind's whole plan, one
/// element at a time.**
///
/// A runtime call carries ten integer arguments and `listenBind` spends all ten,
/// but a list crosses as a pointer and a length whatever its elements are. So a
/// list of *tagged options* carries as many `Str`s and `Int`s as anyone wants for
/// the price of one argument.
///
/// The **declaration order is the ABI**, as `Protocol`'s is: the variant index
/// and its payload are what cross, and `cli/runtime/net.rs`'s `BuriServe` is this
/// declaration transcribed. Append, never reorder.
///
/// `core/net/server`'s `bind` renders a `Server` into one of these, and an empty
/// plan is a caller who chose nothing.
export enum Serve {
    /// An HTTP version to speak. Naming none is naming HTTP/1.1.
    Speak(Protocol),
    /// Where to read the server's certificate chain, as a path to a PEM file.
    ///
    /// A **path** and not the certificate itself: certificates expire and get
    /// rotated, and a key written into a source file is a key in version
    /// control.
    Certificate(Str),
    /// Where to read the private key that goes with it, on the same terms.
    PrivateKey(Str),
    /// How long a shutdown may wait for the requests already in flight.
    ///
    /// A platform that can be asked to stop — by a supervisor, or by somebody at
    /// a terminal — stops taking connections, answers what it already took, and
    /// only then says `.Closed`. This is how long the second step may take before
    /// the third happens anyway. Naming none leaves the number to the runtime.
    ///
    /// **It bounds the waiting and not the handlers.** A handler still running
    /// when this expires still answers the connection it was given; what expires
    /// is the patience of the workers that have nothing to do.
    DrainMillis(Int),
    /// How many messages a socket's outbound buffer holds before the socket is
    /// closed.
    ///
    /// `socketSendText` never waits, so something has to say what happens when
    /// the far side reads more slowly than this side writes: the buffer is
    /// bounded, and a socket that fills it is **closed**. Naming none leaves the
    /// number to the runtime.
    SocketBuffer(Int),
}

derive Eq, Show for ServeFailure;
/// Why a server stopped, as a closed set.
///
/// Separate from `NetError` because being a server fails in different ways from
/// talking to one, so a `match` on either covers cases that can actually happen.
///
/// The **declaration order is the ABI**, as `Protocol`'s is.
export enum ServeFailure {
    /// Somebody else holds the port.
    AddressInUse,
    /// The address does not name an interface on this machine.
    AddressNotAvailable,
    /// A privileged port, or a sandbox that forbids listening.
    PermissionDenied,
    /// A protocol this toolchain's runtime does not speak. The message names the
    /// build switch that would add it.
    Unsupported,
    /// The listener waited its idle deadline and nobody connected.
    Timeout,
    /// The listener will answer no more: its request limit is spent, or it has
    /// been closed. **Not a failure** — `core/net/server`'s `run` turns this one
    /// cause into `.Ok(())`, and it is the ordinary way a bounded server ends.
    Closed,
    /// Anything the operating system or the wire reported that the six above do
    /// not name. The message is the platform's own.
    Transport,
}

derive Eq, Show for ServeError;
/// Why a server stopped, and what the platform said about it.
///
/// A **struct** rather than an enum with payloads: `cause` is what a program
/// branches on and `detail` is what it prints. `cli/runtime/lib.rs` §2.1 also
/// gives a non-enum error its own out-pointer, so the message crosses the C ABI
/// whole, where an enum error's payload would not cross at all.
export struct ServeError {
    export cause: ServeFailure,
    export detail: Str,
}

derive Eq, Show for Listener;
/// An open port. Inert data: three integers the acceptor understands and nobody
/// else does.
///
/// `port` is the port actually bound, which is why this is a record rather than a
/// handle. `ListenOptions.port` of `0` asks the operating system to choose, and a
/// program that has to tell somebody where to connect — a test, a supervisor, a
/// line on standard output — reads the answer here.
///
/// `handlers` is **how many handlers this acceptor will host at once on this
/// listener**, and it is what `core/net/server`'s `run` fans its accept loop out
/// to. The number is the acceptor's and not the program's: a program that has to
/// bound its concurrency bounds it in its handler.
///
/// It is inert like the rest of this value, so a program may write a `Listener`
/// of its own with any number in it. `core/net/server` therefore believes it only
/// inside a range it can host, and says so where the clamp is.
export struct Listener {
    export handle: Int,
    export port: Int,
    export handlers: Int,
}

derive Eq, Show for Frame;
/// Which of the three things `listenReceive` answered with.
///
/// **Three and not five**: a ping and a pong are the transport keeping a
/// connection alive and the platform answers them, so nothing above this line
/// ever sees one.
///
/// The **declaration order is the ABI**, as `Protocol`'s is.
export enum Frame {
    /// A text message. `Received.text` is the whole of it.
    Text,
    /// A binary message. `Received.data` is the whole of it.
    Binary,
    /// The socket is gone, and this is the last thing it will ever answer.
    /// `Received.code` says why.
    Closed,
}

derive Eq, Show for Received;
/// One thing that arrived on a socket.
///
/// **A struct with a kind beside it, rather than an enum with payloads**, on
/// `ServeError`'s terms: it crosses the C ABI whole. The enum with payloads that
/// a reader wants is `core/net/server`'s `Message`, built from this on the Buri
/// side of the boundary.
///
/// The fields a `frame` does not name are empty: a `.Text` carries nothing in
/// `data`, a `.Binary` nothing in `text`, and neither carries a `code`.
export struct Received {
    /// Which of the three this is, and therefore which field to read.
    export frame: Frame,
    /// A `.Text` message's payload.
    export text: Str,
    /// A `.Binary` message's payload.
    export data: [U8],
    /// Why a `.Closed` socket closed, as the wire's own number.
    /// `core/net/server` maps it to a `CloseReason` before any program sees it.
    ///
    /// **A negative code is the platform's own and never the far side's.** Wire
    /// codes are unsigned, so a number below zero cannot have come off a socket:
    /// it is how a platform says a socket ended for a reason that was never on
    /// the wire at all, such as an outbound buffer that filled.
    export code: Int,
}

derive Eq, Show for Connected;
/// A WebSocket client's opening handshake, answered.
///
/// **Flat, and a struct rather than a pair**, on `Received`'s terms: it crosses
/// the C ABI whole. `core/net/websocket` builds the `Response` a program wanted
/// out of the last three fields.
///
/// The response is the `101` the server answered, and it is where a negotiated
/// subprotocol arrives.
export struct Connected {
    /// The socket, on `listenUpgrade`'s terms: opaque, minted by the platform,
    /// and the thing `Sockets`' three methods name.
    export socket: Int,
    /// The response's status. `101` on every handshake that finished, because a
    /// handshake that answered anything else is an `.Err` and never reaches
    /// here.
    export status: Int,
    /// The response's header fields, lowercased on the way in like every other
    /// `Header` in this language.
    ///
    /// **A page knows less than a native program does.** The browser's own
    /// `WebSocket` never shows the handshake response, so on `JS` and `WEB` this
    /// carries what the platform does expose — the negotiated subprotocol and
    /// extensions — and nothing else. On `LINUX` and `MACOS` it is the head the
    /// server actually sent.
    export headers: [Header],
    /// The response's body. Empty on every handshake that finished: a `101`
    /// carries none, and the octets after it are the socket.
    export body: [U8],
}

derive Eq, Show for Method;
/// The request method.
///
/// Its **wire spelling never appears in Buri code**: `GET` is written `.Get`,
/// and the three letters are the platform's business. The set is closed, so a
/// typo is a compile error rather than a 501.
///
/// The **declaration order is the ABI**: the variant index is what crosses to the
/// runtime, so a variant may be appended and never reordered.
export enum Method {
    Get,
    Head,
    Post,
    Put,
    Patch,
    Delete,
    Options,
}

derive Eq, Show for Header;
/// One header field.
///
/// **Names are lowercase.** HTTP/2 and HTTP/3 require it on the wire, every
/// platform here lowercases what it receives, and `withHeader` lowercases what it
/// is given. So `header` is an exact comparison rather than a case-insensitive
/// scan. A name written any other way is not an error; it is lowercased on the
/// way in.
export struct Header {
    export name: Str,
    export value: Str,
}

derive Eq, Show for Request;
/// An HTTP request: what `Net.fetch` takes, and what a server's handler is given.
///
/// The body is octets rather than text: a decoded `Str` would have to be lossy or
/// fallible, and both are wrong for a byte range or a protobuf. `core/net/http`
/// has the text-shaped constructors and `core/bytes` the conversions.
export struct Request {
    export method: Method,
    export url: Str,
    export headers: [Header],
    export body: [U8],
}

derive Eq, Show for Response;
/// An HTTP response: what `Net.fetch` answers, and what a server's handler
/// returns. The body is octets, for `Request`'s reason.
export struct Response {
    export status: Int,
    export headers: [Header],
    export body: [U8],
}

impl Request {
    /// The path component of `url`, always beginning with `/` and carrying
    /// neither query nor fragment. `"/"` when the URL names no path.
    ///
    /// Pure: every step is a view, so this costs no allocation and needs no
    /// context.
    export fn path(self): Str {
        let after = match (self.url.splitOnce("://")) {
            .Some((_scheme, rest)) => rest,
            .None => self.url,
        };
        let rooted = match (after.indexOf("/")) {
            .Some(at) => after.slice(at, after.len()),
            .None => "/",
        };
        let noQuery = match (rooted.splitOnce("?")) {
            .Some((only, _query)) => only,
            .None => rooted,
        };
        match (noQuery.splitOnce("#")) {
            .Some((only, _fragment)) => only,
            .None => noQuery,
        }
    }

    /// Everything after the first `?` and before any `#`, without the `?` itself;
    /// the empty string when there is no query.
    export fn query(self): Str {
        let noFragment = match (self.url.splitOnce("#")) {
            .Some((only, _fragment)) => only,
            .None => self.url,
        };
        match (noFragment.splitOnce("?")) {
            .Some((_before, q)) => q,
            .None => "",
        }
    }

    /// The value of the first header with this name, which must be lowercase.
    export fn header(self, name: Str): Option<Str> {
        match (self.headers.find(fn(h) => h.name == name)) {
            .Some(found) => .Some(found.value),
            .None => .None,
        }
    }

    /// The same request with one more header. Appends rather than replaces,
    /// because `set-cookie` legitimately repeats.
    export fn withHeader<C: Alloc>(self, ctx: C, name: Str, value: Str): Request {
        Request {
            method: self.method,
            url: self.url,
            headers: self
                .headers
                .push(ctx, Header { name: name.toLower(ctx), value: value }),
            body: self.body,
        }
    }

    export fn withMethod(self, method: Method): Request {
        Request {
            method: method,
            url: self.url,
            headers: self.headers,
            body: self.body,
        }
    }

    export fn withBody(self, body: [U8]): Request {
        Request {
            method: self.method,
            url: self.url,
            headers: self.headers,
            body: body,
        }
    }
}

impl Response {
    /// `2xx`. A redirect is not a success, and a caller that wants to follow one
    /// has to say so.
    export fn isOk(self): Bool {
        self.status >= 200 && self.status < 300
    }

    /// The value of the first header with this name, which must be lowercase.
    export fn header(self, name: Str): Option<Str> {
        match (self.headers.find(fn(h) => h.name == name)) {
            .Some(found) => .Some(found.value),
            .None => .None,
        }
    }

    /// The same response with one more header. Appends, for `Request`'s reason.
    export fn withHeader<C: Alloc>(self, ctx: C, name: Str, value: Str): Response {
        Response {
            status: self.status,
            headers: self
                .headers
                .push(ctx, Header { name: name.toLower(ctx), value: value }),
            body: self.body,
        }
    }

    export fn withStatus(self, status: Int): Response {
        Response { status: status, headers: self.headers, body: self.body }
    }

    export fn withBody(self, body: [U8]): Response {
        Response { status: self.status, headers: self.headers, body: body }
    }
}
