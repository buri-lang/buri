//! core/effect — the effect declarations.
//!
//! An effect is an interface declared with `effect` instead of `trait`. Its
//! methods are the operations it grants. Only platform modules may declare
//! effects, so the set of things a Buri program can do to the world is fixed by
//! its platform rather than open-ended (SPEC 10.1).
//!
//! Two rules separate an effect from an ordinary trait:
//!   - its implementors are effect-carrying, and so may be passed only as
//!     `self` or `ctx`;
//!   - no type may implement both an effect and a trait.

/// A region of memory. `Alloc` is a *resource* effect: it can fail and it
/// costs something, but it is not observable, which is what makes a function
/// bounded only by `Alloc` deterministic (SPEC 10.5).
export struct Region(export I64);

/// What allocating costs, as a **definition**.
///
/// | Operation | Charge, in bytes |
/// |---|---|
/// | a `[T]` of `n` elements | `16 + n * stride(T)` |
/// | a `Str` of `n` UTF-8 bytes | `16 + n` |
/// | a `Str` view — `slice`, `trim`, `splitOnce` | `0` |
/// | a closure environment of fields `F` | `16 + size(record(F))` |
/// | a heap-promoted struct, tuple or enum payload | `0` |
/// | `allocate(ctx, n)` | `n` |
///
/// The charge is a function of the *types*, computed from the layout in
/// `design/native/VALUE-MODEL.md` §5, so the same program charges the same
/// number on every backend and every platform. It is not a measurement of what
/// an allocator did, and it is deliberately not one: a measured number is not
/// reproducible across backends, and a test asserting one is flaky.
///
/// Two rows carry their reasons. A **view charges nothing** because the
/// language says so — `slice`, `trim` and `splitOnce` are declared without an
/// `Alloc` bound, and the accounting has to agree with the type system or the
/// type system is lying. A **fixed-size construction charges nothing** even
/// where the implementation heap-allocates, because SPEC 10.5 says fixed-size
/// construction never requires `Alloc`: the model counts what the *language*
/// says allocates, and a number that moves when the optimizer improves is not
/// a number a test can assert.
///
/// Being a definition makes it a commitment: a change to any row is a breaking
/// change to observable behaviour. `core/alloc` is where the charges are
/// counted, and it states which of these rows an allocator is actually told
/// about today.
export effect Alloc {
  fn allocate(self, bytes: Int): Region;
}

export effect Stdout {
  fn print(self, text: Template): ();
  fn println(self, text: Template): ();
  /// Octets, written through unchanged.
  ///
  /// `print` takes a `Template` and the platform encodes it; this takes bytes
  /// and the platform encodes nothing. A program speaking a binary protocol
  /// over a pipe needs the second, and could not get it by rendering the first.
  fn writeBytes(self, b: [U8]): ();
}

export effect Stderr {
  fn eprint(self, text: Template): ();
  fn eprintln(self, text: Template): ();
}

export effect Stdin {
  fn readLine(self): Option<Str>;
  /// Exactly `n` octets, or fewer at end of input — `.None` when there were
  /// none at all.
  ///
  /// This blocks until the octets arrive, which is what makes a
  /// request/response protocol over a pipe expressible: `readLine` reads the
  /// input to its end, so a program using it cannot answer before the other
  /// side has finished speaking.
  fn readBytes(self, n: Int): Option<[U8]>;
}

export effect Fs {
  fn readFile(self, path: Str): Result<Str, IoError>;
  fn writeFile(self, path: Str, body: Str): Result<(), IoError>;
  fn fileExists(self, path: Str): Bool;
  fn readDir(self, path: Str): Result<[Str], IoError>;

  /// The octets, unchanged. `readFile` decodes UTF-8 and substitutes U+FFFD
  /// for what is not; this is the operation for a file that is not text.
  fn readFileBytes(self, path: Str): Result<[U8], IoError>;
  /// Truncates an existing file, and creates one that is absent.
  fn writeFileBytes(self, path: Str, body: [U8]): Result<(), IoError>;
  /// Appends the whole body, creating the file when it is absent.
  fn appendFile(self, path: Str, body: [U8]): Result<(), IoError>;
  /// Replaces `to`, atomically within one filesystem.
  fn renameFile(self, source: Str, destination: Str): Result<(), IoError>;
  fn removeFile(self, path: Str): Result<(), IoError>;
  /// Parents included; an existing directory is `.Ok`.
  fn makeDir(self, path: Str): Result<(), IoError>;
  /// The commit point: what was written to `path` is durable when this
  /// returns. `core/fs`'s `sync` states what each platform can promise.
  fn syncFile(self, path: Str): Result<(), IoError>;
}

export effect Net {
  /// One request, one response. `Request` and `Response` are declared below,
  /// and they are the *same* two types `core/net/http` re-exports and a server
  /// hands its handler — there is one shape for an HTTP message in this
  /// language, not one per direction.
  fn fetch(self, request: Request): Result<Response, NetError>;
}

export effect Clock {
  fn nowMillis(self): I64;
  fn sleepMillis(self, millis: Int): ();
}

export effect Rand {
  fn nextInt(self, lo: Int, hi: Int): Int;
  fn nextFloat(self): Float;
}

export effect Env {
  fn variable(self, name: Str): Option<Str>;
  fn arguments(self): [Str];
}

export effect Proc {
  fn exitWith(self, code: Int): ();
}

/// Running a piece of a program more than once at a time.
///
/// `parallel` is the whole of it, and the shape is deliberate. There is no
/// detached spawn and no handle to join: a task is handed the caller's
/// context, runs while the caller waits, and has finished before `parallel`
/// returns. A task that outlived the call would outlive the context that
/// granted it, and then "a program that never names `host.fs` cannot read a
/// file" would stop being true of the program's *lifetime* rather than only of
/// its call graph.
///
/// **Results are in the order the items were given**, whatever order the tasks
/// finished in, and the `Int` is the item's own index. That is a promise, not
/// an implementation detail waiting to be relaxed: a program whose answer
/// depended on which task won is a program no test can pin, and this language
/// has no way to say "assert one of these six outputs".
///
/// The closure takes `Self` rather than capturing it, for the reason
/// `ui/effect`'s `Fetch` does — an effect-carrying value may arrive only as
/// `self` or `ctx` (SPEC 10.6), so a task receives the full context as a
/// parameter and captures nothing effectful.
///
/// **No platform grants this yet.** `core/host` declares `HostTasks` and
/// `tasks`, and the grant table gives them no platform at all, so every
/// `Tasks: host.tasks` is refused today with the reason. The declaration lands
/// ahead of the scheduler on purpose: the signature is the part that is
/// expensive to change once programs are written against it, and it can be
/// reviewed, documented and pinned before there is a runtime to argue with.
export effect Tasks {
  /// Runs `f` over every item and answers the results in the items' order.
  fn parallel<A, B>(self, items: [A], f: fn(Self, Int, A) => B): [B];
}

/// Accepting connections.
///
/// `Net` is "I make requests"; this is "I accept them", and they are two
/// grants rather than one because they are two authorities. A program that
/// fetches a URL has not thereby earned the right to hold a port open, and the
/// difference is one a reader of a context should be able to see: `Net` in the
/// list means the program talks to servers, `Listen` means it *is* one.
///
/// `Sockets` is the other half of the pair and is declared beside this one,
/// because the two are granted together: a platform that accepts connections
/// is a platform that can write back on them.
///
/// **What is fixed here is the authority, not the argument list.** `Tasks` is
/// the other shape — `parallel` is what a program calls, so its signature was
/// the expensive thing and it is pinned above. Nothing calls `listen`
/// directly: `core/net/server` does, and a program hands *that* module a
/// `Server` value carrying every knob. So the split of authority is the
/// commitment here, and the parameters below are plumbing that grows a knob at
/// a time as the runtime learns to honour one — which costs nothing while no
/// platform grants the effect, because there is no caller anywhere to update.
///
/// The handler arrives as a parameter rather than as a capture, for
/// `Tasks.parallel`'s reason: an effect-carrying value may be passed only as
/// `self` or `ctx` (SPEC 10.6), so a request handler is *handed* the context
/// and captures nothing effectful.
///
/// **No platform grants this yet.** `core/host` declares `HostListen` and
/// `listen`, and the grant table gives them no platform at all, so every
/// `Listen: host.listen` is refused today with the reason. The acceptor that
/// answers it lands with `core/net/server`; granting it is then one row of
/// that table rather than a new name a program has to be rewritten to use.
export effect Listen {
  /// Accepts connections on `address:port`, answers each request with
  /// `onRequest`, and returns when the process is asked to shut down.
  ///
  /// Answering `.Ok(())` for "the server stopped" rather than never returning
  /// is what keeps `serve` an ordinary call: a `main` that runs a server ends
  /// by falling off the end of a function, not by being killed.
  fn listen(
    self,
    address: Str,
    port: Int,
    onRequest: fn(Self, Request) => Response,
  ): Result<(), NetError>;
}

/// Writing to a connection somebody else accepted.
///
/// A websocket is not a request and a response, so the authority to push on
/// one is neither `Listen` nor `Net`. It is separate because it *outlives* the
/// handler: a socket handle can be given to an actor and pushed to from there
/// long after the request that opened it returned, and a context granted only
/// `Listen` should not be able to do that.
///
/// **Every method here names the noun it acts on**, and that is a rule rather
/// than a style. Method lookup through a context searches every bound effect
/// and reports two matches as `ambiguous-trait-method` (`find_in_bounds`,
/// `semantics/expressions.rs`), so an effect that claims a common verb makes
/// that verb unusable for every effect bound beside it, and the language has
/// no way to un-claim it afterwards. `Ui.read` and `Watch.read` are the
/// shipped cautionary case: the two are meant to be bound together, and
/// `ctx.read(id)` is ambiguous for everyone who does. A bare `send`, `write`
/// or `close` here would have made the same mistake against `Stdout`, `Ui` and
/// whatever a later effect wants. Claiming the `socket…` prefix costs six
/// characters at the one call site there will ever be, and reserves a
/// namespace instead of a word.
///
/// **The operations are declared, rather than this being a marker effect.** It
/// is tempting to leave `Sockets` empty and used only as a bound, letting
/// `core/net/server` hold the real operations as functions taking `C: Sockets`
/// — the surface a program sees would be identical, since `send` and `close`
/// are `Socket`'s methods either way. It would also be an authority hole. An
/// effect is an ordinary interface and anyone may write a type satisfying it
/// (SPEC 10.9), which is safe exactly because a hand-written `Stdout` writes
/// nowhere; a hand-written `Sockets` satisfying a *marker* would be a key to
/// operations somebody else implemented. So the operations go through the
/// implementation, and a forged one forges only its own inert bodies.
///
/// A socket is an `Int` handle here and `core/net/server` wraps it in a
/// `Socket`, which is the arrangement `Ui` already uses: the effect speaks in
/// signal ids and `ui/signal` hands out `Signal<T>`. The close code is an
/// `Int` for the same reason — `CloseReason` is an enum in the module above,
/// and "wire codes never appear in Buri code" is a rule about the code people
/// write, which is why the mapping lives one layer up from here.
///
/// **No platform grants this yet**, on `Listen`'s terms, with which it is
/// granted and withheld together.
export effect Sockets {
  /// Enqueues a text frame. Never waits: the frame goes to the socket's
  /// outbound buffer, and a socket whose buffer is full is closed rather than
  /// its writer blocked.
  fn socketSendText(self, socket: Int, text: Str): ();
  /// Enqueues a binary frame, on `socketSendText`'s terms. Two operations
  /// rather than one taking a payload, because they are two framings on the
  /// wire and not one operation with a choice of argument.
  fn socketSendBytes(self, socket: Int, body: [U8]): ();
  /// Closes the socket, with the wire code and reason the far side is told.
  /// A message sent afterwards is dropped rather than refused: the other end
  /// may already be gone, so "did this arrive" was never answerable here.
  fn socketClose(self, socket: Int, code: Int, reason: Str): ();
}

/// Declared here rather than in `core/fs` so that the effect signature above
/// can name it without `core/effect` depending on a module that depends on it.
export enum IoError {
  NotFound,
  PermissionDenied,
  ReadOnly,
  AlreadyExists,
  NotADirectory,
  /// A rename whose two paths are on different filesystems — the one case
  /// where the operation is a copy and therefore not atomic. Named rather than
  /// folded into `Other` because a caller that wanted atomicity has to be able
  /// to tell this apart from a failure it can retry.
  CrossDevice,
  Other(Str),
}

export enum NetError {
  Timeout,
  Refused,
  BadUrl(Str),
  Transport(Str),
  /// The request was called off before an answer arrived — a cancelled task,
  /// a closed connection, a deadline the caller set. Distinct from `Timeout`,
  /// which is the *transport* giving up: this one is the program's own doing,
  /// and a caller that retries a `Timeout` should not retry this.
  Aborted,
}

/// The request method.
///
/// Its **wire spelling never appears in Buri code**: `GET` is written `.Get`,
/// and the three letters are the platform's business, exactly as a WebSocket
/// close code is. That is what makes the set closed — a method a program
/// cannot name is a method it cannot send — and what keeps a typo a compile
/// error instead of a 501 from a server three timezones away.
///
/// The **declaration order is the ABI**: the variant index is what crosses to
/// the runtime, so a variant may be appended and never reordered.
export enum Method {
  Get,
  Head,
  Post,
  Put,
  Patch,
  Delete,
  Options,
}

/// One header field.
///
/// **Names are lowercase.** HTTP/2 and HTTP/3 require it on the wire, every
/// platform here lowercases what it receives, and `withHeader` lowercases what
/// it is given — so `header` is an exact comparison rather than a
/// case-insensitive scan, and a program never has to guess which casing a
/// server chose. A name written any other way is not an error; it is
/// lowercased on the way in.
export struct Header {
  export name: Str,
  export value: Str,
}

/// An HTTP request: what `Net.fetch` takes, and what a server's handler is
/// given.
///
/// The body is octets rather than text because a request body is not
/// necessarily text — a decoded `Str` would have to be lossy or fallible, and
/// both are wrong for a byte range or a protobuf. `core/net/http` has the
/// text-shaped constructors and `core/bytes` the conversions.
export struct Request {
  export method: Method,
  export url: Str,
  export headers: [Header],
  export body: [U8],
}

/// An HTTP response: what `Net.fetch` answers, and what a server's handler
/// returns. The body is octets, for `Request`'s reason.
export struct Response {
  export status: Int,
  export headers: [Header],
  export body: [U8],
}

impl Request {
  /// The path component of `url`, always beginning with `/` and carrying
  /// neither query nor fragment. `"/"` when the URL names no path.
  ///
  /// Pure: every step is a view (`splitOnce`, `slice`), so asking a request
  /// where it is going costs no allocation and needs no context.
  export fn path(self): Str {
    let after = match (self.url.splitOnce("://")) {
      .Some((_scheme, rest)) => rest,
      .None => self.url,
    };
    let rooted = match (after.indexOf("/")) {
      .Some(at) => after.slice(at, after.len()),
      .None => "/",
    };
    let noQuery = match (rooted.splitOnce("?")) {
      .Some((only, _query)) => only,
      .None => rooted,
    };
    match (noQuery.splitOnce("#")) {
      .Some((only, _fragment)) => only,
      .None => noQuery,
    }
  }

  /// Everything after the first `?` and before any `#`, without the `?`
  /// itself; the empty string when there is no query.
  export fn query(self): Str {
    let noFragment = match (self.url.splitOnce("#")) {
      .Some((only, _fragment)) => only,
      .None => self.url,
    };
    match (noFragment.splitOnce("?")) {
      .Some((_before, q)) => q,
      .None => "",
    }
  }

  /// The value of the first header with this name, which must be lowercase.
  export fn header(self, name: Str): Option<Str> {
    match (self.headers.find(fn(h) => h.name == name)) {
      .Some(found) => .Some(found.value),
      .None => .None,
    }
  }

  /// The same request with one more header. Appends rather than replaces:
  /// `set-cookie` legitimately repeats, and a builder that silently dropped
  /// the earlier one would make that unsayable.
  export fn withHeader<C: Alloc>(self, ctx: C, name: Str, value: Str): Request {
    Request {
      method: self.method,
      url: self.url,
      headers: self.headers.push(ctx, Header { name: name.toLower(ctx), value: value }),
      body: self.body,
    }
  }

  export fn withMethod(self, method: Method): Request {
    Request { method: method, url: self.url, headers: self.headers, body: self.body }
  }

  export fn withBody(self, body: [U8]): Request {
    Request { method: self.method, url: self.url, headers: self.headers, body: body }
  }
}

impl Response {
  /// `2xx`. Nothing else: a redirect is not a success, and a caller that
  /// wanted to follow one has to say so.
  export fn isOk(self): Bool {
    self.status >= 200 && self.status < 300
  }

  /// The value of the first header with this name, which must be lowercase.
  export fn header(self, name: Str): Option<Str> {
    match (self.headers.find(fn(h) => h.name == name)) {
      .Some(found) => .Some(found.value),
      .None => .None,
    }
  }

  /// The same response with one more header. Appends, for `Request`'s reason.
  export fn withHeader<C: Alloc>(self, ctx: C, name: Str, value: Str): Response {
    Response {
      status: self.status,
      headers: self.headers.push(ctx, Header { name: name.toLower(ctx), value: value }),
      body: self.body,
    }
  }

  export fn withStatus(self, status: Int): Response {
    Response { status: status, headers: self.headers, body: self.body }
  }

  export fn withBody(self, body: [U8]): Response {
    Response { status: self.status, headers: self.headers, body: body }
  }
}

/// What `Fetch` — the UI backend's non-blocking client — answers.
///
/// Not `Response`: `Fetch` is `core/ui`'s callback-shaped effect and is retired
/// whole in a later slice, and widening its payload in the meantime would move
/// a hundred fixtures for a type that is about to go away.
export struct NetResponse {
  export status: Int,
  export body: Str,
}

derive Eq, Show for IoError;
derive Eq, Show for NetError;
derive Eq, Show for NetResponse;
derive Eq, Show for Method;
derive Eq, Show for Header;
derive Eq, Show for Request;
derive Eq, Show for Response;
derive Eq, Show for Region;
