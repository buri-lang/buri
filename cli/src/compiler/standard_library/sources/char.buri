//! core/char — the defining module of `Char`, a Unicode scalar value.

impl Char {
    export fn isDigit(self): Bool;

    export fn isAlpha(self): Bool;

    export fn isAlphanumeric(self): Bool {
        self.isAlpha() || self.isDigit()
    }

    export fn isSpace(self): Bool;

    export fn isUpper(self): Bool;

    export fn isLower(self): Bool;

    export fn toLower(self): Char;

    export fn toUpper(self): Char;

    /// Exact: every `Char` is a `U32`. The other direction, `u32.toChar()`, is one
    /// of the numeric conversions and lives on `U32` — not every `U32` is a
    /// Unicode scalar value, so it yields `Result<Char, RangeError>`.
    export fn toU32(self): U32;

    /// The digit a character denotes, in the given radix.
    export fn toDigit(self, radix: Int): Option<Int>;

    /// Whether this is `0`–`9`, `a`–`f` or `A`–`F`.
    ///
    /// The same question as `toDigit(16).isSome()`, given a name because
    /// hexadecimal is what that question is nearly always about — and because
    /// a predicate reads as one where a `Option` compared against `.None` does
    /// not.
    export fn isHexDigit(self): Bool {
        self.toDigit(16).isSome()
    }
}

/// The thirty-six digits, in order. `fromDigit` is a lookup rather than
/// arithmetic over character codes, which is one table instead of two
/// range checks and a base.
let DIGITS: Str = "0123456789abcdefghijklmnopqrstuvwxyz";

/// The character a digit is written as: `fromDigit(11, 16)` is `'b'`.
///
/// Lowercase, which is the case `core/bytes` and `core/num` render hexadecimal
/// in — one case, so two renderings of the same bytes cannot differ by it.
/// `.None` for a digit the radix does not have, and for a radix outside 2 to
/// 36, which is the range `toDigit` reads.
///
/// The inverse of `toDigit`, and the reason no program needs a table of the
/// sixteen hexadecimal digits of its own.
export fn fromDigit(n: Int, radix: Int): Option<Char> {
    if (radix < 2 || radix > 36 || n < 0 || n >= radix) {
        .None
    } else {
        DIGITS.charAt(n)
    }
}
