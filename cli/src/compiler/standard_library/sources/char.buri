//! core/char — the defining module of `Char`, a Unicode scalar value.

impl Char {
    export fn isDigit(self): Bool;

    export fn isAlpha(self): Bool;

    export fn isAlphanumeric(self): Bool {
        self.isAlpha() || self.isDigit()
    }

    export fn isSpace(self): Bool;

    export fn isUpper(self): Bool;

    export fn isLower(self): Bool;

    export fn toLower(self): Char;

    export fn toUpper(self): Char;

    /// Always exact: every `Char` is a `U32`. The other direction lives on `U32`
    /// as `u32.toChar()`, one of the numeric conversions. Not every `U32` is a
    /// Unicode scalar value, so that one yields `Result<Char, RangeError>`.
    export fn toU32(self): U32;

    /// The digit a character denotes, in the given radix.
    export fn toDigit(self, radix: Int): Option<Int>;

    /// Whether this is `0`–`9`, `a`–`f` or `A`–`F`.
    ///
    /// The same question as `toDigit(16).isSome()`, with a name because
    /// hexadecimal is nearly always what you are asking.
    export fn isHexDigit(self): Bool {
        self.toDigit(16).isSome()
    }

    /// Whether this is one of the first 128 scalars — the ones UTF-8 writes as
    /// a single byte.
    export fn isAscii(self): Bool {
        self.toU32().toI64() < 128
    }

    /// General Category `Cc`: the thirty-three C0 controls and the thirty-two
    /// C1 ones, and nothing else.
    ///
    /// Not the same set as "unprintable" — a zero-width joiner and an
    /// unassigned code point are both outside `Cc`. `isPrintable` is the
    /// question with the wider answer.
    export fn isControl(self): Bool {
        let cp = self.toU32().toI64();
        cp < 0x20 || (cp >= 0x7f && cp <= 0x9f)
    }

    /// General Category `P` — the connectors, dashes, brackets, quotation
    /// marks and the rest, as `\p{P}` matches them.
    ///
    /// Symbols are *not* punctuation: `+`, `<`, `$` and `~` are General
    /// Category `S` and this says no to all four, which is the one surprise in
    /// the set. A binary search over a range table, so it is a few reads rather
    /// than a comparison.
    export fn isPunctuation(self): Bool {
        inRanges(PUNCTUATION, self.toU32().toI64(), 0, PUNCTUATION.len() / 8)
    }

    /// Whether this scalar has a visible shape of its own — everything outside
    /// General Categories `C` and `Z`, plus the space itself.
    ///
    /// So a tab, a newline, a non-breaking space, a zero-width joiner, an
    /// unassigned code point and a private-use one are all not printable, and
    /// `' '` is. That is Python's `str.isprintable`, and it is the useful
    /// division: what you can put in a diagnostic and read back.
    export fn isPrintable(self): Bool {
        inRanges(PRINTABLE, self.toU32().toI64(), 0, PRINTABLE.len() / 8)
    }

    /// Whether a line ends here: LF, VT, FF, CR, NEL, and the line and
    /// paragraph separators — the seven `str.lines` splits on.
    ///
    /// `isSpace` says yes to a tab and a space as well, which is why splitting
    /// lines with it does not work.
    export fn isNewline(self): Bool {
        let cp = self.toU32().toI64();
        (cp >= 0x0a && cp <= 0x0d) || cp == 0x85 || cp == 0x2028 || cp == 0x2029
    }

    /// How many bytes this scalar takes in UTF-8: one below U+0080, two below
    /// U+0800, three below U+10000, and four above.
    ///
    /// `str.utf8Length` is the same count over a whole string.
    export fn utf8Length(self): Int {
        let cp = self.toU32().toI64();
        if (cp < 0x80) {
            1
        } else if (cp < 0x800) {
            2
        } else if (cp < 0x10000) {
            3
        } else {
            4
        }
    }
}

/// Whether `cp` is inside one of `table`'s ranges.
///
/// A range is eight base-36 digits — four for its first code point, four for
/// its last — and the ranges are sorted and disjoint, so this halves. `core/str`
/// carries the same three helpers for its own tables: they are four lines each
/// and exporting them would put a table format in the public surface.
fn inRanges(table: Str, cp: Int, lo: Int, hi: Int): Bool {
    if (lo >= hi) {
        false
    } else {
        let mid = lo + (hi - lo) / 2;
        if (cp < codeAt(table, mid * 8)) {
            inRanges(table, cp, lo, mid)
        } else if (cp <= codeAt(table, mid * 8 + 4)) {
            true
        } else {
            inRanges(table, cp, mid + 1, hi)
        }
    }
}

/// The four base-36 digits at `at`, as a number.
fn codeAt(table: Str, at: Int): Int {
    digitAt(table, at) * 46656
        + digitAt(table, at + 1) * 1296
        + digitAt(table, at + 2) * 36
        + digitAt(table, at + 3)
}

fn digitAt(table: Str, at: Int): Int {
    match (table.charAt(at)) {
        .Some(c) => c.toDigit(36).withDefault(0),
        .None => 0,
    }
}

// --- Generated Unicode tables (Unicode 16.0) ---------------------------
//
// Written by `cli/src/compiler/standard_library/unicode_tables.py`, which
// says what the fields are. Regenerate rather than edit.

/// General Category `P`, as sorted, disjoint code-point ranges.
let PUNCTUATION: Str = "";

/// Everything outside General Categories `C` and `Z`, plus the space.
let PRINTABLE: Str = "";

// --- End of the generated Unicode tables -------------------

/// The thirty-six digits, in order. `fromDigit` looks one up here rather than
/// doing arithmetic on character codes.
let DIGITS: Str = "0123456789abcdefghijklmnopqrstuvwxyz";

/// The character a digit is written as: `fromDigit(11, 16)` is `'b'`.
///
/// Lowercase, matching how `core/bytes` and `core/num` render hexadecimal.
///
/// Answers `.None` for a digit the radix does not have, and for a radix outside
/// 2 to 36, the range `toDigit` reads. The inverse of `toDigit`.
export fn fromDigit(n: Int, radix: Int): Option<Char> {
    if (radix < 2 || radix > 36 || n < 0 || n >= radix) {
        .None
    } else {
        DIGITS.charAt(n)
    }
}
