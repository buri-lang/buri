//! core/testing/context — the test runner's platform.
//!
//! One implementation per effect, not one pre-assembled world. Each is real
//! where it can be and hermetic everywhere else, and each is an ordinary struct
//! with methods — there is no distinction between the runner's implementations
//! and yours (SPEC 11.2).
//!
//! The structs carry an `I64` handle rather than their state. A captured stdout
//! and an in-memory filesystem accumulate what a test does to them, and Buri
//! has no mutation, so the state lives on the runner's side and the value here
//! names it. That is also why a named context is *called* — `Hermetic()` —
//! rather than referred to: each call allocates fresh handles, so what one test
//! writes is invisible to the next.

from "core/effect" import {
  Alloc, Clock, Env, Fs, Net, Rand, Stderr, Stdin, Stdout,
  IoError, NetError, NetResponse, Region,
};

// --- Alloc --------------------------------------------------------------------

/// Real, from a per-test arena the runner reclaims.
export struct TestAlloc(I64);
impl Alloc for TestAlloc {
  fn allocate(self, bytes: Int): Region;
}
export fn alloc(): TestAlloc;

// --- Output -------------------------------------------------------------------

/// Captured, and never printed. `captured` is the only way to read it back,
/// which is what makes a test's output something to assert on rather than
/// something to watch scroll past — a failing test says so through its
/// assertion.
export struct CaptureOut(I64);
impl Stdout for CaptureOut {
  fn print(self, text: Template): ();
  fn println(self, text: Template): ();
  /// Captured as the UTF-8 text the octets spell, so `captured` answers one
  /// question rather than two.
  fn writeBytes(self, b: [U8]): ();
}
export fn captureOut(): CaptureOut;

export struct CaptureErr(I64);
impl Stderr for CaptureErr {
  fn eprint(self, text: Template): ();
  fn eprintln(self, text: Template): ();
}
export fn captureErr(): CaptureErr;

impl CaptureOut {
  /// Everything written to this context's stdout so far, so a test can assert on
  /// what a function printed.
  export fn captured(self): Str;
}

impl CaptureErr {
  export fn capturedErr(self): Str;
}

// --- Input --------------------------------------------------------------------

/// Reads the given lines, then end-of-input.
export struct TestStdin(I64);
impl Stdin for TestStdin {
  fn readLine(self): Option<Str>;
  fn readBytes(self, n: Int): Option<[U8]>;
}
export fn stdin(lines: [Str]): TestStdin;

/// Reads those octets, then end-of-input. The binary twin of `stdin`.
export fn stdinBytes(b: [U8]): TestStdin;

// --- Filesystem ---------------------------------------------------------------

/// In-memory. Writes are visible to that test and discarded after it.
///
/// A file holds **octets**, and `readFile` decodes them as UTF-8 the way a real
/// filesystem's does — so `writeBytes` of a byte a text encoding cannot carry
/// reads back through `readBytes` unchanged.
///
/// Two places where an in-memory filesystem is thinner than a real one, both
/// observable and both deliberate. It is a flat map of paths, so the parents of
/// a fixture's path are not directories until `makeDir` says so; and `sync` has
/// nothing to flush, so it is `.Ok` for any path that exists. Everything else —
/// append creating a file, rename replacing one, removing what is not there —
/// answers exactly what a real filesystem answers, which is what lets one
/// conformance block run against both.
export struct MemFs(I64);
impl Fs for MemFs {
  fn readFile(self, path: Str): Result<Str, IoError>;
  fn writeFile(self, path: Str, body: Str): Result<(), IoError>;
  fn fileExists(self, path: Str): Bool;
  fn readDir(self, path: Str): Result<[Str], IoError>;
  fn readFileBytes(self, path: Str): Result<[U8], IoError>;
  fn writeFileBytes(self, path: Str, body: [U8]): Result<(), IoError>;
  fn appendFile(self, path: Str, body: [U8]): Result<(), IoError>;
  fn renameFile(self, source: Str, destination: Str): Result<(), IoError>;
  fn removeFile(self, path: Str): Result<(), IoError>;
  fn makeDir(self, path: Str): Result<(), IoError>;
  fn syncFile(self, path: Str): Result<(), IoError>;
}

/// Rooted at the package directory, containing exactly `test { data: [...] }`.
export fn data(): MemFs;

/// Containing exactly these entries.
export fn files(entries: [(Str, Str)]): MemFs;

/// The byte twin of `files`, for a fixture that is not text.
export fn filesBytes(entries: [(Str, [U8])]): MemFs;

/// Wraps an `Fs` so every write fails.
///
/// The type parameter carries no bound, so `ctx` here is not effect-carrying
/// by the rule in SPEC 10.2 and the wrapper is expressible. `ReadOnly<C>`
/// satisfies `Fs` only when `C` does, and there is deliberately no working
/// `writeFile`, so the callee holds a value that genuinely lacks the effect
/// rather than merely being unable to name it.
export struct ReadOnly<C>(C);

export fn readOnly<C>(ctx: C): ReadOnly<C> {
  ReadOnly(ctx)
}

impl<C: Fs> Fs for ReadOnly<C> {
  fn readFile(self, path: Str): Result<Str, IoError> {
    self.0.readFile(path)
  }
  fn writeFile(self, path: Str, body: Str): Result<(), IoError> {
    .Err(.ReadOnly)
  }
  fn fileExists(self, path: Str): Bool {
    self.0.fileExists(path)
  }
  fn readDir(self, path: Str): Result<[Str], IoError> {
    self.0.readDir(path)
  }
  fn readFileBytes(self, path: Str): Result<[U8], IoError> {
    self.0.readFileBytes(path)
  }
  fn writeFileBytes(self, path: Str, body: [U8]): Result<(), IoError> {
    .Err(.ReadOnly)
  }
  fn appendFile(self, path: Str, body: [U8]): Result<(), IoError> {
    .Err(.ReadOnly)
  }
  fn renameFile(self, source: Str, destination: Str): Result<(), IoError> {
    .Err(.ReadOnly)
  }
  fn removeFile(self, path: Str): Result<(), IoError> {
    .Err(.ReadOnly)
  }
  fn makeDir(self, path: Str): Result<(), IoError> {
    .Err(.ReadOnly)
  }
  /// Not a write, and there is nothing this wrapper could be hiding: whatever
  /// the inner filesystem already holds is what gets flushed.
  fn syncFile(self, path: Str): Result<(), IoError> {
    self.0.syncFile(path)
  }
}

// --- Network ------------------------------------------------------------------

/// Refuses every connection. A fake goes in `test.dependencies`.
export struct NoNet {}
impl Net for NoNet {
  fn fetch(self, method: Str, url: Str, body: Str): Result<NetResponse, NetError> {
    .Err(.Refused)
  }
}
export fn noNet(): NoNet {
  NoNet {}
}

// --- Clock --------------------------------------------------------------------

/// Starts at that instant and advances only when the test advances it.
export struct TestClock(I64);
impl Clock for TestClock {
  fn nowMillis(self): I64;
  fn sleepMillis(self, millis: Int): ();
}
export fn clockAt(millis: Int): TestClock;

impl TestClock {
  /// Moves a test clock forward. `sleepMillis` does this too, without sleeping.
  export fn advance(self, millis: Int): ();
}

// --- Randomness ---------------------------------------------------------------

/// Seeded, so a failure reproduces.
export struct TestRand(I64);
impl Rand for TestRand {
  fn nextInt(self, lo: Int, hi: Int): Int;
  fn nextFloat(self): Float;
}
export fn randSeed(seed: Int): TestRand;

// --- Environment --------------------------------------------------------------

/// These variables and these arguments.
export struct TestEnv(I64);
impl Env for TestEnv {
  fn variable(self, name: Str): Option<Str>;
  fn arguments(self): [Str];
}
export fn envOf(variables: [(Str, Str)], arguments: [Str]): TestEnv;

// --- The assembled world -------------------------------------------------------

/// A context binding all of the above at hermetic defaults. A file may use it
/// directly, declare its own on top of it, or build one per test.
export context Hermetic {
  Alloc:  alloc(),
  Stdout: captureOut(),
  Stderr: captureErr(),
  Stdin:  stdin([]),
  Fs:     data(),
  Net:    noNet(),
  Clock:  clockAt(0),
  Rand:   randSeed(0),
  Env:    envOf([], []),
}
