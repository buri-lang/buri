//! core/bool — the defining module of `Bool`.
//!
//! These are the eager forms. `&&` and `||` short-circuit; `and` and `or` do
//! not, because an argument is evaluated before a call.

impl Bool {
    export fn not(self): Bool {
        if (self) { false } else { true }
    }

    export fn and(self, other: Bool): Bool {
        if (self) { other } else { false }
    }

    export fn or(self, other: Bool): Bool {
        if (self) { true } else { other }
    }

    export fn xor(self, other: Bool): Bool {
        if (self) { other.not() } else { other }
    }

    export fn toStr(self): Str {
        if (self) { "true" } else { "false" }
    }

    export fn toInt(self): Int {
        if (self) { 1 } else { 0 }
    }
}
