//! core/testing/check — property testing.
//!
//! You write the shape of an input and a claim about every one of them.
//! `forAll` draws a hundred inputs and stops at the first that breaks the
//! claim.
//!
//! ```buri role=test
//! from "core/effect" import { Allocator };
//! from "core/host/testing" import { alloc };
//! from "core/list" import * as list;
//! from "core/testing/check" import * as check;
//!
//! test "reversing twice gives the list back" {
//!     let ctx = context {
//!         Allocator: alloc(),
//!     };
//!     check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 100), 8), fn(c, items) => {
//!         items.reverse(c).reverse(c).compare(items) == .Equal
//!     });
//! }
//! ```
//!
//! **Nothing here draws from the platform.** A generator is
//! `core/random`'s `Gen` — a seed in, a value and the next generator out — so a
//! run is the same run on every backend, in every process, forever. That is
//! what makes the failure replayable: the report names the seed the failing
//! case was drawn from, and
//!
//! ```buri role=test
//! from "core/random" import * as random;
//! from "core/testing/check" import * as check;
//!
//! test "the case seed 4 draws" {
//!     let (value, _) = check.int(0, 100)(random.seeded(4));
//!     let _ = value;
//! }
//! ```
//!
//! gives you that one case back to step through.
//!
//! **There is no shrinking.** The counterexample you get is the one the
//! generator drew, not a smaller one, so keep the generators tight — a
//! `listOf(ctx, int(0, 3), 4)` fails with something you can read, and a
//! `listOf(ctx, int(0, 1000000), 1000)` does not.
//!
//! A failure reports through `core/testing/assert`, so it lands in `buri test`'s
//! report the way every other assertion does: the file, the line, and both
//! values.

from "core/effect" import { Allocator };
from "core/list" import * as list;
from "core/random" import * as random;
from "core/random" import { Gen };
from "core/testing/assert" import * as assert;

/// How many cases [`forAll`] and [`forAllCtx`] draw. A hundred is enough to
/// meet the shapes a generator makes often and cheap enough to sit in a suite
/// that runs on every keystroke.
export let CASES: Int = 100;

/// The seed the first case comes from.
///
/// Fixed, and that is the point: two runs of the same suite draw the same
/// hundred cases, so a property that fails fails in the report every time
/// rather than on a Tuesday.
let FIRST_SEED: Int = 0;

/// The case that broke the property, and the seed it was drawn from.
///
/// `random.seeded(seed)` handed back to the same generator draws `case` again,
/// which is how a failure is replayed.
export struct Counterexample<T> {
    export seed: Int,
    export case: T,
}

/// Fails unless `property` holds for every one of [`CASES`] drawn inputs.
///
/// ```buri role=test
/// from "core/testing/check" import * as check;
///
/// test "a draw in 0..100 is never 100" {
///     check.forAll(check.int(0, 100), fn(n) => n < 100);
/// }
/// ```
///
/// A failure reports the [`Counterexample`]:
///
/// ```text
///   assert.none failed
///     actual:   .Some(Counterexample { seed: 4372, case: 87 })
///     expected: .None
/// ```
///
/// Drawing stops at the first failure, so a broken property costs one case
/// rather than a hundred.
export fn forAll<T>(generator: fn(Gen) => (T, Gen), property: fn(T) => Bool): () {
    assert.none(firstFailure(generator, property, random.seeded(FIRST_SEED), CASES))
}

/// [`forAll`] where the generator and the property both need a context —
/// which anything that builds a list does.
///
/// ```buri role=test
/// from "core/effect" import { Allocator };
/// from "core/host/testing" import { alloc };
/// from "core/list" import * as list;
/// from "core/testing/check" import * as check;
///
/// test "sorting keeps the length" {
///     let ctx = context {
///         Allocator: alloc(),
///     };
///     check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 20), 6), fn(c, items) => {
///         items.sort(c).len() == items.len()
///     });
/// }
/// ```
export fn forAllCtx<T, C: Allocator>(
    ctx: C,
    generator: fn(C, Gen) => (T, Gen),
    property: fn(C, T) => Bool,
): () {
    assert.none(
        firstFailureCtx(ctx, generator, property, random.seeded(FIRST_SEED), CASES),
    )
}

/// Uniform in `[low, high)`, as a generator to hand to [`forAll`].
///
/// ```buri role=test
/// from "core/testing/check" import * as check;
///
/// test "a die lands on one of six faces" {
///     check.forAll(check.int(1, 7), fn(face) => face >= 1 && face <= 6);
/// }
/// ```
///
/// An empty range draws `low` every time and steps nothing, which is
/// `Gen.nextInt`'s answer rather than an abort.
export fn int(low: Int, high: Int): fn(Gen) => (Int, Gen) {
    fn(g) => g.nextInt(low, high)
}

/// Lists of `item`, between empty and `maxLength` long, with the length drawn
/// first and uniform over that range.
///
/// The `ctx` says which context the lists are built in; the generator takes one
/// again because a lambda cannot capture a context (SPEC 10.6). So this is the
/// generator [`forAllCtx`] takes, never [`forAll`]'s.
///
/// ```buri role=test
/// from "core/effect" import { Allocator };
/// from "core/host/testing" import { alloc };
/// from "core/list" import * as list;
/// from "core/testing/check" import * as check;
///
/// test "a drawn list is never longer than the bound" {
///     let ctx = context {
///         Allocator: alloc(),
///     };
///     check.forAllCtx(ctx, check.listOf(ctx, check.int(0, 10), 5), fn(_c, items) => {
///         items.len() <= 5
///     });
/// }
/// ```
///
/// A negative `maxLength` gives the empty list every time.
export fn listOf<T, C: Allocator>(
    ctx: C,
    item: fn(Gen) => (T, Gen),
    maxLength: Int,
): fn(C, Gen) => ([T], Gen) {
    // `ctx` names the context the lists are built in and is read nowhere else:
    // the lambda takes its own, because it cannot capture this one.
    let _ = ctx;
    fn(c, g) => {
        let (count, next) = g.nextInt(0, maxLength + 1);
        drawn(c, item, count, next, list.empty<T>())
    }
}

/// One case at a time, stopping at the first that fails. Tail-recursive, so a
/// hundred cases cost one frame.
fn firstFailure<T>(
    generator: fn(Gen) => (T, Gen),
    property: fn(T) => Bool,
    g: Gen,
    remaining: Int,
): Option<Counterexample<T>> {
    if (remaining <= 0) {
        .None
    } else {
        let (value, next) = generator(g);
        if (property(value)) {
            firstFailure(generator, property, next, remaining - 1)
        } else {
            .Some(Counterexample { seed: g.0.wrapToI64(), case: value })
        }
    }
}

fn firstFailureCtx<T, C: Allocator>(
    ctx: C,
    generator: fn(C, Gen) => (T, Gen),
    property: fn(C, T) => Bool,
    g: Gen,
    remaining: Int,
): Option<Counterexample<T>> {
    if (remaining <= 0) {
        .None
    } else {
        let (value, next) = generator(ctx, g);
        if (property(ctx, value)) {
            firstFailureCtx(ctx, generator, property, next, remaining - 1)
        } else {
            .Some(Counterexample { seed: g.0.wrapToI64(), case: value })
        }
    }
}

/// `count` draws, appended in the order they came out.
fn drawn<T, C: Allocator>(
    ctx: C,
    item: fn(Gen) => (T, Gen),
    remaining: Int,
    g: Gen,
    acc: [T],
): ([T], Gen) {
    if (remaining <= 0) {
        (acc, g)
    } else {
        let (value, next) = item(g);
        drawn(ctx, item, remaining - 1, next, acc.push(ctx, value))
    }
}
