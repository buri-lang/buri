//! core/orderedset — an ordered set.
//!
//! An `OrderedMap<T, ()>`, which is what a set is. Everything true of `core/orderedmap`
//! is true here: a persistent B-tree, O(log n) membership and insert, iteration
//! in order, and `range` and `prefix` that scan rather than filter. It stands to
//! `core/orderedmap` exactly as `core/set` stands to `core/map`.
//!
//! It is a wrapper rather than an alias so that `insert` takes one argument
//! instead of two, and so that `union` can exist.
//!
//! ```buri run
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/orderedset" import * as orderedset;
//! from "core/str" import * as str;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let ids = orderedset.of(ctx, [30, 10, 20, 10]);
//!     // In order, with no sort: that is what this costs a hash set's constant
//!     // lookup for.
//!     let shown = ids
//!         .toList(ctx)
//!         .mapCtx(ctx, fn(c, i) => str.fromInt(c, i))
//!         .join(ctx, " ");
//!     let _ = io.println(ctx, "${ids.len()} unique: ${shown}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 3 unique: 10 20 30
//! ```

from "core/effect" import { Allocator };
from "core/list" import * as list;
from "core/orderedmap" import * as orderedmap;
from "core/orderedmap" import { OrderedMap };

export struct OrderedSet<T> {
    members: OrderedMap<T, ()>,
}

/// The empty set. Pure, for the same reason `orderedmap.empty` is.
export fn empty<T>(): OrderedSet<T> {
    OrderedSet { members: orderedmap.empty<T, ()>() }
}

/// A set holding the given items, duplicates collapsed.
export fn of<T: Ord, C: Allocator>(ctx: C, items: [T]): OrderedSet<T> {
    items.foldCtx(ctx, fn(c, acc, x) => acc.insert(c, x), empty<T>())
}

/// The member half of an entry.
fn memberOf<T>(entry: (T, ())): T {
    let (member, _unit) = entry;
    member
}

impl<T: Ord> OrderedSet<T> {
    export fn len(self): Int {
        self.members.len()
    }

    export fn isEmpty(self): Bool {
        self.members.isEmpty()
    }

    export fn has(self, item: T): Bool {
        self.members.has(item)
    }

    export fn insert<C: Allocator>(self, ctx: C, item: T): OrderedSet<T> {
        OrderedSet { members: self.members.insert(ctx, item, ()) }
    }

    export fn remove<C: Allocator>(self, ctx: C, item: T): OrderedSet<T> {
        OrderedSet { members: self.members.remove(ctx, item) }
    }

    /// The smallest member.
    export fn first(self): Option<T> {
        self.members.first().map(fn(e) => memberOf(e))
    }

    /// The largest member.
    export fn last(self): Option<T> {
        self.members.last().map(fn(e) => memberOf(e))
    }

    /// Every member, in order.
    export fn toList<C: Allocator>(self, ctx: C): [T] {
        self.members.keys(ctx)
    }

    /// The members that are at least `start` and less than `end`, in order.
    /// Half-open, like `orderedmap.range`.
    export fn range<C: Allocator>(self, ctx: C, start: T, end: T): [T] {
        self.members.range(ctx, start, end).map(ctx, fn(e) => memberOf(e))
    }

    export fn union<C: Allocator>(self, ctx: C, other: OrderedSet<T>): OrderedSet<T> {
        other.toList(ctx).foldCtx(ctx, fn(c, acc, x) => acc.insert(c, x), self)
    }

    export fn intersect<C: Allocator>(self, ctx: C, other: OrderedSet<T>): OrderedSet<T> {
        let theirs = other;
        of(ctx, self.toList(ctx).filterCtx(ctx, fn(_c, x) => theirs.has(x)))
    }

    /// The members of `self` that are not in `other`.
    export fn difference<C: Allocator>(self, ctx: C, other: OrderedSet<T>): OrderedSet<T> {
        let theirs = other;
        of(ctx, self.toList(ctx).filterCtx(ctx, fn(_c, x) => !theirs.has(x)))
    }

    export fn isSubsetOf<C: Allocator>(self, ctx: C, other: OrderedSet<T>): Bool {
        let theirs = other;
        self.toList(ctx).all(fn(x) => theirs.has(x))
    }

    /// Whether every member of `other` is also in `self`. `isSubsetOf` read
    /// from the other end.
    export fn isSupersetOf<C: Allocator>(self, ctx: C, other: OrderedSet<T>): Bool {
        other.isSubsetOf(ctx, self)
    }

    /// The members in exactly one of the two, in order.
    export fn symmetricDifference<C: Allocator>(self, ctx: C, other: OrderedSet<T>): OrderedSet<T> {
        self.difference(ctx, other).union(ctx, other.difference(ctx, self))
    }

    /// Whether the two share no member at all.
    ///
    /// **It builds no set**, where `intersect` then `isEmpty` allocates the
    /// whole intersection to ask a yes-or-no question. It walks the smaller
    /// side and stops at the first member the other one holds.
    export fn isDisjointFrom<C: Allocator>(self, ctx: C, other: OrderedSet<T>): Bool {
        if (self.len() <= other.len()) {
            let theirs = other;
            self.toList(ctx).all(fn(x) => !theirs.has(x))
        } else {
            let mine = self;
            other.toList(ctx).all(fn(x) => !mine.has(x))
        }
    }

    /// The members `keep` answers true for, in order.
    export fn filter<C: Allocator>(self, ctx: C, keep: fn(T) => Bool): OrderedSet<T> {
        of(ctx, self.toList(ctx).filterCtx(ctx, fn(_c, x) => keep(x)))
    }

    /// The largest member that is at most `item`. One descent, and pure —
    /// `range` cannot answer it, because "nearest at or below" has only one
    /// end.
    export fn floor(self, item: T): Option<T> {
        self.members.floor(item).map(fn(e) => memberOf(e))
    }

    /// The smallest member that is at least `item`. `floor` from the other
    /// side.
    export fn ceiling(self, item: T): Option<T> {
        self.members.ceiling(item).map(fn(e) => memberOf(e))
    }

    /// Same members, whatever order either was built in.
    export fn equals<C: Allocator>(self, ctx: C, other: OrderedSet<T>): Bool {
        self.len() == other.len() && self.isSubsetOf(ctx, other)
    }
}

impl OrderedSet<Str> {
    /// The members beginning with `prefix`, in order. `core/orderedmap`'s module
    /// comment defines what a prefix is.
    export fn prefix<C: Allocator>(self, ctx: C, prefix: Str): [Str] {
        self.members.prefix(ctx, prefix).map(ctx, fn(e) => memberOf(e))
    }
}

/// The list with later duplicates dropped, the first of each kept and the order
/// left alone.
///
/// `core/set`'s `distinct` over `Ord` rather than `Hash + Eq`: O(n log n)
/// against that one's O(n), and still well under `core/list`'s `uniqueBy`,
/// which asks about everything already kept and costs O(n²).
export fn distinct<T: Ord, C: Allocator>(ctx: C, xs: [T]): [T] {
    let (kept, _seen) = xs.foldCtx(
        ctx,
        fn(c, acc: ([T], OrderedSet<T>), x) => {
            let (out, seen) = acc;
            if (seen.has(x)) { acc } else { (out.push(c, x), seen.insert(c, x)) }
        },
        (list.empty<T>(), empty<T>()),
    );
    kept
}

/// [`distinct`] over a key: the first element answering each key is kept, and
/// the rest go. One `key` call per element.
export fn distinctBy<A, K: Ord, C: Allocator>(ctx: C, xs: [A], key: fn(A) => K): [A] {
    let (kept, _seen) = xs.foldCtx(
        ctx,
        fn(c, acc: ([A], OrderedSet<K>), x) => {
            let (out, seen) = acc;
            let k = key(x);
            if (seen.has(k)) { acc } else { (out.push(c, x), seen.insert(c, k)) }
        },
        (list.empty<A>(), empty<K>()),
    );
    kept
}
