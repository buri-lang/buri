//! ui/effect — the effects a user interface platform grants.
//!
//! These take the same shape as the standard library's other effect
//! declarations. An effect is an interface declared with `effect` instead of
//! `trait`, only a platform module may declare one, and its implementors are
//! effect-carrying, so they may be passed only as `self` or `ctx` (SPEC 10.1,
//! 10.2).
//!
//! **A signal handle is inert data, and the authority to read or write it
//! travels through `ctx`.** `Signal<T>` and `Prop<T>`, in `ui/signal` and
//! `ui/prop`, are ordinary capturable data; nothing in them can do anything
//! without one of the effects below.
//!
//! A signal identifier is an `Int` here rather than a `Signal<T>` because this
//! module is the boundary with the runtime, which holds one graph of untyped
//! cells. The typed handle is built on top, in ordinary Buri.
//!
//! A page asks for `Network` like every other platform: there is no fetch effect
//! here.

from "core/effect" import { Allocator, Region };
from "core/time" import { Duration };

/// Reading signals, alone.
///
/// Separate from `Ui` so a computation can hold read authority and nothing else.
/// A `fn(Scope) => T` can observe the graph and cannot change it.
export effect Watch {
    /// The current value of the cell `id` names.
    ///
    /// Reading inside a computation records a dependency, so the computation
    /// re-runs when that cell changes. Reading outside one records nothing.
    fn read<T>(self, id: Int): T;
}

/// Creating and writing signals, and registering computations.
///
/// **`Ui` and `Watch` are independent bounds, and a function that reads what it
/// wrote names both.** A `C: Ui` does not satisfy `Watch`: a bound is a list of
/// interfaces the type parameter must satisfy, and nothing in the language makes
/// one bound stand in for another.
///
/// ```buri sig
/// # from "ui/effect" import { Ui, Watch };
/// # from "ui/signal" import { Signal };
///
/// export fn bump<C: Ui + Watch>(ctx: C, cell: Signal<Int>): () {
///     cell.set(ctx, cell.get(ctx) + 1)
/// }
/// ```
///
/// `read` is declared here as well because `update` reads the old value on its
/// way to writing the new one.
export effect Ui {
    /// A fresh cell holding `initial`. The returned `Int` names it for the
    /// lifetime of the program.
    fn signal<T>(self, initial: T): Int;
    /// The current value of the cell `id` names.
    fn read<T>(self, id: Int): T;
    /// Replaces the value of the cell `id` names, marking everything that read
    /// it out of date.
    fn write<T>(self, id: Int, value: T): ();
    /// A derived cell: `compute` runs on demand, and again only after something
    /// it read has changed. Lazy, so a memo nothing reads never runs.
    fn memo<T>(self, compute: fn(Scope) => T): Int;
    /// A computation run for its effect on the world rather than its value. It
    /// runs once immediately, which is how it learns what it depends on, then
    /// again whenever any of that changes.
    ///
    /// Named `watch` rather than `effect` because `effect` is a keyword.
    fn watch(self, run: fn(Scope) => ()): ();
    /// Registers `run` to fire on the graph's own turn once `millis`
    /// milliseconds have passed, and answers a handle that names it.
    ///
    /// The runtime hands `run` a context of its own — the same one this method
    /// was called on — so the callback may write signals, exactly as a handler
    /// does. That is why `run` takes `Self` rather than a `Scope`, and why it
    /// is the runtime that supplies it: a lambda captures no context (SPEC
    /// 10.6), so the way a delayed body reaches one is to be handed it, the way
    /// `each`'s row builder is.
    fn schedule(self, millis: Int, run: fn(Self) => ()): Int;
    /// Stops a pending scheduled run by its handle. One that has already fired
    /// or already been stopped is a no-op.
    fn unschedule(self, id: Int): ();
}

/// A pending scheduled run, returned by `after` and stopped by `cancel`.
///
/// Opaque on purpose: the field is a graph index and nothing more, so holding
/// one carries no authority — the authority to schedule and to cancel travels
/// through `ctx`, the way it does for a `Signal`. A lambda may capture one,
/// which is what lets a hover-pause hold the timer it means to cancel.
export struct Timer(Int);

/// Runs `run` on the graph's own turn once `duration` has passed, and answers a
/// `Timer` that names the pending run.
///
/// `Ui`-granted, so it is reachable from an event handler — which is the whole
/// point: a handler runs to completion, so nothing it does can happen *after* a
/// delay unless the delay is scheduled on the graph rather than waited on in
/// place. `run` is handed a context of its own when it fires, so it may write
/// signals: a toast's handler calls `after` on the write and the toast takes
/// itself away when the timer fires.
///
/// The duration is read in whole milliseconds — a length finer than that
/// schedules on the next turn.
export fn after<C: Ui>(ctx: C, duration: Duration, run: fn(C) => ()): Timer {
    Timer(ctx.schedule(duration.milliseconds(), run))
}

/// Stops a pending timer. A timer that has already fired, or already been
/// cancelled, is a no-op — so the hover-pause that cancels on pointer-enter and
/// schedules a fresh one on pointer-leave never has to ask which state it is in.
export fn cancel<C: Ui>(ctx: C, timer: Timer): () {
    ctx.unschedule(timer.0)
}

/// What a reactive closure is handed: reading the graph, and allocating.
///
/// Minted only by the runtime, when it evaluates a computation. Concrete so
/// that closure types can name it, which keeps `Prop` and `Style` free of a
/// context type parameter. Its field is private, so no program can build one,
/// and it is effect-carrying, so it may only arrive as `ctx`.
///
/// ```buri
/// from "ui/effect" import { Scope };
///
/// fn evens(ctx: Scope, xs: [Int]): [Int] {
///     xs.filter(ctx, fn(value) => value % 2 == 0)
/// }
/// ```
///
/// **It cannot write.** Reading and allocating are what a derivation does;
/// writing a signal it read would be a loop the runtime schedules rather than a
/// value it caches. `Ui` is the effect that writes, and a `Scope` is not one.
export struct Scope(Int);

impl Watch for Scope {
    fn read<T>(self, id: Int): T;
}

/// Allocating hands out nothing: `Allocator` is the one effect whose
/// implementation carries no authority, because a `Region` is a number
/// (`core/alloc`'s own header says why that module is importable anywhere).
/// So a `Scope` charges the request and counts nothing, exactly as `core/host`'s
/// allocator does — a derived value is reclaimed when the last reference to it
/// goes, and no budget is attached to a computation.
///
/// Without this a derivation could not map, filter, sort or format, and an app
/// whose state lives in signals would render once and go stale.
impl Allocator for Scope {
    fn allocate(self, bytes: Int): Region {
        Region(bytes)
    }
}

/// Something a reader did.
///
/// Opaque in this version. There are two shapes of handler — a press, on a
/// button, and a submission, on a form — and both receive one of these. There is
/// no change handler: a field and a toggle bind to a `Signal`, so what the
/// reader typed is already there. Hover, focus and pressed are appearance, so
/// they live in `ui/style`.
///
/// Holds no authority, so a lambda may capture one. Its field is private, so
/// only the runtime can mint one.
export struct Event(Int);

/// The address the page is at.
///
/// **Granted on WEB alone.** Nothing else has an address bar: a worker is
/// handed a request and reads the path off that, and a native program has
/// neither.
///
/// It answers a cell rather than a string. `ui/web`'s `path` reads it and
/// `ui/web`'s `route` wraps it in a `Prop`, so a computation that read the path
/// re-runs when the reader navigates and nothing else does.
///
/// The two writers are the history's, not the cell's: they put an address in
/// the address bar and say whether the reader can come back to the one they
/// left. `ui/web`'s `navigate` and `replace` are the doors, and each writes the
/// cell itself — so the address the graph sees is the address the bar shows,
/// whichever of the two moved it.
export effect Location {
    /// The cell holding the path of the page's address, as `/guide/routing`.
    /// The runtime writes it when the reader navigates.
    fn path(self): Int;
    /// A new history entry at `path`, which the reader can press Back out of.
    fn push(self, path: Str): ();
    /// `path` in place of the entry the reader is on, which Back does not
    /// return to. What a redirect wants.
    fn replace(self, path: Str): ();
}
