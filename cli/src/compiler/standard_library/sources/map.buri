//! core/map — a hash map.
//!
//! A list of buckets, each an association list, indexed by the key's `Hash`.
//! Lookup is O(1) expected; insert copies the bucket spine, which is O(b) in
//! the number of buckets rather than O(n) in the number of entries.
//!
//! **Iteration order is unspecified and will change.** It follows the bucket
//! layout, which follows the hashes, which follow the values. Anything that
//! needs a stable order should sort `entries` — or use an association list,
//! which is what `core/json` does for exactly this reason.
//!
//! ```buri run
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/map" import * as map;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let counts = map.of(ctx, [("a", 1), ("b", 2)]).insert(ctx, "a", 9);
//!     // Inserting an existing key replaces its value and leaves the size alone.
//!     let a = counts.get("a").withDefault(0);
//!     let _ = io.println(ctx, "a=${a}, ${counts.length()} entries").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! a=9, 2 entries
//! ```

from "core/bits" import * as bits;
from "core/effect" import { Allocator };
from "core/list" import * as list;

/// The buckets, and how many entries are spread across them.
///
/// The map carries `size` rather than summing the buckets, which would make
/// `length` O(b).
export struct Map<K, V> {
    buckets: [[(K, V)]],
    export size: Int,
}

/// How many buckets a new map has. Small, because most maps are.
let INITIAL: Int = 8;

/// Entries per bucket, averaged, before the map grows. Above this the
/// association lists stop being short and lookup stops being constant.
let LOAD: Int = 4;

/// A bucket index for a hash.
///
/// The top bit is shifted out first: `wrapToI64` on a `U64` above `I64`'s
/// maximum produces a negative number, and a negative index is not a bucket.
fn bucketOf(h: U64, count: Int): Int {
    if (count <= 0) { 0 } else { bits.shrU64(h, 1).wrapToI64() % count }
}

/// The bucket list with position `at` replaced, by splicing rather than by
/// mapping over the indices.
///
/// A free function rather than a lambda at each use site: a lambda may not
/// capture a value whose type could be a context, and `V` is unbounded here, so
/// `[[(K, V)]]` is exactly such a type (SPEC 10.6).
fn replaceAt<K, V, C: Allocator>(
    ctx: C,
    buckets: [[(K, V)]],
    at: Int,
    bucket: [(K, V)],
): [[(K, V)]] {
    buckets.take(ctx, at).push(ctx, bucket).concat(ctx, buckets.drop(ctx, at + 1))
}

/// The empty map.
///
/// Pure, and with no buckets at all: the first `insert` allocates them. That is
/// what makes the function callable. The compiler generates a context type and
/// gives it no name (SPEC 11.3), so nobody can write `empty<Str, Int, C>()`, and
/// a written type argument list is all-or-nothing.
export fn empty<K, V>(): Map<K, V> {
    Map { buckets: list.empty<[(K, V)]>(), size: 0 }
}

impl<K: Hash + Equal, V> Map<K, V> {
    export fn length(self): Int {
        self.size
    }

    export fn isEmpty(self): Bool {
        self.size == 0
    }

    /// The value stored under `key`, if there is one.
    export fn get(self, key: K): Option<V> {
        let buckets = self.buckets;
        let b = buckets
            .get(bucketOf(key.hash(), buckets.length()))
            .withDefault(list.empty<(K, V)>());
        b
            .find(fn(e) => {
                let (k, _v) = e;
                k == key
            })
            .map(fn(e) => {
                let (_k, v) = e;
                v
            })
    }

    export fn has(self, key: K): Bool {
        self.get(key).isSome()
    }

    /// Stores `value` under `key`, replacing whatever was there.
    export fn insert<C: Allocator>(self, ctx: C, key: K, value: V): Map<K, V> {
        let grown = if (self.size + 1 > self.buckets.length() * LOAD) {
            self.grow(ctx)
        } else {
            self
        };
        let buckets = grown.buckets;
        let target = bucketOf(key.hash(), buckets.length());
        let existing = buckets.get(target).withDefault(list.empty<(K, V)>());
        let replaced = existing.any(fn(e) => {
            let (k, _v) = e;
            k == key
        });
        let kept = existing.filterCtx(ctx, fn(_c, e) => {
            let (k, _v) = e;
            k != key
        });
        let bucket = kept.push(ctx, (key, value));
        // Splice rather than rebuild by index: a lambda may not capture
        // `buckets`, since `[[(K, V)]]` would carry an effect at `V := C`
        // (SPEC 10.6).
        let next = replaceAt(ctx, buckets, target, bucket);
        Map {
            buckets: next,
            size: if (replaced) { grown.size } else { grown.size + 1 },
        }
    }

    /// Removes `key`, if it is there. Removing what is absent is not an error.
    export fn remove<C: Allocator>(self, ctx: C, key: K): Map<K, V> {
        let buckets = self.buckets;
        let target = bucketOf(key.hash(), buckets.length());
        let existing = buckets.get(target).withDefault(list.empty<(K, V)>());
        let kept = existing.filterCtx(ctx, fn(_c, e) => {
            let (k, _v) = e;
            k != key
        });
        if (kept.length() == existing.length()) {
            self
        } else {
            let next = replaceAt(ctx, buckets, target, kept);
            Map { buckets: next, size: self.size - 1 }
        }
    }

    /// Every entry, in no particular order — see the module comment.
    export fn entries<C: Allocator>(self, ctx: C): [(K, V)] {
        self.buckets.flatten(ctx)
    }

    export fn keys<C: Allocator>(self, ctx: C): [K] {
        self
            .entries(ctx)
            .map(ctx, fn(e) => {
                let (k, _v) = e;
                k
            })
    }

    export fn values<C: Allocator>(self, ctx: C): [V] {
        self
            .entries(ctx)
            .map(ctx, fn(e) => {
                let (_k, v) = e;
                v
            })
    }

    /// Insert, replace or remove in one call. `update` gets what is stored
    /// under `key` — `.Some(v)` or `.None` — and what it answers is what gets
    /// stored afterwards, with `.None` meaning "not there".
    ///
    /// A counter is `alter(ctx, k, fn(n) => .Some(n.withDefault(0) + 1))`.
    /// `core/orderedmap` has the same method with the same meaning.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/map" import * as map;
    /// from "core/str" import * as str;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let counts = map.of(ctx, [("a", 1)]);
    ///     // One call whether or not the key is there, and one that removes.
    ///     let bumped = counts
    ///         .alter(ctx, "a", fn(n) => .Some(n.withDefault(0) + 1))
    ///         .alter(ctx, "b", fn(n) => .Some(n.withDefault(0) + 1))
    ///         .alter(ctx, "a", fn(_n) => .None);
    ///     let keys = bumped.keys(ctx).join(ctx, " ");
    ///     let b = str.fromInt(ctx, bumped.get("b").withDefault(0));
    ///     let _ = io.println(ctx, "${keys}=${b}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// b=1
    /// ```
    export fn alter<C: Allocator>(
        self,
        ctx: C,
        key: K,
        update: fn(Option<V>) => Option<V>,
    ): Map<K, V> {
        match (update(self.get(key))) {
            .Some(v) => self.insert(ctx, key, v),
            .None => self.remove(ctx, key),
        }
    }

    /// The same keys, every value put through `transform`.
    ///
    /// It rebuilds the map rather than copying the buckets, so it costs one
    /// insert per entry. The iteration order is still unspecified.
    export fn mapValues<W, C: Allocator>(self, ctx: C, transform: fn(V) => W): Map<K, W> {
        self
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, W>, e) => {
                    let (k, v) = e;
                    acc.insert(c, k, transform(v))
                },
                empty<K, W>(),
            )
    }

    /// The same keys, each value `transform` keeps. A `.None` drops the entry,
    /// so this is `mapValues` and `filter` in one pass.
    export fn filterMapValues<W, C: Allocator>(
        self,
        ctx: C,
        transform: fn(V) => Option<W>,
    ): Map<K, W> {
        self
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, W>, e) => {
                    let (k, v) = e;
                    match (transform(v)) {
                        .None => acc,
                        .Some(w) => acc.insert(c, k, w),
                    }
                },
                empty<K, W>(),
            )
    }

    /// Both maps' entries, `other`'s winning where a key is in both.
    ///
    /// Right-biased on purpose: `defaults.merge(ctx, overrides)` reads the way
    /// it is used. Reach for `mergeWith` when a collision is not a replacement.
    export fn merge<C: Allocator>(self, ctx: C, other: Map<K, V>): Map<K, V> {
        other
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, V>, e) => {
                    let (k, v) = e;
                    acc.insert(c, k, v)
                },
                self,
            )
    }

    /// Both maps' entries, with `combine(mine, theirs)` deciding a key that is
    /// in both. `combine` is called only for those keys.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/map" import * as map;
    /// from "core/str" import * as str;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let monday = map.of(ctx, [("ana", 2), ("bo", 1)]);
    ///     let tuesday = map.of(ctx, [("ana", 3), ("cy", 5)]);
    ///     let total = monday.mergeWith(ctx, tuesday, fn(a, b) => a + b);
    ///     let ana = str.fromInt(ctx, total.get("ana").withDefault(0));
    ///     let cy = str.fromInt(ctx, total.get("cy").withDefault(0));
    ///     let _ = io.println(ctx, "ana=${ana} cy=${cy}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// ana=5 cy=5
    /// ```
    export fn mergeWith<C: Allocator>(
        self,
        ctx: C,
        other: Map<K, V>,
        combine: fn(V, V) => V,
    ): Map<K, V> {
        other
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, V>, e) => {
                    let (k, v) = e;
                    match (acc.get(k)) {
                        .None => acc.insert(c, k, v),
                        .Some(mine) => acc.insert(c, k, combine(mine, v)),
                    }
                },
                self,
            )
    }

    /// The entries `keep` answers true for.
    export fn filter<C: Allocator>(self, ctx: C, keep: fn(K, V) => Bool): Map<K, V> {
        self
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, V>, e) => {
                    let (k, v) = e;
                    if (keep(k, v)) { acc.insert(c, k, v) } else { acc }
                },
                empty<K, V>(),
            )
    }

    /// The value under `key` and the map without it, or `.None` when the key is
    /// not there. Taking an entry out and using it is one call rather than a
    /// `get` beside a `remove`.
    export fn pop<C: Allocator>(self, ctx: C, key: K): Option<(V, Map<K, V>)> {
        match (self.get(key)) {
            .None => .None,
            .Some(v) => .Some((v, self.remove(ctx, key))),
        }
    }

    /// Only the entries whose keys are in `keys`. A key that is not in the map
    /// is skipped rather than an error.
    export fn takeKeys<C: Allocator>(self, ctx: C, keys: [K]): Map<K, V> {
        let wanted = of(ctx, keys.map(ctx, fn(k) => (k, ())));
        self
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, V>, e) => {
                    let (k, v) = e;
                    if (wanted.has(k)) { acc.insert(c, k, v) } else { acc }
                },
                empty<K, V>(),
            )
    }

    /// Everything but the entries whose keys are in `keys`.
    export fn dropKeys<C: Allocator>(self, ctx: C, keys: [K]): Map<K, V> {
        let unwanted = of(ctx, keys.map(ctx, fn(k) => (k, ())));
        self
            .entries(ctx)
            .foldCtx(
                ctx,
                fn(c, acc: Map<K, V>, e) => {
                    let (k, v) = e;
                    if (unwanted.has(k)) { acc } else { acc.insert(c, k, v) }
                },
                empty<K, V>(),
            )
    }

    /// Twice the buckets, everything rehashed. `insert` calls it once the entries
    /// outgrow the load factor, so the association lists stay short and lookup
    /// stays expected-constant.
    fn grow<C: Allocator>(self, ctx: C): Map<K, V> {
        // From nothing, the initial size; otherwise twice what there was.
        let count = if (self.buckets.length() == 0) {
            INITIAL
        } else {
            self.buckets.length() * 2
        };
        let all = self.buckets.flatten(ctx);
        // One pass over the entries, each dropped into its new bucket. A fold
        // takes the accumulator as a *parameter*, and a lambda may not capture a
        // `[(K, V)]` when `V` is unbounded and so could be a context (SPEC 10.6).
        let blank = list.repeat(ctx, list.empty<(K, V)>(), count);
        // `acc` is annotated because type information flows left-to-right and
        // the checker has not reached `blank` yet (guides/compile-speed.md).
        let next = all.foldCtx(
            ctx,
            fn(c, acc: [[(K, V)]], e) => {
                let (k, _v) = e;
                let at = bucketOf(k.hash(), count);
                let bucket = acc.get(at).withDefault(list.empty<(K, V)>()).push(c, e);
                replaceAt(c, acc, at, bucket)
            },
            blank,
        );
        Map { buckets: next, size: self.size }
    }
}

/// The elements of `xs` collected under `key(x)`, each group in the order the
/// elements arrived in.
///
/// A free function rather than a method on `[T]`: `core/list` sits at the bottom
/// of the dependency order and cannot name a `Map`.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/map" import * as map;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let words = ["ant", "bee", "ape", "bat"];
///     let byLetter = map.groupBy(ctx, words, fn(w: Str) => w.slice(0, 1));
///     let a = byLetter.get("a").withDefault([]).join(ctx, " ");
///     let _ = io.println(ctx, "a: ${a}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// a: ant ape
/// ```
export fn groupBy<A, K: Hash + Equal, C: Allocator>(
    ctx: C,
    xs: [A],
    key: fn(A) => K,
): Map<K, [A]> {
    xs.foldCtx(
        ctx,
        fn(c, acc: Map<K, [A]>, x) => {
            let k = key(x);
            let group = acc.get(k).withDefault(list.empty<A>());
            acc.insert(c, k, group.push(c, x))
        },
        empty<K, [A]>(),
    )
}

/// One element per key rather than a group of them: `key(x)` to `x`, with a
/// later element replacing an earlier one that answered the same key.
///
/// This is the index you look a list up through. Reach for `groupBy` when the
/// key is not unique: this one *silently* keeps the last.
export fn indexBy<A, K: Hash + Equal, C: Allocator>(
    ctx: C,
    xs: [A],
    key: fn(A) => K,
): Map<K, A> {
    xs.foldCtx(ctx, fn(c, acc: Map<K, A>, x) => acc.insert(c, key(x), x), empty<K, A>())
}

/// A map holding the given entries, later ones winning.
export fn of<K: Hash + Equal, V, C: Allocator>(ctx: C, entries: [(K, V)]): Map<K, V> {
    entries.foldCtx(
        ctx,
        fn(c, acc, e) => {
            let (k, v) = e;
            acc.insert(c, k, v)
        },
        empty<K, V>(),
    )
}

impl<K: Hash + Equal, V: Equal> Map<K, V> {
    /// Same entries, whatever bucket layout each arrived at. `derive Equal` would
    /// compare the layout, which two equal maps built in different orders need
    /// not share.
    export fn equals<C: Allocator>(self, ctx: C, other: Map<K, V>): Bool {
        if (self.size != other.size) {
            false
        } else {
            let theirs = other;
            self
                .entries(ctx)
                .all(fn(e) => {
                    let (k, v) = e;
                    theirs.get(k) == .Some(v)
                })
        }
    }
}

/// How many elements answer each key. One pass over the list, so it costs what
/// `groupBy` costs without building the groups.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/map" import * as map;
/// from "core/str" import * as str;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let words = ["ant", "bee", "ape", "bat"];
///     let counts = map.countBy(ctx, words, fn(w: Str) => w.slice(0, 1));
///     let a = str.fromInt(ctx, counts.get("a").withDefault(0));
///     let _ = io.println(ctx, "a: ${a}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// a: 2
/// ```
export fn countBy<A, K: Hash + Equal, C: Allocator>(
    ctx: C,
    xs: [A],
    key: fn(A) => K,
): Map<K, Int> {
    xs.foldCtx(
        ctx,
        fn(c, acc: Map<K, Int>, x) => {
            let k = key(x);
            acc.insert(c, k, acc.get(k).withDefault(0) + 1)
        },
        empty<K, Int>(),
    )
}

/// How many times each element appears. `countBy` with the element as its own
/// key, which is the histogram every word count wants.
export fn frequencies<T: Hash + Equal, C: Allocator>(ctx: C, xs: [T]): Map<T, Int> {
    countBy(ctx, xs, fn(x: T) => x)
}
