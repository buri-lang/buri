//! core/heap — a priority queue.
//!
//! A **pairing heap**: `push` and `merge` are O(1), `peek` is O(1) and pure,
//! and `pop` is O(log n) amortized. The collection `core/queue` is not — a
//! deque answers at the ends it was written at, not at the smallest element —
//! and the one `core/ordset` is not either, because a set collapses duplicates
//! and a work queue holds the same priority twice.
//!
//! **What this costs.** A `Heap` is a value, like everything else, so `push`
//! answers a new one and the two share every node but the root. The amortized
//! bound on `pop` is what "amortized" says: one `pop` after a run of pushes
//! moves every child of the root, and the pairing pass pays for it across the
//! pops that follow.
//!
//! **Smallest first.** `peek` and `pop` answer the least element by `Ord`. For
//! largest-first, key the elements by a struct with a `compare` that flips —
//! `core/order`'s `reverse` is the same idea one level down.
//!
//! ```buri run
//! from "core/effect" import { Alloc, Stdout };
//! from "core/heap" import * as heap;
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/str" import * as str;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let work = heap.of(ctx, [30, 10, 20]).push(ctx, 5);
//!     let first = str.fromInt(ctx, work.peek().withDefault(0));
//!     let order = work
//!         .toSortedList(ctx)
//!         .mapCtx(ctx, fn(c, i) => str.fromInt(c, i))
//!         .join(ctx, " ");
//!     let _ = io.println(ctx, "${first} first, then ${order}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 5 first, then 5 10 20 30
//! ```

from "core/effect" import { Alloc };
from "core/list" import * as list;

/// A node and everything under it, or nothing.
///
/// Every child of a node holds an element at least as large as the node's, so
/// the smallest element of a whole tree is at its root and `peek` reads one
/// field. The children are in no particular order — a pairing heap does not
/// balance, it merges.
enum Tree<T> {
    Empty,
    Node(T, [Tree<T>]),
}

/// A priority queue, as a value.
///
/// `size` is carried rather than walked: callers ask `length` far more often
/// than the heap changes.
export struct Heap<T> {
    root: Tree<T>,
    export size: Int,
}

/// The empty heap. Pure: a context type has no name, so a `<T, C>` here could
/// not be written at a call site (SPEC 11.3).
export fn empty<T>(): Heap<T> {
    Heap { root: .Empty, size: 0 }
}

/// A heap holding every item, duplicates and all.
export fn of<T: Ord, C: Alloc>(ctx: C, items: [T]): Heap<T> {
    items.foldCtx(ctx, fn(c, acc: Heap<T>, x) => acc.push(c, x), empty<T>())
}

/// Two trees into one: the larger root becomes a child of the smaller.
///
/// This is the whole data structure. `push` melds a one-element tree, `merge`
/// melds two heaps, and `pop` melds what is left of the root's children — each
/// of them one comparison and one `push` onto a child list.
fn meld<T: Ord, C: Alloc>(ctx: C, a: Tree<T>, b: Tree<T>): Tree<T> {
    match (a) {
        .Empty => b,
        .Node(x, xs) => {
            match (b) {
                .Empty => a,
                .Node(y, ys) => {
                    if (y.compare(x).isLess()) {
                        .Node(y, ys.push(ctx, a))
                    } else {
                        .Node(x, xs.push(ctx, b))
                    }
                },
            }
        },
    }
}

/// The children of a popped root, melded in pairs and then right to left.
///
/// The two passes are what the O(log n) amortized bound rests on: melding
/// left to right in one pass leaves a spine as long as the child list, and the
/// next `pop` walks all of it. Both passes are folds rather than recursion,
/// because a root that has just taken n pushes has n children and a recursion
/// per pair would be n/2 frames deep.
fn mergePairs<T: Ord, C: Alloc>(ctx: C, children: [Tree<T>]): Tree<T> {
    let paired = list
        .range(ctx, 0, (children.len() + 1) / 2)
        .mapCtx(
            ctx,
            fn(c, i) => {
                let first = children.get(i * 2).withDefault(.Empty);
                let second = children.get(i * 2 + 1).withDefault(.Empty);
                meld(c, first, second)
            },
        );
    paired
        .reverse(ctx)
        .foldCtx(ctx, fn(c, acc: Tree<T>, one) => meld(c, one, acc), .Empty)
}

/// Pops until there is nothing left, in a tail call rather than a `map` over
/// something no one has yet.
fn drain<T: Ord, C: Alloc>(ctx: C, h: Heap<T>, acc: [T]): [T] {
    match (h.pop(ctx)) {
        .None => acc,
        .Some(taken) => {
            let (x, rest) = taken;
            drain(ctx, rest, acc.push(ctx, x))
        },
    }
}

impl<T: Ord> Heap<T> {
    export fn length(self): Int {
        self.size
    }

    export fn isEmpty(self): Bool {
        self.size == 0
    }

    /// The smallest element, without taking it out. O(1) and pure: it is the
    /// root, and every child is at least as large.
    export fn peek(self): Option<T> {
        match (self.root) {
            .Empty => .None,
            .Node(x, _children) => .Some(x),
        }
    }

    /// The heap with `item` in it. O(1): one comparison against the root.
    export fn push<C: Alloc>(self, ctx: C, item: T): Heap<T> {
        Heap {
            root: meld(ctx, self.root, .Node(item, list.empty<Tree<T>>())),
            size: self.size + 1,
        }
    }

    /// The smallest element and the heap without it, or `.None` when there is
    /// nothing left. O(log n) amortized — the root goes and its children are
    /// melded back together in pairs.
    export fn pop<C: Alloc>(self, ctx: C): Option<(T, Heap<T>)> {
        match (self.root) {
            .Empty => .None,
            .Node(x, children) => {
                .Some(
                    (
                        x,
                        Heap { root: mergePairs(ctx, children), size: self.size - 1 },
                    ),
                )
            },
        }
    }

    /// Both heaps' elements, duplicates kept. O(1): one comparison between the
    /// two roots.
    export fn merge<C: Alloc>(self, ctx: C, other: Heap<T>): Heap<T> {
        Heap {
            root: meld(ctx, self.root, other.root),
            size: self.size + other.size,
        }
    }

    /// Every element, smallest first. O(n log n): it is `pop` until empty.
    export fn toSortedList<C: Alloc>(self, ctx: C): [T] {
        drain(ctx, self, list.empty<T>())
    }
}
