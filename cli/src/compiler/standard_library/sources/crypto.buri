        3835390401,
        4022224774,
        264347078,
        604807628,
        770255983,
        1249150122,
        1555081692,
        1996064986,
        2554220882,
        2821834349,
        2952996808,
        3210313671,
        3336571891,
        3584528711,
        113926993,
        338241895,
        666307205,
        773529912,
        1294757372,
        1396182291,
        1695183700,
        1986661051,
        2177026350,
        2456956037,
        2730485921,
        2820302411,
        3259730800,
        3345764771,
        3516065817,
        3600352804,
        4094571909,
        275423344,
        430227734,
        506948616,
        659060556,
        883997877,
        958139571,
        1322822218,
        1537002063,
        1747873779,
        1955562222,
        2024104815,
        2227730452,
        2361852424,
        2428436474,
        2756734187,
        3204031479,
        3329325298,
    ];
    k.map(ctx, fn(x) => x)
}

/// Rotate right, within 32 bits.
///
/// `bits` has rotation for `Int` and shifts for `U32`, so this is the two
/// shifts, or-ed. It is correct only because the unsigned bitwise operators
/// narrow to the type's width.
fn rotr(x: U32, n: Int): U32 {
    bits.shiftRightU32(x, n) | bits.shiftLeftU32(x, 32 - n)
}

/// The message, padded: a one bit, then zeros, then the length in bits as a
/// big-endian 64-bit number, to a multiple of 64 bytes.
fn pad<C: Allocator>(ctx: C, message: [U8]): [U8] {
    let n = message.length();
    let bitLength = n * 8;
    // One byte for the `0x80`, eight for the length; zeros to fill the block.
    let zeros = (55 - n % 64 + 64) % 64;
    let lengthBytes = list
        .range(ctx, 0, 8)
        .map(ctx, fn(i) => bits.shiftRight(bitLength, (7 - i) * 8).wrapToU8());
    message
        .push(ctx, 128)
        .concat(ctx, list.repeat(ctx, 0, zeros))
        .concat(ctx, lengthBytes)
}

/// The 64-entry message schedule for one block.
fn schedule<C: Allocator>(ctx: C, block: [U8]): [U32] {
    let first = list
        .range(ctx, 0, 16)
        .map(ctx, fn(i) => {
            let b0 = block.get(i * 4).withDefault(0).toI64();
            let b1 = block.get(i * 4 + 1).withDefault(0).toI64();
            let b2 = block.get(i * 4 + 2).withDefault(0).toI64();
            let b3 = block.get(i * 4 + 3).withDefault(0).toI64();
            (b0 * 16777216 + b1 * 65536 + b2 * 256 + b3).wrapToU32()
        });
    extend(ctx, first, 16)
}

/// Rounds 16 to 63, each from four earlier words. Tail-recursive, so the
/// sixty-four steps cost one frame.
fn extend<C: Allocator>(ctx: C, w: [U32], i: Int): [U32] {
    if (i >= 64) {
        w
    } else {
        let a = w.get(i - 15).withDefault(0);
        let b = w.get(i - 2).withDefault(0);
        let s0 = rotr(a, 7) ^ rotr(a, 18) ^ bits.shiftRightU32(a, 3);
        let s1 = rotr(b, 17) ^ rotr(b, 19) ^ bits.shiftRightU32(b, 10);
        let next = w
            .get(i - 16)
            .withDefault(0)
            .wrappingAdd(s0)
            .wrappingAdd(w.get(i - 7).withDefault(0))
            .wrappingAdd(s1);
        extend(ctx, w.push(ctx, next), i + 1)
    }
}

/// The eight working variables, so a round is one value in and one value out.
struct Working {
    a: U32,
    b: U32,
    c: U32,
    d: U32,
    e: U32,
    f: U32,
    g: U32,
    h: U32,
}

fn compress<C: Allocator>(ctx: C, state: [U32], block: [U8]): [U32] {
    let w = schedule(ctx, block);
    let k = roundConstants(ctx);
    let start = Working {
        a: state.get(0).withDefault(0),
        b: state.get(1).withDefault(0),
        c: state.get(2).withDefault(0),
        d: state.get(3).withDefault(0),
        e: state.get(4).withDefault(0),
        f: state.get(5).withDefault(0),
        g: state.get(6).withDefault(0),
        h: state.get(7).withDefault(0),
    };
    let end = rounds(start, w, k, 0);
    [
        state.get(0).withDefault(0).wrappingAdd(end.a),
        state.get(1).withDefault(0).wrappingAdd(end.b),
        state.get(2).withDefault(0).wrappingAdd(end.c),
        state.get(3).withDefault(0).wrappingAdd(end.d),
        state.get(4).withDefault(0).wrappingAdd(end.e),
        state.get(5).withDefault(0).wrappingAdd(end.f),
        state.get(6).withDefault(0).wrappingAdd(end.g),
        state.get(7).withDefault(0).wrappingAdd(end.h),
    ]
}

/// Sixty-four rounds. Pure and tail-recursive: nothing here allocates, because
/// `Working` is a fixed-size struct rather than a growing list.
fn rounds(v: Working, w: [U32], k: [U32], i: Int): Working {
    if (i >= 64) {
        v
    } else {
        let s1 = rotr(v.e, 6) ^ rotr(v.e, 11) ^ rotr(v.e, 25);
        let ch = v.e & v.f ^ ~v.e & v.g;
        let temp1 = v
            .h
            .wrappingAdd(s1)
            .wrappingAdd(ch)
            .wrappingAdd(k.get(i).withDefault(0))
            .wrappingAdd(w.get(i).withDefault(0));
        let s0 = rotr(v.a, 2) ^ rotr(v.a, 13) ^ rotr(v.a, 22);
        let maj = v.a & v.b ^ v.a & v.c ^ v.b & v.c;
        let temp2 = s0.wrappingAdd(maj);
        rounds(
            Working {
                a: temp1.wrappingAdd(temp2),
                b: v.a,
                c: v.b,
                d: v.c,
                e: v.d.wrappingAdd(temp1),
                f: v.e,
                g: v.f,
                h: v.g,
            },
            w,
            k,
            i + 1,
        )
    }
}

fn blocks<C: Allocator>(ctx: C, padded: [U8], state: [U32], i: Int): [U32] {
    if (i >= padded.length()) {
        state
    } else {
        blocks(ctx, padded, compress(ctx, state, padded.slice(ctx, i, i + 64)), i + 64)
    }
}

/// The SHA-256 digest of a byte string.
export fn sha256<C: Allocator>(ctx: C, message: [U8]): Digest {
    let state = blocks(ctx, pad(ctx, message), initialState(ctx), 0);
    Digest(
        state
            .mapCtx(ctx, fn(c, word) => {
                list
                    .range(c, 0, 4)
                    .map(c, fn(i) => bits.shiftRightU32(word, (3 - i) * 8).wrapToU8())
            })
            .flatten(ctx),
    )
}

/// The digest of a string's UTF-8 encoding.
export fn sha256Text<C: Allocator>(ctx: C, text: Str): Digest {
    sha256(ctx, bytes.toUtf8(ctx, text))
}

// --- SHA-512 ------------------------------------------------------------------
//
// The same shape one width up: 64-bit words, 128-byte blocks, eighty rounds, and
// a 128-bit length in the padding. Only the constants and the rotation amounts
// differ, so read `sha256` above first — this is that algorithm with `U64` in
// place of `U32`.

/// The initial state at 64 bits: the fractional parts of the square roots of
/// the first eight primes.
fn initialState512<C: Allocator>(ctx: C): [U64] {
    let seed: [U64] = [
        0x6a09e667f3bcc908,
        0xbb67ae8584caa73b,
        0x3c6ef372fe94f82b,
        0xa54ff53a5f1d36f1,
        0x510e527fade682d1,
        0x9b05688c2b3e6c1f,
        0x1f83d9abfb41bd6b,
        0x5be0cd19137e2179,
    ];
    seed.map(ctx, fn(x) => x)
}

/// The eighty round constants: the fractional parts of the cube roots of the
/// first eighty primes.
fn roundConstants512<C: Allocator>(ctx: C): [U64] {
    let k: [U64] = [
        0x428a2f98d728ae22,
        0x7137449123ef65cd,
        0xb5c0fbcfec4d3b2f,
        0xe9b5dba58189dbbc,
