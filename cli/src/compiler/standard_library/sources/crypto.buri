//! core/crypto — hashing in Buri, and randomness from the platform.
//!
//! SHA-256 and HMAC-SHA-256, written in the language rather than handed to the
//! platform. That is a deliberate choice and it is the same one the toolchain
//! makes about itself: `build/cache.rs` hand-writes SHA-256 in Rust because the
//! toolchain is pinned by hash and a dependency tree is a second thing to pin.
//! A second implementation, in the language, is also the strongest test the
//! language has — U32 wrapping arithmetic, rotation, array indexing, and
//! sixty-four rounds of tail recursion, checked against the same NIST vectors
//! the Rust one uses.
//!
//! # Randomness that cannot be guessed
//!
//! `randomBytes` and `token` are the second half of this module and they are
//! **not** written in the language: they perform the `Entropy` effect, and the
//! octets come from the operating system's generator through `core/host`'s
//! `entropy`. That is the decision this header used to defer, taken and
//! written down — a CSPRNG is a platform's to supply, not an algorithm to
//! reimplement, and the thing that made it a decision rather than a function
//! was that it needed a new effect for a program to ask for and be refused.
//!
//! They live here rather than in `core/random` for the reason this header gave
//! before either existed: `core/random` is *seeded and reproducible on
//! purpose*, and a `bytes` beside its `int` and `float` that quietly answered
//! from a different generator would make the module's one promise untrue.
//! `core/random.bytes` exists and is uniform; this is the one that is
//! unpredictable, and a program says which it meant by which it imports.
//!
//! **Neither takes a `Gen`, and this is the one place `core/random`'s
//! seed-or-context rule deliberately does not reach.** `Gen` exists so that a
//! run can be replayed from a seed; a token that can be replayed is a token
//! that can be predicted, and the call site would look exactly like the safe
//! one. The seeded path a test needs exists and is somewhere it can do no harm:
//! `core/host/testing`'s `entropy()` is a seeded implementation of the same
//! effect and is reachable only from a test source.
//!
//! # What is not here, and will not be by accident
//!
//! - **No ciphers, yet, and none by accident.** No AES, no ChaCha. Encryption
//!   needs a key schedule, a mode, a nonce discipline, and an authentication
//!   tag; shipping the block function alone is how people end up with ECB. An
//!   AEAD — one authenticated construction, with the nonce minted by
//!   `Entropy` rather than by the caller — is the shape it would take, and it
//!   is a slice of its own rather than a function to add here: it is a second
//!   host effect on both backends, `crypto.subtle` is `undefined` on a page
//!   that is not a secure context where `crypto.getRandomValues` is not, and
//!   `crypto.subtle` is promise-shaped, so every Buri function that could
//!   reach it becomes an `async` one in the emitted JavaScript. Each of those
//!   is answerable; none of them is answerable *quietly*.
//! - **No public-key anything.**
//! - **No key derivation and no password hashing.** See the note on `sha256`
//!   below: a fast hash is the wrong primitive for a password, and the right
//!   one is memory-hard with a work factor to argue about.
//!
//! **`sha256` is not a password hash.** It is fast, which is the wrong
//! property. Passwords want a memory-hard function with a work factor.
//!
//! ```buri run
//! from "core/crypto" import * as crypto;
//! from "core/effect" import { Alloc, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let d = crypto.sha256Text(ctx, "abc");
//!     let _ = io.println(ctx, "${d.toHex(ctx)}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//! ```
//!
//! A token cannot have its value written down here, because the whole of what
//! it is worth is that nobody can write it down in advance. Its *shape* can:
//!
//! ```buri run
//! from "core/crypto" import * as crypto;
//! from "core/effect" import { Alloc, Entropy, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Entropy: host.entropy,
//!         Stdout: host.stdout,
//!     };
//!     let resume = crypto.token(ctx, 32);
//!     let _ = io
//!         .println(ctx, "${crypto.randomBytes(ctx, 32).len()} ${resume.len()}")
//!         .ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 32 64
//! ```

from "core/bits" import * as bits;
from "core/bytes" import * as bytes;
from "core/effect" import { Alloc, Entropy };
from "core/list" import * as list;

derive Eq, Show for Digest;
/// A 32-byte digest.
export struct Digest(export [U8]);

impl Digest {
    /// The digest as lowercase hex, which is how one is written down.
    export fn toHex<C: Alloc>(self, ctx: C): Str {
        bytes.toHex(ctx, self.0)
    }
}

/// The initial state: the fractional parts of the square roots of the first
/// eight primes.
fn initialState<C: Alloc>(ctx: C): [U32] {
    let seed: [U32] = [
        1779033703,
        3144134277,
        1013904242,
        2773480762,
        1359893119,
        2600822924,
        528734635,
        1541459225,
    ];
    seed.map(ctx, fn(x) => x)
}

/// The round constants: the fractional parts of the cube roots of the first
/// sixty-four primes.
fn roundConstants<C: Alloc>(ctx: C): [U32] {
    let k: [U32] = [
        1116352408,
        1899447441,
        3049323471,
        3921009573,
        961987163,
        1508970993,
        2453635748,
        2870763221,
        3624381080,
        310598401,
        607225278,
        1426881987,
        1925078388,
        2162078206,
        2614888103,
        3248222580,
        3835390401,
        4022224774,
        264347078,
        604807628,
        770255983,
        1249150122,
        1555081692,
        1996064986,
        2554220882,
        2821834349,
        2952996808,
        3210313671,
        3336571891,
        3584528711,
        113926993,
        338241895,
        666307205,
        773529912,
        1294757372,
        1396182291,
        1695183700,
        1986661051,
        2177026350,
        2456956037,
        2730485921,
        2820302411,
        3259730800,
        3345764771,
        3516065817,
        3600352804,
        4094571909,
        275423344,
        430227734,
        506948616,
        659060556,
        883997877,
        958139571,
        1322822218,
        1537002063,
        1747873779,
        1955562222,
        2024104815,
        2227730452,
        2361852424,
        2428436474,
        2756734187,
        3204031479,
        3329325298,
    ];
    k.map(ctx, fn(x) => x)
}

/// Rotate right, within 32 bits.
///
/// `bits` has rotation for `Int` and shifts for `U32`, and this needs rotation
/// for `U32` — which is the two shifts, or-ed. It is correct only because the
/// unsigned bitwise operators narrow to the type's width; before they did, the
/// high half came back negative and every round after the first was wrong.
fn rotr(x: U32, n: Int): U32 {
    bits.shrU32(x, n) | bits.shlU32(x, 32 - n)
}

/// The message, padded: a one bit, then zeros, then the length in bits as a
/// big-endian 64-bit number, to a multiple of 64 bytes.
fn pad<C: Alloc>(ctx: C, message: [U8]): [U8] {
    let n = message.len();
    let bitLength = n * 8;
    // One byte for the `0x80`, eight for the length; zeros to fill the block.
    let zeros = (55 - n % 64 + 64) % 64;
    let lengthBytes = list
        .range(ctx, 0, 8)
        .map(ctx, fn(i) => bits.shr(bitLength, (7 - i) * 8).wrapToU8());
    message
        .push(ctx, 128)
        .concat(ctx, list.repeat(ctx, 0, zeros))
        .concat(ctx, lengthBytes)
}

/// The 64-entry message schedule for one block.
fn schedule<C: Alloc>(ctx: C, block: [U8]): [U32] {
    let first = list
        .range(ctx, 0, 16)
        .map(ctx, fn(i) => {
            let b0 = block.get(i * 4).withDefault(0).toI64();
            let b1 = block.get(i * 4 + 1).withDefault(0).toI64();
            let b2 = block.get(i * 4 + 2).withDefault(0).toI64();
            let b3 = block.get(i * 4 + 3).withDefault(0).toI64();
            (b0 * 16777216 + b1 * 65536 + b2 * 256 + b3).wrapToU32()
        });
    extend(ctx, first, 16)
}

/// Rounds 16 to 63, each from four earlier words. Tail-recursive, so the
/// sixty-four steps cost one frame.
fn extend<C: Alloc>(ctx: C, w: [U32], i: Int): [U32] {
    if (i >= 64) {
        w
    } else {
        let a = w.get(i - 15).withDefault(0);
        let b = w.get(i - 2).withDefault(0);
        let s0 = rotr(a, 7) ^ rotr(a, 18) ^ bits.shrU32(a, 3);
        let s1 = rotr(b, 17) ^ rotr(b, 19) ^ bits.shrU32(b, 10);
        let next = w
            .get(i - 16)
            .withDefault(0)
            .wrappingAdd(s0)
            .wrappingAdd(w.get(i - 7).withDefault(0))
            .wrappingAdd(s1);
        extend(ctx, w.push(ctx, next), i + 1)
    }
}

/// The eight working variables, so a round is one value in and one value out.
struct Working {
    a: U32,
    b: U32,
    c: U32,
    d: U32,
    e: U32,
    f: U32,
    g: U32,
    h: U32,
}

fn compress<C: Alloc>(ctx: C, state: [U32], block: [U8]): [U32] {
    let w = schedule(ctx, block);
    let k = roundConstants(ctx);
    let start = Working {
        a: state.get(0).withDefault(0),
        b: state.get(1).withDefault(0),
        c: state.get(2).withDefault(0),
        d: state.get(3).withDefault(0),
        e: state.get(4).withDefault(0),
        f: state.get(5).withDefault(0),
        g: state.get(6).withDefault(0),
        h: state.get(7).withDefault(0),
    };
    let end = rounds(start, w, k, 0);
    [
        state.get(0).withDefault(0).wrappingAdd(end.a),
        state.get(1).withDefault(0).wrappingAdd(end.b),
        state.get(2).withDefault(0).wrappingAdd(end.c),
        state.get(3).withDefault(0).wrappingAdd(end.d),
        state.get(4).withDefault(0).wrappingAdd(end.e),
        state.get(5).withDefault(0).wrappingAdd(end.f),
        state.get(6).withDefault(0).wrappingAdd(end.g),
        state.get(7).withDefault(0).wrappingAdd(end.h),
    ]
}

/// Sixty-four rounds. Pure and tail-recursive: nothing here allocates, because
/// `Working` is a fixed-size struct rather than a growing list.
fn rounds(v: Working, w: [U32], k: [U32], i: Int): Working {
    if (i >= 64) {
        v
    } else {
        let s1 = rotr(v.e, 6) ^ rotr(v.e, 11) ^ rotr(v.e, 25);
        let ch = v.e & v.f ^ ~v.e & v.g;
        let temp1 = v
            .h
            .wrappingAdd(s1)
            .wrappingAdd(ch)
            .wrappingAdd(k.get(i).withDefault(0))
            .wrappingAdd(w.get(i).withDefault(0));
        let s0 = rotr(v.a, 2) ^ rotr(v.a, 13) ^ rotr(v.a, 22);
        let maj = v.a & v.b ^ v.a & v.c ^ v.b & v.c;
        let temp2 = s0.wrappingAdd(maj);
        rounds(
            Working {
                a: temp1.wrappingAdd(temp2),
                b: v.a,
                c: v.b,
                d: v.c,
                e: v.d.wrappingAdd(temp1),
                f: v.e,
                g: v.f,
                h: v.g,
            },
            w,
            k,
            i + 1,
        )
    }
}

fn blocks<C: Alloc>(ctx: C, padded: [U8], state: [U32], i: Int): [U32] {
    if (i >= padded.len()) {
        state
    } else {
        blocks(ctx, padded, compress(ctx, state, padded.slice(ctx, i, i + 64)), i + 64)
    }
}

/// The SHA-256 digest of a byte string.
export fn sha256<C: Alloc>(ctx: C, message: [U8]): Digest {
    let state = blocks(ctx, pad(ctx, message), initialState(ctx), 0);
    Digest(
        state
            .mapCtx(ctx, fn(c, word) => {
                list
                    .range(c, 0, 4)
                    .map(c, fn(i) => bits.shrU32(word, (3 - i) * 8).wrapToU8())
            })
            .flatten(ctx),
    )
}

/// The digest of a string's UTF-8 encoding, which is what "the hash of this
/// text" nearly always means.
export fn sha256Text<C: Alloc>(ctx: C, text: Str): Digest {
    sha256(ctx, bytes.toUtf8(ctx, text))
}

// --- HMAC ---------------------------------------------------------------------

let BLOCK: Int = 64;

/// HMAC-SHA-256, per RFC 2104.
///
/// A key longer than the block is hashed first; a shorter one is padded with
/// zeros. That is the specification, and the reason it matters is that two
/// keys must not collide by accident of length.
export fn hmacSha256<C: Alloc>(ctx: C, key: [U8], message: [U8]): Digest {
    let shortened = if (key.len() > BLOCK) { sha256(ctx, key).0 } else { key };
    let padded = shortened.concat(ctx, list.repeat(ctx, 0, BLOCK - shortened.len()));
    let inner = padded.map(ctx, fn(b) => (b.toI64() ^ 54).wrapToU8());
    let outer = padded.map(ctx, fn(b) => (b.toI64() ^ 92).wrapToU8());
    let innerDigest = sha256(ctx, inner.concat(ctx, message));
    sha256(ctx, outer.concat(ctx, innerDigest.0))
}

// --- Randomness ------------------------------------------------------------------

/// `count` octets from the platform's cryptographic generator.
///
/// `getrandom(2)` or `getentropy(2)` under a native binary,
/// `crypto.getRandomValues` under a JavaScript one. Not seeded here, not
/// steppable from here, and not reproducible: a test that needs the same
/// octets twice binds `core/host/testing`'s `entropy()`, which is a seeded
/// implementation of the same effect and is the one place in this language
/// where these bytes are predictable on purpose.
///
/// A negative `count` aborts, and so does a platform that cannot answer.
/// Neither is a `Result`, and `core/effect`'s `Entropy` says why: fewer octets
/// than were asked for is the one answer that must never reach a caller.
export fn randomBytes<C: Entropy>(ctx: C, count: Int): [U8] {
    ctx.bytes(count)
}

/// A bearer token: `octets` octets of entropy, written as lowercase hex.
///
/// **`octets`, not characters** — the parameter is how much unguessability the
/// token carries, which is the only number worth choosing, and the string is
/// twice as long. 16 is a reasonable floor and 32 is what a session's resume
/// token should be.
///
/// Hex rather than base64url, for a reason that is about the caller rather than
/// about density. A hex token is URL-safe, filename-safe, header-safe and
/// case-insensitive with no alphabet to argue about and no padding to strip,
/// and `bytes.fromHex` reads it back. Base64url is a third shorter and every
/// one of those has to be checked instead.
///
/// Compare two of these with `equalsConstantTime` over their bytes, not with
/// `==` over their text.
export fn token<C: Alloc + Entropy>(ctx: C, octets: Int): Str {
    bytes.toHex(ctx, randomBytes(ctx, octets))
}

// --- Comparison ------------------------------------------------------------------

/// Compares two byte strings without stopping at the first difference.
///
/// Whether this actually takes constant time under a JIT is not something a
/// library can promise: the engine is free to do as it likes. What it does
/// promise is that the *algorithm* has no early exit, which is the part that
/// is a library's to get right.
export fn equalsConstantTime(a: [U8], b: [U8]): Bool {
    if (a.len() != b.len()) { false } else { accumulate(a, b, 0, 0) == 0 }
}

fn accumulate(a: [U8], b: [U8], i: Int, acc: Int): Int {
    if (i >= a.len()) {
        acc
    } else {
        let x = a.get(i).withDefault(0).toI64();
        let y = b.get(i).withDefault(0).toI64();
        accumulate(a, b, i + 1, acc | x ^ y)
    }
}
