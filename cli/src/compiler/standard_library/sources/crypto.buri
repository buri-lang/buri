/// Rotate right, within 64 bits: the two shifts, or-ed, as `rotr` is at 32.
fn rotr64(x: U64, n: Int): U64 {
    bits.shiftRightU64(x, n) | bits.shiftLeftU64(x, 64 - n)
}

/// The message padded to a multiple of 128 bytes. The length goes in as a
/// 128-bit big-endian number whose top eight bytes are always zero — no message
/// this can hash is 2^64 bits long.
fn pad512<C: Allocator>(ctx: C, message: [U8]): [U8] {
    let n = message.length();
    let bitLength = n * 8;
    let zeros = (111 - n % 128 + 128) % 128;
    let lengthBytes = list
        .range(ctx, 0, 8)
        .map(ctx, fn(i) => bits.shiftRight(bitLength, (7 - i) * 8).wrapToU8());
    message
        .push(ctx, 128)
        .concat(ctx, list.repeat(ctx, 0, zeros + 8))
        .concat(ctx, lengthBytes)
}

/// The eighty-entry message schedule for one 128-byte block.
fn schedule512<C: Allocator>(ctx: C, block: [U8]): [U64] {
    let first = list
        .range(ctx, 0, 16)
        .map(ctx, fn(i) => bytes.toU64BigEndian(block, i * 8).withDefault(0));
    extend512(ctx, first, 16)
}

/// Rounds 16 to 79, each from four earlier words. Tail-recursive.
fn extend512<C: Allocator>(ctx: C, w: [U64], i: Int): [U64] {
    if (i >= 80) {
        w
    } else {
        let a = w.get(i - 15).withDefault(0);
        let b = w.get(i - 2).withDefault(0);
        let s0 = rotr64(a, 1) ^ rotr64(a, 8) ^ bits.shiftRightU64(a, 7);
        let s1 = rotr64(b, 19) ^ rotr64(b, 61) ^ bits.shiftRightU64(b, 6);
        let next = w
            .get(i - 16)
            .withDefault(0)
            .wrappingAdd(s0)
            .wrappingAdd(w.get(i - 7).withDefault(0))
            .wrappingAdd(s1);
        extend512(ctx, w.push(ctx, next), i + 1)
    }
}

/// The eight working variables at 64 bits, so a round is one value in and one
/// value out.
struct Working512 {
    a: U64,
    b: U64,
    c: U64,
    d: U64,
    e: U64,
    f: U64,
    g: U64,
    h: U64,
}

fn compress512<C: Allocator>(ctx: C, state: [U64], block: [U8]): [U64] {
    let w = schedule512(ctx, block);
    let k = roundConstants512(ctx);
    let start = Working512 {
        a: state.get(0).withDefault(0),
        b: state.get(1).withDefault(0),
        c: state.get(2).withDefault(0),
        d: state.get(3).withDefault(0),
        e: state.get(4).withDefault(0),
        f: state.get(5).withDefault(0),
        g: state.get(6).withDefault(0),
        h: state.get(7).withDefault(0),
    };
    let end = rounds512(start, w, k, 0);
    [
        state.get(0).withDefault(0).wrappingAdd(end.a),
        state.get(1).withDefault(0).wrappingAdd(end.b),
        state.get(2).withDefault(0).wrappingAdd(end.c),
        state.get(3).withDefault(0).wrappingAdd(end.d),
        state.get(4).withDefault(0).wrappingAdd(end.e),
        state.get(5).withDefault(0).wrappingAdd(end.f),
        state.get(6).withDefault(0).wrappingAdd(end.g),
        state.get(7).withDefault(0).wrappingAdd(end.h),
    ]
}

/// Eighty rounds. Pure and tail-recursive, and nothing here allocates.
fn rounds512(v: Working512, w: [U64], k: [U64], i: Int): Working512 {
    if (i >= 80) {
        v
    } else {
        let s1 = rotr64(v.e, 14) ^ rotr64(v.e, 18) ^ rotr64(v.e, 41);
        let ch = v.e & v.f ^ ~v.e & v.g;
        let temp1 = v
            .h
            .wrappingAdd(s1)
            .wrappingAdd(ch)
            .wrappingAdd(k.get(i).withDefault(0))
            .wrappingAdd(w.get(i).withDefault(0));
        let s0 = rotr64(v.a, 28) ^ rotr64(v.a, 34) ^ rotr64(v.a, 39);
        let maj = v.a & v.b ^ v.a & v.c ^ v.b & v.c;
        let temp2 = s0.wrappingAdd(maj);
        rounds512(
            Working512 {
                a: temp1.wrappingAdd(temp2),
                b: v.a,
                c: v.b,
                d: v.c,
                e: v.d.wrappingAdd(temp1),
                f: v.e,
                g: v.f,
                h: v.g,
            },
            w,
            k,
            i + 1,
        )
    }
}

fn blocks512<C: Allocator>(ctx: C, padded: [U8], state: [U64], i: Int): [U64] {
    if (i >= padded.length()) {
        state
    } else {
        blocks512(
            ctx,
            padded,
            compress512(ctx, state, padded.slice(ctx, i, i + 128)),
            i + 128,
        )
    }
}

/// The SHA-512 digest of a byte string — sixty-four bytes.
///
/// ```buri run
/// from "core/bytes" import * as bytes;
/// from "core/crypto" import * as crypto;
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let d = crypto.sha512(ctx, bytes.toUtf8(ctx, "abc"));
///     let _ = io.println(ctx, "${d.0.length()} ${d.toHex(ctx).slice(0, 16)}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// 64 ddaf35a193617aba
/// ```
export fn sha512<C: Allocator>(ctx: C, message: [U8]): Digest {
    let state = blocks512(ctx, pad512(ctx, message), initialState512(ctx), 0);
    Digest(state.map(ctx, fn(word) => bytes.fromU64BigEndian(word)).flatten(ctx))
}

/// The SHA-512 digest of a string's UTF-8 encoding.
export fn sha512Text<C: Allocator>(ctx: C, text: Str): Digest {
    sha512(ctx, bytes.toUtf8(ctx, text))
}

// --- SHA-1 --------------------------------------------------------------------

/// The initial state, which SHA-1 writes down rather than derives.
fn initialState1<C: Allocator>(ctx: C): [U32] {
    let seed: [U32] = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0];
    seed.map(ctx, fn(x) => x)
}

/// Rotate left, within 32 bits.
fn rotl32(x: U32, n: Int): U32 {
    bits.shiftLeftU32(x, n) | bits.shiftRightU32(x, 32 - n)
}

/// The eighty-entry schedule. Every word past the first sixteen is four earlier
/// ones xor-ed and turned by one bit.
fn schedule1<C: Allocator>(ctx: C, block: [U8]): [U32] {
    let first = list
        .range(ctx, 0, 16)
        .map(ctx, fn(i) => bytes.toU32BigEndian(block, i * 4).withDefault(0));
    extend1(ctx, first, 16)
}

fn extend1<C: Allocator>(ctx: C, w: [U32], i: Int): [U32] {
    if (i >= 80) {
        w
    } else {
        let x = w.get(i - 3).withDefault(0)
            ^ w.get(i - 8).withDefault(0)
            ^ w.get(i - 14).withDefault(0)
            ^ w.get(i - 16).withDefault(0);
        extend1(ctx, w.push(ctx, rotl32(x, 1)), i + 1)
    }
}

/// SHA-1's five working variables.
struct Working1 {
    a: U32,
    b: U32,
    c: U32,
    d: U32,
    e: U32,
}

fn rounds1(v: Working1, w: [U32], i: Int): Working1 {
    if (i >= 80) {
        v
    } else {
        let mixed = if (i < 20) {
            v.b & v.c ^ ~v.b & v.d
        } else if (i < 40 || i >= 60) {
            v.b ^ v.c ^ v.d
        } else {
            v.b & v.c ^ v.b & v.d ^ v.c & v.d
        };
        let k: U32 = if (i < 20) {
            0x5a827999
        } else if (i < 40) {
            0x6ed9eba1
        } else if (i < 60) {
            0x8f1bbcdc
        } else {
            0xca62c1d6
        };
        let temp = rotl32(v.a, 5)
            .wrappingAdd(mixed)
            .wrappingAdd(v.e)
            .wrappingAdd(k)
            .wrappingAdd(w.get(i).withDefault(0));
        rounds1(
            Working1 { a: temp, b: v.a, c: rotl32(v.b, 30), d: v.c, e: v.d },
            w,
            i + 1,
        )
    }
}

fn compress1<C: Allocator>(ctx: C, state: [U32], block: [U8]): [U32] {
    let w = schedule1(ctx, block);
    let start = Working1 {
        a: state.get(0).withDefault(0),
        b: state.get(1).withDefault(0),
        c: state.get(2).withDefault(0),
        d: state.get(3).withDefault(0),
        e: state.get(4).withDefault(0),
    };
    let end = rounds1(start, w, 0);
    [
        state.get(0).withDefault(0).wrappingAdd(end.a),
        state.get(1).withDefault(0).wrappingAdd(end.b),
        state.get(2).withDefault(0).wrappingAdd(end.c),
        state.get(3).withDefault(0).wrappingAdd(end.d),
        state.get(4).withDefault(0).wrappingAdd(end.e),
    ]
}

fn blocks1<C: Allocator>(ctx: C, padded: [U8], state: [U32], i: Int): [U32] {
    if (i >= padded.length()) {
        state
    } else {
        blocks1(
            ctx,
            padded,
            compress1(ctx, state, padded.slice(ctx, i, i + 64)),
            i + 64,
        )
    }
}

/// The SHA-1 digest of a byte string — twenty bytes.
///
/// **Legacy interop only.** SHA-1 is broken for collisions: a chosen-prefix
/// collision has been published, and anything that trusts two different inputs
/// to have two different digests can be forged. Use it to read what already
/// exists — a git object id, an S3 ETag, an old signature — and never to protect
/// something new. `sha256` is the one to reach for.
export fn sha1<C: Allocator>(ctx: C, message: [U8]): Digest {
    let state = blocks1(ctx, pad(ctx, message), initialState1(ctx), 0);
    Digest(state.map(ctx, fn(word) => bytes.fromU32BigEndian(word)).flatten(ctx))
}

// --- HMAC ---------------------------------------------------------------------

let BLOCK: Int = 64;

/// HMAC-SHA-256, per RFC 2104.
///
/// A key longer than the block gets hashed first; a shorter one gets padded with
/// zeros.
export fn hmacSha256<C: Allocator>(ctx: C, key: [U8], message: [U8]): Digest {
    let shortened = if (key.length() > BLOCK) { sha256(ctx, key).0 } else { key };
    let padded = shortened.concat(ctx, list.repeat(ctx, 0, BLOCK - shortened.length()));
    let inner = padded.map(ctx, fn(b) => (b.toI64() ^ 54).wrapToU8());
    let outer = padded.map(ctx, fn(b) => (b.toI64() ^ 92).wrapToU8());
    let innerDigest = sha256(ctx, inner.concat(ctx, message));
    sha256(ctx, outer.concat(ctx, innerDigest.0))
}

let BLOCK_512: Int = 128;

/// HMAC-SHA-512, per RFC 2104. SHA-512's block is 128 bytes rather than 64, and
/// that is the only difference from `hmacSha256`.
export fn hmacSha512<C: Allocator>(ctx: C, key: [U8], message: [U8]): Digest {
    let shortened = if (key.length() > BLOCK_512) { sha512(ctx, key).0 } else { key };
    let padded = shortened.concat(
        ctx,
        list.repeat(ctx, 0, BLOCK_512 - shortened.length()),
    );
    let inner = padded.map(ctx, fn(b) => (b.toI64() ^ 54).wrapToU8());
    let outer = padded.map(ctx, fn(b) => (b.toI64() ^ 92).wrapToU8());
    let innerDigest = sha512(ctx, inner.concat(ctx, message));
    sha512(ctx, outer.concat(ctx, innerDigest.0))
}

// --- Randomness ------------------------------------------------------------------

/// `count` octets from the platform's cryptographic generator.
///
/// `getrandom(2)` or `getentropy(2)` under a native binary,
/// `crypto.getRandomValues` under a JavaScript one. It does not reproduce. A
/// test that needs the same octets twice binds `core/host/testing`'s
/// `entropy()`.
///
/// A negative `count` aborts, and so does a platform that cannot answer. Neither
/// is a `Result`: fewer octets than the caller asked for must never reach them.
export fn randomBytes<C: Entropy>(ctx: C, count: Int): [U8] {
    ctx.bytes(count)
}

/// A bearer token: `octets` octets of entropy, written as lowercase hex.
///
/// **`octets`, not characters** — the string comes out twice as long. 16 is a
/// reasonable floor, and 32 is what a session's resume token should be.
///
/// Hex rather than base64url: a hex token is URL-safe, filename-safe,
/// header-safe and case-insensitive, with no padding to strip, and
/// `bytes.fromHex` reads it back.
///
/// Compare two of these with `equalsConstantTime` over their bytes, not with
/// `==` over their text.
export fn token<C: Allocator + Entropy>(ctx: C, octets: Int): Str {
    bytes.toHex(ctx, randomBytes(ctx, octets))
}

// --- Comparison ------------------------------------------------------------------

/// Compares two byte strings without stopping at the first difference.
///
/// No library can promise constant time under a JIT. What this promises is that
/// the *algorithm* has no early exit.
export fn equalsConstantTime(first: [U8], second: [U8]): Bool {
    if (first.length() != second.length()) {
        false
    } else {
        accumulate(first, second, 0, 0) == 0
    }
}

fn accumulate(a: [U8], b: [U8], i: Int, acc: Int): Int {
    if (i >= a.length()) {
        acc
    } else {
        let x = a.get(i).withDefault(0).toI64();
        let y = b.get(i).withDefault(0).toI64();
        accumulate(a, b, i + 1, acc | x ^ y)
    }
}

// --- Sealing ---------------------------------------------------------------------

/// ChaCha20-Poly1305 (RFC 8439): the ciphertext with its tag appended. A key
/// that is not 32 bytes or a nonce that is not 12 aborts.
fn chacha20Poly1305Seal<C: Allocator>(
    ctx: C,
    key: [U8],
    nonce: [U8],
    plaintext: [U8],
    aad: [U8],
): [U8];

/// The plaintext, or `.None` when the tag does not match.
fn chacha20Poly1305Open<C: Allocator>(
    ctx: C,
    key: [U8],
    nonce: [U8],
    sealed: [U8],
    aad: [U8],
): Option<[U8]>;

let KEY_BYTES: Int = 32;

let NONCE_BYTES: Int = 12;

let TAG_BYTES: Int = 16;

/// Encrypts and authenticates `plaintext` under a 32-byte `key`.
///
/// ```buri run
/// from "core/bytes" import * as bytes;
/// from "core/crypto" import * as crypto;
/// from "core/effect" import { Allocator, Entropy, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Entropy: host.entropy,
///         Stdout: host.stdout,
///     };
///     let key = crypto.randomBytes(ctx, 32);
///     let aad = bytes.toUtf8(ctx, "user:42");
///     let sealed = crypto.seal(ctx, key, bytes.toUtf8(ctx, "refresh-token"), aad);
///     let opened = crypto.open(ctx, key, sealed, aad)?;
///     let _ = io
///         .println(ctx, "${sealed.length()} ${bytes.fromUtf8Lossy(ctx, opened)}")
///         .ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// 41 refresh-token
/// ```
///
/// The answer is `nonce ++ ciphertext ++ tag`: 12 + the plaintext's length + 16
/// bytes. The nonce comes from `Entropy`, so sealing the same plaintext twice
/// gives two different answers.
///
/// `aad` is authenticated but not encrypted. Bind a value to where it belongs,
/// such as a user id or a column name, and `open` refuses it anywhere else.
/// Pass `[]` when there is nothing to bind.
///
/// A random 12-byte nonce repeats by chance after about 2^32 seals under one
/// key, and a repeat leaks both plaintexts. Rotate keys well before that.
///
/// A `key` that is not 32 bytes aborts. Make one with `randomBytes(ctx, 32)`.
export fn seal<C: Allocator + Entropy>(
    ctx: C,
    key: [U8],
    plaintext: [U8],
    aad: [U8],
): [U8] {
    let nonce = randomBytes(ctx, NONCE_BYTES);
    nonce.concat(ctx, chacha20Poly1305Seal(ctx, key, nonce, plaintext, aad))
}

/// The plaintext `seal` encrypted, or why it cannot be had.
///
/// It fails when the key is wrong, when `aad` differs from what was sealed, or
/// when any byte of `sealed` changed. The tag is checked before anything is
/// decrypted, so a failure releases no plaintext.
export fn open<C: Allocator>(
    ctx: C,
    key: [U8],
    sealed: [U8],
    aad: [U8],
): Result<[U8], Str> {
    if (key.length() != KEY_BYTES) {
        .Err("a sealing key is 32 bytes")
    } else if (sealed.length() < NONCE_BYTES + TAG_BYTES) {
        .Err("too short to be a sealed value")
    } else {
        let nonce = sealed.slice(ctx, 0, NONCE_BYTES);
        let rest = sealed.slice(ctx, NONCE_BYTES, sealed.length());
        match (chacha20Poly1305Open(ctx, key, nonce, rest, aad)) {
            .Some(plaintext) => .Ok(plaintext),
            .None => .Err("the sealed value does not authenticate"),
        }
    }
}

// --- Signatures ------------------------------------------------------------------

/// ECDSA over P-256 with SHA-256. `key` is a 65-byte uncompressed point and
/// `signature` is `r ++ s`.
fn ecdsaP256Sha256Verify(key: [U8], message: [U8], signature: [U8]): Bool;

/// Ed25519 (RFC 8032). `key` is 32 bytes and `signature` 64.
fn ed25519Verify(key: [U8], message: [U8], signature: [U8]): Bool;

/// A P-256 public key, for `verifyEs256`. Make one with
/// `p256PublicKeyFromJwk`, `p256PublicKeyFromSec1` or `p256PublicKeyFromSpki`.
///
/// Those check the encoding, not the curve: a point that is not on P-256 fails
/// every `verifyEs256`.
export struct P256PublicKey([U8]);

/// A P-256 key from a JWK's `x` and `y` members, which are base64url.
///
/// ```buri
/// from "core/crypto" import * as crypto;
/// from "core/effect" import { Allocator };
///
/// export fn rfcKey<C: Allocator>(ctx: C): Result<crypto.P256PublicKey, Str> {
///     crypto.p256PublicKeyFromJwk(
///         ctx,
///         "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU",
///         "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0",
///     )
/// }
/// ```
///
/// Check the JWK's `kty` is `"EC"` and its `crv` is `"P-256"` before calling this.
export fn p256PublicKeyFromJwk<C: Allocator>(
    ctx: C,
    x: Str,
    y: Str,
): Result<P256PublicKey, Str> {
    match ((bytes.fromBase64Url(ctx, x), bytes.fromBase64Url(ctx, y))) {
        (.Ok(xs), .Ok(ys)) => {
            if (xs.length() != 32 || ys.length() != 32) {
                .Err("a P-256 coordinate is 32 bytes")
            } else {
                let prefix: [U8] = [4];
                .Ok(P256PublicKey(prefix.concat(ctx, xs).concat(ctx, ys)))
            }
        },
        _ => .Err("a JWK coordinate is base64url"),
    }
}

/// A P-256 key from its SEC1 encoding: `0x04 ++ x ++ y`, 65 bytes. The
/// compressed form is refused.
export fn p256PublicKeyFromSec1(point: [U8]): Result<P256PublicKey, Str> {
    if (point.length() == 65 && point.get(0).withDefault(0) == 4) {
        .Ok(P256PublicKey(point))
    } else {
        .Err("a P-256 key is 65 bytes starting with 0x04")
    }
}

/// DER's `SubjectPublicKeyInfo` header for an uncompressed P-256 key: the
/// `id-ecPublicKey` and `prime256v1` object identifiers and the bit string's
/// opening. DER is canonical, so every such key starts with exactly these.
let SPKI_P256: [U8] = [
    0x30,
    0x59,
    0x30,
    0x13,
    0x06,
    0x07,
    0x2a,
    0x86,
    0x48,
    0xce,
    0x3d,
    0x02,
    0x01,
    0x06,
    0x08,
    0x2a,
    0x86,
    0x48,
    0xce,
    0x3d,
    0x03,
    0x01,
    0x07,
    0x03,
    0x42,
    0x00,
];

/// A P-256 key from DER `SubjectPublicKeyInfo` bytes, which is what a PEM
/// `PUBLIC KEY` block holds once its base64 is decoded.
export fn p256PublicKeyFromSpki<C: Allocator>(
    ctx: C,
    der: [U8],
): Result<P256PublicKey, Str> {
    if (der.length() == 91 && bytes.startsWith(der, SPKI_P256)) {
        p256PublicKeyFromSec1(der.slice(ctx, 26, 91))
    } else {
        .Err("not a P-256 SubjectPublicKeyInfo")
    }
}

/// Whether `signature` is `key`'s ES256 signature over `message`.
///
/// `signature` is `r ++ s`, 64 bytes, which is how JWS writes it. For a JWT,
/// `message` is the ASCII of `header.payload` and `signature` is the third part,
/// base64url-decoded:
///
/// ```buri
/// from "core/bytes" import * as bytes;
/// from "core/crypto" import * as crypto;
/// from "core/effect" import { Allocator };
/// from "core/str" import * as str;
///
/// export fn checks<C: Allocator>(ctx: C, key: crypto.P256PublicKey, jwt: Str): Bool {
///     let parts = jwt.split(ctx, ".");
///     let signed = str.format(
///         ctx,
///         "${parts.get(0).withDefault("")}.${parts.get(1).withDefault("")}",
///     );
///     match (bytes.fromBase64Url(ctx, parts.get(2).withDefault(""))) {
///         .Ok(signature) => crypto.verifyEs256(key, bytes.toUtf8(ctx, signed), signature),
///         .Err(_) => false,
///     }
/// }
/// ```
///
/// A true answer says who signed. Checking the header's `alg`, and the claims'
/// `exp`, `aud` and `iss`, is still the caller's job.
export fn verifyEs256(key: P256PublicKey, message: [U8], signature: [U8]): Bool {
    ecdsaP256Sha256Verify(key.0, message, signature)
}

/// An Ed25519 public key, for `verifyEd25519`.
export struct Ed25519PublicKey([U8]);

/// An Ed25519 key from its 32 raw bytes, which is also what a JWK's `x`
/// decodes to.
export fn ed25519PublicKeyFromRaw(raw: [U8]): Result<Ed25519PublicKey, Str> {
    if (raw.length() == 32) {
        .Ok(Ed25519PublicKey(raw))
    } else {
        .Err("an Ed25519 key is 32 bytes")
    }
}

/// Whether `signature` is `key`'s Ed25519 signature over `message`.
///
/// ```buri run
/// from "core/bytes" import * as bytes;
/// from "core/crypto" import * as crypto;
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
///
/// fn hex<C: Allocator>(ctx: C, text: Str): [U8] {
///     bytes.fromHex(ctx, text).withDefault([])
/// }
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     // RFC 8032 section 7.1, test 2.
///     let key = crypto.ed25519PublicKeyFromRaw(
///         hex(ctx, "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"),
///     )?;
///     let signature = hex(
///         ctx,
///         "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00",
///     );
///     let good = crypto.verifyEd25519(key, hex(ctx, "72"), signature);
///     let forged = crypto.verifyEd25519(key, hex(ctx, "73"), signature);
///     let _ = io.println(ctx, "${good} ${forged}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// true false
/// ```
///
/// A signature must be 64 bytes, and its `S` below the group order. Any other
/// signature answers `false`.
export fn verifyEd25519(key: Ed25519PublicKey, message: [U8], signature: [U8]): Bool {
    ed25519Verify(key.0, message, signature)
}

/// RSASSA-PKCS1-v1_5 with SHA-256. `n` and `e` are big-endian with no leading
/// zero octet.
fn rsaPkcs1Sha256Verify(n: [U8], e: [U8], message: [U8], signature: [U8]): Bool;

/// An RSA public key, for `verifyRs256`. Make one with `rsaPublicKeyFromJwk` or
/// `rsaPublicKeyFromSpki`.
///
/// Both refuse a key outside these bounds:
///
/// - the modulus is odd and 2048 to 8192 bits long;
/// - the exponent is odd, at least 3 and below 2^33.
///
/// The keys identity providers publish fit: 2048 to 4096 bits, and 65537.
export struct RsaPublicKey {
    n: [U8],
    e: [U8],
}

/// An RSA key from a JWK's `n` and `e` members, which are base64url.
///
/// ```buri
/// from "core/crypto" import * as crypto;
/// from "core/effect" import { Allocator };
///
/// export fn rfcKey<C: Allocator>(ctx: C): Result<crypto.RsaPublicKey, Str> {
///     // RFC 7515 appendix A.2.
///     crypto.rsaPublicKeyFromJwk(
///         ctx,
///         "ofgWCuLjybRlzo0tZWJjNiuSfb4p4fAkd_wWJcyQoTbji9k0l8W26mPddxHmfHQp-Vaw-4qPCJrcS2mJPMEzP1Pt0Bm4d4QlL-yRT-SFd2lZS-pCgNMsD1W_YpRPEwOWvG6b32690r2jZ47soMZo9wGzjb_7OMg0LOL-bSf63kpaSHSXndS5z5rexMdbBYUsLA9e-KXBdQOS-UTo7WTBEMa2R2CapHg665xsmtdVMTBQY4uDZlxvb3qCo5ZwKh9kG4LT6_I5IhlJH7aGhyxXFvUK-DWNmoudF8NAco9_h9iaGNj8q2ethFkMLs91kzk2PAcDTW9gb54h4FRWyuXpoQ",
///         "AQAB",
///     )
/// }
/// ```
///
/// Check the JWK's `kty` is `"RSA"` before calling this. A leading zero octet,
/// which some encoders add, is ignored.
export fn rsaPublicKeyFromJwk<C: Allocator>(
    ctx: C,
    n: Str,
    e: Str,
): Result<RsaPublicKey, Str> {
    match ((bytes.fromBase64Url(ctx, n), bytes.fromBase64Url(ctx, e))) {
        (.Ok(ns), .Ok(es)) => rsaPublicKey(ctx, ns, es),
        _ => .Err("a JWK modulus or exponent is base64url"),
    }
}

/// An RSA key from DER `SubjectPublicKeyInfo` bytes holding an `rsaEncryption`
/// key, which is what a PEM `PUBLIC KEY` block holds once its base64 is decoded.
///
/// The DER must be exact: minimal lengths and integers, the `NULL` parameters,
/// and nothing after the end.
export fn rsaPublicKeyFromSpki<C: Allocator>(
    ctx: C,
    der: [U8],
): Result<RsaPublicKey, Str> {
    match (rsaSpki(ctx, der)) {
        .Some((n, e)) => rsaPublicKey(ctx, n, e),
        .None => .Err("not an RSA SubjectPublicKeyInfo"),
    }
}

/// Whether `signature` is `key`'s RS256 signature over `message`.
///
/// For a JWT, `message` is the ASCII of `header.payload` and `signature` is the
/// third part, base64url-decoded, as for `verifyEs256`.
///
/// A signature must be exactly as long as the modulus, and its padding exactly
/// PKCS #1 v1.5's. Any other signature answers `false`.
export fn verifyRs256(key: RsaPublicKey, message: [U8], signature: [U8]): Bool {
    rsaPkcs1Sha256Verify(key.n, key.e, message, signature)
}

/// The key, once `n` and `e` are in bounds. Leading zero octets are dropped.
fn rsaPublicKey<C: Allocator>(
    ctx: C,
    modulus: [U8],
    exponent: [U8],
): Result<RsaPublicKey, Str> {
    let n = modulus.slice(ctx, leadingZeros(modulus, 0), modulus.length());
    let e = exponent.slice(ctx, leadingZeros(exponent, 0), exponent.length());
    let bits = if (n.length() == 0) {
        0
    } else {
        (n.length() - 1) * 8 + bitLength(octet(n, 0))
    };
    let value = if (e.length() > 5) { 0 } else { bigEndian(e, 0, 0) };
    if (bits < 2048 || bits > 8192) {
        .Err("an RSA modulus is 2048 to 8192 bits")
    } else if (octet(n, n.length() - 1) % 2 == 0) {
        .Err("an RSA modulus is odd")
    } else if (value < 3 || value >= 8589934592 || value % 2 == 0) {
        .Err("an RSA exponent is odd, at least 3 and below 2^33")
    } else {
        .Ok(RsaPublicKey { n, e })
    }
}

fn leadingZeros(octets: [U8], i: Int): Int {
    if (octet(octets, i) == 0) { leadingZeros(octets, i + 1) } else { i }
}

fn bitLength(x: Int): Int {
    if (x <= 0) { 0 } else { 1 + bitLength(x / 2) }
}

/// Up to seven octets, big-endian, as an `Int`.
fn bigEndian(octets: [U8], i: Int, acc: Int): Int {
    if (i >= octets.length()) {
        acc
    } else {
        bigEndian(octets, i + 1, acc * 256 + octet(octets, i))
    }
}

/// The octet at `i`, or -1 outside `octets`.
fn octet(octets: [U8], i: Int): Int {
    match (octets.get(i)) {
        .Some(b) => b.toI64(),
        .None => -1,
    }
}

/// DER's `AlgorithmIdentifier` for `rsaEncryption`, with its `NULL` parameters.
let RSA_ENCRYPTION: [U8] = [
    0x30,
    0x0d,
    0x06,
    0x09,
    0x2a,
    0x86,
    0x48,
    0x86,
    0xf7,
    0x0d,
    0x01,
    0x01,
    0x01,
    0x05,
    0x00,
];

/// A `SubjectPublicKeyInfo`'s modulus and exponent, from
/// `SEQUENCE { RSA_ENCRYPTION, BIT STRING { 0x00, SEQUENCE { INTEGER n, INTEGER e } } }`.
/// Each item must fill its parent exactly.
fn rsaSpki<C: Allocator>(ctx: C, der: [U8]): Option<([U8], [U8])> {
    let outer = derItem(der, 0, 0x30).filter(fn(item) => item.1 == der.length());
    let bits = outer
        .filter(fn(item) => matchesAt(der, item.0, RSA_ENCRYPTION, 0))
        .andThen(fn(item) => {
            derItem(der, item.0 + RSA_ENCRYPTION.length(), 0x03).filter(fn(b) => {
                b.1 == item.1
            })
        })
        .filter(fn(item) => octet(der, item.0) == 0);
    let key = bits.andThen(fn(item) => {
        derItem(der, item.0 + 1, 0x30).filter(fn(k) => k.1 == item.1)
    });
    let n = key.andThen(fn(item) => derInteger(der, item.0));
    let e = n.andThen(fn(item) => derInteger(der, item.1));
    match ((key, n, e)) {
        (.Some(k), .Some(ns), .Some(es)) => {
            if (es.1 == k.1) {
                .Some((der.slice(ctx, ns.0, ns.1), der.slice(ctx, es.0, es.1)))
            } else {
                .None
            }
        },
        _ => .None,
    }
}

/// Whether `der` holds `expected` from `at` on.
fn matchesAt(der: [U8], at: Int, expected: [U8], i: Int): Bool {
    i >= expected.length()
        || octet(der, at + i) == octet(expected, i)
            && matchesAt(der, at, expected, i + 1)
}

/// The DER item tagged `tag` at `at`: where its contents start and end. The
/// length must be minimal, and at most two octets.
fn derItem(der: [U8], at: Int, tag: Int): Option<(Int, Int)> {
    let first = octet(der, at + 1);
    let (start, length) = if (octet(der, at) != tag) {
        (0, -1)
    } else if (first >= 0 && first < 0x80) {
        (at + 2, first)
    } else if (first == 0x81 && octet(der, at + 2) >= 0x80) {
        (at + 3, octet(der, at + 2))
    } else if (first == 0x82 && octet(der, at + 2) >= 1 && octet(der, at + 3) >= 0) {
        (at + 4, octet(der, at + 2) * 256 + octet(der, at + 3))
    } else {
        (0, -1)
    };
    if (length < 0 || start + length > der.length()) {
        .None
    } else {
        .Some((start, start + length))
    }
}

/// A positive DER `INTEGER` at `at`: where its magnitude starts, past the zero
/// octet that keeps it positive, and where it ends. Zero, a negative number and
/// a needless zero octet are refused.
fn derInteger(der: [U8], at: Int): Option<(Int, Int)> {
    derItem(der, at, 0x02).andThen(fn(item) => {
        let first = octet(der, item.0);
        let second = if (item.0 + 1 < item.1) { octet(der, item.0 + 1) } else { -1 };
        if (item.0 == item.1 || first >= 0x80 || first == 0 && second < 0x80) {
            .None
        } else if (first == 0) {
            .Some((item.0 + 1, item.1))
        } else {
            .Some(item)
        }
    })
}
