//! core/crypto — hashing in Buri, and randomness from the platform.
//!
//! SHA-256, SHA-512 and their HMACs, written in the language rather than handed
//! to the platform, and checked against the NIST vectors. SHA-1 is here too, for
//! reading formats that already use it — see its own note.
//!
//! # Randomness that cannot be guessed
//!
//! `randomBytes` and `token` are **not** written in the language. They perform
//! the `Entropy` effect, and the octets come from the operating system's
//! generator through `core/host`'s `entropy`.
//!
//! They live here rather than in `core/random`, which is *seeded and
//! reproducible on purpose*. `core/random.bytes` is uniform. These are
//! unpredictable, and a program says which it meant by which it imports.
//!
//! **Neither takes a `Generator`.** A token you can replay is a token somebody can
//! predict. The seeded path a test needs is `core/host/testing`'s `entropy()`, a
//! seeded implementation of the same effect that only a test source can reach.
//!
//! # Sealing and signatures
//!
//! `seal` and `open` encrypt with ChaCha20-Poly1305, and `Entropy` mints the
//! nonce rather than the caller. `verifyEs256`, `verifyRs256` and
//! `verifyEd25519` check a signature somebody else made. These five are the
//! platform's rather than Buri's: `ring` natively, and the JavaScript runtime's
//! own synchronous code.
//!
//! # What is not here
//!
//! - **No signing and no key generation.** Only checking.
//! - **No RSA-PSS and no RSA encryption.** RS256 is the one RSA scheme.
//! - **No key derivation and no password hashing.**
//!
//! **`sha256` is not a password hash.** It is fast, which is the wrong
//! property. Passwords want a memory-hard function with a work factor.
//!
//! ```buri run
//! from "core/crypto" import * as crypto;
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let d = crypto.sha256Text(ctx, "abc");
//!     let _ = io.println(ctx, "${d.toHex(ctx)}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
//! ```
//!
//! A token's value cannot go in this file. Its *shape* can:
//!
//! ```buri run
//! from "core/crypto" import * as crypto;
//! from "core/effect" import { Allocator, Entropy, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Entropy: host.entropy,
//!         Stdout: host.stdout,
//!     };
//!     let resume = crypto.token(ctx, 32);
//!     let _ = io
//!         .println(ctx, "${crypto.randomBytes(ctx, 32).length()} ${resume.length()}")
//!         .ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 32 64
//! ```

from "core/bits" import * as bits;
from "core/bytes" import * as bytes;
from "core/effect" import { Allocator, Entropy };
from "core/list" import * as list;

derive Equal, Show for Digest;
/// A digest, as many bytes as the function that made it: 32 from SHA-256, 64
/// from SHA-512, 20 from SHA-1. The type does not say which, so compare two
/// digests only when the same function made both.
export struct Digest(export [U8]);

impl Digest {
    /// The digest as lowercase hex, which is how you write one down.
    export fn toHex<C: Allocator>(self, ctx: C): Str {
        bytes.toHex(ctx, self.0)
    }
}

/// The initial state: the fractional parts of the square roots of the first
/// eight primes.
fn initialState<C: Allocator>(ctx: C): [U32] {
    let seed: [U32] = [
        1779033703,
        3144134277,
        1013904242,
        2773480762,
        1359893119,
        2600822924,
        528734635,
        1541459225,
    ];
    seed.map(ctx, fn(x) => x)
}

