//! ui/testing — a headless user interface platform.
//!
//! Test-only, by the `testing` path segment: importable only from a test
//! source (SPEC rule 35). One implementation per effect, the same shape as
//! `core/testing/context`, so a test builds the context it wants rather than
//! being handed a world.
//!
//! The implementations are the real reactive runtime with no document
//! attached. That is deliberate: the graph is what the tests here are about,
//! and a second implementation of it would be a second thing to be right.
//!
//! Each call to `recorder()` allocates a fresh handle, so what one test
//! records is invisible to the next. `headless()` and `observer()` are windows
//! onto the one graph the runtime holds, which needs no isolating: a cell is
//! named by an index nothing else can produce, so a test can only reach the
//! cells it made.

from "ui/effect" import { Fetch, FetchError, Request, Scope, Ui, Watch };
from "ui/node" import { Node };
from "ui/theme" import { Theme };
from "core/effect" import { NetResponse };

/// Creates and writes signals, and runs computations, with no rendering.
export struct Headless(I64);

impl Ui for Headless {
  fn signal<T>(self: Headless, initial: T): Int;
  fn read<T>(self: Headless, id: Int): T;
  fn write<T>(self: Headless, id: Int, value: T): ();
  fn memo<T>(self: Headless, compute: fn(Scope) => T): Int;
  fn watch(self: Headless, run: fn(Scope) => ()): ();
}

/// A headless `Ui`.
export fn headless(): Headless;

/// Reads signals and nothing else — what a test binds to `Watch` so that it
/// can look at a cell from outside any computation.
export struct Observer(I64);

impl Watch for Observer {
  fn read<T>(self: Observer, id: Int): T;
}

/// A headless `Watch`.
export fn observer(): Observer;

/// Refuses every request. A fake goes in `test.dependencies`.
export struct NoFetch {}

impl Fetch for NoFetch {
  fn fetch(
    self: NoFetch,
    request: Request,
    done: fn(NoFetch, Result<NetResponse, FetchError>) => (),
  ): () {
    done(self, .Err(.Refused))
  }
}

/// A `Fetch` that refuses.
export fn noFetch(): NoFetch {
  NoFetch {}
}

/// A tree that has been rendered, and can be looked at and acted on.
///
/// The renderer behind it is the one `ui/node`'s `mount` uses, against a
/// document the runtime supplies rather than a browser: there is no second
/// reconciler to be right about, and what these tests exercise is the shipping
/// one. Which element each role became, which style reached which element,
/// what a press did, and which rows a keyed list moved rather than rebuilt are
/// all answerable here.
///
/// What is left is what only a browser does, and it is a short list, kept here
/// so that it is a list rather than a silence:
///
/// - **Layout and painting.** A style is asserted as the declaration it became,
///   not as pixels. Whether `flex-grow: 1` actually took the leftover room is
///   the browser's answer to give.
/// - **The browser's own dispatch.** That Enter and Space on a button produce
///   a press, that Enter in a field submits the form around it, and that a
///   press inside a label reaches the input it wraps — all three are why the
///   vocabulary lowers to `button`, `form` and `label` rather than to
///   listeners on a `div`, and all three are the browser keeping its side.
/// - **Focus and selection.** That a moved row keeps the focus and the caret
///   is the reason rows are keyed; what is asserted here is the identity that
///   makes it possible.
/// - **What assistive technology announces.** A role is asserted as the
///   element it became. Whether a reader says "list, five items" is that
///   reader's contract with HTML, which is the whole reason meaning is lowered
///   to HTML rather than to attributes on a `div`.
///
/// Each of those needs a real browser driven from the outside, which is a suite
/// this repository does not have yet.
export struct Rendered(I64);

/// Renders `root` into a document of its own.
///
/// The context is the one the tree's handlers are given, exactly as `mount`
/// hands over the context it was called with.
export fn render<C: Ui>(ctx: C, root: Node<C>): Rendered;

impl Rendered {
  /// The tree as markup: elements, their attributes, their styles and their
  /// text, in order.
  ///
  /// The runtime's own bookkeeping — the markers it puts around a region that
  /// can change — is left out, because it is not what a reader sees and not
  /// what a test should be pinned to.
  export fn markup(self: Rendered): Str;

  /// Every run of text in the tree, in order, separated by a space.
  export fn text(self: Rendered): Str;

  /// Presses the button whose label is `label`.
  ///
  /// Addressed by label rather than by position because that is what a reader
  /// addresses it by, and because a test that says which button it meant does
  /// not quietly start pressing another one. Aborts when no button carries
  /// that label.
  export fn press(self: Rendered, label: Str): ();

  /// Types `value` into the field labelled `label`, as a reader replacing what
  /// was there.
  export fn fill(self: Rendered, label: Str, value: Str): ();

  /// Flips the toggle labelled `label`.
  export fn flip(self: Rendered, label: Str): ();

  /// Submits the `index`th form, oldest first — what pressing Enter in one of
  /// its fields does.
  export fn submit(self: Rendered, index: Int): ();

  /// How many elements of this kind the tree holds. The name is the one
  /// `markup` shows.
  export fn count(self: Rendered, name: Str): Int;

  /// What the `index`th element of this kind is, as a number the runtime gives
  /// an element when it creates it and never gives to another.
  ///
  /// This is how a test says that a keyed list *moved* a row rather than
  /// rebuilding it: the identity survives a reorder and a rebuild changes it.
  export fn identity(self: Rendered, name: Str, index: Int): Int;
}

/// The stylesheet the compiler extracted for this artifact.
///
/// Every static style in the program is in here, as one atomic class per
/// distinct property value, deduped across the whole build — so this is how a
/// test asserts what a class *means* rather than only what an element is
/// called, and how it sees that two modules asking for one padding produced one
/// rule and not two.
///
/// It is a compile-time string. Nothing appends to it at run time, and there is
/// no call anywhere that could.
export fn stylesheet(): Str;

/// Installs `themes` exactly as `mount` does, and answers the custom-property
/// block they resolve to.
///
/// This is how a test asserts what a token is *worth* — the stylesheet says
/// only that a class reads `var(--cardlib-surface)`, and the value of that
/// variable is what a theme decides. A chain resolves here, once, the way it
/// resolves at mount.
export fn install(themes: [Theme]): Str;

/// The custom-property block that is installed right now.
///
/// Reading it again after writing a signal a `switching` theme's condition
/// depends on is how a test sees a theme switch: the block changes and nothing
/// else does, which is the claim.
export fn variables(): Str;

/// An ordered log, for asserting on *when* something ran.
///
/// A reactive computation receives a `Scope`, which grants reading the graph
/// and nothing else, so it cannot write a signal to say that it ran. This is
/// how a test sees the order watchers were scheduled in and how many times a
/// memo recomputed — the same shape as `core/testing/context`'s captured
/// stdout, and for the same reason: Buri has no mutation, so the state lives
/// on the runner's side and this value names it.
///
/// Holds no authority, so a lambda may capture one, which is what lets a
/// computation reach it at all.
export struct Recorder(I64);

/// A fresh, empty recorder.
export fn recorder(): Recorder;

impl Recorder {
  /// Appends `tag` to the tag log.
  export fn record(self: Recorder, tag: Str): ();

  /// Every tag recorded so far, oldest first.
  export fn recorded(self: Recorder): [Str];

  /// Appends `value` to the value log, and answers it.
  ///
  /// A second channel rather than `record("${value}")` because a computation
  /// holds only a `Scope`: it cannot allocate, so it cannot render a number
  /// into a string. It answers its argument so that it can be wrapped around
  /// the expression being watched instead of sequenced before it.
  export fn note(self: Recorder, value: Int): Int;

  /// Every value noted so far, oldest first.
  export fn noted(self: Recorder): [Int];
}
