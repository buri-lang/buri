//! ui/testing — a headless user interface platform.
//!
//! Test-only, by the `testing` path segment: only a test source may import it
//! (SPEC rule 35). One implementation per effect, the same shape as
//! `core/host/testing`, so a test builds the context it wants instead of
//! taking a whole world.
//!
//! The two graph effects live here, and the address bar over them. For a page's
//! requests, the double is `core/host/testing`'s `net()`, which refuses every
//! request until `respond` says what to answer.
//!
//! The implementations are the real reactive runtime with no document attached.
//!
//! Every call to `recorder()` allocates a fresh handle, so what one test
//! records is invisible to the next, and every `address(ctx, at)` is a cell of
//! its own. `headless()` and `observer()` are windows onto the one graph the
//! runtime holds, which needs no isolating: a cell is named by an index nothing
//! else can produce, so a test can only reach the cells it made.

from "core/effect" import { Allocator };
from "ui/effect" import { Location, Scope, Ui, Watch };
from "ui/node" import * as node;
from "ui/node" import { Node };
from "ui/style" import { State };
from "ui/theme" import * as theme;
from "ui/theme" import { Theme };

/// Creates and writes signals, and runs computations, with no rendering.
export struct Headless(I64);

impl Ui for Headless {
    fn signal<T>(self, initial: T): Int;

    fn read<T>(self, id: Int): T;

    fn write<T>(self, id: Int, value: T): ();

    fn memo<T>(self, compute: fn(Scope) => T): Int;

    fn watch(self, run: fn(Scope) => ()): ();
}

/// A headless `Ui`.
export fn headless(): Headless;

/// Reads signals and nothing else — what a test binds to `Watch` so it can
/// look at a cell from outside any computation.
export struct Observer(I64);

impl Watch for Observer {
    fn read<T>(self, id: Int): T;
}

/// A headless `Watch`.
export fn observer(): Observer;

/// An address bar with no browser behind it: one cell of the same graph.
///
/// `web.navigate` and `web.replace` write that cell, so `web.path` and
/// `web.route` answer where a test has been. What is *not* here is a history
/// stack — a headless platform has none, and pressing Back is a browser's own
/// answer — so the two differ only in what a browser does with the entry.
/// `language::a_website_is_rendered_by_its_worker_and_resumed_by_its_page`
/// drives a built page against one and asserts that half.
export struct Address(Int);

impl Location for Address {
    fn path(self): Int {
        self.0
    }

    fn push(self, path: Str): () {}

    fn replace(self, path: Str): () {}
}

/// A headless `Location` starting at `at`, over `ctx`'s graph.
export fn address<C: Ui>(ctx: C, at: Str): Address {
    Address(ctx.signal(at))
}

/// A tree the runtime rendered, ready to look at and act on.
///
/// Behind it is the renderer `ui/node`'s `mount` uses, pointed at a document
/// the runtime supplies rather than a browser. Which element each role became,
/// which style reached which element, what a press did, and which rows a keyed
/// list moved rather than rebuilt are all answerable here.
///
/// What only a browser does is out of reach, and needs a suite that drives a
/// real one:
///
/// - **Layout and painting.** A test asserts a style as the declaration it
///   became, not as pixels.
/// - **The browser's own dispatch.** That Enter and Space on a button produce a
///   press, that Enter in a field submits the form around it, and that a press
///   inside a label reaches the input it wraps.
/// - **Focus and selection.** That a moved row keeps the focus and the caret.
///   What a test asserts here is the identity that makes it possible.
/// - **What assistive technology announces.** A test asserts a role as the
///   element it became.
export struct Rendered(I64);

/// Renders `root` into a document of its own.
///
/// The tree's handlers get this context, exactly as `mount` hands over the
/// context its caller passed.
export fn render<C: Ui>(ctx: C, root: Node<C>): Rendered;

impl Rendered {
    /// The tree as markup: elements, their attributes, their styles and their
    /// text, in order.
    ///
    /// It leaves out the runtime's own bookkeeping, the markers it puts around
    /// a region that can change.
    export fn markup(self): Str;

    /// Every run of text in the tree, in order, separated by a space.
    export fn text(self): Str;

    /// Presses the button whose label is `label`.
    ///
    /// Addressed by label rather than by position, the way a reader addresses
    /// it. Aborts when no button carries that label.
    export fn press(self, label: Str): ();

    /// Types `value` into the field labelled `label`, the way a reader replacing
    /// what was there would.
    export fn fill(self, label: Str, value: Str): ();

    /// Flips the toggle labelled `label`.
    export fn flip(self, label: Str): ();

    /// Submits the `index`th form, oldest first — what pressing Enter in one of
    /// its fields does.
    export fn submit(self, index: Int): ();

    /// How many elements of this kind the tree holds. The name is the one
    /// `markup` shows.
    export fn count(self, name: Str): Int;

    /// What the `index`th element of this kind is, as a number the runtime gives
    /// an element when it creates it and never gives to another.
    ///
    /// This is how a test says a keyed list *moved* a row rather than rebuilding
    /// it: the identity survives a reorder, and a rebuild changes it.
    export fn identity(self, name: Str, index: Int): Int;
}

/// The stylesheet the compiler extracted for this artifact.
///
/// It holds every static style in the program, as one atomic class per distinct
/// property value, deduped across the whole build. So a test can assert what a
/// class *means*, and see that two modules asking for one padding produced one
/// rule and not two.
///
/// Ahead of the classes is the reset: what a browser would paint by itself on
/// a heading, a button, a link or a field, dropped for the elements this
/// program builds.
export fn stylesheet(): Str;

/// Installs `themes` exactly as `mount` does, and answers the `:root` block
/// they resolve to — the custom properties, and the `color-scheme` a
/// `theme.scheme` writes.
///
/// This is how a test asserts what a token is *worth*: the stylesheet says only
/// that a class reads `var(--cardlib-surface)`. A chain resolves here once, the
/// way it resolves at mount.
///
/// It installs into the document `render` builds, so it belongs to a suite that
/// declares `platforms: [JS]` — a native run has no document and `buri test`
/// says so by name. A **snapshot** needs no installing at all: `snapshot` takes
/// its themes the way `mount` does.
export fn install(themes: [Theme]): Str;

/// The custom-property block installed right now.
///
/// Write a signal a `switching` theme's condition depends on, then read this
/// again: that is how a test sees a theme switch.
export fn variables(): Str;

/// Paints `root` under `themes` and compares it against
/// `test/__snapshots__/<name>.png`.
///
/// ```text
/// snapshot(ctx, "card", card(ctx, "Ada"), .Hover, [cardlib.themed(light)]);
/// ```
///
/// Fails the test when the bytes differ, and writes
/// `test/__snapshots__/<name>.diff.png` beside the golden. `buri test --update`
/// writes the golden instead of comparing.
///
/// No window and no browser: `describe` resolves the tree to a scene document
/// and the toolchain's own renderer paints it. `state` is the pseudo-class to
/// paint in, so a hovered card and a resting one are two snapshots of one
/// tree.
///
/// `themes` is `mount`'s parameter, in the same place in the sentence and
/// meaning the same thing: one theme per package whose design tokens this tree
/// uses, and where a chain of tokens resolves into the values the painter
/// reads. That is how a component is snapshotted light and dark — two calls,
/// two theme lists, two pictures. A tree with no tokens passes the empty list.
///
/// The name is a file name and nothing more. It may not be empty and may not
/// hold a path separator.
export fn snapshot<C: Allocator + Ui>(
    ctx: C,
    name: Str,
    root: Node<C>,
    state: State,
    themes: [Theme],
): () {
    let _ = installThemes(theme.document(ctx, themes));
    paint(name, node.describe(ctx, root, state), stateName(state))
}

/// The runner's side: what each token is worth, for the paint that follows.
///
/// A call of its own rather than a fifth argument to `paint`, because four
/// `Str`s is twelve machine words and a runtime call is ten
/// (`stencil/abi.rs`'s `MAX_INT_ARGS`).
fn installThemes(document: Str): ();

/// The runner's side: paint the scene, then compare or record.
fn paint(name: Str, scene: Str, state: Str): ();

/// The state, as the painter spells it.
fn stateName(state: State): Str {
    match (state) {
        .Hover => "hover",
        .Focus => "focus",
        .Active => "active",
        .Disabled => "disabled",
        .Checked => "checked",
    }
}

/// An ordered log, for asserting on *when* something ran.
///
/// A reactive computation gets a `Scope`, so it cannot write a signal to say
/// that it ran. This is how a test sees the order the runtime scheduled watchers
/// in, and how many times a memo recomputed. The log lives on the runner's side
/// and this value names it, the same shape as `core/host/testing`'s captured
/// stdout.
///
/// Holds no authority, so a lambda may capture one.
export struct Recorder(I64);

/// A fresh, empty recorder.
export fn recorder(): Recorder;

impl Recorder {
    /// Appends `tag` to the tag log.
    export fn record(self, tag: Str): ();

    /// Every tag recorded so far, oldest first.
    export fn recorded(self): [Str];

    /// Appends `value` to the value log, and answers it.
    ///
    /// A second channel rather than `record("${value}")`, so that a test
    /// asserting on numbers asserts on `[Int]` and not on rendered text. It
    /// answers its argument, so you can wrap it around the expression being
    /// watched.
    export fn note(self, value: Int): Int;

    /// Every value noted so far, oldest first.
    export fn noted(self): [Int];
}
