//! ui/node — the tree a user interface is, and the vocabulary that builds it.
//!
//! HTML conflates layout and meaning. This vocabulary splits them. **Meaning
//! comes from a `Role`**, taken from the accessibility taxonomy, which is
//! already cross-platform: a browser lowers a role to a semantic element, a
//! native backend lowers it to an accessibility trait. **Arrangement comes
//! from a `Style`**, which says nothing about what a thing is. No constructor
//! here is named after an HTML element, and there is no tag-string escape
//! hatch. Anything you could only reach by tag name is a role or a widget, or
//! you cannot reach it.
//!
//! The other rule runs through all of it: **whatever an assistive technology
//! cannot do without is a parameter**, not an attribute somebody may remember
//! to set. An image takes its `alt`, a link takes its `dest`, a field and a
//! toggle take their `label`. You cannot write an unlabelled input here. An
//! `icon` is the other side of that rule: it is decorative by construction,
//! so it carries no name and what it means is said by what it sits in.
//!
//! Building a tree needs no context, no allocator and no authority. Every
//! constructor below is pure, and `C` is unbounded in all of them. A `Node<C>`
//! keeps its one type parameter because handlers are open-ended: a press may
//! legitimately need `Network`, and `main` picks the budget of effects a program
//! permits. `C` occurs only in argument position, so holding a `Node<C>` is not
//! holding a `C`, which is what lets `mount` take one as ordinary data
//! (SPEC 10.2).
//!
//! Three constructors put reactivity *in* the tree, and each re-runs the
//! smallest thing it can. `choose` re-renders one of two subtrees when its
//! condition changes. `computed` re-renders its subtree when anything it read
//! changes. `each` reconciles a list by key, so it moves a row that is still
//! there rather than rebuilding it. Everything else runs once — a component is
//! an ordinary function, and it is called once.

from "core/alloc" import * as alloc;
from "core/effect" import { Allocator };
from "core/str" import * as str;
from "ui/effect" import { Event, Scope, Ui };
from "ui/prop" import { Prop };
from "ui/signal" import { Signal };
from "ui/style" import {
    Align, BorderStyle, Color, Corner, Cursor, Edge, FontFamily, Layout, Length,
    ListMarker, Shadow, State, Style, TextCase, TextLine, TextWrap, Track, Weight,
};
from "ui/theme" import { Theme };

/// What a region *is*, as against what it looks like.
///
/// Eighteen names, all from the accessibility taxonomy rather than from HTML.
/// Some are missing because they need behaviour and not just a name: tabs and
/// menus need a roving focus and a key model, and a dialog needs a focus trap
/// and a scroll lock, which is why it is the `dialog` widget below. There is
/// no `Grid` role: visual arrangement is `Style::Layout`, and a data table is
/// the four table roles below.
export enum Role {
    /// A set of links to elsewhere. `nav`.
    Navigation,
    /// The content of the page, once. `main`.
    Main,
    /// Introductory content at the top of the page. `header`.
    Banner,
    /// Authorship, copyright, links at the foot. `footer`.
    ContentInfo,
    /// Related but separable content. `aside`.
    Complementary,
    /// A self-contained composition. `article`.
    Article,
    /// The controls that search. `search`.
    Search,
    /// A list. A screen reader announces how many items it holds, which is why
    /// a list of things is this rather than a stack of things. `ul`.
    List,
    /// One item of a list. `li`.
    ListItem,
    /// A labelled cluster of related controls. `div role="group"`.
    Group,
    /// A break between sections. `hr`.
    Separator,
    /// A polite live region: the reader announces its changes once it goes
    /// idle. Without it, a reactive change to text is silent.
    /// `div role="status"`.
    Status,
    /// An assertive live region: its changes interrupt. Validation failures.
    /// `div role="alert"`.
    Alert,
    /// A data table — a structure of cells related to their headers, which is
    /// semantics and not arrangement. `table`.
    Table,
    /// One row of a table. `tr`.
    TableRow,
    /// A header for the row it is in. `th scope="row"`.
    RowHeader,
    /// A header for the column it is in. `th scope="col"`.
    ColumnHeader,
    /// One cell. `td`.
    Cell,
}

/// What a field accepts.
///
/// `Multiline` rather than a second constructor named after a `textarea`.
/// `Number`, `Email` and `Search` choose the keyboard on a phone as well as the
/// validation in a browser.
///
/// There is no `Range`: a slider's value is a number picked off a track, not a
/// run of text, and it shares none of a field's text-input behaviour — no
/// placeholder, no keyboard kind, no text value. It is its own primitive,
/// `slider`, which binds a `Signal<Float>` rather than dressing a text field up
/// as something it is not.
export enum FieldKind {
    /// A line of text.
    Text,
    /// Several lines.
    Multiline,
    /// A secret: never shown, never spoken.
    Password,
    /// An address.
    Email,
    /// A number.
    Number,
    /// A query.
    Search,
}

/// What a toggle looks like, and which mark it draws inside itself.
///
/// The two are one control with two marks. A screen reader is told them apart
/// — a switch announces "on" and "off" where a checkbox announces "ticked" —
/// so the kind is a parameter rather than a style, and the mark is the
/// widget's own drawing rather than a child the caller supplies.
export enum ToggleKind {
    /// A box with a tick in it when it is on.
    Checkbox,
    /// A track with a thumb in it, at the near end when it is off and at the
    /// far end when it is on.
    Switch,
}

/// What a button does when it is pressed, as against what its handler does.
///
/// A `.Button` is an ordinary button: it runs its own `onPress` and never
/// submits the form it happens to be inside, so a Cancel beside a Send stays a
/// Cancel. A `.Submit` submits its enclosing form — the form's `onSubmit` is
/// its handler, and pressing it and pressing Enter in a field both arrive
/// there — so it takes no `onPress` of its own. This absorbs what used to be a
/// separate `submit` node: the one irreducible capability, triggering
/// submission from a control, is a property of a button.
export enum ButtonKind {
    /// Runs its `onPress`, and submits nothing.
    Button,
    /// Submits the enclosing form, and takes no `onPress`.
    Submit,
}

/// What a picture is *to a reader*, which is the one thing about it that cannot
/// be left out.
///
/// `.Decorative` is a picture a reader is told nothing about, because what it
/// means is said by what it sits in — the button's label, the link's
/// destination. It is drawn as inline artwork in the element's own colour, so
/// `currentColor` follows the text beside it: the `source` is an `<svg>` and
/// the shapes inside it, read at compile time. This is what used to be `icon`.
///
/// `.AccessibilityText(name)` is a picture that *is* the content, so it carries
/// the name a reader hears in its place. Its `source` is an address the browser
/// fetches. This is what used to be `image`.
///
/// The name is a required part of the enum either way — a decorative picture
/// says so, and a meaningful one gives its text — so "you forgot the alt" stays
/// impossible to write.
export enum Alt {
    /// Decorative: no name, drawn inline in the element's colour (was `icon`).
    Decorative,
    /// Meaningful: the text a reader hears in the picture's place (was `image`).
    AccessibilityText(Str),
}

/// How a choice is drawn, as against what it *is*.
///
/// A `picker` is the one choice primitive, and the style picks its shape without
/// changing its accessible model — a single selected key, bound two-way to a
/// `Signal<Str>`. `.Radio` is a set of real radios (one tab stop, arrows that
/// move and select); the other three are the shapes a design system reaches for
/// when the list is long or the room is short. This is the choice axis's answer
/// to `FieldKind`: one primitive, styled, rather than a node per style.
export enum ChoiceStyle {
    /// One real radio per option, in a `role="radiogroup"`.
    Radio,
    /// One control split into a segment per option.
    Segmented,
    /// A button that opens the options in a menu.
    Menu,
    /// A native select.
    Dropdown,
}

/// The place a scroll came to rest, handed to an `onScroll` handler.
export struct ScrollOffset {
    /// How far the content has scrolled from its start along the inline axis.
    export x: Float,
    /// How far the content has scrolled from its start down the block axis.
    export y: Float,
}

/// A key, as the name a browser gives one: `"Escape"`, `"ArrowDown"`, `"Enter"`.
export type Key = Str;

/// The five generic events any element carries, each an omittable handler.
///
/// Named handlers rather than an `on: [Event]` list — omittable, discoverable,
/// and consistent with `onPress`/`onSubmit`. There is deliberately **no generic
/// `onTap`**: activation is a `button`'s or a `link`'s concern (a press on a
/// plain box is the "clickable div" anti-pattern), so it stays on those nodes.
///
/// A snapshot has no pointer, keyboard or scroll, so every one of these is inert
/// in `describe`; `onPressOutside` is the one a native mount still registers,
/// because it is a document listener rather than a paint. In a browser all five
/// are wired.
struct Events<C> {
    /// True as the pointer enters this element, false as it leaves.
    onHover: Option<fn(C, Bool) => ()>,
    /// True as focus moves into this element, false as it leaves (blur).
    onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element. Answering `true` claims
    /// the key: the platform's own handling of it is suppressed
    /// (`preventDefault`), so Tab does not leave the field, Enter does not submit
    /// the form, an arrow does not move the caret, and Escape does not shut the
    /// dialog. Answering `false` lets the key through, which is what a handler
    /// that only observed it wants.
    onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an
    /// overlay. Lowers to one document-level listener that lives exactly as long
    /// as the element.
    onPressOutside: Option<fn(C) => ()>,
}

/// A user interface, as a value.
///
/// Opaque on purpose. The field is private, so the constructors below are the
/// whole vocabulary. No program can build a node the runtime has no lowering
/// for, or take one apart.
export struct Node<C>(NodeKind<C>);

/// What a node is, kept private so `Node` stays opaque. The variant order is
/// load-bearing — the JavaScript runtime (`$tree_render`), the stylesheet's
/// chrome reset (`semantics::styles`) and the icon reader (`semantics::icons`)
/// all read a node by its tag, and the three must move together.
///
/// The public vocabulary is smaller than this list: one constructor per
/// irreducible capability, several of which pick between two variants here — a
/// `text` with a heading level is a `Heading`, a `.Decorative` `image` is an
/// `Icon`, a `.Submit` `button` is a `Submit`, a `stack` with a role is a
/// `Region`. The split is the renderer's, kept because each half lowers to a
/// different element and takes a different reset.
///
/// Every element-producing variant ends in an `Events<C>` — the five generic
/// handlers — which the browser wires and a snapshot ignores.
enum NodeKind<C> {
    Empty,
    Text(Prop<Str>),
    Heading(Int, [Style], Prop<Str>),
    Stack([Style], [Node<C>], Events<C>),
    Region(Role, [Style], [Node<C>], Events<C>),
    Button(Prop<Str>, [Style], [Node<C>], fn(C, Event) => (), Prop<Bool>, Prop<Bool>, Prop<Bool>, Events<C>),
    // A `<a href>`. `onFollow` set makes a same-origin dest route client-side
    // (what used to be `routeLink`); left `.None` it is a plain anchor.
    Link(Prop<Str>, [Style], [Node<C>], Option<fn(C, Str) => ()>, Prop<Bool>, Events<C>),
    Image(Prop<Str>, Str, [Style], Events<C>),
    Icon([Style], Str, Events<C>),
    Field(Prop<Str>, FieldKind, Prop<Str>, [Style], [Style], Signal<Str>, Option<Signal<(Int, Int)>>, Prop<Bool>, Prop<Bool>, Events<C>),
    // The numeric control split out of the old `FieldKind.Range`: label, value,
    // min, max, step, styles, around, disabled, events. `around` lands on the
    // `<label>` wrapper, the way a `Field`'s and a `Toggle`'s do.
    Slider(Prop<Str>, Signal<Float>, Float, Float, Option<Float>, [Style], [Style], Prop<Bool>, Events<C>),
    Toggle(Prop<Str>, ToggleKind, [Style], [Style], Signal<Bool>, Prop<Bool>, Prop<Bool>, Events<C>),
    // The one choice primitive (was `radioGroup`), styled. Each option is a key
    // and the node drawn beside it — any node, not just a caption.
    Picker(Prop<Str>, [(Str, Node<C>)], [Style], Signal<Str>, ChoiceStyle, Prop<Bool>, Events<C>),
    Form(fn(C, Event) => (), [Style], [Node<C>], Events<C>),
    // The button that submits its form: a childless `<button type=submit>`. Its
    // handler is the form's `onSubmit`, so it carries none of its own. `disabled`
    // takes it out of the tab order and refuses the submit, the way `<button
    // type=submit disabled>` does — an ordinary button's `isDisabled` reaches a
    // submit too.
    Submit(Prop<Str>, [Style], Prop<Bool>, Events<C>),
    // A modal. `scrimStyles` land on the scrim behind the panel, so a backdrop
    // blur or tint can reach it; `styles` land on the panel.
    Dialog(Signal<Bool>, Prop<Str>, [Style], [Node<C>], [Style], Events<C>),
    Disclosure(Prop<Str>, Signal<Bool>, [Style], [Node<C>], Events<C>),
    // How far a task has come. `value` set → determinate; `.None` → a spinner.
    Progress(Prop<Str>, Option<Prop<Float>>, [Style], [Node<C>], Events<C>),
    When(Prop<Bool>, Node<C>, Node<C>),
    Computed(fn(Scope) => Node<C>),
    // Three closures rather than the list itself, since the row type cannot be
    // `Node<C>`'s one type parameter. The runtime asks by index. See `each`.
    Each(fn(Scope) => Int, fn(Scope, Int) => Str, fn(C, Scope, Int) => Node<C>),
    // An element of an arbitrary name with its own styles and children, the
    // renderer's own — never a program's, so no `ui.*` builds one. It is how a
    // reactive widget whose presence or structure changes (a dialog, a
    // disclosure) rebuilds through `bindDynamic`: the build answers the open
    // state as a plain element tree the reconciler walks and mints afresh.
    // Appended last, because the variant order is load-bearing and append-only.
    Raw(Str, [Style], [Node<C>]),
    // A list of children with no element of their own — the renderer's own, for
    // a reactive region that shows several children directly under their parent
    // (a disclosure's body). Appended last, the variant order being load-bearing
    // and append-only.
    Fragment([Node<C>]),
}

// --- Building the tree -------------------------------------------------------
//
// Each constructor takes one config struct, so a call reads `button({ label:
// … })`: SPEC's type elision reads the literal's type off the parameter, and an
// `Option` field left out of the literal is `.None`, which the constructor
// reads as that field's default. Required fields are plain, non-`Option` — a
// label, an `alt`, a `dest`, a `kind` — and that is where the accessibility
// guarantee lives: you cannot leave one out. Behaviour is named `onX` handlers,
// gathered from a config's five generic ones into `Events` by `listen`.

/// The five generic handlers a config carries, gathered into one `Events`.
fn listen<C>(
    onHover: Option<fn(C, Bool) => ()>,
    onFocus: Option<fn(C, Bool) => ()>,
    onScroll: Option<fn(C, ScrollOffset) => ()>,
    onKey: Option<fn(C, Key) => Bool>,
    onPressOutside: Option<fn(C) => ()>,
): Events<C> {
    Events {
        onHover: onHover,
        onFocus: onFocus,
        onScroll: onScroll,
        onKey: onKey,
        onPressOutside: onPressOutside,
    }
}

/// The `Events` a node with no `onX` config carries — every handler unset.
fn noEvents<C>(): Events<C> {
    Events {
        onHover: .None,
        onFocus: .None,
        onScroll: .None,
        onKey: .None,
        onPressOutside: .None,
    }
}

/// A `Prop<Bool>` config field, defaulting to `false` when it was left out.
fn orFalse(flag: Option<Prop<Bool>>): Prop<Bool> {
    match (flag) {
        .Some(prop) => prop,
        .None => .Const(false),
    }
}

/// A `Prop<Str>` config field, defaulting to the empty string — no hint at all.
fn orBlank(text: Option<Prop<Str>>): Prop<Str> {
    match (text) {
        .Some(prop) => prop,
        .None => .Const(""),
    }
}

/// A `[Style]` config field, defaulting to none.
fn orNoStyles(styles: Option<[Style]>): [Style] {
    match (styles) {
        .Some(list) => list,
        .None => [],
    }
}

/// A `[Node<C>]` config field, defaulting to none.
fn orNoChildren<C>(children: Option<[Node<C>]>): [Node<C>] {
    match (children) {
        .Some(list) => list,
        .None => [],
    }
}

/// Nothing at all.
///
/// The other arm of a one-armed `choose`, and what a component answers when it
/// has nothing to show. It takes up no space and produces no element. Renamed
/// from `nothing`.
export fn empty<C>(): Node<C> {
    Node(.Empty)
}

/// A container. Arrangement lives in `styles`; give it a `role` and it *means*
/// something — a landmark, a list, a table row, a labelled group.
///
/// This is the one container primitive. A column is a `stack` with a
/// `Layout(.Column)` style, a row is `Layout(.Row)`, the layers case is
/// `Layout(.Layers)`, and a region is a `stack` with a `role` — so `column`,
/// `row` and `region` are gone, and the direction, the stacking and the meaning
/// are all data.
struct Stack<C> {
    /// Arrangement, size, spacing, colour and borders — `Layout(.Row)` for a
    /// row, `Layout(.Column)` for a column, `Layout(.Layers)` to stack.
    export styles: [Style],
    /// The nodes laid out inside, in order.
    export children: [Node<C>],
    /// What the container *means* — a landmark, a list, a table row, a labelled
    /// group. Left out, it is a plain box.
    export role: Option<Role>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn stack<C>(config: Stack<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    match (config.role) {
        .Some(role) => Node(.Region(role, config.styles, config.children, events)),
        .None => Node(.Stack(config.styles, config.children, events)),
    }
}

/// Empty space between two things. Left flexible it grows to push its siblings
/// apart; given a `size` it is a fixed gap.
///
/// A grown or fixed empty box, so it is a child's share of the main axis rather
/// than a margin — this vocabulary has no margins.
struct Spacer {
    /// A fixed gap when set; left out, the spacer grows to push its siblings
    /// apart. `{}` is unit, not an empty struct, so an unsized spacer is
    /// `spacer({ size: .None })`.
    export size: Option<Length>,
}

export fn spacer<C>(config: Spacer): Node<C> {
    match (config.size) {
        .Some(length) => {
            Node(.Stack([.Width(length), .Height(length), .Shrink(0)], [], noEvents()))
        },
        .None => Node(.Stack([.Grow(1)], [], noEvents())),
    }
}

/// Text. A run of characters with no element of its own; give it a
/// `headingLevel` and it becomes a heading in the document's outline, an
/// `<h1>`–`<h6>` a reader navigates by.
///
/// The level is not a size: an unstyled heading is the size and weight of the
/// text around it, and `styles` — which apply only when it is a heading — say
/// the rest, the sheet dropping the size, weight and margins a browser paints on
/// a heading by itself. Levels below one and above six clamp. This absorbs the
/// old `heading` node.
struct Text {
    /// The characters to show.
    export content: Prop<Str>,
    /// Set it and the text becomes a heading at this level (`1`–`6`, clamped)
    /// in the document outline. Left out, it is ordinary text.
    export headingLevel: Option<Int>,
    /// Applied only when this is a heading, to drop the size, weight and margins
    /// a browser paints on one by itself.
    export styles: Option<[Style]>,
}

export fn text<C>(config: Text): Node<C> {
    match (config.headingLevel) {
        .Some(level) => {
            Node(.Heading(level, orNoStyles(config.styles), config.content))
        },
        .None => Node(.Text(config.content)),
    }
}

/// Something to press, and what is drawn inside it.
///
/// The label is required because a reader announces a button with no accessible
/// name as "button", and it stays the name however the children are drawn — the
/// markup carries it as `aria-label`, so what a reader hears is never the
/// glyphs. **A button with no children shows its label**, which is what makes a
/// mark and a word one element rather than a row of two.
///
/// `onPress` runs for a tap, for Enter and for Space, and takes its context as a
/// parameter since a lambda may not capture one. A `.Submit` button omits it —
/// the enclosing form's `onSubmit` is its handler, and pressing this and Enter
/// in a field both arrive there — and submits that form; every other button
/// submits nothing, so a Cancel beside a Send stays a Cancel. This absorbs the
/// old `submit` node.
///
/// The styles land on the button itself, which is what makes `On(.Hover, ...)`,
/// `On(.Focus, ...)` and `On(.Disabled, ...)` fire. `isDisabled` takes the
/// button out of the tab order and refuses the press before the handler is
/// reached; `isExpanded` carries `aria-expanded` for a button that opens a menu
/// or popover; `isCurrent` carries `aria-current` for the one in a set that is
/// the current page. Each is announced, which is why it is a parameter and not
/// a style, and each is written only when it is `true`.
struct Button<C> {
    /// The accessible name, required. Stays what a reader hears however the
    /// children are drawn, and shows in place of them when there are none.
    export label: Prop<Str>,
    /// Applied to the button itself, so `On(.Hover, ...)`, `On(.Focus, ...)`
    /// and `On(.Disabled, ...)` fire.
    export styles: [Style],
    /// Drawn inside the button. Left out, the button shows its `label`.
    export children: Option<[Node<C>]>,
    /// Runs for a tap, for Enter and for Space, taking the context a lambda may
    /// not capture. A `.Submit` button omits it — the form's `onSubmit` is its
    /// handler.
    export onPress: Option<fn(C) => ()>,
    /// `.Submit` submits the enclosing form; every other kind submits nothing.
    /// Left out, an ordinary button.
    export kind: Option<ButtonKind>,
    /// Written only when `true`: takes the button out of the tab order and
    /// refuses the press before the handler is reached.
    export isDisabled: Option<Prop<Bool>>,
    /// Written only when `true`: `aria-expanded` for a button that opens a menu
    /// or popover.
    export isExpanded: Option<Prop<Bool>>,
    /// Written only when `true`: `aria-current` for the one in a set that is the
    /// current page.
    export isCurrent: Option<Prop<Bool>>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn button<C>(config: Button<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    match (config.kind) {
        .Some(.Submit) => {
            Node(
                .Submit(
                    config.label,
                    config.styles,
                    orFalse(config.isDisabled),
                    events,
                ),
            )
        },
        _ => {
            Node(
                .Button(
                    config.label,
                    config.styles,
                    orNoChildren(config.children),
                    pressHandler(config.onPress),
                    orFalse(config.isDisabled),
                    orFalse(config.isExpanded),
                    orFalse(config.isCurrent),
                    events,
                ),
            )
        },
    }
}

/// A public `onPress: fn(C) => ()` adapted to the runtime's `fn(C, Event) => ()`,
/// which ignores the event. A button with no `onPress` gets one that does
/// nothing, which is what a `.Submit`'s form-driven press wants.
fn pressHandler<C>(onPress: Option<fn(C) => ()>): fn(C, Event) => () {
    match (onPress) {
        .Some(handler) => fn(c, _event) => handler(c),
        .None => {
            fn(_c, _event) => {
            }
        },
    }
}

/// Somewhere to go. The destination is required — a reader announces a link by
/// where it goes.
///
/// Set `onFollow` and a same-origin `dest` routes client-side: the anchor is a
/// real `<a href>` (middle-click, ⌘-click, "open in new tab" and the status-bar
/// preview all work), but a plain left-click runs `onFollow` in place of the
/// browser's own navigation, and every modified click is left to the browser.
/// Left out, it is a plain anchor. This absorbs the old `routeLink`; `ui/web`'s
/// `routeLink` is the wrapper that fills `onFollow` with a client-side
/// `navigate`. `isCurrent` carries `aria-current` for the link to the page you
/// are on.
struct Link<C> {
    /// Where the link goes — the `href`.
    export dest: Prop<Str>,
    /// Drawn inside the link.
    export children: [Node<C>],
    /// Applied to the anchor itself.
    export styles: [Style],
    /// Written only when `true`: `aria-current` for the link to the page you
    /// are on.
    export isCurrent: Option<Prop<Bool>>,
    /// Runs on a plain left-click in place of the browser's navigation, given
    /// the destination; modified clicks are left to the browser. Left out, a
    /// plain anchor.
    export onFollow: Option<fn(C, Str) => ()>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn link<C>(config: Link<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Link(
            config.dest,
            config.styles,
            config.children,
            config.onFollow,
            orFalse(config.isCurrent),
            events,
        ),
    )
}

/// A picture, and what it is to a reader. `alt` is required — `.Decorative` for
/// artwork a reader is told nothing about, or `.AccessibilityText(name)` for a
/// picture that is the content and carries the name a reader hears in its place.
///
/// `.Decorative` is what used to be `icon`: the `source` is inline `<svg>`
/// artwork, read at compile time and drawn in the element's own `Foreground`,
/// so `currentColor` follows the text beside it and a theme switch recolours it
/// for nothing. `.AccessibilityText` is what used to be `image`: the `source`
/// is an address the browser fetches.
///
/// The styles land on the picture itself, the rule `button` and `field` follow:
/// sizing it, shaping it with `AspectRatio` and rounding it with `Radius` are
/// things only the picture can be told.
struct Image<C> {
    /// Where the picture comes from — inline `<svg>` read at compile time for a
    /// `.Decorative` picture, an address the browser fetches for
    /// `.AccessibilityText`.
    export source: Prop<Str>,
    /// What the picture is to a reader, required. `.Decorative` for artwork a
    /// reader is told nothing about, `.AccessibilityText(name)` for a picture
    /// that is the content and carries the name a reader hears in its place.
    export alt: Alt,
    /// Applied to the picture — size it, shape it with `AspectRatio`, round it
    /// with `Radius`.
    export styles: [Style],
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn image<C>(config: Image<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    match (config.alt) {
        .Decorative => Node(.Icon(config.styles, artworkOf(config.source), events)),
        .AccessibilityText(name) => {
            Node(.Image(config.source, name, config.styles, events))
        },
    }
}

/// A decorative picture's source is inline artwork the compiler reads, so it is
/// written out as a constant `<svg>`. A source that is not a constant is refused
/// by `semantics::icons` before this runs, so the fallback is unreachable for a
/// program that compiles.
fn artworkOf(source: Prop<Str>): Str {
    match (source) {
        .Const(svg) => svg,
        _ => "",
    }
}

/// Somewhere to type, and what it is for. The one text-input primitive: a line,
/// several lines, a secret, an address, a number or a query, picked by `kind`.
/// A slider is not one of these — its value is a number, not text — so it is its
/// own node, `slider`.
///
/// The label is required: an unlabelled input is the commonest accessibility
/// failure there is, and unlike a missing `alt` it has no visual fallback. There
/// is no change event — the field binds to a `Signal`, so what the reader types
/// lands in the signal and whatever writes the signal lands in the field.
///
/// **Two style lists, because a labelled control is two boxes.** `styles` land
/// on the input — the thing a reader focuses and a browser disables. `around`
/// lands on the label the input and its text are wrapped in, the box a
/// surrounding stack lays out: `Grow`, `Shrink`, `AlignSelf` and `Width` belong
/// there.
///
/// `isInvalid` carries `aria-invalid` and puts the input in `State::Invalid`;
/// `isDisabled` refuses what a reader types and puts it in `State::Disabled`.
/// `hint` is the sample value inside the empty box — `aria-placeholder`-shaped,
/// announced after the name, gone the moment there is a value — never a
/// substitute for the required label.
struct Field<C> {
    /// The accessible name, required — an unlabelled input has no visual
    /// fallback the way a missing `alt` does.
    export label: Prop<Str>,
    /// What the field is for — a line, several lines, a secret, an address, a
    /// number or a query — which picks the keyboard and the validation.
    export kind: FieldKind,
    /// The two-way binding: what the reader types lands here, and whatever
    /// writes this lands in the field. There is no change event.
    export value: Signal<Str>,
    /// The caret and the selection, as an `(anchor, focus)` pair of offsets into
    /// the text — the DOM's `selectionStart`/`selectionEnd`. The two are equal
    /// for a plain caret and differ for a selection. The platform writes it as
    /// the reader moves, and writing it back moves the caret or selects a span
    /// (`setSelectionRange`), which is how an editor writes ahead of the caret or
    /// replaces what is selected. Left out, the field keeps none.
    export selection: Option<Signal<(Int, Int)>>,
    /// Applied to the input — the thing a reader focuses and a browser disables.
    export styles: [Style],
    /// The sample value shown in the empty box, gone the moment there is a
    /// value. Never a substitute for the label.
    export hint: Option<Prop<Str>>,
    /// Applied to the label the input and its text are wrapped in — where
    /// `Grow`, `Shrink`, `AlignSelf` and `Width` belong.
    export around: Option<[Style]>,
    /// Written only when `true`: `aria-invalid`, and puts the input in
    /// `State::Invalid`.
    export isInvalid: Option<Prop<Bool>>,
    /// Written only when `true`: refuses what a reader types and puts the input
    /// in `State::Disabled`.
    export isDisabled: Option<Prop<Bool>>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn field<C>(config: Field<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Field(
            config.label,
            config.kind,
            orBlank(config.hint),
            config.styles,
            orNoStyles(config.around),
            config.value,
            config.selection,
            orFalse(config.isInvalid),
            orFalse(config.isDisabled),
            events,
        ),
    )
}

/// A number picked off a track, between a smallest and a largest, in steps of a
/// size. The numeric control split out of the old `FieldKind.Range`.
///
/// A slider shares no text-input behaviour — no placeholder, no keyboard kind,
/// no text value — so it binds a `Signal<Float>` rather than dressing a `field`
/// up as something it is not. `min` and `max` are required because a reader is
/// told the range it is dragging inside; `step` is what an arrow key moves by,
/// and defaults to a continuous track when left out. The label is required for a
/// `field`'s reason.
struct Slider<C> {
    /// The accessible name, required for a `field`'s reason.
    export label: Prop<Str>,
    /// The two-way binding to the number picked off the track.
    export value: Signal<Float>,
    /// The smallest value the track allows, required — a reader is told the
    /// range being dragged inside.
    export min: Float,
    /// The largest value the track allows, required.
    export max: Float,
    /// Applied to the slider.
    export styles: [Style],
    /// Applied to the `<label>` the track and its text are wrapped in — where
    /// `Grow`, `Shrink`, `AlignSelf` and `Width` belong, the way a `field`'s and
    /// a `toggle`'s `around` does.
    export around: Option<[Style]>,
    /// What an arrow key moves by. Left out, a continuous track.
    export step: Option<Float>,
    /// Written only when `true`: takes the slider out of the tab order and
    /// refuses input.
    export isDisabled: Option<Prop<Bool>>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn slider<C>(config: Slider<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Slider(
            config.label,
            config.value,
            config.min,
            config.max,
            config.step,
            config.styles,
            orNoStyles(config.around),
            orFalse(config.isDisabled),
            events,
        ),
    )
}

/// Something with two states, what it looks like, and what it is for.
///
/// Binds to a `Signal<Bool>`, for the reason a field binds to a signal. The kind
/// picks the mark the control draws inside itself — a tick for a `Checkbox`, a
/// thumb that moves for a `Switch` — so a toggle needs no children and there is
/// no way to leave one unmarked.
///
/// The two style lists are a field's: `styles` land on the box, so
/// `On(.Checked, ...)` is the box being on, and `around` lands on the label the
/// box and its text are wrapped in. The mark is drawn in the box's `Foreground`.
/// `isInvalid` and `isDisabled` mean what a field's do.
struct Toggle<C> {
    /// The accessible name, required for a `field`'s reason.
    export label: Prop<Str>,
    /// What the control looks like and which mark it draws — a tick for a
    /// `.Checkbox`, a moving thumb for a `.Switch`.
    export kind: ToggleKind,
    /// The two-way binding to the toggle's state: on while it holds `true`.
    export isOn: Signal<Bool>,
    /// Applied to the box, so `On(.Checked, ...)` is the box being on.
    export styles: [Style],
    /// Applied to the label the box and its text are wrapped in.
    export around: Option<[Style]>,
    /// Written only when `true`: `aria-invalid`, and puts the box in
    /// `State::Invalid`.
    export isInvalid: Option<Prop<Bool>>,
    /// Written only when `true`: refuses the toggle and puts the box in
    /// `State::Disabled`.
    export isDisabled: Option<Prop<Bool>>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn toggle<C>(config: Toggle<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Toggle(
            config.label,
            config.kind,
            config.styles,
            orNoStyles(config.around),
            config.isOn,
            orFalse(config.isInvalid),
            orFalse(config.isDisabled),
            events,
        ),
    )
}

/// A group of controls you submit.
///
/// A widget rather than a role, because submitting is behaviour: pressing Enter
/// in a field inside one runs `onSubmit`. That is why `Role` has no `Form`.
///
/// **Put a `.Submit` button in it.** Enter is the platform's own dispatch, and
/// its rule comes with it: a form is submitted implicitly through its submit
/// button, and a form with none is submitted only while it holds exactly one
/// field. So a form of one field works either way, and a form of two that ends
/// in an ordinary `button` discards the keypress.
struct Form<C> {
    /// Runs when the form is submitted — by a `.Submit` button or by Enter in a
    /// field inside it.
    export onSubmit: fn(C) => (),
    /// The controls in the form. Put a `.Submit` button among them.
    export children: [Node<C>],
    /// Applied to the form.
    export styles: [Style],
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn form<C>(config: Form<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(.Form(submitHandler(config.onSubmit), config.styles, config.children, events))
}

/// A public `onSubmit: fn(C) => ()` adapted to the runtime's `fn(C, Event) => ()`,
/// which ignores the event.
fn submitHandler<C>(onSubmit: fn(C) => ()): fn(C, Event) => () {
    fn(c, _event) => onSubmit(c)
}

/// A panel over the page, and the signal that opens and shuts it.
///
/// A widget rather than a stack with a pin, because a modal needs three things
/// from the platform that no style can say: the page behind it must stop
/// scrolling, what is behind must go inert, and the focus must stay inside. A
/// browser gives all three to a `<dialog>` opened with `showModal`, along with
/// the backdrop and the Escape key, and gives a `<div>` none of them.
///
/// **`isOpen` is writable because the platform writes it.** Escape shuts the
/// dialog without asking, so a `Prop` would leave the program holding a panel
/// the reader can no longer see. Write `true` to open it and `false` to shut it;
/// the browser writes `false` back when it shuts one itself. To dismiss it on a
/// press outside the panel, set `onPressOutside` and write it shut there.
///
/// The label is the accessible name, the rule `button`'s label follows. `styles`
/// land on the panel; **`scrimStyles` land on the scrim behind it**, so a
/// `BackdropBlur` or a tint can reach the backdrop the way `field`'s `around`
/// reaches its label. The scrim is the widget's own drawing — a black at half
/// strength by default — and `scrimStyles` compose on top of it.
///
/// Shut, it draws nothing and what is inside it is out of reach. Open, it is
/// pinned to the viewport, so like every pin it never decides how tall a page
/// is.
struct Dialog<C> {
    /// The two-way binding that opens and shuts it: Open while it holds `true`.
    /// Writable because the platform writes it — the browser writes `false`
    /// back when Escape shuts the dialog.
    export isOpen: Signal<Bool>,
    /// The accessible name, the rule `button`'s label follows.
    export label: Prop<Str>,
    /// What the panel holds.
    export children: [Node<C>],
    /// Applied to the panel.
    export styles: [Style],
    /// Applied to the scrim behind the panel — a `BackdropBlur` or a tint,
    /// composed on top of the default half-strength black.
    export scrimStyles: Option<[Style]>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn dialog<C>(config: Dialog<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Dialog(
            config.isOpen,
            config.label,
            config.styles,
            config.children,
            orNoStyles(config.scrimStyles),
            events,
        ),
    )
}

/// One choice among a few, styled. The one choice primitive (was `radioGroup`).
///
/// `.Radio` lands real radios — one tab stop, the arrow keys that *move and
/// select*, `aria-checked` and the roving `tabindex`, all the browser's own the
/// moment the options are `<input type="radio">` in a `role="radiogroup"`. The
/// other `ChoiceStyle`s draw the same accessible model as a segmented control, a
/// menu or a native select. One primitive on the choice axis, styled — the way
/// `field(kind)` is one input primitive — rather than a node per style.
///
/// `label` is the group's accessible name, required for the reason every
/// widget's label is. `options` is one `(key, content)` per choice: the key is
/// what the signal holds when that option is picked, and the content is any node
/// drawn beside it, not just a caption. `value` holds the selected key — the
/// option whose key equals it is the checked one, and picking another writes its
/// key back, so two-way binding replaces a change event. A key the signal holds
/// that no option carries checks nothing, which is an unset choice.
///
/// `styles` land on the group, the box a surrounding stack lays out. `style`
/// picks the shape and defaults to `.Radio`.
struct Picker<C> {
    /// The group's accessible name, required for a widget's reason.
    export label: Prop<Str>,
    /// The choices — one `(key, content)` pair per choice. The key is what the
    /// signal holds when that option is picked; the content is any node drawn
    /// beside it, not just a caption.
    export options: [(Str, Node<C>)],
    /// The two-way binding holding the selected key: the option whose key
    /// equals it is checked, and picking another writes its key back. A key no
    /// option carries is an unset choice.
    export value: Signal<Str>,
    /// Applied to the group.
    export styles: [Style],
    /// The shape drawn — `.Radio`, a segmented control, a menu or a native
    /// select. Defaults to `.Radio`.
    export style: Option<ChoiceStyle>,
    /// Written only when `true`: takes the group out of the tab order and
    /// refuses a pick.
    export isDisabled: Option<Prop<Bool>>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn picker<C>(config: Picker<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    let style = match (config.style) {
        .Some(chosen) => chosen,
        .None => .Radio,
    };
    Node(
        .Picker(
            config.label,
            config.options,
            config.styles,
            config.value,
            style,
            orFalse(config.isDisabled),
            events,
        ),
    )
}

/// How far along a task has come, announced as well as drawn.
///
/// A widget rather than a role, because the value is what the role is for: a bar
/// that says `role="progressbar"` and nothing else is announced as a progress
/// bar with no progress. So the value is a parameter — the module's own rule,
/// that whatever an assistive technology cannot do without is a parameter.
///
/// **Set `value` for a determinate bar, leave it out for a spinner.** A value
/// from `0.0` to `1.0` lowers to `aria-valuenow` as a whole number of hundredths
/// beside `aria-valuemin="0"` and `aria-valuemax="100"`. Left out, the bar is
/// indeterminate — no `aria-valuenow`, which is how a reader is told a task is
/// running without a figure for how far — the shape a spinner takes. `label` is
/// the accessible name: a reader is told what is loading, not only that
/// something is.
///
/// **The fill is the caller's.** `children` are what is drawn inside the bar and
/// `styles` land on the bar itself; the widget adds the announcement and nothing
/// to the picture.
struct Progress<C> {
    /// The accessible name: a reader is told what is loading, not only that
    /// something is.
    export label: Prop<Str>,
    /// Applied to the bar.
    export styles: [Style],
    /// A fraction from `0.0` to `1.0` for a determinate bar. Left out, the bar
    /// is indeterminate — a spinner.
    export value: Option<Prop<Float>>,
    /// Drawn inside the bar — the fill is the caller's.
    export children: Option<[Node<C>]>,
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn progress<C>(config: Progress<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Progress(
            config.label,
            config.value,
            config.styles,
            orNoChildren(config.children),
            events,
        ),
    )
}

/// A section that opens and shuts, and the summary that opens it.
///
/// A widget rather than a role, and the reason is `dialog`'s: the element
/// carries behaviour no style and no `Role` can name. A `<details>` with a
/// `<summary>` is the open-and-shut state, the Enter and Space that toggle it,
/// and what a reader is told about all of it. An accordion is an `each` of these.
///
/// `summary` is the always-visible label; `children` are what it hides and
/// shows; `styles` land on the `<details>`. **`isOpen` is writable because the
/// platform writes it** — a reader opens and shuts a `<details>` without asking
/// the program — the rule `dialog`'s `isOpen` follows.
struct Disclosure<C> {
    /// The always-visible label that opens and shuts the section.
    export summary: Prop<Str>,
    /// The two-way binding for the open state: open while it holds `true`.
    /// Writable because the platform writes it — a reader opens and shuts a
    /// `<details>` without asking the program.
    export isOpen: Signal<Bool>,
    /// What the section hides and shows.
    export children: [Node<C>],
    /// Applied to the `<details>`.
    export styles: [Style],
    /// Runs as the pointer enters this element (`true`) and as it leaves (`false`).
    export onHover: Option<fn(C, Bool) => ()>,
    /// Runs as focus moves into this element (`true`) and as it leaves (`false`).
    export onFocus: Option<fn(C, Bool) => ()>,
    /// The offset this element's own scroll came to rest at.
    export onScroll: Option<fn(C, ScrollOffset) => ()>,
    /// A key pressed while focus is within this element.
    export onKey: Option<fn(C, Key) => Bool>,
    /// A press that lands anywhere outside this element — what dismisses an overlay.
    export onPressOutside: Option<fn(C) => ()>,
}

export fn disclosure<C>(config: Disclosure<C>): Node<C> {
    let events = listen(
        config.onHover,
        config.onFocus,
        config.onScroll,
        config.onKey,
        config.onPressOutside,
    );
    Node(
        .Disclosure(
            config.summary,
            config.isOpen,
            config.styles,
            config.children,
            events,
        ),
    )
}

/// One subtree or the other, decided by a condition that may vary.
///
/// When the condition changes, the showing subtree tears down — its
/// computations go with it — and the other one builds. When it does not
/// change, nothing here runs at all.
///
/// Named `choose` rather than `when` because `when` is a reserved word, the
/// same substitution `ui/signal` makes when it calls `watch` what would
/// otherwise be `effect`.
export fn choose<C>(cond: Prop<Bool>, then: Node<C>, otherwise: Node<C>): Node<C> {
    Node(.When(cond, then, otherwise))
}

/// A subtree derived from whatever it reads.
///
/// The closure gets a `Scope` at evaluation time and can never capture one,
/// which lets a pure component hold a derivation. It re-runs when anything it
/// actually read changes, and rebuilds its subtree when it does. That makes it
/// the coarse instrument: reach for a `Prop` on a leaf when only a string is
/// changing.
export fn computed<C>(build: fn(Scope) => Node<C>): Node<C> {
    Node(.Computed(build))
}

/// One row per item, reconciled by key.
///
/// The key is a parameter rather than a convention: keying a list by position
/// silently corrupts it the moment anything reorders the list. Two items with
/// the same key is a mistake the runtime refuses at the point you make it.
///
/// A row whose key is still in the list *moves*, never rebuilds, which keeps the
/// focus, the scroll position and the computations inside a row alive across a
/// reorder. It also means a row is built from its item once. If what a row shows
/// can change while its key stays the same, make the changing part a `Prop`.
///
/// `T` carries an ordinary bound because the closures below capture a
/// `Prop<[T]>`, and an unbounded type parameter could be a context
/// (`design/ui-reactivity.md` rule 5). `derive Equal` supplies it.
export fn each<C, T: Equal>(
    items: Prop<[T]>,
    key: fn(T) => Str,
    row: fn(C, T, Int) => Node<C>,
): Node<C> {
    Node(
        .Each(
            fn(scope) => items.read(scope).length(),
            fn(scope, index) => {
                match (items.read(scope).get(index)) {
                    .Some(item) => key(item),
                    .None => "",
                }
            },
            fn(c, scope, index) => {
                match (items.read(scope).get(index)) {
                    .Some(item) => row(c, item, index),
                    .None => Node(.Empty),
                }
            },
        ),
    )
}

/// Rebuilds a subtree from the mount context whenever `on` changes.
///
/// The reactive constructor a router reaches for. `choose` hands its builder
/// nothing and `computed` hands it a `Scope`, so neither can build a page that
/// mints signals — `signal(ctx, …)` needs `Ui` — or routes, and a client
/// site is left building every page at startup and using `computed` only to
/// pick one already built. `rebuild` is `each` narrowed to one row, keyed by
/// `on`, under a name that says so: it hands `build` the mount context, and
/// when `on` changes the old subtree tears down with its computations and the
/// new one is built with the real context. So the page a route matches is built
/// when the route matches, and not before.
///
/// `build` runs only when `on` changes, and untracked — the signals the page it
/// builds reads are the page's own, not this rebuild's, so a page's reactivity
/// is not tied to its route. `K` carries `Show` because the region keys on how
/// `on` renders: two values that render alike are the same subtree and it
/// stays, and one that renders differently is a new subtree and the old one
/// goes with its computations.
export fn rebuild<C, K: Show>(on: Prop<K>, build: fn(C, K) => Node<C>): Node<C> {
    Node(
        .Each(
            fn(_scope) => 1,
            fn(scope, _index) => on.read(scope).show(scope),
            fn(c, scope, _index) => build(c, on.read(scope)),
        ),
    )
}

/// Puts a tree on the screen, and leaves it there.
///
/// The context is what the tree's handlers get, so it is the budget `main`
/// chose and nothing wider. `themes` is one theme per package whose design
/// tokens this program uses, and it is where a chain of tokens resolves — a
/// library's token to the app's token to a colour — into the one
/// custom-property block the page reads (see `ui/theme`). An app with no
/// tokens passes the empty list.
///
/// Answers `.Ok(())` and returns immediately. The page stays live because the
/// entry wrapper only exits on an `.Err`, and the listeners this registered keep
/// running. `.Err` is for a platform with nowhere to mount — in a browser, a
/// document with no body yet.
///
/// Run outside a browser, under `bun` or `node`, there is no document at all, so
/// the runtime supplies one. A program written for a page builds, mounts and
/// reacts from a command line, which is what lets a test and a golden run it.
/// `ui/testing` lists what a substitute cannot answer.
export fn mount<C: Ui>(ctx: C, root: Node<C>, themes: [Theme]): Result<(), Str>;

// --- The scene document ------------------------------------------------------
//
// `describe` writes down what a tree would look like instead of putting it on a
// screen. `ui/testing`'s `snapshot` paints what comes out, and
// `cli/runtime/paint.rs` reads it.
//
// It is ordinary Buri and not an intrinsic: a node holds closures, and a runtime
// written in C cannot call one.

/// An untracked scope: reading through it records no dependency.
///
/// What the walk below reads props under. A snapshot observes the graph once
/// and subscribes to nothing, so nothing here re-runs.
fn rootScope(): Scope;

/// The tree, resolved to a scene document — every prop read, every style
/// expanded, every child in order.
///
/// The document is line-oriented UTF-8. `buri-scene 1`, then
/// `viewport <width> <height>`, then one line per box (`e <depth>
/// <declarations>`) or run of text (`t <depth> <text>`). A line at depth `d`
/// is a child of the nearest line above it at depth `d - 1`.
///
/// **The page is 800 across and as tall as what it holds.** Across is a
/// viewport width and so is stated rather than measured: `At(.Small)` and
/// every percentage resolve against it, and a number read off the tree would
/// make a breakpoint depend on what it decides. Down is the word `fit`, which
/// asks the painter for the height the paint came to — so a picture of a
/// button is the size of a button, and a page taller than a screen is painted
/// whole rather than cut off. `describeWide` is the same document at another
/// width.
///
/// An image is a box carrying `image:<source>`, its `;` and `\` escaped. The
/// painter reads a `data:` URI holding a PNG or an SVG and paints every other
/// source — an address, a path — as a placeholder box of the same size,
/// because a snapshot fetches nothing.
///
/// An icon is a box carrying `icon:<artwork>`, escaped the same way and with
/// its line breaks flattened. The artwork is in the scene rather than behind an
/// address, so the painter draws it with `currentColor` bound to the colour the
/// element paints in — which is what an icon is for, and what an `image` cannot
/// do, its source being a document of its own.
///
/// `state` is the pseudo-class the snapshot is taken in. An `On(s, ...)`
/// contributes its styles when `s` is that state and nothing otherwise. An
/// `At(...)` contributes nothing at all — a breakpoint's rules are in the
/// stylesheet, and the painter reads that for itself.
///
/// Two of the six states are not the snapshot's to name, because the tree
/// already holds the answer, and a widget's line says so. A toggle carries
/// `checked:<true|false>`, which is its signal — the same thing its mark is
/// drawn from: a page holding one toggle that is on and one that is off paints
/// two answers, and the snapshot's `.Checked` reaches only what holds no
/// answer of its own. A button, a field and a toggle whose `disabled` is set
/// carry `disabled:true`; that one is a direction rather than an answer, so
/// the snapshot's `.Disabled` still asks every element what it would look like
/// unavailable.
///
/// A heading's level says nothing here. The level is the document's outline
/// and the sheet paints no size or weight for one, so a heading's line carries
/// its own styles and nothing else — which is what the markup carries too.
///
/// A field's and a toggle's `<label>` is the runtime's element rather than the
/// program's, so its line carries the arrangement the sheet's reset gives it —
/// the control and its text on one line, and a line of its own for a control as
/// wide as the line is — and then whatever `around` said. A field's own line
/// carries `field:<kind>`, which is the `type` its markup carries: the painter
/// masks a password's value on it.
///
/// A range carries `range:<min> <max> <value>` beside its kind and no run of
/// text under it, because a browser draws a slider and never the number behind
/// one. The painter reads the three and puts the thumb where the value is.
///
/// A field with a hint carries `placeholder:<hint>` beside its kind, whatever
/// its value is — the attribute stays in the markup whatever is typed, and it
/// is the painter that stops drawing the hint once the run under the input has
/// something in it. A range carries none.
///
/// A toggle's box carries a line for its mark, which is the widget's own
/// drawing rather than anything a program wrote: `mark:thumb` for a switch,
/// always, and `mark:tick` for a checkbox that is on. Both are painted in the
/// box's own foreground.
///
/// A shut `dialog` writes no lines at all, because a browser draws none of
/// one. An open one writes two boxes: the scrim it sits on, pinned to the
/// viewport and centring what it holds, and the panel inside that. The scrim
/// is the widget's own drawing too — the `::backdrop` a browser paints, said
/// in the vocabulary the painter reads.
export fn describe<C: Allocator>(ctx: C, root: Node<C>, state: State): Str {
    describeWide(ctx, root, state, 800)
}

/// `describe`, laid out on a page `width` across rather than on the 800-wide
/// one.
///
/// The one thing a width buys is a **breakpoint**: `At(.Small)` and its four
/// siblings resolve against the page, so the same tree at 390 and at 800 is
/// the only way to see one apply and not apply. Everything else about the
/// document is what `describe` says it is, the height included — the page
/// still fits what it holds, because a stated height is a picture with
/// something cut off it.
export fn describeWide<C: Allocator>(
    ctx: C,
    root: Node<C>,
    state: State,
    width: Int,
): Str {
    let head = ["buri-scene 1", str.format(ctx, "viewport ${width} fit")];
    head.concat(ctx, nodeLines(ctx, state, root, 0)).join(ctx, "\n")
}

/// A handle to the document `render` is building — the runtime's element arena.
///
/// Opaque, and it carries no authority, so it crosses as data. Only `render`
/// mints one, by way of the runtime, and hands it to `renderInto`.
export struct Builder(I64);

/// Walks `node` into the document `builder` holds, the way `describe` walks one
/// into `[Str]`.
///
/// The split `design/native` calls for: the *destructuring* of a `Node` stays
/// here, in Buri, where `describe` already does it and where it is legal, and
/// the mutable document stays in the runtime. `render` reaches this through the
/// walk trampoline, handing over its own `ctx` — dropped at the boundary as a
/// step drops one, and reconstructed here as the zero-sized context it is, so
/// an `each`'s `rowAt` can be handed it. `C` is unbounded, which is what lets a
/// handler need any effect.
///
/// **Static, and only static.** A `Prop` is read once through the untracked
/// `rootScope`, and `when`/`computed`/`each` are built once; the watcher that
/// re-reads and the reconciler that re-walks are a later phase. It mirrors
/// `nodeLines` arm for arm, and every element carries the same scene
/// declarations its line does — the allocator that builds them is minted from
/// `core/alloc` where it is needed, because those bytes are the runtime's and
/// need no capability from `render`'s context.
export fn renderInto<C>(ctx: C, builder: Builder, node: Node<C>): () {
    emitNode(ctx, builder, node, .Hover)
}

/// A run of text that follows its prop — the native `$tree_bind`.
///
/// A `Const` registers nothing, which is the whole reason it is a visible
/// variant: a static interface holds no computations at all, so it is emitted
/// once and never watched. Anything that can change opens the run once, minting
/// its identity, and registers a watcher that re-reads the prop and patches
/// that same record — the element and its identity are never remade, so a write
/// moves the text and not the node.
fn emitReactiveText(builder: Builder, content: Prop<Str>): () {
    match (content) {
        .Const(v) => { let _ = emitText(builder, v); },
        _ => {
            let at = openText(builder);
            reactive(fn(scope) => patchText(builder, at, content.read(scope)))
        },
    }
}

/// A region whose contents are decided by something that can change — the
/// native `$tree_dynamic`. Two markers hold the place; a watcher removes
/// everything between them and re-walks `build(scope)`, so every element the
/// region shows is built again and minted again. Everything that run created
/// belongs to the run, so the watchers a subtree registered are disposed with
/// it when the region is rebuilt — the graph's `run` disposes the previous
/// run's children (`cli/runtime/ui.rs`), which is what a departed subtree needs
/// and what this reuses rather than rebuilds.
///
/// The watcher captures no context — a lambda may not (SPEC 10.6) — so it hands
/// the re-walk to `rebuildRegion` as `renderInto` itself, a walk that *takes*
/// its context as a parameter the runtime supplies and drops, exactly as
/// `render` hands `renderInto` to `mount`. `build` and the region handle carry
/// no effect, so the watcher captures those.
fn bindDynamic<C>(builder: Builder, build: fn(Scope) => Node<C>): () {
    let region = enterDynamic(builder);
    reactive(fn(scope) => rebuildRegion(builder, region, build(scope), renderInto))
}

/// One node's records, and everything under it — `nodeLines`, emitting to the
/// document instead of building `[Str]`.
fn emitNode<C>(ctx: C, builder: Builder, node: Node<C>, state: State): () {
    let mem = alloc.generalPurpose();
    let scope = rootScope();
    match (node.0) {
        .Empty => {
        },
        .Text(content) => emitReactiveText(builder, content),
        .Heading(level, styles, content) => {
            let _ = emitElement(
                builder,
                headingName(level),
                widgetBody(mem, plain(state), [], styles),
            );
            let _ = emitReactiveText(builder, content);
            exitElement(builder)
        },
        .Stack(styles, children, events) => {
            emitBox(ctx, builder, "div", plain(state), styles, children, state, events)
        },
        .Region(role, styles, children, events) => {
            emitBox(
                ctx,
                builder,
                roleName(role),
                plain(state),
                roleStyles(mem, role, styles, children),
                children,
                state,
                events,
            )
        },
        // A reactive `disabled` (or, for a label-only button, a reactive label)
        // rebuilds the button in place through `bindDynamic`: the build reads
        // the props under its scope — subscribing — and answers the button with
        // them snapshotted to `.Const`, so the rebuilt node takes the static arm
        // and never re-wraps. An all-`Const` button is emitted once, with no
        // watcher, exactly as `describe` expands it.
        .Button(label, styles, children, onPress, disabled, expanded, current, events) => {
            if (constProp(label) && constProp(disabled)) {
                emitButton(
                    ctx,
                    builder,
                    label,
                    styles,
                    children,
                    onPress,
                    disabled,
                    state,
                )
            } else {
                bindDynamic(builder, fn(scope) => {
                    Node(
                        .Button(
                            .Const(label.read(scope)),
                            styles,
                            children,
                            onPress,
                            .Const(disabled.read(scope)),
                            expanded,
                            current,
                            events,
                        ),
                    )
                })
            }
        },
        // A plain anchor, or — when `onFollow` is set — one whose plain
        // left-click routes client-side. The handler crosses whole (`renderInto`
        // never calls it, so its `Location` requirement never reaches this
        // unbounded walk); the runtime fires it with the destination on a
        // `follow`. A plain link with no handler is a box like any other, so it
        // keeps `emitBox`'s reactive-style path.
        .Link(dest, styles, children, onFollow, _current, events) => {
            match (onFollow) {
                .None => {
                    emitBox(
                        ctx,
                        builder,
                        "a",
                        plain(state),
                        styles,
                        children,
                        state,
                        events,
                    )
                },
                .Some(handler) => {
                    // A routing anchor's styles are reactive the same way a
                    // plain link's (`emitBox`) are: a `.When`/`.Computed` swap —
                    // how a nav rail marks the current row — re-serialises in
                    // place rather than being frozen at first render.
                    let _ = if (stylesReactive(styles)) {
                        let at = openElement(builder, "a", "");
                        reactive(fn(scope) => {
                            patchBody(
                                builder,
                                at,
                                widgetBodyUnder(scope, plain(state), [], styles),
                            )
                        })
                    } else {
                        emitElement(
                            builder,
                            "a",
                            widgetBody(mem, plain(state), [], styles),
                        )
                    };
                    let _ = registerFollow(builder, dest.read(scope), handler);
                    let _ = registerEvents(builder, events);
                    let _ = emitChildren(ctx, builder, children, state, 0);
                    exitElement(builder)
                },
            }
        },
        .Image(source, _alt, styles, events) => {
            let declaration = decl(mem, "image", escapeValue(mem, source.read(scope)));
            let _ = emitElement(
                builder,
                "img",
                widgetBody(mem, plain(state), [declaration], styles),
            );
            let _ = registerEvents(builder, events);
            exitElement(builder)
        },
        .Icon(styles, source, events) => {
            let artwork = decl(mem, "icon", escapeInline(mem, source));
            let _ = emitElement(
                builder,
                "svg",
                widgetBody(mem, plain(state), [artwork], styles),
            );
            let _ = registerEvents(builder, events);
            exitElement(builder)
        },
        // A field's value, hint and `disabled` all change its scene, so a write
        // to any of them rebuilds it in place: a region holds its spot and the
        // watcher re-reads the three — subscribing — and re-emits. The control's
        // own element is ctx-free, so the watcher emits it inline between the
        // region's markers rather than walking a node.
        .Field(label, kind, hint, styles, around, value, selection, invalid, disabled, _events) => {
            let region = enterDynamic(builder);
            let _ = invalid;
            reactive(fn(scope) => {
                let _ = beginRegion(builder, region);
                let _ = emitField(
                    scope,
                    builder,
                    label,
                    kind,
                    hint,
                    styles,
                    around,
                    value,
                    selection,
                    disabled,
                    state,
                );
                endRegion(builder)
            })
        },
        // A slider's value and `disabled` change its scene, so a write rebuilds
        // it in place, the way a field does. The control is ctx-free, so the
        // watcher emits it inline between the region's markers.
        .Slider(label, value, min, max, step, styles, around, disabled, _events) => {
            let region = enterDynamic(builder);
            let _ = step;
            reactive(fn(scope) => {
                let _ = beginRegion(builder, region);
                let _ = emitSlider(
                    scope,
                    builder,
                    label,
                    value,
                    min,
                    max,
                    styles,
                    around,
                    disabled,
                    state,
                );
                endRegion(builder)
            })
        },
        // A toggle's `checked` (its mark and its `checked:` line) and `disabled`
        // change its scene, so a flip rebuilds it in place. Its element and its
        // mark are ctx-free, so the watcher emits them inline between the
        // region's markers.
        .Toggle(label, kind, styles, around, value, invalid, disabled, _events) => {
            let region = enterDynamic(builder);
            let _ = invalid;
            reactive(fn(scope) => {
                let _ = beginRegion(builder, region);
                let _ = emitToggle(
                    scope,
                    builder,
                    label,
                    kind,
                    styles,
                    around,
                    value,
                    disabled,
                    state,
                );
                endRegion(builder)
            })
        },
        // The group's box is emitted once with the caller's context, since an
        // option's content is any node; each option's input and dot follow the
        // selection in a reactive region of their own, so picking one re-checks
        // and re-dots without rebuilding the content beside it. `style` picks
        // the shape and does not change the scene the painter reads.
        .Picker(label, options, styles, value, _style, _disabled, _events) => {
            let _ = label;
            emitPicker(ctx, builder, options, styles, value, state)
        },
        .Form(onSubmit, styles, children, events) => {
            let _ = emitElement(
                builder,
                "form",
                widgetBody(mem, plain(state), [], styles),
            );
            let _ = registerPress(builder, onSubmit);
            let _ = registerEvents(builder, events);
            let _ = emitChildren(ctx, builder, children, state, 0);
            exitElement(builder)
        },
        // A submit button's `disabled` changes its scene — the `disabled:true`
        // its line carries, and whether a press or an Enter reaches the form —
        // so a write rebuilds it in place, the way a field's does. The element is
        // ctx-free, so the watcher emits it inline between the region's markers.
        .Submit(label, styles, disabled, events) => {
            let region = enterDynamic(builder);
            reactive(fn(scope) => {
                let inner = alloc.generalPurpose();
                let _ = beginRegion(builder, region);
                let _ = emitElement(
                    builder,
                    "button",
                    widgetBody(
                        inner,
                        refusing(state, disabled.read(scope)),
                        [],
                        styles,
                    ),
                );
                let _ = markSubmit(builder);
                let _ = registerEvents(builder, events);
                let _ = emitText(builder, label.read(scope));
                let _ = exitElement(builder);
                endRegion(builder)
            })
        },
        .When(cond, then, otherwise) => {
            match (cond) {
                // A constant condition never changes, so the branch it chooses
                // is built once with no markers and no watcher, exactly as
                // `describe` expands it.
                .Const(pick) => {
                    if (pick) {
                        emitNode(ctx, builder, then, state)
                    } else {
                        emitNode(ctx, builder, otherwise, state)
                    }
                },
                _ => {
                    bindDynamic(builder, fn(dynamicScope) => {
                        if (cond.read(dynamicScope)) { then } else { otherwise }
                    })
                },
            }
        },
        .Computed(build) => bindDynamic(builder, build),
        .Each(count, keyAt, rowAt) => emitEach(builder, count, keyAt, rowAt),
        // Shut, a browser draws none of a dialog, so the scene holds none either;
        // open, it is the scrim and the panel. `open` is a signal, so the dialog
        // appears and vanishes with it: a region holds its place and the build
        // answers the open content — a scrim `div` (the caller's `scrimStyles`
        // over the default) holding a `dialog` element, as `.Raw` trees the
        // reconciler walks and mints — or nothing. Closing it unlinks the panel,
        // so the page behind is reachable again.
        .Dialog(open, _label, styles, children, scrimStyles, _events) => {
            bindDynamic(builder, fn(scope) => {
                if (open.get(scope)) {
                    Node(
                        .Raw("div", scrimWith(scrimStyles), [
                            Node(.Raw("dialog", styles, children)),
                        ]),
                    )
                } else {
                    Node(.Empty)
                }
            })
        },
        // The summary is always drawn; the children only when open. `open` is a
        // signal, so the group rebuilds in place on a toggle: the build answers
        // a `details` element holding the summary, and the children after it
        // only while open, as a `.Raw` tree the reconciler walks.
        .Disclosure(summary, open, styles, children, events) => {
            // The `details` and its `summary` are always drawn, so they are
            // emitted once and kept — the element and its identity survive a
            // toggle, the way a browser's `<details>` does. Only the body comes
            // and goes, in a region of its own inside the `details`.
            let _ = emitElement(
                builder,
                "details",
                widgetBody(mem, plain(state), [], styles),
            );
            let _ = registerEvents(builder, events);
            let _ = emitElement(
                builder,
                "summary",
                widgetBody(mem, plain(state), [], []),
            );
            let _ = emitReactiveText(builder, summary);
            let _ = exitElement(builder);
            let _ = bindDynamic(builder, fn(scope) => {
                if (open.get(scope)) { Node(.Fragment(children)) } else { Node(.Empty) }
            });
            exitElement(builder)
        },
        // A bar and whatever fills it. The role and the `aria-value*` are a
        // reader's, not a painter's, so the scene is the caller's own boxes.
        .Progress(_label, _value, styles, children, events) => {
            emitBox(ctx, builder, "div", plain(state), styles, children, state, events)
        },
        .Raw(name, styles, children) => {
            emitBox(
                ctx,
                builder,
                name,
                plain(state),
                styles,
                children,
                state,
                noEvents(),
            )
        },
        .Fragment(children) => { emitChildren(ctx, builder, children, state, 0) },
    }
}

/// Whether a prop is a constant — one that never changes, so the widget holding
/// it needs no watcher for it.
fn constProp<T>(prop: Prop<T>): Bool {
    match (prop) {
        .Const(_) => true,
        _ => false,
    }
}

/// A button's static emit: its element, the kept press, and its label or its
/// children. `disabled` is read untracked because the watcher that re-reads it
/// is the `bindDynamic` the reactive arm wraps this in — here every prop is
/// already a constant.
fn emitButton<C>(
    ctx: C,
    builder: Builder,
    label: Prop<Str>,
    styles: [Style],
    children: [Node<C>],
    onPress: fn(C, Event) => (),
    disabled: Prop<Bool>,
    state: State,
): () {
    let mem = alloc.generalPurpose();
    let painted = refusing(state, disabled.read(rootScope()));
    // A button whose styles hold a computation opens once and patches its body
    // from a watcher, so a `.When`/`.Computed` class swap re-serialises in place
    // — the same reactive-style bind `emitBox` gives a plain box. A button of
    // constant styles registers nothing. (Its `disabled` is constant here: the
    // reactive arm of `emitNode`'s `Button` wraps a non-const one in a rebuild.)
    let _ = if (stylesReactive(styles)) {
        let at = openElement(builder, "button", "");
        reactive(fn(scope) => {
            patchBody(builder, at, widgetBodyUnder(scope, painted, [], styles))
        })
    } else {
        emitElement(builder, "button", widgetBody(mem, painted, [], styles))
    };
    let _ = registerPress(builder, onPress);
    let _ = registerLabel(builder, label.read(rootScope()));
    let _ = if (children.isEmpty()) {
        emitReactiveText(builder, label)
    } else {
        emitChildren(ctx, builder, children, state, 0)
    };
    exitElement(builder)
}

/// A toggle's static emit, reading its signal and `disabled` under `scope` so
/// the watcher that drives it subscribes to both. No node crosses, so it needs
/// no context: a toggle holds a control and a caption and no program children.
fn emitToggle(
    ctx: Scope,
    builder: Builder,
    label: Prop<Str>,
    kind: ToggleKind,
    styles: [Style],
    around: [Style],
    value: Signal<Bool>,
    disabled: Prop<Bool>,
    state: State,
): () {
    let mem = alloc.generalPurpose();
    let on = value.get(ctx);
    let painted = Painted {
        state: state,
        checked: .Some(on),
        disabled: disabled.read(ctx),
    };
    let _ = emitElement(
        builder,
        "label",
        widgetBody(mem, plain(state), [], wrapper(around)),
    );
    let _ = emitElement(
        builder,
        "input",
        widgetBody(mem, painted, [], boxStyles(on, styles)),
    );
    let _ = registerValue(builder, value.index());
    let _ = emitMark(builder, kind, on);
    let _ = exitElement(builder);
    let _ = emitReactiveText(builder, label);
    exitElement(builder)
}

/// A field's static emit, reading its signal, hint and `disabled` under `scope`
/// so the watcher subscribes to each. It holds no program children, so no
/// context crosses.
fn emitField(
    ctx: Scope,
    builder: Builder,
    label: Prop<Str>,
    kind: FieldKind,
    hint: Prop<Str>,
    styles: [Style],
    around: [Style],
    value: Signal<Str>,
    selection: Option<Signal<(Int, Int)>>,
    disabled: Prop<Bool>,
    state: State,
): () {
    let mem = alloc.generalPurpose();
    let _ = emitElement(
        builder,
        "label",
        widgetBody(mem, plain(state), [], wrapper(around)),
    );
    let _ = emitReactiveText(builder, label);
    let _ = emitFieldControl(
        builder,
        refusing(state, disabled.read(ctx)),
        kind,
        hint.read(ctx),
        styles,
        value.get(ctx),
        value.index(),
        selection,
    );
    exitElement(builder)
}

/// A picker's emit. The group's box is emitted once with the caller's context,
/// since an option's content is any node; each option's input and dot follow the
/// selection in a reactive region of their own.
fn emitPicker<C>(
    ctx: C,
    builder: Builder,
    options: [(Str, Node<C>)],
    styles: [Style],
    value: Signal<Str>,
    state: State,
): () {
    let mem = alloc.generalPurpose();
    let _ = emitElement(builder, "div", widgetBody(mem, plain(state), [], styles));
    let _ = emitPickerOptions(ctx, builder, options, value, state, 0);
    exitElement(builder)
}

/// Every option, in order: a `<label>` wrapping a reactive input-and-dot region
/// and the option's content node. The region re-reads the selection, so picking
/// one re-checks and re-dots it without touching the content beside it.
fn emitPickerOptions<C>(
    ctx: C,
    builder: Builder,
    options: [(Str, Node<C>)],
    value: Signal<Str>,
    state: State,
    at: Int,
): () {
    match (options.get(at)) {
        .None => {
        },
        .Some(option) => {
            let mem = alloc.generalPurpose();
            let key = option.0;
            let content = option.1;
            let _ = emitElement(
                builder,
                "label",
                widgetBody(mem, plain(state), [], wrapper([])),
            );
            let region = enterDynamic(builder);
            let _ = reactive(fn(scope) => {
                let inner = alloc.generalPurpose();
                let on = key == value.get(scope);
                let painted = Painted {
                    state: state,
                    checked: .Some(on),
                    disabled: false,
                };
                let _ = beginRegion(builder, region);
                let _ = emitElement(
                    builder,
                    "input",
                    widgetBody(inner, painted, [], radioBox()),
                );
                let _ = emitDot(builder, on);
                let _ = exitElement(builder);
                endRegion(builder)
            });
            let _ = emitNode(ctx, builder, content, state);
            let _ = exitElement(builder);
            emitPickerOptions(ctx, builder, options, value, state, at + 1)
        },
    }
}

/// A slider's static emit, reading its value and `disabled` under `scope` so the
/// watcher subscribes to both. It holds no program children, so no context
/// crosses.
fn emitSlider(
    ctx: Scope,
    builder: Builder,
    label: Prop<Str>,
    value: Signal<Float>,
    min: Float,
    max: Float,
    styles: [Style],
    around: [Style],
    disabled: Prop<Bool>,
    state: State,
): () {
    let mem = alloc.generalPurpose();
    let _ = emitElement(
        builder,
        "label",
        widgetBody(mem, plain(state), [], wrapper(around)),
    );
    let _ = emitReactiveText(builder, label);
    let _ = emitSliderControl(
        builder,
        refusing(state, disabled.read(ctx)),
        min,
        max,
        styles,
        value.get(ctx),
        value.index(),
    );
    exitElement(builder)
}

/// A slider's control: an `<input type=range>` carrying `field:range` and the
/// `range:<min> <max> <value>` a painter reads the thumb from, bound to the
/// signal. Its scene is the old `FieldKind.Range`'s, so the painter is unchanged.
fn emitSliderControl(
    builder: Builder,
    painted: Painted,
    min: Float,
    max: Float,
    styles: [Style],
    value: Float,
    signal: Int,
): () {
    let mem = alloc.generalPurpose();
    let leading = [decl(mem, "field", "range")].concat(
        mem,
        sliderBounds(mem, min, max, value),
    );
    let _ = emitElement(
        builder,
        "input",
        widgetBody(mem, painted, leading, sliderTrack(styles)),
    );
    let _ = registerValue(builder, signal);
    exitElement(builder)
}

/// Registers the one generic event a native scene can carry: `onPressOutside`,
/// a document listener the runtime pairs with the open element, disposed with
/// the subtree. The other four handlers (`onHover`, `onFocus`, `onScroll`,
/// `onKey`) are the browser's alone — a snapshot has no pointer, keyboard or
/// scroll — so they are wired only in `runtime.js`'s `$tree_events`. The public
/// handler is `fn(C) => ()`, adapted here to the intrinsic's `fn(C, Event)`.
fn registerEvents<C>(builder: Builder, events: Events<C>): () {
    match (events.onPressOutside) {
        .Some(handler) => registerOutside(builder, fn(c, _event) => handler(c)),
        .None => {
        },
    }
}

/// A box: its element, its `onPressOutside` listener, then every child one level
/// in. The listener is kept on the open element, so it lands before the
/// children and is disposed with the subtree.
fn emitBox<C>(
    ctx: C,
    builder: Builder,
    name: Str,
    painted: Painted,
    styles: [Style],
    children: [Node<C>],
    state: State,
    events: Events<C>,
): () {
    let mem = alloc.generalPurpose();
    // A box whose styles hold a computation opens the element once and patches
    // its body from a watcher, so a write to what a `Computed`/`When` style
    // reads re-serialises the line in place — the scene's `$tree_styles` bind.
    // Its children are emitted once and kept, as are the element and its
    // identity. A box of constant styles registers nothing.
    if (stylesReactive(styles)) {
        let at = openElement(builder, name, "");
        let _ = reactive(fn(scope) => {
            patchBody(builder, at, widgetBodyUnder(scope, painted, [], styles))
        });
        let _ = registerEvents(builder, events);
        let _ = emitChildren(ctx, builder, children, state, 0);
        exitElement(builder)
    } else {
        let _ = emitElement(builder, name, widgetBody(mem, painted, [], styles));
        let _ = registerEvents(builder, events);
        let _ = emitChildren(ctx, builder, children, state, 0);
        exitElement(builder)
    }
}

/// Whether a style list holds a computation — a `Computed`, or a `When` whose
/// condition can change — so the element carrying it needs a watcher. A list
/// of constants registers none, which is what lets a static interface hold no
/// computations at all.
fn stylesReactive(styles: [Style]): Bool {
    stylesReactiveAt(styles, 0)
}

fn stylesReactiveAt(styles: [Style], at: Int): Bool {
    match (styles.get(at)) {
        .None => false,
        .Some(style) => {
            let here = match (style) {
                .Computed(_build) => true,
                .When(cond, then, otherwise) => {
                    !constProp(cond)
                        || stylesReactiveAt(then, 0)
                        || stylesReactiveAt(otherwise, 0)
                },
                .Group(inner) => stylesReactiveAt(inner, 0),
                .On(_on, inner) => stylesReactiveAt(inner, 0),
                .At(_screen, inner) => stylesReactiveAt(inner, 0),
                _ => false,
            };
            if (here) { true } else { stylesReactiveAt(styles, at + 1) }
        },
    }
}

/// Every child, in order.
fn emitChildren<C>(
    ctx: C,
    builder: Builder,
    children: [Node<C>],
    state: State,
    at: Int,
): () {
    match (children.get(at)) {
        .None => {
        },
        .Some(child) => {
            let _ = emitNode(ctx, builder, child, state);
            emitChildren(ctx, builder, children, state, at + 1)
        },
    }
}

/// A leaf element — one line, no children.
fn emitLeaf(builder: Builder, name: Str, body: Str): () {
    let _ = emitElement(builder, name, body);
    exitElement(builder)
}

/// A keyed list — the native `$tree_each`. `enterEach` opens the two markers
/// and the owner the rows hang off; a watcher then reconciles on every change to
/// what the keys read.
///
/// The watcher body is a lambda, so it captures no context (SPEC 10.6) — which
/// is why the row is built through `renderInto` handed to the runtime, exactly
/// as a region rebuild is. `count` and `keyAt` take only a `Scope`, so the
/// watcher drives them itself to compute the keys (their reads are the list's
/// dependencies); `rowAt` takes the context, so the runtime supplies and drops
/// one, driving `build` per new key. `build` renders the row's node under the
/// row's own owner and untracked, so the watchers a row registers are that
/// owner's and die with the row.
fn emitEach<C>(
    builder: Builder,
    count: fn(Scope) => Int,
    keyAt: fn(Scope, Int) => Str,
    rowAt: fn(C, Scope, Int) => Node<C>,
): () {
    let region = enterEach(builder);
    // The row body the runtime drives per new key. Its first parameter is the
    // context it supplies and drops; its second is the row's owner, which the
    // runtime has already pointed the graph at, so the row reads through the
    // untracked `rootScope` exactly as `rowLines` does and its leaves belong to
    // the owner. The third is the row index. A lambda may take a context
    // parameter, which is how a row is built with no context captured.
    let build = fn(c: C, _owner: Int, index: Int) => {
        renderInto(c, builder, rowAt(c, rootScope(), index))
    };
    reactive(fn(scope) => {
        reconcile(builder, region, keysOf(scope, count, keyAt), build)
    })
}

/// The keys of a list, in order — `keyAt` at every index up to `count`, built
/// with the scope as the allocator (a `Scope` is one). The reads subscribe the
/// watcher these run under, so writing what the list is derived from reconciles
/// it.
fn keysOf(ctx: Scope, count: fn(Scope) => Int, keyAt: fn(Scope, Int) => Str): [Str] {
    keysUpTo(ctx, keyAt, count(ctx), 0, [])
}

fn keysUpTo(
    ctx: Scope,
    keyAt: fn(Scope, Int) => Str,
    n: Int,
    at: Int,
    acc: [Str],
): [Str] {
    if (at >= n) {
        acc
    } else {
        keysUpTo(ctx, keyAt, n, at + 1, acc.push(ctx, keyAt(ctx, at)))
    }
}

/// A field's control and the run of text it holds — `fieldLines`, emitting.
fn emitFieldControl(
    builder: Builder,
    painted: Painted,
    kind: FieldKind,
    hint: Str,
    styles: [Style],
    value: Str,
    signal: Int,
    selection: Option<Signal<(Int, Int)>>,
): () {
    let mem = alloc.generalPurpose();
    let leading = [decl(mem, "field", kindName(kind))].concat(
        mem,
        placeholder(mem, hint),
    );
    let _ = emitElement(
        builder,
        fieldName(kind),
        widgetBody(mem, painted, leading, styles),
    );
    let _ = registerValue(builder, signal);
    // The caret/selection signal is registered but never read here: the scene a
    // painter reads carries no caret, so a write to it must not rebuild the
    // field. `select` writes it, and a browser binds it to `setSelectionRange`.
    let _ = match (selection) {
        .Some(sel) => registerSelection(builder, sel.index()),
        .None => {
        },
    };
    let _ = emitText(builder, value);
    exitElement(builder)
}

/// A toggle's mark — `markLines`, emitting. A synthetic element the widget
/// draws, so it carries no element name.
fn emitMark(builder: Builder, kind: ToggleKind, on: Bool): () {
    let mem = alloc.generalPurpose();
    match (kind) {
        .Switch => {
            emitLeaf(
                builder,
                "",
                elementBody(mem, [], ["mark:thumb", "height:100%", "aspect-ratio:1"]),
            )
        },
        .Checkbox => {
            if (on) {
                emitLeaf(
                    builder,
                    "",
                    elementBody(mem, [], ["mark:tick", "width:100%", "height:100%"]),
                )
            } else {
            }
        },
    }
}

/// A radio's dot when it is the checked one — `dotLines`, emitting.
fn emitDot(builder: Builder, on: Bool): () {
    let mem = alloc.generalPurpose();
    if (on) {
        emitLeaf(
            builder,
            "",
            elementBody(mem, [], ["mark:dot", "width:50%", "height:50%"]),
        )
    } else {
    }
}

/// The `range:<min> <max> <value>` declaration a slider carries, escaped the way
/// a declaration needs. The painter reads the three and puts the thumb where the
/// value is. Its shape is the old `FieldKind.Range`'s, so the painter is
/// unchanged.
fn sliderBounds<C: Allocator>(ctx: C, min: Float, max: Float, value: Float): [Str] {
    let lo = str.fromFloat(ctx, min);
    let hi = str.fromFloat(ctx, max);
    let at = str.fromFloat(ctx, value);
    [decl(ctx, "range", str.format(ctx, "${lo} ${hi} ${at}"))]
}

/// A slider's track: the size a browser gives one, and then the caller's own.
/// Twelve lines wide, one line tall, and it does not shrink — the sheet's reset
/// says the same to a browser, because with the chrome cleared an unsized range
/// is a control nobody can see or hit.
fn sliderTrack(styles: [Style]): [Style] {
    [.Width(.Rem(12.0)), .Height(.Rem(1.0)), .Shrink(0), .Group(styles)]
}

/// A dialog's scrim styles: the widget's own drawing, then the caller's
/// `scrimStyles` on top — so a `BackdropBlur` or a tint reaches the backdrop and
/// still wins. An empty list adds a `.Group([])`, which contributes nothing, so
/// the default scrim is byte-identical when `scrimStyles` is omitted.
fn scrimWith(extra: [Style]): [Style] {
    let mem = alloc.generalPurpose();
    scrim().push(mem, .Group(extra))
}

/// What a `FieldKind`'s control element is called — `textarea` for the one kind
/// that wraps, and `input` for the rest.
fn fieldName(kind: FieldKind): Str {
    match (kind) {
        .Multiline => "textarea",
        .Text => "input",
        .Password => "input",
        .Email => "input",
        .Number => "input",
        .Search => "input",
    }
}

/// The element a heading of this level becomes, clamped to `h1`–`h6` — the
/// document's outline, which is why the level is not a size.
fn headingName(level: Int): Str {
    if (level <= 1) {
        "h1"
    } else if (level == 2) {
        "h2"
    } else if (level == 3) {
        "h3"
    } else if (level == 4) {
        "h4"
    } else if (level == 5) {
        "h5"
    } else {
        "h6"
    }
}

/// The element a role becomes — the accessibility taxonomy lowered to the tags
/// `count` and `identity` address, the same lowering `mount` makes.
fn roleName(role: Role): Str {
    match (role) {
        .Navigation => "nav",
        .Main => "main",
        .Banner => "header",
        .ContentInfo => "footer",
        .Complementary => "aside",
        .Article => "article",
        .Search => "search",
        .List => "ul",
        .ListItem => "li",
        .Group => "div",
        .Separator => "hr",
        .Status => "div",
        .Alert => "div",
        .Table => "table",
        .TableRow => "tr",
        .RowHeader => "th",
        .ColumnHeader => "th",
        .Cell => "td",
    }
}

/// Emits an element with `name` and its scene declarations `body`, and enters
/// it: everything until the matching `exitElement` is its child.
fn emitElement(builder: Builder, name: Str, body: Str): ();

/// Closes the element `emitElement` opened.
fn exitElement(builder: Builder): ();

/// Emits a run of text under the open element.
fn emitText(builder: Builder, content: Str): ();

/// Opens an empty run of text under the open element and answers the handle a
/// reactive leaf patches it by. Its identity is minted here, once, and the
/// watcher `emitReactiveText` registers writes over its text and never its
/// identity.
fn openText(builder: Builder): I64;

/// Writes `content` over the run `openText` answered `at`.
fn patchText(builder: Builder, at: I64, content: Str): ();

/// Emits an element with `name` and `body` and enters it, the way `emitElement`
/// does, and answers the index a reactive style patches its body by. Its
/// identity is minted once; the watcher `emitReactiveBox` registers writes over
/// its `body` and never its identity, so a style that changes moves no element.
fn openElement(builder: Builder, name: Str, body: Str): I64;

/// Writes `body` over the element `openElement` answered `at`, leaving its
/// identity, its children and its place as they were.
fn patchBody(builder: Builder, at: I64, body: Str): ();

/// Registers `body` to run now and again on every change to what it reads —
/// the renderer's own `watch`, reached with no `Ui` in hand because the runtime
/// owns the graph the reconciler builds. Everything the run creates belongs to
/// the run, so a rebuilt region disposes the watchers its last build left.
fn reactive(body: fn(Scope) => ()): ();

/// Opens a changeable region: two markers holding a place that emits nothing,
/// and the handle `rebuildRegion` names it by.
fn enterDynamic(builder: Builder): I64;

/// Clears `region` and points the builder at the gap, so the emits that follow
/// land between its markers — `rebuildRegion` split open, for a reactive widget
/// whose body builds no `Node` and needs no context. `endRegion` closes it.
fn beginRegion(builder: Builder, region: I64): ();

/// Restores where the builder emits after `beginRegion`.
fn endRegion(builder: Builder): ();

/// Rebuilds `region`: removes everything between its markers, points the builder
/// at the gap, walks `node` there with `walk`, and restores the builder. `walk`
/// is `renderInto`, handed over rather than captured so the runtime supplies and
/// drops its context — the native `$tree_dynamic`'s remove-and-re-render.
fn rebuildRegion<C>(
    builder: Builder,
    region: I64,
    node: Node<C>,
    walk: fn(C, Builder, Node<C>) => (),
): ();

/// Opens a keyed list: two markers holding its place and the graph owner its
/// rows hang off, and the handle `reconcile` names it by — the native
/// `$tree_each`'s setup.
fn enterEach(builder: Builder): I64;

/// Reconciles the list against `keys`: moves a surviving key's row, builds a new
/// key's through `build`, and disposes a departed key's owner. `build` is the
/// row body `renderInto(c, builder, rowAt(c, rootScope(), index))`, handed over
/// rather than captured so the runtime supplies and drops its context; its
/// middle parameter is the row's owner, which the runtime has already pointed
/// the graph at before it drives one — the native `$tree_reconcile`.
fn reconcile<C>(
    builder: Builder,
    region: I64,
    keys: [Str],
    build: fn(C, Int, Int) => (),
): ();

/// Keeps a button's or a form's `fn(C, Event) => ()` on the open element, for a
/// press or a submit to fire — the native twin of a listener on an element. The
/// handler lives in the graph, so disposing the row it is in disposes it.
fn registerPress<C>(builder: Builder, onPress: fn(C, Event) => ()): ();

/// Keeps an `onPressOutside`'s `fn(C, Event) => ()` on the document, paired with
/// the open element, so a press whose target is not inside that element fires
/// it. The handler lives in the graph, so disposing the subtree it is in takes
/// the listener with it — the native twin of `$dom_outside`.
fn registerOutside<C>(builder: Builder, handler: fn(C, Event) => ()): ();

/// Stores the signal a field's or a toggle's value is bound to on the open
/// element, so `fill` writes it a string and `flip` its negation.
fn registerValue(builder: Builder, signal: Int): ();

/// Stores the signal a field's caret/selection is bound to on the open element,
/// so `select` writes it an `(anchor, focus)` pair and a browser binds it to
/// `setSelectionRange`. Never read while the scene is built — a caret is not in
/// the paint — so a write to it moves no scene.
fn registerSelection(builder: Builder, signal: Int): ();

/// Keeps a control's accessible name on the open element, so `press` can
/// address a button by the label a reader hears even when its glyphs are its
/// children — the scene twin of the `aria-label` a button carries.
fn registerLabel(builder: Builder, label: Str): ();

/// Keeps a route link's `fn(C, Str) => ()` and its destination on the open
/// anchor, so `follow` fires it with that destination — a plain left-click that
/// navigates in place — while `openInNewTab` leaves it to the browser and fires
/// nothing. The handler lives in the graph, disposed with the subtree.
fn registerFollow<C>(builder: Builder, dest: Str, onFollow: fn(C, Str) => ()): ();

/// Flags the open button as the one whose press submits its form — the native
/// `type="submit"`, the whole of what makes a press or Enter submit.
fn markSubmit(builder: Builder): ();

/// The lines one node contributes, and the lines of everything under it.
///
/// Mirrors the runtime's own render, minus the document: a box is an `e` line
/// and its children are one level deeper, text is a `t` line, and the three
/// reactive constructors are read once and expanded.
fn nodeLines<C: Allocator>(ctx: C, state: State, node: Node<C>, depth: Int): [Str] {
    let scope = rootScope();
    match (node.0) {
        .Empty => [],
        .Text(content) => [textLine(ctx, depth, content.read(scope))],
        .Heading(_level, styles, content) => {
            [
                styledLine(ctx, plain(state), styles, depth),
                textLine(ctx, depth + 1, content.read(scope)),
            ]
        },
        .Stack(styles, children, _events) => {
            container(ctx, state, styles, children, depth)
        },
        // A role paints nothing — it is what a reader is told, not what a
        // painter draws — except the table roles, whose whole point is a
        // two-dimensional arrangement a browser gives them for free.
        .Region(role, styles, children, _events) => {
            container(
                ctx,
                state,
                roleStyles(ctx, role, styles, children),
                children,
                depth,
            )
        },
        // The children are what is drawn, and a button with none draws its
        // label — which is the one place the accessible name and the glyphs
        // are the same string.
        .Button(label, styles, children, _onPress, disabled, _expanded, _current, _events) => {
            let painted = refusing(state, disabled.read(scope));
            if (children.isEmpty()) {
                [
                    styledLine(ctx, painted, styles, depth),
                    textLine(ctx, depth + 1, label.read(scope)),
                ]
            } else {
                boxed(ctx, painted, styles, children, depth)
            }
        },
        // A link — plain or routing — paints as the anchor it is. The
        // destination and the plain-click handler are behaviour, not a picture,
        // so the scene carries neither.
        .Link(_dest, styles, children, _onFollow, _current, _events) => {
            container(ctx, state, styles, children, depth)
        },
        // A picture is a box with a source in it. The painter reads a data URI
        // it can and paints a placeholder box at the same size for one it
        // cannot; `alt` is what a reader is *told* and never what is drawn, so
        // it is not in the scene.
        .Image(source, _alt, styles, _events) => {
            let declaration = decl(ctx, "image", escapeValue(ctx, source.read(scope)));
            [widgetLine(ctx, plain(state), [declaration], styles, depth)]
        },
        // Artwork, not an address: the scene carries the drawing itself, which
        // is what lets the painter resolve `currentColor` against the colour
        // this element paints in. The declaration comes first, so a style still
        // wins over it.
        .Icon(styles, source, _events) => {
            let artwork = decl(ctx, "icon", escapeInline(ctx, source));
            [widgetLine(ctx, plain(state), [artwork], styles, depth)]
        },
        // Two boxes and two style lists: `around` on the label, `styles` on the
        // control inside it.
        .Field(label, kind, hint, styles, around, value, _selection, _invalid, disabled, _events) => {
            [
                styledLine(ctx, plain(state), wrapper(around), depth),
                textLine(ctx, depth + 1, label.read(scope)),
            ].concat(
                ctx,
                fieldLines(
                    ctx,
                    refusing(state, disabled.read(scope)),
                    kind,
                    hint.read(scope),
                    styles,
                    value.get(scope),
                    depth + 1,
                ),
            )
        },
        // A slider is a `<label>` around its name and a range input. The input
        // carries `field:range` and `range:<min> <max> <value>` — the old
        // `FieldKind.Range`'s scene, so the painter draws the thumb unchanged —
        // and no run of text, because a browser draws a thumb and never a number.
        .Slider(label, value, min, max, _step, styles, around, disabled, _events) => {
            let painted = refusing(state, disabled.read(scope));
            let leading = [decl(ctx, "field", "range")].concat(
                ctx,
                sliderBounds(ctx, min, max, value.get(scope)),
            );
            [
                styledLine(ctx, plain(state), wrapper(around), depth),
                textLine(ctx, depth + 1, label.read(scope)),
                widgetLine(ctx, painted, leading, sliderTrack(styles), depth + 1),
            ]
        },
        // The box, its mark, and the text beside it. The mark is the widget's
        // own drawing: there is no child to supply one and no property that
        // names it.
        // The box answers for its own `:checked`, and the signal is the
        // answer — the same signal the mark is drawn from, so what a reader
        // sees and what the styles say cannot come apart.
        .Toggle(label, kind, styles, around, value, _invalid, disabled, _events) => {
            let on = value.get(scope);
            let painted = Painted {
                state: state,
                checked: .Some(on),
                disabled: disabled.read(scope),
            };
            [
                styledLine(ctx, plain(state), wrapper(around), depth),
                styledLine(ctx, painted, boxStyles(on, styles), depth + 1),
            ].concat(ctx, markLines(ctx, kind, on, depth + 2)).push(
                ctx,
                textLine(ctx, depth + 1, label.read(scope)),
            )
        },
        .Form(_onSubmit, styles, children, _events) => {
            container(ctx, state, styles, children, depth)
        },
        // A form's action is a button with its label drawn in it, which is a
        // childless button's own shape: the accessible name and the glyphs are
        // the same string. It answers for its own `disabled`, the way a field's
        // control does.
        .Submit(label, styles, disabled, _events) => {
            [
                styledLine(ctx, refusing(state, disabled.read(scope)), styles, depth),
                textLine(ctx, depth + 1, label.read(scope)),
            ]
        },
        .When(cond, then, otherwise) => {
            if (cond.read(scope)) {
                nodeLines(ctx, state, then, depth)
            } else {
                nodeLines(ctx, state, otherwise, depth)
            }
        },
        .Computed(build) => nodeLines(ctx, state, build(scope), depth),
        .Each(count, _keyAt, rowAt) => {
            rowLines(ctx, state, rowAt, count(scope), depth, 0, [])
        },
        // Shut, a browser draws none of it, so neither does this. Open, it is
        // the two things a browser draws: the scrim over the page, and the
        // panel centred on it.
        .Dialog(open, _label, styles, children, scrimStyles, _events) => {
            if (open.get(scope)) {
                container(ctx, state, scrimWith(scrimStyles), [], depth).concat(
                    ctx,
                    container(ctx, state, styles, children, depth + 1),
                )
            } else {
                []
            }
        },
        // The group is a box the caller styles; each option is a `<label>`
        // wrapping a radio box and its content node. The box answers for its own
        // `:checked` off the signal — the option whose key equals it — and a
        // checked one draws the dot the reset paints, in the box's own
        // foreground. `style` picks the shape and changes no line here.
        .Picker(_label, options, styles, value, _style, _disabled, _events) => {
            [styledLine(ctx, plain(state), styles, depth)].concat(
                ctx,
                pickerOptionLines(
                    ctx,
                    state,
                    options,
                    value.get(scope),
                    depth + 1,
                    0,
                    [],
                ),
            )
        },
        // A bar and whatever fills it. The role and the `aria-value*` are what a
        // reader is told, not what a painter draws, so the scene is the caller's
        // own boxes — the same picture the nested `stack`s painted before, now
        // announced. An indeterminate bar draws the same; the missing value is a
        // fact for a reader, not the painter.
        .Progress(_label, _value, styles, children, _events) => {
            container(ctx, state, styles, children, depth)
        },
        // The summary is always drawn; the children only when it is open. A
        // browser draws a shut `<details>` as its `<summary>` alone, so this
        // reads the signal and leaves the rest out when it is shut.
        .Disclosure(summary, open, styles, children, _events) => {
            let head = [
                styledLine(ctx, plain(state), styles, depth),
                styledLine(ctx, plain(state), [], depth + 1),
                textLine(ctx, depth + 2, summary.read(scope)),
            ];
            if (open.get(scope)) {
                head.concat(ctx, childLines(ctx, state, children, depth + 1, 0, []))
            } else {
                head
            }
        },
        // The renderer's own element, nameless here as every box is: `describe`
        // draws no program tree into one, so this arm exists for the match and
        // mirrors a stack's lines.
        .Raw(_name, styles, children) => container(ctx, state, styles, children, depth),
        // A fragment draws its children at the depth it sits, with no box of its
        // own — `describe` never builds one, so this is for the match.
        .Fragment(children) => childLines(ctx, state, children, depth, 0, []),
    }
}

/// Every option's lines, in order: a `<label>` wrapper, the radio box, its dot
/// when it is the checked one, and the caption beside it.
fn pickerOptionLines<C: Allocator>(
    ctx: C,
    state: State,
    options: [(Str, Node<C>)],
    selected: Str,
    depth: Int,
    at: Int,
    acc: [Str],
): [Str] {
    match (options.get(at)) {
        .None => acc,
        .Some(option) => {
            let key = option.0;
            let content = option.1;
            let on = key == selected;
            let painted = Painted { state: state, checked: .Some(on), disabled: false };
            let lines = [
                styledLine(ctx, plain(state), wrapper([]), depth),
                styledLine(ctx, painted, radioBox(), depth + 1),
            ].concat(ctx, dotLines(ctx, on, depth + 2)).concat(
                ctx,
                nodeLines(ctx, state, content, depth + 1),
            );
            pickerOptionLines(
                ctx,
                state,
                options,
                selected,
                depth,
                at + 1,
                acc.concat(ctx, lines),
            )
        },
    }
}

/// A radio's box: a circle one line square that does not shrink, centring the
/// dot the widget draws in it, and a hairline ring around that dot.
///
/// The sheet's reset says the same sizes and the `border-radius` to a browser,
/// because with the chrome cleared an unsized radio is a control nobody can see
/// or hit — the same bargain a checkbox's box makes. The ring is the widget's
/// own, in the group's `Foreground` the way the dot is: a checkbox's box comes
/// from the caller's `Background` and border, but a radio has no per-option
/// style list by design, so an unchecked option would otherwise draw nothing at
/// all and only the chosen one would be visible.
fn radioBox(): [Style] {
    [
        .Layout(.Row),
        .AlignMain(.Center),
        .AlignCross(.Center),
        .Width(.Rem(1.0)),
        .Height(.Rem(1.0)),
        .Shrink(0),
        .Radius(.Full),
        .BorderWidth(.Px(1)),
    ]
}

/// The dot a checked radio draws in its own box, as the line it contributes.
///
/// `mark:dot` is a scene-only declaration, as a toggle's `mark:tick` is: a disc
/// half the box across, centred, in the box's own foreground. An unchecked radio
/// draws none, the way an unchecked checkbox draws no tick.
fn dotLines<C: Allocator>(ctx: C, on: Bool, depth: Int): [Str] {
    if (on) {
        [elementLine(ctx, depth, [], ["mark:dot", "width:50%", "height:50%"])]
    } else {
        []
    }
}

/// The scrim an open dialog sits on: the `::backdrop` a browser paints, and
/// the arrangement that centres the panel on it.
///
/// The widget's own drawing rather than anything a program wrote, the way a
/// toggle's mark is — there is no property that names a backdrop. It is pinned
/// to the viewport and holds the panel as its one child, which is how the
/// painter centres what a browser centres with the automatic margins its own
/// stylesheet gives a `<dialog>`. The black at half strength is the same
/// colour the sheet writes for `::backdrop`, so the two renderers draw one
/// scrim.
fn scrim(): [Style] {
    [
        .Position(.PinViewport),
        .Pin(.Top, .Px(0)),
        .Pin(.Bottom, .Px(0)),
        .Pin(.Start, .Px(0)),
        .Pin(.End, .Px(0)),
        .Layout(.Row),
        .AlignMain(.Center),
        .AlignCross(.Center),
        .Background(.Rgba(0, 0, 0, 0.5)),
    ]
}

/// The `<label>` a field and a toggle are wrapped in: the arrangement the
/// runtime gives it, and then the caller's own.
///
/// The wrapper is the runtime's element rather than the program's, and the
/// sheet's reset lays it out as a wrapping row: the control and its text sit on
/// one line, and a control as wide as the line takes one of its own. That
/// arrangement is written here in the vocabulary rather than as declarations,
/// so `around` overrides it the way a later entry overrides an earlier one —
/// which is the same rule that lets a caller's `Layout` beat `row`'s.
fn wrapper(around: [Style]): [Style] {
    [.Layout(.Row), .Wrap(true), .AlignCross(.Center), .Group(around)]
}

/// A toggle's box: the arrangement that puts its mark where the mark goes, and
/// then the caller's own.
///
/// The box is a row that centres what is in it, one line tall and one line wide
/// until the caller says otherwise, and it does not shrink — an unstyled toggle
/// is still a box a reader can see and hit. `AlignMain` is where the mark sits:
/// the near end when the toggle is off and the far end when it is on, which is
/// what makes a switch's thumb travel.
fn boxStyles(on: Bool, styles: [Style]): [Style] {
    let placement: [Style] = if (on) {
        [.AlignMain(.End)]
    } else {
        [.AlignMain(.Start)]
    };
    [
        .Layout(.Row),
        .AlignCross(.Center),
        .Width(.Rem(1.0)),
        .Height(.Rem(1.0)),
        .Shrink(0),
        .Group(placement),
        .Group(styles),
    ]
}

/// The mark inside a toggle's box, as the line it contributes.
///
/// `mark:<shape>` is a scene-only declaration, as `field:` and `image:` are. It
/// says *what to draw in the element's own foreground*, because neither shape
/// is a box: a switch's thumb is a disc that travels, and a checkbox's tick is
/// a stroke this vocabulary has no property for. A switch always has its thumb;
/// a checkbox has its tick only when it is on.
fn markLines<C: Allocator>(ctx: C, kind: ToggleKind, on: Bool, depth: Int): [Str] {
    match (kind) {
        .Switch => {
            [
                elementLine(ctx, depth, [], [
                    "mark:thumb",
                    "height:100%",
                    "aspect-ratio:1",
                ]),
            ]
        },
        .Checkbox => {
            if (on) {
                [
                    elementLine(ctx, depth, [], [
                        "mark:tick",
                        "width:100%",
                        "height:100%",
                    ]),
                ]
            } else {
                []
            }
        },
    }
}

/// The lines an input contributes: its own, and the run of text it holds.
///
/// A field's input line, and the run of text it holds. Every text kind shows
/// what is in it, so the value is a `t` line under the input.
fn fieldLines<C: Allocator>(
    ctx: C,
    painted: Painted,
    kind: FieldKind,
    hint: Str,
    styles: [Style],
    value: Str,
    depth: Int,
): [Str] {
    [
        fieldLine(ctx, painted, kind, hint, styles, depth),
        textLine(ctx, depth + 1, value),
    ]
}

/// The `e` line an input contributes: what it accepts, then its styles.
///
/// `field:<kind>` is a scene-only declaration, as `image:` is. It is what the
/// markup spells as `type="password"` or as a `textarea`, and it is the whole
/// of what the painter has to tell one kind of input from another — a secret is
/// masked rather than shown, and only a `textarea` wraps. It comes first, so a
/// style still wins over it the way a later declaration wins over an earlier
/// one.
fn fieldLine<C: Allocator>(
    ctx: C,
    painted: Painted,
    kind: FieldKind,
    hint: Str,
    styles: [Style],
    depth: Int,
): Str {
    let accepts = decl(ctx, "field", kindName(kind));
    let leading = [accepts].concat(ctx, placeholder(ctx, hint));
    widgetLine(ctx, painted, leading, styles, depth)
}

/// The `placeholder:` declaration a hint carries, and nothing for a field that
/// has none.
///
/// It rides on the line whatever the value is, the way the attribute stays in
/// the markup whatever is typed: the painter draws it only while the run under
/// the input is empty, which is where "gone once there is a value" lives.
fn placeholder<C: Allocator>(ctx: C, hint: Str): [Str] {
    if (hint.isEmpty()) {
        []
    } else {
        [decl(ctx, "placeholder", escapeInline(ctx, hint))]
    }
}

/// What a `FieldKind` is called in a scene: the `type` the markup carries, and
/// `multiline` for the `textarea` that has none.
fn kindName(kind: FieldKind): Str {
    match (kind) {
        .Text => "text",
        .Multiline => "multiline",
        .Password => "password",
        .Email => "email",
        .Number => "number",
        .Search => "search",
    }
}

/// The `e` line one styled element contributes, with no children under it.
fn styledLine<C: Allocator>(
    ctx: C,
    painted: Painted,
    styles: [Style],
    depth: Int,
): Str {
    widgetLine(ctx, painted, [], styles, depth)
}

/// One `e` line: the classes the styles chose, then `leading` — the scene-only
/// declarations that say what this element *is* — then everything the styles
/// wrote out.
///
/// The scene-only declarations come first, so a style still wins over one the
/// way a later declaration wins over an earlier one.
fn widgetLine<C: Allocator>(
    ctx: C,
    painted: Painted,
    leading: [Str],
    styles: [Style],
    depth: Int,
): Str {
    str.format(ctx, "e ${depth} ${widgetBody(ctx, painted, leading, styles)}")
}

/// The declarations half of a widget's `e` line, without the depth: the classes,
/// then the scene-only declarations `leading` names, then the styles written
/// out. What `renderInto` hands the runtime for one element.
/// The style list flattened to the concrete declarations and extracted classes
/// an element carries, with every `Computed`/`When`/`On`/`At`/`Group` resolved
/// **once**. `classNames` and `inlineIn` then walk a list that holds no
/// computation, so a `Computed` style's body runs a single time per render
/// rather than once for the classes and once for the inline tier.
fn resolve(
    ctx: Scope,
    painted: Painted,
    styles: [Style],
    at: Int,
    acc: [Style],
): [Style] {
    match (styles.get(at)) {
        .None => acc,
        .Some(style) => {
            let more: [Style] = match (style) {
                .Group(inner) => resolve(ctx, painted, inner, 0, []),
                .On(on, inner) => {
                    if (applies(stateRank(on), painted)) {
                        resolve(ctx, painted, inner, 0, [])
                    } else {
                        []
                    }
                },
                .When(cond, then, otherwise) => {
                    if (cond.read(ctx)) {
                        resolve(ctx, painted, then, 0, [])
                    } else {
                        resolve(ctx, painted, otherwise, 0, [])
                    }
                },
                .Computed(build) => resolve(ctx, painted, build(ctx), 0, []),
                // A breakpoint lives in the stylesheet; both tiers here drop it.
                .At(_screen, _inner) => [],
                _ => [style],
            };
            resolve(ctx, painted, styles, at + 1, acc.concat(ctx, more))
        },
    }
}

fn widgetBody<C: Allocator>(
    ctx: C,
    painted: Painted,
    leading: [Str],
    styles: [Style],
): Str {
    let flat = resolve(rootScope(), painted, styles, 0, []);
    elementBody(
        ctx,
        classNames(ctx, painted, flat),
        leading
            .concat(ctx, answers(ctx, painted))
            .concat(ctx, inlineIn(ctx, painted, flat, 0, [])),
    )
}

/// `widgetBody`, read under a watcher's `scope` rather than the untracked root:
/// a reactive element's watcher computes its body this way so the styles it
/// reads subscribe it, and a write to one re-runs the watcher and patches the
/// body in place. A `Scope` is an allocator, so it builds the strings too.
fn widgetBodyUnder(ctx: Scope, painted: Painted, leading: [Str], styles: [Style]): Str {
    let flat = resolve(ctx, painted, styles, 0, []);
    elementBody(
        ctx,
        classNames(ctx, painted, flat),
        leading
            .concat(ctx, answers(ctx, painted))
            .concat(ctx, inlineIn(ctx, painted, flat, 0, [])),
    )
}

/// The states an element answers for itself, as the declarations its line
/// carries.
///
/// `checked:<true|false>` is a toggle's signal, and only a toggle writes one:
/// the answer is two-valued, so an element that holds one says which, and an
/// element that holds none leaves the snapshot's state to say. `disabled:true`
/// is a control whose flag is set, and there is no `disabled:false` because a
/// clear flag takes nothing away — `.Disabled` is still a fair question to ask
/// of every element.
fn answers<C: Allocator>(ctx: C, painted: Painted): [Str] {
    let checked = match (painted.checked) {
        .Some(on) => [decl(ctx, "checked", boolName(on))],
        .None => [],
    };
    if (painted.disabled) {
        checked.push(ctx, decl(ctx, "disabled", "true"))
    } else {
        checked
    }
}

fn boolName(value: Bool): Str {
    if (value) { "true" } else { "false" }
}

/// An `e` line for a box, then everything inside it one level deeper.
fn container<C: Allocator>(
    ctx: C,
    state: State,
    styles: [Style],
    children: [Node<C>],
    depth: Int,
): [Str] {
    boxed(ctx, plain(state), styles, children, depth)
}

/// The same, for a box that answers for a state of its own — a button holding
/// children, which still carries its own `disabled`.
fn boxed<C: Allocator>(
    ctx: C,
    painted: Painted,
    styles: [Style],
    children: [Node<C>],
    depth: Int,
): [Str] {
    let line = styledLine(ctx, painted, styles, depth);
    [line].concat(ctx, childLines(ctx, painted.state, children, depth + 1, 0, []))
}

/// Every child's lines, in order.
fn childLines<C: Allocator>(
    ctx: C,
    state: State,
    children: [Node<C>],
    depth: Int,
    at: Int,
    acc: [Str],
): [Str] {
    match (children.get(at)) {
        .None => acc,
        .Some(child) => {
            let lines = nodeLines(ctx, state, child, depth);
            childLines(ctx, state, children, depth, at + 1, acc.concat(ctx, lines))
        },
    }
}

/// One subtree per row, in index order.
///
/// The row closure is called directly. It takes its context as a parameter, so
/// there is nothing to capture and no computation to run it under.
fn rowLines<C: Allocator>(
    ctx: C,
    state: State,
    rowAt: fn(C, Scope, Int) => Node<C>,
    count: Int,
    depth: Int,
    at: Int,
    acc: [Str],
): [Str] {
    if (at >= count) {
        acc
    } else {
        let scope = rootScope();
        let lines = nodeLines(ctx, state, rowAt(ctx, scope, at), depth);
        rowLines(ctx, state, rowAt, count, depth, at + 1, acc.concat(ctx, lines))
    }
}

/// One `e` line: the depth, the classes the styles chose, and the declarations
/// they wrote out. The classes come first, as the pseudo-property `class`.
fn elementLine<C: Allocator>(
    ctx: C,
    depth: Int,
    classes: [Str],
    declarations: [Str],
): Str {
    str.format(ctx, "e ${depth} ${elementBody(ctx, classes, declarations)}")
}

/// The declarations half of an `e` line — the classes the styles chose, then
/// what they wrote out, joined — without the depth in front. `elementLine`
/// prepends the depth; `renderInto` hands this to the runtime and lets the
/// document count the depth off the nesting instead.
fn elementBody<C: Allocator>(ctx: C, classes: [Str], declarations: [Str]): Str {
    let all = if (classes.isEmpty()) {
        declarations
    } else {
        let named = classes.join(ctx, " ");
        [str.format(ctx, "class:${named}")].concat(ctx, declarations)
    };
    all.join(ctx, ";")
}

/// What a role adds to an element's own styles.
///
/// A `<table>`'s rows and cells arrange themselves in a browser, so a scene
/// that says nothing about them paints every cell on a line of its own. A row
/// is a grid of one equal column per cell, which is what makes the second row's
/// cells line up under the first's, and a header cell is bold and centred, which
/// is what every browser's own stylesheet does to a `<th>`. The caller's styles
/// come after, so a caller who sets their own still wins.
fn roleStyles<C: Allocator, N>(
    ctx: C,
    role: Role,
    styles: [Style],
    children: [Node<N>],
): [Style] {
    match (role) {
        .TableRow => {
            if (children.isEmpty()) {
                styles
            } else {
                [.Layout(.Grid(columns(ctx, children.length(), []))), .Group(styles)]
            }
        },
        .ColumnHeader => [.FontWeight(.Bold), .TextAlign(.Center), .Group(styles)],
        .RowHeader => [.FontWeight(.Bold), .TextAlign(.Center), .Group(styles)],
        _ => styles,
    }
}

/// `n` tracks that share the row evenly — a table row's cells.
fn columns<C: Allocator>(ctx: C, n: Int, acc: [Track]): [Track] {
    if (acc.length() >= n) {
        acc
    } else {
        let track: Track = .Fraction(1);
        columns(ctx, n, acc.push(ctx, track))
    }
}

/// A declaration's value, with the two characters the scene format reserves
/// escaped: the backslash, and the semicolon that ends a declaration. An image
/// source is a data URI and a data URI is full of both.
fn escapeValue<C: Allocator>(ctx: C, value: Str): Str {
    value.replace(ctx, "\\", "\\\\").replace(ctx, ";", "\\;")
}

/// A declaration value that has to stay on one line: the two characters the
/// format reserves escaped, and every line break a space.
///
/// A declaration is one line, and neither value that needs this loses anything
/// by it — the whitespace between two tags of an icon's artwork and the
/// whitespace inside a path are the same whitespace either way, and HTML says
/// a `placeholder` holds no line break at all.
fn escapeInline<C: Allocator>(ctx: C, value: Str): Str {
    escapeValue(ctx, value).replace(ctx, "\n", " ").replace(ctx, "\r", " ")
}

/// One `t` line. A backslash, a newline and a carriage return are the three
/// characters the format escapes, and there is no fourth.
fn textLine<C: Allocator>(ctx: C, depth: Int, content: Str): Str {
    let body = content
        .replace(ctx, "\\", "\\\\")
        .replace(ctx, "\n", "\\n")
        .replace(ctx, "\r", "\\r");
    str.format(ctx, "t ${depth} ${body}")
}

// --- Styles, lowered ---------------------------------------------------------
//
// Two walks over the same list. One collects the classes the compiler already
// extracted; the other writes out everything it could not. Both expand `Group`,
// `When` and `Computed`, both take an `On` only when it applies to the element
// being written, and both skip an `At` — a breakpoint lives in the stylesheet.

/// Which states one element is in, which is not the same question for all six.
///
/// `Hover`, `Focus`, `FocusWithin` and `Active` are things a pointer or a
/// keyboard does, and there is nothing in a tree to read them off: the snapshot
/// names one for the whole page, and that is a fair way to ask what a page
/// looks like while something on it is hovered.
///
/// The other two are the tree's own. `checked` is a toggle's signal, and a
/// toggle *is* checked or is not — a snapshot cannot add to that, so a toggle
/// answers for itself and `.None` is an element that holds no such answer, for
/// which the snapshot still decides. `disabled` is a control's flag, and it
/// only ever adds: a control whose flag is set is unavailable in every
/// snapshot, and one whose flag is clear is still worth asking `.Disabled` of.
struct Painted {
    state: State,
    checked: Option<Bool>,
    disabled: Bool,
}

/// An element that answers for none of it: everything but a widget.
fn plain(state: State): Painted {
    Painted { state: state, checked: .None, disabled: false }
}

/// A control that answers for its own `disabled` and for nothing else — a
/// button and a field.
fn refusing(state: State, disabled: Bool): Painted {
    Painted { state: state, checked: .None, disabled: disabled }
}

/// Whether a style scoped to `scoped` — a `State`'s rank, or `-1` for a style
/// that applies whatever the state is — reaches this element.
fn applies(scoped: Int, painted: Painted): Bool {
    let named = stateRank(painted.state);
    if (scoped < 0) {
        true
    } else if (scoped == stateRank(.Checked)) {
        match (painted.checked) {
            .Some(on) => on,
            .None => named == scoped,
        }
    } else if (scoped == stateRank(.Disabled)) {
        painted.disabled || named == scoped
    } else {
        scoped == named
    }
}

/// The class each conflict slot ended up with. Last slot wins, which is the
/// scan the runtime makes over the same pairs.
fn classNames<C: Allocator>(ctx: C, painted: Painted, styles: [Style]): [Str] {
    lastPerSlot(ctx, slotsIn(ctx, painted, styles, 0, []), 0, [])
}

/// Every `(slot, class)` pair the list contributes, in order.
fn slotsIn<C: Allocator>(
    ctx: C,
    painted: Painted,
    styles: [Style],
    at: Int,
    acc: [(Int, Str)],
): [(Int, Str)] {
    let scope = rootScope();
    match (styles.get(at)) {
        .None => acc,
        .Some(style) => {
            let more = match (style) {
                .Extracted(classes) => statePairs(ctx, painted, classes.pairs(), 0, []),
                .Group(inner) => slotsIn(ctx, painted, inner, 0, []),
                .On(on, inner) => {
                    if (applies(stateRank(on), painted)) {
                        slotsIn(ctx, painted, inner, 0, [])
                    } else {
                        []
                    }
                },
                .When(cond, then, otherwise) => {
                    if (cond.read(scope)) {
                        slotsIn(ctx, painted, then, 0, [])
                    } else {
                        slotsIn(ctx, painted, otherwise, 0, [])
                    }
                },
                .Computed(build) => slotsIn(ctx, painted, build(scope), 0, []),
                _ => [],
            };
            slotsIn(ctx, painted, styles, at + 1, acc.concat(ctx, more))
        },
    }
}

/// The pairs of an extracted style that apply in `state`.
///
/// **This is where a pseudo-class is read back.** The compiler folds an
/// `On(s, ...)` into the classes it emits, so the group itself is gone by the
/// time this walk sees one; what is left is the conflict slot, which carries
/// the condition the class was scoped to. A slot's low digits are that
/// condition — forty of them per property, five breakpoints to a state,
/// and zero for "in every state" — so a hover class can be told from a plain
/// one and left out of every document but the hovered one.
fn statePairs<C: Allocator>(
    ctx: C,
    painted: Painted,
    pairs: [(Int, Str)],
    at: Int,
    acc: [(Int, Str)],
): [(Int, Str)] {
    match (pairs.get(at)) {
        .None => acc,
        .Some(pair) => {
            let (slot, _name) = pair;
            let next = if (applies(slotState(slot), painted)) {
                acc.push(ctx, pair)
            } else {
                acc
            };
            statePairs(ctx, painted, pairs, at + 1, next)
        },
    }
}

/// The state a conflict slot is scoped to, as a `State`'s rank, and `-1` for a
/// slot that applies whatever the state is. A breakpoint is the other half of
/// the condition and is not a state, so it answers `-1` too.
///
/// Forty is `semantics::styles`'s `CONDITIONS`, and the two move together:
/// eight states counting "none", by five breakpoints counting "none".
fn slotState(slot: Int): Int {
    slot % 40 / 5 - 1
}

/// The class of each slot's last pair.
fn lastPerSlot<C: Allocator>(ctx: C, pairs: [(Int, Str)], at: Int, acc: [Str]): [Str] {
    match (pairs.get(at)) {
        .None => acc,
        .Some(pair) => {
            let (slot, name) = pair;
            let next = if (slotAgain(pairs, at + 1, slot)) {
                acc
            } else {
                acc.push(ctx, name)
            };
            lastPerSlot(ctx, pairs, at + 1, next)
        },
    }
}

/// Whether any pair from `at` onwards names `slot`.
fn slotAgain(pairs: [(Int, Str)], at: Int, slot: Int): Bool {
    match (pairs.get(at)) {
        .None => false,
        .Some(pair) => {
            let (other, _name) = pair;
            if (other == slot) { true } else { slotAgain(pairs, at + 1, slot) }
        },
    }
}

/// Every inline declaration the list writes out, in order. A later declaration
/// of the same property wins, which is what the painter does with them.
fn inlineIn<C: Allocator>(
    ctx: C,
    painted: Painted,
    styles: [Style],
    at: Int,
    acc: [Str],
): [Str] {
    let scope = rootScope();
    match (styles.get(at)) {
        .None => acc,
        .Some(style) => {
            let more = match (style) {
                .Group(inner) => inlineIn(ctx, painted, inner, 0, []),
                .On(on, inner) => {
                    if (applies(stateRank(on), painted)) {
                        inlineIn(ctx, painted, inner, 0, [])
                    } else {
                        []
                    }
                },
                .At(_screen, _inner) => [],
                .When(cond, then, otherwise) => {
                    if (cond.read(scope)) {
                        inlineIn(ctx, painted, then, 0, [])
                    } else {
                        inlineIn(ctx, painted, otherwise, 0, [])
                    }
                },
                .Computed(build) => inlineIn(ctx, painted, build(scope), 0, []),
                .Extracted(_classes) => [],
                _ => declare(ctx, style),
            };
            inlineIn(ctx, painted, styles, at + 1, acc.concat(ctx, more))
        },
    }
}

/// One property, as the declarations it lowers to.
///
/// The same CSS `semantics::styles` writes into the stylesheet, so a style that
/// folded and one that did not paint the same.
fn declare<C: Allocator>(ctx: C, style: Style): [Str] {
    match (style) {
        .Layout(layout) => layoutCss(ctx, layout),
        .AlignMain(align) => [decl(ctx, "justify-content", alignCss(align))],
        .AlignCross(align) => [decl(ctx, "align-items", alignCss(align))],
        .AlignSelf(align) => [decl(ctx, "align-self", alignCss(align))],
        .Wrap(on) => {
            let css = if (on) { "wrap" } else { "nowrap" };
            [decl(ctx, "flex-wrap", css)]
        },
        .Scroll(axis) => {
            match (axis) {
                .X => [decl(ctx, "overflow-x", "auto")],
                .Y => [decl(ctx, "overflow-y", "auto")],
                .Both => [decl(ctx, "overflow", "auto")],
            }
        },
        .Grow(n) => [decl(ctx, "flex-grow", str.fromInt(ctx, n))],
        .Shrink(n) => [decl(ctx, "flex-shrink", str.fromInt(ctx, n))],
        .Span(n) => [decl(ctx, "grid-column", str.format(ctx, "span ${n}"))],
        // A pin takes the child out of the flow, so it carries its own
        // position.
        .Pin(edge, length) => {
            [
                decl(ctx, "position", "absolute"),
                decl(ctx, "inset-".concat(ctx, edgeName(edge)), lengthCss(ctx, length)),
            ]
        },
        .Position(position) => {
            match (position) {
                .Flow => [decl(ctx, "position", "relative")],
                .Sticky => [decl(ctx, "position", "sticky")],
                .PinViewport => [decl(ctx, "position", "fixed")],
                .PinAnchor => {
                    [
                        decl(ctx, "position", "fixed"),
                        decl(ctx, "--buri-pin-anchor", "1"),
                    ]
                },
            }
        },
        .Gap(length) => [decl(ctx, "gap", lengthCss(ctx, length))],
        .GapX(length) => [decl(ctx, "column-gap", lengthCss(ctx, length))],
        .GapY(length) => [decl(ctx, "row-gap", lengthCss(ctx, length))],
        .Padding(length) => [decl(ctx, "padding", lengthCss(ctx, length))],
        .PaddingX(length) => [decl(ctx, "padding-inline", lengthCss(ctx, length))],
        .PaddingY(length) => [decl(ctx, "padding-block", lengthCss(ctx, length))],
        .PaddingEdge(edge, length) => {
            [decl(ctx, "padding-".concat(ctx, edgeName(edge)), lengthCss(ctx, length))]
        },
        .Width(length) => [decl(ctx, "width", lengthCss(ctx, length))],
        .Height(length) => [decl(ctx, "height", lengthCss(ctx, length))],
        .MinWidth(length) => [decl(ctx, "min-width", lengthCss(ctx, length))],
        .MaxWidth(length) => [decl(ctx, "max-width", lengthCss(ctx, length))],
        .MinHeight(length) => [decl(ctx, "min-height", lengthCss(ctx, length))],
        .MaxHeight(length) => [decl(ctx, "max-height", lengthCss(ctx, length))],
        .AspectRatio(ratio) => [decl(ctx, "aspect-ratio", str.fromFloat(ctx, ratio))],
        .Background(color) => [decl(ctx, "background-color", colorCss(ctx, color))],
        .Foreground(color) => [decl(ctx, "color", colorCss(ctx, color))],
        // A width on its own draws a solid border. `BorderStyle` comes after it
        // and overrides that.
        .BorderWidth(length) => {
            [
                decl(ctx, "border-style", "solid"),
                decl(ctx, "border-width", lengthCss(ctx, length)),
            ]
        },
        // One edge, drawing the same solid a whole-box width implies.
        // `BorderColor` stays whole-box.
        .BorderEdge(edge, length) => {
            let side = "border-".concat(ctx, edgeName(edge));
            [
                decl(ctx, side.concat(ctx, "-style"), "solid"),
                decl(ctx, side.concat(ctx, "-width"), lengthCss(ctx, length)),
            ]
        },
        .BorderColor(color) => [decl(ctx, "border-color", colorCss(ctx, color))],
        .BorderStyle(border) => [decl(ctx, "border-style", borderStyleName(border))],
        .Radius(length) => [decl(ctx, "border-radius", lengthCss(ctx, length))],
        .RadiusCorner(corner, length) => {
            let name = str.format(ctx, "border-${cornerName(corner)}-radius");
            [decl(ctx, name, lengthCss(ctx, length))]
        },
        .Opacity(amount) => [decl(ctx, "opacity", str.fromFloat(ctx, amount))],
        .Shadow(shadow) => [decl(ctx, "box-shadow", shadowCss(ctx, shadow))],
        .Shadows(shadows) => {
            [decl(ctx, "box-shadow", shadowList(ctx, shadows, 0, []).join(ctx, ","))]
        },
        .FontFamily(family) => [decl(ctx, "font-family", fontStack(ctx, family))],
        .FontSize(length) => [decl(ctx, "font-size", lengthCss(ctx, length))],
        .FontWeight(weight) => [decl(ctx, "font-weight", weightName(weight))],
        .Italic(on) => {
            let css = if (on) { "italic" } else { "normal" };
            [decl(ctx, "font-style", css)]
        },
        .LineHeight(amount) => [decl(ctx, "line-height", str.fromFloat(ctx, amount))],
        .LetterSpacing(length) => [decl(ctx, "letter-spacing", lengthCss(ctx, length))],
        .TextAlign(align) => [decl(ctx, "text-align", textAlignCss(align))],
        .TextCase(casing) => [decl(ctx, "text-transform", textCaseName(casing))],
        .TextLine(line) => [decl(ctx, "text-decoration-line", textLineName(line))],
        .TextWrap(wrapping) => [decl(ctx, "text-wrap", textWrapName(wrapping))],
        .Truncate(lines) => truncateCss(ctx, lines),
        .Cursor(cursor) => [decl(ctx, "cursor", cursorName(cursor))],
        .ListMarker(marker) => [decl(ctx, "list-style-type", markerName(marker))],
        .Bleed(edge, length) => {
            [decl(ctx, "margin-".concat(ctx, edgeName(edge)), outwardsCss(ctx, length))]
        },
        .Translate(x, y) => {
            let across = lengthCss(ctx, x);
            let down = lengthCss(ctx, y);
            [decl(ctx, "transform", str.format(ctx, "translate(${across},${down})"))]
        },
        // `clip` rather than `hidden`: both stop the paint, and only `hidden`
        // also makes a scroll container a keyboard can land in.
        .Clip(on) => {
            let css = if (on) { "clip" } else { "visible" };
            [decl(ctx, "overflow", css)]
        },
        .Passthrough(on) => {
            let css = if (on) { "none" } else { "auto" };
            [decl(ctx, "pointer-events", css)]
        },
        // Only what is painted behind the box is blurred; the box paints over
        // the blur.
        .BackdropBlur(length) => {
            let css = str.format(ctx, "blur(${lengthCss(ctx, length)})");
            [decl(ctx, "backdrop-filter", css)]
        },
        // The caret on its own, so a field with transparent text still has a
        // visible one. `Foreground` is otherwise the only thing that reaches it.
        .CaretColor(color) => [decl(ctx, "caret-color", colorCss(ctx, color))],
        _ => [],
    }
}

/// One `name:value` pair.
fn decl<C: Allocator>(ctx: C, name: Str, value: Str): Str {
    str.format(ctx, "${name}:${value}")
}

fn layoutCss<C: Allocator>(ctx: C, layout: Layout): [Str] {
    match (layout) {
        .Column => ["display:flex", "flex-direction:column"],
        .Row => ["display:flex", "flex-direction:row"],
        .ColumnReverse => ["display:flex", "flex-direction:column-reverse"],
        .RowReverse => ["display:flex", "flex-direction:row-reverse"],
        .Grid(tracks) => {
            let columns = trackList(ctx, tracks, 0, []).join(ctx, " ");
            ["display:grid", decl(ctx, "grid-template-columns", columns)]
        },
        // The children's half of `Layers` — every child in one cell — is a rule
        // about descendants, which an element's own declarations cannot say.
        .Layers => ["display:grid"],
    }
}

fn trackList<C: Allocator>(ctx: C, tracks: [Track], at: Int, acc: [Str]): [Str] {
    match (tracks.get(at)) {
        .None => acc,
        .Some(track) => {
            trackList(ctx, tracks, at + 1, acc.push(ctx, trackCss(ctx, track)))
        },
    }
}

fn trackCss<C: Allocator>(ctx: C, track: Track): Str {
    match (track) {
        .Fraction(n) => str.format(ctx, "${n}fr"),
        .Fixed(length) => lengthCss(ctx, length),
        .Auto => "auto",
    }
}

fn lengthCss<C: Allocator>(ctx: C, length: Length): Str {
    match (length) {
        .Px(n) => str.format(ctx, "${n}px"),
        .Rem(n) => str.format(ctx, "${n}rem"),
        .Em(n) => str.format(ctx, "${n}em"),
        .Percent(n) => str.format(ctx, "${n}%"),
        .Auto => "auto",
        .Full => "100%",
    }
}

/// A bleed's length, as the margin it writes.
///
/// A bleed is a distance outwards, so the margin is its negation. A negative
/// distance and `.Auto` — which is no distance at all — bleed nothing: inward
/// is the space between things, and that belongs to the container.
fn outwardsCss<C: Allocator>(ctx: C, length: Length): Str {
    match (length) {
        .Px(n) => if (n > 0) { str.format(ctx, "-${n}px") } else { "0px" },
        .Rem(n) => if (n > 0.0) { str.format(ctx, "-${n}rem") } else { "0px" },
        .Em(n) => if (n > 0.0) { str.format(ctx, "-${n}em") } else { "0px" },
        .Percent(n) => if (n > 0.0) { str.format(ctx, "-${n}%") } else { "0px" },
        .Auto => "0px",
        .Full => "-100%",
    }
}

/// A colour, as CSS.
///
/// A token stays a `var()`, exactly as the stylesheet writes it: a theme says
/// what it is worth, and a theme is installed at mount.
fn colorCss<C: Allocator>(ctx: C, color: Color): Str {
    match (color) {
        .Rgb(r, g, b) => str.format(ctx, "rgb(${r},${g},${b})"),
        .Rgba(r, g, b, a) => str.format(ctx, "rgba(${r},${g},${b},${a})"),
        .Token(reference) => {
            let space = reference.namespace();
            let name = reference.name();
            str.format(ctx, "var(--${space}-${name})")
        },
        .Transparent => "transparent",
        .Inherit => "inherit",
        // The token stays a token, so a theme decides the hue and this decides
        // only how much of it there is.
        .Faded(reference, a) => {
            let space = reference.namespace();
            let name = reference.name();
            let percent = cssNumber(ctx, a * 100.0);
            str.format(
                ctx,
                "color-mix(in srgb,var(--${space}-${name}) ${percent}%,transparent)",
            )
        },
    }
}

/// A number the way CSS writes one: `50`, not the `50.0` a `Float` shows as.
///
/// A `Float`'s own rendering always carries a point so `1.0` cannot read as an
/// integer, and the DOM renderer's does not — so a percentage would come out
/// of the two halves as two different declarations. Stripping the trailing
/// `.0` is exactly the inverse of what the float printer adds.
fn cssNumber<C: Allocator>(ctx: C, value: Float): Str {
    let shown = str.fromFloat(ctx, value);
    match (shown.stripSuffix(".0")) {
        .Some(trimmed) => trimmed,
        .None => shown,
    }
}

/// Every layer of a `Shadows`, in the order they were written.
fn shadowList<C: Allocator>(ctx: C, shadows: [Shadow], at: Int, acc: [Str]): [Str] {
    match (shadows.get(at)) {
        .None => acc,
        .Some(shadow) => {
            shadowList(ctx, shadows, at + 1, acc.push(ctx, shadowCss(ctx, shadow)))
        },
    }
}

fn shadowCss<C: Allocator>(ctx: C, shadow: Shadow): Str {
    let x = lengthCss(ctx, shadow.x);
    let y = lengthCss(ctx, shadow.y);
    let blur = lengthCss(ctx, shadow.blur);
    let spread = lengthCss(ctx, shadow.spread);
    let color = colorCss(ctx, shadow.color);
    str.format(ctx, "${x} ${y} ${blur} ${spread} ${color}")
}

fn fontStack<C: Allocator>(ctx: C, family: FontFamily): Str {
    match (family) {
        .Sans => "ui-sans-serif,system-ui,sans-serif",
        .Serif => "ui-serif,Georgia,serif",
        .Mono => "ui-monospace,SFMono-Regular,monospace",
        .Named(name) => str.format(ctx, "\"${name}\",ui-sans-serif,sans-serif"),
    }
}

fn truncateCss<C: Allocator>(ctx: C, lines: Int): [Str] {
    if (lines > 0) {
        [
            "display:-webkit-box",
            "-webkit-box-orient:vertical",
            decl(ctx, "-webkit-line-clamp", str.fromInt(ctx, lines)),
            "overflow:hidden",
        ]
    } else {
        ["-webkit-line-clamp:none", "overflow:visible"]
    }
}

fn alignCss(align: Align): Str {
    match (align) {
        .Start => "flex-start",
        .Center => "center",
        .End => "flex-end",
        .Stretch => "stretch",
        .SpaceBetween => "space-between",
        .SpaceAround => "space-around",
        .SpaceEvenly => "space-evenly",
    }
}

/// Text has no leftover room to distribute, so every distribution means
/// justified.
fn textAlignCss(align: Align): Str {
    match (align) {
        .Start => "start",
        .Center => "center",
        .End => "end",
        _ => "justify",
    }
}

/// Logical edges, so a right-to-left page is right by construction.
fn edgeName(edge: Edge): Str {
    match (edge) {
        .Top => "block-start",
        .Bottom => "block-end",
        .Start => "inline-start",
        .End => "inline-end",
    }
}

/// CSS names a corner by the two logical edges that meet at it, block first,
/// which is the order `Corner` declares them in.
fn cornerName(corner: Corner): Str {
    match (corner) {
        .TopStart => "start-start",
        .TopEnd => "start-end",
        .BottomStart => "end-start",
        .BottomEnd => "end-end",
    }
}

fn borderStyleName(border: BorderStyle): Str {
    match (border) {
        .None => "none",
        .Solid => "solid",
        .Dashed => "dashed",
    }
}

fn weightName(weight: Weight): Str {
    match (weight) {
        .Regular => "400",
        .Medium => "500",
        .Semibold => "600",
        .Bold => "700",
    }
}

fn textCaseName(casing: TextCase): Str {
    match (casing) {
        .AsWritten => "none",
        .Upper => "uppercase",
        .Lower => "lowercase",
        .Capitalize => "capitalize",
    }
}

fn textLineName(line: TextLine): Str {
    match (line) {
        .None => "none",
        .Underline => "underline",
        .Strike => "line-through",
    }
}

fn textWrapName(wrapping: TextWrap): Str {
    match (wrapping) {
        .Wrap => "wrap",
        .NoWrap => "nowrap",
        .Balance => "balance",
    }
}

fn cursorName(cursor: Cursor): Str {
    match (cursor) {
        .Default => "default",
        .Pointer => "pointer",
        .Text => "text",
        .NotAllowed => "not-allowed",
    }
}

fn markerName(marker: ListMarker): Str {
    match (marker) {
        .None => "none",
        .Disc => "disc",
        .Decimal => "decimal",
    }
}

/// A state's position in `State`, so two of them compare without an `Equal` the
/// vocabulary does not derive.
fn stateRank(state: State): Int {
    match (state) {
        .Hover => 0,
        .Focus => 1,
        .FocusWithin => 2,
        .Active => 3,
        .Disabled => 4,
        .Checked => 5,
        .Invalid => 6,
    }
}
