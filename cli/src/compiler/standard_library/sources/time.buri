//! core/time — the clock, and the lengths it measures.
//!
//! An `Instant` is a *point*: it means nothing on its own, and only a clock can
//! produce one. A `Duration` is a *length*: pure arithmetic, no clock involved,
//! the same length wherever it is read. Subtracting two points gives a length;
//! adding a length to a point gives a point; adding two points gives nothing,
//! and the type system says so.
//!
//! **`Duration` lives here rather than in `core/date`**, because a method may
//! only be declared in its receiver's defining module (SPEC 6.7.3) and
//! `instant.plus(d)` has to be writable. `core/date` re-exports the name, so
//! `from "core/date" import { Duration }` still resolves to this type.
//!
//! **A `Duration` counts nanoseconds and an `Instant` counts milliseconds.** A
//! timeout, a measurement and a budget are routinely finer than a millisecond,
//! while the clock this module reads reports whole milliseconds. So
//! `instant.plus(d)` moves by `d.millis()`, and a length finer than a
//! millisecond moves an instant by nothing.
//!
//! **Every arithmetic operation saturates.** Overflow is undefined behaviour
//! (SPEC 6.2), and a deadline is exactly where a program cannot afford it.
//! `hours(1_000_000_000)` is the largest `Duration` rather than a wrapped
//! negative one, and a deadline that saturates is a deadline that has not
//! passed.
//!
//! ```buri run
//! from "core/effect" import { Alloc, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/time" import * as time;
//! from "core/time" import { Instant };
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let started = Instant(1_000);
//!     let deadline = started.plus(time.seconds(30));
//!     // Two minutes later, a thirty-second deadline is behind us.
//!     let later = started.plus(time.minutes(2));
//!     let waited = later.duration(started);
//!     let _ = io
//!         .println(ctx, "${waited.show(ctx)} later, passed: ${later.hasPassed(deadline)}")
//!         .ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 120s later, passed: true
//! ```

from "core/effect" import { Alloc, Clock };
from "core/order" import { Eq, Ord, Show };
from "core/str" import * as str;

derive Eq, Ord, Show for Instant;
/// A point in time, in milliseconds. A distinct type rather than an `I64`, so
/// an instant cannot be added to a count by accident.
export struct Instant(export I64);

derive Eq, Ord, Hash for Duration;
/// A length of time, in nanoseconds, positive or negative.
///
/// The field is exported, so `Duration(2_500)` is 2500 nanoseconds. The
/// constructors below name their unit instead.
export struct Duration(export I64);

derive Eq, Ord, Show for Monotonic;
/// A reading off a clock that only goes forward, in nanoseconds.
///
/// **The number means nothing on its own.** Its zero is wherever the platform
/// put it — this process starting, this machine starting — so the only thing to
/// do with one is subtract another from it. That is why this is its own type and
/// not an `Instant`: an `Instant` names a moment everyone agrees on, and this
/// names nothing.
///
/// It is what an elapsed measurement wants. `Instant` is wall time: NTP steps
/// it, sometimes backwards, and it counts whole milliseconds, so a measurement
/// taken from two `Instant`s can come out negative or zero for work that really
/// happened.
export struct Monotonic(export I64);

/// The length of no time at all, which is what an accumulator starts at.
export let ZERO: Duration = Duration(0);

export let NANOS_PER_MICROSECOND: Int = 1_000;

export let NANOS_PER_MILLISECOND: Int = 1_000_000;

export let NANOS_PER_SECOND: Int = 1_000_000_000;

export let NANOS_PER_MINUTE: Int = 60_000_000_000;

export let NANOS_PER_HOUR: Int = 3_600_000_000_000;

export let NANOS_PER_DAY: Int = 86_400_000_000_000;

// -----------------------------------------------------------------------------
// Building a length
// -----------------------------------------------------------------------------
//
// Free functions, because there is no receiver: `time.seconds(30)` builds one
// and `d.seconds()` further down reads one back.
//
// Each one saturates, so a count no `Duration` can hold becomes the largest one
// there is rather than a wrapped negative.

export fn nanos(n: Int): Duration {
    Duration(n)
}

export fn micros(n: Int): Duration {
    Duration(n.saturatingMul(NANOS_PER_MICROSECOND))
}

export fn millis(n: Int): Duration {
    Duration(n.saturatingMul(NANOS_PER_MILLISECOND))
}

export fn seconds(n: Int): Duration {
    Duration(n.saturatingMul(NANOS_PER_SECOND))
}

export fn minutes(n: Int): Duration {
    Duration(n.saturatingMul(NANOS_PER_MINUTE))
}

export fn hours(n: Int): Duration {
    Duration(n.saturatingMul(NANOS_PER_HOUR))
}

/// A length from a fractional count of seconds: `secondsFloat(0.25)` is 250
/// milliseconds.
///
/// Truncates toward zero at the nanosecond, and saturates at the ends the way
/// every constructor here does. A NaN is no length at all, which is the only
/// answer that is not a lie.
export fn secondsFloat(seconds: Float): Duration {
    let nanos = seconds * 1_000_000_000.0;
    // The in-range test comes first, and the last arm is the one nothing else
    // caught. A NaN is not less than and not greater than anything, so it lands
    // there whatever the comparison does with it — and never reaches the
    // conversion, which has no answer for it.
    if (nanos > -9_223_372_036_854_775_807.0 - 1.0 && nanos < 9_223_372_036_854_775_807.0) {
        Duration(nanos.wrapToI64())
    } else if (nanos > 0.0) {
        Duration(9_223_372_036_854_775_807)
    } else if (nanos < 0.0) {
        Duration(-9_223_372_036_854_775_807 - 1)
    } else {
        ZERO
    }
}

// -----------------------------------------------------------------------------
// Reading and combining one
// -----------------------------------------------------------------------------

impl Duration {
    export fn nanos(self): Int {
        self.0
    }

    /// Truncates towards zero, as every getter below does: `millis` of 1,999,999
    /// nanoseconds is 1, not 2. Nothing here rounds.
    export fn micros(self): Int {
        self.0 / NANOS_PER_MICROSECOND
    }

    export fn millis(self): Int {
        self.0 / NANOS_PER_MILLISECOND
    }

    export fn seconds(self): Int {
        self.0 / NANOS_PER_SECOND
    }

    export fn minutes(self): Int {
        self.0 / NANOS_PER_MINUTE
    }

    export fn hours(self): Int {
        self.0 / NANOS_PER_HOUR
    }

    export fn days(self): Int {
        self.0 / NANOS_PER_DAY
    }

    export fn isZero(self): Bool {
        self.0 == 0
    }

    export fn isNegative(self): Bool {
        self.0 < 0
    }

    export fn add(self, other: Duration): Duration {
        Duration(self.0.saturatingAdd(other.0))
    }

    export fn sub(self, other: Duration): Duration {
        Duration(self.0.saturatingSub(other.0))
    }

    /// Scales a length by a count. `factor` is an `Int` and not a `Duration`,
    /// because a length times a length is not a length.
    export fn mul(self, factor: Int): Duration {
        Duration(self.0.saturatingMul(factor))
    }

    /// `mul`'s inverse: the length split into `divisor` equal parts, truncated
    /// toward zero. A zero divisor aborts, exactly as `/` does (SPEC 6.2).
    export fn divide(self, divisor: Int): Duration {
        Duration(self.0 / divisor)
    }

    /// The length as a fractional count of seconds — `secondsFloat`'s inverse.
    /// Past about 104 days a `Duration` has more nanoseconds than a `Float` has
    /// digits, and the last of them go.
    export fn asSecondsFloat(self): Float {
        self.0.toF64() / NANOS_PER_SECOND.toF64()
    }

    /// How many times `other` goes into this length. A length over a length is a
    /// number and not a length, which is why this answers a `Float`.
    ///
    /// Dividing by no time at all gives an infinity, or a NaN when both are
    /// zero. That is what float division does and it is the honest answer:
    /// nothing goes into nothing a definite number of times.
    export fn ratio(self, other: Duration): Float {
        self.0.toF64() / other.0.toF64()
    }

    /// The same length the other way round. The most negative `Duration`
    /// negates to the most positive one rather than to itself, which is the one
    /// place saturating and wrapping differ by more than a bound.
    export fn negate(self): Duration {
        let zero: Int = 0;
        Duration(zero.saturatingSub(self.0))
    }

    export fn abs(self): Duration {
        if (self.0 < 0) { self.negate() } else { self }
    }
}

// -----------------------------------------------------------------------------
// Rendering
// -----------------------------------------------------------------------------

// `1.5s`, `300ms`, `750us`, `1ns`, `0s`.
//
// The largest of `s`, `ms`, `us` and `ns` the length reaches, with the exact
// fraction and no trailing zeros. No `m` or `h`: a fraction of an hour is not a
// decimal, so those would have to round. Every unit here is a power of ten apart
// from the next, so every `Duration` prints exactly.
//
// ASCII throughout: `us` rather than the micro sign, because this goes into
// logs, file names and terminals that are not all UTF-8.
impl Show for Duration {
    fn show<C: Alloc>(self, ctx: C): Str {
        let sign = if (self.0 < 0) { "-" } else { "" };
        let magnitude = self.abs().0;
        if (magnitude >= NANOS_PER_SECOND) {
            scaled(ctx, sign, magnitude, NANOS_PER_SECOND, 9, "s")
        } else if (magnitude >= NANOS_PER_MILLISECOND) {
            scaled(ctx, sign, magnitude, NANOS_PER_MILLISECOND, 6, "ms")
        } else if (magnitude >= NANOS_PER_MICROSECOND) {
            scaled(ctx, sign, magnitude, NANOS_PER_MICROSECOND, 3, "us")
        } else if (magnitude > 0) {
            str.format(ctx, "${sign}${magnitude}ns")
        } else {
            "0s"
        }
    }
}

/// `magnitude` in a unit that is `unit` nanoseconds and `places` decimal digits
/// wide, with the fraction written out and its trailing zeros dropped.
fn scaled<C: Alloc>(
    ctx: C,
    sign: Str,
    magnitude: Int,
    unit: Int,
    places: Int,
    suffix: Str,
): Str {
    let whole = magnitude / unit;
    let rest = magnitude % unit;
    if (rest == 0) {
        str.format(ctx, "${sign}${whole}${suffix}")
    } else {
        let fraction = withoutTrailingZeros(
            str.fromInt(ctx, rest).padStart(ctx, places, '0'),
        );
        str.format(ctx, "${sign}${whole}.${fraction}${suffix}")
    }
}

/// Pure: `slice` is a view, so this walks back without copying.
fn withoutTrailingZeros(text: Str): Str {
    if (text.endsWith("0")) {
        withoutTrailingZeros(text.slice(0, text.len() - 1))
    } else {
        text
    }
}

// -----------------------------------------------------------------------------
// Points, and the clock that produces them
// -----------------------------------------------------------------------------

impl Instant {
    /// How long since `earlier`, negative if `earlier` is later. Pure: the
    /// difference between two points needs no clock.
    export fn duration(self, earlier: Instant): Duration {
        Duration(self.0.saturatingSub(earlier.0).saturatingMul(NANOS_PER_MILLISECOND))
    }

    /// This point moved forward by a length. `d.millis()` is what moves it, so
    /// a length under a millisecond moves nothing — see the module header.
    export fn plus(self, d: Duration): Instant {
        Instant(self.0.saturatingAdd(d.millis()))
    }

    export fn minus(self, d: Duration): Instant {
        Instant(self.0.saturatingSub(d.millis()))
    }

    /// Whether this point is at or past `deadline`. Both ends saturate, so the
    /// whole deadline check is one `>=`.
    export fn hasPassed(self, deadline: Instant): Bool {
        self.0 >= deadline.0
    }
}

export fn now<C: Clock>(ctx: C): Instant {
    Instant(ctx.nowMillis())
}

/// How long since `earlier`. Reading a clock is what makes this effectful; the
/// pure difference between two points is `Instant.duration`.
export fn since<C: Clock>(ctx: C, earlier: Instant): Duration {
    now(ctx).duration(earlier)
}

/// Waits for a length of time, to the millisecond the clock offers.
export fn sleep<C: Clock>(ctx: C, d: Duration): () {
    ctx.sleepMillis(d.millis())
}

/// The same wait, in the unit the effect itself speaks. Reach for `sleep`
/// unless you already hold a count of milliseconds.
export fn sleepMs<C: Clock>(ctx: C, count: Int): () {
    ctx.sleepMillis(count)
}

// -----------------------------------------------------------------------------
// The other clock
// -----------------------------------------------------------------------------
//
// `now` is wall time. It is the right answer to "what is the date", and the
// wrong one to "how long did that take": NTP steps it, sometimes backwards, and
// it counts whole milliseconds. `monotonic` only goes forward, counts
// nanoseconds, and has no epoch — so a reading is worth nothing on its own and
// `Monotonic` is a separate type saying so.

impl Monotonic {
    /// How long since `earlier`, negative if `earlier` is the later reading.
    /// Pure: the difference between two readings needs no clock.
    export fn duration(self, earlier: Monotonic): Duration {
        Duration(self.0.saturatingSub(earlier.0))
    }
}

/// A reading off the monotonic clock. Take two and subtract them.
export fn monotonic<C: Clock>(ctx: C): Monotonic {
    Monotonic(ctx.monotonicNanoseconds())
}

/// How long since `started`. This is the one to measure with.
///
/// ```buri run
/// from "core/effect" import { Alloc, Clock, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/time" import * as time;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Alloc: host.alloc,
///         Clock: host.clock,
///         Stdout: host.stdout,
///     };
///     let started = time.monotonic(ctx);
///     let took = time.elapsed(ctx, started);
///     let _ = io.println(ctx, "${!took.isNegative()}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// true
/// ```
export fn elapsed<C: Clock>(ctx: C, started: Monotonic): Duration {
    monotonic(ctx).duration(started)
}
