//! core/json — JSON, as a value.
//!
//! `Json` is a tree, and `parse` and `stringify` turn text into one and back.
//! `ToJson` and `FromJson` map it to your own types. They are on `derive`'s
//! fixed list (SPEC 6.7.5), so `derive ToJson for Point;` writes the encoder
//! the way `derive Show` writes the renderer — a fold over the type's
//! components, with no reflection and no macro anywhere. `encode` and `decode`
//! are the two functions that use them.
//!
//! **An object is an ordered association list, not a map.** So parse then
//! stringify gives the key order back, and a `Json` needs no `Hash` bound to be
//! comparable and renderable. The cost is that `get` is O(n).
//!
//! `parse` reads `\uXXXX`, surrogate pairs included. A lone surrogate is an
//! error rather than a replacement character.
//!
//! **Every number is a `Float`**, which is what JSON says a number is. A
//! document holding an integer larger than 2^53 does not survive the round
//! trip.
//!
//! ```buri run
//! from "core/effect" import { Alloc, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/json" import * as json;
//! from "core/json" import { Json };
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let doc = match (json.parse(ctx, "{\"name\":\"buri\",\"tags\":[\"a\",\"b\"]}")) {
//!         .Ok(v) => v,
//!         .Err(_e) => Json.Null,
//!     };
//!     let name = doc.get("name").andThen(fn(v) => v.asStr()).withDefault("?");
//!     // Key order is preserved, which is why an object is an association list
//!     // here rather than a map.
//!     let _ = io.println(ctx, "${name}: ${json.stringify(ctx, doc)}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! buri: {"name":"buri","tags":["a","b"]}
//! ```

from "core/char" import * as char;
from "core/effect" import { Alloc };
from "core/list" import * as list;
from "core/str" import * as str;

derive Eq, Show for Json;
/// A JSON value.
export enum Json {
    Null,
    Bool(Bool),
    Num(Float),
    Str(Str),
    Array([Json]),
    /// Key and value, in the order the document wrote them.
    Object([(Str, Json)]),
}

derive Eq, Show for JsonError;
/// What went wrong, and where. The position is an index into the characters of
/// the input.
export enum JsonError {
    /// A character that cannot begin, continue, or end the value being read.
    Unexpected(Int),
    /// The input ran out mid-value.
    Unterminated,
    /// A complete value, and then more text.
    Trailing(Int),
    /// A number the grammar admits but the runtime cannot represent.
    BadNumber(Int),
    /// A `\` followed by something that is not an escape.
    BadEscape(Int),
    /// Nesting past `MAX_DEPTH`.
    TooDeep(Int),
}

/// How deeply arrays and objects may nest. `value` calls itself for each
/// element and those calls are not tail calls, so a document deeper than this
/// is an error rather than a crash.
export let MAX_DEPTH: Int = 512;

// -----------------------------------------------------------------------------
// Reading
// -----------------------------------------------------------------------------

/// Parses one complete document.
///
/// Trailing text is an error rather than a stopping point.
export fn parse<C: Alloc>(ctx: C, text: Str): Result<Json, JsonError> {
    let cs = text.chars(ctx);
    let start = skipSpace(cs, 0);
    let (v, next) = value(ctx, cs, start, 0)?;
    let end = skipSpace(cs, next);
    if (end < cs.len()) { .Err(.Trailing(end)) } else { .Ok(v) }
}

/// Whitespace, of which JSON admits exactly four characters.
fn skipSpace(cs: [Char], i: Int): Int {
    match (cs.get(i)) {
        .Some(c) => {
            if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                skipSpace(cs, i + 1)
            } else {
                i
            }
        },
        .None => i,
    }
}

/// One value, and the index just past it.
fn value<C: Alloc>(
    ctx: C,
    cs: [Char],
    i: Int,
    depth: Int,
): Result<(Json, Int), JsonError> {
    if (depth > MAX_DEPTH) {
        .Err(.TooDeep(i))
    } else {
        match (cs.get(i)) {
            .None => .Err(.Unterminated),
            .Some(c) => {
                if (c == 'n') {
                    keyword(cs, i, "null", Json.Null)
                } else if (c == 't') {
                    keyword(cs, i, "true", Json.Bool(true))
                } else if (c == 'f') {
                    keyword(cs, i, "false", Json.Bool(false))
                } else if (c == '"') {
                    match (string(ctx, cs, i)) {
                        .Ok((s, next)) => .Ok((Json.Str(s), next)),
                        .Err(e) => .Err(e),
                    }
                } else if (c == '[') {
                    array(ctx, cs, skipSpace(cs, i + 1), depth, list.empty<Json>())
                } else if (c == '{') {
                    object(
                        ctx,
                        cs,
                        skipSpace(cs, i + 1),
                        depth,
                        list.empty<(Str, Json)>(),
                    )
                } else if (c == '-' || c.isDigit()) {
                    number(ctx, cs, i)
                } else {
                    .Err(.Unexpected(i))
                }
            },
        }
    }
}

/// `null`, `true`, `false` — each is its own spelling and nothing else.
fn keyword(cs: [Char], i: Int, word: Str, v: Json): Result<(Json, Int), JsonError> {
    let n = word.len();
    if (matches(cs, i, word, 0, n)) { .Ok((v, i + n)) } else { .Err(.Unexpected(i)) }
}

fn matches(cs: [Char], i: Int, word: Str, k: Int, n: Int): Bool {
    if (k >= n) {
        true
    } else {
        match ((cs.get(i + k), word.charAt(k))) {
            (.Some(a), .Some(b)) => {
                if (a == b) { matches(cs, i, word, k + 1, n) } else { false }
            },
            _ => false,
        }
    }
}

// --- Arrays and objects -------------------------------------------------------
//
// Both use an accumulator plus a recursive step in tail position, so it costs
// no stack — unlike the call into `value`, which is why `depth` exists.

fn array<C: Alloc>(
    ctx: C,
    cs: [Char],
    i: Int,
    depth: Int,
    acc: [Json],
): Result<(Json, Int), JsonError> {
    match (cs.get(i)) {
        .None => .Err(.Unterminated),
        .Some(c) => {
            if (c == ']' && acc.len() == 0) {
                .Ok((Json.Array(acc), i + 1))
            } else {
                let (v, after) = value(ctx, cs, i, depth + 1)?;
                let next = skipSpace(cs, after);
                let items = acc.push(ctx, v);
                match (cs.get(next)) {
                    .Some(',') => array(ctx, cs, skipSpace(cs, next + 1), depth, items),
                    .Some(']') => .Ok((Json.Array(items), next + 1)),
                    .Some(_) => .Err(.Unexpected(next)),
                    .None => .Err(.Unterminated),
                }
            }
        },
    }
}

fn object<C: Alloc>(
    ctx: C,
    cs: [Char],
    i: Int,
    depth: Int,
    acc: [(Str, Json)],
): Result<(Json, Int), JsonError> {
    match (cs.get(i)) {
        .None => .Err(.Unterminated),
        .Some(c) => {
            if (c == '}' && acc.len() == 0) {
                .Ok((Json.Object(acc), i + 1))
            } else if (c != '"') {
                // A key is a string: JSON admits no bare word.
                .Err(.Unexpected(i))
            } else {
                let (k, afterKey) = string(ctx, cs, i)?;
                let colon = skipSpace(cs, afterKey);
                match (cs.get(colon)) {
                    .Some(':') => {
                        let (v, after) = value(
                            ctx,
                            cs,
                            skipSpace(cs, colon + 1),
                            depth + 1,
                        )?;
                        let next = skipSpace(cs, after);
                        let entries = acc.push(ctx, (k, v));
                        match (cs.get(next)) {
                            .Some(',') => {
                                object(ctx, cs, skipSpace(cs, next + 1), depth, entries)
                            },
                            .Some('}') => .Ok((Json.Object(entries), next + 1)),
                            .Some(_) => .Err(.Unexpected(next)),
                            .None => .Err(.Unterminated),
                        }
                    },
                    .Some(_) => .Err(.Unexpected(colon)),
                    .None => .Err(.Unterminated),
                }
            }
        },
    }
}

// --- Strings ------------------------------------------------------------------

/// A quoted string, and the index just past its closing quote.
fn string<C: Alloc>(ctx: C, cs: [Char], i: Int): Result<(Str, Int), JsonError> {
    stringBody(ctx, cs, i + 1, list.empty<Char>())
}

fn stringBody<C: Alloc>(
    ctx: C,
    cs: [Char],
    i: Int,
    acc: [Char],
): Result<(Str, Int), JsonError> {
    match (cs.get(i)) {
        .None => .Err(.Unterminated),
        .Some('"') => .Ok((str.fromChars(ctx, acc), i + 1)),
        .Some('\\') => {
            match (cs.get(i + 1)) {
                .None => .Err(.Unterminated),
                .Some(e) => {
                    if (e == 'u') {
                        // `\uXXXX` names a UTF-16 code unit, so a character above
                        // the basic plane arrives as a surrogate pair; read both.
                        let (c, next) = unicodeEscape(cs, i)?;
                        stringBody(ctx, cs, next, acc.push(ctx, c))
                    } else {
                        match (unescape(e)) {
                            .Some(c) => stringBody(ctx, cs, i + 2, acc.push(ctx, c)),
                            .None => .Err(.BadEscape(i + 1)),
                        }
                    }
                },
            }
        },
        .Some(c) => stringBody(ctx, cs, i + 1, acc.push(ctx, c)),
    }
}

/// The character a `\uXXXX` escape at `i` denotes, and the index just past it.
/// `i` points at the backslash.
fn unicodeEscape(cs: [Char], i: Int): Result<(Char, Int), JsonError> {
    let hi = hex4(cs, i + 2)?;
    if (hi < 55296 || hi > 56319) {
        // Not a high surrogate. A lone low surrogate is refused here too.
        if (hi >= 56320 && hi <= 57343) {
            .Err(.BadEscape(i + 2))
        } else {
            match (hi.wrapToU32().toChar()) {
                .Ok(c) => .Ok((c, i + 6)),
                .Err(_e) => .Err(.BadEscape(i + 2)),
            }
        }
    } else {
        match ((cs.get(i + 6), cs.get(i + 7))) {
            (.Some('\\'), .Some('u')) => {
                let lo = hex4(cs, i + 8)?;
                if (lo < 56320 || lo > 57343) {
                    .Err(.BadEscape(i + 8))
                } else {
                    let code = 65536 + (hi - 55296) * 1024 + (lo - 56320);
                    match (code.wrapToU32().toChar()) {
                        .Ok(c) => .Ok((c, i + 12)),
                        .Err(_e) => .Err(.BadEscape(i + 2)),
                    }
                }
            },
            _ => .Err(.BadEscape(i + 2)),
        }
    }
}

/// Four hexadecimal digits, either case, as a number.
fn hex4(cs: [Char], i: Int): Result<Int, JsonError> {
    match ((cs.get(i), cs.get(i + 1), cs.get(i + 2), cs.get(i + 3))) {
        (.Some(a), .Some(b), .Some(c), .Some(d)) => {
            match ((a.toDigit(16), b.toDigit(16), c.toDigit(16), d.toDigit(16))) {
                (.Some(w), .Some(x), .Some(y), .Some(z)) => {
                    .Ok(w * 4096 + x * 256 + y * 16 + z)
                },
                _ => .Err(.BadEscape(i)),
            }
        },
        _ => .Err(.Unterminated),
    }
}

fn unescape(e: Char): Option<Char> {
    if (e == '"') {
        .Some('"')
    } else if (e == '\\') {
        .Some('\\')
    } else if (e == '/') {
        .Some('/')
    } else if (e == 'n') {
        .Some('\n')
    } else if (e == 'r') {
        .Some('\r')
    } else if (e == 't') {
        .Some('\t')
    } else if (e == 'b') {
        .Some('\u{8}')
    } else if (e == 'f') {
        .Some('\u{c}')
    } else {
        .None
    }
}

// --- Numbers ------------------------------------------------------------------

fn number<C: Alloc>(ctx: C, cs: [Char], i: Int): Result<(Json, Int), JsonError> {
    let end = numberEnd(cs, i, i);
    let text = str.fromChars(ctx, cs.slice(ctx, i, end));
    match (text.toFloat()) {
        .Some(x) => .Ok((Json.Num(x), end)),
        .None => .Err(.BadNumber(i)),
    }
}

/// The extent of a number token. It takes every character a number could
/// contain and lets `toFloat` be the judge.
fn numberEnd(cs: [Char], start: Int, i: Int): Int {
    match (cs.get(i)) {
        .None => i,
        .Some(c) => {
            if (
                c.isDigit()
                    || c == '.'
                    || c == 'e'
                    || c == 'E'
                    || (c == '-' || c == '+') && (i == start || isExponent(cs, i - 1))
            ) {
                numberEnd(cs, start, i + 1)
            } else {
                i
            }
        },
    }
}

fn isExponent(cs: [Char], i: Int): Bool {
    match (cs.get(i)) {
        .Some(c) => c == 'e' || c == 'E',
        .None => false,
    }
}

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

/// The compact rendering: no spaces, no newlines, keys in the order the value
/// holds them. `parse` of this is the value it came from.
export fn stringify<C: Alloc>(ctx: C, v: Json): Str {
    match (v) {
        .Null => "null",
        .Bool(b) => if (b) { "true" } else { "false" },
        .Num(x) => numberText(ctx, x),
        .Str(s) => quote(ctx, s),
        .Array(items) => {
            let parts = items.mapCtx(ctx, fn(c, item) => stringify(c, item));
            str.format(ctx, "[${parts.join(ctx, ",")}]")
        },
        .Object(entries) => {
            let parts = entries.mapCtx(ctx, fn(c, e) => {
                let (k, item) = e;
                str.format(c, "${quote(c, k)}:${stringify(c, item)}")
            });
            str.format(ctx, "{${parts.join(ctx, ",")}}")
        },
    }
}

/// The same value over several lines, `indent` spaces to a level.
///
/// An empty array and an empty object stay `[]` and `{}` — there is nothing to
/// put on a line of its own. A negative `indent` reads as zero, which still puts
/// every element on its own line.
///
/// ```buri run
/// from "core/effect" import { Alloc, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/json" import * as json;
/// from "core/json" import { Json };
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Alloc: host.alloc,
///         Stdout: host.stdout,
///     };
///     let doc = Json.Object([("id", Json.Num(7.0)), ("tags", Json.Array([]))]);
///     let _ = io.println(ctx, json.stringifyPretty(ctx, doc, 2)).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// {
///   "id": 7,
///   "tags": []
/// }
/// ```
export fn stringifyPretty<C: Alloc>(ctx: C, value: Json, indent: Int): Str {
    laidOut(ctx, value, if (indent < 0) { 0 } else { indent }, 0)
}

fn laidOut<C: Alloc>(ctx: C, v: Json, indent: Int, depth: Int): Str {
    match (v) {
        .Array(items) => {
            if (items.isEmpty()) {
                "[]"
            } else {
                let inner = " ".repeat(ctx, indent * (depth + 1));
                let outer = " ".repeat(ctx, indent * depth);
                let parts = items.mapCtx(ctx, fn(c, item) => {
                    str.format(c, "${inner}${laidOut(c, item, indent, depth + 1)}")
                });
                str.format(ctx, "[\n${parts.join(ctx, ",\n")}\n${outer}]")
            }
        },
        .Object(entries) => {
            if (entries.isEmpty()) {
                "{}"
            } else {
                let inner = " ".repeat(ctx, indent * (depth + 1));
                let outer = " ".repeat(ctx, indent * depth);
                let parts = entries.mapCtx(ctx, fn(c, e) => {
                    let (k, item) = e;
                    let rendered = laidOut(c, item, indent, depth + 1);
                    str.format(c, "${inner}${quote(c, k)}: ${rendered}")
                });
                str.format(ctx, "{\n${parts.join(ctx, ",\n")}\n${outer}}")
            }
        },
        _ => stringify(ctx, v),
    }
}

/// The compact rendering with every object's keys in `Str` order, at every
/// depth.
///
/// Two documents that differ only in key order render the same, which is what a
/// golden file or a digest over a document needs. Array order is data and is
/// left alone. Duplicate keys keep the order they arrived in, because the sort
/// is stable.
export fn stringifySorted<C: Alloc>(ctx: C, value: Json): Str {
    stringify(ctx, byKey(ctx, value))
}

fn byKey<C: Alloc>(ctx: C, v: Json): Json {
    match (v) {
        .Array(items) => Json.Array(items.mapCtx(ctx, fn(c, item) => byKey(c, item))),
        .Object(entries) => {
            Json.Object(
                entries
                    .mapCtx(ctx, fn(c, e) => {
                        let (k, item) = e;
                        (k, byKey(c, item))
                    })
                    .sortBy(ctx, fn(a, b) => {
                        let (ka, _va) = a;
                        let (kb, _vb) = b;
                        ka.compare(kb)
                    }),
            )
        },
        _ => v,
    }
}

/// A number, the way JSON writes one.
///
/// `str.fromFloat` renders a whole number as `3.0`. JSON has one number type
/// and writes it `3`, so the trailing `.0` comes off.
fn numberText<C: Alloc>(ctx: C, x: Float): Str {
    let s = str.fromFloat(ctx, x);
    if (s.endsWith(".0")) { s.slice(0, s.len() - 2) } else { s }
}

/// A quoted, escaped string literal.
export fn quote<C: Alloc>(ctx: C, s: Str): Str {
    let inner = s.chars(ctx).mapCtx(ctx, fn(c, ch) => escape(c, ch)).join(ctx, "");
    str.format(ctx, "\"${inner}\"")
}

fn escape<C: Alloc>(ctx: C, c: Char): Str {
    if (c == '"') {
        "\\\""
    } else if (c == '\\') {
        "\\\\"
    } else if (c == '\n') {
        "\\n"
    } else if (c == '\r') {
        "\\r"
    } else if (c == '\t') {
        "\\t"
    } else if (c.toU32().toI64() < 32) {
        // JSON forbids a raw control character in a string, and `\u00XX` is the
        // only way to write the ones without a short spelling.
        let n = c.toU32().toI64();
        str.format(
            ctx,
            "\\u00${HEX2.charAt(n / 16).withDefault('0')}${HEX2
                .charAt(n % 16)
                .withDefault('0')}",
        )
    } else {
        str.fromChars(ctx, [c])
    }
}

let HEX2: Str = "0123456789abcdef";

// -----------------------------------------------------------------------------
// Looking inside one
// -----------------------------------------------------------------------------

impl Json {
    /// The value at `key`, if this is an object that has one. O(n) in the number
    /// of entries — see the module comment.
    export fn get(self, key: Str): Option<Json> {
        match (self) {
            .Object(entries) => {
                entries
                    .find(fn(e) => {
                        let (k, _v) = e;
                        k == key
                    })
                    .map(fn(e) => {
                        let (_k, v) = e;
                        v
                    })
            },
            _ => .None,
        }
    }

    /// The element at `index`, if this is an array that has one.
    export fn at(self, index: Int): Option<Json> {
        match (self) {
            .Array(items) => items.get(index),
            _ => .None,
        }
    }

    export fn asBool(self): Option<Bool> {
        match (self) {
            .Bool(b) => .Some(b),
            _ => .None,
        }
    }

    export fn asNum(self): Option<Float> {
        match (self) {
            .Num(x) => .Some(x),
            _ => .None,
        }
    }

    export fn asStr(self): Option<Str> {
        match (self) {
            .Str(s) => .Some(s),
            _ => .None,
        }
    }

    /// The number as an `Int`, if this is a number and a whole one an `Int`
    /// holds. `7` and `7.0` are the same document, so both answer `.Some(7)`;
    /// `7.5` and `1e300` answer `.None`.
    ///
    /// Every number in a `Json` is a `Float`, so this is the conversion an
    /// integer field pays either way. Doing it here means paying it once and
    /// finding out whether it was one.
    export fn asInt(self): Option<Int> {
        match (self) {
            .Num(x) => {
                match (x.toI64()) {
                    .Ok(n) => if (n.toF64() == x) { .Some(n) } else { .None },
                    .Err(_e) => .None,
                }
            },
            _ => .None,
        }
    }

    export fn asArray(self): Option<[Json]> {
        match (self) {
            .Array(items) => .Some(items),
            _ => .None,
        }
    }

    /// The entries in document order, if this is an object — `asArray`'s twin.
    export fn asObject(self): Option<[(Str, Json)]> {
        match (self) {
            .Object(entries) => .Some(entries),
            _ => .None,
        }
    }

    /// The object's keys in the order the document wrote them. Anything that is
    /// not an object has none, so this is empty rather than `.None`.
    export fn keys<C: Alloc>(self, ctx: C): [Str] {
        match (self) {
            .Object(entries) => {
                entries.map(ctx, fn(e) => {
                    let (k, _v) = e;
                    k
                })
            },
            _ => list.empty<Str>(),
        }
    }

    /// `get` down a chain of keys: `doc.path(["user", "name"])` says what
    /// `doc.get("user").andThen(fn(v) => v.get("name"))` says. An empty chain
    /// answers this value.
    ///
    /// Objects only — a number in the chain is `.None`, because an array index
    /// is `at` and this takes keys.
    export fn path(self, keys: [Str]): Option<Json> {
        keys.fold(
            fn(found: Option<Json>, key) => found.andThen(fn(v) => v.get(key)),
            .Some(self),
        )
    }

    export fn isNull(self): Bool {
        match (self) {
            .Null => true,
            _ => false,
        }
    }
}

// -----------------------------------------------------------------------------
// Typed encoding
// -----------------------------------------------------------------------------
//
// `derive ToJson for Point;` and `derive FromJson for Point;` are folds over
// the type's components, exactly as `derive Show` is. The compiler ships a
// *descriptor* of every type the structural operations reach — field names,
// variant shapes, element types — and the runtime walks it, so this costs no
// reflection, no macro, and no generated source.
//
// A type derives one of these only if every one of its components does. A
// component that reaches back to the type being derived stops there, so a
// recursive type derives rather than hangs.
//
// **The mapping**:
//
//   * `Bool` is a JSON boolean; every integer and float type is a JSON number;
//     `Str` is a string, and `Char` is a one-character string.
//   * `()` is `null`.
//   * `[T]` is an array, and so is a tuple.
//   * `Option<T>` is the encoding of `T`, or `null` for `.None`. JSON has one
//     null, so `Option<Option<T>>` does not round-trip — `.Some(.None)` and
//     `.None` both write `null` and both read back as `.None`.
//   * A struct with named fields is an object keyed by those names, in
//     declaration order.
//   * A struct with positional fields is an array, in declaration order — a
//     one-field struct included.
//   * An enum is **externally tagged**: a variant with no fields is its own
//     name as a string, a variant with named fields is `{"Name": { ... }}`,
//     and a variant with positional fields is `{"Name": [ ... ]}`.
//
// **You derive these two traits; you never write one by hand.** A derive stands
// for the *shape*, which is what the descriptor carries, so the compiler
// rejects an `impl` of either.
//
// **`Json` itself is neither**: the structural walk would write `Json.Str("x")`
// as `{"Str": ["x"]}`, and a `Json` is already JSON. So a type with a `Json`
// field does not derive these. Convert at the boundary instead.

/// Encoding a value as JSON. Derived, never written by hand — see above.
///
/// Rendering allocates, so `toJson` names `Alloc` and nothing else.
export trait ToJson {
    fn toJson<C: Alloc>(self, ctx: C): Json;
}

/// Decoding a value from JSON. Derived, never written by hand — see above.
///
/// Its method takes no `self`: there is no value yet. So you reach it through
/// `decode` rather than through a receiver.
export trait FromJson {
    fn fromJson(value: Json): Result<Self, DecodeError>;
}

derive Eq, Show for DecodeError;
/// Why a document could not be read as the type asked for, and *where*.
///
/// `path` writes `$` for the document itself, `.name` for a member and `[i]`
/// for an element, so a failure names a place: `$.center.x`, `$.tags[2]`.
export enum DecodeError {
    /// An object with no member of that name.
    Missing { path: Str },
    /// A value of the wrong shape: what the type wanted, and what was there.
    WrongType { path: Str, wanted: Str, found: Str },
    /// A tag naming no variant of the enum being read.
    UnknownVariant { path: Str, tag: Str },
}

/// Encodes any `ToJson` value.
///
/// ```buri run
/// from "core/effect" import { Alloc, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/json" import * as json;
/// from "core/json" import { DecodeError, FromJson, ToJson };
///
/// derive Eq, ToJson, FromJson for Point;
/// struct Point {
///     x: Int,
///     y: Int,
/// }
///
/// derive Eq, ToJson, FromJson for Shape;
/// enum Shape {
///     Dot,
///     Line(Point, Point),
/// }
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Alloc: host.alloc,
///         Stdout: host.stdout,
///     };
///     let shape = Shape.Line(Point { x: 0, y: 0 }, Point { x: 3, y: 4 });
///     let text = json.stringify(ctx, json.encode(ctx, shape));
///     let _ = io.println(ctx, text).ignore();
///
///     // The type comes from the annotation, not from a type argument.
///     let back: Result<Shape, DecodeError> = json.decode(ctx, json.encode(ctx, shape));
///     let _ = io.println(ctx, "${back == .Ok(shape)}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// {"Line":[{"x":0,"y":0},{"x":3,"y":4}]}
/// true
/// ```
export fn encode<T: ToJson, C: Alloc>(ctx: C, value: T): Json {
    value.toJson(ctx)
}

/// Reads a `Json` as a `T`, or says where it stopped.
///
/// **The type comes from the annotation.** A written type argument list has to
/// name every argument, and a context type has no name to write (SPEC 11.3).
/// Write the type on the binding instead: `let point: Result<Point,
/// DecodeError> = json.decode(ctx, doc);`.
export fn decode<T: FromJson, C: Alloc>(ctx: C, value: Json): Result<T, DecodeError>;
