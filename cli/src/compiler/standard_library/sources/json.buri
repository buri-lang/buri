//! core/json — JSON, as a value.
//!
//! `Json` is a tree, and `parse` and `stringify` turn text into one and back.
//! `ToJson` and `FromJson` map it to your own types: they are on `derive`'s
//! fixed list (SPEC 6.7.5), so `derive ToJson for Point;` writes the encoder
//! the way `derive Show` writes the renderer — a fold over the type's
//! components, with no reflection and no macro anywhere. `encode` and `decode`
//! are the two functions that use them.
//!
//! **An object is an ordered association list, not a map.** Three reasons, in
//! order of weight: it round-trips — parse then stringify gives the key order
//! back, which a hash map cannot promise; it needs no `Hash` bound, so a `Json`
//! is comparable and renderable with nothing but `derive`; and JSON objects are
//! small in practice. The cost is that `get` is O(n), which is stated here
//! rather than discovered.
//!
//! `\uXXXX` is read, surrogate pairs included; a lone surrogate is an error
//! rather than a replacement character, for the same reason a bad UTF-8
//! sequence is one in `core/bytes`.
//!
//! **Every number is a `Float`.** That is what JSON says a number is. A
//! document holding an integer larger than 2^53 does not survive the round
//! trip, and neither does one in any other JSON implementation backed by a
//! double.
//!
//! ```buri run
//! from "core/effect" import { Alloc, Stdout };
//! from "core/host" import * as host;
//! from "core/json" import { Json };
//! from "core/json" import * as json;
//!
//! export fn main(): Result<(), Str> {
//!   let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
//!   let doc = match (json.parse(ctx, "{\"name\":\"buri\",\"tags\":[\"a\",\"b\"]}")) {
//!     .Ok(v) => v,
//!     .Err(_e) => Json.Null,
//!   };
//!   let name = doc.get("name").andThen(fn(v) => v.asStr()).withDefault("?");
//!   // Key order is preserved, which is why an object is an association list
//!   // here rather than a map.
//!   let _ = ctx.println("${name}: ${json.stringify(ctx, doc)}");
//!   .Ok(())
//! }
//! ```
//!
//! ```stdout
//! buri: {"name":"buri","tags":["a","b"]}
//! ```

from "core/char" import * as char;
from "core/effect" import { Alloc };
from "core/list" import * as list;
from "core/str" import * as str;

/// A JSON value.
export enum Json {
  Null,
  Bool(Bool),
  Num(Float),
  Str(Str),
  Array([Json]),
  /// Key and value, in the order they were written.
  Object([(Str, Json)]),
}

derive Eq, Show for Json;

/// What went wrong, and where. The position is an index into the characters of
/// the input, so it is the same number whatever the encoding of the source.
export enum JsonError {
  /// A character that cannot begin, continue, or end what was being read.
  Unexpected(Int),
  /// The input ran out mid-value.
  Unterminated,
  /// A complete value, and then more text.
  Trailing(Int),
  /// A number the grammar admits but the runtime cannot represent.
  BadNumber(Int),
  /// A `\` followed by something that is not an escape.
  BadEscape(Int),
  /// Nesting past `MAX_DEPTH`. Parsing is recursive and recursion here is not
  /// in tail position, so without this a deep enough document is a crash
  /// rather than an error.
  TooDeep(Int),
}

derive Eq, Show for JsonError;

/// How deeply arrays and objects may nest.
///
/// A limit is not a nicety: `value` calls itself for each element, and those
/// calls are not tail calls, so nothing eliminates the frames. 512 is far past
/// any document a person writes and far short of any stack.
export let MAX_DEPTH: Int = 512;

// -----------------------------------------------------------------------------
// Reading
// -----------------------------------------------------------------------------

/// Parses one complete document.
///
/// Trailing text is an error rather than a stopping point: a caller who asked
/// for one value and got one value and a half should hear about it.
export fn parse<C: Alloc>(ctx: C, text: Str): Result<Json, JsonError> {
  let cs = text.chars(ctx);
  let start = skipSpace(cs, 0);
  let (v, next) = value(ctx, cs, start, 0)?;
  let end = skipSpace(cs, next);
  if (end < cs.len()) {
    .Err(.Trailing(end))
  } else {
    .Ok(v)
  }
}

/// Whitespace, of which JSON admits exactly four characters.
fn skipSpace(cs: [Char], i: Int): Int {
  match (cs.get(i)) {
    .Some(c) => if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
      skipSpace(cs, i + 1)
    } else {
      i
    },
    .None => i,
  }
}

/// One value, and the index just past it.
fn value<C: Alloc>(ctx: C, cs: [Char], i: Int, depth: Int): Result<(Json, Int), JsonError> {
  if (depth > MAX_DEPTH) {
    .Err(.TooDeep(i))
  } else {
    match (cs.get(i)) {
      .None => .Err(.Unterminated),
      .Some(c) => if (c == 'n') {
        keyword(cs, i, "null", Json.Null)
      } else if (c == 't') {
        keyword(cs, i, "true", Json.Bool(true))
      } else if (c == 'f') {
        keyword(cs, i, "false", Json.Bool(false))
      } else if (c == '"') {
        match (string(ctx, cs, i)) {
          .Ok((s, next)) => .Ok((Json.Str(s), next)),
          .Err(e) => .Err(e),
        }
      } else if (c == '[') {
        array(ctx, cs, skipSpace(cs, i + 1), depth, list.empty<Json>())
      } else if (c == '{') {
        object(ctx, cs, skipSpace(cs, i + 1), depth, list.empty<(Str, Json)>())
      } else if (c == '-' || c.isDigit()) {
        number(ctx, cs, i)
      } else {
        .Err(.Unexpected(i))
      },
    }
  }
}

/// `null`, `true`, `false` — each is its own spelling and nothing else.
fn keyword(cs: [Char], i: Int, word: Str, v: Json): Result<(Json, Int), JsonError> {
  let n = word.len();
  if (matches(cs, i, word, 0, n)) {
    .Ok((v, i + n))
  } else {
    .Err(.Unexpected(i))
  }
}

fn matches(cs: [Char], i: Int, word: Str, k: Int, n: Int): Bool {
  if (k >= n) {
    true
  } else {
    match ((cs.get(i + k), word.charAt(k))) {
      (.Some(a), .Some(b)) => if (a == b) { matches(cs, i, word, k + 1, n) } else { false },
      _ => false,
    }
  }
}

// --- Arrays and objects -------------------------------------------------------
//
// Both are written as an accumulator plus a recursive step rather than a loop,
// because there are no loops (SPEC 15.1). The recursion is in tail position,
// so it costs no stack — unlike the call into `value`, which is why `depth`
// exists.

fn array<C: Alloc>(
  ctx: C,
  cs: [Char],
  i: Int,
  depth: Int,
  acc: [Json],
): Result<(Json, Int), JsonError> {
  match (cs.get(i)) {
    .None => .Err(.Unterminated),
    .Some(c) => if (c == ']' && acc.len() == 0) {
      .Ok((Json.Array(acc), i + 1))
    } else {
      let (v, after) = value(ctx, cs, i, depth + 1)?;
      let next = skipSpace(cs, after);
      let items = acc.push(ctx, v);
      match (cs.get(next)) {
        .Some(',') => array(ctx, cs, skipSpace(cs, next + 1), depth, items),
        .Some(']') => .Ok((Json.Array(items), next + 1)),
        .Some(_) => .Err(.Unexpected(next)),
        .None => .Err(.Unterminated),
      }
    },
  }
}

fn object<C: Alloc>(
  ctx: C,
  cs: [Char],
  i: Int,
  depth: Int,
  acc: [(Str, Json)],
): Result<(Json, Int), JsonError> {
  match (cs.get(i)) {
    .None => .Err(.Unterminated),
    .Some(c) => if (c == '}' && acc.len() == 0) {
      .Ok((Json.Object(acc), i + 1))
    } else if (c != '"') {
      // A key is a string. JSON does not admit a bare word, and accepting one
      // would mean writing a document this module could read and nothing else
      // could.
      .Err(.Unexpected(i))
    } else {
      let (k, afterKey) = string(ctx, cs, i)?;
      let colon = skipSpace(cs, afterKey);
      match (cs.get(colon)) {
        .Some(':') => {
          let (v, after) = value(ctx, cs, skipSpace(cs, colon + 1), depth + 1)?;
          let next = skipSpace(cs, after);
          let entries = acc.push(ctx, (k, v));
          match (cs.get(next)) {
            .Some(',') => object(ctx, cs, skipSpace(cs, next + 1), depth, entries),
            .Some('}') => .Ok((Json.Object(entries), next + 1)),
            .Some(_) => .Err(.Unexpected(next)),
            .None => .Err(.Unterminated),
          }
        },
        .Some(_) => .Err(.Unexpected(colon)),
        .None => .Err(.Unterminated),
      }
    },
  }
}

// --- Strings ------------------------------------------------------------------

/// A quoted string, and the index just past its closing quote.
fn string<C: Alloc>(ctx: C, cs: [Char], i: Int): Result<(Str, Int), JsonError> {
  stringBody(ctx, cs, i + 1, list.empty<Char>())
}

fn stringBody<C: Alloc>(
  ctx: C,
  cs: [Char],
  i: Int,
  acc: [Char],
): Result<(Str, Int), JsonError> {
  match (cs.get(i)) {
    .None => .Err(.Unterminated),
    .Some('"') => .Ok((str.fromChars(ctx, acc), i + 1)),
    .Some('\\') => match (cs.get(i + 1)) {
      .None => .Err(.Unterminated),
      .Some(e) => if (e == 'u') {
        // `\uXXXX` is the one escape that is not a single-character rewrite:
        // it names a UTF-16 code unit, and a character above the basic plane is
        // written as a surrogate pair. Both halves are read here, because a
        // lone half is not a character and a document that carries one is
        // saying something no reader can honour.
        let (c, next) = unicodeEscape(cs, i)?;
        stringBody(ctx, cs, next, acc.push(ctx, c))
      } else {
        match (unescape(e)) {
          .Some(c) => stringBody(ctx, cs, i + 2, acc.push(ctx, c)),
          .None => .Err(.BadEscape(i + 1)),
        }
      },
    },
    .Some(c) => stringBody(ctx, cs, i + 1, acc.push(ctx, c)),
  }
}

/// The character a `\uXXXX` escape at `i` denotes, and the index just past it.
/// `i` points at the backslash.
fn unicodeEscape(cs: [Char], i: Int): Result<(Char, Int), JsonError> {
  let hi = hex4(cs, i + 2)?;
  if (hi < 55296 || hi > 56319) {
    // Not a high surrogate. A *low* surrogate on its own is not a character
    // either, and is refused for the same reason.
    if (hi >= 56320 && hi <= 57343) {
      .Err(.BadEscape(i + 2))
    } else {
      match (hi.wrapToU32().toChar()) {
        .Ok(c) => .Ok((c, i + 6)),
        .Err(_e) => .Err(.BadEscape(i + 2)),
      }
    }
  } else {
    match ((cs.get(i + 6), cs.get(i + 7))) {
      (.Some('\\'), .Some('u')) => {
        let lo = hex4(cs, i + 8)?;
        if (lo < 56320 || lo > 57343) {
          .Err(.BadEscape(i + 8))
        } else {
          let code = 65536 + (hi - 55296) * 1024 + (lo - 56320);
          match (code.wrapToU32().toChar()) {
            .Ok(c) => .Ok((c, i + 12)),
            .Err(_e) => .Err(.BadEscape(i + 2)),
          }
        }
      },
      _ => .Err(.BadEscape(i + 2)),
    }
  }
}

/// Four hexadecimal digits, either case, as a number.
fn hex4(cs: [Char], i: Int): Result<Int, JsonError> {
  match ((cs.get(i), cs.get(i + 1), cs.get(i + 2), cs.get(i + 3))) {
    (.Some(a), .Some(b), .Some(c), .Some(d)) => match ((
      a.toDigit(16),
      b.toDigit(16),
      c.toDigit(16),
      d.toDigit(16),
    )) {
      (.Some(w), .Some(x), .Some(y), .Some(z)) => .Ok(w * 4096 + x * 256 + y * 16 + z),
      _ => .Err(.BadEscape(i)),
    },
    _ => .Err(.Unterminated),
  }
}

fn unescape(e: Char): Option<Char> {
  if (e == '"') {
    .Some('"')
  } else if (e == '\\') {
    .Some('\\')
  } else if (e == '/') {
    .Some('/')
  } else if (e == 'n') {
    .Some('\n')
  } else if (e == 'r') {
    .Some('\r')
  } else if (e == 't') {
    .Some('\t')
  } else if (e == 'b') {
    .Some('\u{0008}')
  } else if (e == 'f') {
    .Some('\u{000c}')
  } else {
    .None
  }
}

// --- Numbers ------------------------------------------------------------------

fn number<C: Alloc>(ctx: C, cs: [Char], i: Int): Result<(Json, Int), JsonError> {
  let end = numberEnd(cs, i, i);
  let text = str.fromChars(ctx, cs.slice(ctx, i, end));
  match (text.toFloat()) {
    .Some(x) => .Ok((Json.Num(x), end)),
    .None => .Err(.BadNumber(i)),
  }
}

/// The extent of a number token. Deliberately generous — it takes every
/// character a number could contain and lets `toFloat` be the judge, so there
/// is one definition of what a number is rather than two that can disagree.
fn numberEnd(cs: [Char], start: Int, i: Int): Int {
  match (cs.get(i)) {
    .None => i,
    .Some(c) => if (
      c.isDigit()
        || c == '.'
        || c == 'e'
        || c == 'E'
        || ((c == '-' || c == '+') && (i == start || isExponent(cs, i - 1)))
    ) {
      numberEnd(cs, start, i + 1)
    } else {
      i
    },
  }
}

fn isExponent(cs: [Char], i: Int): Bool {
  match (cs.get(i)) {
    .Some(c) => c == 'e' || c == 'E',
    .None => false,
  }
}

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------

/// The compact rendering: no spaces, no newlines, keys in the order they are
/// held. `parse` of this is the value it came from.
export fn stringify<C: Alloc>(ctx: C, v: Json): Str {
  match (v) {
    .Null => "null",
    .Bool(b) => if (b) { "true" } else { "false" },
    .Num(x) => numberText(ctx, x),
    .Str(s) => quote(ctx, s),
    .Array(items) => {
      let parts = items.mapCtx(ctx, fn(c, item) => stringify(c, item));
      str.format(ctx, "[${parts.join(ctx, ",")}]")
    },
    .Object(entries) => {
      let parts = entries.mapCtx(ctx, fn(c, e) => {
        let (k, item) = e;
        str.format(c, "${quote(c, k)}:${stringify(c, item)}")
      });
      str.format(ctx, "{${parts.join(ctx, ",")}}")
    },
  }
}

/// A number, the way JSON writes one.
///
/// `str.fromFloat` renders a whole number as `3.0`, because in Buri that is
/// what distinguishes a `Float` from an `Int`. JSON has one number type and
/// writes it `3`, so the trailing `.0` comes off — a string test rather than a
/// conversion to `Int`, which would be fallible and would misrender everything
/// past 2^53 rather than leaving it alone.
fn numberText<C: Alloc>(ctx: C, x: Float): Str {
  let s = str.fromFloat(ctx, x);
  if (s.endsWith(".0")) {
    s.slice(0, s.len() - 2)
  } else {
    s
  }
}

/// A quoted, escaped string literal.
export fn quote<C: Alloc>(ctx: C, s: Str): Str {
  let inner = s.chars(ctx).mapCtx(ctx, fn(c, ch) => escape(c, ch)).join(ctx, "");
  str.format(ctx, "\"${inner}\"")
}

fn escape<C: Alloc>(ctx: C, c: Char): Str {
  if (c == '"') {
    "\\\""
  } else if (c == '\\') {
    "\\\\"
  } else if (c == '\n') {
    "\\n"
  } else if (c == '\r') {
    "\\r"
  } else if (c == '\t') {
    "\\t"
  } else if (c.toU32().toI64() < 32) {
    // JSON forbids a raw control character inside a string, and the four with
    // short spellings are above. The rest go out as `\u00XX`, which is the
    // only way to write them at all.
    let n = c.toU32().toI64();
    str.format(ctx, "\\u00${HEX2.charAt(n / 16).withDefault('0')}${HEX2.charAt(n % 16).withDefault('0')}")
  } else {
    str.fromChars(ctx, [c])
  }
}

let HEX2: Str = "0123456789abcdef";

// -----------------------------------------------------------------------------
// Looking inside one
// -----------------------------------------------------------------------------

impl Json {
  /// The value at `key`, if this is an object that has one. O(n) in the number
  /// of entries — see the module comment.
  export fn get(self, key: Str): Option<Json> {
    match (self) {
      .Object(entries) => entries.find(fn(e) => {
        let (k, _v) = e;
        k == key
      }).map(fn(e) => {
        let (_k, v) = e;
        v
      }),
      _ => .None,
    }
  }

  /// The element at `index`, if this is an array that has one.
  export fn at(self, index: Int): Option<Json> {
    match (self) {
      .Array(items) => items.get(index),
      _ => .None,
    }
  }

  export fn asBool(self): Option<Bool> {
    match (self) {
      .Bool(b) => .Some(b),
      _ => .None,
    }
  }

  export fn asNum(self): Option<Float> {
    match (self) {
      .Num(x) => .Some(x),
      _ => .None,
    }
  }

  export fn asStr(self): Option<Str> {
    match (self) {
      .Str(s) => .Some(s),
      _ => .None,
    }
  }

  export fn asArray(self): Option<[Json]> {
    match (self) {
      .Array(items) => .Some(items),
      _ => .None,
    }
  }

  export fn isNull(self): Bool {
    match (self) {
      .Null => true,
      _ => false,
    }
  }
}

// -----------------------------------------------------------------------------
// Typed encoding
// -----------------------------------------------------------------------------
//
// `derive ToJson for Point;` and `derive FromJson for Point;` are folds over
// the type's components, exactly as `derive Show` is. The compiler already
// ships a *descriptor* of every type the structural operations reach — field
// names, variant shapes, element types — and the runtime walks it. So this
// costs no reflection, no macro, and no generated source: one walker for the
// whole program rather than one encoder per type.
//
// A type derives one of these only if every one of its components does, which
// the checker decides the way it decides `derive Eq`: a component that reaches
// back to the type being derived stops there rather than asking the question
// again, so a recursive type — a tree, a rose, a list of itself — is derivable
// rather than a hang.
//
// **The mapping**, stated here rather than discovered by reading output:
//
//   * `Bool` is a JSON boolean; every integer and float type is a JSON number;
//     `Str` is a string, and `Char` is a one-character string.
//   * `()` is `null`.
//   * `[T]` is an array, and so is a tuple: a tuple is positional data, and
//     JSON's positional container is the array.
//   * `Option<T>` is the encoding of `T`, or `null` for `.None`. JSON has one
//     null, so `Option<Option<T>>` does not round-trip — `.Some(.None)` and
//     `.None` both write `null` and both read back as `.None`. That is the
//     price of the obvious encoding, and it is paid here rather than hidden.
//   * A struct with named fields is an object keyed by those names, in
//     declaration order.
//   * A struct with positional fields is an array, in declaration order — a
//     one-field struct included. Writing a newtype "transparently" as its one
//     field would make the document's shape depend on how many fields the type
//     happens to have today, so adding a second field would silently change
//     every document already written.
//   * An enum is **externally tagged**: a variant with no fields is its own
//     name as a string, a variant with named fields is `{"Name": { ... }}`,
//     and a variant with positional fields is `{"Name": [ ... ]}`. The
//     alternative — `{"tag": "Name", ...}` — reserves a key, and a struct
//     variant with a field called `tag` then collides with it silently.
//     Externally tagged reserves nothing.
//
// **These two traits are derived, never written by hand.** What the derive
// stands for is the *shape*, which is what the descriptor carries — so a
// hand-written `impl ToJson for Date` would be called where a `Date` is
// encoded on its own and walked straight past where an `Appointment` holding
// one is, which is worse than not having it. An `impl` of either is rejected
// rather than half-obeyed.
//
// **`Json` itself is neither**, for the same reason: the structural walk would
// write `Json.Str("x")` as `{"Str": ["x"]}`, and a `Json` is already JSON.
// A type with a `Json` field therefore does not derive these; convert at the
// boundary instead, which is a line of code a reader can see.

/// Encoding a value as JSON. Derived, never written by hand — see above.
///
/// Rendering allocates, so `toJson` names `Alloc` and nothing else, exactly as
/// `Show.show` does.
export trait ToJson {
  fn toJson<C: Alloc>(self, ctx: C): Json;
}

/// Decoding a value from JSON. Derived, never written by hand — see above.
///
/// Its method takes no `self`: there is no value yet. So it is reached through
/// `decode` rather than through a receiver, the way `Bounded` is reached
/// through `num.maxValue`.
export trait FromJson {
  fn fromJson(value: Json): Result<Self, DecodeError>;
}

/// Why a document could not be read as the type asked for, and *where*.
///
/// `path` is written `$` for the document itself, `.name` for a member and
/// `[i]` for an element, so `$.center.x` and `$.tags[2]` name a place a reader
/// can find in the text in front of them.
export enum DecodeError {
  /// An object with no member of that name.
  Missing { path: Str },
  /// A value of the wrong shape: what the type wanted, and what was there.
  WrongType { path: Str, wanted: Str, found: Str },
  /// A tag naming no variant of the enum being read.
  UnknownVariant { path: Str, tag: Str },
}

derive Eq, Show for DecodeError;

/// Encodes any `ToJson` value.
///
/// ```buri run
/// from "core/effect" import { Alloc, Stdout };
/// from "core/host" import * as host;
/// from "core/json" import { DecodeError, ToJson, FromJson };
/// from "core/json" import * as json;
///
/// struct Point { x: Int, y: Int }
/// derive Eq, ToJson, FromJson for Point;
///
/// enum Shape {
///   Dot,
///   Line(Point, Point),
/// }
/// derive Eq, ToJson, FromJson for Shape;
///
/// export fn main(): Result<(), Str> {
///   let ctx = context { Alloc: host.alloc, Stdout: host.stdout };
///   let shape = Shape.Line(Point { x: 0, y: 0 }, Point { x: 3, y: 4 });
///   let text = json.stringify(ctx, json.encode(ctx, shape));
///   let _ = ctx.println(text);
///
///   // The type comes from the annotation, not from a type argument.
///   let back: Result<Shape, DecodeError> = json.decode(ctx, json.encode(ctx, shape));
///   let _ = ctx.println("${back == .Ok(shape)}");
///   .Ok(())
/// }
/// ```
///
/// ```stdout
/// {"Line":[{"x":0,"y":0},{"x":3,"y":4}]}
/// true
/// ```
export fn encode<T: ToJson, C: Alloc>(ctx: C, value: T): Json {
  value.toJson(ctx)
}

/// Reads a `Json` as a `T`, or says where it stopped.
///
/// **The type comes from the annotation.** `decode` is generic in both the
/// type being read and the context it allocates in, and a written type
/// argument list has to name every argument — a context type has no name to
/// write (SPEC 11.3), so there is nothing to put in the second slot. Write the type on the
/// binding instead — `let point: Result<Point, DecodeError> = json.decode(ctx,
/// doc);` — as the example on `encode` does.
export fn decode<T: FromJson, C: Alloc>(ctx: C, value: Json): Result<T, DecodeError>;
