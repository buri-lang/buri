//! core/bits — bit manipulation.
//!
//! `shl` and `shr` are functions, not operators. Buri has no `<<` or `>>`
//! token: longest-match lexing would read the `>>` that closes nested type
//! arguments as a shift. Dropping the operators removes the problem instead of
//! papering over it with a position-dependent lexer (design/grammar-rationale.md 12.6).

/// Shifting by a count at or beyond the width of the type aborts. Overflow is
/// undefined, but a bad shift count has no defensible answer at all, and the
/// guard is a comparison the shift already needs.
export fn shl(x: Int, n: Int): Int;

export fn shr(x: Int, n: Int): Int;

/// Arithmetic shift right: the sign bit repeats into the vacated places.
export fn sar(x: Int, n: Int): Int;

export fn popCount(x: Int): Int;

export fn leadingZeros(x: Int): Int;

export fn trailingZeros(x: Int): Int;

export fn rotateLeft(x: Int, n: Int): Int;

export fn rotateRight(x: Int, n: Int): Int;

export fn shlU8(x: U8, n: Int): U8;

export fn shrU8(x: U8, n: Int): U8;

export fn shlU32(x: U32, n: Int): U32;

export fn shrU32(x: U32, n: Int): U32;

export fn shlU64(x: U64, n: Int): U64;

export fn shrU64(x: U64, n: Int): U64;
