//! core/env — environment variables, process arguments, and where the process
//! is.
//!
//! Everything here names `Environment`, so a program that never binds it cannot read a
//! variable anywhere in its call graph. `temporaryDirectory` and
//! `homeDirectory` are `TMPDIR` and `HOME` read through [`get`] and turned into
//! a `Path`: no separate authority, because there is nothing separate to grant.

from "core/effect" import { Allocator, Environment };
from "core/path" import * as path;
from "core/path" import { Path };

from "core/path" export { Path };

export fn get<C: Environment>(ctx: C, name: Str): Option<Str> {
    ctx.variable(name)
}

export fn args<C: Environment>(ctx: C): [Str] {
    ctx.arguments()
}

/// The directory the process is running in, as a `Path`.
///
/// ```buri role=std
/// # from "core/effect" import { Allocator, Environment, Stdout };
/// # from "core/env" import * as env;
/// # from "core/io" import * as io;
///
/// export fn here<C: Allocator + Environment + Stdout>(ctx: C): () {
///     io.println(ctx, "${env.currentDirectory(ctx).text()}").ignore()
/// }
/// ```
///
/// It is where the process *is*, which a program can neither set nor rely on:
/// a shell picked it. `core/fs` resolves every relative path against it.
export fn currentDirectory<C: Allocator + Environment>(ctx: C): Path {
    path.of(ctx, ctx.currentDirectory())
}

/// Every variable, as `(name, value)` pairs.
///
/// In the platform's own order, which is not sorted and not stable across
/// runs — sort it where the order matters. A name appears once.
export fn all<C: Allocator + Environment>(ctx: C): [(Str, Str)] {
    ctx.allVariables()
}

/// Where to write a scratch file: `TMPDIR`, or `/tmp` where nothing set it.
///
/// The directory, not a file in it, and nothing here creates one.
/// `fs.makeTemporaryDirectory` is the call that does.
///
/// `TMPDIR=` is `/tmp` too — see [`named`].
export fn temporaryDirectory<C: Allocator + Environment>(ctx: C): Path {
    path.of(ctx, named(ctx, "TMPDIR").withDefault("/tmp"))
}

/// The user's home directory, from `HOME`, or `.None` where nothing set it.
///
/// `.None` rather than a guess: a daemon, a container and a `sudo` with a
/// scrubbed environment all run with no home, and inventing `/root` for them
/// writes a file somewhere nobody asked for. `HOME=` is one of those runs — see
/// [`named`].
export fn homeDirectory<C: Allocator + Environment>(ctx: C): Option<Path> {
    match (named(ctx, "HOME")) {
        .None => .None,
        .Some(text) => .Some(path.of(ctx, text)),
    }
}

/// The variable's value, where it names something: unset and empty are both
/// `.None`.
///
/// A scrubbed environment spells "no value" as `HOME=`, and the two directories
/// above read it that way — an empty `HOME` is no home rather than a home
/// called `.`, and an empty `TMPDIR` is `/tmp` rather than the directory the
/// process happens to be standing in. [`get`] is the other reading: it answers
/// what is set, empty string included, because a program asking for its own
/// variable is asking what the value *is*.
fn named<C: Environment>(ctx: C, name: Str): Option<Str> {
    match (ctx.variable(name)) {
        .None => .None,
        .Some(value) => if (value == "") { .None } else { .Some(value) },
    }
}

/// The operating system's short name, in lower case.
///
/// `"linux"`, `"macos"` and `"windows"` are the ones a build of this toolchain
/// can produce; anything else is the platform's own word for itself, passed
/// through unchanged. `core/host/testing`'s `env()` answers `"test"`, because a
/// double is not an operating system.
export fn operatingSystem<C: Environment>(ctx: C): Str {
    ctx.operatingSystemName()
}
