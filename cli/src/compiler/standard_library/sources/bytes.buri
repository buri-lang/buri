//! core/bytes — sequences of octets.
//!
//! A byte string is a `[U8]`, which is an ordinary list: `len`, `get`, `slice`
//! and the rest come from `core/list` and are not repeated here. What this
//! module adds is the two things a list of numbers cannot do for itself —
//! turning text into bytes and back, and the encodings that get bytes through
//! something that only carries text.
//!
//! **These are free functions, not methods on `[U8]`.** A method may only be
//! declared in its type's defining module (SPEC 6.7.3), and `[T]`'s is
//! `core/list`. An `impl [U8]` here would declare a method the compiler cannot
//! find.
//!
//! **Decoding is strict.** An overlong UTF-8 encoding, a truncated sequence, or
//! a surrogate is an error rather than a replacement character: bytes that are
//! not text should say so, not turn into `?` and be discovered three layers
//! later. Each decoder is a `foldResultCtx` — accumulate, and stop at the first
//! byte that is not what it claims — so the index a failure reports is the one
//! it stopped at rather than one recomputed afterwards.
//!
//! ```buri run
//! from "core/bytes" import * as bytes;
//! from "core/effect" import { Alloc, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let raw = bytes.toUtf8(ctx, "hi €");
//!     // Four characters, six bytes: the euro sign is three of them.
//!     let _ = io
//!         .println(
//!             ctx,
//!             "${raw.len()} bytes, ${bytes.toHex(ctx, raw)}, ${bytes.toBase64(ctx, raw)}",
//!         )
//!         .ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 6 bytes, 686920e282ac, aGkg4oKs
//! ```

from "core/bits" import * as bits;
from "core/char" import * as char;
from "core/effect" import { Alloc };
from "core/list" import * as list;
from "core/str" import * as str;

derive Eq, Show for Utf8Error;
/// Where a byte sequence stopped being UTF-8: the index of the first byte that
/// could not be part of a valid encoding.
export struct Utf8Error(export Int);

derive Eq, Show for DecodeError;
/// Where a decoding stopped making sense.
export struct DecodeError(export Int);

/// The UTF-8 encoding of a string.
///
/// An intrinsic rather than Buri: how a string is stored is the platform's
/// business — UTF-8 natively, UTF-16 code units on JavaScript — so the encoding
/// is a transcode the platform already has rather than something to rebuild on
/// top of `charAt`.
export fn toUtf8<C: Alloc>(ctx: C, s: Str): [U8];

/// The string those bytes encode, or where they stopped being one.
export fn fromUtf8<C: Alloc>(ctx: C, b: [U8]): Result<Str, Utf8Error>;

// --- Hexadecimal ---------------------------------------------------------------

let HEX: Str = "0123456789abcdef";

/// Lowercase, two characters per byte, no separator.
export fn toHex<C: Alloc>(ctx: C, b: [U8]): Str {
    b
        .mapCtx(ctx, fn(c, x) => {
            let n = x.toI64();
            str.fromChars(c, [
                HEX.charAt(n / 16).withDefault('0'),
                HEX.charAt(n % 16).withDefault('0'),
            ])
        })
        .join(ctx, "")
}

/// Reads either case. An odd number of digits, or a character that is not one,
/// is an error at the offending index.
export fn fromHex<C: Alloc>(ctx: C, text: Str): Result<[U8], DecodeError> {
    let cs = text.chars(ctx);
    if (cs.len() % 2 != 0) {
        .Err(DecodeError(cs.len()))
    } else {
        list
            .range(ctx, 0, cs.len() / 2)
            .foldResultCtx(
                ctx,
                fn(c, acc: [U8], i) => {
                    let hi = cs.get(i * 2).andThen(fn(ch) => ch.toDigit(16));
                    let lo = cs.get(i * 2 + 1).andThen(fn(ch) => ch.toDigit(16));
                    match ((hi, lo)) {
                        (.Some(h), .Some(l)) => {
                            .Ok(acc.push(c, (h * 16 + l).wrapToU8()))
                        },
                        // The index of the pair that failed, not of the whole string: a
                        // decoder that only says "somewhere" is one you debug by bisection.
                        (.None, _) => .Err(DecodeError(i * 2)),
                        _ => .Err(DecodeError(i * 2 + 1)),
                    }
                },
                list.empty<U8>(),
            )
    }
}

// --- Base64 ---------------------------------------------------------------------
//
// The standard alphabet, always padded. No URL-safe variant and no unpadded
// form: two spellings of one encoding is two things to get wrong, and a caller
// who needs one can replace two characters.

let B64: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

export fn toBase64<C: Alloc>(ctx: C, b: [U8]): Str {
    let n = b.len();
    list
        .range(ctx, 0, (n + 2) / 3)
        .mapCtx(ctx, fn(c, g) => {
            let i = g * 3;
            let b0 = b.get(i).withDefault(0).toI64();
            let b1 = b.get(i + 1).withDefault(0).toI64();
            let b2 = b.get(i + 2).withDefault(0).toI64();
            let left = n - i;
            str.fromChars(c, [
                B64.charAt(b0 / 4).withDefault('A'),
                B64.charAt(b0 % 4 * 16 + b1 / 16).withDefault('A'),
                if (left > 1) {
                    B64.charAt(b1 % 16 * 4 + b2 / 64).withDefault('A')
                } else {
                    '='
                },
                if (left > 2) { B64.charAt(b2 % 64).withDefault('A') } else { '=' },
            ])
        })
        .join(ctx, "")
}

export fn fromBase64<C: Alloc>(ctx: C, text: Str): Result<[U8], DecodeError> {
    let cs = text.chars(ctx);
    if (cs.len() % 4 != 0 || cs.len() == 0) {
        if (cs.len() == 0) {
            .Ok(list.empty<U8>())
        } else {
            .Err(DecodeError(cs.len()))
        }
    } else {
        match (firstNonBase64(cs, 0, cs.len())) {
            .Some(i) => .Err(DecodeError(i)),
            .None => {
                let groups = cs.len() / 4;
                let pad = padding(cs);
                let bytes = list
                    .range(ctx, 0, groups)
                    .map(ctx, fn(g) => {
                        let i = g * 4;
                        let a = sextet(cs.get(i));
                        let b = sextet(cs.get(i + 1));
                        let c = sextet(cs.get(i + 2));
                        let d = sextet(cs.get(i + 3));
                        [
                            (a * 4 + b / 16).wrapToU8(),
                            (b % 16 * 16 + c / 4).wrapToU8(),
                            (c % 4 * 64 + d).wrapToU8(),
                        ]
                    })
                    .flatten(ctx);
                .Ok(bytes.take(ctx, bytes.len() - pad))
            },
        }
    }
}

/// How many of the trailing bytes the padding says are not there.
fn padding(cs: [Char]): Int {
    let n = cs.len();
    let last = cs.get(n - 1).withDefault('A');
    let before = cs.get(n - 2).withDefault('A');
    if (last == '=' && before == '=') { 2 } else if (last == '=') { 1 } else { 0 }
}

/// The alphabet position of a character, or 0 — the caller has already checked
/// that every character is in the alphabet.
fn sextet(c: Option<Char>): Int {
    match (c) {
        .None => 0,
        .Some(ch) => if (ch == '=') { 0 } else { alphabetIndex(ch, 0) },
    }
}

fn alphabetIndex(ch: Char, i: Int): Int {
    match (B64.charAt(i)) {
        .None => 0,
        .Some(b) => if (b == ch) { i } else { alphabetIndex(ch, i + 1) },
    }
}

/// Pure validation: every character is in the alphabet, and `=` appears only in
/// the last one or two positions.
fn firstNonBase64(cs: [Char], i: Int, n: Int): Option<Int> {
    match (cs.get(i)) {
        .None => .None,
        .Some(c) => {
            if (c == '=') {
                if (i >= n - 2) { firstNonBase64(cs, i + 1, n) } else { .Some(i) }
            } else if (inAlphabet(c, 0)) {
                firstNonBase64(cs, i + 1, n)
            } else {
                .Some(i)
            }
        },
    }
}

fn inAlphabet(ch: Char, i: Int): Bool {
    match (B64.charAt(i)) {
        .None => false,
        .Some(b) => b == ch || inAlphabet(ch, i + 1),
    }
}

// --- Varints -----------------------------------------------------------------------
//
// Base 128, little end first, the high bit of every byte but the last set. It
// is here for the same reason hex and base64 are: it is an encoding of a number
// as bytes, it has exactly one definition, and `core/proto` and anything else
// that speaks a length-prefixed wire format needs the same one.
//
// **Sixty-four bits, in two halves.** A varint carries 64 bits and the
// arithmetic below is done on two 32-bit halves rather than on the value, so
// `toVarint` of a negative number writes the ten bytes of its two's complement
// — what a protobuf `int64` field holds — and `readVarint` reads all ten back.
// The halves were once also a way around a 2^53 ceiling; they are not any more
// (`core/num`), and every digit round-trips on every backend.

let TWO32: Int = 4294967296;

/// The varint encoding of `value`.
///
/// A negative value is ten bytes: its two's complement at 64 bits, exactly as
/// protocol buffers writes a negative `int64`. Encoding a negative number as a
/// zigzag instead — `toVarint(ctx, zigzag(x))` — is two bytes for -1 rather
/// than ten, which is the whole reason `sint64` exists.
export fn toVarint<C: Alloc>(ctx: C, value: Int): [U8] {
    if (value < 0) {
        let a = 0 - value;
        let alo = a % TWO32;
        let ahi = (a - alo) / TWO32;
        let borrow = if (alo > 0) { 1 } else { 0 };
        varintBytes(ctx, (TWO32 - ahi - borrow) % TWO32, (TWO32 - alo) % TWO32)
    } else {
        let lo = value % TWO32;
        varintBytes(ctx, (value - lo) / TWO32, lo)
    }
}

/// Seven bits at a time off the low end of a 64-bit value held as two halves.
/// The carry from the high half into the low one is `hi % 128` scaled by 2^25,
/// which is what makes this exact where `value / 128` on the whole number would
/// not be.
fn varintBytes<C: Alloc>(ctx: C, hi: Int, lo: Int): [U8] {
    let byte = lo % 128;
    let nextLo = (lo - byte) / 128 + hi % 128 * 33554432;
    let nextHi = (hi - hi % 128) / 128;
    if (nextHi == 0 && nextLo == 0) {
        [byte.wrapToU8()]
    } else {
        [(byte + 128).wrapToU8()].concat(ctx, varintBytes(ctx, nextHi, nextLo))
    }
}

/// The varint beginning at `at`: its value, and the index just past it.
///
/// An encoding that runs off the end of the input, or past ten bytes, is an
/// error at the index it started from — a truncated varint has no partial
/// reading, so there is nothing to return but where it began.
export fn readVarint(b: [U8], at: Int): Result<(Int, Int), DecodeError> {
    match (varintEnd(b, at, 0)) {
        .None => .Err(DecodeError(at)),
        .Some(end) => .Ok((varintValue(b, at, end - 1, 0, 0), end)),
    }
}

/// The same varint, read as its low 32 bits.
///
/// Not `readVarint(...) % 2^32`: a varint carries 64 bits and an `Int` is
/// exact to 53, so the whole number may already have rounded by the time it
/// could be truncated. This keeps the low half from the start, which is exact
/// for every input — and the low half is what a 32-bit field is.
export fn readVarint32(b: [U8], at: Int): Result<(Int, Int), DecodeError> {
    match (varintEnd(b, at, 0)) {
        .None => .Err(DecodeError(at)),
        .Some(end) => .Ok((varintLow(b, at, end - 1, 0), end)),
    }
}

fn varintLow(b: [U8], at: Int, i: Int, lo: Int): Int {
    if (i < at) {
        lo
    } else {
        let g = b.get(i).withDefault(0).toI64() % 128;
        varintLow(b, at, i - 1, (lo * 128 + g) % TWO32)
    }
}

fn varintEnd(b: [U8], i: Int, taken: Int): Option<Int> {
    if (taken >= 10) {
        .None
    } else {
        match (b.get(i)) {
            .None => .None,
            .Some(x) => {
                if (x.toI64() < 128) {
                    .Some(i + 1)
                } else {
                    varintEnd(b, i + 1, taken + 1)
                }
            },
        }
    }
}

/// Folds the groups from the most significant end down, so no power of two is
/// ever needed: each step is a multiply by 128 with a carry between the halves.
fn varintValue(b: [U8], at: Int, i: Int, hi: Int, lo: Int): Int {
    if (i < at) {
        joinHalves(hi, lo)
    } else {
        let g = b.get(i).withDefault(0).toI64() % 128;
        let wide = lo * 128 + g;
        let nextLo = wide % TWO32;
        varintValue(b, at, i - 1, (hi * 128 + (wide - nextLo) / TWO32) % TWO32, nextLo)
    }
}

/// Two 32-bit halves read as one signed 64-bit number. A value with the top bit
/// set comes back negative, which is what a signed reading of those bits is —
/// and is why a `uint64` above 2^63 reads as a negative `Int`.
fn joinHalves(hi: Int, lo: Int): Int {
    if (hi >= 2147483648) { (hi - TWO32) * TWO32 + lo } else { hi * TWO32 + lo }
}

/// The zigzag transform: a small negative number becomes a small positive one,
/// so that a varint of it is short. -1 is 1, 1 is 2, -2 is 3.
export fn zigzag(x: Int): Int {
    if (x < 0) { (0 - x) * 2 - 1 } else { x * 2 }
}

/// Its inverse.
export fn unzigzag(n: Int): Int {
    if (n % 2 == 0) { n / 2 } else { 0 - (n + 1) / 2 }
}

// --- Fixed-width numbers ------------------------------------------------------------
//
// Little-endian, because that is the byte order every fixed-width protobuf
// field uses. The two float conversions are intrinsics for the same reason
// `toUtf8` is: the bit pattern of a `Float` belongs to the platform, and
// rebuilding it out of arithmetic would be a second definition of the same
// thing that could disagree with the first.

/// The eight bytes of an IEEE 754 double.
export fn f64ToBytes<C: Alloc>(ctx: C, x: Float): [U8];

/// The double encoded by the eight bytes at `at`, or `.None` if there are not
/// eight. A NaN comes back as the canonical quiet NaN on every backend: the
/// payload bits are not part of a `Float`'s value (SPEC 6.2 — every NaN is `==`
/// every other), and a backend where a `Float` is a JavaScript `number` cannot
/// carry them. The sign of a zero is preserved.
export fn f64FromBytes(b: [U8], at: Int): Option<Float>;

/// The four bytes of an IEEE 754 single. A `Float` that is not representable at
/// single precision is rounded, exactly as storing one in a `float` field does.
export fn f32ToBytes<C: Alloc>(ctx: C, x: Float): [U8];

/// The double the four bytes at `at` encode, or `.None` if there are not four.
/// A NaN is canonicalized, as it is at eight bytes.
export fn f32FromBytes(b: [U8], at: Int): Option<Float>;

// --- Fixed-width integers -------------------------------------------------------
//
// The float pair above is little-endian because protobuf is; these are both
// ends, because a length prefix on a network wire is big-endian and a length
// prefix in a file usually is not, and a caller who has to remember which one
// `fromU64` meant will eventually remember wrong.
//
// **Writing is pure.** An array literal of a fixed size allocates nothing a
// context has to grant — the same reason `proto.le32` takes no `ctx` — so
// `fromU64Be(x)` is a pure function and only the readers that produce a *slice*
// name `Alloc`.

/// Eight octets, most significant first.
export fn fromU64Be(x: U64): [U8] {
    [
        bits.shrU64(x, 56).wrapToU8(),
        bits.shrU64(x, 48).wrapToU8(),
        bits.shrU64(x, 40).wrapToU8(),
        bits.shrU64(x, 32).wrapToU8(),
        bits.shrU64(x, 24).wrapToU8(),
        bits.shrU64(x, 16).wrapToU8(),
        bits.shrU64(x, 8).wrapToU8(),
        x.wrapToU8(),
    ]
}

/// Eight octets, least significant first.
export fn fromU64Le(x: U64): [U8] {
    [
        x.wrapToU8(),
        bits.shrU64(x, 8).wrapToU8(),
        bits.shrU64(x, 16).wrapToU8(),
        bits.shrU64(x, 24).wrapToU8(),
        bits.shrU64(x, 32).wrapToU8(),
        bits.shrU64(x, 40).wrapToU8(),
        bits.shrU64(x, 48).wrapToU8(),
        bits.shrU64(x, 56).wrapToU8(),
    ]
}

/// Four octets, most significant first.
export fn fromU32Be(x: U32): [U8] {
    [
        bits.shrU32(x, 24).wrapToU8(),
        bits.shrU32(x, 16).wrapToU8(),
        bits.shrU32(x, 8).wrapToU8(),
        x.wrapToU8(),
    ]
}

/// Four octets, least significant first.
export fn fromU32Le(x: U32): [U8] {
    [
        x.wrapToU8(),
        bits.shrU32(x, 8).wrapToU8(),
        bits.shrU32(x, 16).wrapToU8(),
        bits.shrU32(x, 24).wrapToU8(),
    ]
}

/// The `U64` the eight octets at `at` spell, most significant first, or `.None`
/// if there are not eight of them. `.None` rather than a truncated reading, for
/// the reason `f64FromBytes` gives: a number assembled out of octets that were
/// not there is a wrong answer wearing the shape of a right one.
export fn toU64Be(b: [U8], at: Int): Option<U64> {
    if (at < 0 || at + 8 > b.len()) {
        .None
    } else {
        .Some(
            bits.shlU64(octet64(b, at), 56)
                | bits.shlU64(octet64(b, at + 1), 48)
                | bits.shlU64(octet64(b, at + 2), 40)
                | bits.shlU64(octet64(b, at + 3), 32)
                | bits.shlU64(octet64(b, at + 4), 24)
                | bits.shlU64(octet64(b, at + 5), 16)
                | bits.shlU64(octet64(b, at + 6), 8)
                | octet64(b, at + 7),
        )
    }
}

/// The same eight octets read least significant first.
export fn toU64Le(b: [U8], at: Int): Option<U64> {
    if (at < 0 || at + 8 > b.len()) {
        .None
    } else {
        .Some(
            octet64(b, at)
                | bits.shlU64(octet64(b, at + 1), 8)
                | bits.shlU64(octet64(b, at + 2), 16)
                | bits.shlU64(octet64(b, at + 3), 24)
                | bits.shlU64(octet64(b, at + 4), 32)
                | bits.shlU64(octet64(b, at + 5), 40)
                | bits.shlU64(octet64(b, at + 6), 48)
                | bits.shlU64(octet64(b, at + 7), 56),
        )
    }
}

/// Four octets at `at`, most significant first.
export fn toU32Be(b: [U8], at: Int): Option<U32> {
    if (at < 0 || at + 4 > b.len()) {
        .None
    } else {
        .Some(
            bits.shlU32(octet32(b, at), 24)
                | bits.shlU32(octet32(b, at + 1), 16)
                | bits.shlU32(octet32(b, at + 2), 8)
                | octet32(b, at + 3),
        )
    }
}

/// Four octets at `at`, least significant first.
export fn toU32Le(b: [U8], at: Int): Option<U32> {
    if (at < 0 || at + 4 > b.len()) {
        .None
    } else {
        .Some(
            octet32(b, at)
                | bits.shlU32(octet32(b, at + 1), 8)
                | bits.shlU32(octet32(b, at + 2), 16)
                | bits.shlU32(octet32(b, at + 3), 24),
        )
    }
}

/// The octet at `i` widened, or zero. Every caller has checked the bounds
/// first, so the default is unreachable rather than a decision.
fn octet64(b: [U8], i: Int): U64 {
    b.get(i).withDefault(0).toU64()
}

fn octet32(b: [U8], i: Int): U32 {
    b.get(i).withDefault(0).toU32()
}

// --- A reader -----------------------------------------------------------------------
//
// `readVarint(b, at)` and every `readX` beside it answer a value and the index
// just past it. That is the right shape and the wrong ergonomics: each caller
// threads the index by hand, and each one can thread the wrong one — the index
// a read *began* at is in scope right next to the one it ended at, and they
// have the same type.
//
// A `Reader` is that index given a name. It is an ordinary value, so taking
// does not advance it: a `take` answers the next reader, and a decoder that
// wants to look ahead and change its mind keeps the one it started from. That
// is also why there is no `Builder` here — a value cannot be appended to in
// place, and `[[U8]].flatten` is already the answer for building.
//
// **The methods that only move the cursor are pure; the two that answer a
// `[U8]` name `Alloc`**, because `[T].slice` allocates. A Buri list is a value
// and not a view, so a slice of one is octets copied, and a reader that
// pretended otherwise would be the one place in this module where the tier in
// the signature was a guess.

derive Eq, Show for Reader;
/// A position in a run of octets: the octets, and how far in.
export struct Reader {
    export bytes: [U8],
    export at: Int,
}

/// A reader positioned at the first octet.
export fn reader(b: [U8]): Reader {
    Reader { bytes: b, at: 0 }
}

/// A reader positioned at `at`, for a frame whose header some other decoder
/// already read.
export fn readerAt(b: [U8], at: Int): Reader {
    Reader { bytes: b, at }
}

impl Reader {
    /// Whether every octet has been read.
    export fn isDone(self): Bool {
        self.at >= self.bytes.len()
    }

    /// The next octet, and the reader after it.
    ///
    /// ```buri run
    /// from "core/bytes" import * as bytes;
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     // A tag octet, then a length-prefixed body: the shape every wire
    ///     // format in this repository is some spelling of.
    ///     let frame = [7, 5, 104, 101, 108, 108, 111];
    ///     let (tag, afterTag) = bytes.reader(frame).takeByte().mapErr(fn(_e) => "short")?;
    ///     let (body, rest) = afterTag.takeFramed(ctx).mapErr(fn(_e) => "short")?;
    ///     let text = bytes.fromUtf8(ctx, body).mapErr(fn(_e) => "not text")?;
    ///     let _ = io.println(ctx, "${tag} ${text} ${rest.isDone()}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 7 hello true
    /// ```
    export fn takeByte(self): Result<(U8, Reader), DecodeError> {
        match (self.bytes.get(self.at)) {
            .None => .Err(DecodeError(self.at)),
            .Some(octet) => .Ok((octet, Reader { ..self, at: self.at + 1 })),
        }
    }

    /// The varint beginning here, and the reader just past it.
    export fn takeVarint(self): Result<(Int, Reader), DecodeError> {
        let (value, next) = readVarint(self.bytes, self.at)?;
        .Ok((value, Reader { ..self, at: next }))
    }

    /// The next `n` octets, copied.
    ///
    /// A negative `n`, or one that runs off the end, is an error at the index
    /// the read began — a truncated slice has no partial reading, so there is
    /// nothing to report but where it started.
    export fn takeSlice<C: Alloc>(
        self,
        ctx: C,
        n: Int,
    ): Result<([U8], Reader), DecodeError> {
        let end = self.at + n;
        if (n < 0 || end > self.bytes.len()) {
            .Err(DecodeError(self.at))
        } else {
            .Ok((self.bytes.slice(ctx, self.at, end), Reader { ..self, at: end }))
        }
    }

    /// A varint length, then that many octets — the framing `core/proto`'s
    /// length-delimited wire type is, and the one a log record or a socket
    /// message is written by hand over and over.
    ///
    /// The error index is where the *frame* began rather than where its body
    /// did, so a caller that reports it points at the record rather than into
    /// the middle of one.
    export fn takeFramed<C: Alloc>(self, ctx: C): Result<([U8], Reader), DecodeError> {
        let (n, afterLength) = self.takeVarint()?;
        match (afterLength.takeSlice(ctx, n)) {
            .Ok(pair) => .Ok(pair),
            .Err(_e) => .Err(DecodeError(self.at)),
        }
    }
}
