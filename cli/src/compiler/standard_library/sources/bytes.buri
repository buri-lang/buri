//! core/bytes — sequences of octets.
//!
//! A byte string is a `[U8]`, an ordinary list: `length`, `get`, `slice` and the
//! rest come from `core/list`, and this module does not repeat them. What it
//! adds is the two things a list of numbers cannot do for itself — turning text
//! into bytes and back, and the encodings that get bytes through something that
//! only carries text.
//!
//! **These are free functions, not methods on `[U8]`.** A method may only be
//! declared in its type's defining module (SPEC 6.7.3), and `[T]`'s is
//! `core/list`.
//!
//! **Decoding is strict.** An overlong UTF-8 encoding, a truncated sequence, or
//! a surrogate is an error, not a replacement character. Each decoder stops at
//! the first byte that is not what it claims, and reports that index.
//!
//! ```buri run
//! from "core/bytes" import * as bytes;
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let raw = bytes.toUtf8(ctx, "hi €");
//!     // Four characters, six bytes: the euro sign is three of them.
//!     let _ = io
//!         .println(
//!             ctx,
//!             "${raw.length()} bytes, ${bytes.toHex(ctx, raw)}, ${bytes.toBase64(ctx, raw)}",
//!         )
//!         .ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 6 bytes, 686920e282ac, aGkg4oKs
//! ```

from "core/bits" import * as bits;
from "core/character" import * as character;
from "core/effect" import { Allocator };
from "core/list" import * as list;
from "core/str" import * as str;

derive Equal, Show for Utf8Error;
/// Where a byte sequence stopped being UTF-8: the index of the first byte that
/// could not be part of a valid encoding.
export struct Utf8Error(export Int);

derive Equal, Show for DecodeError;
/// Where a decoding stopped making sense.
export struct DecodeError(export Int);

/// The UTF-8 encoding of a string.
export fn toUtf8<C: Allocator>(ctx: C, s: Str): [U8];

/// The string those bytes encode, or where they stopped being one.
export fn fromUtf8<C: Allocator>(ctx: C, b: [U8]): Result<Str, Utf8Error>;

/// The same decoding, with every byte that cannot be part of a valid encoding
/// replaced by U+FFFD instead of refused.
///
/// One replacement per *maximal subpart*, which is the Unicode substitution rule
/// and the one `fs.readText` and every browser follow: a truncated three-byte
/// sequence costs one replacement character, not three. Overlongs, surrogates
/// and anything past U+10FFFF are refused a byte at a time, so `ed a0 80` — a
/// lone surrogate — becomes three.
///
/// Reach for this on a body somebody else wrote. Reach for `fromUtf8` on
/// anything whose bytes you have a claim about, because a replacement character
/// is a wrong answer that reads like a right one.
///
/// ```buri run
/// from "core/bytes" import * as bytes;
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     // "hi", then a euro sign with its last byte cut off.
///     let raw: [U8] = [104, 105, 226, 130];
///     let text = bytes.fromUtf8Lossy(ctx, raw);
///     let _ = io.println(ctx, "${text} ${text.length()}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// hi� 3
/// ```
export fn fromUtf8Lossy<C: Allocator>(ctx: C, bytes: [U8]): Str {
    // The substitution happens in the *octets*, and `fromUtf8` then reads them.
    // What `cleaned` answers is valid UTF-8 by construction, so the decoder
    // cannot refuse it and the fallback is unreachable. Building the octets
    // rather than a `[Char]` keeps one decoder in the module: this walk decides
    // what is a sequence, and the intrinsic decides what the string is.
    fromUtf8(ctx, cleaned(ctx, bytes, 0, list.empty<U8>())).withDefault("")
}

/// U+FFFD's own UTF-8 encoding, which is what a bad sequence becomes.
let REPLACEMENT: [U8] = [0xef, 0xbf, 0xbd];

/// The input with every maximal subpart that is not a valid sequence swapped for
/// U+FFFD. Tail-recursive over the whole run.
fn cleaned<C: Allocator>(ctx: C, b: [U8], i: Int, acc: [U8]): [U8] {
    if (i >= b.length()) {
        acc
    } else {
        let lead = b.get(i).withDefault(0).toI64();
        if (lead < 0x80) {
            cleaned(ctx, b, i + 1, acc.push(ctx, b.get(i).withDefault(0)))
        } else {
            let width = sequenceWidth(lead);
            let taken = valid(b, i, width);
            if (taken == width) {
                cleaned(ctx, b, i + width, acc.concat(ctx, b.slice(ctx, i, i + width)))
            } else {
                // The maximal subpart: what was consumed before the byte that
                // did not belong, and never fewer than one byte.
                cleaned(
                    ctx,
                    b,
                    i + if (taken < 1) { 1 } else { taken },
                    acc.concat(ctx, REPLACEMENT),
                )
            }
        }
    }
}

/// How many bytes a lead byte claims, or 1 for a byte that can lead nothing —
/// a continuation byte on its own, `c0`, `c1`, or anything from `f5` up.
fn sequenceWidth(lead: Int): Int {
    if (lead >= 0xc2 && lead <= 0xdf) {
        2
    } else if (lead >= 0xe0 && lead <= 0xef) {
        3
    } else if (lead >= 0xf0 && lead <= 0xf4) {
        4
    } else {
        1
    }
}

/// How many of the `width` bytes at `i` are what the sequence needs. `width`
/// means the whole sequence is there; anything less names the first byte that
/// is not, and a lead byte that leads nothing answers 0.
fn valid(b: [U8], i: Int, width: Int): Int {
    if (width == 1) {
        0
    } else {
        let lead = b.get(i).withDefault(0).toI64();
        // The second byte's range is narrower than 80..bf for four lead bytes,
        // and that is what rejects an overlong encoding and a surrogate before
        // the code point is ever assembled.
        let low = if (lead == 0xe0) {
            0xa0
        } else if (lead == 0xf0) {
            0x90
        } else {
            0x80
        };
        let high = if (lead == 0xed) {
            0x9f
        } else if (lead == 0xf4) {
            0x8f
        } else {
            0xbf
        };
        continuations(b, i, width, low, high, 1)
    }
}

fn continuations(b: [U8], i: Int, width: Int, low: Int, high: Int, at: Int): Int {
    if (at >= width) {
        width
    } else if (i + at >= b.length()) {
        at
    } else {
        let x = b.get(i + at).withDefault(0).toI64();
        let lo = if (at == 1) { low } else { 0x80 };
        let hi = if (at == 1) { high } else { 0xbf };
        if (x < lo || x > hi) {
            at
        } else {
            continuations(b, i, width, low, high, at + 1)
        }
    }
}

// --- Hexadecimal ---------------------------------------------------------------

/// Lowercase, two characters per byte, no separator.
export fn toHex<C: Allocator>(ctx: C, b: [U8]): Str {
    str.fromChars(
        ctx,
        list
            .range(ctx, 0, b.length() * 2)
            .map(ctx, fn(i) => {
                let octet = b.get(i / 2).withDefault(0).toI64();
                let nibble = if (i % 2 == 0) { octet / 16 } else { octet % 16 };
                character.fromDigit(nibble, 16).withDefault('0')
            }),
    )
}

/// Reads either case. An odd number of digits, or a character that is not one,
/// is an error at the offending index.
export fn fromHex<C: Allocator>(ctx: C, text: Str): Result<[U8], DecodeError> {
    let cs = text.chars(ctx);
    if (cs.length() % 2 != 0) {
        .Err(DecodeError(cs.length()))
    } else {
        list
            .range(ctx, 0, cs.length() / 2)
            .foldResultCtx(
                ctx,
                fn(c, acc: [U8], i) => {
                    let hi = cs.get(i * 2).andThen(fn(ch) => ch.toDigit(16));
                    let lo = cs.get(i * 2 + 1).andThen(fn(ch) => ch.toDigit(16));
                    match ((hi, lo)) {
                        (.Some(h), .Some(l)) => {
                            .Ok(acc.push(c, (h * 16 + l).wrapToU8()))
                        },
                        // The index of the character that failed, not of the whole string.
                        (.None, _) => .Err(DecodeError(i * 2)),
                        _ => .Err(DecodeError(i * 2 + 1)),
                    }
                },
                list.empty<U8>(),
            )
    }
}

// --- Base64 ---------------------------------------------------------------------
//
// Two alphabets over one encoder. The standard one is always padded; the URL-safe
// one never is, which is what every format that reaches for it expects.

let B64: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

/// RFC 4648 §5: `-` and `_` where the standard alphabet has `+` and `/`.
let B64URL: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

export fn toBase64<C: Allocator>(ctx: C, b: [U8]): Str {
    encode64(ctx, b, B64)
}

/// The URL- and filename-safe alphabet, **unpadded**: `-` and `_` for `+` and
/// `/`, and no trailing `=`. This is the spelling a JWT, a signed cookie and a
/// URL-safe id use, and the one `fromBase64Url` reads back.
///
/// ```buri run
/// from "core/bytes" import * as bytes;
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let raw: [U8] = [251, 255];
///     let _ = io
///         .println(ctx, "${bytes.toBase64(ctx, raw)} ${bytes.toBase64Url(ctx, raw)}")
///         .ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// +/8= -_8
/// ```
export fn toBase64Url<C: Allocator>(ctx: C, bytes: [U8]): Str {
    withoutPadding(encode64(ctx, bytes, B64URL))
}

fn encode64<C: Allocator>(ctx: C, b: [U8], alphabet: Str): Str {
    let n = b.length();
    list
        .range(ctx, 0, (n + 2) / 3)
        .mapCtx(ctx, fn(c, g) => {
            let i = g * 3;
            let b0 = b.get(i).withDefault(0).toI64();
            let b1 = b.get(i + 1).withDefault(0).toI64();
            let b2 = b.get(i + 2).withDefault(0).toI64();
            let left = n - i;
            str.fromChars(c, [
                alphabet.charAt(b0 / 4).withDefault('A'),
                alphabet.charAt(b0 % 4 * 16 + b1 / 16).withDefault('A'),
                if (left > 1) {
                    alphabet.charAt(b1 % 16 * 4 + b2 / 64).withDefault('A')
                } else {
                    '='
                },
                if (left > 2) {
                    alphabet.charAt(b2 % 64).withDefault('A')
                } else {
                    '='
                },
            ])
        })
        .join(ctx, "")
}

/// Pure: `slice` is a view, so this walks back over the `=`s without copying.
fn withoutPadding(text: Str): Str {
    if (text.endsWith("=")) {
        withoutPadding(text.slice(0, text.length() - 1))
    } else {
        text
    }
}

export fn fromBase64<C: Allocator>(ctx: C, text: Str): Result<[U8], DecodeError> {
    decode64(ctx, text, B64)
}

/// Reads the URL-safe alphabet, padded or not. A length that no base64 has —
/// one character past a group of four — is an error at the end of the input.
export fn fromBase64Url<C: Allocator>(ctx: C, text: Str): Result<[U8], DecodeError> {
    let short = text.length() % 4;
    if (short == 1) {
        .Err(DecodeError(text.length()))
    } else if (short == 0) {
        decode64(ctx, text, B64URL)
    } else {
        decode64(ctx, text.concat(ctx, "=".repeat(ctx, 4 - short)), B64URL)
    }
}

fn decode64<C: Allocator>(ctx: C, text: Str, alphabet: Str): Result<[U8], DecodeError> {
    let cs = text.chars(ctx);
    if (cs.length() % 4 != 0 || cs.length() == 0) {
        if (cs.length() == 0) {
            .Ok(list.empty<U8>())
        } else {
            .Err(DecodeError(cs.length()))
        }
    } else {
        match (firstNonBase64(cs, alphabet, 0, cs.length())) {
            .Some(i) => .Err(DecodeError(i)),
            .None => {
                let groups = cs.length() / 4;
                let pad = padding(cs);
                let bytes = list
                    .range(ctx, 0, groups)
                    .map(ctx, fn(g) => {
                        let i = g * 4;
                        let a = sextet(cs.get(i), alphabet);
                        let b = sextet(cs.get(i + 1), alphabet);
                        let c = sextet(cs.get(i + 2), alphabet);
                        let d = sextet(cs.get(i + 3), alphabet);
                        [
                            (a * 4 + b / 16).wrapToU8(),
                            (b % 16 * 16 + c / 4).wrapToU8(),
                            (c % 4 * 64 + d).wrapToU8(),
                        ]
                    })
                    .flatten(ctx);
                .Ok(bytes.take(ctx, bytes.length() - pad))
            },
        }
    }
}

/// How many of the trailing bytes the padding says are not there.
fn padding(cs: [Char]): Int {
    let n = cs.length();
    let last = cs.get(n - 1).withDefault('A');
    let before = cs.get(n - 2).withDefault('A');
    if (last == '=' && before == '=') { 2 } else if (last == '=') { 1 } else { 0 }
}

/// The alphabet position of a character, or 0 — the caller has already checked
/// that every character is in the alphabet.
fn sextet(c: Option<Char>, alphabet: Str): Int {
    match (c) {
        .None => 0,
        .Some(ch) => if (ch == '=') { 0 } else { alphabetIndex(ch, alphabet, 0) },
    }
}

fn alphabetIndex(ch: Char, alphabet: Str, i: Int): Int {
    match (alphabet.charAt(i)) {
        .None => 0,
        .Some(b) => if (b == ch) { i } else { alphabetIndex(ch, alphabet, i + 1) },
    }
}

/// Pure validation: every character is in the alphabet, and `=` appears only in
/// the last one or two positions.
fn firstNonBase64(cs: [Char], alphabet: Str, i: Int, n: Int): Option<Int> {
    match (cs.get(i)) {
        .None => .None,
        .Some(c) => {
            if (c == '=') {
                if (i >= n - 2) {
                    firstNonBase64(cs, alphabet, i + 1, n)
                } else {
                    .Some(i)
                }
            } else if (inAlphabet(c, alphabet, 0)) {
                firstNonBase64(cs, alphabet, i + 1, n)
            } else {
                .Some(i)
            }
        },
    }
}

fn inAlphabet(ch: Char, alphabet: Str, i: Int): Bool {
    match (alphabet.charAt(i)) {
        .None => false,
        .Some(b) => b == ch || inAlphabet(ch, alphabet, i + 1),
    }
}

// --- Searching, splitting and joining ------------------------------------------
//
// What framing a stream and reading a multipart body need: find a delimiter, cut
// on it, put the pieces back. `core/str` has the same five over text; these are
// the octet versions, and they do not care whether the octets are text at all.
//
// The search is a plain scan, O(n*m) in the worst case and with no
// preprocessing. A delimiter here is a boundary marker or a CRLF, so m is small
// and the table a smarter algorithm would build costs more than it saves.

/// Where `needle` first appears in `haystack`, or `.None`. An empty needle is at
/// 0.
export fn indexOf(haystack: [U8], needle: [U8]): Option<Int> {
    indexOfFrom(haystack, needle, 0)
}

/// The same search, started at `start`. A negative `start` reads as 0, and one
/// past the end answers `.None` — except for an empty needle, which is at the
/// end too.
///
/// The parameter is `start` rather than the `from` the shape suggests, because
/// `from` opens an import.
export fn indexOfFrom(haystack: [U8], needle: [U8], start: Int): Option<Int> {
    scanFor(haystack, needle, if (start < 0) { 0 } else { start })
}

fn scanFor(haystack: [U8], needle: [U8], at: Int): Option<Int> {
    if (at + needle.length() > haystack.length()) {
        .None
    } else if (equalAt(haystack, needle, at, 0)) {
        .Some(at)
    } else {
        scanFor(haystack, needle, at + 1)
    }
}

/// Whether `haystack` begins with `prefix`. An empty prefix always does.
export fn startsWith(haystack: [U8], prefix: [U8]): Bool {
    prefix.length() <= haystack.length() && equalAt(haystack, prefix, 0, 0)
}

/// Whether `haystack` ends with `suffix`. An empty suffix always does.
export fn endsWith(haystack: [U8], suffix: [U8]): Bool {
    suffix.length() <= haystack.length()
        && equalAt(haystack, suffix, haystack.length() - suffix.length(), 0)
}

/// Whether `needle` sits at `at`. Every caller has checked that it fits.
fn equalAt(haystack: [U8], needle: [U8], at: Int, i: Int): Bool {
    if (i >= needle.length()) {
        true
    } else if (haystack.get(at + i).withDefault(0) != needle.get(i).withDefault(0)) {
        false
    } else {
        equalAt(haystack, needle, at, i + 1)
    }
}

/// The pieces between the occurrences of `separator`, empty ones included: n
/// separators give n + 1 pieces. An empty separator answers the whole input as
/// one piece rather than one piece per byte.
export fn split<C: Allocator>(ctx: C, bytes: [U8], separator: [U8]): [[U8]] {
    if (separator.isEmpty()) {
        [bytes]
    } else {
        splitFrom(ctx, bytes, separator, 0, list.empty<[U8]>())
    }
}

fn splitFrom<C: Allocator>(ctx: C, b: [U8], separator: [U8], at: Int, acc: [[U8]]): [[U8]] {
    match (indexOfFrom(b, separator, at)) {
        .Some(i) => {
            splitFrom(
                ctx,
                b,
                separator,
                i + separator.length(),
                acc.push(ctx, b.slice(ctx, at, i)),
            )
        },
        .None => acc.push(ctx, b.slice(ctx, at, b.length())),
    }
}

/// The parts with `separator` between each pair — `split`'s inverse when no part
/// holds the separator.
export fn join<C: Allocator>(ctx: C, parts: [[U8]], separator: [U8]): [U8] {
    list
        .range(ctx, 0, parts.length())
        .mapCtx(ctx, fn(c, i) => {
            let part = parts.get(i).withDefault(list.empty<U8>());
            if (i == 0) { part } else { separator.concat(c, part) }
        })
        .flatten(ctx)
}

// --- Varints -----------------------------------------------------------------------
//
// Base 128, little end first, the high bit of every byte but the last set.
//
// **Sixty-four bits, in two halves.** The arithmetic below works on two 32-bit
// halves rather than on the value, so `toVarint` of a negative number writes the
// ten bytes of its two's complement — what a protobuf `int64` field holds — and
// `readVarint` reads all ten back.

let TWO32: Int = 4294967296;

/// The varint encoding of `value`.
///
/// A negative value is ten bytes: its two's complement at 64 bits, exactly as
/// protocol buffers writes a negative `int64`. Encode a negative number as a
/// zigzag instead — `toVarint(ctx, zigzag(x))` — and -1 costs two bytes rather
/// than ten, which is the whole reason `sint64` exists.
export fn toVarint<C: Allocator>(ctx: C, value: Int): [U8] {
    if (value < 0) {
        let a = 0 - value;
        let alo = a % TWO32;
        let ahi = (a - alo) / TWO32;
        let borrow = if (alo > 0) { 1 } else { 0 };
        varintBytes(ctx, (TWO32 - ahi - borrow) % TWO32, (TWO32 - alo) % TWO32)
    } else {
        let lo = value % TWO32;
        varintBytes(ctx, (value - lo) / TWO32, lo)
    }
}

/// Seven bits at a time off the low end of a 64-bit value held as two halves.
/// The carry from the high half into the low one is `hi % 128` scaled by 2^25.
fn varintBytes<C: Allocator>(ctx: C, hi: Int, lo: Int): [U8] {
    let byte = lo % 128;
    let nextLo = (lo - byte) / 128 + hi % 128 * 33554432;
    let nextHi = (hi - hi % 128) / 128;
    if (nextHi == 0 && nextLo == 0) {
        [byte.wrapToU8()]
    } else {
        [(byte + 128).wrapToU8()].concat(ctx, varintBytes(ctx, nextHi, nextLo))
    }
}

/// The varint beginning at `at`: its value, and the index just past it.
///
/// An encoding that runs off the end of the input, or past ten bytes, is an
/// error at the index it started from.
export fn readVarint(b: [U8], at: Int): Result<(Int, Int), DecodeError> {
    match (varintEnd(b, at, 0)) {
        .None => .Err(DecodeError(at)),
        .Some(end) => .Ok((varintValue(b, at, end - 1, 0, 0), end)),
    }
}

/// The same varint, read as its low 32 bits.
///
/// Not `readVarint(...) % 2^32`: a varint carries 64 bits and an `Int` is exact
/// to 53, so the whole number may already have rounded. This keeps the low half
/// from the start, which is exact for every input.
export fn readVarint32(b: [U8], at: Int): Result<(Int, Int), DecodeError> {
    match (varintEnd(b, at, 0)) {
        .None => .Err(DecodeError(at)),
        .Some(end) => .Ok((varintLow(b, at, end - 1, 0), end)),
    }
}

fn varintLow(b: [U8], at: Int, i: Int, lo: Int): Int {
    if (i < at) {
        lo
    } else {
        let g = b.get(i).withDefault(0).toI64() % 128;
        varintLow(b, at, i - 1, (lo * 128 + g) % TWO32)
    }
}

fn varintEnd(b: [U8], i: Int, taken: Int): Option<Int> {
    if (taken >= 10) {
        .None
    } else {
        match (b.get(i)) {
            .None => .None,
            .Some(x) => {
                if (x.toI64() < 128) {
                    .Some(i + 1)
                } else {
                    varintEnd(b, i + 1, taken + 1)
                }
            },
        }
    }
}

/// Folds the groups from the most significant end down, so it never needs a
/// power of two: each step is a multiply by 128 with a carry between the
/// halves.
fn varintValue(b: [U8], at: Int, i: Int, hi: Int, lo: Int): Int {
    if (i < at) {
        joinHalves(hi, lo)
    } else {
        let g = b.get(i).withDefault(0).toI64() % 128;
        let wide = lo * 128 + g;
        let nextLo = wide % TWO32;
        varintValue(b, at, i - 1, (hi * 128 + (wide - nextLo) / TWO32) % TWO32, nextLo)
    }
}

/// Two 32-bit halves read as one signed 64-bit number. A value with the top bit
/// set comes back negative, which is what a signed reading of those bits is —
/// and is why a `uint64` above 2^63 reads as a negative `Int`.
fn joinHalves(hi: Int, lo: Int): Int {
    if (hi >= 2147483648) { (hi - TWO32) * TWO32 + lo } else { hi * TWO32 + lo }
}

/// The zigzag transform: a small negative number becomes a small positive one,
/// so that a varint of it is short. -1 is 1, 1 is 2, -2 is 3.
export fn zigzag(x: Int): Int {
    if (x < 0) { (0 - x) * 2 - 1 } else { x * 2 }
}

/// Its inverse.
export fn unzigzag(n: Int): Int {
    if (n % 2 == 0) { n / 2 } else { 0 - (n + 1) / 2 }
}

// --- Fixed-width numbers ------------------------------------------------------------
//
// Little-endian, because that is the byte order every fixed-width protobuf
// field uses.

/// The eight bytes of an IEEE 754 double.
export fn f64ToBytes<C: Allocator>(ctx: C, x: Float): [U8];

/// The double encoded by the eight bytes at `at`, or `.None` if there are not
/// eight. A NaN comes back as the canonical quiet NaN on every backend — the
/// payload bits are not part of a `Float`'s value (SPEC 6.2). A zero keeps its
/// sign.
export fn f64FromBytes(b: [U8], at: Int): Option<Float>;

/// The four bytes of an IEEE 754 single. A `Float` that single precision cannot
/// represent rounds, exactly as storing one in a `float` field does.
export fn f32ToBytes<C: Allocator>(ctx: C, x: Float): [U8];

/// The double the four bytes at `at` encode, or `.None` if there are not four.
/// A NaN canonicalizes, as it does at eight bytes.
export fn f32FromBytes(b: [U8], at: Int): Option<Float>;

// --- Fixed-width integers -------------------------------------------------------
//
// These come in both ends, because a length prefix on a network wire is
// big-endian and a length prefix in a file usually is not.
//
// **Writing is pure.** An array literal of a fixed size allocates nothing a
// context has to grant, so `fromU64BigEndian(x)` is a pure function; only the readers
// that produce a *slice* name `Allocator`.

/// Eight octets, most significant first.
export fn fromU64BigEndian(x: U64): [U8] {
    [
        bits.shiftRightU64(x, 56).wrapToU8(),
        bits.shiftRightU64(x, 48).wrapToU8(),
        bits.shiftRightU64(x, 40).wrapToU8(),
        bits.shiftRightU64(x, 32).wrapToU8(),
        bits.shiftRightU64(x, 24).wrapToU8(),
        bits.shiftRightU64(x, 16).wrapToU8(),
        bits.shiftRightU64(x, 8).wrapToU8(),
        x.wrapToU8(),
    ]
}

/// Eight octets, least significant first.
export fn fromU64LittleEndian(x: U64): [U8] {
    [
        x.wrapToU8(),
        bits.shiftRightU64(x, 8).wrapToU8(),
        bits.shiftRightU64(x, 16).wrapToU8(),
        bits.shiftRightU64(x, 24).wrapToU8(),
        bits.shiftRightU64(x, 32).wrapToU8(),
        bits.shiftRightU64(x, 40).wrapToU8(),
        bits.shiftRightU64(x, 48).wrapToU8(),
        bits.shiftRightU64(x, 56).wrapToU8(),
    ]
}

/// Four octets, most significant first.
export fn fromU32BigEndian(x: U32): [U8] {
    [
        bits.shiftRightU32(x, 24).wrapToU8(),
        bits.shiftRightU32(x, 16).wrapToU8(),
        bits.shiftRightU32(x, 8).wrapToU8(),
        x.wrapToU8(),
    ]
}

/// Four octets, least significant first.
export fn fromU32LittleEndian(x: U32): [U8] {
    [
        x.wrapToU8(),
        bits.shiftRightU32(x, 8).wrapToU8(),
        bits.shiftRightU32(x, 16).wrapToU8(),
        bits.shiftRightU32(x, 24).wrapToU8(),
    ]
}

/// Two octets, most significant first. This is the width every length-prefixed
/// record format uses, so it is here beside the other two.
export fn fromU16BigEndian(value: U16): [U8] {
    let v = value.toI64();
    [(v / 256).wrapToU8(), v.wrapToU8()]
}

/// Two octets, least significant first.
export fn fromU16LittleEndian(value: U16): [U8] {
    let v = value.toI64();
    [v.wrapToU8(), (v / 256).wrapToU8()]
}

/// The `U16` the two octets at `at` spell, most significant first, or `.None` if
/// there are not two of them.
export fn toU16BigEndian(bytes: [U8], at: Int): Option<U16> {
    if (at < 0 || at + 2 > bytes.length()) {
        .None
    } else {
        .Some(
            (bytes.get(at).withDefault(0).toI64() * 256
                + bytes.get(at + 1).withDefault(0).toI64()).wrapToU16(),
        )
    }
}

/// The same two octets read least significant first.
export fn toU16LittleEndian(bytes: [U8], at: Int): Option<U16> {
    if (at < 0 || at + 2 > bytes.length()) {
        .None
    } else {
        .Some(
            (bytes.get(at + 1).withDefault(0).toI64() * 256
                + bytes.get(at).withDefault(0).toI64()).wrapToU16(),
        )
    }
}

/// The `U64` the eight octets at `at` spell, most significant first, or `.None`
/// if there are not eight of them — never a truncated reading.
export fn toU64BigEndian(b: [U8], at: Int): Option<U64> {
    if (at < 0 || at + 8 > b.length()) {
        .None
    } else {
        .Some(
            bits.shiftLeftU64(octet64(b, at), 56)
                | bits.shiftLeftU64(octet64(b, at + 1), 48)
                | bits.shiftLeftU64(octet64(b, at + 2), 40)
                | bits.shiftLeftU64(octet64(b, at + 3), 32)
                | bits.shiftLeftU64(octet64(b, at + 4), 24)
                | bits.shiftLeftU64(octet64(b, at + 5), 16)
                | bits.shiftLeftU64(octet64(b, at + 6), 8)
                | octet64(b, at + 7),
        )
    }
}

/// The same eight octets read least significant first.
export fn toU64LittleEndian(b: [U8], at: Int): Option<U64> {
    if (at < 0 || at + 8 > b.length()) {
        .None
    } else {
        .Some(
            octet64(b, at)
                | bits.shiftLeftU64(octet64(b, at + 1), 8)
                | bits.shiftLeftU64(octet64(b, at + 2), 16)
                | bits.shiftLeftU64(octet64(b, at + 3), 24)
                | bits.shiftLeftU64(octet64(b, at + 4), 32)
                | bits.shiftLeftU64(octet64(b, at + 5), 40)
                | bits.shiftLeftU64(octet64(b, at + 6), 48)
                | bits.shiftLeftU64(octet64(b, at + 7), 56),
        )
    }
}

/// Four octets at `at`, most significant first.
export fn toU32BigEndian(b: [U8], at: Int): Option<U32> {
    if (at < 0 || at + 4 > b.length()) {
        .None
    } else {
        .Some(
            bits.shiftLeftU32(octet32(b, at), 24)
                | bits.shiftLeftU32(octet32(b, at + 1), 16)
                | bits.shiftLeftU32(octet32(b, at + 2), 8)
                | octet32(b, at + 3),
        )
    }
}

/// Four octets at `at`, least significant first.
export fn toU32LittleEndian(b: [U8], at: Int): Option<U32> {
    if (at < 0 || at + 4 > b.length()) {
        .None
    } else {
        .Some(
            octet32(b, at)
                | bits.shiftLeftU32(octet32(b, at + 1), 8)
                | bits.shiftLeftU32(octet32(b, at + 2), 16)
                | bits.shiftLeftU32(octet32(b, at + 3), 24),
        )
    }
}

/// The octet at `i` widened, or zero. Every caller checks the bounds first.
fn octet64(b: [U8], i: Int): U64 {
    b.get(i).withDefault(0).toU64()
}

fn octet32(b: [U8], i: Int): U32 {
    b.get(i).withDefault(0).toU32()
}

// --- A reader -----------------------------------------------------------------------
//
// `readVarint(b, at)` and every `readX` beside it answer a value and the index
// just past it, leaving each caller to thread the index by hand. A `Reader` is
// that index given a name.
//
// It is an ordinary value, so taking does not advance it: a `take` answers the
// next reader, and a decoder that wants to look ahead and change its mind keeps
// the one it started from. For building, `[[U8]].flatten` is the answer.
//
// **The methods that only move the cursor are pure; the two that answer a
// `[U8]` name `Allocator`**, because `[T].slice` copies.

derive Equal, Show for Reader;
/// A position in a run of octets: the octets, and how far in.
export struct Reader {
    export bytes: [U8],
    export at: Int,
}

/// A reader positioned at the first octet.
export fn reader(b: [U8]): Reader {
    Reader { bytes: b, at: 0 }
}

/// A reader positioned at `at`, for a frame whose header some other decoder
/// already read.
export fn readerAt(b: [U8], at: Int): Reader {
    Reader { bytes: b, at }
}

impl Reader {
    /// Whether every octet has been read.
    export fn isDone(self): Bool {
        self.at >= self.bytes.length()
    }

    /// The next octet, and the reader after it.
    ///
    /// ```buri run
    /// from "core/bytes" import * as bytes;
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     // A tag octet, then a length-prefixed body: the shape every wire
    ///     // format in this repository is some spelling of.
    ///     let frame = [7, 5, 104, 101, 108, 108, 111];
    ///     let (tag, afterTag) = bytes.reader(frame).takeByte().mapErr(fn(_e) => "short")?;
    ///     let (body, rest) = afterTag.takeFramed(ctx).mapErr(fn(_e) => "short")?;
    ///     let text = bytes.fromUtf8(ctx, body).mapErr(fn(_e) => "not text")?;
    ///     let _ = io.println(ctx, "${tag} ${text} ${rest.isDone()}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 7 hello true
    /// ```
    export fn takeByte(self): Result<(U8, Reader), DecodeError> {
        match (self.bytes.get(self.at)) {
            .None => .Err(DecodeError(self.at)),
            .Some(octet) => .Ok((octet, Reader { ..self, at: self.at + 1 })),
        }
    }

    /// The varint beginning here, and the reader just past it.
    export fn takeVarint(self): Result<(Int, Reader), DecodeError> {
        let (value, next) = readVarint(self.bytes, self.at)?;
        .Ok((value, Reader { ..self, at: next }))
    }

    /// The next `n` octets, copied.
    ///
    /// A negative `n`, or one that runs off the end, is an error at the index
    /// the read began.
    export fn takeSlice<C: Allocator>(
        self,
        ctx: C,
        n: Int,
    ): Result<([U8], Reader), DecodeError> {
        let end = self.at + n;
        if (n < 0 || end > self.bytes.length()) {
            .Err(DecodeError(self.at))
        } else {
            .Ok((self.bytes.slice(ctx, self.at, end), Reader { ..self, at: end }))
        }
    }

    /// A varint length, then that many octets — the framing `core/proto`'s
    /// length-delimited wire type uses.
    ///
    /// The error index is where the *frame* began rather than where its body
    /// did.
    export fn takeFramed<C: Allocator>(self, ctx: C): Result<([U8], Reader), DecodeError> {
        let (n, afterLength) = self.takeVarint()?;
        match (afterLength.takeSlice(ctx, n)) {
            .Ok(pair) => .Ok(pair),
            .Err(_e) => .Err(DecodeError(self.at)),
        }
    }
}
