//! ui/theme — what a package's design tokens mean, decided by the app.
//!
//! A library that uses tokens declares its own closed vocabulary as an ordinary
//! enum and styles itself against that. The app closes the loop at mount with
//! one theme per library, mapping that library's tokens to its own or to raw
//! values. Exhaustiveness is the whole contract: when a library adds a token,
//! every consumer fails to compile until its theme maps it
//! (`design/ui-reactivity.md` §Design tokens).
//!
//! **The package that owns a vocabulary writes a `themed`.** That is one small
//! function taking a mapping, `fn(Token) => Color`, and answering the `themed`
//! below applied to one binding per token: `(Token.Surface.color(),
//! f(.Surface))`, and so on down the enum. Only that package knows what its
//! tokens are.
//!
//! **The app that uses the package writes the mapping.** It is an ordinary
//! function whose `match` over the package's enum is the compatibility check.
//! The app hands `cardlib.themed(cardTheme)` to `mount`, alongside one entry
//! for every other package it uses. The guide's standard-library page works the
//! example through under "Design tokens".
//!
//! A binding's left half is the token *written the way the owning package
//! writes it*. Its right half is what that token is worth, and it may be another
//! token, so a library's token can chain to the app's token to a value. Mount
//! follows the chain once.
//!
//! A token is a custom property, so every class is settled at compile time.
//! Installing a theme writes one `:root` block of values, and switching one
//! rewrites the same block.

from "core/effect" import { Allocator };
from "core/str" import * as str;
from "ui/effect" import { Scope };
from "ui/prop" import { Prop };
from "ui/style" import { Color, TokenReference };

/// One package's tokens, resolved to values.
///
/// Opaque: `themed` and `switching` build one, and only `mount` reads it. The
/// field is private, so no program outside this module can build a theme or take
/// one apart.
export struct Theme(ThemeKind);

/// What a theme is, kept private so that `Theme` stays opaque. The variant
/// order is load-bearing — the JavaScript runtime reads a theme by its tag.
enum ThemeKind {
    /// Each token, paired with what it is worth.
    Values([(Color, Color)]),
    /// The first list while the condition reads true, the second while it reads
    /// false. Each list holds one theme; an array is how a value refers to its
    /// own type.
    Switching(Prop<Bool>, [Theme], [Theme]),
    /// Which scheme the page is in while this theme applies.
    Scheme(Scheme),
    /// The page's own ground and text colour: a background and a foreground,
    /// landing on the document rather than on any box inside it.
    Page(Color, Color),
}

/// Whether a page is dark or light.
///
/// Not a colour: it is what the *platform* paints its own things in — a native
/// control, the document scrollbar, a date picker, the form autofill. A page
/// that paints itself near-black and never says so gets all of them in white.
export enum Scheme {
    /// A light page.
    Light,
    /// A dark one.
    Dark,
}

/// A package's tokens, resolved.
///
/// Each binding pairs a token — written the way the owning package writes it,
/// which is `Token.Surface.color()` — with the colour it is worth. That colour
/// may be another package's token, and the chain resolves at mount.
///
/// A binding whose left half is not a token names nothing, and `mount` skips
/// it: there is no custom property for `.Rgb(0, 0, 0)` to be the value of.
export fn themed(bindings: [(Color, Color)]): Theme {
    Theme(.Values(bindings))
}

/// Whichever of two themes the condition currently picks. This is dark mode.
///
/// When the condition changes, the runtime rewrites the custom-property block
/// and every class on every element stays as it was. The condition is a
/// `Prop<Bool>`, so it can be a constant, a signal the app writes, or a
/// computation over one.
export fn switching(condition: Prop<Bool>, whenTrue: Theme, whenFalse: Theme): Theme {
    Theme(.Switching(condition, [whenTrue], [whenFalse]))
}

/// A theme that binds no token and says only which scheme the page is in.
///
/// ```buri
/// from "ui/theme" import * as theme;
/// from "ui/theme" import { Theme };
///
/// export fn dark(): Theme {
///     theme.scheme(.Dark)
/// }
/// ```
///
/// It goes in `mount`'s list beside a package's own themes, and it belongs to
/// the app rather than to a package: a library writes `themed` and has no idea
/// which scheme the app is in. `switching` takes one on either side, so the
/// scheme flips with the values it goes with.
export fn scheme(which: Scheme): Theme {
    Theme(.Scheme(which))
}

/// A theme that binds no token and says what the page itself is painted in.
///
/// ```buri
/// from "ui/theme" import * as theme;
/// from "ui/theme" import { Theme };
///
/// export fn night(): Theme {
///     theme.page(.Rgb(10, 10, 10), .Rgb(250, 250, 250))
/// }
/// ```
///
/// The ground of a page belongs to the page. A box inside one paints only as
/// far as it reaches, so a root box leaves the browser's own white behind an
/// overscroll and anywhere it does not cover, and no program can reach `<body>`
/// to say otherwise. This lands there: `background-color` and `color` on the
/// document, in the block `mount` rewrites, so the window is the ground colour
/// to its edges and every box inherits the text colour.
///
/// Either colour may be a token, read the way a class reads one: the value
/// comes from the themes beside it, so what switches those switches the page.
/// It goes in `mount`'s list beside a package's own themes, and `switching`
/// takes one on either side.
export fn page(background: Color, foreground: Color): Theme {
    Theme(.Page(background, foreground))
}

// --- The flattened document --------------------------------------------------
//
// A theme holds closures and a closure cannot cross the C boundary as data, so
// the side that can call one — this one — resolves the switches and hands the
// bindings over as text. `cli/runtime/ui.rs`'s header is the format, and
// `ui/testing`'s `snapshot` is the caller: a snapshot is painted natively, and
// the painter has to know what a token is worth before it can put a colour on a
// pixel.

/// An untracked scope: reading a prop through it records no dependency.
///
/// A snapshot looks at the graph once, so a `switching` theme's condition is
/// read the same way `ui/node`'s walk reads every other prop.
fn rootScope(): Scope;

/// `themes`, flattened to the document the toolchain's own renderer reads.
///
/// This is the seam between a theme and a painter, and nothing else needs it:
/// `mount` installs a theme through the runtime, and this is how the one caller
/// with no runtime to install into — a snapshot — says the same thing. The text
/// is UTF-8 and line-oriented, `buri-theme 1` first, then a `theme` line per
/// applying theme with its bindings under it.
export fn document(themes: [Theme]): Str {
    documentUnder(rootScope(), themes)
}

/// `document`, run under a `Scope` rather than a plain allocator, so a
/// `switching` theme's condition is read through *that* scope.
///
/// A reactive caller — `ui/testing`'s `install` — hands its computation's scope
/// here, so following a switch to its branch subscribes the computation to the
/// condition's signal. Writing that signal then re-runs the flatten, and the
/// block installed changes to the other branch's. The scope is the allocator
/// too, because a `Scope` is one, so the whole flatten runs under it — which is
/// why `document` reaches it with the untracked `rootScope`, whose reads
/// subscribe nothing.
export fn documentUnder(ctx: Scope, themes: [Theme]): Str {
    ["buri-theme 1"].concat(ctx, blocks(ctx, themes, 0, [])).join(ctx, "\n")
}

/// Resolves the flattened `document` `doc` to its custom-property block —
/// following each chain and writing one `:root`/`body`/scheme block per applied
/// theme — installs it as the block `variables` reads, and answers it.
///
/// The resolution is `cli/runtime/ui.rs`'s on the native backend and
/// `$ui_theme_render_doc`'s on the JavaScript one, the two written to agree byte
/// for byte. A switching theme is the caller's business: `ui/testing`'s
/// `install` re-flattens through a tracked scope and installs again, so no
/// closure crosses here.
export fn installDoc(doc: Str): Str;

/// The custom-property block installed right now.
///
/// `ui/testing`'s `variables` answers this, and reading it again after a
/// `switching` condition's signal is written is how a test sees a theme switch.
export fn variables(): Str;

/// The lines of every theme that applies, in the order they were passed.
///
/// A switch is followed to whichever branch its condition picks — read through
/// `ctx`, the scope this runs under — and deciding that in one place is what
/// keeps the block that is written and the map it is resolved through from ever
/// disagreeing about which side of a switch the program is on.
fn blocks(ctx: Scope, themes: [Theme], at: Int, acc: [Str]): [Str] {
    match (themes.get(at)) {
        .None => acc,
        .Some(theme) => {
            let lines = match (theme.0) {
                .Values(bindings) => ["theme"].concat(ctx, binds(ctx, bindings, 0, [])),
                .Switching(condition, whenTrue, whenFalse) => {
                    if (condition.read(ctx)) {
                        blocks(ctx, whenTrue, 0, [])
                    } else {
                        blocks(ctx, whenFalse, 0, [])
                    }
                },
                .Scheme(which) => [str.format(ctx, "scheme ${schemeName(which)}")],
                .Page(background, foreground) => {
                    let ground = colorText(ctx, background);
                    let ink = colorText(ctx, foreground);
                    [str.format(ctx, "page ${ground} ${ink}")]
                },
            };
            blocks(ctx, themes, at + 1, acc.concat(ctx, lines))
        },
    }
}

/// What a scheme is called, in the document and in the declaration alike.
fn schemeName(which: Scheme): Str {
    match (which) {
        .Light => "light",
        .Dark => "dark",
    }
}

/// One theme's bindings, in declaration order.
fn binds<C: Allocator>(ctx: C, bindings: [(Color, Color)], at: Int, acc: [Str]): [Str] {
    match (bindings.get(at)) {
        .None => acc,
        .Some(binding) => {
            let line = bindLine(ctx, binding.0, binding.1);
            binds(ctx, bindings, at + 1, acc.concat(ctx, line))
        },
    }
}

/// One `bind` line, or nothing at all where the left half names no token.
///
/// A binding whose left half is a plain colour names nothing there is a custom
/// property for, and `mount` skips it for the same reason.
fn bindLine<C: Allocator>(ctx: C, left: Color, right: Color): [Str] {
    match (left) {
        .Token(reference) => {
            let name = propertyName(ctx, reference);
            match (right) {
                .Token(other) => {
                    let to = propertyName(ctx, other);
                    [str.format(ctx, "bind ${name} token ${to}")]
                },
                _ => {
                    let value = valueText(ctx, right);
                    [str.format(ctx, "bind ${name} value ${value}")]
                },
            }
        },
        _ => [],
    }
}

/// A colour as CSS, a token included.
///
/// `bindLine` answers a token before `valueText` is reached, because the left
/// half of a binding *is* the property being defined. A page's ground is the
/// other side of that: it is a use, so a token there is the same `var()` a
/// class would have held.
fn colorText<C: Allocator>(ctx: C, color: Color): Str {
    match (color) {
        .Token(reference) => {
            let name = propertyName(ctx, reference);
            str.format(ctx, "var(--${name})")
        },
        _ => valueText(ctx, color),
    }
}

/// The custom property a token reference names, without its leading dashes.
fn propertyName<C: Allocator>(ctx: C, reference: TokenReference): Str {
    let space = reference.namespace();
    let name = reference.name();
    str.format(ctx, "${space}-${name}")
}

/// A colour that is not a token, as CSS — the same text `ui/node`'s walk writes
/// into a declaration.
fn valueText<C: Allocator>(ctx: C, color: Color): Str {
    match (color) {
        .Rgb(r, g, b) => str.format(ctx, "rgb(${r},${g},${b})"),
        .Rgba(r, g, b, a) => str.format(ctx, "rgba(${r},${g},${b},${a})"),
        .Transparent => "transparent",
        .Inherit => "inherit",
        // A token bound to a faded token: the mix is the value, and the
        // `var()` inside it is followed like any other.
        .Faded(reference, a) => {
            let space = reference.namespace();
            let name = reference.name();
            // `50`, not the `50.0` a `Float` shows as, so this and the page's
            // own renderer write one text. `ui/node`'s `cssNumber` says why.
            let shown = str.fromFloat(ctx, a * 100.0);
            let percent = shown.stripSuffix(".0").withDefault(shown);
            str.format(
                ctx,
                "color-mix(in srgb,var(--${space}-${name}) ${percent}%,transparent)",
            )
        },
        // Answered by `bindLine` before this is reached.
        .Token(_) => "",
    }
}
