//! platform/host — the backends' production implementations of the bundled
//! effects.
//!
//! Every struct here has no fields, and every method has no body: the backend
//! supplies it. A platform names these as the fields of its host type, and the
//! CLI builds that host value and hands it to the platform's entry. Only a
//! platform's `platform.buri` may import this module; anywhere else is
//! `host-import-outside-platform`. A program takes the host its platform
//! declares instead, and binds its fields in a `context`:
//!
//! ```buri ignore why="an entry takes its platform's host, and this page is not one"
//! export fn main(host: NativeHost): Result<(), Str> {
//!     run(context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     })
//! }
//! ```

// The filesystem's two effects are declared in `core/fs` rather than
// `platform/effect`, because their methods name `Path`. See that module's header.
from "core/fs" import { FileSystemRead, FileSystemWrite, Metadata };
from "core/path" import { Path };

// And `Spawn` is declared in `core/proc` for the same reason: it names that
// module's own `Command` and `Output`.
from "core/process" import { Output, Spawn };
from "platform/effect" import {
    Allocator, Clock, Connected, Entropy, Environment, Header, IoError, Listen,
    Listener, NetError, Network, Process, Random, Received, Region, Request, Response,
    Serve, ServeError, Sockets, Stderr, Stdin, Stdout, Tasks, Tcp, WebSocketClient,
};

// One `Request`, and it is `platform/effect`'s.
from "ui/effect" import { Location, Scope, Ui, Watch };

export struct HostAllocator {}

impl Allocator for HostAllocator {
    fn allocate(self, bytes: Int): Region;
}

export struct HostStdout {}

impl Stdout for HostStdout {
    fn print(self, text: Template): Result<(), IoError>;

    fn println(self, text: Template): Result<(), IoError>;

    fn writeBytes(self, bytes: [U8]): Result<(), IoError>;
}

export struct HostStderr {}

impl Stderr for HostStderr {
    fn eprint(self, text: Template): Result<(), IoError>;

    fn eprintln(self, text: Template): Result<(), IoError>;
}

export struct HostStdin {}

impl Stdin for HostStdin {
    fn readLine(self): Option<Str>;

    fn readBytes(self, count: Int): Option<[U8]>;
}

/// The platform's filesystem.
///
/// **On `NativeHost` and `NodeHost`.** Not on `WebHost`: a page has no filesystem.
///
/// One value and two effects. A program that binds `FileSystemRead: host.fs` and no
/// `FileSystemWrite` cannot write anywhere in its transitive call graph.
export struct HostFileSystem {}

impl FileSystemRead for HostFileSystem {
    fn readFile(self, path: Path): Result<Str, IoError>;

    fn fileExists(self, path: Path): Bool;

    fn readDir(self, path: Path): Result<[Str], IoError>;

    fn readFileBytes(self, path: Path): Result<[U8], IoError>;

    fn metadata(self, path: Path): Result<Metadata, IoError>;

    fn readRange(self, path: Path, at: Int, count: Int): Result<[U8], IoError>;

    fn realPath(self, path: Path): Result<Str, IoError>;
}

impl FileSystemWrite for HostFileSystem {
    fn writeFile(self, path: Path, body: Str): Result<(), IoError>;

    fn writeFileBytes(self, path: Path, body: [U8]): Result<(), IoError>;

    fn appendFile(self, path: Path, body: [U8]): Result<(), IoError>;

    fn renameFile(self, source: Path, destination: Path): Result<(), IoError>;

    fn removeFile(self, path: Path): Result<(), IoError>;

    fn removeDir(self, path: Path): Result<(), IoError>;

    fn makeDir(self, path: Path): Result<(), IoError>;

    fn syncFile(self, path: Path): Result<(), IoError>;

    fn copyFile(self, source: Path, destination: Path): Result<(), IoError>;
}

/// HTTP and HTTPS requests out.
///
/// **On every host.** On JavaScript it is the platform's own `fetch`. On
/// `native` it is an HTTP/1.1 client, and two things differ:
///
/// * **Redirects come back as they are.** A `3xx` is the response, where
///   JavaScript follows it and answers the final one.
/// * **Certificates are checked against the system's PEM bundle**, which on
///   macOS is `/etc/ssl/cert.pem` and not the keychain. Set `SSL_CERT_FILE` to
///   a PEM file to trust its roots instead.
export struct HostNetwork {}

impl Network for HostNetwork {
    fn fetch(self, request: Request): Result<Response, NetError>;
}

export struct HostClock {}

impl Clock for HostClock {
    fn nowMilliseconds(self): I64;

    fn sleepMilliseconds(self, milliseconds: Int): ();

    fn monotonicNanoseconds(self): I64;
}

export struct HostRandom {}

impl Random for HostRandom {
    fn nextInt(self, low: Int, high: Int): Int;

    fn nextFloat(self): Float;
}

/// The operating system's own generator, for the one thing `HostRandom` does not
/// promise.
///
/// **On every host.** The toolchain varies instead: a runtime archive
/// built without the `crypto` feature answers `cryptography-not-available` before
/// code generation, the way `net` does.
export struct HostEntropy {}

impl Entropy for HostEntropy {
    fn bytes(self, count: Int): [U8];
}

/// The process's variables and arguments.
///
/// **On `NativeHost` and `NodeHost`, and a worker's `core/host`.** A worker's variables
/// are the string bindings in the `env` its platform calls it with — its vars
/// and its secrets — and it has no arguments.
export struct HostEnvironment {}

impl Environment for HostEnvironment {
    fn variable(self, name: Str): Option<Str>;

    fn arguments(self): [Str];

    fn currentDirectory(self): Str;

    fn allVariables(self): [(Str, Str)];

    fn operatingSystemName(self): Str;
}

export struct HostProcess {}

impl Process for HostProcess {
    fn exitWith(self, code: Int): ();
}

/// Running another program.
///
/// **On `NativeHost` and `NodeHost`.** Not on a page or a worker: neither has a
/// process table to put a child in.
///
/// It is a separate grant from `HostProcess` because starting a program is a
/// bigger authority than ending one — a context that can run `sh` can do
/// anything its user can. `core/proc` is the module a program calls; this is
/// what a context binds.
export struct HostSpawn {}

impl Spawn for HostSpawn {
    fn spawnProcess(
        self,
        plan: [Str],
        environment: [Str],
        replaceEnvironment: Bool,
        stdin: [U8],
    ): Result<Output, IoError>;
}

/// Running the program's own work concurrently.
///
/// **On every host, `WebHost` included.** A page's concurrency is its
/// event loop, and `core/tasks`'s `spawn` is how a program puts work on one:
/// a socket that stays open, a retry, a timer. `effect Tasks` has the argument.
///
/// `core/tasks` is the module a program calls; this is what a context binds.
export struct HostTasks {}

impl Tasks for HostTasks {
    fn parallel<C, A, B>(self, ctx: C, items: [A], step: fn(C, Int, A) => B): [B];
}

/// Being a server rather than talking to one.
///
/// **On `NativeHost` alone**, and never on a JavaScript host: a page does not
/// hold a port open.
///
/// The acceptor is `cli/runtime/net.rs`: an HTTP/1.1 server that reads one
/// request at a time on one connection at a time, with a deadline on every
/// step. `core/net/server` is the module a program calls; this is what a
/// context binds.
export struct HostListen {}

impl Listen for HostListen {
    fn listenBind(
        self,
        address: Str,
        port: Int,
        plan: [Serve],
        requestLimit: Int,
        idleTimeoutMilliseconds: Int,
    ): Result<Listener, ServeError>;

    fn listenAccept(self, handle: Int): Result<Int, ServeError>;

    fn listenRequest(self, connection: Int): Result<Request, ServeError>;

    fn listenRespond(
        self,
        connection: Int,
        status: Int,
        headers: [Header],
        body: [U8],
    ): Result<(), ServeError>;

    fn listenClose(self, handle: Int): ();

    fn listenUpgrade(self, connection: Int): Result<Int, ServeError>;

    fn listenReceive(self, socket: Int): Result<Received, ServeError>;
}

/// A connection dialled out, with bytes each way and no protocol over them.
///
/// **On `NativeHost` alone**, beside `HostListen`: a page and a worker have
/// no sockets of their own. The client is `cli/runtime/tcp.rs`, and it is plain
/// `std::net` — no TLS, so a program that needs it speaks it itself or uses
/// `HostNetwork`.
export struct HostTcp {}

impl Tcp for HostTcp {
    fn tcpConnect(self, host: Str, port: Int): Result<Int, IoError>;

    fn tcpRead(self, handle: Int, limit: Int): Result<[U8], IoError>;

    fn tcpWrite(self, handle: Int, body: [U8]): Result<(), IoError>;

    fn tcpClose(self, handle: Int): ();
}

/// Pushing on a connection that is already open.
///
/// **On every host**, because there are two ways to come by a socket
/// and only one of them belongs to a server. `HostListen.listenUpgrade` mints
/// one where a program can accept connections;
/// `HostWebSocketClient.connectSocket` mints one anywhere, a page included. A
/// handle that names no open socket counts as one that has already gone away, so
/// a handle a program made up and a handle it has spent answer alike.
export struct HostSockets {}

impl Sockets for HostSockets {
    fn socketSendText(self, socket: Int, text: Str): ();

    fn socketSendBytes(self, socket: Int, body: [U8]): ();

    fn socketClose(self, socket: Int, code: Int, reason: Str): ();
}

/// Dialling somebody else's WebSocket.
///
/// **On every host.** Holding a port open is a native program's
/// authority; dialling out is not, and a page does it every day. On `web` both
/// methods suspend without holding the event loop, which is the same thing that
/// let `HostNetwork` onto a page.
///
/// Natively the two are `cli/runtime/net.rs`'s, over the same RFC 6455 framing:
/// the socket a client dials and the socket a server accepts are the same value
/// in the same table, so `HostSockets` writes on both without knowing which it
/// has. On JavaScript they wrap the platform's own `WebSocket`.
///
/// `core/net/websocket` is the module a program calls; this is what a context
/// binds.
export struct HostWebSocketClient {}

impl WebSocketClient for HostWebSocketClient {
    fn connectSocket(self, url: Str): Result<Connected, ServeError>;

    fn connectReceive(self, socket: Int): Result<Received, ServeError>;
}

/// The reactive graph. A program with a user interface binds it, and a platform
/// that renders nothing is never asked for one.
export struct HostUi {}

impl Ui for HostUi {
    fn signal<T>(self, initial: T): Int;

    fn read<T>(self, id: Int): T;

    fn write<T>(self, id: Int, value: T): ();

    fn memo<T>(self, compute: fn(Scope) => T): Int;

    fn watch(self, run: fn(Scope) => ()): ();

    fn schedule(self, millis: Int, run: fn(Self) => ()): Int;

    fn unschedule(self, id: Int): ();
}

/// Reading the reactive graph, without the authority to change it.
export struct HostWatch {}

impl Watch for HostWatch {
    fn read<T>(self, id: Int): T;
}

/// The address bar. A page binds it to route on the path it was opened at and
/// to re-route when the reader navigates.
///
/// **On `WebHost` alone**, because nothing else has one. A worker reads the
/// path off the request it was handed, which is `Request.path` and no authority
/// at all.
export struct HostLocation {}

impl Location for HostLocation {
    fn path(self): Int;

    fn push(self, path: Str): ();

    fn replace(self, path: Str): ();
}
