//! ui/prop — a value that may vary.
//!
//! Wherever a value can vary, there is a `Computed` variant taking
//! `fn(Scope) => X`. The runtime supplies the `Scope` at evaluation time, and
//! the closure can never capture one.
//!
//! A component cannot tell which variant it got. One that may write takes the
//! `Signal` itself, or a callback.
//!
//! A `Scope` allocates, so a derivation may map, filter, sort or format:
//! `.Computed(fn(s) => xs.get(s).filter(s, isEven))` is a `Prop<[Int]>`, and
//! `.Computed(fn(s) => str.format(s, "${n.get(s)} items"))` is a `Prop<Str>`
//! that re-renders when the cell moves.
//!
//! `memo` lives here rather than in `ui/signal` because it returns a `Prop`,
//! and a module may not import the module that imports it.

from "ui/effect" import { Scope, Ui };
from "ui/signal" import { Signal };

/// A time-varying value.
export enum Prop<T> {
    /// Never changes. The runtime registers nothing.
    Const(T),
    /// Backed by a writable cell.
    Cell(Signal<T>),
    /// A derivation. Buildable in a pure component, since the `Scope` arrives as
    /// a parameter rather than from an enclosing context — and the `Scope`
    /// allocates, so the derivation may build its answer rather than only pick
    /// one out.
    Computed(fn(Scope) => T),
}

impl<T> Prop<T> {
    /// The current value.
    export fn read(self, ctx: Scope): T {
        match (self) {
            .Const(v) => v,
            .Cell(s) => s.get(ctx),
            .Computed(f) => f(ctx),
        }
    }
}

/// A derived value, computed on demand and cached until something it read
/// changes.
///
/// Lazy: `compute` does not run here, and a memo nothing ever reads never runs.
/// Once read, it re-runs only when a cell it actually read is written. A memo
/// that reads one of two cells depending on a third subscribes to the third and
/// to the branch it took, not to the branch it skipped.
///
/// Whatever reads the memo subscribes to the memo, not to its sources. So when
/// the sources move, the memo recomputes once and everything downstream sees
/// one change.
export fn memo<C: Ui, T>(ctx: C, compute: fn(Scope) => T): Prop<T> {
    let id = ctx.memo(compute);
    .Computed(fn(scope) => scope.read(id))
}
