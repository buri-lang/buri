//! core/alloc — the counting implementations of `Allocator`, and the scope.
//!
//! `core/host` implements `Allocator` the only way a platform can: `allocate`
//! hands back the bytes it was asked for, nothing counts, and no request is
//! ever refused. The three below count, and one of them refuses.
//!
//! They are budgets and accounting policies over the one real allocator, not
//! three allocators (`design/native/MEMORY.md` §7.2). None of the three
//! reserves memory, and swapping one for another changes what a program is
//! *told*, never where a value lives.
//!
//! `scoped` and `Scoped<C>` at the end of this file are the fourth thing, and
//! the only one that is more than accounting. A scope's arena reserves the
//! bytes it charges, serves the body's blocks out of the same mappings, and
//! gives every page back when the scope returns. One value leaves: `body`'s
//! answer, deep-copied out first.
//!
//! ## The charge is defined, not measured
//!
//! The table beside `Allocator` in `core/effect` is the whole cost model. The
//! charge for an operation is a function of the *types*, so the same program
//! charges the same number on every backend and every platform.
//!
//! ## What is counted
//!
//! **Every `allocate(ctx, n)`, at `n` bytes, on both backends. Nothing else.**
//!
//! That is smaller than the cost model. The model charges the list, string and
//! closure rows *by definition* and reports them to *no* allocator: `xs.map(ctx,
//! f)` and `s.split(ctx, ",")` take the context and drop it. On JavaScript the
//! runtime is untyped and has no `stride(T)` to work from; natively the ABI
//! drops the context argument from every `buri_rt_*` call
//! (`backend/runtime_table.rs`), so the function that builds the list never
//! learns which allocator asked.
//!
//! A program that wants those rows counted charges them itself, which is what
//! `strBytes` and its neighbours below are for:
//! `ctx.allocate(alloc.listBytes(xs.len(), 8))` is exactly the model's
//! `16 + n * stride(T)`.
//!
//! ## The counters live outside the values
//!
//! Buri has no mutation, so a running total cannot live in the struct that
//! reports it. Each of the three carries a handle and the total lives beside
//! it. Two consequences:
//!
//!   * **A copy shares its counter.** Pass a `FixedBuffer` into a context and
//!     keep the original, and the budget does not fork.
//!   * **A constructor is *called*.** `alloc.arena()` twice gives two arenas
//!     with two totals, which is what makes an arena per phase expressible.
//!
//! None of the three implements a trait, and none can: SPEC 10.1 forbids a type
//! implementing both an effect and a trait. So `stats` is an inherent method on
//! each, and `Show` sits on `Stats`.
//!
//! ```buri run
//! from "core/alloc" import * as alloc;
//! from "core/effect" import { Allocator, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//!
//! export fn main(): Result<(), Str> {
//!     let gp = alloc.generalPurpose();
//!     let ctx = context {
//!         Allocator: gp,
//!         Stdout: host.stdout,
//!     };
//!     let _ = alloc.allocate(ctx, 64);
//!     let _ = alloc.allocate(ctx, alloc.strBytes(5));
//!     let s = gp.stats();
//!     let _ = io.println(ctx, "${s.allocations} allocations, ${s.bytes} bytes").ignore();
//!
//!     // A budget refuses rather than reports: this one has 32 bytes left.
//!     let buffer = alloc.fixedBuffer(64);
//!     let small = context {
//!         Allocator: buffer,
//!     };
//!     let _ = alloc.allocate(small, 32);
//!     let _ = io.println(ctx, "${buffer.remaining()} of ${buffer.budget} left").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 2 allocations, 85 bytes
//! 32 of 64 left
//! ```

from "core/effect" import {
    Allocator, Clock, Environment, Header, IoError, Listen, Listener, Network, NetError, Process, Random,
    Received, Region, Request, Response, Serve, ServeError, Sockets, Stderr, Stdin,
    Stdout, Tasks,
};

// The filesystem's two effects, and the type their methods take. Declared in
// `core/fs` rather than `core/effect`; see that module's header.
from "core/fs" import { FileSystemRead, FileSystemWrite, Metadata };
from "core/path" import { Path };
from "core/process" import { Output, Spawn };

// --- The door onto the effect -------------------------------------------------

/// `bytes` bytes, charged to whichever allocator the context binds.
///
/// This is `Allocator`'s only operation and the only way to reach it. You perform
/// an effect by handing the context to a function, never by calling a method on
/// it (SPEC 10.2). Everything else in this module is either an allocator to bind
/// or arithmetic over the cost model, and the two meet here:
/// `alloc.allocate(ctx, alloc.listBytes(xs.len(), 8))` is the model's
/// `16 + n * stride(T)`, charged.
export fn allocate<C: Allocator>(ctx: C, bytes: Int): Region {
    ctx.allocate(bytes)
}

// --- The cost model, as arithmetic --------------------------------------------
//
// `core/effect`'s table states the model; these evaluate it. Ordinary pure
// functions, so both backends compute them from one body.

/// The block header every heap value carries, in bytes (MEMORY.md §5.1).
export let HEADER_BYTES: Int = 16;

/// A `Str` view — `slice`, `trim`, `splitOnce` — charges nothing, and so does
/// a fixed-size construction. The model counts what the *language* says
/// allocates (SPEC 10.5), not what an implementation happens to do.
export let VIEW_BYTES: Int = 0;

/// The charge for a `Str` of `n` UTF-8 bytes: `16 + n`.
///
/// UTF-8 bytes, not scalars — `"é".len()` is 1 and its charge is 18.
export fn strBytes(n: Int): Int {
    HEADER_BYTES + n
}

/// The charge for a `[T]` of `n` elements: `16 + n * stride`.
///
/// The stride is a parameter because the language has no `sizeOf<T>()`. The
/// model's `stride(T)` is VALUE-MODEL.md §5's layout, which the compiler knows
/// and a program cannot ask for.
export fn listBytes(n: Int, stride: Int): Int {
    HEADER_BYTES + n * stride
}

/// The charge for a closure environment of `size` bytes: `16 + size`.
export fn closureBytes(size: Int): Int {
    HEADER_BYTES + size
}

derive Equal, Show for Stats;
// --- What an allocator has been asked for -------------------------------------

/// What `GeneralPurpose.stats`, `Arena.stats` and `FixedBuffer.stats`
/// answer: every charge since the allocator was made.
///
/// `allocations` counts *requests*, a request for zero bytes included, so a
/// program can tell "asked once for nothing" from "never asked".
export struct Stats {
    export allocations: Int,
    export bytes: Int,
}

// --- The accounting, which all three share ------------------------------------
//
// One counter behind three types. Nothing tells the three policies apart
// except which counter they open and whether it has a budget.

/// A fresh counter. A negative budget is unbounded.
fn newCounter(budget: Int): I64;

/// Adds `bytes` to the counter and answers them.
///
/// Aborts when the counter has a budget and this request would pass it. See
/// `FixedBuffer` for why that is an abort rather than an error value.
fn charge(handle: I64, bytes: Int): Int;

/// How many charges this counter has taken.
fn count(handle: I64): Int;

/// How many bytes this counter has taken.
fn total(handle: I64): Int;

/// Unbounded, in the shape `newCounter` wants it.
let UNBOUNDED: Int = -1;

// --- GeneralPurpose -----------------------------------------------------------

/// Unbounded, and counts.
///
/// The one to reach for when the question is "how much does this cost?" rather
/// than "does this fit?".
export struct GeneralPurpose {
    handle: I64,
}

impl Allocator for GeneralPurpose {
    fn allocate(self, bytes: Int): Region {
        Region(charge(self.handle, bytes))
    }
}

/// A fresh general-purpose allocator, with its own counter at zero.
export fn generalPurpose(): GeneralPurpose {
    GeneralPurpose { handle: newCounter(UNBOUNDED) }
}

impl GeneralPurpose {
    export fn stats(self): Stats {
        Stats { allocations: count(self.handle), bytes: total(self.handle) }
    }
}

// --- Arena --------------------------------------------------------------------

/// A separate counter, and **nothing more than a counter** in this version.
///
/// An arena in the usual sense frees in bulk at the end of a scope. This one
/// does not, because it has no scope to end at. Every allocator here hands its
/// blocks to the same reference-counted heap, which frees each one when the last
/// reference to it goes (MEMORY.md §5), so an `Arena` reclaims nothing a
/// `GeneralPurpose` would not have.
///
/// What it is for is *attribution*: an arena per phase answers "how much did
/// parsing charge?" without the caller subtracting two totals.
///
/// **`scoped` at the end of this file is the other half.** It serves the body's
/// blocks out of its own mappings and deep-copies the answer on the way out,
/// which is what lets it free in bulk (MEMORY.md §7.2.1). Reach for this one to
/// attribute charges, and for `scoped` to put a bound on a request.
export struct Arena {
    handle: I64,
}

impl Allocator for Arena {
    fn allocate(self, bytes: Int): Region {
        Region(charge(self.handle, bytes))
    }
}

/// A fresh arena, with its own counter at zero.
export fn arena(): Arena {
    Arena { handle: newCounter(UNBOUNDED) }
}

impl Arena {
    /// Everything charged to this arena since it was made. Nothing subtracts
    /// from it, because nothing gets reclaimed early — see the type.
    export fn stats(self): Stats {
        Stats { allocations: count(self.handle), bytes: total(self.handle) }
    }
}

// --- FixedBuffer --------------------------------------------------------------

/// A byte budget. Charging past it **aborts**.
///
/// `allocate` answers `Region`, not `Result<Region, _>` (`core/effect`), so
/// there is no value to report a failure with, and SPEC 6.9 makes that an
/// abort. The message names both numbers: `allocation budget exhausted: 40
/// bytes requested against a budget of 64`.
///
/// The check is against the *defined* charge, so it is byte-exact and fires on
/// the same request on both backends. That makes a budget a test a program can
/// write: give a function 64 bytes and it either fits or the process ends.
export struct FixedBuffer {
    handle: I64,
    /// What this buffer was made with, in bytes.
    export budget: Int,
}

impl Allocator for FixedBuffer {
    fn allocate(self, bytes: Int): Region {
        Region(charge(self.handle, bytes))
    }
}

/// A buffer of exactly `budget` bytes.
///
/// A negative budget is **clamped to zero** rather than refused, and it does
/// not mean "unbounded". So `fixedBuffer(-1).budget` is `0`, and the first
/// request for a byte or more ends the process.
export fn fixedBuffer(budget: Int): FixedBuffer {
    let limit = if (budget < 0) { 0 } else { budget };
    FixedBuffer { handle: newCounter(limit), budget: limit }
}

impl FixedBuffer {
    export fn stats(self): Stats {
        Stats { allocations: count(self.handle), bytes: total(self.handle) }
    }

    /// `budget` less what it has charged so far. Never negative: a request that
    /// would make it negative aborts instead.
    export fn remaining(self): Int {
        self.budget - total(self.handle)
    }
}

// --- Scoped, and the scope it belongs to ---------------------------------------

/// A fresh arena, and its handle.
fn arenaCreate(): I64;

/// Reserves `bytes` from the arena and answers them.
fn arenaAllocate(handle: I64, bytes: Int): Int;

/// Gives every page the arena took back to the platform, and answers how many
/// bytes that was.
fn arenaRelease(handle: I64): Int;

/// How many charges this arena has taken.
fn arenaCount(handle: I64): Int;

/// How many bytes this arena has taken.
fn arenaTotal(handle: I64): Int;

/// The handle no arena has. So `arenaEnter(NO_SCOPE)` *leaves* whichever arena
/// the carrier is in without entering another, and still answers what it left —
/// the whole of what `copyAcross` needs.
///
/// The runtime encodes "no arena at all" in the same `I64` the pair carries
/// (`cli/runtime/memory.rs`'s `ArenaSlot::NONE`). A handle a scope was actually
/// given is never negative, so nothing collides with it.
let NO_SCOPE: I64 = -1;

/// Makes this arena the one the platform allocator serves blocks from, for the
/// carrier this runs on, and answers whichever arena was active before.
/// `arenaLeave` takes that number back.
///
/// Every runtime call drops its context argument, so nothing can *tell* the
/// function that builds a list which allocator asked. Making the answer a
/// property of the carrier for the dynamic extent of the scope tells it anyway.
///
/// `NO_SCOPE` above is the handle that means "none of them".
fn arenaEnter(handle: I64): I64;

/// Puts back what `arenaEnter` answered.
fn arenaLeave(previous: I64): I64;

/// **A deep copy of `value`, on whichever allocator is active.**
///
/// It duplicates every counted block reachable from `value` — a nested
/// `[[Str]]`, an enum's payload, a closure's captured environment — so the
/// answer shares nothing with the argument at any depth. A *copy*, not a second
/// reference: the counts of the original's blocks do not move.
///
/// Compiled rather than called: each backend generates the walk for the
/// concrete `T` at the call site (`middle/monomorphize.rs`).
///
/// **"Whichever allocator is active" is load-bearing.** The copy goes through
/// the same `buri_rt_alloc` every other allocation does, so inside an
/// `alloc.scoped` body it lands in *that body's arena*. That is right for a
/// scope inside a scope, and wrong for anything that has to outlive every scope.
/// `scoped` gets what it wants by leaving the arena **before** it calls this.
///
/// This is the primitive: the copy without the leave, for a caller that has
/// decided which allocator it wants the answer on. If you are not making that
/// decision, reach for [`copyAcross`].
export fn copyOut<T>(value: T): T;

/// **A deep copy of `value` that is in no arena at all**, whichever one the
/// carrier is standing in.
///
/// This is [`copyOut`] with [`scoped`]'s leave-first dance written into it:
/// leave every arena, copy, go back. So the answer is a block the platform
/// allocator owns and no scope will `munmap`, at every depth.
///
/// **It is the copy a value takes on its way *into the runtime*.** `core/actor`
/// hands the runtime a mailbox message, an initial state, a stepped state and a
/// step's answer, and the runtime keeps each past the frame of the call that
/// supplied it (`cli/runtime/rt.rs` §2, `cli/runtime/lib.rs` §3). A value posted
/// from inside an `alloc.scoped` body outlives that body, and `copyOut` alone
/// would have copied it into the very pages the scope is about to give back.
///
/// A caller that is *not* inside a scope pays two runtime calls that read and
/// write one thread-local word, plus the copy it would have made anyway.
export fn copyAcross<T>(value: T): T {
    let previous = arenaEnter(NO_SCOPE);
    let out = copyOut(value);
    let _ = arenaLeave(previous);
    out
}

/// **An attenuating wrapper whose `Allocator` is a scope's own arena and whose
/// every other effect is the wrapped context's.**
///
/// `ReadOnly<C>` in `core/testing/context` is the shape, and the same two rules
/// make it expressible:
///
///   * **the type parameter carries no bound**, so a `Scoped<C>` is not
///     effect-carrying *by mention* of its field (SPEC 10.2) and the struct
///     can be declared at all;
///   * **the arena is an opaque `I64`**, so the second field is a handle rather
///     than a second capability.
///
/// What it satisfies, it satisfies **conditionally**. `Scoped<C>` is an
/// `FileSystemRead` only where `C` is one, a `Clock` only where `C` is one, and so on
/// for every effect the platform declares. This language has no blanket
/// implementations and no delegation, so each is written out below, once. A new
/// effect in `core/effect` means a new block here.
///
/// **`Allocator` is the one that does not forward**, and it is the whole point of
/// the type. See `scoped` below.
export struct Scoped<C>(C, I64);

/// **Runs `body` with a context whose allocator is a fresh arena, and releases
/// the arena's pages when it returns.**
///
/// ```text
/// alloc.scoped(ctx, fn(c) => handle(c, request))
/// ```
///
/// `ctx` must already grant `Allocator`. A scope **narrows** what an allocation is
/// charged to and never widens what the callee may do, so entering one is no
/// way to obtain the effect. Everything else `ctx` grants passes through
/// unchanged — the body prints on the same stdout, reads the same filesystem
/// and fans out onto the same tasks.
///
/// ## What is in the arena
///
/// **The charges, and the values.** `c.allocate(n)` inside the scope reserves
/// `n` bytes from the arena — a real anonymous mapping, bump-allocated — and
/// charges them to the arena rather than to `ctx`, so the caller's own
/// allocator's totals do not move. That divergence is what `stats` below
/// reports.
///
/// A `[Str]` the body builds is in the arena too. The mechanism is dynamic
/// rather than passed: `arenaEnter` makes the arena the one the platform
/// allocator serves from, for this carrier and for the dynamic extent of `body`,
/// and `arenaLeave` puts back whatever was there before.
///
/// A task started inside a scope runs on another carrier and allocates on the
/// platform heap, not in this arena. That is the safe direction: a block on the
/// heap outliving the scope is ordinary, and a block in the arena escaping it is
/// what the copy below prevents.
///
/// ## The answer is copied out, and that is what makes the release sound
///
/// The single value that leaves a scope *this way* is `body`'s answer, and
/// `copyOut` **deep-copies** it onto the caller's allocator before the pages go
/// back. It duplicates every counted block reachable from the answer, at every
/// depth, so what the caller receives points at nothing this arena mapped. The
/// original's counts do not move, and the copy's are fresh.
///
/// The reference count releases everything else the body allocated before this
/// function returns, and the arena's bulk free reclaims the *address space*
/// those blocks sat in. The invariant: **a value's lifetime never exceeds the
/// dynamic extent it was created in, except by being the answer — and the
/// answer is copied.**
///
/// One other place extends a value's lifetime, and a *scope* cannot see it. The
/// **runtime** keeps blocks between two calls of its own — today `core/actor`'s
/// mailboxes, states and reply slots (`cli/runtime/lib.rs` §3). Such a value is
/// not the answer, so it takes the same copy at its own site: [`copyAcross`],
/// which leaves every arena first.
///
/// ## The handle dies with the scope
///
/// `body`'s return type is an unbounded `T`, so a body may hand its `Scoped<C>`
/// back out. Allocating through one afterwards charges nothing and reserves
/// nothing: this function retires the arena's handle when it returns, and a
/// retired handle matches no arena.
export fn scoped<C: Allocator, T>(ctx: C, body: fn(Scoped<C>) => T): T {
    let handle = arenaCreate();
    let outer = arenaEnter(handle);
    let inside = body(Scoped(ctx, handle));
    let _ = arenaLeave(outer);
    let out = copyOut(inside);
    let _ = arenaRelease(handle);
    out
}

impl<C> Scoped<C> {
    /// Everything charged to **this scope's** arena. A sibling scope's charges
    /// are not here, and neither are the wrapped context's.
    export fn stats(self): Stats {
        Stats { allocations: arenaCount(self.1), bytes: arenaTotal(self.1) }
    }
}

// The one implementation that does not forward.
//
// No bound on `C`: the arena is this wrapper's own, so a `Scoped<C>` allocates
// whether or not the `C` it holds can. `scoped` checks the authority once, and
// requires `C: Allocator` there.
impl<C> Allocator for Scoped<C> {
    fn allocate(self, bytes: Int): Region {
        Region(arenaAllocate(self.1, bytes))
    }
}

// Everything below here forwards, and says nothing else.

impl<C: Stdout> Stdout for Scoped<C> {
    fn print(self, text: Template): Result<(), IoError> {
        self.0.print(text)
    }

    fn println(self, text: Template): Result<(), IoError> {
        self.0.println(text)
    }

    fn writeBytes(self, b: [U8]): Result<(), IoError> {
        self.0.writeBytes(b)
    }
}

impl<C: Stderr> Stderr for Scoped<C> {
    fn eprint(self, text: Template): Result<(), IoError> {
        self.0.eprint(text)
    }

    fn eprintln(self, text: Template): Result<(), IoError> {
        self.0.eprintln(text)
    }
}

impl<C: Stdin> Stdin for Scoped<C> {
    fn readLine(self): Option<Str> {
        self.0.readLine()
    }

    fn readBytes(self, n: Int): Option<[U8]> {
        self.0.readBytes(n)
    }
}

impl<C: FileSystemRead> FileSystemRead for Scoped<C> {
    fn readFile(self, path: Path): Result<Str, IoError> {
        self.0.readFile(path)
    }

    fn fileExists(self, path: Path): Bool {
        self.0.fileExists(path)
    }

    fn readDir(self, path: Path): Result<[Str], IoError> {
        self.0.readDir(path)
    }

    fn readFileBytes(self, path: Path): Result<[U8], IoError> {
        self.0.readFileBytes(path)
    }

    fn metadata(self, path: Path): Result<Metadata, IoError> {
        self.0.metadata(path)
    }

    fn readRange(self, path: Path, at: Int, count: Int): Result<[U8], IoError> {
        self.0.readRange(path, at, count)
    }

    fn realPath(self, path: Path): Result<Str, IoError> {
        self.0.realPath(path)
    }
}

impl<C: FileSystemWrite> FileSystemWrite for Scoped<C> {
    fn writeFile(self, path: Path, body: Str): Result<(), IoError> {
        self.0.writeFile(path, body)
    }

    fn writeFileBytes(self, path: Path, body: [U8]): Result<(), IoError> {
        self.0.writeFileBytes(path, body)
    }

    fn appendFile(self, path: Path, body: [U8]): Result<(), IoError> {
        self.0.appendFile(path, body)
    }

    fn renameFile(self, source: Path, destination: Path): Result<(), IoError> {
        self.0.renameFile(source, destination)
    }

    fn removeFile(self, path: Path): Result<(), IoError> {
        self.0.removeFile(path)
    }

    fn removeDir(self, path: Path): Result<(), IoError> {
        self.0.removeDir(path)
    }

    fn makeDir(self, path: Path): Result<(), IoError> {
        self.0.makeDir(path)
    }

    fn syncFile(self, path: Path): Result<(), IoError> {
        self.0.syncFile(path)
    }

    fn copyFile(self, source: Path, destination: Path): Result<(), IoError> {
        self.0.copyFile(source, destination)
    }
}

impl<C: Network> Network for Scoped<C> {
    fn fetch(self, request: Request): Result<Response, NetError> {
        self.0.fetch(request)
    }
}

impl<C: Clock> Clock for Scoped<C> {
    fn nowMilliseconds(self): I64 {
        self.0.nowMilliseconds()
    }

    fn sleepMilliseconds(self, millis: Int): () {
        self.0.sleepMilliseconds(millis)
    }

    fn monotonicNanoseconds(self): I64 {
        self.0.monotonicNanoseconds()
    }
}

impl<C: Random> Random for Scoped<C> {
    fn nextInt(self, lo: Int, hi: Int): Int {
        self.0.nextInt(lo, hi)
    }

    fn nextFloat(self): Float {
        self.0.nextFloat()
    }
}

impl<C: Environment> Environment for Scoped<C> {
    fn variable(self, name: Str): Option<Str> {
        self.0.variable(name)
    }

    fn arguments(self): [Str] {
        self.0.arguments()
    }

    fn currentDirectory(self): Str {
        self.0.currentDirectory()
    }

    fn allVariables(self): [(Str, Str)] {
        self.0.allVariables()
    }

    fn operatingSystemName(self): Str {
        self.0.operatingSystemName()
    }
}

impl<C: Process> Process for Scoped<C> {
    fn exitWith(self, code: Int): () {
        self.0.exitWith(code)
    }
}

impl<C: Spawn> Spawn for Scoped<C> {
    fn spawnProcess(
        self,
        plan: [Str],
        environment: [Str],
        replaceEnvironment: Bool,
        stdin: [U8],
    ): Result<Output, IoError> {
        self.0.spawnProcess(plan, environment, replaceEnvironment, stdin)
    }
}

// The step is handed `ctx` — the caller's whole context — and not `self`, so a
// task receives whatever the caller passed and not this wrapper.
impl<C: Tasks> Tasks for Scoped<C> {
    fn parallel<X, A, B>(self, ctx: X, items: [A], f: fn(X, Int, A) => B): [B] {
        self.0.parallel(ctx, items, f)
    }
}

// Seven ordinary forwards. Nothing crosses this boundary but a listener, a
// request and a response: `core/net/server`'s `run` calls `onRequest` itself,
// under the caller's own context. Every allocation a handler makes still lands
// in the scope's arena, because the handler gets the `Scoped<C>` `alloc.scoped`
// built and charges through it.
impl<C: Listen> Listen for Scoped<C> {
    fn listenBind(
        self,
        address: Str,
        port: Int,
        plan: [Serve],
        requestLimit: Int,
        idleTimeoutMillis: Int,
    ): Result<Listener, ServeError> {
        self.0.listenBind(address, port, plan, requestLimit, idleTimeoutMillis)
    }

    fn listenAccept(self, handle: Int): Result<Int, ServeError> {
        self.0.listenAccept(handle)
    }

    fn listenRequest(self, connection: Int): Result<Request, ServeError> {
        self.0.listenRequest(connection)
    }

    fn listenRespond(
        self,
        connection: Int,
        status: Int,
        headers: [Header],
        body: [U8],
    ): Result<(), ServeError> {
        self.0.listenRespond(connection, status, headers, body)
    }

    fn listenClose(self, handle: Int): () {
        self.0.listenClose(handle)
    }

    fn listenUpgrade(self, connection: Int): Result<Int, ServeError> {
        self.0.listenUpgrade(connection)
    }

    // Whichever `Allocator` the acceptor itself holds allocates a socket's
    // messages, not this one — exactly as with a `Request`'s body.
    fn listenReceive(self, socket: Int): Result<Received, ServeError> {
        self.0.listenReceive(socket)
    }
}

impl<C: Sockets> Sockets for Scoped<C> {
    fn socketSendText(self, socket: Int, text: Str): () {
        self.0.socketSendText(socket, text)
    }

    fn socketSendBytes(self, socket: Int, body: [U8]): () {
        self.0.socketSendBytes(socket, body)
    }

    fn socketClose(self, socket: Int, code: Int, reason: Str): () {
        self.0.socketClose(socket, code, reason)
    }
}
