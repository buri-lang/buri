//! core/path — where a file is, as a type instead of a `Str`.
//!
//! Every `Path` comes out of [`of`], and that is the whole promise: **every
//! `Path` is spelled one way**. `"logs//app/"`, `"logs/./app"` and
//! `"logs/app"` are the same path and compare equal.
//!
//! Everything in `core/fs` takes one, so a `${dir}/${name}` with a separator
//! too many is caught at the call rather than coming back `.NotFound`.
//!
//! ## What normalizing does, and what it won't do
//!
//! [`of`] drops empty components and `.` components, drops a trailing
//! separator, and keeps a leading one. It does **not** resolve `..`. If `a` is
//! a symbolic link, `a/../b` and `b` name two different files, so `..` stays a
//! component like any other and what it means is the filesystem's business.
//!
//! ## Pure and allocating, as everywhere else
//!
//! [`Path::parent`], [`Path::fileName`], [`Path::stem`], [`Path::extension`]
//! and [`Path::isAbsolute`] are **views** into a path that already exists, so
//! they are pure and take no context (SPEC 10.5). [`of`], [`Path::join`],
//! [`Path::withSuffix`] and [`Path::components`] build something new, so they
//! name `Alloc`.
//!
//! ```buri run
//! from "core/effect" import { Alloc, Stdout };
//! from "core/host" import * as host;
//! from "core/io" import * as io;
//! from "core/path" import * as path;
//!
//! export fn main(): Result<(), Str> {
//!     let ctx = context {
//!         Alloc: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let dir = path.of(ctx, "var//log/./");
//!     let file = dir.join(ctx, "app.log");
//!     let stem = file.stem().withDefault("");
//!     let extension = file.extension().withDefault("");
//!     let _ = io.println(ctx, "${file.text()} — ${stem} then ${extension}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! var/log/app.log — app then log
//! ```

from "core/effect" import { Alloc };
from "core/str" import * as str;

derive Eq, Show for Path;
/// A filesystem path, in the one spelling [`of`] gives it.
///
/// You can't reach the text as a field, so nothing downstream has to ask
/// whether this came through [`of`]. [`Path::text`] hands the spelling back
/// when you need a `Str`.
export struct Path(Str);

/// The path this text spells, normalized.
///
/// Total: it refuses no text. The empty string becomes `"."`, the directory a
/// relative path is relative to.
///
/// ```buri run
/// from "core/effect" import { Alloc, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/path" import * as path;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Alloc: host.alloc,
///         Stdout: host.stdout,
///     };
///     let tidied = path.of(ctx, "logs//app/").text();
///     let empty = path.of(ctx, "").text();
///     let root = path.of(ctx, "/").text();
///     // `..` is a component, not an instruction: see the module header.
///     let up = path.of(ctx, "a/../b").text();
///     let _ = io.println(ctx, "${tidied} ${empty} ${root} ${up}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// logs/app . / a/../b
/// ```
export fn of<C: Alloc>(ctx: C, text: Str): Path {
    let body = named(ctx, text).join(ctx, "/");
    if (text.startsWith("/")) {
        Path("/".concat(ctx, body))
    } else if (body == "") {
        Path(".")
    } else {
        Path(body)
    }
}

/// The components of `text` that name something: neither empty nor `.`.
fn named<C: Alloc>(ctx: C, text: Str): [Str] {
    text.split(ctx, "/").filter(ctx, fn(part) => part != "" && part != ".")
}

/// Everything after the last separator. For a path with no separator, the
/// whole thing. A view: `splitOnce` copies nothing.
fn lastComponent(text: Str): Str {
    match (text.splitOnce("/")) {
        .None => text,
        .Some((_before, after)) => lastComponent(after),
    }
}

/// The index of the last `.` in `name`, at or after `start`, or `best`.
fn lastDot(name: Str, start: Int, best: Option<Int>): Option<Int> {
    match (name.slice(start, name.len()).indexOf(".")) {
        .None => best,
        .Some(at) => lastDot(name, start + at + 1, .Some(start + at)),
    }
}

/// Where the extension starts in `name`, as the index of its dot.
///
/// `.None` where there is no extension, which covers three cases: no dot at
/// all (`README`), a dot that begins the name (`.gitignore` is a name, not an
/// extension), and a dot that ends it (`archive.`).
fn extensionDot(name: Str): Option<Int> {
    match (lastDot(name, 0, .None)) {
        .None => .None,
        .Some(at) => {
            if (at == 0 || at + 1 == name.len()) { .None } else { .Some(at) }
        },
    }
}

impl Path {
    /// The spelling, for the places that need a `Str`.
    ///
    /// A view into the path rather than a copy, so it's pure. What comes back
    /// is normalized.
    export fn text(self): Str {
        self.0
    }

    /// Whether the path begins at the root.
    ///
    /// The other half of what [`Path::components`] answers: that list never
    /// carries the leading separator, so `/a/b` and `a/b` share their
    /// components and differ here.
    export fn isAbsolute(self): Bool {
        self.0.startsWith("/")
    }

    /// This path with `other` appended to it, normalized.
    ///
    /// **`join` appends an absolute `other`, it doesn't substitute it.** The
    /// root never changes: `path.of(ctx, "/srv").join(ctx, "/etc")` is
    /// `/srv/etc`. Substituting is how a program that joins a user's string
    /// onto its own directory ends up reading `/etc/passwd`.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let dir = path.of(ctx, "var/log");
    ///     let one = dir.join(ctx, "app.log").text();
    ///     let two = dir.join(ctx, "a/b").text();
    ///     let absolute = dir.join(ctx, "/etc").text();
    ///     let _ = io.println(ctx, "${one} ${two} ${absolute}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// var/log/app.log var/log/a/b var/log/etc
    /// ```
    export fn join<C: Alloc>(self, ctx: C, other: Str): Path {
        let left = self.0;
        of(ctx, str.format(ctx, "${left}/${other}"))
    }

    /// The directory this path sits in: everything before its last component.
    ///
    /// A relative path of one component answers `.`. `.None` is for the two
    /// paths that name no containing directory: the root and `.` itself.
    ///
    /// Lexical, like the rest of this module. The parent of `a/..` is `a`:
    /// `parent` drops the last component, and `..` is a component.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let deep = path.of(ctx, "/var/log").parent().map(fn(p) => p.text());
    ///     let shallow = path.of(ctx, "/var").parent().map(fn(p) => p.text());
    ///     let here = path.of(ctx, "app.log").parent().map(fn(p) => p.text());
    ///     let root = path.of(ctx, "/").parent().map(fn(p) => p.text());
    ///     let a = deep.withDefault("none");
    ///     let b = shallow.withDefault("none");
    ///     let c = here.withDefault("none");
    ///     let d = root.withDefault("none");
    ///     let _ = io.println(ctx, "${a} ${b} ${c} ${d}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// /var / . none
    /// ```
    export fn parent(self): Option<Path> {
        let tail = lastComponent(self.0);
        let cut = self.0.len() - tail.len() - 1;
        if (self.0 == "/" || self.0 == ".") {
            .None
        } else if (cut < 0) {
            .Some(Path("."))
        } else if (cut == 0) {
            .Some(Path("/"))
        } else {
            .Some(Path(self.0.slice(0, cut)))
        }
    }

    /// The last component, when that component names a file.
    ///
    /// `.None` for the root and for `.`, which have no last component, and for
    /// a path ending in `..`, which names a directory the path alone cannot
    /// decide.
    export fn fileName(self): Option<Str> {
        let last = lastComponent(self.0);
        if (last == "" || last == "." || last == "..") { .None } else { .Some(last) }
    }

    /// The file name without its extension. The whole name where there is no
    /// extension, and `.None` wherever [`Path::fileName`] is.
    export fn stem(self): Option<Str> {
        match (self.fileName()) {
            .None => .None,
            .Some(name) => {
                match (extensionDot(name)) {
                    .None => .Some(name),
                    .Some(at) => .Some(name.slice(0, at)),
                }
            },
        }
    }

    /// What follows the last `.` of the file name, without the dot.
    ///
    /// `.None` where the name has no extension: `README` has no dot,
    /// `.gitignore`'s dot begins the name instead of separating an extension
    /// from it, and `archive.`'s dot ends the name.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let archive = path.of(ctx, "a/report.tar.gz");
    ///     let hidden = path.of(ctx, "a/.gitignore");
    ///     let one = archive.extension().withDefault("none");
    ///     let two = archive.stem().withDefault("none");
    ///     let three = hidden.extension().withDefault("none");
    ///     let four = hidden.stem().withDefault("none");
    ///     let _ = io.println(ctx, "${one} ${two} ${three} ${four}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// gz report.tar none .gitignore
    /// ```
    export fn extension(self): Option<Str> {
        match (self.fileName()) {
            .None => .None,
            .Some(name) => {
                match (extensionDot(name)) {
                    .None => .None,
                    .Some(at) => .Some(name.slice(at + 1, name.len())),
                }
            },
        }
    }

    /// This path with `suffix` written onto the end of its text.
    ///
    /// This is how you name a temporary beside a file — `fs.writeAtomic` names
    /// its scratch file this way — so it appends to the *whole* name rather
    /// than replacing the extension. `data.db` and `data.log` get two different
    /// temporaries.
    ///
    /// `.None` where there is no last component to append to: the root and
    /// `.`.
    export fn withSuffix<C: Alloc>(self, ctx: C, suffix: Str): Option<Path> {
        match (self.fileName()) {
            .None => .None,
            .Some(_name) => .Some(of(ctx, self.0.concat(ctx, suffix))),
        }
    }

    /// The components that name something, in order, without the leading
    /// separator.
    ///
    /// `/a/b` and `a/b` answer the same two, and [`Path::isAbsolute`] tells
    /// them apart. The root and `.` answer the empty list.
    export fn components<C: Alloc>(self, ctx: C): [Str] {
        named(ctx, self.0)
    }

    /// Whether this path is `prefix` or sits under it.
    ///
    /// Component-wise, so `/srv/ab` does not start with `/srv/a`. An absolute
    /// path never starts with a relative one, and `.` starts every relative
    /// path the way `/` starts every absolute one.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let base = path.of(ctx, "/srv/a");
    ///     let under = path.of(ctx, "/srv/a/b").startsWith(base);
    ///     let beside = path.of(ctx, "/srv/ab").startsWith(base);
    ///     let _ = io.println(ctx, "${under} ${beside}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// true false
    /// ```
    export fn startsWith(self, prefix: Path): Bool {
        if (self.0 == prefix.0) {
            true
        } else if (self.isAbsolute() != prefix.isAbsolute()) {
            false
        } else if (prefix.0 == "/" || prefix.0 == ".") {
            true
        } else if (self.0.startsWith(prefix.0)) {
            match (self.0.charAt(prefix.0.len())) {
                .None => false,
                .Some(c) => c == '/',
            }
        } else {
            false
        }
    }

    /// This path written from `base`, or `.None` where it is not under it.
    ///
    /// Lexical, like the rest of this module: it never answers a path of `..`
    /// components, because `..` is not something a path alone can resolve. A
    /// path that *is* `base` answers `.`.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let root = path.of(ctx, "/srv/app");
    ///     let inside = path.of(ctx, "/srv/app/log/today");
    ///     let one = inside.relativeTo(ctx, root).map(fn(p) => p.text()).withDefault("none");
    ///     let two = path.of(ctx, "/etc").relativeTo(ctx, root).map(fn(p) => p.text());
    ///     let _ = io.println(ctx, "${one} ${two.withDefault("none")}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// log/today none
    /// ```
    export fn relativeTo<C: Alloc>(self, ctx: C, base: Path): Option<Path> {
        if (!self.startsWith(base)) {
            .None
        } else if (self.0 == base.0) {
            .Some(Path("."))
        } else if (base.0 == ".") {
            .Some(self)
        } else if (base.0 == "/") {
            .Some(of(ctx, self.0.slice(1, self.0.len())))
        } else {
            .Some(of(ctx, self.0.slice(base.0.len() + 1, self.0.len())))
        }
    }

    /// This path with its extension replaced by `extension`, written without a
    /// dot.
    ///
    /// The mirror of [`Path::withSuffix`], which appends to the whole name:
    /// `report.tar.gz` with extension `txt` is `report.tar.txt`. An empty
    /// `extension` drops the extension, which is [`Path::withoutExtension`].
    ///
    /// `.None` wherever [`Path::fileName`] is: the root, `.`, and a path ending
    /// in `..`.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let file = path.of(ctx, "/var/log/app.log");
    ///     let renamed = file.withExtension(ctx, "gz").map(fn(p) => p.text());
    ///     let bare = file.withoutExtension(ctx).text();
    ///     let _ = io.println(ctx, "${renamed.withDefault("none")} ${bare}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// /var/log/app.gz /var/log/app
    /// ```
    export fn withExtension<C: Alloc>(self, ctx: C, extension: Str): Option<Path> {
        match (self.fileName()) {
            .None => .None,
            .Some(name) => {
                let bare = match (extensionDot(name)) {
                    .None => name,
                    .Some(at) => name.slice(0, at),
                };
                let renamed = if (extension == "") {
                    bare
                } else {
                    str.format(ctx, "${bare}.${extension}")
                };
                match (self.parent()) {
                    .None => .Some(of(ctx, renamed)),
                    .Some(directory) => .Some(directory.join(ctx, renamed)),
                }
            },
        }
    }

    /// This path with its extension dropped, or the path unchanged where there
    /// is none to drop.
    export fn withoutExtension<C: Alloc>(self, ctx: C): Path {
        self.withExtension(ctx, "").withDefault(self)
    }

    /// [`Path::join`] for a path rather than for a `Str`.
    ///
    /// It appends an absolute `other` exactly as `join` does — the root never
    /// changes — so joining a path a caller supplied cannot walk out of this
    /// one.
    export fn joinPath<C: Alloc>(self, ctx: C, other: Path): Path {
        self.join(ctx, other.text())
    }

    /// Whether this path matches a shell-style pattern, component by component.
    ///
    /// `*` matches any run of characters inside one component, `?` matches one
    /// character, `[abc]` and `[a-z]` match a set — a leading `!` or `^` negates
    /// it — and `**` matches any number of whole components, none included.
    /// Nothing else is special, so a pattern without a metacharacter is an
    /// equality test.
    ///
    /// An absolute path matches only an absolute pattern. A `]` closes a set and
    /// cannot be a member of one.
    ///
    /// Pure, so it allocates nothing and takes no context. Backtracking is
    /// recursion, so a pattern of many `*`s against a long name costs what
    /// backtracking costs.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/path" import * as path;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let file = path.of(ctx, "src/net/http.buri");
    ///     let deep = file.matchesGlob("src/**/*.buri");
    ///     let shallow = file.matchesGlob("src/*.buri");
    ///     let _ = io.println(ctx, "${deep} ${shallow}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// true false
    /// ```
    export fn matchesGlob(self, pattern: Str): Bool {
        if (self.isAbsolute() != pattern.startsWith("/")) {
            false
        } else {
            globComponents(componentsOf(self.0), 0, componentsOf(pattern), 0)
        }
    }
}

// -----------------------------------------------------------------------------
// Globbing
//
// Index arithmetic over two views rather than two lists of components: a list
// would need an `Alloc`, and `matchesGlob` is pure.
// -----------------------------------------------------------------------------

/// The components of a path or a pattern as one string, without the leading
/// separator and without the `.` that names none.
fn componentsOf(text: Str): Str {
    if (text == "." || text == "/") {
        ""
    } else if (text.startsWith("/")) {
        text.slice(1, text.len())
    } else {
        text
    }
}

/// Where the component starting at `at` ends.
fn componentEnd(text: Str, at: Int): Int {
    match (text.slice(at, text.len()).indexOf("/")) {
        .None => text.len(),
        .Some(k) => at + k,
    }
}

/// Where the component after the one ending at `end` starts.
fn afterComponent(text: Str, end: Int): Int {
    if (end >= text.len()) { text.len() } else { end + 1 }
}

/// `text` from `ti`, against `pattern` from `pi`, one component at a time.
fn globComponents(text: Str, ti: Int, pattern: Str, pi: Int): Bool {
    if (pi >= pattern.len()) {
        ti >= text.len()
    } else {
        let pe = componentEnd(pattern, pi);
        let piece = pattern.slice(pi, pe);
        if (piece == "**") {
            globAcross(text, ti, pattern, afterComponent(pattern, pe))
        } else if (ti >= text.len()) {
            false
        } else {
            let te = componentEnd(text, ti);
            if (globOne(text.slice(ti, te), 0, piece, 0)) {
                globComponents(text, afterComponent(text, te), pattern, afterComponent(pattern, pe))
            } else {
                false
            }
        }
    }
}

/// `**`: the rest of the pattern, tried here and at every component after it.
fn globAcross(text: Str, ti: Int, pattern: Str, pi: Int): Bool {
    if (globComponents(text, ti, pattern, pi)) {
        true
    } else if (ti >= text.len()) {
        false
    } else {
        globAcross(text, afterComponent(text, componentEnd(text, ti)), pattern, pi)
    }
}

/// One component against one pattern component.
fn globOne(name: Str, ni: Int, piece: Str, pi: Int): Bool {
    if (pi >= piece.len()) {
        ni >= name.len()
    } else {
        match (piece.charAt(pi)) {
            .None => ni >= name.len(),
            .Some(c) => {
                if (c == '*') {
                    globRun(name, ni, piece, pi + 1)
                } else if (c == '?') {
                    if (ni >= name.len()) { false } else { globOne(name, ni + 1, piece, pi + 1) }
                } else if (c == '[') {
                    globSet(name, ni, piece, pi)
                } else {
                    match (name.charAt(ni)) {
                        .None => false,
                        .Some(n) => {
                            if (n == c) { globOne(name, ni + 1, piece, pi + 1) } else { false }
                        },
                    }
                }
            },
        }
    }
}

/// `*`: the rest of the pattern, tried at this character and at every one after.
fn globRun(name: Str, ni: Int, piece: Str, pi: Int): Bool {
    if (globOne(name, ni, piece, pi)) {
        true
    } else if (ni >= name.len()) {
        false
    } else {
        globRun(name, ni + 1, piece, pi)
    }
}

/// `[...]`: one character against the set, then the rest of the pattern.
fn globSet(name: Str, ni: Int, piece: Str, pi: Int): Bool {
    let negated = match (piece.charAt(pi + 1)) {
        .None => false,
        .Some(c) => c == '!' || c == '^',
    };
    let start = if (negated) { pi + 2 } else { pi + 1 };
    match (closingBracket(piece, start)) {
        .None => false,
        .Some(end) => {
            match (name.charAt(ni)) {
                .None => false,
                .Some(n) => {
                    if (inGlobSet(n, piece, start, end) != negated) {
                        globOne(name, ni + 1, piece, end + 1)
                    } else {
                        false
                    }
                },
            }
        },
    }
}

/// Where the `]` closing a set opened before `start` is.
fn closingBracket(piece: Str, start: Int): Option<Int> {
    match (piece.slice(start, piece.len()).indexOf("]")) {
        .None => .None,
        .Some(k) => .Some(start + k),
    }
}

/// Whether `c` is one of the members listed between `start` and `end`.
fn inGlobSet(c: Char, piece: Str, start: Int, end: Int): Bool {
    if (start >= end) {
        false
    } else {
        match (piece.charAt(start)) {
            .None => false,
            .Some(low) => {
                let ranged = match (piece.charAt(start + 1)) {
                    .None => false,
                    .Some(d) => d == '-',
                };
                if (ranged && start + 2 < end) {
                    match (piece.charAt(start + 2)) {
                        .None => false,
                        .Some(high) => {
                            if (low.toU32() <= c.toU32() && c.toU32() <= high.toU32()) {
                                true
                            } else {
                                inGlobSet(c, piece, start + 3, end)
                            }
                        },
                    }
                } else if (c == low) {
                    true
                } else {
                    inGlobSet(c, piece, start + 1, end)
                }
            },
        }
    }
}
