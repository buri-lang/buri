//! core/testing/assert — assertions.
//!
//! An ordinary module, imported like any other: `assert` is not a keyword, and
//! the name comes from `import * as assert`. A file is free to call it
//! something else.
//!
//! Two things about this module are not ordinary, and both follow from it being
//! a platform module rather than a library:
//!
//!   - its functions render a failure message with nowhere to write it. The
//!     runner does the rendering, not the program. That is why these signatures
//!     would be a lie anywhere else, and why only a test source may import the
//!     module. The three that take a `ctx` take it to *compare* with — sorting
//!     a list, or calling a collection's own `equals` — never to print with.
//!   - a failure ends that test and no other. The runner reports the file, the
//!     line, and both values.
//!
//! The set is wide because every assertion names the two values it compared.
//! `isTrue(xs.contains(x))` reports "expected true, got false", which names
//! neither the list nor the element, so reach for the narrowest assertion that
//! fits.
//!
//! There is no `fail`. A test that has to fail asserts on the value it has: a
//! verdict rendered as a `Str`, or the `Option` itself.

from "core/effect" import { Allocator };
from "core/order" import { Equal };

/// Fails unless `a == b`. Requires `Equal`, and nothing else.
///
/// The comparison goes through `Equal`, so a hand-written implementation decides
/// what equal means. The runner renders a failure structurally rather than
/// calling `Show`, so a type is assertable as soon as it is comparable.
export fn equal<T: Equal>(actual: T, expected: T): () {
    report(actual == expected, "equal", actual, expected)
}

export fn notEq<T: Equal>(actual: T, expected: T): () {
    report(actual != expected, "notEq", actual, expected)
}

/// `equal` for a type with no `Equal`: you pass the comparison, and a failure still
/// reports both values.
///
/// `Map`, `Set`, `OrderedMap`, `OrderedSet`, `Queue` and `BitSet` answer
/// `equals(ctx, other)` rather than deriving `Equal` — two of them holding the
/// same entries need not hold them in the same shape — so `assert.equal` cannot
/// take one, and the test had to fall back to `isTrue(a.equals(ctx, b))`, which
/// names neither map.
///
/// ```buri role=test
/// from "core/effect" import { Allocator };
/// from "core/host/testing" import { alloc };
/// from "core/map" import * as map;
/// from "core/testing/assert" import * as assert;
///
/// test "two maps built in different orders hold the same entries" {
///     let ctx = context {
///         Allocator: alloc(),
///     };
///     let one = map.empty<Str, Int>().insert(ctx, "a", 1).insert(ctx, "b", 2);
///     let two = map.empty<Str, Int>().insert(ctx, "b", 2).insert(ctx, "a", 1);
///     assert.eqWith(ctx, one, two, fn(c, a, b) => a.equals(c, b));
/// }
/// ```
///
/// The comparison is yours, so this promises nothing about it. A `same` that is
/// not reflexive fails a value against itself, and the report then shows two
/// values that look alike.
///
/// The runner renders both sides *structurally*, so a failure shows a map's
/// buckets rather than its entries — which is the layout the comparison just
/// decided not to care about, and is still where the difference is.
export fn eqWith<T, C: Allocator>(
    ctx: C,
    actual: T,
    expected: T,
    same: fn(C, T, T) => Bool,
): () {
    report(same(ctx, actual, expected), "eqWith", actual, expected)
}

export fn isTrue(actual: Bool): () {
    report(actual, "isTrue", actual, true)
}

export fn isFalse(actual: Bool): () {
    report(actual == false, "isFalse", actual, false)
}

/// Fails unless `needle` is one of `haystack`'s elements. The whole list goes on
/// the `actual` line, and the missing element goes on the `expected` line as a
/// one-element list.
export fn contains<T: Equal>(haystack: [T], needle: T): () {
    report(haystack.contains(needle), "contains", haystack, [needle])
}

/// Fails unless `needle` appears somewhere in `haystack`, and reports both
/// strings — `isTrue(haystack.contains(needle))` names neither.
///
/// ```buri role=test
/// from "core/testing/assert" import * as assert;
///
/// test "the greeting names the caller" {
///     assert.containsText("hello, world", "world");
/// }
/// ```
///
/// Matched by scalar value, so nothing is case folded or normalised first.
export fn containsText(haystack: Str, needle: Str): () {
    report(haystack.contains(needle), "containsText", haystack, needle)
}

/// Fails unless `haystack` begins with `prefix`, and reports both strings.
/// Every string starts with `""`.
///
/// ```buri role=test
/// from "core/testing/assert" import * as assert;
///
/// test "the error leads with the file" {
///     assert.startsWith("main.buri:3: no such name", "main.buri:");
/// }
/// ```
export fn startsWith(haystack: Str, prefix: Str): () {
    report(haystack.startsWith(prefix), "startsWith", haystack, prefix)
}

/// Fails unless `xs` is empty. The report shows what was in it.
export fn isEmpty<T>(xs: [T]): () {
    report(xs.isEmpty(), "isEmpty", xs, [])
}

/// Fails when `xs` is empty. The one assertion here that reports a sentence
/// rather than a diff, because it can only fail at one value.
export fn notEmpty<T>(xs: [T]): () {
    if (xs.isEmpty()) {
        failWith("assert.notEmpty failed: the list is empty")
    } else {
        ()
    }
}

/// Fails unless `xs` holds exactly `expected` elements. The report compares the
/// two lengths.
export fn length<T>(xs: [T], expected: Int): () {
    report(xs.length() == expected, "length", xs.length(), expected)
}

/// Fails unless the two lists hold the same elements in any order. Duplicates
/// count, so `[1, 1, 2]` and `[1, 2]` are not the same.
///
/// **The report shows the sorted lists.** The order the caller wrote is the one
/// thing this assertion has already decided not to care about, and sorted lines
/// up beside sorted.
///
/// ```buri role=test
/// from "core/effect" import { Allocator };
/// from "core/host/testing" import { alloc };
/// from "core/testing/assert" import * as assert;
///
/// test "the keys are all there, whatever order they came out in" {
///     let ctx = context {
///         Allocator: alloc(),
///     };
///     assert.unordered(ctx, [3, 1, 2], [1, 2, 3]);
/// }
/// ```
///
/// Sorting costs O(n log n) and two lists.
export fn unordered<T: Ordered, C: Allocator>(ctx: C, actual: [T], expected: [T]): () {
    let sortedActual = actual.sort(ctx);
    let sortedExpected = expected.sort(ctx);
    report(
        sortedActual.compare(sortedExpected) == .Equal,
        "unordered",
        sortedActual,
        sortedExpected,
    )
}

/// Fails unless `actual > bound`. The report names the bound on its
/// `expected` line: `gt(3, 5)` reads `actual: 3`, `expected: 5`.
export fn gt<T: Ordered>(actual: T, bound: T): () {
    report(actual > bound, "gt", actual, bound)
}

/// Fails unless `actual >= bound`.
export fn ge<T: Ordered>(actual: T, bound: T): () {
    report(actual >= bound, "ge", actual, bound)
}

/// Fails unless `actual < bound`.
export fn lt<T: Ordered>(actual: T, bound: T): () {
    report(actual < bound, "lt", actual, bound)
}

/// Fails unless `actual <= bound`.
export fn le<T: Ordered>(actual: T, bound: T): () {
    report(actual <= bound, "le", actual, bound)
}

/// Fails unless `actual` and `expected` are within `tolerance` of each other.
///
/// The tolerance is absolute, and a parameter rather than a constant: how close
/// counts as close enough is a fact about the computation. A `NaN` on either side
/// fails, since it is within nothing.
export fn approxEq(actual: Float, expected: Float, tolerance: Float): () {
    // `math.absFloat` would do, but would make every test source that imports
    // this one load `core/math`. A `NaN` on either side makes `>` false, so the
    // subtraction takes the other branch and is a `NaN` too — and a `NaN` is `<=`
    // nothing, because the ordering operators stay IEEE's (SPEC 6.2).
    let apart = if (actual > expected) { actual - expected } else { expected - actual };
    report(apart <= tolerance, "approxEq", actual, expected)
}

/// Fails unless the two are within `tolerance` *of the larger of them*, so the
/// tolerance is a fraction rather than a distance.
///
/// An absolute tolerance is the wrong bar wherever the numbers span orders of
/// magnitude: `0.001` is loose at 1.0 and impossibly tight at 1000000.0. A
/// relative `0.0001` means "the same to four significant figures" at either
/// size.
///
/// ```buri role=test
/// from "core/testing/assert" import * as assert;
///
/// test "the sum is right to four significant figures" {
///     assert.approxEqRelative(1000000.0, 1000050.0, 0.0001);
/// }
/// ```
///
/// Two zeroes pass. Anything else against zero fails at every finite tolerance,
/// because the scale is zero too — use `approxEq` where one side may be zero. A
/// `NaN` on either side fails, as it does there.
export fn approxEqRelative(actual: Float, expected: Float, tolerance: Float): () {
    let apart = if (actual > expected) { actual - expected } else { expected - actual };
    let left = magnitude(actual);
    let right = magnitude(expected);
    let scale = if (left > right) { left } else { right };
    report(apart <= tolerance * scale, "approxEqRelative", actual, expected)
}

/// `math.absFloat`, written out for the reason `approxEq` gives: importing
/// `core/math` here makes every test source that imports this one load it.
fn magnitude(x: Float): Float {
    if (x > 0.0 - x) { x } else { 0.0 - x }
}

/// Fails unless `r` is `.Ok`, and returns the wrapped value. That is how a test
/// consumes a `Result`, which is still must-use here.
export fn ok<T, E>(r: Result<T, E>): T {
    match (r) {
        .Ok(v) => v,
        .Err(e) => failExpected("ok", e),
    }
}

export fn err<T, E>(r: Result<T, E>): E {
    match (r) {
        .Ok(v) => failExpected("err", v),
        .Err(e) => e,
    }
}

/// The report shows the `Option` itself, so a failure reads `actual: .None`
/// against `expected: .Some` — both in the syntax you write the value in.
export fn some<T>(o: Option<T>): T {
    match (o) {
        .Some(v) => v,
        .None => failExpected("some", o),
    }
}

/// The mirror of `some`: `actual: .Some("none")` against `expected: .None`.
export fn none<T>(o: Option<T>): () {
    match (o) {
        .Some(_) => failExpected("none", o),
        .None => (),
    }
}

// The runner's side. `report` renders both values only when the assertion
// failed, so a passing test costs one comparison and nothing else.
fn report<T>(passed: Bool, kind: Str, actual: T, expected: T): ();

fn failWith(message: Str): ();

/// Returns the bottom type: a failed assertion ends the test, the way `crash`
/// ends a program.
fn failExpected<T, R>(kind: Str, got: T): R;
