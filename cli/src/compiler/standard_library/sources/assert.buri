//! core/testing/assert — assertions.
//!
//! An ordinary module, imported like any other: `assert` is not a keyword, and
//! the name comes from `import * as assert`. A file is free to call it
//! something else.
//!
//! Two things about this module are not ordinary, and both follow from it being
//! a platform module rather than a library:
//!
//!   - its functions take no `ctx` and still render a failure message. The
//!     runner does the rendering, not the program. That is why this signature
//!     would be a lie anywhere else, and why only a test source may import the
//!     module.
//!   - a failure ends that test and no other. The runner reports the file, the
//!     line, and both values.
//!
//! The set is wide on purpose, and the report is why. `isTrue(xs.contains(x))`
//! gives a passing test's `true` and a failing test's "expected true, got
//! false", which names neither the list nor the element. Every assertion here
//! names the two values it compared, so reaching for the narrowest one that fits
//! is what makes a failure readable.
//!
//! There is no `fail`. It answered `()` rather than a bottom type, so a match arm
//! that used it could not produce a value and a test had to fabricate a dummy one
//! to type-check. A test that has to fail asserts on the value it has: a verdict
//! rendered as a `Str`, or the `Option` itself.

from "core/order" import { Eq };

/// Fails unless `a == b`. Requires `Eq`, and nothing else.
///
/// The comparison goes through `Eq`, so a hand-written implementation decides
/// what equal means here exactly as it does everywhere else. The runner
/// *renders* a failure structurally, walking the type rather than calling
/// `Show`, so there is no `Show` bound to satisfy. A type is assertable as soon
/// as it is comparable.
export fn eq<T: Eq>(actual: T, expected: T): () {
    report(actual == expected, "eq", actual, expected)
}

export fn notEq<T: Eq>(actual: T, expected: T): () {
    report(actual != expected, "notEq", actual, expected)
}

export fn isTrue(actual: Bool): () {
    report(actual, "isTrue", actual, true)
}

export fn isFalse(actual: Bool): () {
    report(actual == false, "isFalse", actual, false)
}

/// Fails unless `needle` is one of `haystack`'s elements.
///
/// `isTrue(xs.contains(x))` is the same check with the report thrown away:
/// "expected true, got false" says nothing about which list or which element.
/// This one names both. The whole list goes on the `actual` line, and the
/// missing element goes on the `expected` line as a one-element list.
export fn contains<T: Eq>(haystack: [T], needle: T): () {
    report(haystack.contains(needle), "contains", haystack, [needle])
}

/// Fails unless `xs` is empty. The report shows what was in it.
export fn isEmpty<T>(xs: [T]): () {
    report(xs.isEmpty(), "isEmpty", xs, [])
}

/// Fails when `xs` is empty.
///
/// The one assertion here with a sentence rather than a diff, because it can
/// only fail at one value: the empty list. A report with `actual: []` against
/// `expected: []` would be two ways of writing the same thing.
export fn notEmpty<T>(xs: [T]): () {
    if (xs.isEmpty()) {
        failWith("assert.notEmpty failed: the list is empty")
    } else {
        ()
    }
}

/// Fails unless `xs` holds exactly `expected` elements. The report compares
/// the two lengths, which is the question that was asked.
export fn len<T>(xs: [T], expected: Int): () {
    report(xs.len() == expected, "len", xs.len(), expected)
}

/// Fails unless `actual > bound`. The report names the bound on its
/// `expected` line: `gt(3, 5)` reads `actual: 3`, `expected: 5`.
export fn gt<T: Ord>(actual: T, bound: T): () {
    report(actual > bound, "gt", actual, bound)
}

/// Fails unless `actual >= bound`.
export fn ge<T: Ord>(actual: T, bound: T): () {
    report(actual >= bound, "ge", actual, bound)
}

/// Fails unless `actual < bound`.
export fn lt<T: Ord>(actual: T, bound: T): () {
    report(actual < bound, "lt", actual, bound)
}

/// Fails unless `actual <= bound`.
export fn le<T: Ord>(actual: T, bound: T): () {
    report(actual <= bound, "le", actual, bound)
}

/// Fails unless `actual` and `expected` are within `tolerance` of each other.
///
/// The tolerance is absolute, and it is a parameter rather than a constant this
/// module picks: how close counts as close enough is a fact about the
/// computation, not about floating point. A `NaN` on either side fails, since it
/// is within nothing.
export fn approxEq(actual: Float, expected: Float, tolerance: Float): () {
    // `math.absFloat` would do, but would make every test source that imports
    // this one load `core/math`. A `NaN` on either side makes `>` false, so the
    // subtraction takes the other branch and is a `NaN` too — and a `NaN` is `<=`
    // nothing, because the ordering operators stay IEEE's (SPEC 6.2).
    let apart = if (actual > expected) { actual - expected } else { expected - actual };
    report(apart <= tolerance, "approxEq", actual, expected)
}

/// Fails unless `r` is `.Ok`, and returns the wrapped value. That is how a test
/// consumes a `Result`, which is still must-use here.
export fn ok<T, E>(r: Result<T, E>): T {
    match (r) {
        .Ok(v) => v,
        .Err(e) => failExpected("ok", e),
    }
}

export fn err<T, E>(r: Result<T, E>): E {
    match (r) {
        .Ok(v) => failExpected("err", v),
        .Err(e) => e,
    }
}

/// The report shows the `Option` itself, so a failure reads `actual: .None`
/// against `expected: .Some` — both in the syntax you write the value in. Passing
/// the word "none" instead would be indistinguishable from a test whose value
/// really was `.Some("none")`.
export fn some<T>(o: Option<T>): T {
    match (o) {
        .Some(v) => v,
        .None => failExpected("some", o),
    }
}

/// The mirror of `some`: `actual: .Some("none")` against `expected: .None`.
export fn none<T>(o: Option<T>): () {
    match (o) {
        .Some(_) => failExpected("none", o),
        .None => (),
    }
}

// The runner's side. `report` renders both values only when the assertion
// failed, so a passing test costs one comparison and nothing else.
fn report<T>(passed: Bool, kind: Str, actual: T, expected: T): ();

fn failWith(message: Str): ();

/// Returns the bottom type: a failed assertion ends the test, the way `crash`
/// ends a program.
fn failExpected<T, R>(kind: Str, got: T): R;
