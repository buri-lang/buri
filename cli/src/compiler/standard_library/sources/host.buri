//! core/host — the host values a `CLOUDFLARE_WORKER` entry binds.
//!
//! Importable only from the module whose `fetch` a worker output enters
//! through. Every other entry takes its platform's host as a parameter — see
//! `platform/host` — and this module goes when Cloudflare becomes a platform a
//! repository writes for itself.
//!
//! A worker that does not grant an effect does not export the value for it, so
//! requesting one is `effect-not-on-platform` at the one line that asked.

from "platform/host" import {
    HostAllocator, HostClock, HostEntropy, HostEnvironment, HostFileSystem, HostListen,
    HostLocation, HostNetwork, HostProcess, HostRandom, HostSockets, HostSpawn,
    HostStderr, HostStdin, HostStdout, HostTasks, HostTcp, HostUi, HostWatch,
    HostWebSocketClient,
};

export let alloc: HostAllocator = HostAllocator { };

export let stdout: HostStdout = HostStdout { };

export let stderr: HostStderr = HostStderr { };

export let stdin: HostStdin = HostStdin { };

export let fs: HostFileSystem = HostFileSystem { };

export let net: HostNetwork = HostNetwork { };

export let clock: HostClock = HostClock { };

export let rand: HostRandom = HostRandom { };

export let entropy: HostEntropy = HostEntropy { };

export let env: HostEnvironment = HostEnvironment { };

export let proc: HostProcess = HostProcess { };

export let spawn: HostSpawn = HostSpawn { };

export let tasks: HostTasks = HostTasks { };

export let listen: HostListen = HostListen { };

export let sockets: HostSockets = HostSockets { };

export let tcp: HostTcp = HostTcp { };

export let websocketClient: HostWebSocketClient = HostWebSocketClient { };

export let ui: HostUi = HostUi { };

export let watch: HostWatch = HostWatch { };

export let location: HostLocation = HostLocation { };
