//! core/host — the platform's implementations of the effects it grants.
//!
//! Importable only from the module that exports `main`. That restriction, and
//! the `testing` segment rule, name every place in a program where authority
//! can enter (SPEC 4.1.1).
//!
//! A program that never names `host.net` cannot open a socket anywhere in its
//! transitive call graph, because nothing anywhere can obtain a value bounded
//! by `Net`. A platform that does not grant an effect simply does not export
//! it, so requesting one is an ordinary unresolved-name error at the one line
//! that asked for it.

from "core/effect" import {
    Alloc, Clock, Connected, Entropy, Env, Header, IoError, Listen, Listener, Net,
    NetError, Proc, Rand, Received, Region, Request, Response, Serve, ServeError,
    Sockets, Stderr, Stdin, Stdout, Tasks, WebSocketClient,
};

// The filesystem's two effects are declared in `core/fs` rather than
// `core/effect`, because their methods name `Path`. See that module's header.
from "core/fs" import { FsRead, FsWrite };
from "core/path" import { Path };

// One `Request`, and it is `core/effect`'s.
from "ui/effect" import { Location, Scope, Ui, Watch };

export struct HostAlloc {}

impl Alloc for HostAlloc {
    fn allocate(self, bytes: Int): Region;
}

export struct HostStdout {}

impl Stdout for HostStdout {
    fn print(self, text: Template): Result<(), IoError>;

    fn println(self, text: Template): Result<(), IoError>;

    fn writeBytes(self, b: [U8]): Result<(), IoError>;
}

export struct HostStderr {}

impl Stderr for HostStderr {
    fn eprint(self, text: Template): Result<(), IoError>;

    fn eprintln(self, text: Template): Result<(), IoError>;
}

export struct HostStdin {}

impl Stdin for HostStdin {
    fn readLine(self): Option<Str>;

    fn readBytes(self, n: Int): Option<[U8]>;
}

/// The platform's filesystem.
///
/// **Granted on LINUX, MACOS and JS.** Not on WEB: a page has no filesystem.
///
/// One value and two effects. A program that binds `FsRead: host.fs` and no
/// `FsWrite` cannot write anywhere in its transitive call graph.
export struct HostFs {}

impl FsRead for HostFs {
    fn readFile(self, path: Path): Result<Str, IoError>;

    fn fileExists(self, path: Path): Bool;

    fn readDir(self, path: Path): Result<[Str], IoError>;

    fn readFileBytes(self, path: Path): Result<[U8], IoError>;
}

impl FsWrite for HostFs {
    fn writeFile(self, path: Path, body: Str): Result<(), IoError>;

    fn writeFileBytes(self, path: Path, body: [U8]): Result<(), IoError>;

    fn appendFile(self, path: Path, body: [U8]): Result<(), IoError>;

    fn renameFile(self, source: Path, destination: Path): Result<(), IoError>;

    fn removeFile(self, path: Path): Result<(), IoError>;

    fn removeDir(self, path: Path): Result<(), IoError>;

    fn makeDir(self, path: Path): Result<(), IoError>;

    fn syncFile(self, path: Path): Result<(), IoError>;
}

export struct HostNet {}

impl Net for HostNet {
    fn fetch(self, request: Request): Result<Response, NetError>;
}

export struct HostClock {}

impl Clock for HostClock {
    fn nowMillis(self): I64;

    fn sleepMillis(self, millis: Int): ();

    fn monotonicNanoseconds(self): I64;
}

export struct HostRand {}

impl Rand for HostRand {
    fn nextInt(self, lo: Int, hi: Int): Int;

    fn nextFloat(self): Float;
}

/// The operating system's own generator, for the one thing `HostRand` does not
/// promise.
///
/// **Granted on every platform.** The toolchain varies instead: a runtime archive
/// built without the `crypto` feature answers `cryptography-not-available` before
/// code generation, the way `net` does.
export struct HostEntropy {}

impl Entropy for HostEntropy {
    fn bytes(self, count: Int): [U8];
}

export struct HostEnv {}

impl Env for HostEnv {
    fn variable(self, name: Str): Option<Str>;

    fn args(self): [Str];
}

export struct HostProc {}

impl Proc for HostProc {
    fn exitWith(self, code: Int): ();
}

/// Running the program's own work concurrently.
///
/// **Granted on every platform, WEB included.** A page's concurrency is its
/// event loop, and `core/tasks`'s `spawn` is how a program puts work on one:
/// a socket that stays open, a retry, a timer. `effect Tasks` has the argument.
///
/// `core/tasks` is the module a program calls; this is what a context binds.
export struct HostTasks {}

impl Tasks for HostTasks {
    fn parallel<C, A, B>(self, ctx: C, items: [A], f: fn(C, Int, A) => B): [B];
}

/// Being a server rather than talking to one.
///
/// **Granted on LINUX and MACOS**, together with `HostSockets`, and never on
/// `JS` or `WEB`: a page does not hold a port open.
///
/// The acceptor is `cli/runtime/net.rs`: an HTTP/1.1 server that reads one
/// request at a time on one connection at a time, with a deadline on every
/// step. `core/net/server` is the module a program calls; this is what a
/// context binds.
export struct HostListen {}

impl Listen for HostListen {
    fn listenBind(
        self,
        address: Str,
        port: Int,
        plan: [Serve],
        requestLimit: Int,
        idleTimeoutMillis: Int,
    ): Result<Listener, ServeError>;

    fn listenAccept(self, handle: Int): Result<Int, ServeError>;

    fn listenRequest(self, connection: Int): Result<Request, ServeError>;

    fn listenRespond(
        self,
        connection: Int,
        status: Int,
        headers: [Header],
        body: [U8],
    ): Result<(), ServeError>;

    fn listenClose(self, handle: Int): ();

    fn listenUpgrade(self, connection: Int): Result<Int, ServeError>;

    fn listenReceive(self, socket: Int): Result<Received, ServeError>;
}

/// Pushing on a connection that is already open.
///
/// **Granted on every platform**, because there are two ways to come by a socket
/// and only one of them belongs to a server. `HostListen.listenUpgrade` mints
/// one where a program can accept connections;
/// `HostWebSocketClient.connectSocket` mints one anywhere, a page included. A
/// handle that names no open socket counts as one that has already gone away, so
/// a handle a program made up and a handle it has spent answer alike.
export struct HostSockets {}

impl Sockets for HostSockets {
    fn socketSendText(self, socket: Int, text: Str): ();

    fn socketSendBytes(self, socket: Int, body: [U8]): ();

    fn socketClose(self, socket: Int, code: Int, reason: Str): ();
}

/// Dialling somebody else's WebSocket.
///
/// **Granted on every platform.** Holding a port open is a native program's
/// authority; dialling out is not, and a page does it every day. On `WEB` both
/// methods suspend without holding the event loop, which is the same thing that
/// let `HostNet` onto a page.
///
/// Natively the two are `cli/runtime/net.rs`'s, over the same RFC 6455 framing:
/// the socket a client dials and the socket a server accepts are the same value
/// in the same table, so `HostSockets` writes on both without knowing which it
/// has. On JavaScript they wrap the platform's own `WebSocket`.
///
/// `core/net/websocket` is the module a program calls; this is what a context
/// binds.
export struct HostWebSocketClient {}

impl WebSocketClient for HostWebSocketClient {
    fn connectSocket(self, url: Str): Result<Connected, ServeError>;

    fn connectReceive(self, socket: Int): Result<Received, ServeError>;
}

/// The reactive graph. A program with a user interface binds it, and a platform
/// that renders nothing is never asked for one.
export struct HostUi {}

impl Ui for HostUi {
    fn signal<T>(self, initial: T): Int;

    fn read<T>(self, id: Int): T;

    fn write<T>(self, id: Int, value: T): ();

    fn memo<T>(self, compute: fn(Scope) => T): Int;

    fn watch(self, run: fn(Scope) => ()): ();
}

/// Reading the reactive graph, without the authority to change it.
export struct HostWatch {}

impl Watch for HostWatch {
    fn read<T>(self, id: Int): T;
}

/// The address bar. A page binds it to route on the path it was opened at and
/// to re-route when the reader navigates.
///
/// **Granted on WEB alone**, because nothing else has one. A worker reads the
/// path off the request it was handed, which is `Request.path` and no authority
/// at all.
export struct HostLocation {}

impl Location for HostLocation {
    fn path(self): Int;
}

export let alloc: HostAlloc = HostAlloc { };

export let stdout: HostStdout = HostStdout { };

export let stderr: HostStderr = HostStderr { };

export let stdin: HostStdin = HostStdin { };

export let fs: HostFs = HostFs { };

export let net: HostNet = HostNet { };

export let clock: HostClock = HostClock { };

export let rand: HostRand = HostRand { };

export let entropy: HostEntropy = HostEntropy { };

export let env: HostEnv = HostEnv { };

export let proc: HostProc = HostProc { };

export let tasks: HostTasks = HostTasks { };

export let listen: HostListen = HostListen { };

export let sockets: HostSockets = HostSockets { };

export let websocketClient: HostWebSocketClient = HostWebSocketClient { };

export let ui: HostUi = HostUi { };

export let watch: HostWatch = HostWatch { };

export let location: HostLocation = HostLocation { };
