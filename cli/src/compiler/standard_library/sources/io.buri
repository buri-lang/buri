//! core/io — printing and reading a line.
//!
//! These are free functions over a context, so they keep the context first.
//! The same operations are reachable as `ctx.println(...)`, because an effect
//! is an interface and its methods resolve through the bound like any other.
//!
//! `print` and `println` return `()`, not `Result`. Stream errors are reported
//! by the platform at flush time and surface as `main`'s exit status; threading
//! an `IoError` through every print statement buys nothing a program can act on
//! (SPEC 5.7.1).

from "core/effect" import { Stderr, Stdin, Stdout };

export fn print<C: Stdout>(ctx: C, text: Template): () {
  ctx.print(text)
}

export fn println<C: Stdout>(ctx: C, text: Template): () {
  ctx.println(text)
}

export fn eprint<C: Stderr>(ctx: C, text: Template): () {
  ctx.eprint(text)
}

export fn eprintln<C: Stderr>(ctx: C, text: Template): () {
  ctx.eprintln(text)
}

export fn readLine<C: Stdin>(ctx: C): Option<Str> {
  ctx.readLine()
}

/// Exactly `n` octets from standard input, or fewer at end of input.
///
/// Text and octets are two different questions about the same stream, so they
/// are two different operations: `readLine` decodes, this does not. Mixing them
/// on one stream is undefined, and a program should pick one.
export fn readBytes<C: Stdin>(ctx: C, n: Int): Option<[U8]> {
  ctx.readBytes(n)
}

/// Octets to standard output, encoded as nothing.
export fn writeBytes<C: Stdout>(ctx: C, b: [U8]): () {
  ctx.writeBytes(b)
}
