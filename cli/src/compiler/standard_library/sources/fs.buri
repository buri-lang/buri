//! core/fs — the filesystem: two effects, and the doors onto them.
//!
//! Every function here names `FsRead` or `FsWrite` in its bounds. The disk is
//! visible in the signature, and so is *which half* of the disk.
//!
//! ## Reading and writing are two authorities
//!
//! `FsRead` has four methods, `FsWrite` has eight. They are two grants: a
//! program that reads its configuration hasn't thereby earned the right to
//! delete it.
//!
//! ```buri sig
//! # from "core/effect" import { Alloc, IoError };
//! # from "core/fs" import * as fs;
//! # from "core/fs" import { FsRead, Path };
//! #
//! export fn settings<C: Alloc + FsRead>(ctx: C, at: Path): Result<Str, IoError> {
//!     fs.readText(ctx, at)
//! }
//! ```
//!
//! Nothing `settings` calls can write, because nothing it hands `ctx` to can
//! ask for `FsWrite` from a context that doesn't bind it. A program doing both
//! binds both: `FsRead: host.fs, FsWrite: host.fs`.
//!
//! ## Every operation takes a `Path`
//!
//! Not a `Str`. `core/path` normalizes text once, at the boundary where it
//! becomes a path. See that module for what normalizing does and what it
//! won't do.
//!
//! ## Directories
//!
//! `makeDir` creates a directory and every missing parent of it. `removeDir`
//! removes one that is **empty**. Neither is recursive: creation is `mkdir -p`,
//! removal is `rmdir`. A program that wants a recursive delete writes the walk
//! itself out of `listDir`, `remove` and `removeDir`.
//!
//! ## Text and octets
//!
//! `readText` and `writeText` are the text pair. `readBytes` and `writeBytes`
//! are the same two operations without an encoding step. Reading text
//! substitutes U+FFFD for anything that is not valid UTF-8, so read a file
//! that is not text as octets to get it back unchanged.
//!
//! ## What is atomic, and what is durable
//!
//! Two different promises.
//!
//! **Atomic** is `rename`, and only `rename`. Once it returns, the destination
//! names either the file it named before or the file the source named — never
//! a mixture, never nothing. Within one filesystem that is POSIX `rename(2)`,
//! which the JavaScript runner reaches through `fs.renameSync`. Across two
//! filesystems the answer is `.Err(.CrossDevice)`.
//!
//! **Durable** is `sync`, and only `sync`. `writeBytes` and `append` return
//! once the platform accepted the octets, which is not the same as the storage
//! device holding them. What each backend promises:
//!
//! | Backend | `sync` is | Survives |
//! |---|---|---|
//! | native, Linux | `fsync(2)` | the process, and the operating system |
//! | native, macOS | `fcntl(F_FULLFSYNC)` | those two, and the drive's own cache |
//! | JavaScript runner | `fs.fsyncSync` | the process, and the operating system |
//! | `core/host/testing`'s `TestFs` | nothing to flush | the test that wrote it |
//!
//! Watch the macOS rows. Node's `fsync` is the plain `fsync(2)`, which on
//! macOS asks the drive to write its cache and does not wait for it. The
//! native backend asks for `F_FULLFSYNC` there, which does wait.
//!
//! `sync` on a **directory** flushes the directory entry rather than a file's
//! contents, which is what makes a preceding `rename` durable rather than
//! merely visible. So a checkpoint is four calls — `writeBytes` the temporary,
//! `sync` it, `rename` it over the old one, `sync` the directory holding both
//! — and [`writeAtomic`] is those four written once.

from "core/effect" import { Alloc, IoError };
from "core/path" import { Path };

from "core/effect" export { IoError };

from "core/path" export { Path };

/// Looking at what is on the filesystem.
///
/// The half of the filesystem that changes nothing. A context that binds this
/// and not `FsWrite` grants a program authority to read and none to write.
export effect FsRead {
    fn readFile(self, path: Path): Result<Str, IoError>;
    fn fileExists(self, path: Path): Bool;
    fn readDir(self, path: Path): Result<[Str], IoError>;

    /// The octets, unchanged. `readFile` decodes UTF-8 and substitutes U+FFFD
    /// for anything that is not; use this for a file that is not text.
    fn readFileBytes(self, path: Path): Result<[U8], IoError>;
}

/// Changing what is on the filesystem.
///
/// Eight methods, none of which reads. A program that only writes — a logger, a
/// recorder — binds this and nothing else.
export effect FsWrite {
    fn writeFile(self, path: Path, body: Str): Result<(), IoError>;
    /// Truncates an existing file, and creates one that is absent.
    fn writeFileBytes(self, path: Path, body: [U8]): Result<(), IoError>;
    /// Appends the whole body, creating the file when it is absent.
    fn appendFile(self, path: Path, body: [U8]): Result<(), IoError>;
    /// Replaces `destination`, atomically within one filesystem.
    fn renameFile(self, source: Path, destination: Path): Result<(), IoError>;
    fn removeFile(self, path: Path): Result<(), IoError>;
    /// Removes the directory, which must be **empty**. `.Err(.Other)` where it
    /// is not, and `.Err(.NotFound)` where the path names nothing. `removeDir`
    /// below states the whole rule.
    fn removeDir(self, path: Path): Result<(), IoError>;
    /// Parents included; an existing directory is `.Ok`.
    fn makeDir(self, path: Path): Result<(), IoError>;
    /// The commit point: what was written to `path` is durable once this
    /// returns. `sync` below states what each platform promises.
    fn syncFile(self, path: Path): Result<(), IoError>;
}

export fn readText<C: Alloc + FsRead>(ctx: C, path: Path): Result<Str, IoError> {
    ctx.readFile(path)
}

export fn writeText<C: Alloc + FsWrite>(
    ctx: C,
    path: Path,
    body: Str,
): Result<(), IoError> {
    ctx.writeFile(path, body)
}

export fn exists<C: FsRead>(ctx: C, path: Path): Bool {
    ctx.fileExists(path)
}

export fn listDir<C: Alloc + FsRead>(ctx: C, path: Path): Result<[Str], IoError> {
    ctx.readDir(path)
}

/// The file's octets, unchanged.
///
/// `.Err(.NotFound)` where the path names nothing, exactly as `readText` does.
/// The only difference from `readText` is the encoding step: a file holding a
/// protobuf message or a log record wants this one, because `readText` would
/// substitute U+FFFD into it.
export fn readBytes<C: Alloc + FsRead>(ctx: C, path: Path): Result<[U8], IoError> {
    ctx.readFileBytes(path)
}

/// The file's octets, or `.None` where the path names nothing.
///
/// "Read it, or carry on without it" — a cache, an optional override, a
/// checkpoint nobody has written yet. Unlike `exists` followed by `readBytes`,
/// this is *one* call, with no window for the file to vanish in between. The
/// `.None` comes from `.NotFound` on the read itself and nowhere else.
///
/// Every other failure is still a failure. A file that is there and cannot be
/// read is `.Err(.PermissionDenied)`, not `.Ok(.None)`.
///
/// ```buri run
/// from "core/effect" import { Alloc, Stdout };
/// from "core/fs" import * as fs;
/// from "core/fs" import { FsRead };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/path" import * as path;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Alloc: host.alloc,
///         FsRead: host.fs,
///         Stdout: host.stdout,
///     };
///     let answer = match (fs.readBytesIfExists(ctx, path.of(ctx, "no-such-file"))) {
///         .Ok(.None) => "absent",
///         .Ok(.Some(_body)) => "there",
///         .Err(_e) => "unreadable",
///     };
///     let _ = io.println(ctx, "${answer}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// absent
/// ```
export fn readBytesIfExists<C: Alloc + FsRead>(
    ctx: C,
    path: Path,
): Result<Option<[U8]>, IoError> {
    match (ctx.readFileBytes(path)) {
        .Ok(body) => .Ok(.Some(body)),
        .Err(.NotFound) => .Ok(.None),
        .Err(other) => .Err(other),
    }
}

/// Replaces the file's contents with these octets, creating it when it is
/// absent.
///
/// Durable only after `sync`; see the module header.
export fn writeBytes<C: Alloc + FsWrite>(
    ctx: C,
    path: Path,
    body: [U8],
): Result<(), IoError> {
    ctx.writeFileBytes(path, body)
}

/// Replaces the file's contents with these octets, or leaves the file exactly
/// as it was.
///
/// The checkpoint sequence the module header spells out, written once: it
/// writes and syncs a sibling temporary, renames it over the destination, then
/// syncs the directory holding both. A reader of the destination sees the old
/// contents or the new ones, never a mixture and never nothing, including
/// across a crash.
///
/// **The temporary is `<path>.tmp`, a sibling.** `rename` is atomic only within
/// one filesystem, and a sibling is the one place guaranteed to be on the same
/// one. So two writers of one path share the temporary and the last rename
/// wins, except that no reader ever sees half of either.
///
/// The first failure is the answer, and the temporary stays where it is.
///
/// `.Err(.Other)` where the path has no last component — the root, and `.` —
/// because there is no sibling to write beside it.
export fn writeAtomic<C: Alloc + FsWrite>(
    ctx: C,
    path: Path,
    body: [U8],
): Result<(), IoError> {
    match (path.withSuffix(ctx, ".tmp")) {
        .None => .Err(.Other("a path with no file name cannot be written atomically")),
        .Some(temp) => {
            let _written = ctx.writeFileBytes(temp, body)?;
            let _flushed = ctx.syncFile(temp)?;
            let _moved = ctx.renameFile(temp, path)?;
            match (path.parent()) {
                .None => .Ok(()),
                .Some(directory) => ctx.syncFile(directory),
            }
        },
    }
}

/// Adds these octets to the end of the file, creating it when it is absent.
///
/// Whole-body, so one call is one record. It takes the position and writes the
/// octets as one operation, so two writers appending to one log interleave
/// records rather than overwriting each other.
///
/// Durable only after `sync`.
export fn append<C: Alloc + FsWrite>(
    ctx: C,
    path: Path,
    body: [U8],
): Result<(), IoError> {
    ctx.appendFile(path, body)
}

/// Moves `source` onto `destination`, replacing it if it is there.
///
/// Atomic within one filesystem: a reader of the destination sees the old file
/// or the new one, never a partial write. That is what makes "write a
/// temporary, then rename it over the real one" a crash-safe checkpoint.
/// `.Err(.CrossDevice)` where the two paths are not on one filesystem.
///
/// The rename is *visible* when this returns and *durable* after you `sync`
/// the directory holding it. `writeAtomic` is the whole sequence.
export fn rename<C: FsWrite>(
    ctx: C,
    source: Path,
    destination: Path,
): Result<(), IoError> {
    ctx.renameFile(source, destination)
}

/// Deletes the file.
///
/// `.Err(.NotFound)` where the path names nothing, because a path that was
/// never right is the most common way for a deletion to be wrong. "Delete it if
/// it is there" is `result.ignore(fs.remove(ctx, p))`.
///
/// Files only. `removeDir` is the directory half, and neither is recursive.
export fn remove<C: FsWrite>(ctx: C, path: Path): Result<(), IoError> {
    ctx.removeFile(path)
}

/// Deletes the directory, which must be **empty**.
///
/// This is `makeDir`'s inverse, and it is how a program that made a scratch
/// directory leaves the filesystem as it found it.
///
/// **Empty, and not recursive.** On every backend with a real filesystem this
/// is `rmdir(2)`, and a directory that still holds something is `.Err(.Other)`
/// carrying the platform's own `ENOTEMPTY` sentence. There is no recursive form
/// and no flag that turns one on: a program that wants one writes the walk
/// itself out of `listDir` and these two removals.
///
/// `.Err(.NotFound)` where the path names nothing, and `.Err(.NotADirectory)`
/// where the path names a file. "Remove it if it is there" is
/// `fs.removeDir(ctx, p).ignore()`.
export fn removeDir<C: FsWrite>(ctx: C, path: Path): Result<(), IoError> {
    ctx.removeDir(path)
}

/// Creates the directory, and every missing parent of it.
///
/// An existing directory is `.Ok`, so a tenant's directory is one call rather
/// than a check and a race: two callers who both find it missing both succeed.
/// A path that already names a *file* is `.Err(.AlreadyExists)`.
///
/// Unlike `remove`, this states a postcondition — this directory exists — that
/// somebody else reaching it first does not violate.
export fn makeDir<C: FsWrite>(ctx: C, path: Path): Result<(), IoError> {
    ctx.makeDir(path)
}

/// Waits until what was written to `path` is durable.
///
/// This is a program's commit point. `writeBytes`, `append` and `rename` return
/// once the platform accepted the operation; they survive a power cut only
/// after this returns. On a directory path it flushes the directory entry,
/// which is what a preceding `rename` needs.
///
/// The module header's table says what each backend promises. They are not all
/// the same promise, and the two macOS rows differ.
export fn sync<C: FsWrite>(ctx: C, path: Path): Result<(), IoError> {
    ctx.syncFile(path)
}
