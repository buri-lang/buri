//! core/list — the defining module of `[T]`.
//!
//! One split runs through this file, the one SPEC 10.5 draws: an operation
//! whose result size is fixed is pure, and an operation whose result size
//! depends on runtime data names `Allocator`. `length` and `fold` are pure. `map` and
//! `filter` are not, and their signatures say so.
//!
//! Everything here takes its collection as `self`, so you can call it as a
//! method with no import: receiver first, context second, everything else
//! after (SPEC 10.7).

from "core/effect" import { Allocator };
from "core/order" import { Ordered, Order };

// --- Pure: no context parameter at all --------------------------------------

impl<T> [T] {
    export fn length(self): Int;

    export fn isEmpty(self): Bool {
        self.length() == 0
    }

    /// Indexing yields `Option<T>`. There is no way to index out of bounds and
    /// no way to panic by indexing.
    export fn get(self, index: Int): Option<T>;

    export fn first(self): Option<T> {
        self.get(0)
    }

    export fn last(self): Option<T> {
        self.get(self.length() - 1)
    }

    /// A fold produces one value rather than a new collection, so it allocates
    /// nothing and needs no context.
    export fn fold<B>(self, f: fn(B, T) => B, init: B): B;

    /// The `*Ctx` variant, for a step that needs an effect. A lambda may not
    /// capture one (SPEC 10.6), so you thread the context through instead.
    export fn foldCtx<B, C>(self, ctx: C, f: fn(C, B, T) => B, init: B): B;

    /// Stops at the first `.Err` — how you write a fallible fold without an
    /// early exit.
    export fn foldResult<B, E>(
        self,
        f: fn(B, T) => Result<B, E>,
        init: B,
    ): Result<B, E>;

    /// The same, but `f` takes the context instead of capturing it — a fallible
    /// fold that allocates as it goes.
    export fn foldResultCtx<B, E, C: Allocator>(
        self,
        ctx: C,
        f: fn(C, B, T) => Result<B, E>,
        init: B,
    ): Result<B, E>;

    export fn any(self, pred: fn(T) => Bool): Bool;

    export fn all(self, pred: fn(T) => Bool): Bool;

    export fn find(self, pred: fn(T) => Bool): Option<T>;

    export fn findIndex(self, pred: fn(T) => Bool): Option<Int>;
}

impl<T: Equal> [T] {
    export fn contains(self, needle: T): Bool {
        self.any(fn(x) => x == needle)
    }
}

impl<T> [T] {
    export fn count(self, pred: fn(T) => Bool): Int;

    /// Whether every neighbouring pair is in order — `cmp(xs[i], xs[i + 1])` is
    /// never `.Greater`. The empty list and a single element are sorted. This is
    /// the predicate `sort` and `sortBy` answer.
    export fn isSortedBy(self, cmp: fn(T, T) => Order): Bool {
        sortedFrom(self, cmp, 0)
    }

    /// The greatest element by `cmp`, or `.None` for an empty list. Ties go to
    /// the earlier element, which is `maximum`'s answer too.
    ///
    /// `maximum` is this with the type's own `Ordered`. This form takes the order as
    /// a value, so "the row with the largest score" needs no `Ordered` on the row.
    export fn maxBy(self, cmp: fn(T, T) => Order): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => {
                        match (cmp(x, b)) {
                            .Greater => .Some(x),
                            _ => .Some(b),
                        }
                    },
                }
            },
            .None,
        )
    }

    /// The least element by `cmp`, or `.None` for an empty list. Ties go to
    /// the earlier element.
    export fn minBy(self, cmp: fn(T, T) => Order): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => {
                        match (cmp(x, b)) {
                            .Less => .Some(x),
                            _ => .Some(b),
                        }
                    },
                }
            },
            .None,
        )
    }

    /// Lexicographic comparison, element by element with `cmp`, the shorter
    /// list first when one is a prefix of the other.
    ///
    /// `[T]` satisfies `Ordered` structurally whenever `T` does (SPEC 5.11), so `<`
    /// on two lists already answers this order. This adds the comparator form: a
    /// list compared by an order that is not the element type's own.
    export fn compareBy(self, other: [T], cmp: fn(T, T) => Order): Order {
        compareFrom(self, other, cmp, 0)
    }
}

/// This walks by index rather than folding, because a fold's lambda would have
/// to capture the other list, and a lambda may not capture a value whose type
/// could be a context (SPEC 10.6).
fn compareFrom<T>(a: [T], b: [T], cmp: fn(T, T) => Order, at: Int): Order {
    match ((a.get(at), b.get(at))) {
        (.None, .None) => .Equal,
        (.None, .Some(_)) => .Less,
        (.Some(_), .None) => .Greater,
        (.Some(x), .Some(y)) => {
            match (cmp(x, y)) {
                .Equal => compareFrom(a, b, cmp, at + 1),
                decided => decided,
            }
        },
    }
}

fn sortedFrom<T>(xs: [T], cmp: fn(T, T) => Order, at: Int): Bool {
    match ((xs.get(at), xs.get(at + 1))) {
        (.Some(a), .Some(b)) => {
            match (cmp(a, b)) {
                .Greater => false,
                _ => sortedFrom(xs, cmp, at + 1),
            }
        },
        // One element left, or none: there is no pair to be out of order.
        _ => true,
    }
}

impl<T: Ordered> [T] {
    /// The type's own order, lexicographically over the list — `compareBy`
    /// with `T`'s `compare`.
    ///
    /// The compiler owns `[T]`'s structural `Ordered` conformance (SPEC 5.11), since
    /// an `impl` registers against a type *constructor* and `[T]` is not one.
    /// This is that same order, callable by name.
    export fn compare(self, other: [T]): Order {
        self.compareBy(other, fn(a, b) => a.compare(b))
    }
}

// --- Deterministic: bounded by <C: Allocator> ------------------------------------

impl<A> [A] {
    export fn map<B, C: Allocator>(self, ctx: C, f: fn(A) => B): [B];

    export fn mapCtx<B, C: Allocator>(self, ctx: C, f: fn(C, A) => B): [B];

    /// `mapCtx`, with the runtime running the step rather than a loop the
    /// backend writes. The answer is `mapCtx`'s answer, element for element.
    ///
    /// Prefer `mapCtx`. This is slower by an indirect call per element, and no
    /// case makes it the better tool. It exists to exercise the runtime calling
    /// back into Buri code.
    export fn mapCtxStep<B, C: Allocator>(self, ctx: C, f: fn(C, A) => B): [B];

    /// `map` with a step that can fail: every element mapped, or the first
    /// `.Err` and nothing after it.
    ///
    /// It stops at the first failure and never calls `f` again, so a validation
    /// reports the first bad element rather than the last.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// fn small(n: Int): Result<Int, Int> {
    ///     if (n < 10) { .Ok(n * 2) } else { .Err(n) }
    /// }
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let doubled = [1, 2, 3].mapResult(ctx, small);
    ///     let refused = [1, 20, 3].mapResult(ctx, small);
    ///     let shown = match ((doubled, refused)) {
    ///         (.Ok(xs), .Err(n)) => "${xs.length()} doubled, and then ${n}",
    ///         _ => "unreachable",
    ///     };
    ///     let _ = io.println(ctx, shown).ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 3 doubled, and then 20
    /// ```
    export fn mapResult<B, E, C: Allocator>(
        self,
        ctx: C,
        f: fn(A) => Result<B, E>,
    ): Result<[B], E> {
        self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(x)) {
                    .Ok(b) => .Ok(acc.push(c, b)),
                    .Err(e) => .Err(e),
                }
            },
            empty<B>(),
        )
    }

    /// `mapResult`, but the step takes the context instead of capturing it. The
    /// form a validation takes, since checking an element usually allocates and
    /// a lambda may not capture a context (SPEC 10.6).
    export fn mapResultCtx<B, E, C: Allocator>(
        self,
        ctx: C,
        f: fn(C, A) => Result<B, E>,
    ): Result<[B], E> {
        self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(c, x)) {
                    .Ok(b) => .Ok(acc.push(c, b)),
                    .Err(e) => .Err(e),
                }
            },
            empty<B>(),
        )
    }

    /// `mapResult` for a step that answers `Option`: every element mapped, or
    /// `.None` the moment one is missing.
    export fn mapOption<B, C: Allocator>(self, ctx: C, f: fn(A) => Option<B>): Option<[B]> {
        // `Result` is the shape with an early exit in it, so the walk is one
        // and the two names differ only in what they answer.
        let mapped = self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(x)) {
                    .Some(b) => .Ok(acc.push(c, b)),
                    .None => .Err(()),
                }
            },
            empty<B>(),
        );
        match (mapped) {
            .Ok(bs) => .Some(bs),
            .Err(_) => .None,
        }
    }

    /// `mapOption`, but the step takes the context instead of capturing it.
    export fn mapOptionCtx<B, C: Allocator>(
        self,
        ctx: C,
        f: fn(C, A) => Option<B>,
    ): Option<[B]> {
        let mapped = self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(c, x)) {
                    .Some(b) => .Ok(acc.push(c, b)),
                    .None => .Err(()),
                }
            },
            empty<B>(),
        );
        match (mapped) {
            .Ok(bs) => .Some(bs),
            .Err(_) => .None,
        }
    }

    /// Maps and filters in one pass: it drops an element `f` answers `.None`
    /// for, and the `.Some` payloads are the result.
    export fn filterMap<B, C: Allocator>(self, ctx: C, f: fn(A) => Option<B>): [B] {
        self.foldCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(x)) {
                    .Some(b) => acc.push(c, b),
                    .None => acc,
                }
            },
            empty<B>(),
        )
    }

    /// `filterMap`, but the step takes the context instead of capturing it.
    export fn filterMapCtx<B, C: Allocator>(self, ctx: C, f: fn(C, A) => Option<B>): [B] {
        self.foldCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(c, x)) {
                    .Some(b) => acc.push(c, b),
                    .None => acc,
                }
            },
            empty<B>(),
        )
    }
}

impl<T> [T] {
    export fn filter<C: Allocator>(self, ctx: C, keep: fn(T) => Bool): [T];

    export fn filterCtx<C: Allocator>(self, ctx: C, keep: fn(C, T) => Bool): [T];

    export fn concat<C: Allocator>(self, ctx: C, other: [T]): [T];

    export fn push<C: Allocator>(self, ctx: C, item: T): [T];

    export fn reverse<C: Allocator>(self, ctx: C): [T];

    /// Ordering is a value you pass, so the tie-break is explicit and reviewable.
    /// The sort is stable.
    export fn sortBy<C: Allocator>(self, ctx: C, order: fn(T, T) => Order): [T];
}

impl<T: Ordered> [T] {
    /// `sortBy` with the type's own `Ordered`, and stable like it.
    ///
    /// For `[Str]` that is `core/str`'s `compare`: lexicographic by Unicode
    /// scalar value, which for a valid string is UTF-8 byte order, on both
    /// backends. It is not JavaScript's UTF-16 order, so an emoji sorts after
    /// a character in U+E000..U+FFFF rather than before it.
    export fn sort<C: Allocator>(self, ctx: C): [T] {
        self.sortBy(ctx, fn(a, b) => a.compare(b))
    }
}

impl<T> [T] {
    export fn take<C: Allocator>(self, ctx: C, n: Int): [T];

    export fn drop<C: Allocator>(self, ctx: C, n: Int): [T];

    export fn slice<C: Allocator>(self, ctx: C, start: Int, end: Int): [T];

    /// Everything but the element at `index`. An index outside the list removes
    /// nothing.
    export fn removeAt<C: Allocator>(self, ctx: C, index: Int): [T] {
        self.take(ctx, index).concat(ctx, self.drop(ctx, index + 1))
    }

    /// Every run of `size` neighbouring elements, one position apart:
    /// `[1, 2, 3].windows(ctx, 2)` is `[[1, 2], [2, 3]]`.
    ///
    /// A list shorter than `size` has no windows, and a `size` of zero or less
    /// has none either.
    export fn windows<C: Allocator>(self, ctx: C, size: Int): [[T]] {
        if (size <= 0) {
            empty<[T]>()
        } else {
            windowsFrom(ctx, self, size, 0, empty<[T]>())
        }
    }

    /// The first element of each class `cmp` calls `.Equal`, in the order they
    /// arrived — it keeps the list's order, not the comparator's, and two equal
    /// elements need not be neighbours.
    ///
    /// O(n²) comparisons, because keeping the first occurrence means asking
    /// about every element already kept. For a large list, `sortBy` and a walk
    /// over neighbours is the O(n log n) answer, and `core/orderedset` is the one
    /// that also answers membership.
    export fn uniqueBy<C: Allocator>(self, ctx: C, cmp: fn(T, T) => Order): [T] {
        uniqueFrom(ctx, self, cmp, 0, empty<T>())
    }
}

/// Tail-recursive rather than a `map` over indices, because the lambda would
/// have to capture the list (SPEC 10.6).
fn windowsFrom<T, C: Allocator>(ctx: C, xs: [T], size: Int, at: Int, acc: [[T]]): [[T]] {
    if (at + size > xs.length()) {
        acc
    } else {
        windowsFrom(ctx, xs, size, at + 1, acc.push(ctx, xs.slice(ctx, at, at + size)))
    }
}

fn uniqueFrom<T, C: Allocator>(
    ctx: C,
    xs: [T],
    cmp: fn(T, T) => Order,
    at: Int,
    acc: [T],
): [T] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => {
            let next = if (equalAt(acc, x, cmp, 0)) { acc } else { acc.push(ctx, x) };
            uniqueFrom(ctx, xs, cmp, at + 1, next)
        },
    }
}

/// Whether `x` is `.Equal` to something in `seen`. `any` would want a lambda
/// capturing `x`, which SPEC 10.6 refuses.
fn equalAt<T>(seen: [T], x: T, cmp: fn(T, T) => Order, at: Int): Bool {
    match (seen.get(at)) {
        .None => false,
        .Some(y) => {
            match (cmp(x, y)) {
                .Equal => true,
                _ => equalAt(seen, x, cmp, at + 1),
            }
        },
    }
}

impl<A> [A] {
    export fn zip<B, C: Allocator>(self, ctx: C, other: [B]): [(A, B)];
}

impl<T> [[T]] {
    export fn flatten<C: Allocator>(self, ctx: C): [T];
}

impl [Str] {
    /// Declared here rather than in `core/str` because its receiver is `[Str]`,
    /// and a method lives in its receiver type's defining module.
    export fn join<C: Allocator>(self, ctx: C, separator: Str): Str;
}

export fn empty<T>(): [T];

/// `[from, from+1, ..., to-1]`. Counting without a loop and without a `Range`
/// type — design/non-goals.md records why neither exists.
export fn range<C: Allocator>(ctx: C, start: Int, end: Int): [Int];

export fn repeat<T, C: Allocator>(ctx: C, item: T, times: Int): [T];

/// `[f(0), f(1), ..., f(n - 1)]`. `repeat` for an element that depends on its
/// own position. An `n` of zero or less is the empty list.
export fn generate<T, C: Allocator>(ctx: C, n: Int, f: fn(Int) => T): [T] {
    range(ctx, 0, n).map(ctx, fn(i) => f(i))
}

// --- Numeric folds ------------------------------------------------------------

impl [Int] {
    export fn sum(self): Int {
        self.fold(fn(acc, x) => acc + x, 0)
    }
}

impl [Float] {
    export fn sumFloat(self): Float {
        self.fold(fn(acc, x) => acc + x, 0.0)
    }
}

impl<T: Ordered> [T] {
    export fn maximum(self): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => if (x > b) { .Some(x) } else { .Some(b) },
                }
            },
            .None,
        )
    }

    export fn minimum(self): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => if (x < b) { .Some(x) } else { .Some(b) },
                }
            },
            .None,
        )
    }
}

// --- Position: the index, and the list around it -------------------------------

impl<A> [A] {
    /// `map` for a step that answers a list, with the pieces run together —
    /// `[[1], [], [2, 3]]` flattened as it is built.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let doubled = [1, 2, 3].flatMap(ctx, fn(n) => [n, n]);
    ///     let _ = io.println(ctx, "${doubled.length()}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 6
    /// ```
    export fn flatMap<B, C: Allocator>(self, ctx: C, transform: fn(A) => [B]): [B] {
        self.map(ctx, transform).flatten(ctx)
    }

    /// `flatMap`, but the step takes the context instead of capturing it — the
    /// form to use when building each piece allocates.
    export fn flatMapCtx<B, C: Allocator>(self, ctx: C, transform: fn(C, A) => [B]): [B] {
        self.mapCtx(ctx, transform).flatten(ctx)
    }

    /// `map` with the element's position, counting from zero.
    export fn mapIndexed<B, C: Allocator>(self, ctx: C, transform: fn(Int, A) => B): [B] {
        mappedFrom(ctx, self, transform, 0, empty<B>())
    }

    /// `mapIndexed`, with the context threaded rather than captured.
    export fn mapIndexedCtx<B, C: Allocator>(
        self,
        ctx: C,
        transform: fn(C, Int, A) => B,
    ): [B] {
        mappedCtxFrom(ctx, self, transform, 0, empty<B>())
    }
}

fn mappedFrom<A, B, C: Allocator>(
    ctx: C,
    xs: [A],
    f: fn(Int, A) => B,
    at: Int,
    acc: [B],
): [B] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => mappedFrom(ctx, xs, f, at + 1, acc.push(ctx, f(at, x))),
    }
}

fn mappedCtxFrom<A, B, C: Allocator>(
    ctx: C,
    xs: [A],
    f: fn(C, Int, A) => B,
    at: Int,
    acc: [B],
): [B] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => mappedCtxFrom(ctx, xs, f, at + 1, acc.push(ctx, f(ctx, at, x))),
    }
}

impl<T> [T] {
    /// `fold` with the element's position. Pure, like `fold`: one value out,
    /// nothing allocated.
    export fn foldIndexed<B>(self, step: fn(B, Int, T) => B, init: B): B {
        foldedFrom(self, step, 0, init)
    }

    /// `filter` with the element's position — "every other one" without a
    /// counter threaded through a fold.
    export fn filterIndexed<C: Allocator>(self, ctx: C, keep: fn(Int, T) => Bool): [T] {
        keptFrom(ctx, self, keep, 0, empty<T>())
    }

    /// Each element paired with its position. `mapIndexed` is this and a `map`
    /// without the list in between.
    export fn indexed<C: Allocator>(self, ctx: C): [(Int, T)] {
        pairedFrom(ctx, self, 0, empty<(Int, T)>())
    }

    /// The longest leading run the predicate accepts. It stops at the first
    /// element it refuses and does not look past it, which is what tells this
    /// from `filter`.
    export fn takeWhile<C: Allocator>(self, ctx: C, keep: fn(T) => Bool): [T] {
        self.take(ctx, runLength(self, keep, 0))
    }

    /// Everything after the longest leading run the predicate accepts — the
    /// other half of `takeWhile`.
    export fn dropWhile<C: Allocator>(self, ctx: C, skip: fn(T) => Bool): [T] {
        self.drop(ctx, runLength(self, skip, 0))
    }

    /// Neighbouring elements in groups of `size`, without overlap: `windows`
    /// slides by one, this steps by `size`. The last group is short when the
    /// length is not a multiple, and a `size` of zero or less has no groups.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let groups = [1, 2, 3, 4, 5].chunks(ctx, 2);
    ///     let last: [Int] = groups.last().withDefault([]);
    ///     let _ = io.println(ctx, "${groups.length()} ${last.length()}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 3 1
    /// ```
    export fn chunks<C: Allocator>(self, ctx: C, size: Int): [[T]] {
        if (size <= 0) {
            empty<[T]>()
        } else {
            chunksFrom(ctx, self, size, 0, empty<[T]>())
        }
    }

    /// The elements the predicate accepts and the ones it refuses, each in the
    /// order they arrived. One pass, where two `filter`s are two.
    export fn partition<C: Allocator>(self, ctx: C, keep: fn(T) => Bool): ([T], [T]) {
        partitionFrom(ctx, self, keep, 0, empty<T>(), empty<T>())
    }

    /// The list with `item` at `index`, everything from there on moved along.
    /// An `index` past the end appends and one below zero prepends, so there is
    /// no way to insert into a hole.
    export fn insertAt<C: Allocator>(self, ctx: C, index: Int, item: T): [T] {
        let at = clampIndex(index, self.length());
        self.take(ctx, at).push(ctx, item).concat(ctx, self.drop(ctx, at))
    }

    /// The list with the element at `index` exchanged for `item`. An index
    /// outside the list changes nothing, which is `removeAt`'s rule.
    export fn replaceAt<C: Allocator>(self, ctx: C, index: Int, item: T): [T] {
        if (index < 0 || index >= self.length()) {
            self
        } else {
            self.take(ctx, index).push(ctx, item).concat(ctx, self.drop(ctx, index + 1))
        }
    }

    /// `replaceAt` where the new element is built from the old one. An index
    /// outside the list changes nothing and never calls `update`.
    export fn updateAt<C: Allocator>(self, ctx: C, index: Int, update: fn(T) => T): [T] {
        match (self.get(index)) {
            .None => self,
            .Some(x) => self.replaceAt(ctx, index, update(x)),
        }
    }

    /// `push` at the other end. It copies the whole list, where `push` usually
    /// does not — an array is contiguous, so a new first element moves every
    /// other one.
    export fn pushFront<C: Allocator>(self, ctx: C, item: T): [T] {
        empty<T>().push(ctx, item).concat(ctx, self)
    }

    /// `get` with the absent case already answered.
    export fn getOr(self, index: Int, fallback: T): T {
        self.get(index).withDefault(fallback)
    }
}

fn foldedFrom<T, B>(xs: [T], f: fn(B, Int, T) => B, at: Int, acc: B): B {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => foldedFrom(xs, f, at + 1, f(acc, at, x)),
    }
}

fn keptFrom<T, C: Allocator>(
    ctx: C,
    xs: [T],
    keep: fn(Int, T) => Bool,
    at: Int,
    acc: [T],
): [T] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => {
            let next = if (keep(at, x)) { acc.push(ctx, x) } else { acc };
            keptFrom(ctx, xs, keep, at + 1, next)
        },
    }
}

fn pairedFrom<T, C: Allocator>(ctx: C, xs: [T], at: Int, acc: [(Int, T)]): [(Int, T)] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => pairedFrom(ctx, xs, at + 1, acc.push(ctx, (at, x))),
    }
}

/// How many elements at the front `keep` accepts, counting one at a time.
/// `partitionPoint` is the O(log n) form and needs the list to be partitioned.
fn runLength<T>(xs: [T], keep: fn(T) => Bool, at: Int): Int {
    match (xs.get(at)) {
        .None => at,
        .Some(x) => if (keep(x)) { runLength(xs, keep, at + 1) } else { at },
    }
}

fn chunksFrom<T, C: Allocator>(ctx: C, xs: [T], size: Int, at: Int, acc: [[T]]): [[T]] {
    if (at >= xs.length()) {
        acc
    } else {
        let piece = xs.slice(ctx, at, at + size);
        chunksFrom(ctx, xs, size, at + size, acc.push(ctx, piece))
    }
}

fn partitionFrom<T, C: Allocator>(
    ctx: C,
    xs: [T],
    keep: fn(T) => Bool,
    at: Int,
    yes: [T],
    no: [T],
): ([T], [T]) {
    match (xs.get(at)) {
        .None => (yes, no),
        .Some(x) => {
            if (keep(x)) {
                partitionFrom(ctx, xs, keep, at + 1, yes.push(ctx, x), no)
            } else {
                partitionFrom(ctx, xs, keep, at + 1, yes, no.push(ctx, x))
            }
        },
    }
}

fn clampIndex(index: Int, length: Int): Int {
    if (index < 0) { 0 } else { if (index > length) { length } else { index } }
}

// --- Searching a list that is already in order ---------------------------------

impl<T> [T] {
    /// The index of an element `probe` calls `.Equal`, or where one would go.
    ///
    /// `probe` compares an *element* against what you are looking for, so it
    /// answers `.Less` for an element that sorts before it. The list has to be
    /// sorted by that same order; on one that is not, the answer is a position
    /// rather than a promise. O(log n) probes.
    ///
    /// `.Err` carries the insertion point — the index the missing element would
    /// take — so a miss is still useful. Where several elements are `.Equal`,
    /// the index is one of them and not necessarily the first.
    ///
    /// ```buri run
    /// from "core/effect" import { Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Stdout: host.stdout,
    ///     };
    ///     let xs = [10, 20, 30];
    ///     let hit = xs.binarySearchBy(fn(x) => x.compare(20));
    ///     let miss = xs.binarySearchBy(fn(x) => x.compare(25));
    ///     let goes = miss.withDefaultWith(fn(i) => i);
    ///     let _ = io.println(ctx, "${hit.withDefault(-1)} ${goes}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 1 2
    /// ```
    export fn binarySearchBy(self, probe: fn(T) => Order): Result<Int, Int> {
        searchBy(self, probe, 0, self.length())
    }

    /// How many elements at the front the predicate accepts, found in O(log n)
    /// rather than by counting.
    ///
    /// The list has to be partitioned by the predicate — every element it
    /// accepts before every element it refuses — which is what makes halving
    /// sound. On a list that is not, `takeWhile` is the honest answer.
    export fn partitionPoint(self, predicate: fn(T) => Bool): Int {
        pointFrom(self, predicate, 0, self.length())
    }

    /// The last element the predicate accepts, searching from the end.
    export fn findLast(self, predicate: fn(T) => Bool): Option<T> {
        match (self.findLastIndex(predicate)) {
            .None => .None,
            .Some(i) => self.get(i),
        }
    }

    /// The index of the last element the predicate accepts.
    export fn findLastIndex(self, predicate: fn(T) => Bool): Option<Int> {
        lastFrom(self, predicate, self.length() - 1)
    }
}

fn searchBy<T>(xs: [T], probe: fn(T) => Order, lo: Int, hi: Int): Result<Int, Int> {
    if (lo >= hi) {
        .Err(lo)
    } else {
        let mid = lo + (hi - lo) / 2;
        match (xs.get(mid)) {
            .None => .Err(lo),
            .Some(x) => {
                match (probe(x)) {
                    .Equal => .Ok(mid),
                    .Less => searchBy(xs, probe, mid + 1, hi),
                    .Greater => searchBy(xs, probe, lo, mid),
                }
            },
        }
    }
}

fn pointFrom<T>(xs: [T], keep: fn(T) => Bool, lo: Int, hi: Int): Int {
    if (lo >= hi) {
        lo
    } else {
        let mid = lo + (hi - lo) / 2;
        match (xs.get(mid)) {
            .None => lo,
            .Some(x) => {
                if (keep(x)) {
                    pointFrom(xs, keep, mid + 1, hi)
                } else {
                    pointFrom(xs, keep, lo, mid)
                }
            },
        }
    }
}

fn lastFrom<T>(xs: [T], keep: fn(T) => Bool, at: Int): Option<Int> {
    if (at < 0) {
        .None
    } else {
        match (xs.get(at)) {
            .None => .None,
            .Some(x) => if (keep(x)) { .Some(at) } else { lastFrom(xs, keep, at - 1) },
        }
    }
}

impl<T: Ordered> [T] {
    /// `binarySearchBy` with the type's own order. The list has to be sorted by
    /// it, which is what `sort` leaves behind.
    export fn binarySearch(self, needle: T): Result<Int, Int> {
        searchOrd(self, needle, 0, self.length())
    }
}

fn searchOrd<T: Ordered>(xs: [T], needle: T, lo: Int, hi: Int): Result<Int, Int> {
    if (lo >= hi) {
        .Err(lo)
    } else {
        let mid = lo + (hi - lo) / 2;
        match (xs.get(mid)) {
            .None => .Err(lo),
            .Some(x) => {
                match (x.compare(needle)) {
                    .Equal => .Ok(mid),
                    .Less => searchOrd(xs, needle, mid + 1, hi),
                    .Greater => searchOrd(xs, needle, lo, mid),
                }
            },
        }
    }
}

impl<T: Equal> [T] {
    /// The index of the first element equal to `needle`. O(n), where
    /// `binarySearch` is O(log n) on a list that is already in order.
    export fn indexOf(self, needle: T): Option<Int> {
        self.findIndex(fn(x) => x == needle)
    }

    /// The index of the last element equal to `needle`.
    export fn lastIndexOf(self, needle: T): Option<Int> {
        self.findLastIndex(fn(x) => x == needle)
    }

    /// Whether the list begins with `prefix`, element for element. Every list
    /// starts with the empty one.
    export fn startsWith(self, prefix: [T]): Bool {
        matchesAt(self, prefix, 0, 0)
    }

    /// Whether the list ends with `suffix`. Every list ends with the empty one.
    export fn endsWith(self, suffix: [T]): Bool {
        matchesAt(self, suffix, self.length() - suffix.length(), 0)
    }
}

/// Whether `part` occurs in `xs` starting at `at`. A negative `at` means a
/// `part` longer than `xs`, which never matches.
fn matchesAt<T: Equal>(xs: [T], part: [T], at: Int, seen: Int): Bool {
    if (at < 0) {
        false
    } else {
        match (part.get(seen)) {
            .None => true,
            .Some(want) => {
                match (xs.get(at + seen)) {
                    .None => false,
                    .Some(got) => {
                        if (got == want) {
                            matchesAt(xs, part, at, seen + 1)
                        } else {
                            false
                        }
                    },
                }
            },
        }
    }
}

// --- Reshaping ------------------------------------------------------------------

impl<T> [T] {
    /// A `fold` that keeps its working. One element out per element in — the
    /// running value *after* each step, so the seed is not in the answer and
    /// `[1, 2, 3].scan(ctx, add, 0)` is `[1, 3, 6]`.
    export fn scan<B, C: Allocator>(self, ctx: C, step: fn(B, T) => B, init: B): [B] {
        scanFrom(ctx, self, step, 0, init, empty<B>())
    }

    /// `fold` with the first element as the seed, so nothing outside the list
    /// has to be invented. `.None` for an empty list, because there is no seed
    /// to answer with.
    export fn reduce(self, combine: fn(T, T) => T): Option<T> {
        match (self.get(0)) {
            .None => .None,
            .Some(first) => .Some(reduceFrom(self, combine, 1, first)),
        }
    }

    /// The list cut in two at `index`: everything before it, then the rest.
    /// `take` and `drop` in one call, clamped the way they are.
    export fn splitAt<C: Allocator>(self, ctx: C, index: Int): ([T], [T]) {
        (self.take(ctx, index), self.drop(ctx, index))
    }

    /// The first element and everything after it, or `.None` when there is no
    /// first element.
    ///
    /// It names `Allocator` where `first` does not: a Buri list is a value rather
    /// than a view, so the tail is a copy (SPEC 10.5).
    export fn splitFirst<C: Allocator>(self, ctx: C): Option<(T, [T])> {
        match (self.get(0)) {
            .None => .None,
            .Some(head) => .Some((head, self.drop(ctx, 1))),
        }
    }

    /// `separator` between every neighbouring pair, and nowhere else. A list of
    /// one and the empty list come back unchanged.
    export fn intersperse<C: Allocator>(self, ctx: C, separator: T): [T] {
        interFrom(ctx, self, separator, 0, empty<T>())
    }

    /// Neighbouring elements `same` calls equal, grouped. The groups are runs,
    /// so two equal elements with something else between them land in two
    /// groups.
    export fn chunkBy<C: Allocator>(self, ctx: C, same: fn(T, T) => Bool): [[T]] {
        runsFrom(ctx, self, same, 0, empty<T>(), empty<[T]>())
    }

    /// One element per run of neighbours `same` calls equal — the first of each
    /// run. O(n) comparisons, where `uniqueBy` is O(n²) because it looks at
    /// every element it has already kept.
    export fn deduplicateBy<C: Allocator>(self, ctx: C, same: fn(T, T) => Bool): [T] {
        dedupeFrom(ctx, self, same, 0, empty<T>())
    }

    /// The sum of a number read off each element, without the list a `map` and
    /// a `sum` would build in between.
    export fn sumOf(self, value: fn(T) => Int): Int {
        self.fold(fn(acc, x) => acc + value(x), 0)
    }
}

fn scanFrom<T, B, C: Allocator>(
    ctx: C,
    xs: [T],
    step: fn(B, T) => B,
    at: Int,
    acc: B,
    out: [B],
): [B] {
    match (xs.get(at)) {
        .None => out,
        .Some(x) => {
            let next = step(acc, x);
            scanFrom(ctx, xs, step, at + 1, next, out.push(ctx, next))
        },
    }
}

fn reduceFrom<T>(xs: [T], combine: fn(T, T) => T, at: Int, acc: T): T {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => reduceFrom(xs, combine, at + 1, combine(acc, x)),
    }
}

fn interFrom<T, C: Allocator>(ctx: C, xs: [T], separator: T, at: Int, acc: [T]): [T] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => {
            let started = if (at == 0) { acc } else { acc.push(ctx, separator) };
            interFrom(ctx, xs, separator, at + 1, started.push(ctx, x))
        },
    }
}

fn runsFrom<T, C: Allocator>(
    ctx: C,
    xs: [T],
    same: fn(T, T) => Bool,
    at: Int,
    run: [T],
    acc: [[T]],
): [[T]] {
    match (xs.get(at)) {
        .None => if (run.isEmpty()) { acc } else { acc.push(ctx, run) },
        .Some(x) => {
            match (run.last()) {
                .None => runsFrom(ctx, xs, same, at + 1, run.push(ctx, x), acc),
                .Some(previous) => {
                    if (same(previous, x)) {
                        runsFrom(ctx, xs, same, at + 1, run.push(ctx, x), acc)
                    } else {
                        let started = empty<T>().push(ctx, x);
                        runsFrom(ctx, xs, same, at + 1, started, acc.push(ctx, run))
                    }
                },
            }
        },
    }
}

fn dedupeFrom<T, C: Allocator>(
    ctx: C,
    xs: [T],
    same: fn(T, T) => Bool,
    at: Int,
    acc: [T],
): [T] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => {
            let next = match (acc.last()) {
                .None => acc.push(ctx, x),
                .Some(previous) => {
                    if (same(previous, x)) { acc } else { acc.push(ctx, x) }
                },
            };
            dedupeFrom(ctx, xs, same, at + 1, next)
        },
    }
}

impl<A, B> [(A, B)] {
    /// The left halves and the right halves, in two lists — `zip` run
    /// backwards.
    export fn unzip<C: Allocator>(self, ctx: C): ([A], [B]) {
        unzipFrom(ctx, self, 0, empty<A>(), empty<B>())
    }
}

fn unzipFrom<A, B, C: Allocator>(
    ctx: C,
    pairs: [(A, B)],
    at: Int,
    lefts: [A],
    rights: [B],
): ([A], [B]) {
    match (pairs.get(at)) {
        .None => (lefts, rights),
        .Some(pair) => {
            unzipFrom(
                ctx,
                pairs,
                at + 1,
                lefts.push(ctx, pair.0),
                rights.push(ctx, pair.1),
            )
        },
    }
}

impl<A> [A] {
    /// `zip` and a `map` in one pass, so no list of pairs is built. It stops at
    /// the shorter of the two, the way `zip` does.
    export fn zipWith<B, R, C: Allocator>(
        self,
        ctx: C,
        other: [B],
        combine: fn(A, B) => R,
    ): [R] {
        zippedFrom(ctx, self, other, combine, 0, empty<R>())
    }
}

fn zippedFrom<A, B, R, C: Allocator>(
    ctx: C,
    xs: [A],
    ys: [B],
    combine: fn(A, B) => R,
    at: Int,
    acc: [R],
): [R] {
    match ((xs.get(at), ys.get(at))) {
        (.Some(x), .Some(y)) => {
            zippedFrom(ctx, xs, ys, combine, at + 1, acc.push(ctx, combine(x, y)))
        },
        _ => acc,
    }
}

/// A list built from a seed rather than from another list: `step` answers the
/// next element and the next seed, and `.None` ends it.
///
/// Nothing bounds the length but `step`, so a `step` that never answers `.None`
/// never returns.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/list" import * as list;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let halves = list.unfold(ctx, 8, fn(n) => {
///         if (n == 0) { .None } else { .Some((n, n / 2)) }
///     });
///     let _ = io.println(ctx, "${halves.length()}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// 4
/// ```
export fn unfold<T, S, C: Allocator>(ctx: C, seed: S, step: fn(S) => Option<(T, S)>): [T] {
    unfoldFrom(ctx, seed, step, empty<T>())
}

fn unfoldFrom<T, S, C: Allocator>(
    ctx: C,
    seed: S,
    step: fn(S) => Option<(T, S)>,
    acc: [T],
): [T] {
    match (step(seed)) {
        .None => acc,
        .Some(pair) => unfoldFrom(ctx, pair.1, step, acc.push(ctx, pair.0)),
    }
}

/// `range` with a stride: `[start, start + step, ...]`, stopping before `end`.
///
/// A negative `step` counts down and stops *above* `end`, so the bound is
/// always the one the count is moving towards. A `step` of zero has no answer
/// that terminates, so it is the empty list.
export fn rangeBy<C: Allocator>(ctx: C, start: Int, end: Int, step: Int): [Int] {
    if (step == 0) {
        empty<Int>()
    } else {
        strideFrom(ctx, start, end, step, empty<Int>())
    }
}

fn strideFrom<C: Allocator>(ctx: C, at: Int, end: Int, step: Int, acc: [Int]): [Int] {
    let done = if (step > 0) { at >= end } else { at <= end };
    if (done) { acc } else { strideFrom(ctx, at + step, end, step, acc.push(ctx, at)) }
}

// --- Numbers, again -------------------------------------------------------------

impl [Int] {
    /// Every element multiplied together. The empty list is `1`, which is what
    /// keeps the product of two halves equal to the product of the whole.
    export fn product(self): Int {
        self.fold(fn(acc, x) => acc * x, 1)
    }

    /// The arithmetic mean, or `.None` for an empty list. The sum is exact and
    /// only the division is a `Float`.
    export fn mean(self): Option<Float> {
        if (self.isEmpty()) {
            .None
        } else {
            .Some(self.sum().toF64() / self.length().toF64())
        }
    }
}

impl [Float] {
    /// The arithmetic mean, or `.None` for an empty list. It sums and then
    /// divides, so a list whose sum overflows to infinity has an infinite mean.
    ///
    /// `mean` is the `[Int]` one. A method name resolves once across the
    /// module, which is why this is spelled out — the same reason `sumFloat`
    /// is not `sum`.
    export fn meanFloat(self): Option<Float> {
        if (self.isEmpty()) {
            .None
        } else {
            .Some(self.sumFloat() / self.length().toF64())
        }
    }

    /// The middle value once sorted, or the mean of the two middle values when
    /// the length is even. `.None` for an empty list.
    ///
    /// It sorts, so it names `Allocator` where `meanFloat` does not. A `NaN` in the
    /// list leaves the order undefined and the answer with it.
    export fn median<C: Allocator>(self, ctx: C): Option<Float> {
        let sorted = self.sort(ctx);
        let n = sorted.length();
        if (n == 0) {
            .None
        } else {
            if (n % 2 == 1) {
                sorted.get(n / 2)
            } else {
                match ((sorted.get(n / 2 - 1), sorted.get(n / 2))) {
                    (.Some(a), .Some(b)) => .Some((a + b) / 2.0),
                    _ => .None,
                }
            }
        }
    }
}
