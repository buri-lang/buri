//! core/list — the defining module of `[T]`.
//!
//! One split runs through this file, the one SPEC 10.5 draws: an operation
//! whose result size is fixed is pure, and an operation whose result size
//! depends on runtime data names `Alloc`. `len` and `fold` are pure. `map` and
//! `filter` are not, and their signatures say so.
//!
//! Everything here takes its collection as `self`, so you can call it as a
//! method with no import: receiver first, context second, everything else
//! after (SPEC 10.7).

from "core/effect" import { Alloc };
from "core/order" import { Ord, Order };

// --- Pure: no context parameter at all --------------------------------------

impl<T> [T] {
    export fn len(self): Int;

    export fn isEmpty(self): Bool {
        self.len() == 0
    }

    /// Indexing yields `Option<T>`. There is no way to index out of bounds and
    /// no way to panic by indexing.
    export fn get(self, index: Int): Option<T>;

    export fn first(self): Option<T> {
        self.get(0)
    }

    export fn last(self): Option<T> {
        self.get(self.len() - 1)
    }

    /// A fold produces one value rather than a new collection, so it allocates
    /// nothing and needs no context.
    export fn fold<B>(self, f: fn(B, T) => B, init: B): B;

    /// The `*Ctx` variant, for a step that needs an effect. A lambda may not
    /// capture one (SPEC 10.6), so you thread the context through instead.
    export fn foldCtx<B, C>(self, ctx: C, f: fn(C, B, T) => B, init: B): B;

    /// Stops at the first `.Err` — how you write a fallible fold without an
    /// early exit.
    export fn foldResult<B, E>(
        self,
        f: fn(B, T) => Result<B, E>,
        init: B,
    ): Result<B, E>;

    /// The same, but `f` takes the context instead of capturing it — a fallible
    /// fold that allocates as it goes.
    export fn foldResultCtx<B, E, C: Alloc>(
        self,
        ctx: C,
        f: fn(C, B, T) => Result<B, E>,
        init: B,
    ): Result<B, E>;

    export fn any(self, pred: fn(T) => Bool): Bool;

    export fn all(self, pred: fn(T) => Bool): Bool;

    export fn find(self, pred: fn(T) => Bool): Option<T>;

    export fn findIndex(self, pred: fn(T) => Bool): Option<Int>;
}

impl<T: Eq> [T] {
    export fn contains(self, needle: T): Bool {
        self.any(fn(x) => x == needle)
    }
}

impl<T> [T] {
    export fn count(self, pred: fn(T) => Bool): Int;

    /// Whether every neighbouring pair is in order — `cmp(xs[i], xs[i + 1])` is
    /// never `.Greater`. The empty list and a single element are sorted. This is
    /// the predicate `sort` and `sortBy` answer.
    export fn isSortedBy(self, cmp: fn(T, T) => Order): Bool {
        sortedFrom(self, cmp, 0)
    }

    /// The greatest element by `cmp`, or `.None` for an empty list. Ties go to
    /// the earlier element, which is `maximum`'s answer too.
    ///
    /// `maximum` is this with the type's own `Ord`. This form takes the order as
    /// a value, so "the row with the largest score" needs no `Ord` on the row.
    export fn maxBy(self, cmp: fn(T, T) => Order): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => {
                        match (cmp(x, b)) {
                            .Greater => .Some(x),
                            _ => .Some(b),
                        }
                    },
                }
            },
            .None,
        )
    }

    /// The least element by `cmp`, or `.None` for an empty list. Ties go to
    /// the earlier element.
    export fn minBy(self, cmp: fn(T, T) => Order): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => {
                        match (cmp(x, b)) {
                            .Less => .Some(x),
                            _ => .Some(b),
                        }
                    },
                }
            },
            .None,
        )
    }

    /// Lexicographic comparison, element by element with `cmp`, the shorter
    /// list first when one is a prefix of the other.
    ///
    /// `[T]` satisfies `Ord` structurally whenever `T` does (SPEC 5.11), so `<`
    /// on two lists already answers this order. This adds the comparator form: a
    /// list compared by an order that is not the element type's own.
    export fn compareBy(self, other: [T], cmp: fn(T, T) => Order): Order {
        compareFrom(self, other, cmp, 0)
    }
}

/// This walks by index rather than folding, because a fold's lambda would have
/// to capture the other list, and a lambda may not capture a value whose type
/// could be a context (SPEC 10.6).
fn compareFrom<T>(a: [T], b: [T], cmp: fn(T, T) => Order, at: Int): Order {
    match ((a.get(at), b.get(at))) {
        (.None, .None) => .Equal,
        (.None, .Some(_)) => .Less,
        (.Some(_), .None) => .Greater,
        (.Some(x), .Some(y)) => {
            match (cmp(x, y)) {
                .Equal => compareFrom(a, b, cmp, at + 1),
                decided => decided,
            }
        },
    }
}

fn sortedFrom<T>(xs: [T], cmp: fn(T, T) => Order, at: Int): Bool {
    match ((xs.get(at), xs.get(at + 1))) {
        (.Some(a), .Some(b)) => {
            match (cmp(a, b)) {
                .Greater => false,
                _ => sortedFrom(xs, cmp, at + 1),
            }
        },
        // One element left, or none: there is no pair to be out of order.
        _ => true,
    }
}

impl<T: Ord> [T] {
    /// The type's own order, lexicographically over the list — `compareBy`
    /// with `T`'s `compare`.
    ///
    /// The compiler owns `[T]`'s structural `Ord` conformance (SPEC 5.11), since
    /// an `impl` registers against a type *constructor* and `[T]` is not one.
    /// This is that same order, callable by name.
    export fn compare(self, other: [T]): Order {
        self.compareBy(other, fn(a, b) => a.compare(b))
    }
}

// --- Deterministic: bounded by <C: Alloc> ------------------------------------

impl<A> [A] {
    export fn map<B, C: Alloc>(self, ctx: C, f: fn(A) => B): [B];

    export fn mapCtx<B, C: Alloc>(self, ctx: C, f: fn(C, A) => B): [B];

    /// `mapCtx`, with the runtime running the step rather than a loop the
    /// backend writes. The answer is `mapCtx`'s answer, element for element.
    ///
    /// Prefer `mapCtx`. This is slower by an indirect call per element, and no
    /// case makes it the better tool. It exists to exercise the runtime calling
    /// back into Buri code.
    export fn mapCtxStep<B, C: Alloc>(self, ctx: C, f: fn(C, A) => B): [B];

    /// `map` with a step that can fail: every element mapped, or the first
    /// `.Err` and nothing after it.
    ///
    /// It stops at the first failure and never calls `f` again, so a validation
    /// reports the first bad element rather than the last.
    ///
    /// ```buri run
    /// from "core/effect" import { Alloc, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// fn small(n: Int): Result<Int, Int> {
    ///     if (n < 10) { .Ok(n * 2) } else { .Err(n) }
    /// }
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Alloc: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let doubled = [1, 2, 3].mapResult(ctx, small);
    ///     let refused = [1, 20, 3].mapResult(ctx, small);
    ///     let shown = match ((doubled, refused)) {
    ///         (.Ok(xs), .Err(n)) => "${xs.len()} doubled, and then ${n}",
    ///         _ => "unreachable",
    ///     };
    ///     let _ = io.println(ctx, shown).ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 3 doubled, and then 20
    /// ```
    export fn mapResult<B, E, C: Alloc>(
        self,
        ctx: C,
        f: fn(A) => Result<B, E>,
    ): Result<[B], E> {
        self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(x)) {
                    .Ok(b) => .Ok(acc.push(c, b)),
                    .Err(e) => .Err(e),
                }
            },
            empty<B>(),
        )
    }

    /// `mapResult`, but the step takes the context instead of capturing it. The
    /// form a validation takes, since checking an element usually allocates and
    /// a lambda may not capture a context (SPEC 10.6).
    export fn mapResultCtx<B, E, C: Alloc>(
        self,
        ctx: C,
        f: fn(C, A) => Result<B, E>,
    ): Result<[B], E> {
        self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(c, x)) {
                    .Ok(b) => .Ok(acc.push(c, b)),
                    .Err(e) => .Err(e),
                }
            },
            empty<B>(),
        )
    }

    /// `mapResult` for a step that answers `Option`: every element mapped, or
    /// `.None` the moment one is missing.
    export fn mapOption<B, C: Alloc>(self, ctx: C, f: fn(A) => Option<B>): Option<[B]> {
        // `Result` is the shape with an early exit in it, so the walk is one
        // and the two names differ only in what they answer.
        let mapped = self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(x)) {
                    .Some(b) => .Ok(acc.push(c, b)),
                    .None => .Err(()),
                }
            },
            empty<B>(),
        );
        match (mapped) {
            .Ok(bs) => .Some(bs),
            .Err(_) => .None,
        }
    }

    /// `mapOption`, but the step takes the context instead of capturing it.
    export fn mapOptionCtx<B, C: Alloc>(
        self,
        ctx: C,
        f: fn(C, A) => Option<B>,
    ): Option<[B]> {
        let mapped = self.foldResultCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(c, x)) {
                    .Some(b) => .Ok(acc.push(c, b)),
                    .None => .Err(()),
                }
            },
            empty<B>(),
        );
        match (mapped) {
            .Ok(bs) => .Some(bs),
            .Err(_) => .None,
        }
    }

    /// Maps and filters in one pass: it drops an element `f` answers `.None`
    /// for, and the `.Some` payloads are the result.
    export fn filterMap<B, C: Alloc>(self, ctx: C, f: fn(A) => Option<B>): [B] {
        self.foldCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(x)) {
                    .Some(b) => acc.push(c, b),
                    .None => acc,
                }
            },
            empty<B>(),
        )
    }

    /// `filterMap`, but the step takes the context instead of capturing it.
    export fn filterMapCtx<B, C: Alloc>(self, ctx: C, f: fn(C, A) => Option<B>): [B] {
        self.foldCtx(
            ctx,
            fn(c, acc: [B], x) => {
                match (f(c, x)) {
                    .Some(b) => acc.push(c, b),
                    .None => acc,
                }
            },
            empty<B>(),
        )
    }
}

impl<T> [T] {
    export fn filter<C: Alloc>(self, ctx: C, keep: fn(T) => Bool): [T];

    export fn filterCtx<C: Alloc>(self, ctx: C, keep: fn(C, T) => Bool): [T];

    export fn concat<C: Alloc>(self, ctx: C, other: [T]): [T];

    export fn push<C: Alloc>(self, ctx: C, item: T): [T];

    export fn reverse<C: Alloc>(self, ctx: C): [T];

    /// Ordering is a value you pass, so the tie-break is explicit and reviewable.
    /// The sort is stable.
    export fn sortBy<C: Alloc>(self, ctx: C, order: fn(T, T) => Order): [T];
}

impl<T: Ord> [T] {
    /// `sortBy` with the type's own `Ord`, and stable like it.
    ///
    /// For `[Str]` that is `core/str`'s `compare`: lexicographic by Unicode
    /// scalar value, which for a valid string is UTF-8 byte order, on both
    /// backends. It is not JavaScript's UTF-16 order, so an emoji sorts after
    /// a character in U+E000..U+FFFF rather than before it.
    export fn sort<C: Alloc>(self, ctx: C): [T] {
        self.sortBy(ctx, fn(a, b) => a.compare(b))
    }
}

impl<T> [T] {
    export fn take<C: Alloc>(self, ctx: C, n: Int): [T];

    export fn drop<C: Alloc>(self, ctx: C, n: Int): [T];

    export fn slice<C: Alloc>(self, ctx: C, start: Int, end: Int): [T];

    /// Everything but the element at `index`. An index outside the list removes
    /// nothing.
    export fn removeAt<C: Alloc>(self, ctx: C, index: Int): [T] {
        self.take(ctx, index).concat(ctx, self.drop(ctx, index + 1))
    }

    /// Every run of `size` neighbouring elements, one position apart:
    /// `[1, 2, 3].windows(ctx, 2)` is `[[1, 2], [2, 3]]`.
    ///
    /// A list shorter than `size` has no windows, and a `size` of zero or less
    /// has none either.
    export fn windows<C: Alloc>(self, ctx: C, size: Int): [[T]] {
        if (size <= 0) {
            empty<[T]>()
        } else {
            windowsFrom(ctx, self, size, 0, empty<[T]>())
        }
    }

    /// The first element of each class `cmp` calls `.Equal`, in the order they
    /// arrived — it keeps the list's order, not the comparator's, and two equal
    /// elements need not be neighbours.
    ///
    /// O(n²) comparisons, because keeping the first occurrence means asking
    /// about every element already kept. For a large list, `sortBy` and a walk
    /// over neighbours is the O(n log n) answer, and `core/ordset` is the one
    /// that also answers membership.
    export fn uniqueBy<C: Alloc>(self, ctx: C, cmp: fn(T, T) => Order): [T] {
        uniqueFrom(ctx, self, cmp, 0, empty<T>())
    }
}

/// Tail-recursive rather than a `map` over indices, because the lambda would
/// have to capture the list (SPEC 10.6).
fn windowsFrom<T, C: Alloc>(ctx: C, xs: [T], size: Int, at: Int, acc: [[T]]): [[T]] {
    if (at + size > xs.len()) {
        acc
    } else {
        windowsFrom(ctx, xs, size, at + 1, acc.push(ctx, xs.slice(ctx, at, at + size)))
    }
}

fn uniqueFrom<T, C: Alloc>(
    ctx: C,
    xs: [T],
    cmp: fn(T, T) => Order,
    at: Int,
    acc: [T],
): [T] {
    match (xs.get(at)) {
        .None => acc,
        .Some(x) => {
            let next = if (equalAt(acc, x, cmp, 0)) { acc } else { acc.push(ctx, x) };
            uniqueFrom(ctx, xs, cmp, at + 1, next)
        },
    }
}

/// Whether `x` is `.Equal` to something in `seen`. `any` would want a lambda
/// capturing `x`, which SPEC 10.6 refuses.
fn equalAt<T>(seen: [T], x: T, cmp: fn(T, T) => Order, at: Int): Bool {
    match (seen.get(at)) {
        .None => false,
        .Some(y) => {
            match (cmp(x, y)) {
                .Equal => true,
                _ => equalAt(seen, x, cmp, at + 1),
            }
        },
    }
}

impl<A> [A] {
    export fn zip<B, C: Alloc>(self, ctx: C, other: [B]): [(A, B)];
}

impl<T> [[T]] {
    export fn flatten<C: Alloc>(self, ctx: C): [T];
}

impl [Str] {
    /// Declared here rather than in `core/str` because its receiver is `[Str]`,
    /// and a method lives in its receiver type's defining module.
    export fn join<C: Alloc>(self, ctx: C, separator: Str): Str;
}

export fn empty<T>(): [T];

/// `[from, from+1, ..., to-1]`. Counting without a loop and without a `Range`
/// type — design/non-goals.md records why neither exists.
export fn range<C: Alloc>(ctx: C, start: Int, end: Int): [Int];

export fn repeat<T, C: Alloc>(ctx: C, item: T, times: Int): [T];

/// `[f(0), f(1), ..., f(n - 1)]`. `repeat` for an element that depends on its
/// own position. An `n` of zero or less is the empty list.
export fn generate<T, C: Alloc>(ctx: C, n: Int, f: fn(Int) => T): [T] {
    range(ctx, 0, n).map(ctx, fn(i) => f(i))
}

// --- Numeric folds ------------------------------------------------------------

impl [Int] {
    export fn sum(self): Int {
        self.fold(fn(acc, x) => acc + x, 0)
    }
}

impl [Float] {
    export fn sumFloat(self): Float {
        self.fold(fn(acc, x) => acc + x, 0.0)
    }
}

impl<T: Ord> [T] {
    export fn maximum(self): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => if (x > b) { .Some(x) } else { .Some(b) },
                }
            },
            .None,
        )
    }

    export fn minimum(self): Option<T> {
        self.fold(
            fn(best, x) => {
                match (best) {
                    .None => .Some(x),
                    .Some(b) => if (x < b) { .Some(x) } else { .Some(b) },
                }
            },
            .None,
        )
    }
}
