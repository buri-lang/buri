//! ui/signal — writable cells, and the computations that watch them.
//!
//! A `Signal<T>` is an index into the runtime's graph and nothing else. It
//! holds no authority, so a lambda may capture one — that is what makes event
//! handlers expressible. Every operation takes the context granting the
//! authority it needs: `Watch` to read, `Ui` to write.
//!
//! Tracking is automatic. `get` inside a computation records an edge from the
//! cell to it, and a write marks everything that read the cell out of date. The
//! runtime collects dependencies afresh on every run, so a read behind an `if`
//! is tracked exactly: the branch not taken creates no edge.

from "ui/effect" import { Scope, Ui, Watch };

/// An index into the runtime graph.
///
/// The value lives in the graph, not here. Holding one carries no authority,
/// and capturing one needs no bound on `T`.
export struct Signal<T>(Int);

impl<T> Signal<T> {
    /// The current value.
    ///
    /// Called inside a memo or a watcher, this is what subscribes that
    /// computation to this cell.
    export fn get<C: Watch>(self, ctx: C): T {
        ctx.read(self.0)
    }

    /// Replaces the value. Everything that read this cell is marked out of date
    /// and re-run; writing a value equal to the current one does nothing.
    ///
    /// Equal is `==`, which is structural: two strings with the same text are
    /// one value however each was built, and so are two lists of the same
    /// elements. A type with no `Equal` of its own is compared the same way,
    /// field by field.
    export fn set<C: Ui>(self, ctx: C, value: T): () {
        ctx.write(self.0, value)
    }

    /// Replaces the value with a function of the old one.
    ///
    /// The read it does on the way records no dependency. A computation only
    /// ever gets a `Scope`, which cannot write, so `update` is callable only
    /// from outside a computation.
    export fn update<C: Ui>(self, ctx: C, f: fn(T) => T): () {
        ctx.write(self.0, f(ctx.read(self.0)))
    }
}

/// A fresh cell holding `initial`.
export fn signal<C: Ui, T>(ctx: C, initial: T): Signal<T> {
    Signal(ctx.signal(initial))
}

/// Registers a computation run for its effect on the world rather than its
/// value: once now, and again whenever anything it read changes.
///
/// Named `watch` rather than `effect` because `effect` is a keyword. The closure
/// receives a `Scope`, so it reads the graph and allocates — it can build what
/// it read into a string or a list — and it cannot write.
export fn watch<C: Ui>(ctx: C, run: fn(Scope) => ()): () {
    ctx.watch(run)
}
