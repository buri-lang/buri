//! core/str — the defining module of `Str`.
//!
//! `Str` is an immutable UTF-8 string. `trim`, `slice`, and `splitOnce` are
//! pure because it is immutable and sliceable: they return views, not copies.
//! Anything whose result length depends on runtime data names `Allocator`.
//!
//! There is no overloading, so a pure variant and an allocating variant of the
//! same idea get different names: `splitOnce` returns two slices and is pure;
//! `split` returns `[Str]` and allocates.

from "core/character" import * as character;
from "core/effect" import { Allocator };
from "core/list" import * as list;
from "core/order" import { Order };

// --- Pure ---------------------------------------------------------------------

impl Str {
    /// The number of Unicode scalar values, not the number of UTF-8 bytes.
    export fn len(self): Int;

    export fn isEmpty(self): Bool {
        self.len() == 0
    }

    export fn charAt(self, index: Int): Option<Char>;

    /// A view into `self`, not a copy — which is why it is pure and takes no
    /// `Allocator`. The view keeps the whole parent string alive for as long as it
    /// lives, so holding three bytes of a ten-megabyte line holds ten megabytes.
    /// Copy with `format` when the parent is large and the view is small.
    export fn slice(self, start: Int, end: Int): Str;

    export fn trim(self): Str;

    export fn trimStart(self): Str;

    export fn trimEnd(self): Str;

    export fn startsWith(self, prefix: Str): Bool;

    export fn endsWith(self, suffix: Str): Bool;

    export fn contains(self, needle: Str): Bool;

    export fn indexOf(self, needle: Str): Option<Int>;

    /// Two slices, or `.None` when the separator does not occur. Pure, because
    /// neither half is a copy.
    export fn splitOnce(self, separator: Str): Option<(Str, Str)>;

    /// Lexicographic, **by Unicode scalar value** — the same unit `len` counts
    /// and `charAt` hands back. For a valid string that is byte-for-byte UTF-8
    /// order, so the first byte the two differ at decides, and a string that is
    /// a prefix of another sorts before it.
    ///
    /// `<`, `<=`, `>`, `>=`, `[Str].sort`, `core/order.str` and an
    /// `OrderedMap<Str, _>`'s key order all answer this order, because every one of
    /// them reaches this method through `Ord`.
    ///
    /// This is *not* UTF-16 code-unit order, which is what JavaScript's `<` on a
    /// string gives. An astral scalar is written there as a surrogate pair
    /// beginning at U+D800, so JavaScript puts every astral character below every
    /// character in U+E000..U+FFFF. Buri says the opposite, on both backends, and
    /// agrees with Rust's `str::cmp`, Go's `<` and Python's `<`:
    ///
    /// ```buri run
    /// from "core/effect" import { Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Stdout: host.stdout,
    ///     };
    ///     // U+FFFD is 65533 and U+1F600 is 128512, so the emoji sorts above
    ///     // the replacement character. JavaScript's `<` on a string answers
    ///     // the other way. Every scalar in U+E000..U+FFFF behaves like the
    ///     // first one here.
    ///     let below = "�" < "😀";
    ///     let _ = io.println(ctx, "${below}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// true
    /// ```
    ///
    /// There is no locale-aware or case-insensitive comparison here: collation is
    /// a table and a set of options, not a total order a `<` can carry. Fold with
    /// `toLower` first for a case-insensitive ordering.
    export fn compare(self, other: Str): Order;

    export fn toInt(self): Option<Int>;

    /// The integer this text spells in `radix`, base 2 to base 36.
    ///
    /// Strict, and the same strictness `toInt` has: an optional leading `-`,
    /// then one digit or more, and nothing else — no spaces, no `0x`, no digit
    /// separators. Either case of letter counts, so `"FF".toRadix(16)` and
    /// `"ff".toRadix(16)` are both 255.
    ///
    /// `.None` covers all three ways this has no answer: a radix outside the
    /// range, a character that is not a digit of it, and a value outside `Int`.
    /// So `.Some(v)` promises `v` is the number that was written down.
    export fn toRadix(self, radix: Int): Option<Int> {
        if (radix < 2 || radix > 36) {
            .None
        } else {
            let negative = self.startsWith("-");
            let first = if (negative) { 1 } else { 0 };
            if (self.len() <= first) {
                .None
            } else {
                // Accumulates downwards, so the magnitude never has to fit:
                // `Int` reaches one further below zero, and the negation at the
                // end answers `.None` rather than wrapping.
                let magnitude = digitsOf(self, radix, first, 0);
                let zero: Int = 0;
                if (negative) {
                    magnitude
                } else {
                    magnitude.andThen(fn(m) => zero.checkedSub(m))
                }
            }
        }
    }

    export fn toFloat(self): Option<Float>;
}

/// The digits of `text` from `at`, folded negative.
fn digitsOf(text: Str, radix: Int, at: Int, acc: Int): Option<Int> {
    match (text.charAt(at)) {
        .None => .Some(acc),
        .Some(c) => {
            match (c.toDigit(radix)) {
                .None => .None,
                .Some(d) => {
                    let next = acc
                        .checkedMul(radix)
                        .andThen(fn(scaled) => scaled.checkedSub(d));
                    match (next) {
                        .None => .None,
                        .Some(v) => digitsOf(text, radix, at + 1, v),
                    }
                },
            }
        },
    }
}

// --- Deterministic: bounded by <C: Allocator> --------------------------------------

impl Str {
    export fn concat<C: Allocator>(self, ctx: C, other: Str): Str;

    export fn split<C: Allocator>(self, ctx: C, separator: Str): [Str];

    /// Splits on any of the characters in `separators`, dropping empty pieces.
    export fn splitAny<C: Allocator>(self, ctx: C, separators: Str): [Str];

    export fn lines<C: Allocator>(self, ctx: C): [Str];

    export fn replace<C: Allocator>(self, ctx: C, needle: Str, replacement: Str): Str;

    export fn repeat<C: Allocator>(self, ctx: C, times: Int): Str;

    export fn toUpper<C: Allocator>(self, ctx: C): Str;

    export fn toLower<C: Allocator>(self, ctx: C): Str;

    export fn chars<C: Allocator>(self, ctx: C): [Char];
}

export fn fromChars<C: Allocator>(ctx: C, cs: [Char]): Str;

export fn fromInt<C: Allocator>(ctx: C, n: Int): Str;

export fn fromFloat<C: Allocator>(ctx: C, x: Float): Str;

impl Str {
    export fn padStart<C: Allocator>(self, ctx: C, width: Int, fill: Char): Str;

    export fn padEnd<C: Allocator>(self, ctx: C, width: Int, fill: Char): Str;
}

/// Turning a `Template` into a `Str` is the point at which interpolation
/// allocates. Constructing the `Template` itself allocates nothing, which is
/// why `io.println(ctx, "hi ${name}")` needs only `Stdout`.
export fn format<C: Allocator>(ctx: C, template: Template): Str;

// --- Prefixes, suffixes, and searching from the right --------------------------

impl Str {
    /// The rest of the string once `prefix` is off the front, or `.None` when
    /// it was never there. `s.stripPrefix(p).withDefault(s)` is the
    /// trim-if-present form.
    ///
    /// Pure, because both answers are views into `self`.
    export fn stripPrefix(self, prefix: Str): Option<Str> {
        if (self.startsWith(prefix)) {
            .Some(self.slice(prefix.len(), self.len()))
        } else {
            .None
        }
    }

    /// `stripPrefix` at the other end.
    export fn stripSuffix(self, suffix: Str): Option<Str> {
        if (self.endsWith(suffix)) {
            .Some(self.slice(0, self.len() - suffix.len()))
        } else {
            .None
        }
    }

    /// The index of the *last* occurrence of `needle`, in scalars.
    ///
    /// The empty needle is found at the end, which is where the last empty
    /// slice is.
    export fn lastIndexOf(self, needle: Str): Option<Int> {
        lastMatch(self, needle, self.len() - needle.len())
    }

    /// `splitOnce` at the last separator rather than the first — the split a
    /// file extension or a fully qualified name wants.
    export fn splitOnceFromEnd(self, separator: Str): Option<(Str, Str)> {
        match (self.lastIndexOf(separator)) {
            .None => .None,
            .Some(at) => {
                .Some((self.slice(0, at), self.slice(at + separator.len(), self.len())))
            },
        }
    }

    /// `indexOf`, starting the search at `start` rather than at zero. The
    /// answer is still an index into the whole string.
    ///
    /// The parameter is `start` and not `from`, because `from` opens an import.
    export fn indexOfFrom(self, needle: Str, start: Int): Option<Int> {
        let at = if (start < 0) { 0 } else { start };
        self.slice(at, self.len()).indexOf(needle).map(fn(found) => found + at)
    }

    /// How many times `needle` occurs, without overlaps: `"aaaa".count("aa")` is
    /// two, not three. An empty needle occurs nowhere.
    export fn count(self, needle: Str): Int {
        if (needle.isEmpty()) { 0 } else { countFrom(self, needle, 0, 0) }
    }
}

fn lastMatch(text: Str, needle: Str, at: Int): Option<Int> {
    if (at < 0) {
        .None
    } else if (text.slice(at, at + needle.len()) == needle) {
        .Some(at)
    } else {
        lastMatch(text, needle, at - 1)
    }
}

fn countFrom(text: Str, needle: Str, at: Int, seen: Int): Int {
    match (text.indexOfFrom(needle, at)) {
        .None => seen,
        .Some(found) => countFrom(text, needle, found + needle.len(), seen + 1),
    }
}

// --- Trimming a set of characters ----------------------------------------------

impl Str {
    /// `trim`, but you say which characters to remove rather than taking
    /// whitespace. Pure: the answer is a view.
    export fn trimAny(self, chars: Str): Str {
        self.trimStartAny(chars).trimEndAny(chars)
    }

    /// `trimAny` at the front only.
    export fn trimStartAny(self, chars: Str): Str {
        self.slice(leadingAny(self, chars, 0), self.len())
    }

    /// `trimAny` at the end only.
    export fn trimEndAny(self, chars: Str): Str {
        self.slice(0, trailingAny(self, chars, self.len()))
    }

    /// The first index at which one of `chars` occurs.
    export fn indexOfAny(self, chars: Str): Option<Int> {
        self.indexWhere(fn(c) => holds(chars, c, 0))
    }

    /// The first index at which the predicate accepts the scalar there.
    ///
    /// Pure, where `chars(ctx).findIndex(...)` costs a whole `[Char]`.
    export fn indexWhere(self, predicate: fn(Char) => Bool): Option<Int> {
        whereFrom(self, predicate, 0)
    }

    /// Whether the string is empty or nothing but whitespace.
    export fn isBlank(self): Bool {
        self.trim().isEmpty()
    }
}

/// Whether `c` is one of `chars`.
fn holds(chars: Str, c: Char, at: Int): Bool {
    match (chars.charAt(at)) {
        .None => false,
        .Some(x) => x == c || holds(chars, c, at + 1),
    }
}

fn leadingAny(text: Str, chars: Str, at: Int): Int {
    match (text.charAt(at)) {
        .None => at,
        .Some(c) => {
            if (holds(chars, c, 0)) { leadingAny(text, chars, at + 1) } else { at }
        },
    }
}

fn trailingAny(text: Str, chars: Str, at: Int): Int {
    if (at <= 0) {
        0
    } else {
        match (text.charAt(at - 1)) {
            .None => at,
            .Some(c) => {
                if (holds(chars, c, 0)) { trailingAny(text, chars, at - 1) } else { at }
            },
        }
    }
}

fn whereFrom(text: Str, predicate: fn(Char) => Bool, at: Int): Option<Int> {
    match (text.charAt(at)) {
        .None => .None,
        .Some(c) => {
            if (predicate(c)) { .Some(at) } else { whereFrom(text, predicate, at + 1) }
        },
    }
}

// --- Case, without a locale ------------------------------------------------------

impl Str {
    /// Whether the two strings are equal once each scalar is lowercased.
    ///
    /// **Simple** case folding, one scalar at a time, so it is a comparison and
    /// not a collation: `"ß"` and `"SS"` are different lengths and this says
    /// no. `caseFold` is the full folding that says yes.
    export fn equalsIgnoreCase(self, other: Str): Bool {
        self.len() == other.len() && sameFolded(self, other, 0)
    }

    /// `startsWith` under the same simple folding `equalsIgnoreCase` uses.
    export fn startsWithIgnoreCase(self, prefix: Str): Bool {
        self.len() >= prefix.len() && sameFolded(self.slice(0, prefix.len()), prefix, 0)
    }
}

fn sameFolded(a: Str, b: Str, at: Int): Bool {
    match ((a.charAt(at), b.charAt(at))) {
        (.None, .None) => true,
        (.Some(x), .Some(y)) => x.toLower() == y.toLower() && sameFolded(a, b, at + 1),
        _ => false,
    }
}

// --- Building new text ------------------------------------------------------------

impl Str {
    /// `split`, stopping once `limit` pieces exist — the last one holds the
    /// whole of the rest, separators and all.
    ///
    /// A `limit` of zero or less has no pieces at all.
    export fn splitLimit<C: Allocator>(self, ctx: C, separator: Str, limit: Int): [Str] {
        if (limit <= 0) {
            list.empty<Str>()
        } else {
            limitedFrom(ctx, self, separator, limit, list.empty<Str>())
        }
    }

    /// `replace` for the first occurrence only. An empty needle changes
    /// nothing, which is `replace`'s rule too.
    export fn replaceFirst<C: Allocator>(self, ctx: C, needle: Str, replacement: Str): Str {
        if (needle.isEmpty()) {
            self
        } else {
            match (self.splitOnce(needle)) {
                .None => self,
                .Some(halves) => {
                    halves.0.concat(ctx, replacement).concat(ctx, halves.1)
                },
            }
        }
    }

    /// The scalars in the opposite order.
    ///
    /// Scalars, not graphemes: reversing `"e\u{301}"` puts the accent first and
    /// it lands on whatever follows. Reverse `graphemes(ctx)` instead when the
    /// answer has to look like the input backwards.
    export fn reverse<C: Allocator>(self, ctx: C): Str {
        fromChars(ctx, self.chars(ctx).reverse(ctx))
    }

    /// The whitespace-separated words, with the empty pieces dropped — so
    /// leading, trailing and repeated whitespace makes no empty word.
    ///
    /// Whitespace is `character.isSpace`, which is the set JavaScript's `\s`
    /// matches.
    export fn words<C: Allocator>(self, ctx: C): [Str] {
        wordsFrom(ctx, self, 0, list.empty<Str>())
    }

    /// How many bytes this string takes in UTF-8, which is what `core/bytes`'
    /// `toUtf8` produces and what a `Content-Length` counts.
    ///
    /// `len` counts scalars, so the two agree only for ASCII.
    export fn utf8Length(self): Int {
        utf8From(self, 0, 0)
    }

    /// How many UTF-16 code units this string takes — the unit a language
    /// server's positions and JavaScript's own `.length` are measured in.
    ///
    /// One per scalar below U+10000 and two above, so it differs from `len`
    /// exactly where an astral character appears.
    export fn utf16Length(self): Int {
        utf16From(self, 0, 0)
    }

    /// The common leading whitespace removed from every line.
    ///
    /// A blank line counts for nothing when the margin is measured, and comes
    /// back empty. Lines are split and rejoined on `\n`, the way `lines` cuts
    /// them.
    ///
    /// The margin is counted in characters, so a tab counts one and so does a
    /// space. Indent a block with both and the cut lands where the *count*
    /// agrees, not where the column does.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let _ = io.println(ctx, "    one\n      two".dedent(ctx)).ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// one
    ///   two
    /// ```
    export fn dedent<C: Allocator>(self, ctx: C): Str {
        let rows = self.lines(ctx);
        let margin = rows.fold(
            fn(best: Int, row) => {
                if (row.isBlank()) {
                    best
                } else {
                    let indented = leadingAny(row, " \t", 0);
                    if (best < 0 || indented < best) { indented } else { best }
                }
            },
            -1,
        );
        let cut = if (margin < 0) { 0 } else { margin };
        rows
            .map(ctx, fn(row) => {
                if (row.isBlank()) { "" } else { row.slice(cut, row.len()) }
            })
            .join(ctx, "\n")
    }

    /// `prefix` in front of every line that has anything on it. An empty line
    /// stays empty, so no trailing whitespace is invented.
    export fn indent<C: Allocator>(self, ctx: C, prefix: Str): Str {
        self
            .lines(ctx)
            .mapCtx(ctx, fn(c, row) => {
                if (row.isEmpty()) { row } else { prefix.concat(c, row) }
            })
            .join(ctx, "\n")
    }

    /// The words, greedily packed into lines of at most `width` scalars.
    ///
    /// Whitespace in the input is not kept: this is `words` and a fill, so
    /// every gap comes back as one space. A word longer than `width` gets a
    /// line of its own and overflows it rather than being cut, and a `width` of
    /// zero or less is one word per line.
    export fn wrap<C: Allocator>(self, ctx: C, width: Int): [Str] {
        wrapFrom(ctx, self.words(ctx), width, 0, "", list.empty<Str>())
    }
}

fn limitedFrom<C: Allocator>(
    ctx: C,
    rest: Str,
    separator: Str,
    left: Int,
    acc: [Str],
): [Str] {
    if (left <= 1) {
        acc.push(ctx, rest)
    } else {
        match (rest.splitOnce(separator)) {
            .None => acc.push(ctx, rest),
            .Some(halves) => {
                limitedFrom(ctx, halves.1, separator, left - 1, acc.push(ctx, halves.0))
            },
        }
    }
}

fn wordsFrom<C: Allocator>(ctx: C, text: Str, at: Int, acc: [Str]): [Str] {
    let start = spanSpace(text, at);
    if (start >= text.len()) {
        acc
    } else {
        let end = spanWord(text, start);
        wordsFrom(ctx, text, end, acc.push(ctx, text.slice(start, end)))
    }
}

fn spanSpace(text: Str, at: Int): Int {
    match (text.charAt(at)) {
        .None => at,
        .Some(c) => if (c.isSpace()) { spanSpace(text, at + 1) } else { at },
    }
}

fn spanWord(text: Str, at: Int): Int {
    match (text.charAt(at)) {
        .None => at,
        .Some(c) => if (c.isSpace()) { at } else { spanWord(text, at + 1) },
    }
}

fn utf8From(text: Str, at: Int, acc: Int): Int {
    match (text.charAt(at)) {
        .None => acc,
        .Some(c) => utf8From(text, at + 1, acc + c.utf8Length()),
    }
}

fn utf16From(text: Str, at: Int, acc: Int): Int {
    match (text.charAt(at)) {
        .None => acc,
        .Some(c) => {
            let units = if (c.toU32().toI64() >= 0x10000) { 2 } else { 1 };
            utf16From(text, at + 1, acc + units)
        },
    }
}

fn wrapFrom<C: Allocator>(
    ctx: C,
    words: [Str],
    width: Int,
    at: Int,
    line: Str,
    acc: [Str],
): [Str] {
    match (words.get(at)) {
        .None => if (line.isEmpty()) { acc } else { acc.push(ctx, line) },
        .Some(word) => {
            if (line.isEmpty()) {
                wrapFrom(ctx, words, width, at + 1, word, acc)
            } else if (line.len() + 1 + word.len() <= width) {
                let joined = line.concat(ctx, " ").concat(ctx, word);
                wrapFrom(ctx, words, width, at + 1, joined, acc)
            } else {
                wrapFrom(ctx, words, width, at + 1, word, acc.push(ctx, line))
            }
        },
    }
}

// --- Numbers as text ---------------------------------------------------------------

/// `fromInt` with `separator` between every group of three digits, counting
/// from the right. A negative number keeps its `-` and groups the rest.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/str" import * as str;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let _ = io.println(ctx, str.fromIntGrouped(ctx, -1234567, ",")).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// -1,234,567
/// ```
export fn fromIntGrouped<C: Allocator>(ctx: C, value: Int, separator: Str): Str {
    let text = fromInt(ctx, value);
    let negative = text.startsWith("-");
    let digits = if (negative) { text.slice(1, text.len()) } else { text };
    let grouped = groupedFrom(ctx, digits, separator, 0, "");
    if (negative) { "-".concat(ctx, grouped) } else { grouped }
}

fn groupedFrom<C: Allocator>(ctx: C, digits: Str, separator: Str, at: Int, acc: Str): Str {
    if (at >= digits.len()) {
        acc
    } else {
        let first = digits.len() % 3;
        let take = if (at > 0) { 3 } else if (first == 0) { 3 } else { first };
        let piece = digits.slice(at, at + take);
        let joined = if (at == 0) {
            piece
        } else {
            acc.concat(ctx, separator).concat(ctx, piece)
        };
        groupedFrom(ctx, digits, separator, at + take, joined)
    }
}

/// `fromFloat` with a fixed number of digits after the point. A negative
/// `decimals` counts as zero, and asking for more digits than the value has
/// pads with zeros.
///
/// It rounds the **shortest decimal that reads back as this `Float`** — what
/// `fromFloat` writes — half away from zero. So `2.675` comes out as `2.68`,
/// where C's `printf` says `2.67` because the stored value is a hair under.
/// Both are defensible; this one gives the same answer on every backend and
/// rounds the number you wrote down.
///
/// `NaN`, `inf` and `-inf` come back as themselves.
///
/// ```buri run
/// from "core/effect" import { Allocator, Stdout };
/// from "core/host" import * as host;
/// from "core/io" import * as io;
/// from "core/str" import * as str;
///
/// export fn main(): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let _ = io.println(ctx, str.fromFloatFixed(ctx, 3.14159, 2)).ignore();
///     let _ = io.println(ctx, str.fromFloatFixed(ctx, 2.0, 3)).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// 3.14
/// 2.000
/// ```
export fn fromFloatFixed<C: Allocator>(ctx: C, value: Float, decimals: Int): Str {
    let places = if (decimals < 0) { 0 } else { decimals };
    let shown = fromFloat(ctx, value);
    let negative = shown.startsWith("-");
    let body = if (negative) { shown.slice(1, shown.len()) } else { shown };
    if (body.indexWhere(fn(c) => c.isDigit()).isNone()) {
        shown
    } else {
        let parsed = significand(ctx, body);
        let keep = parsed.1 + places;
        let rounded = roundTo(ctx, parsed.0, keep);
        let point = if (rounded.len() > keep) { parsed.1 + 1 } else { parsed.1 };
        let text = renderFixed(ctx, rounded, point, places);
        if (negative) { "-".concat(ctx, text) } else { text }
    }
}

/// A plain or exponent-notation decimal as its digits and where the point sits:
/// the value is `0.<digits>` times ten to the second field.
fn significand<C: Allocator>(ctx: C, text: Str): (Str, Int) {
    let marker = text.indexOfAny("eE");
    let mantissa = match (marker) {
        .None => text,
        .Some(at) => text.slice(0, at),
    };
    let exponent = match (marker) {
        .None => 0,
        .Some(at) => text.slice(at + 1, text.len()).toInt().withDefault(0),
    };
    let dot = mantissa.indexOf(".");
    let whole = match (dot) {
        .None => mantissa,
        .Some(at) => mantissa.slice(0, at),
    };
    let fraction = match (dot) {
        .None => "",
        .Some(at) => mantissa.slice(at + 1, mantissa.len()),
    };
    (whole.concat(ctx, fraction), whole.len() + exponent)
}

/// `digits` cut to `keep` of them, rounded half up on the first one dropped.
/// A carry off the front makes the answer one longer than `keep`.
fn roundTo<C: Allocator>(ctx: C, digits: Str, keep: Int): Str {
    if (keep >= digits.len()) {
        digits
    } else {
        let head = if (keep <= 0) { "" } else { digits.slice(0, keep) };
        let at = if (keep < 0) { 0 } else { keep };
        let up = match (digits.charAt(at)) {
            .None => false,
            .Some(c) => c >= '5',
        };
        if (up && keep >= 0) { carry(ctx, head, head.len() - 1) } else { head }
    }
}

/// `digits` with one added to its last digit, carrying leftwards.
fn carry<C: Allocator>(ctx: C, digits: Str, at: Int): Str {
    if (at < 0) {
        "1".concat(ctx, digits)
    } else {
        let value = digits.charAt(at).andThen(fn(c) => c.toDigit(10)).withDefault(0);
        if (value == 9) {
            carry(ctx, writeAt(ctx, digits, at, '0'), at - 1)
        } else {
            match (character.fromDigit(value + 1, 10)) {
                .None => digits,
                .Some(c) => writeAt(ctx, digits, at, c),
            }
        }
    }
}

fn writeAt<C: Allocator>(ctx: C, text: Str, at: Int, c: Char): Str {
    text
        .slice(0, at)
        .concat(ctx, fromChars(ctx, [c]))
        .concat(ctx, text.slice(at + 1, text.len()))
}

/// `0.<digits>` times ten to the `point`, as a plain decimal with `places`
/// digits after the point.
fn renderFixed<C: Allocator>(ctx: C, digits: Str, point: Int, places: Int): Str {
    let whole = if (point <= 0) {
        "0"
    } else {
        digits.slice(0, point).padEnd(ctx, point, '0')
    };
    if (places <= 0) {
        whole
    } else {
        let zeros = if (point < 0) {
            "0".repeat(ctx, if (-point > places) { places } else { -point })
        } else {
            ""
        };
        let head = if (point < 0) { 0 } else { point };
        let rest = digits.slice(head, head + places - zeros.len());
        let after = zeros.concat(ctx, rest).padEnd(ctx, places, '0');
        whole.concat(ctx, ".").concat(ctx, after)
    }
}

// --- Unicode beyond the scalar ------------------------------------------------------
//
// Three answers a `Str` cannot give one scalar at a time: where a reader would
// say one character ends, which of several ways to spell the same text this is,
// and what two strings that differ only in case have in common. All three are
// tables, and `unicode_tables.py` writes them at the end of this file from
// **Unicode 16.0**.
//
// Every table is ASCII, four base-36 digits to a code point, except the ones
// holding characters — a decomposition, a folding, the Hangul syllables. There
// is no way to turn a number into a `Char` without a `Result` the native
// backends do not build, so an answer that is a character is *sliced out of a
// string that already holds it*.
//
// The cost, stated once: everything here walks the string and probes a table
// per scalar, and the allocating three turn each table into a `[Char]` first so
// a probe is a list index. That is one pass over the tables per call, not per
// scalar. `graphemeCount` is pure and cannot do it, so it reads the table as
// text and is the slow one — `graphemes(ctx).len()` is the same answer for less
// where a context is at hand.

derive Eq, Show for Normalization;
/// The four normalization forms of UAX #15.
export enum Normalization {
    /// Canonical decomposition, then canonical composition. The form to store
    /// and compare text in.
    Nfc,
    /// Canonical decomposition, and no composition.
    Nfd,
    /// Compatibility decomposition, then canonical composition. It loses
    /// distinctions on purpose: `ﬁ` becomes `fi` and `²` becomes `2`.
    Nfkc,
    /// Compatibility decomposition, and no composition.
    Nfkd,
}

impl Str {
    /// The extended grapheme clusters, in order — what a reader calls
    /// characters and what a cursor moves over.
    ///
    /// UAX #29, including the rules that keep an emoji with its skin tone, a
    /// flag's two regional indicators, and an Indic consonant with its
    /// conjunct. So `"👨‍👩‍👦"` is one piece where `chars` gives five.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let text = "👍🏽!";
    ///     let _ = io.println(ctx, "${text.graphemes(ctx).len()} ${text.len()}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 2 3
    /// ```
    export fn graphemes<C: Allocator>(self, ctx: C): [Str] {
        let cs = self.chars(ctx);
        if (cs.isEmpty()) {
            list.empty<Str>()
        } else {
            // `classIn` answers the first 128 scalars without the table, so a
            // line of ASCII does not pay to unpack fourteen thousand of them.
            let table = if (allBelow(cs, 0x80)) {
                list.empty<Char>()
            } else {
                GRAPHEME_CLASS.chars(ctx)
            };
            let first = advance(
                freshBoundary(),
                classIn(table, codePoint(cs, 0)),
                true,
            );
            clustersFrom(ctx, self, cs, table, 1, 0, first, list.empty<Str>())
        }
    }

    /// How many extended grapheme clusters there are, without building them.
    ///
    /// The same count `graphemes(ctx).len()` gives. It is pure, so it reads the
    /// break table as text rather than as a list, and that costs a walk of the
    /// table per non-ASCII scalar — use `graphemes` where you have a context.
    export fn graphemeCount(self): Int {
        if (self.isEmpty()) {
            0
        } else {
            let first = advance(freshBoundary(), classOf(charCode(self, 0)), true);
            clusterCount(self, 1, 1, first)
        }
    }

    /// The text in one of the four normalization forms of UAX #15.
    ///
    /// Two strings that look the same and are not equal are nearly always two
    /// spellings of one thing: `"é"` is either U+00E9 or `e` and U+0301, and
    /// `.Nfc` makes both the first. Normalize before comparing, hashing or
    /// storing text that came from outside.
    ///
    /// Hangul is composed and decomposed by the arithmetic UAX #15 gives, so
    /// the whole syllable block round-trips without a table of eleven thousand
    /// entries.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    /// from "core/str" import { Normalization };
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let tight = "é";
    ///     let loose = tight.normalize(ctx, .Nfd);
    ///     let back = loose.normalize(ctx, .Nfc) == tight;
    ///     let _ = io.println(ctx, "${tight.len()} ${loose.len()} ${back}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// 1 2 true
    /// ```
    export fn normalize<C: Allocator>(self, ctx: C, form: Normalization): Str {
        let cs = self.chars(ctx);
        // Nothing below U+00A0 decomposes and nothing below U+0300 combines,
        // so a string of them is already in all four forms.
        if (allBelow(cs, 0xa0)) { self } else { normalized(ctx, cs, form) }
    }
}

/// `normalize` once the string is known to hold something that decomposes.
fn normalized<C: Allocator>(ctx: C, cs: [Char], form: Normalization): Str {
    let compatible = match (form) {
        .Nfkc => true,
        .Nfkd => true,
        _ => false,
    };
    let table = if (compatible) {
        Mapping {
            keys: NFKD_KEYS.chars(ctx),
            offsets: NFKD_OFFSETS.chars(ctx),
            lengths: NFKD_LENGTHS.chars(ctx),
            values: NFKD_VALUES.chars(ctx),
        }
    } else {
        Mapping {
            keys: NFD_KEYS.chars(ctx),
            offsets: NFD_OFFSETS.chars(ctx),
            lengths: NFD_LENGTHS.chars(ctx),
            values: NFD_VALUES.chars(ctx),
        }
    };
    let composing = match (form) {
        .Nfc => true,
        .Nfkc => true,
        _ => false,
    };
    let jamo = Hangul {
        leading: HANGUL_LEADING.chars(ctx),
        vowel: HANGUL_VOWEL.chars(ctx),
        trailing: HANGUL_TRAILING.chars(ctx),
        syllables: if (composing) {
            HANGUL_SYLLABLES.chars(ctx)
        } else {
            list.empty<Char>()
        },
    };
    // Only composition indexes the syllables; decomposition is the
    // three jamo runs and arithmetic.
    let classes = COMBINING_CLASS.chars(ctx);
    let pulled = decomposeFrom(ctx, cs, table, jamo, 0, list.empty<Char>());
    let sorted = reorder(ctx, pulled, classes, pulled.len());
    if (composing) {
        let pairs = Composition {
            keys: COMPOSE_KEYS.chars(ctx),
            values: COMPOSE_VALUES.chars(ctx),
            jamo,
        };
        let joined = composeFrom(
            ctx,
            sorted,
            classes,
            pairs,
            0,
            list.empty<Char>(),
            -1,
            0,
        );
        fromChars(ctx, joined)
    } else {
        fromChars(ctx, sorted)
    }
}

impl Str {
    /// The text under **full** case folding, which is what a case-insensitive
    /// comparison should use.
    ///
    /// Full, so a folding may change the length: `"ß"` folds to `"ss"` and
    /// `"ﬁ"` to `"fi"`. `equalsIgnoreCase` is the cheap, simple folding that
    /// says those are different.
    ///
    /// Folding is not lowercasing. It has no locale and no round trip: fold
    /// both sides and compare, and do not show the answer to anyone.
    ///
    /// ```buri run
    /// from "core/effect" import { Allocator, Stdout };
    /// from "core/host" import * as host;
    /// from "core/io" import * as io;
    ///
    /// export fn main(): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let same = "STRASSE".caseFold(ctx) == "Straße".caseFold(ctx);
    ///     let _ = io.println(ctx, "${same}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// true
    /// ```
    export fn caseFold<C: Allocator>(self, ctx: C): Str {
        let cs = self.chars(ctx);
        // Full folding at an ASCII scalar is lowercasing it, and the runtime
        // already does that in one call.
        if (allBelow(cs, 0x80)) { self.toLower(ctx) } else { folded(ctx, cs) }
    }
}

/// `caseFold` once the ASCII answer is ruled out.
fn folded<C: Allocator>(ctx: C, cs: [Char]): Str {
    let table = Mapping {
        keys: FOLD_KEYS.chars(ctx),
        offsets: FOLD_OFFSETS.chars(ctx),
        lengths: FOLD_LENGTHS.chars(ctx),
        values: FOLD_VALUES.chars(ctx),
    };
    fromChars(ctx, foldFrom(ctx, cs, table, 0, list.empty<Char>()))
}

/// A key table and the characters its keys map to, all as `[Char]` so a lookup
/// is a list index rather than a walk down a string.
struct Mapping {
    keys: [Char],
    offsets: [Char],
    lengths: [Char],
    values: [Char],
}

/// The jamo and the syllables, for the arithmetic in UAX #15 §3.12.
struct Hangul {
    leading: [Char],
    vowel: [Char],
    trailing: [Char],
    syllables: [Char],
}

/// The primary composites, by the pair they are made of.
struct Composition {
    keys: [Char],
    values: [Char],
    jamo: Hangul,
}

/// What the grapheme scan remembers about everything before the boundary it is
/// deciding.
struct Boundary {
    /// The packed class of the character just before it.
    previous: Int,
    /// How many Regional_Indicators run up to it, unbroken (GB12, GB13).
    regionals: Int,
    /// Whether `ExtPict Extend*` ends here, so a `ZWJ` next keeps GB11 alive.
    pictographic: Bool,
    /// Whether `ExtPict Extend* ZWJ` ends here — GB11's left half.
    joined: Bool,
    /// Whether `Consonant [Extend Linker]*` ends here.
    consonant: Bool,
    /// Whether a `Linker` has appeared in that run — GB9c's left half.
    linked: Bool,
}

fn freshBoundary(): Boundary {
    Boundary {
        previous: 0,
        regionals: 0,
        pictographic: false,
        joined: false,
        consonant: false,
        linked: false,
    }
}

/// Whether the cluster ends between the character `state` remembers and the one
/// whose packed class is `next` — UAX #29's GB3 to GB999, in order.
fn breaksBefore(state: Boundary, next: Int): Bool {
    let a = state.previous % 16;
    let b = next % 16;
    if (a == 1 && b == 2) {
        false
    } else if (a == 1 || a == 2 || a == 3 || b == 1 || b == 2 || b == 3) {
        true
    } else if (a == 9 && (b == 9 || b == 10 || b == 12 || b == 13)) {
        false
    } else if ((a == 10 || a == 12) && (b == 10 || b == 11)) {
        false
    } else if ((a == 11 || a == 13) && b == 11) {
        false
    } else if (b == 4 || b == 5 || b == 8) {
        false
    } else if (a == 7) {
        false
    } else if (state.linked && isConsonant(next)) {
        false
    } else if (state.joined && isPictographic(next)) {
        false
    } else if (a == 6 && b == 6 && state.regionals % 2 == 1) {
        false
    } else {
        true
    }
}

/// The state after the character whose packed class is `next`, given whether
/// the cluster broke in front of it.
fn advance(state: Boundary, next: Int, broke: Bool): Boundary {
    let kind = next % 16;
    let regionals = if (kind != 6) {
        0
    } else if (broke) {
        1
    } else {
        state.regionals + 1
    };
    let carried = state.consonant && (isExtender(next) || isLinker(next));
    Boundary {
        previous: next,
        regionals,
        pictographic: isPictographic(next) || state.pictographic && kind == 4,
        joined: state.pictographic && kind == 5 && !isPictographic(next),
        consonant: isConsonant(next) || carried,
        linked: !isConsonant(next) && carried && (state.linked || isLinker(next)),
    }
}

fn isPictographic(packed: Int): Bool {
    packed / 16 % 2 == 1
}

fn isLinker(packed: Int): Bool {
    packed / 32 % 2 == 1
}

fn isConsonant(packed: Int): Bool {
    packed / 64 % 2 == 1
}

fn isExtender(packed: Int): Bool {
    packed / 128 % 2 == 1
}

fn clustersFrom<C: Allocator>(
    ctx: C,
    text: Str,
    cs: [Char],
    table: [Char],
    at: Int,
    start: Int,
    state: Boundary,
    acc: [Str],
): [Str] {
    if (at >= cs.len()) {
        acc.push(ctx, text.slice(start, at))
    } else {
        let next = classIn(table, codePoint(cs, at));
        let broke = breaksBefore(state, next);
        let pieces = if (broke) { acc.push(ctx, text.slice(start, at)) } else { acc };
        let begin = if (broke) { at } else { start };
        clustersFrom(
            ctx,
            text,
            cs,
            table,
            at + 1,
            begin,
            advance(state, next, broke),
            pieces,
        )
    }
}

fn clusterCount(text: Str, at: Int, seen: Int, state: Boundary): Int {
    if (at >= text.len()) {
        seen
    } else {
        let next = classOf(charCode(text, at));
        let broke = breaksBefore(state, next);
        let total = if (broke) { seen + 1 } else { seen };
        clusterCount(text, at + 1, total, advance(state, next, broke))
    }
}

/// Whether every scalar is below `bound`.
fn allBelow(cs: [Char], bound: Int): Bool {
    cs.all(fn(c) => c.toU32().toI64() < bound)
}

fn codePoint(cs: [Char], at: Int): Int {
    match (cs.get(at)) {
        .Some(c) => c.toU32().toI64(),
        .None => 0,
    }
}

fn charCode(text: Str, at: Int): Int {
    match (text.charAt(at)) {
        .Some(c) => c.toU32().toI64(),
        .None => 0,
    }
}

/// The packed grapheme class of the first 128 scalars, which the table never
/// has to be opened for: controls but for the two line breaks, then `Other`.
fn asciiClass(cp: Int): Option<Int> {
    if (cp >= 0x20 && cp < 0x7f) {
        .Some(0)
    } else if (cp == 0x0a) {
        .Some(2)
    } else if (cp == 0x0d) {
        .Some(1)
    } else if (cp >= 0 && cp < 0x80) {
        .Some(3)
    } else {
        .None
    }
}

fn classIn(table: [Char], cp: Int): Int {
    match (asciiClass(cp)) {
        .Some(known) => known,
        .None => rangeValue(table, cp, 0, table.len() / 10),
    }
}

fn classOf(cp: Int): Int {
    match (asciiClass(cp)) {
        .Some(known) => known,
        .None => textRangeValue(GRAPHEME_CLASS, cp, 0, GRAPHEME_CLASS.len() / 10),
    }
}

fn combiningClass(classes: [Char], c: Char): Int {
    let cp = c.toU32().toI64();
    // Nothing below U+0300 combines, which is every character a Latin text is
    // made of.
    if (cp < 0x300) { 0 } else { rangeValue(classes, cp, 0, classes.len() / 10) }
}

/// The two-digit value of the range `cp` falls in, or zero. An entry is a
/// four-digit first code point, a four-digit last one, and the value.
fn rangeValue(table: [Char], cp: Int, lo: Int, hi: Int): Int {
    if (lo >= hi) {
        0
    } else {
        let mid = lo + (hi - lo) / 2;
        let at = mid * 10;
        if (cp < codeIn(table, at)) {
            rangeValue(table, cp, lo, mid)
        } else if (cp <= codeIn(table, at + 4)) {
            digitIn(table, at + 8) * 36 + digitIn(table, at + 9)
        } else {
            rangeValue(table, cp, mid + 1, hi)
        }
    }
}

/// `rangeValue` over the table as text, for the one caller that may not
/// allocate.
///
/// It reads only each range's *first* code point while halving, and looks at a
/// last one once: every read walks the string from the front, so the reads are
/// the whole cost.
fn textRangeValue(table: Str, cp: Int, lo: Int, hi: Int): Int {
    if (lo < hi) {
        let mid = lo + (hi - lo) / 2;
        if (cp < textCodeAt(table, mid * 10)) {
            textRangeValue(table, cp, lo, mid)
        } else {
            textRangeValue(table, cp, mid + 1, hi)
        }
    } else if (lo == 0) {
        0
    } else {
        // `lo` counts the ranges beginning at or below `cp`, so the last of
        // them is the only one that can hold it.
        let at = (lo - 1) * 10;
        if (cp <= textCodeAt(table, at + 4)) {
            textDigitAt(table, at + 8) * 36 + textDigitAt(table, at + 9)
        } else {
            0
        }
    }
}

fn codeIn(table: [Char], at: Int): Int {
    digitIn(table, at) * 46656
        + digitIn(table, at + 1) * 1296
        + digitIn(table, at + 2) * 36
        + digitIn(table, at + 3)
}

fn digitIn(table: [Char], at: Int): Int {
    match (table.get(at)) {
        .Some(c) => c.toDigit(36).withDefault(0),
        .None => 0,
    }
}

fn textCodeAt(table: Str, at: Int): Int {
    textDigitAt(table, at) * 46656
        + textDigitAt(table, at + 1) * 1296
        + textDigitAt(table, at + 2) * 36
        + textDigitAt(table, at + 3)
}

fn textDigitAt(table: Str, at: Int): Int {
    match (table.charAt(at)) {
        .Some(c) => c.toDigit(36).withDefault(0),
        .None => 0,
    }
}

/// Where `cp` sits in a table of four-digit keys, or `.None`.
fn keyIndex(keys: [Char], cp: Int, lo: Int, hi: Int): Option<Int> {
    if (lo >= hi) {
        .None
    } else {
        let mid = lo + (hi - lo) / 2;
        let here = codeIn(keys, mid * 4);
        if (cp < here) {
            keyIndex(keys, cp, lo, mid)
        } else if (cp == here) {
            .Some(mid)
        } else {
            keyIndex(keys, cp, mid + 1, hi)
        }
    }
}

/// Where the pair `(a, b)` sits in a table of eight-digit keys, or `.None`.
fn pairIndex(keys: [Char], a: Int, b: Int, lo: Int, hi: Int): Option<Int> {
    if (lo >= hi) {
        .None
    } else {
        let mid = lo + (hi - lo) / 2;
        let first = codeIn(keys, mid * 8);
        let second = codeIn(keys, mid * 8 + 4);
        if (a < first || a == first && b < second) {
            pairIndex(keys, a, b, lo, mid)
        } else if (a == first && b == second) {
            .Some(mid)
        } else {
            pairIndex(keys, a, b, mid + 1, hi)
        }
    }
}

/// What `cp` maps to, or `.None` when the table says nothing about it.
fn mapped<C: Allocator>(ctx: C, table: Mapping, cp: Int): Option<[Char]> {
    match (keyIndex(table.keys, cp, 0, table.keys.len() / 4)) {
        .None => .None,
        .Some(found) => {
            let at = codeIn(table.offsets, found * 4);
            .Some(table.values.slice(ctx, at, at + digitIn(table.lengths, found)))
        },
    }
}

fn foldFrom<C: Allocator>(
    ctx: C,
    cs: [Char],
    table: Mapping,
    at: Int,
    acc: [Char],
): [Char] {
    match (cs.get(at)) {
        .None => acc,
        .Some(c) => {
            let next = match (mapped(ctx, table, c.toU32().toI64())) {
                .None => acc.push(ctx, c),
                .Some(parts) => acc.concat(ctx, parts),
            };
            foldFrom(ctx, cs, table, at + 1, next)
        },
    }
}

fn decomposeFrom<C: Allocator>(
    ctx: C,
    cs: [Char],
    table: Mapping,
    jamo: Hangul,
    at: Int,
    acc: [Char],
): [Char] {
    match (cs.get(at)) {
        .None => acc,
        .Some(c) => {
            let cp = c.toU32().toI64();
            let next = if (cp >= 0xac00 && cp <= 0xd7a3) {
                acc.concat(ctx, hangulParts(ctx, jamo, c, cp - 0xac00))
            } else {
                match (mapped(ctx, table, cp)) {
                    .None => acc.push(ctx, c),
                    .Some(parts) => acc.concat(ctx, parts),
                }
            };
            decomposeFrom(ctx, cs, table, jamo, at + 1, next)
        },
    }
}

/// A Hangul syllable's two or three jamo, by the arithmetic in UAX #15 §3.12.
fn hangulParts<C: Allocator>(ctx: C, jamo: Hangul, syllable: Char, index: Int): [Char] {
    let none: [Char] = [];
    match ((jamo.leading.get(index / 588), jamo.vowel.get(index % 588 / 28))) {
        (.Some(lead), .Some(vowel)) => {
            let pair = none.push(ctx, lead).push(ctx, vowel);
            if (index % 28 == 0) {
                pair
            } else {
                match (jamo.trailing.get(index % 28)) {
                    .Some(tail) => pair.push(ctx, tail),
                    .None => pair,
                }
            }
        },
        _ => none.push(ctx, syllable),
    }
}

/// The canonical ordering algorithm: inside each run of non-starters, sort by
/// combining class and leave equal classes as they were.
///
/// Adjacent swaps until nothing moves, which is O(n²) on the run — and a run is
/// two or three marks in real text.
fn reorder<C: Allocator>(ctx: C, cs: [Char], classes: [Char], fuel: Int): [Char] {
    if (fuel <= 0) {
        cs
    } else {
        let once = swapPass(ctx, cs, classes, 0);
        if (once == cs) { cs } else { reorder(ctx, once, classes, fuel - 1) }
    }
}

fn swapPass<C: Allocator>(ctx: C, cs: [Char], classes: [Char], at: Int): [Char] {
    match ((cs.get(at), cs.get(at + 1))) {
        (.Some(a), .Some(b)) => {
            let first = combiningClass(classes, a);
            let second = combiningClass(classes, b);
            if (second > 0 && first > second) {
                let swapped = cs.replaceAt(ctx, at, b).replaceAt(ctx, at + 1, a);
                swapPass(ctx, swapped, classes, at + 1)
            } else {
                swapPass(ctx, cs, classes, at + 1)
            }
        },
        _ => cs,
    }
}

/// The canonical composition algorithm: each character joined to the last
/// starter where the pair is a primary composite and nothing blocks it.
fn composeFrom<C: Allocator>(
    ctx: C,
    cs: [Char],
    classes: [Char],
    pairs: Composition,
    at: Int,
    acc: [Char],
    starter: Int,
    lastClass: Int,
): [Char] {
    match (cs.get(at)) {
        .None => acc,
        .Some(c) => {
            let cc = combiningClass(classes, c);
            let open = starter >= 0 && (lastClass == 0 || lastClass < cc);
            let made: Option<Char> = if (open) {
                match (acc.get(starter)) {
                    .None => .None,
                    .Some(base) => primaryComposite(pairs, base, c),
                }
            } else {
                .None
            };
            match (made) {
                .Some(joined) => {
                    let merged = acc.replaceAt(ctx, starter, joined);
                    composeFrom(
                        ctx,
                        cs,
                        classes,
                        pairs,
                        at + 1,
                        merged,
                        starter,
                        lastClass,
                    )
                },
                .None => {
                    let next = if (cc == 0) { acc.len() } else { starter };
                    composeFrom(
                        ctx,
                        cs,
                        classes,
                        pairs,
                        at + 1,
                        acc.push(ctx, c),
                        next,
                        cc,
                    )
                },
            }
        },
    }
}

/// The one character `a` and `b` compose to, or `.None`. Hangul is arithmetic
/// and everything else is a lookup.
fn primaryComposite(pairs: Composition, a: Char, b: Char): Option<Char> {
    let x = a.toU32().toI64();
    let y = b.toU32().toI64();
    if (x >= 0x1100 && x <= 0x1112 && y >= 0x1161 && y <= 0x1175) {
        pairs.jamo.syllables.get(((x - 0x1100) * 21 + (y - 0x1161)) * 28)
    } else if (
        x >= 0xac00
            && x <= 0xd7a3
            && (x - 0xac00) % 28 == 0
            && y >= 0x11a8
            && y <= 0x11c2
    ) {
        pairs.jamo.syllables.get(x - 0xac00 + (y - 0x11a7))
    } else {
        match (pairIndex(pairs.keys, x, y, 0, pairs.keys.len() / 8)) {
            .None => .None,
            .Some(found) => pairs.values.get(found),
        }
    }
}

