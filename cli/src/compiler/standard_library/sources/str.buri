//! core/str — the defining module of `Str`.
//!
//! `Str` is an immutable UTF-8 string. `trim`, `slice`, and `splitOnce` are
//! pure because it is immutable and sliceable: they return views, not copies.
//! Anything whose result length depends on runtime data names `Alloc`.
//!
//! There is no overloading, so a pure variant and an allocating variant of the
//! same idea get different names: `splitOnce` returns two slices and is pure;
//! `split` returns `[Str]` and allocates.

from "core/effect" import { Alloc };
from "core/order" import { Order };

// --- Pure ---------------------------------------------------------------------

impl Str {
    /// The number of Unicode scalar values, not the number of UTF-8 bytes.
    export fn len(self): Int;

    export fn isEmpty(self): Bool {
        self.len() == 0
    }

    export fn charAt(self, index: Int): Option<Char>;

    /// A view into `self`, not a copy — which is why it is pure and takes no
    /// `Alloc`. The view keeps the whole parent string alive for as long as it
    /// lives, so holding three bytes of a ten-megabyte line holds ten megabytes.
    /// Copy with `format` when the parent is large and the view is small.
    export fn slice(self, start: Int, end: Int): Str;

    export fn trim(self): Str;

    export fn trimStart(self): Str;

    export fn trimEnd(self): Str;

    export fn startsWith(self, prefix: Str): Bool;

    export fn endsWith(self, suffix: Str): Bool;

    export fn contains(self, needle: Str): Bool;

    export fn indexOf(self, needle: Str): Option<Int>;

    /// Two slices, or `.None` when the separator does not occur. Pure, because
    /// neither half is a copy.
    export fn splitOnce(self, separator: Str): Option<(Str, Str)>;

    export fn compare(self, other: Str): Order;

    export fn toInt(self): Option<Int>;

    export fn toFloat(self): Option<Float>;
}

// --- Deterministic: bounded by <C: Alloc> --------------------------------------

impl Str {
    export fn concat<C: Alloc>(self, ctx: C, other: Str): Str;

    export fn split<C: Alloc>(self, ctx: C, separator: Str): [Str];

    /// Splits on any of the characters in `separators`, dropping empty pieces.
    export fn splitAny<C: Alloc>(self, ctx: C, separators: Str): [Str];

    export fn lines<C: Alloc>(self, ctx: C): [Str];

    export fn replace<C: Alloc>(self, ctx: C, needle: Str, replacement: Str): Str;

    export fn repeat<C: Alloc>(self, ctx: C, times: Int): Str;

    export fn toUpper<C: Alloc>(self, ctx: C): Str;

    export fn toLower<C: Alloc>(self, ctx: C): Str;

    export fn chars<C: Alloc>(self, ctx: C): [Char];
}

export fn fromChars<C: Alloc>(ctx: C, cs: [Char]): Str;

export fn fromInt<C: Alloc>(ctx: C, n: Int): Str;

export fn fromFloat<C: Alloc>(ctx: C, x: Float): Str;

impl Str {
    export fn padStart<C: Alloc>(self, ctx: C, width: Int, fill: Char): Str;

    export fn padEnd<C: Alloc>(self, ctx: C, width: Int, fill: Char): Str;
}

/// Turning a `Template` into a `Str` is the point at which interpolation
/// allocates. Constructing the `Template` itself allocates nothing, which is
/// why `io.println(ctx, "hi ${name}")` needs only `Stdout`.
export fn format<C: Alloc>(ctx: C, template: Template): Str;
