//! Soaks the replicated store: long faulty runs over a range of seeds, each
//! settled and checked. Prints one line a seed, and fails on the first seed
//! whose nodes disagree.

from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout };
from "//libs/replica" import { Config, soak };

let SEEDS: Int = 8;

let STEPS: Int = 6000;

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let config = Config { nodes: 5, keys: 200, dropPercent: 5, faults: true };
    list
        .range(ctx, 1, SEEDS + 1)
        .foldResultCtx(
            ctx,
            fn(c, u, seed) => {
                let s = soak(c, config, seed, STEPS)?;
                let line = str.format(
                    c,
                    "seed ${seed}: commit ${s.commit}, ${s.keys} keys, digest ${s.digest}, ${s.sent} sent, ${s.dropped} dropped, ${s.elections} elections, snapshot ${s.snapshot}, ${s.reads} reads",
                );
                let _ = io.println(c, line).mapErr(fn(e) => "stdout closed")?;
                .Ok(())
            },
            (),
        )
}
