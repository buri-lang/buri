from "core/env" import * as env;
from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Environment, Stdout };

fn key(mode: Str, n: Int, i: Int): Int {
    match (mode) {
        "ascending" => i,
        "descending" => n - i,
        "appended" => if (i == n - 1) { 0 } else { i },
        "ties" => (n - i) / 3,
        "runs" => i % 1000,
        _ => i * 7919 % 100003,
    }
}

fn ints<C: Allocator>(ctx: C, xs: [Int], k: Int, acc: Int): Int {
    if (k == 0) {
        acc
    } else {
        ints(ctx, xs, k - 1, acc + xs.sort(ctx).first().withDefault(0) + 1)
    }
}

fn strs<C: Allocator>(ctx: C, xs: [Str], k: Int, acc: Int): Int {
    if (k == 0) {
        acc
    } else {
        strs(ctx, xs, k - 1, acc + xs.sort(ctx).first().withDefault("").length() + 1)
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Environment: host.env,
        Stdout: host.stdout,
    };
    let args = env.arguments(ctx);
    let mode = args.first().withDefault("shuffled");
    let elems = args.get(1).withDefault("int");
    let n = 20000;
    let xs = list.range(ctx, 0, n).map(ctx, fn(i) => key(mode, n, i));
    let answer = if (elems == "str") {
        strs(ctx, xs.mapCtx(ctx, fn(c, k) => str.format(c, "k${k + 100000}")), 100, 0)
    } else {
        ints(ctx, xs, 100, 0)
    };
    io.println(ctx, "${answer}").mapErr(fn(_e) => "stdout")
}
