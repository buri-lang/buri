from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn build<C: Allocator>(ctx: C, acc: Str, i: Int, end: Int): Str {
    if (i == end) {
        acc
    } else {
        build(ctx, acc.concat(ctx, str.fromInt(ctx, i)).concat(ctx, ","), i + 1, end)
    }
}

fn churn<C: Allocator>(ctx: C, i: Int, end: Int, total: Int): Int {
    if (i == end) {
        total
    } else {
        let s = str.format(ctx, "item-${i}-${i * 3}");
        let parts = s.split(ctx, "-");
        let t = if (s.contains("99")) { 1 } else { 0 };
        churn(
            ctx,
            i + 1,
            end,
            total + parts.length() + s.length() + t + s.indexOf("-").withDefault(0),
        )
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = host.alloc;
    let big = build(ctx, "", 0, 300000);
    let n = churn(ctx, 0, 1000000, 0);
    let _ = io.println(host.stdout, str.format(ctx, "${big.length()} ${n}")).ignore();
    .Ok(())
}
