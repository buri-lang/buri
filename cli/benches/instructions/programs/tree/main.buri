from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator, Stdout };

enum Tree {
    Leaf,
    Node(Tree, Int, Tree),
}

fn build(d: Int, v: Int): Tree {
    if (d == 0) {
        .Leaf
    } else {
        .Node(build(d - 1, v * 2), v, build(d - 1, v * 2 + 1))
    }
}

fn sum(t: Tree): Int {
    match (t) {
        .Leaf => 0,
        .Node(l, v, r) => sum(l) + v % 7 + sum(r),
    }
}

fn depth(t: Tree): Int {
    match (t) {
        .Leaf => 0,
        .Node(l, _, r) => {
            let a = depth(l);
            let b = depth(r);
            if (a > b) { a + 1 } else { b + 1 }
        },
    }
}

fn rep(i: Int, acc: Int): Int {
    if (i == 0) {
        acc
    } else {
        let t = build(16, 1);
        rep(i - 1, acc + sum(t) + depth(t))
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let _ = io.println(host.stdout, str.fromInt(host.alloc, rep(40, 0))).ignore();
    .Ok(())
}
