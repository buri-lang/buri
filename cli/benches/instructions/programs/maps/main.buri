from "core/io" import * as io;
from "core/map" import * as map;
from "core/map" import { Map };
from "core/str" import * as str;
from "native" import { NativeHost };
from "platform/effect" import { Allocator };

fn fill<C: Allocator>(ctx: C, m: Map<Str, Int>, i: Int, end: Int): Map<Str, Int> {
    if (i == end) {
        m
    } else {
        fill(ctx, m.insert(ctx, str.format(ctx, "key-${i % 50000}"), i), i + 1, end)
    }
}

fn look<C: Allocator>(ctx: C, m: Map<Str, Int>, i: Int, end: Int, acc: Int): Int {
    if (i == end) {
        acc
    } else {
        let v = m.get(str.format(ctx, "key-${i % 70000}")).withDefault(1);
        look(ctx, m, i + 1, end, (acc + v) % 1000000007)
    }
}

export fn main(host: NativeHost): Result<(), Str> {
    let ctx = host.alloc;
    let m = fill(ctx, map.empty<Str, Int>(), 0, 300000);
    let x = look(ctx, m, 0, 600000, 0);
    let _ = io.println(host.stdout, str.format(ctx, "${m.length()} ${x}")).ignore();
    .Ok(())
}
