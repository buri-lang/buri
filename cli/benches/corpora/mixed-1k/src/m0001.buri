/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label1_6<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "foxtrot" } else { "delta" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants1_6(): (Int, Int, Float, Char, Str) {
  (546841, 0x714B, 679.822, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_6<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants1_6();
  label1_6(ctx, a, e).len() + b
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose1_7(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth1_7(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_7<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth1_7("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose1_7(.Some(3), .None) + extra
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest1_8<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [6228, 2679, 3193, 8003, 5867, 478, 2483, 9997, 3209, 8644];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain1_8(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_8<C: Alloc>(ctx: C): Int {
  digest1_8(ctx) + drain1_8()
}

