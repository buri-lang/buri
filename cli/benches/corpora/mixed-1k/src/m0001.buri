//! Generated module 1 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0000.buri" import { Node0, seed0, blend0, reach0 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node1 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node1;

export fn seed1(): Int { 7920 }

/// Folds this module's seed together with its dependencies'.
export fn blend1(base: Int): Int {
  let d0 = blend0(base) + seed0();
  d0 + seed1()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift1(n: Node0): Node1 {
  Node1 { label: n.label, value: n.value + seed1(), weight: n.weight }
}

/// A body of 6 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute1_0(input: Int): Int {
  let a0 = input * 4 + 680;
  let a1 = a0 * 77;
  let a2 = a1 + 20;
  let a3 = a2 - 19;
  let a4 = a3 * 52;
  let a5 = a4 * 91;
  if (a5 > 5654) { a5 } else { a5 - 36 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute1_0(7)
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr1_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll1_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric1_1(ns: [Int], ss: [Str]): Int {
  firstOr1_1<Int>(ns, 0) + firstOr1_1<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_1<C: Alloc>(ctx: C): Int {
  useGeneric1_1([1, 2], ["a"]) + describeAll1_1(ctx, [1, 2]).len()
}

/// A record with 3 fields, derived comparisons and two methods.
export struct Rec1_2 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
}

derive Eq, Show for Rec1_2;

impl Rec1_2 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 53
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec1_2: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_2<C: Alloc>(ctx: C): Int {
  let r = Rec1_2 { f0: 7, f1: "probe", f2: 1.5 };
  r.scaled(3) + r.render(ctx).len()
}

