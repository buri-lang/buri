/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach1<C: Alloc>(ctx: C): Int {
  0
    + probe1_0(ctx)
    + probe1_1(ctx)
    + probe1_2(ctx)
    + probe1_3(ctx)
    + probe1_4(ctx)
    + probe1_5(ctx)
    + probe1_6(ctx)
    + probe1_7(ctx)
    + probe1_8(ctx)
    + probe1_9(ctx)
    + probe1_10(ctx)
    + reach0(ctx)
}
