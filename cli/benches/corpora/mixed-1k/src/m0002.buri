/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach2<C: Alloc>(ctx: C): Int {
  0
    + probe2_0(ctx)
    + probe2_1(ctx)
    + probe2_2(ctx)
    + probe2_3(ctx)
    + probe2_4(ctx)
    + probe2_5(ctx)
    + probe2_6(ctx)
    + probe2_7(ctx)
