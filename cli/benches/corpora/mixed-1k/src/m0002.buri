/// An enum of 4 variants, matched exhaustively below.
export enum State2_6 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
}

derive Eq, Show for State2_6;

/// The match every enum in a real program has somewhere.
export fn rank2_6(state: State2_6): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start2_6(ticks: Int): State2_6 {
  if (ticks == 0) { .Idle } else if (ticks < 63) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_6<C: Alloc>(ctx: C): Int {
  let s = start2_6(5);
  rank2_6(s) + s.show(ctx).len()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label2_7<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "golf" } else { "delta" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants2_7(): (Int, Int, Float, Char, Str) {
  (919874, 0x7011, 160.465, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_7<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants2_7();
  label2_7(ctx, a, e).len() + b
}

