//! Generated module 2 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0001" import { Node1, seed1, blend1, reach1 };
from "//bench/m0000" import { Node0, seed0, blend0, reach0 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node2 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node2;

export fn seed2(): Int { 5839 }

/// Folds this module's seed together with its dependencies'.
export fn blend2(base: Int): Int {
  let d0 = blend1(base) + seed1();
  let d1 = blend0(base) + seed0();
  d0 + d1 + seed2()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift2(n: Node1): Node2 {
  Node2 { label: n.label, value: n.value + seed2(), weight: n.weight }
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr2_0<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll2_0<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric2_0(ns: [Int], ss: [Str]): Int {
  firstOr2_0<Int>(ns, 0) + firstOr2_0<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_0<C: Alloc>(ctx: C): Int {
  useGeneric2_0([1, 2], ["a"]) + describeAll2_0(ctx, [1, 2]).len()
}

/// A body of 5 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute2_1(input: Int): Int {
  let a0 = input * 6 + 64;
  let a1 = a0 - 86;
  let a2 = a1 * 96;
  let a3 = a2 - 21;
  let a4 = a3 * 40;
  if (a4 > 5439) { a4 } else { a4 - 3 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_1<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute2_1(7)
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose2_2(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth2_2(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_2<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth2_2("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose2_2(.Some(3), .None) + extra
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest2_3<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [4713, 6013, 1107, 8949, 5606, 3497];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain2_3(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_3<C: Alloc>(ctx: C): Int {
  digest2_3(ctx) + drain2_3()
}

/// A record with 3 fields, derived comparisons and two methods.
export struct Rec2_4 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
}

derive Eq, Show for Rec2_4;

impl Rec2_4 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 2
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec2_4: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_4<C: Alloc>(ctx: C): Int {
  let r = Rec2_4 { f0: 7, f1: "probe", f2: 1.5 };
  r.scaled(3) + r.render(ctx).len()
}

