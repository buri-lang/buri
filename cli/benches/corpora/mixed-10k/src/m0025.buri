/// Folds this module's seed together with its dependencies'.
export fn blend25(base: Int): Int {
  let d0 = blend16(base) + seed16();
  let d1 = blend23(base) + seed23();
  let d2 = blend18(base) + seed18();
  d0 + d1 + d2 + seed25()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift25(n: Node16): Node25 {
  Node25 { label: n.label, value: n.value + seed25(), weight: n.weight }
}

