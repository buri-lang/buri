/// An enum of 6 variants, matched exhaustively below.
export enum State25_11 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
  export Step4(Int, Str),
  export Step5(Int, Str),
}

derive Eq, Show for State25_11;

/// The match every enum in a real program has somewhere.
export fn rank25_11(state: State25_11): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start25_11(ticks: Int): State25_11 {
  if (ticks == 0) { .Idle } else if (ticks < 27) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe25_11<C: Alloc>(ctx: C): Int {
  let s = start25_11(5);
  rank25_11(s) + s.show(ctx).len()
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach25<C: Alloc>(ctx: C): Int {
  0
    + probe25_0(ctx)
    + probe25_1(ctx)
    + probe25_2(ctx)
    + probe25_3(ctx)
    + probe25_4(ctx)
    + probe25_5(ctx)
    + probe25_6(ctx)
    + probe25_7(ctx)
    + probe25_8(ctx)
    + probe25_9(ctx)
    + probe25_10(ctx)
    + probe25_11(ctx)
    + reach16(ctx)
    + reach23(ctx)
    + reach18(ctx)
}
