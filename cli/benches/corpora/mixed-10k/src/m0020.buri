//! Generated module 20 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0003" import { Node3, seed3, blend3, reach3 };
from "//bench/m0008" import { Node8, seed8, blend8, reach8 };
from "//bench/m0001" import { Node1, seed1, blend1, reach1 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node20 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node20;

export fn seed20(): Int { 8381 }

/// Folds this module's seed together with its dependencies'.
export fn blend20(base: Int): Int {
  let d0 = blend3(base) + seed3();
  let d1 = blend8(base) + seed8();
  let d2 = blend1(base) + seed1();
  d0 + d1 + d2 + seed20()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift20(n: Node3): Node20 {
  Node20 { label: n.label, value: n.value + seed20(), weight: n.weight }
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose20_0(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth20_0(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe20_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth20_0("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose20_0(.Some(3), .None) + extra
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr20_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll20_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric20_1(ns: [Int], ss: [Str]): Int {
  firstOr20_1<Int>(ns, 0) + firstOr20_1<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe20_1<C: Alloc>(ctx: C): Int {
  useGeneric20_1([1, 2], ["a"]) + describeAll20_1(ctx, [1, 2]).len()
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest20_2<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [5054, 8466, 7841, 3327, 2305, 8670, 5002, 4907, 6513, 43, 679];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain20_2(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe20_2<C: Alloc>(ctx: C): Int {
  digest20_2(ctx) + drain20_2()
}

/// A body of 4 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute20_3(input: Int): Int {
  let a0 = input * 1 + 170;
  let a1 = a0 * 64;
  let a2 = a1 + 93;
  let a3 = a2 - 66;
  if (a3 > 6125) { a3 } else { a3 - 45 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe20_3<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute20_3(7)
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label20_4<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "delta" } else { "golf" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants20_4(): (Int, Int, Float, Char, Str) {
  (281633, 0xFDA2, 491.635, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe20_4<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants20_4();
  label20_4(ctx, a, e).len() + b
}

