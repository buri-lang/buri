/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach6<C: Alloc>(ctx: C): Int {
  0
    + probe6_0(ctx)
    + probe6_1(ctx)
    + probe6_2(ctx)
    + probe6_3(ctx)
    + probe6_4(ctx)
    + probe6_5(ctx)
    + probe6_6(ctx)
    + probe6_7(ctx)
    + probe6_8(ctx)
    + probe6_9(ctx)
    + probe6_10(ctx)
    + reach2(ctx)
}
