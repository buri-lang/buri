//! Generated module 6 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str/lib.buri" import * as str;
from "core/list/lib.buri" import * as list;
from "core/effect/lib.buri" import { Alloc };
from "//bench/m0002.buri" import { Node2, seed2, blend2, reach2 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node6 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node6;

export fn seed6(): Int { 7515 }

/// Folds this module's seed together with its dependencies'.
export fn blend6(base: Int): Int {
  let d0 = blend2(base) + seed2();
  d0 + seed6()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift6(n: Node2): Node6 {
  Node6 { label: n.label, value: n.value + seed6(), weight: n.weight }
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest6_0<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [3296, 612, 1095, 1626, 1950, 6721, 5564];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain6_0(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe6_0<C: Alloc>(ctx: C): Int {
  digest6_0(ctx) + drain6_0()
}

/// An enum of 7 variants, matched exhaustively below.
export enum State6_1 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
  Step6(Int, Str),
}

derive Eq, Show for State6_1;

/// The match every enum in a real program has somewhere.
export fn rank6_1(state: State6_1): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
    .Step6(k, _) => k + 6,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start6_1(ticks: Int): State6_1 {
  if (ticks == 0) { .Idle } else if (ticks < 47) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe6_1<C: Alloc>(ctx: C): Int {
  let s = start6_1(5);
  rank6_1(s) + s.show(ctx).len()
}

/// A record with 5 fields, derived comparisons and two methods.
export struct Rec6_2 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
  export f3: Bool,
  export f4: Int,
}

derive Eq, Show for Rec6_2;

impl Rec6_2 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 607
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec6_2: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe6_2<C: Alloc>(ctx: C): Int {
  let r = Rec6_2 { f0: 7, f1: "probe", f2: 1.5, f3: true, f4: 7 };
  r.scaled(3) + r.render(ctx).len()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label6_3<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "bravo" } else { "golf" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants6_3(): (Int, Int, Float, Char, Str) {
  (500918, 0xA8AE, 676.879, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe6_3<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants6_3();
  label6_3(ctx, a, e).len() + b
}

