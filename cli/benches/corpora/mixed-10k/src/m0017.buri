/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose17_3(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth17_3(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe17_3<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth17_3("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose17_3(.Some(3), .None) + extra
}

/// A body of 11 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute17_4(input: Int): Int {
  let a0 = input * 3 + 223;
  let a1 = a0 - 77;
  let a2 = a1 - 60;
  let a3 = a2 * 9;
  let a4 = a3 - 89;
  let a5 = a4 + 59;
  let a6 = a5 - 11;
  let a7 = a6 - 14;
  let a8 = a7 + 1;
  let a9 = a8 - 9;
  let a10 = a9 - 16;
  if (a10 > 2208) { a10 } else { a10 - 36 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe17_4<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute17_4(7)
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label17_5<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "delta" } else { "bravo" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants17_5(): (Int, Int, Float, Char, Str) {
  (424916, 0x1234, 710.860, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe17_5<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants17_5();
  label17_5(ctx, a, e).len() + b
}

/// A record with 3 fields, derived comparisons and two methods.
export struct Rec17_6 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
}

derive Eq, Show for Rec17_6;

impl Rec17_6 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 827
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec17_6: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe17_6<C: Alloc>(ctx: C): Int {
  let r = Rec17_6 { f0: 7, f1: "probe", f2: 1.5 };
  r.scaled(3) + r.render(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr17_7<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll17_7<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric17_7(ns: [Int], ss: [Str]): Int {
  firstOr17_7<Int>(ns, 0) + firstOr17_7<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe17_7<C: Alloc>(ctx: C): Int {
  useGeneric17_7([1, 2], ["a"]) + describeAll17_7(ctx, [1, 2]).len()
}

