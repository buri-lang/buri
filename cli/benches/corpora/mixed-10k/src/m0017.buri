/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach17<C: Alloc>(ctx: C): Int {
  0
    + probe17_0(ctx)
    + probe17_1(ctx)
    + probe17_2(ctx)
    + probe17_3(ctx)
    + probe17_4(ctx)
    + probe17_5(ctx)
    + probe17_6(ctx)
    + probe17_7(ctx)
    + probe17_8(ctx)
    + probe17_9(ctx)
    + reach16(ctx)
