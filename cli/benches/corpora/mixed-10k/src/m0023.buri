/// A body of 8 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute23_6(input: Int): Int {
  let a0 = input * 4 + 132;
  let a1 = a0 + 52;
  let a2 = a1 * 67;
  let a3 = a2 - 67;
  let a4 = a3 * 96;
  let a5 = a4 + 79;
  let a6 = a5 * 28;
  let a7 = a6 + 20;
  if (a7 > 3642) { a7 } else { a7 - 69 }
}

