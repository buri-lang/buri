/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node23 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node23;

export fn seed23(): Int { 2138 }

/// Folds this module's seed together with its dependencies'.
export fn blend23(base: Int): Int {
  let d0 = blend12(base) + seed12();
  d0 + seed23()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift23(n: Node12): Node23 {
  Node23 { label: n.label, value: n.value + seed23(), weight: n.weight }
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose23_0(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth23_0(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe23_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth23_0("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose23_0(.Some(3), .None) + extra
}

