}

/// An enum of 5 variants, matched exhaustively below.
export enum State23_8 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
}

derive Eq, Show for State23_8;

/// The match every enum in a real program has somewhere.
export fn rank23_8(state: State23_8): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start23_8(ticks: Int): State23_8 {
  if (ticks == 0) { .Idle } else if (ticks < 55) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe23_8<C: Alloc>(ctx: C): Int {
  let s = start23_8(5);
  rank23_8(s) + s.show(ctx).len()
}

