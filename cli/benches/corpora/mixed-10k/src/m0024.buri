//! Generated module 24 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0020.buri" import { Node20, seed20, blend20, reach20 };
from "//bench/m0018.buri" import { Node18, seed18, blend18, reach18 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node24 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node24;

export fn seed24(): Int { 57 }

/// Folds this module's seed together with its dependencies'.
export fn blend24(base: Int): Int {
  let d0 = blend20(base) + seed20();
  let d1 = blend18(base) + seed18();
  d0 + d1 + seed24()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift24(n: Node20): Node24 {
  Node24 { label: n.label, value: n.value + seed24(), weight: n.weight }
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr24_0<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll24_0<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric24_0(ns: [Int], ss: [Str]): Int {
  firstOr24_0<Int>(ns, 0) + firstOr24_0<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe24_0<C: Alloc>(ctx: C): Int {
  useGeneric24_0([1, 2], ["a"]) + describeAll24_0(ctx, [1, 2]).len()
}

/// A body of 11 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute24_1(input: Int): Int {
  let a0 = input * 3 + 616;
  let a1 = a0 - 54;
  let a2 = a1 - 9;
  let a3 = a2 + 85;
  let a4 = a3 - 55;
  let a5 = a4 + 59;
  let a6 = a5 * 31;
  let a7 = a6 * 17;
  let a8 = a7 * 61;
  let a9 = a8 - 42;
  let a10 = a9 + 56;
  if (a10 > 5364) { a10 } else { a10 - 74 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe24_1<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute24_1(7)
}

/// An enum of 4 variants, matched exhaustively below.
export enum State24_2 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
}

derive Eq, Show for State24_2;

/// The match every enum in a real program has somewhere.
export fn rank24_2(state: State24_2): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start24_2(ticks: Int): State24_2 {
  if (ticks == 0) { .Idle } else if (ticks < 63) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe24_2<C: Alloc>(ctx: C): Int {
  let s = start24_2(5);
  rank24_2(s) + s.show(ctx).len()
}

