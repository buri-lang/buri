/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose33_5(a: Option<Int>, b: Option<Int>): Int {
    match ((a, b)) {
        (.Some(x), .Some(y)) if x > y => x - y,
        (.Some(x), .Some(y)) => y - x,
        (.Some(x), .None) => x,
        (.None, .Some(y)) => y,
        (.None, .None) => 0,
    }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth33_5(left: Str, right: Str): Option<Int> {
    let a = left.toInt()?;
    let b = right.toInt()?;
    .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe33_5<C: Alloc>(ctx: C): Int {
    let _ = ctx;
    let extra = match (parseBoth33_5("1", "2")) {
        .Some(v) => v,
        .None => 0,
    };
    choose33_5(.Some(3), .None) + extra
}

