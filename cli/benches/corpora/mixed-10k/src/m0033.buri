derive Eq, Show for Node33;
/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node33 {
    export label: Str,
    export value: Int,
    export weight: Float,
}

export fn seed33(): Int {
    1328
}

/// Folds this module's seed together with its dependencies'.
export fn blend33(base: Int): Int {
    let d0 = blend11(base) + seed11();
    d0 + seed33()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift33(n: Node11): Node33 {
    Node33 { label: n.label, value: n.value + seed33(), weight: n.weight }
}

derive Eq, Show for Rec33_0;
/// A record with 2 fields, derived comparisons and two methods.
export struct Rec33_0 {
    export f0: Int,
    export f1: Str,
}

impl Rec33_0 {
    /// A pure accessor, of the kind that is most of a real impl block.
    export fn scaled(self, factor: Int): Int {
        self.f0 * factor + 808
    }

    /// Allocates, and says so with `C: Alloc`.
    export fn render<C: Alloc>(self, ctx: C): Str {
        str.format(ctx, "rec33_0: ${self.f0}/${self.f1}")
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe33_0<C: Alloc>(ctx: C): Int {
    let r = Rec33_0 { f0: 7, f1: "probe" };
    r.scaled(3) + r.render(ctx).len()
}

derive Eq, Show for State33_1;
/// An enum of 4 variants, matched exhaustively below.
export enum State33_1 {
    Idle,
    Running(Int),
    Failed { code: Int, message: Str },
    Step3(Int, Str),
}

/// The match every enum in a real program has somewhere.
export fn rank33_1(state: State33_1): Int {
    match (state) {
        .Idle => 0,
        .Running(ticks) => ticks + 1,
        .Failed { code, .. } => code * -1,
        .Step3(k, _) => k + 3,
    }
}

/// Construction, so the variants are reachable from a root.
export fn start33_1(ticks: Int): State33_1 {
    if (ticks == 0) {
        .Idle
    } else if (ticks < 96) {
        .Running(ticks)
    } else {
        .Failed { code: ticks, message: "overrun" }
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe33_1<C: Alloc>(ctx: C): Int {
    let s = start33_1(5);
    rank33_1(s) + s.show(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr33_2<T>(xs: [T], fallback: T): T {
    match (xs.first()) {
        .Some(v) => v,
        .None => fallback,
    }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll33_2<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
    xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric33_2(ns: [Int], ss: [Str]): Int {
    firstOr33_2<Int>(ns, 0) + firstOr33_2<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe33_2<C: Alloc>(ctx: C): Int {
    useGeneric33_2([1, 2], ["a"]) + describeAll33_2(ctx, [1, 2]).len()
}

