/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node11 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node11;

export fn seed11(): Int { 7110 }

/// Folds this module's seed together with its dependencies'.
export fn blend11(base: Int): Int {
  let d0 = blend7(base) + seed7();
  let d1 = blend10(base) + seed10();
  let d2 = blend9(base) + seed9();
  d0 + d1 + d2 + seed11()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift11(n: Node7): Node11 {
  Node11 { label: n.label, value: n.value + seed11(), weight: n.weight }
}

/// A body of 4 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute11_0(input: Int): Int {
  let a0 = input * 7 + 42;
  let a1 = a0 + 3;
  let a2 = a1 * 39;
  let a3 = a2 - 51;
  if (a3 > 5447) { a3 } else { a3 - 31 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe11_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute11_0(7)
}

/// An enum of 7 variants, matched exhaustively below.
export enum State11_1 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
  Step6(Int, Str),
}

derive Eq, Show for State11_1;

/// The match every enum in a real program has somewhere.
export fn rank11_1(state: State11_1): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
    .Step6(k, _) => k + 6,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start11_1(ticks: Int): State11_1 {
  if (ticks == 0) { .Idle } else if (ticks < 57) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe11_1<C: Alloc>(ctx: C): Int {
  let s = start11_1(5);
  rank11_1(s) + s.show(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr11_2<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll11_2<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric11_2(ns: [Int], ss: [Str]): Int {
  firstOr11_2<Int>(ns, 0) + firstOr11_2<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe11_2<C: Alloc>(ctx: C): Int {
  useGeneric11_2([1, 2], ["a"]) + describeAll11_2(ctx, [1, 2]).len()
}

