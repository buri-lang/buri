/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose11_6(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth11_6(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe11_6<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth11_6("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose11_6(.Some(3), .None) + extra
}

/// A record with 2 fields, derived comparisons and two methods.
export struct Rec11_7 {
  export f0: Int,
  export f1: Str,
}

derive Eq, Show for Rec11_7;

impl Rec11_7 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 119
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec11_7: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe11_7<C: Alloc>(ctx: C): Int {
  let r = Rec11_7 { f0: 7, f1: "probe" };
  r.scaled(3) + r.render(ctx).len()
}

