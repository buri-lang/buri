/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node18 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node18;

export fn seed18(): Int { 2543 }

/// Folds this module's seed together with its dependencies'.
export fn blend18(base: Int): Int {
  let d0 = blend12(base) + seed12();
  let d1 = blend13(base) + seed13();
  d0 + d1 + seed18()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift18(n: Node12): Node18 {
  Node18 { label: n.label, value: n.value + seed18(), weight: n.weight }
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose18_0(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth18_0(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe18_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth18_0("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose18_0(.Some(3), .None) + extra
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr18_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll18_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric18_1(ns: [Int], ss: [Str]): Int {
  firstOr18_1<Int>(ns, 0) + firstOr18_1<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe18_1<C: Alloc>(ctx: C): Int {
  useGeneric18_1([1, 2], ["a"]) + describeAll18_1(ctx, [1, 2]).len()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label18_2<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "bravo" } else { "foxtrot" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants18_2(): (Int, Int, Float, Char, Str) {
  (17462, 0xC1DB, 191.027, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe18_2<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants18_2();
  label18_2(ctx, a, e).len() + b
}

