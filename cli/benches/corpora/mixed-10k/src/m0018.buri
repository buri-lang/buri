}

/// An enum of 4 variants, matched exhaustively below.
export enum State18_8 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
}

derive Eq, Show for State18_8;

/// The match every enum in a real program has somewhere.
export fn rank18_8(state: State18_8): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start18_8(ticks: Int): State18_8 {
  if (ticks == 0) { .Idle } else if (ticks < 45) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe18_8<C: Alloc>(ctx: C): Int {
  let s = start18_8(5);
  rank18_8(s) + s.show(ctx).len()
}

