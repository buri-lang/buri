/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach32<C: Alloc>(ctx: C): Int {
  0
    + probe32_0(ctx)
    + probe32_1(ctx)
    + probe32_2(ctx)
    + probe32_3(ctx)
    + probe32_4(ctx)
    + probe32_5(ctx)
    + probe32_6(ctx)
    + probe32_7(ctx)
    + probe32_8(ctx)
    + reach30(ctx)
    + reach3(ctx)
}
