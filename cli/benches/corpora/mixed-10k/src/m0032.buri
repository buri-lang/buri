/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr32_4<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll32_4<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric32_4(ns: [Int], ss: [Str]): Int {
  firstOr32_4<Int>(ns, 0) + firstOr32_4<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe32_4<C: Alloc>(ctx: C): Int {
  useGeneric32_4([1, 2], ["a"]) + describeAll32_4(ctx, [1, 2]).len()
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose32_5(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth32_5(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe32_5<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth32_5("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose32_5(.Some(3), .None) + extra
}

