//! Generated module 32 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0030" import { Node30, seed30, blend30, reach30 };
from "//bench/m0003" import { Node3, seed3, blend3, reach3 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node32 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node32;

export fn seed32(): Int { 3409 }

/// Folds this module's seed together with its dependencies'.
export fn blend32(base: Int): Int {
  let d0 = blend30(base) + seed30();
  let d1 = blend3(base) + seed3();
  d0 + d1 + seed32()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift32(n: Node30): Node32 {
  Node32 { label: n.label, value: n.value + seed32(), weight: n.weight }
}

/// A body of 8 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute32_0(input: Int): Int {
  let a0 = input * 2 + 403;
  let a1 = a0 - 2;
  let a2 = a1 * 35;
  let a3 = a2 - 92;
  let a4 = a3 - 35;
  let a5 = a4 - 5;
  let a6 = a5 + 17;
  let a7 = a6 - 9;
  if (a7 > 6555) { a7 } else { a7 - 82 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe32_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute32_0(7)
}

/// An enum of 4 variants, matched exhaustively below.
export enum State32_1 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
}

derive Eq, Show for State32_1;

/// The match every enum in a real program has somewhere.
export fn rank32_1(state: State32_1): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start32_1(ticks: Int): State32_1 {
  if (ticks == 0) { .Idle } else if (ticks < 90) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe32_1<C: Alloc>(ctx: C): Int {
  let s = start32_1(5);
  rank32_1(s) + s.show(ctx).len()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label32_2<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "golf" } else { "alpha" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants32_2(): (Int, Int, Float, Char, Str) {
  (788145, 0xCFC6, 724.879, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe32_2<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants32_2();
  label32_2(ctx, a, e).len() + b
}

