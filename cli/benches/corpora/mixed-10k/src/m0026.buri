/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node26 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node26;

export fn seed26(): Int { 5895 }

/// Folds this module's seed together with its dependencies'.
export fn blend26(base: Int): Int {
  let d0 = blend25(base) + seed25();
  let d1 = blend12(base) + seed12();
  let d2 = blend5(base) + seed5();
  d0 + d1 + d2 + seed26()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift26(n: Node25): Node26 {
  Node26 { label: n.label, value: n.value + seed26(), weight: n.weight }
}

/// A body of 9 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute26_0(input: Int): Int {
  let a0 = input * 2 + 559;
  let a1 = a0 - 53;
  let a2 = a1 * 38;
  let a3 = a2 - 51;
  let a4 = a3 - 10;
  let a5 = a4 * 1;
  let a6 = a5 + 64;
  let a7 = a6 * 26;
  let a8 = a7 * 40;
  if (a8 > 1702) { a8 } else { a8 - 10 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe26_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute26_0(7)
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose26_1(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth26_1(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe26_1<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth26_1("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose26_1(.Some(3), .None) + extra
}

/// A record with 3 fields, derived comparisons and two methods.
export struct Rec26_2 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
}

derive Eq, Show for Rec26_2;

impl Rec26_2 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self: Rec26_2, factor: Int): Int {
    self.f0 * factor + 756
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self: Rec26_2, ctx: C): Str {
    str.format(ctx, "rec26_2: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe26_2<C: Alloc>(ctx: C): Int {
  let r = Rec26_2 { f0: 7, f1: "probe", f2: 1.5 };
  r.scaled(3) + r.render(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr26_3<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll26_3<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric26_3(ns: [Int], ss: [Str]): Int {
  firstOr26_3<Int>(ns, 0) + firstOr26_3<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe26_3<C: Alloc>(ctx: C): Int {
  useGeneric26_3([1, 2], ["a"]) + describeAll26_3(ctx, [1, 2]).len()
}

