/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node29 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node29;

export fn seed29(): Int { 9652 }

/// Folds this module's seed together with its dependencies'.
export fn blend29(base: Int): Int {
  let d0 = blend23(base) + seed23();
  let d1 = blend14(base) + seed14();
  let d2 = blend27(base) + seed27();
  d0 + d1 + d2 + seed29()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift29(n: Node23): Node29 {
  Node29 { label: n.label, value: n.value + seed29(), weight: n.weight }
}

/// A body of 7 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute29_0(input: Int): Int {
  let a0 = input * 3 + 188;
  let a1 = a0 * 69;
  let a2 = a1 * 74;
  let a3 = a2 - 52;
  let a4 = a3 + 45;
  let a5 = a4 - 48;
  let a6 = a5 - 11;
  if (a6 > 8584) { a6 } else { a6 - 14 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe29_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute29_0(7)
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose29_1(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth29_1(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe29_1<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth29_1("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose29_1(.Some(3), .None) + extra
}

/// A record with 5 fields, derived comparisons and two methods.
