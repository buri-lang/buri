  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 357
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec29_2: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe29_2<C: Alloc>(ctx: C): Int {
  let r = Rec29_2 { f0: 7, f1: "probe", f2: 1.5, f3: true, f4: 7 };
  r.scaled(3) + r.render(ctx).len()
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest29_3<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [8326, 2497, 1820, 3308, 2187, 4833, 9815, 8798, 771, 7880];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain29_3(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe29_3<C: Alloc>(ctx: C): Int {
  digest29_3(ctx) + drain29_3()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr29_4<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll29_4<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric29_4(ns: [Int], ss: [Str]): Int {
  firstOr29_4<Int>(ns, 0) + firstOr29_4<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe29_4<C: Alloc>(ctx: C): Int {
  useGeneric29_4([1, 2], ["a"]) + describeAll29_4(ctx, [1, 2]).len()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label29_5<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "golf" } else { "echo" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants29_5(): (Int, Int, Float, Char, Str) {
  (616145, 0x4593, 117.588, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe29_5<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants29_5();
  label29_5(ctx, a, e).len() + b
}

