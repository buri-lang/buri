derive Eq, Show for Rec8_9;
/// A record with 5 fields, derived comparisons and two methods.
export struct Rec8_9 {
    export f0: Int,
    export f1: Str,
    export f2: Float,
    export f3: Bool,
    export f4: Int,
}

impl Rec8_9 {
    /// A pure accessor, of the kind that is most of a real impl block.
    export fn scaled(self, factor: Int): Int {
        self.f0 * factor + 876
    }

    /// Allocates, and says so with `C: Alloc`.
    export fn render<C: Alloc>(self, ctx: C): Str {
        str.format(ctx, "rec8_9: ${self.f0}/${self.f1}")
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe8_9<C: Alloc>(ctx: C): Int {
    let r = Rec8_9 { f0: 7, f1: "probe", f2: 1.5, f3: true, f4: 7 };
    r.scaled(3) + r.render(ctx).len()
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach8<C: Alloc>(ctx: C): Int {
    0
        + probe8_0(ctx)
        + probe8_1(ctx)
        + probe8_2(ctx)
        + probe8_3(ctx)
        + probe8_4(ctx)
        + probe8_5(ctx)
        + probe8_6(ctx)
        + probe8_7(ctx)
        + probe8_8(ctx)
        + probe8_9(ctx)
        + reach5(ctx)
}
