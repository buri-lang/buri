derive Eq, Show for Node8;
/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node8 {
    export label: Str,
    export value: Int,
    export weight: Float,
}

export fn seed8(): Int {
    3353
}

/// Folds this module's seed together with its dependencies'.
export fn blend8(base: Int): Int {
    let d0 = blend5(base) + seed5();
    d0 + seed8()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift8(n: Node5): Node8 {
    Node8 { label: n.label, value: n.value + seed8(), weight: n.weight }
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label8_0<C: Alloc>(ctx: C, id: Int, name: Str): Str {
    let prefix = if (id < 0) { "golf" } else { "delta" };
    let body = str.format(ctx, "${prefix}-${name}-${id}");
    body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants8_0(): (Int, Int, Float, Char, Str) {
    (754364, 0x6069, 272.731, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe8_0<C: Alloc>(ctx: C): Int {
    let (a, b, _, _, e) = constants8_0();
    label8_0(ctx, a, e).len() + b
}

derive Eq, Show for State8_1;
/// An enum of 4 variants, matched exhaustively below.
export enum State8_1 {
    Idle,
    Running(Int),
    Failed { code: Int, message: Str },
    Step3(Int, Str),
}

/// The match every enum in a real program has somewhere.
export fn rank8_1(state: State8_1): Int {
    match (state) {
        .Idle => 0,
        .Running(ticks) => ticks + 1,
        .Failed { code, .. } => code * -1,
        .Step3(k, _) => k + 3,
    }
}

/// Construction, so the variants are reachable from a root.
export fn start8_1(ticks: Int): State8_1 {
    if (ticks == 0) {
        .Idle
    } else if (ticks < 44) {
        .Running(ticks)
    } else {
        .Failed { code: ticks, message: "overrun" }
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe8_1<C: Alloc>(ctx: C): Int {
    let s = start8_1(5);
    rank8_1(s) + s.show(ctx).len()
}

