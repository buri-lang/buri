/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach34<C: Alloc>(ctx: C): Int {
  0
    + probe34_0(ctx)
    + probe34_1(ctx)
    + probe34_2(ctx)
    + probe34_3(ctx)
    + probe34_4(ctx)
    + probe34_5(ctx)
    + probe34_6(ctx)
    + probe34_7(ctx)
    + probe34_8(ctx)
    + probe34_9(ctx)
    + probe34_10(ctx)
    + probe34_11(ctx)
    + reach16(ctx)
    + reach15(ctx)
}
