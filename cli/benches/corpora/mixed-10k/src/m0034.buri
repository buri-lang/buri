//! Generated module 34 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/cap" import { Alloc };
from "//bench/m0016" import { Node16, seed16, blend16, reach16 };
from "//bench/m0015" import { Node15, seed15, blend15, reach15 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node34 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node34;

export fn seed34(): Int { 9247 }

/// Folds this module's seed together with its dependencies'.
export fn blend34(base: Int): Int {
  let d0 = blend16(base) + seed16();
  let d1 = blend15(base) + seed15();
  d0 + d1 + seed34()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift34(n: Node16): Node34 {
  Node34 { label: n.label, value: n.value + seed34(), weight: n.weight }
}

/// A body of 6 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute34_0(input: Int): Int {
  let a0 = input * 5 + 823;
  let a1 = a0 * 69;
  let a2 = a1 * 42;
  let a3 = a2 + 75;
  let a4 = a3 - 83;
  let a5 = a4 - 59;
  if (a5 > 4811) { a5 } else { a5 - 14 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe34_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute34_0(7)
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label34_1<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "charlie" } else { "hotel" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants34_1(): (Int, Int, Float, Char, Str) {
  (309293, 0x3116, 442.774, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe34_1<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants34_1();
  label34_1(ctx, a, e).len() + b
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr34_2<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll34_2<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric34_2(ns: [Int], ss: [Str]): Int {
  firstOr34_2<Int>(ns, 0) + firstOr34_2<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe34_2<C: Alloc>(ctx: C): Int {
  useGeneric34_2([1, 2], ["a"]) + describeAll34_2(ctx, [1, 2]).len()
}

/// A record with 2 fields, derived comparisons and two methods.
export struct Rec34_3 {
  export f0: Int,
  export f1: Str,
}

derive Eq, Show for Rec34_3;

impl Rec34_3 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self: Rec34_3, factor: Int): Int {
    self.f0 * factor + 674
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self: Rec34_3, ctx: C): Str {
    str.format(ctx, "rec34_3: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe34_3<C: Alloc>(ctx: C): Int {
  let r = Rec34_3 { f0: 7, f1: "probe" };
  r.scaled(3) + r.render(ctx).len()
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose34_4(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth34_4(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe34_4<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth34_4("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose34_4(.Some(3), .None) + extra
}

