/// An enum of 6 variants, matched exhaustively below.
export enum State34_10 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
  export Step4(Int, Str),
  export Step5(Int, Str),
}

derive Eq, Show for State34_10;

/// The match every enum in a real program has somewhere.
export fn rank34_10(state: State34_10): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start34_10(ticks: Int): State34_10 {
  if (ticks == 0) { .Idle } else if (ticks < 34) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe34_10<C: Alloc>(ctx: C): Int {
  let s = start34_10(5);
  rank34_10(s) + s.show(ctx).len()
}

