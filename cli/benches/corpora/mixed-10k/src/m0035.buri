/// Reaches everything above from one call. See `reach` below.
export fn probe35_7<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth35_7("1", "2")) {
    .Some(v) => v,
    .None => 0,
