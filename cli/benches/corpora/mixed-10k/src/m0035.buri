//! Generated module 35 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0026.buri" import { Node26, seed26, blend26, reach26 };
from "//bench/m0016.buri" import { Node16, seed16, blend16, reach16 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node35 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node35;

export fn seed35(): Int { 7166 }

/// Folds this module's seed together with its dependencies'.
export fn blend35(base: Int): Int {
  let d0 = blend26(base) + seed26();
  let d1 = blend16(base) + seed16();
  d0 + d1 + seed35()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift35(n: Node26): Node35 {
  Node35 { label: n.label, value: n.value + seed35(), weight: n.weight }
}

/// A body of 5 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute35_0(input: Int): Int {
  let a0 = input * 2 + 931;
  let a1 = a0 - 59;
  let a2 = a1 + 79;
  let a3 = a2 + 53;
  let a4 = a3 - 24;
  if (a4 > 3434) { a4 } else { a4 - 50 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute35_0(7)
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr35_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll35_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric35_1(ns: [Int], ss: [Str]): Int {
  firstOr35_1<Int>(ns, 0) + firstOr35_1<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_1<C: Alloc>(ctx: C): Int {
  useGeneric35_1([1, 2], ["a"]) + describeAll35_1(ctx, [1, 2]).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr35_2<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll35_2<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric35_2(ns: [Int], ss: [Str]): Int {
  firstOr35_2<Int>(ns, 0) + firstOr35_2<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_2<C: Alloc>(ctx: C): Int {
  useGeneric35_2([1, 2], ["a"]) + describeAll35_2(ctx, [1, 2]).len()
}

/// An enum of 4 variants, matched exhaustively below.
export enum State35_3 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
}

derive Eq, Show for State35_3;

/// The match every enum in a real program has somewhere.
export fn rank35_3(state: State35_3): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start35_3(ticks: Int): State35_3 {
  if (ticks == 0) { .Idle } else if (ticks < 22) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_3<C: Alloc>(ctx: C): Int {
  let s = start35_3(5);
  rank35_3(s) + s.show(ctx).len()
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose35_4(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth35_4(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_4<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth35_4("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose35_4(.Some(3), .None) + extra
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest35_5<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [6790, 3917, 4028, 1565, 2905, 2002, 5138, 1997, 4360, 2789];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain35_5(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_5<C: Alloc>(ctx: C): Int {
  digest35_5(ctx) + drain35_5()
}

/// A record with 3 fields, derived comparisons and two methods.
export struct Rec35_6 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
}

derive Eq, Show for Rec35_6;

impl Rec35_6 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 444
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec35_6: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe35_6<C: Alloc>(ctx: C): Int {
  let r = Rec35_6 { f0: 7, f1: "probe", f2: 1.5 };
  r.scaled(3) + r.render(ctx).len()
}

/// Nested matching over `Option` and a tuple, with a guard — the
