/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach35<C: Alloc>(ctx: C): Int {
  0
    + probe35_0(ctx)
    + probe35_1(ctx)
    + probe35_2(ctx)
    + probe35_3(ctx)
    + probe35_4(ctx)
    + probe35_5(ctx)
    + probe35_6(ctx)
    + probe35_7(ctx)
    + probe35_8(ctx)
    + probe35_9(ctx)
    + probe35_10(ctx)
    + reach26(ctx)
    + reach16(ctx)
}
