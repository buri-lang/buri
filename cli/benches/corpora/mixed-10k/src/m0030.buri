/// An enum of 5 variants, matched exhaustively below.
export enum State30_7 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
}

derive Eq, Show for State30_7;

/// The match every enum in a real program has somewhere.
export fn rank30_7(state: State30_7): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start30_7(ticks: Int): State30_7 {
  if (ticks == 0) { .Idle } else if (ticks < 67) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe30_7<C: Alloc>(ctx: C): Int {
  let s = start30_7(5);
  rank30_7(s) + s.show(ctx).len()
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest30_8<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [9826, 7379, 7118, 7122, 3586, 667, 4622];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain30_8(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe30_8<C: Alloc>(ctx: C): Int {
  digest30_8(ctx) + drain30_8()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label30_9<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "hotel" } else { "hotel" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants30_9(): (Int, Int, Float, Char, Str) {
  (2513, 0x5934, 475.546, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe30_9<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants30_9();
  label30_9(ctx, a, e).len() + b
}

