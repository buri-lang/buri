/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node30 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node30;

export fn seed30(): Int { 7571 }

/// Folds this module's seed together with its dependencies'.
export fn blend30(base: Int): Int {
  let d0 = blend1(base) + seed1();
  d0 + seed30()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift30(n: Node1): Node30 {
  Node30 { label: n.label, value: n.value + seed30(), weight: n.weight }
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr30_0<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll30_0<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric30_0(ns: [Int], ss: [Str]): Int {
  firstOr30_0<Int>(ns, 0) + firstOr30_0<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe30_0<C: Alloc>(ctx: C): Int {
  useGeneric30_0([1, 2], ["a"]) + describeAll30_0(ctx, [1, 2]).len()
}

