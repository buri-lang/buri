/// An enum of 6 variants, matched exhaustively below.
export enum State13_6 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
}

derive Eq, Show for State13_6;

/// The match every enum in a real program has somewhere.
export fn rank13_6(state: State13_6): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start13_6(ticks: Int): State13_6 {
  if (ticks == 0) { .Idle } else if (ticks < 33) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe13_6<C: Alloc>(ctx: C): Int {
  let s = start13_6(5);
  rank13_6(s) + s.show(ctx).len()
}

