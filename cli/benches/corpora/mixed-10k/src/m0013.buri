export fn seed13(): Int { 2948 }

/// Folds this module's seed together with its dependencies'.
export fn blend13(base: Int): Int {
  let d0 = blend8(base) + seed8();
  d0 + seed13()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift13(n: Node8): Node13 {
  Node13 { label: n.label, value: n.value + seed13(), weight: n.weight }
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose13_0(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth13_0(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe13_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth13_0("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose13_0(.Some(3), .None) + extra
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label13_1<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "echo" } else { "delta" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants13_1(): (Int, Int, Float, Char, Str) {
  (99077, 0x5BB7, 678.484, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe13_1<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants13_1();
  label13_1(ctx, a, e).len() + b
}

