/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node19 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node19;

export fn seed19(): Int { 462 }

/// Folds this module's seed together with its dependencies'.
export fn blend19(base: Int): Int {
  let d0 = blend11(base) + seed11();
  let d1 = blend14(base) + seed14();
  let d2 = blend6(base) + seed6();
  d0 + d1 + d2 + seed19()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift19(n: Node11): Node19 {
  Node19 { label: n.label, value: n.value + seed19(), weight: n.weight }
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose19_0(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth19_0(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe19_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth19_0("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose19_0(.Some(3), .None) + extra
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr19_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll19_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric19_1(ns: [Int], ss: [Str]): Int {
  firstOr19_1<Int>(ns, 0) + firstOr19_1<Str>(ss, "").len()
}

