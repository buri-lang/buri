/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node5 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node5;

export fn seed5(): Int { 9596 }

/// Folds this module's seed together with its dependencies'.
export fn blend5(base: Int): Int {
  let d0 = blend4(base) + seed4();
  let d1 = blend0(base) + seed0();
  let d2 = blend1(base) + seed1();
  d0 + d1 + d2 + seed5()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift5(n: Node4): Node5 {
  Node5 { label: n.label, value: n.value + seed5(), weight: n.weight }
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose5_0(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth5_0(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe5_0<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth5_0("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose5_0(.Some(3), .None) + extra
}

/// A body of 4 bindings over integer arithmetic — the shape most
