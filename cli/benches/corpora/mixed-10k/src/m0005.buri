/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label5_4<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "charlie" } else { "charlie" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants5_4(): (Int, Int, Float, Char, Str) {
  (398013, 0xEEF6, 828.872, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe5_4<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants5_4();
  label5_4(ctx, a, e).len() + b
}

/// A record with 4 fields, derived comparisons and two methods.
export struct Rec5_5 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
  export f3: Bool,
}

derive Eq, Show for Rec5_5;

impl Rec5_5 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self, factor: Int): Int {
    self.f0 * factor + 278
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self, ctx: C): Str {
    str.format(ctx, "rec5_5: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe5_5<C: Alloc>(ctx: C): Int {
  let r = Rec5_5 { f0: 7, f1: "probe", f2: 1.5, f3: true };
  r.scaled(3) + r.render(ctx).len()
}

