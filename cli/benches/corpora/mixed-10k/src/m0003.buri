/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr3_9<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll3_9<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric3_9(ns: [Int], ss: [Str]): Int {
  firstOr3_9<Int>(ns, 0) + firstOr3_9<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_9<C: Alloc>(ctx: C): Int {
  useGeneric3_9([1, 2], ["a"]) + describeAll3_9(ctx, [1, 2]).len()
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach3<C: Alloc>(ctx: C): Int {
  0
    + probe3_0(ctx)
    + probe3_1(ctx)
    + probe3_2(ctx)
    + probe3_3(ctx)
    + probe3_4(ctx)
    + probe3_5(ctx)
    + probe3_6(ctx)
    + probe3_7(ctx)
    + probe3_8(ctx)
    + probe3_9(ctx)
    + reach2(ctx)
    + reach1(ctx)
}
