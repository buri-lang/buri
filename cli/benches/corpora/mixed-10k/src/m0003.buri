//! Generated module 3 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/cap" import { Alloc };
from "//bench/m0002" import { Node2, seed2, blend2, reach2 };
from "//bench/m0001" import { Node1, seed1, blend1, reach1 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node3 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node3;

export fn seed3(): Int { 3758 }

/// Folds this module's seed together with its dependencies'.
export fn blend3(base: Int): Int {
  let d0 = blend2(base) + seed2();
  let d1 = blend1(base) + seed1();
  d0 + d1 + seed3()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift3(n: Node2): Node3 {
  Node3 { label: n.label, value: n.value + seed3(), weight: n.weight }
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label3_0<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "hotel" } else { "hotel" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants3_0(): (Int, Int, Float, Char, Str) {
  (603484, 0xAA59, 391.006, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_0<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants3_0();
  label3_0(ctx, a, e).len() + b
}

/// An enum of 4 variants, matched exhaustively below.
export enum State3_1 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
}

derive Eq, Show for State3_1;

/// The match every enum in a real program has somewhere.
export fn rank3_1(state: State3_1): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start3_1(ticks: Int): State3_1 {
  if (ticks == 0) { .Idle } else if (ticks < 27) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_1<C: Alloc>(ctx: C): Int {
  let s = start3_1(5);
  rank3_1(s) + s.show(ctx).len()
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest3_2<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [574, 8858, 2620, 1855];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain3_2(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_2<C: Alloc>(ctx: C): Int {
  digest3_2(ctx) + drain3_2()
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose3_3(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth3_3(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_3<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth3_3("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose3_3(.Some(3), .None) + extra
}

