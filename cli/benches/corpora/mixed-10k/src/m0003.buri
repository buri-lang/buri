/// A record with 4 fields, derived comparisons and two methods.
export struct Rec3_5 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
  export f3: Bool,
}

derive Eq, Show for Rec3_5;

impl Rec3_5 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self: Rec3_5, factor: Int): Int {
    self.f0 * factor + 548
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self: Rec3_5, ctx: C): Str {
    str.format(ctx, "rec3_5: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_5<C: Alloc>(ctx: C): Int {
  let r = Rec3_5 { f0: 7, f1: "probe", f2: 1.5, f3: true };
  r.scaled(3) + r.render(ctx).len()
}

