  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
  Step6(Int, Str),
}

derive Eq, Show for State4_5;

/// The match every enum in a real program has somewhere.
export fn rank4_5(state: State4_5): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
    .Step6(k, _) => k + 6,
  }
}

