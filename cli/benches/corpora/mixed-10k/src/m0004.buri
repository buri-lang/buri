/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach4<C: Alloc>(ctx: C): Int {
  0
    + probe4_0(ctx)
    + probe4_1(ctx)
    + probe4_2(ctx)
    + probe4_3(ctx)
    + probe4_4(ctx)
    + probe4_5(ctx)
    + probe4_6(ctx)
    + probe4_7(ctx)
    + probe4_8(ctx)
    + probe4_9(ctx)
    + probe4_10(ctx)
    + reach2(ctx)
}
