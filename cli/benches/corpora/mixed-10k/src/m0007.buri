derive Eq, Show for Node7;
/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node7 {
    export label: Str,
    export value: Int,
    export weight: Float,
}

export fn seed7(): Int {
    5434
}

/// Folds this module's seed together with its dependencies'.
export fn blend7(base: Int): Int {
    let d0 = blend4(base) + seed4();
    d0 + seed7()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift7(n: Node4): Node7 {
    Node7 { label: n.label, value: n.value + seed7(), weight: n.weight }
}

/// A body of 6 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute7_0(input: Int): Int {
    let a0 = input * 9 + 367;
    let a1 = a0 * 39;
    let a2 = a1 + 40;
    let a3 = a2 - 52;
    let a4 = a3 - 75;
    let a5 = a4 * 77;
    if (a5 > 4817) { a5 } else { a5 - 66 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe7_0<C: Alloc>(ctx: C): Int {
    let _ = ctx;
    compute7_0(7)
}

