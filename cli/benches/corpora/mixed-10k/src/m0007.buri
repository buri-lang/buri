export fn label7_2<C: Alloc>(ctx: C, id: Int, name: Str): Str {
    let prefix = if (id < 0) { "foxtrot" } else { "alpha" };
    let body = str.format(ctx, "${prefix}-${name}-${id}");
    body.toUpper(ctx)
}

