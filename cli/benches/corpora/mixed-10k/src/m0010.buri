//! Generated module 10 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/effect" import { Alloc };
from "//bench/m0006" import { Node6, seed6, blend6, reach6 };
from "//bench/m0000" import { Node0, seed0, blend0, reach0 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node10 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node10;

export fn seed10(): Int { 9191 }

/// Folds this module's seed together with its dependencies'.
export fn blend10(base: Int): Int {
  let d0 = blend6(base) + seed6();
  let d1 = blend0(base) + seed0();
  d0 + d1 + seed10()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift10(n: Node6): Node10 {
  Node10 { label: n.label, value: n.value + seed10(), weight: n.weight }
}

/// An enum of 4 variants, matched exhaustively below.
export enum State10_0 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
}

derive Eq, Show for State10_0;

/// The match every enum in a real program has somewhere.
export fn rank10_0(state: State10_0): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start10_0(ticks: Int): State10_0 {
  if (ticks == 0) { .Idle } else if (ticks < 53) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe10_0<C: Alloc>(ctx: C): Int {
  let s = start10_0(5);
  rank10_0(s) + s.show(ctx).len()
}

/// A record with 2 fields, derived comparisons and two methods.
export struct Rec10_1 {
