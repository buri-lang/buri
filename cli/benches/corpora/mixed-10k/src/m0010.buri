/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose10_9(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth10_9(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe10_9<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth10_9("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose10_9(.Some(3), .None) + extra
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach10<C: Alloc>(ctx: C): Int {
  0
    + probe10_0(ctx)
    + probe10_1(ctx)
    + probe10_2(ctx)
    + probe10_3(ctx)
    + probe10_4(ctx)
    + probe10_5(ctx)
    + probe10_6(ctx)
    + probe10_7(ctx)
    + probe10_8(ctx)
    + probe10_9(ctx)
    + reach6(ctx)
    + reach0(ctx)
}
