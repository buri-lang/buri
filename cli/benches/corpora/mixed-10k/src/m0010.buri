/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr10_4<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll10_4<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric10_4(ns: [Int], ss: [Str]): Int {
  firstOr10_4<Int>(ns, 0) + firstOr10_4<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe10_4<C: Alloc>(ctx: C): Int {
  useGeneric10_4([1, 2], ["a"]) + describeAll10_4(ctx, [1, 2]).len()
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest10_5<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [7648, 9922, 1705, 293, 286, 9178];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain10_5(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe10_5<C: Alloc>(ctx: C): Int {
  digest10_5(ctx) + drain10_5()
}

/// A body of 9 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute10_6(input: Int): Int {
  let a0 = input * 5 + 605;
  let a1 = a0 * 63;
  let a2 = a1 + 7;
  let a3 = a2 + 35;
  let a4 = a3 - 54;
  let a5 = a4 * 27;
  let a6 = a5 - 38;
  let a7 = a6 - 31;
  let a8 = a7 + 94;
  if (a8 > 8153) { a8 } else { a8 - 34 }
}

