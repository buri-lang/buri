/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node9 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node9;

export fn seed9(): Int { 1272 }

/// Folds this module's seed together with its dependencies'.
export fn blend9(base: Int): Int {
  let d0 = blend8(base) + seed8();
  let d1 = blend2(base) + seed2();
  let d2 = blend0(base) + seed0();
  d0 + d1 + d2 + seed9()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift9(n: Node8): Node9 {
  Node9 { label: n.label, value: n.value + seed9(), weight: n.weight }
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label9_0<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "alpha" } else { "echo" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants9_0(): (Int, Int, Float, Char, Str) {
  (258516, 0xDCFA, 723.105, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe9_0<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants9_0();
  label9_0(ctx, a, e).len() + b
}

