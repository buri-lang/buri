/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose9_2(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth9_2(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe9_2<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth9_2("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose9_2(.Some(3), .None) + extra
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest9_3<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [9536, 8707, 7480, 1266, 5100, 4049, 4910];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain9_3(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe9_3<C: Alloc>(ctx: C): Int {
  digest9_3(ctx) + drain9_3()
}

/// An enum of 3 variants, matched exhaustively below.
export enum State9_4 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
}

derive Eq, Show for State9_4;

/// The match every enum in a real program has somewhere.
export fn rank9_4(state: State9_4): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start9_4(ticks: Int): State9_4 {
  if (ticks == 0) { .Idle } else if (ticks < 60) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe9_4<C: Alloc>(ctx: C): Int {
  let s = start9_4(5);
  rank9_4(s) + s.show(ctx).len()
}

