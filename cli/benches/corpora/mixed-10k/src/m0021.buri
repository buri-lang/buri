//! Generated module 21 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str/lib.buri" import * as str;
from "core/list/lib.buri" import * as list;
from "core/effect/lib.buri" import { Alloc };
from "//bench/m0016.buri" import { Node16, seed16, blend16, reach16 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node21 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node21;

export fn seed21(): Int { 6300 }

/// Folds this module's seed together with its dependencies'.
export fn blend21(base: Int): Int {
  let d0 = blend16(base) + seed16();
  d0 + seed21()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift21(n: Node16): Node21 {
  Node21 { label: n.label, value: n.value + seed21(), weight: n.weight }
}

/// An enum of 7 variants, matched exhaustively below.
export enum State21_0 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
  Step6(Int, Str),
}

derive Eq, Show for State21_0;

/// The match every enum in a real program has somewhere.
export fn rank21_0(state: State21_0): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
    .Step6(k, _) => k + 6,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start21_0(ticks: Int): State21_0 {
  if (ticks == 0) { .Idle } else if (ticks < 67) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe21_0<C: Alloc>(ctx: C): Int {
  let s = start21_0(5);
  rank21_0(s) + s.show(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr21_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll21_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric21_1(ns: [Int], ss: [Str]): Int {
  firstOr21_1<Int>(ns, 0) + firstOr21_1<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe21_1<C: Alloc>(ctx: C): Int {
  useGeneric21_1([1, 2], ["a"]) + describeAll21_1(ctx, [1, 2]).len()
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose21_2(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth21_2(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe21_2<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth21_2("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose21_2(.Some(3), .None) + extra
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label21_3<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "foxtrot" } else { "bravo" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants21_3(): (Int, Int, Float, Char, Str) {
  (419054, 0xEAD2, 490.345, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe21_3<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants21_3();
  label21_3(ctx, a, e).len() + b
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest21_4<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [1369, 8272, 4205, 6661, 6600, 9595, 9959];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain21_4(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe21_4<C: Alloc>(ctx: C): Int {
  digest21_4(ctx) + drain21_4()
}

