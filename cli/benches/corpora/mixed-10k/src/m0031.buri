derive Eq, Show for State31_3;
/// An enum of 6 variants, matched exhaustively below.
export enum State31_3 {
    Idle,
    Running(Int),
    Failed { code: Int, message: Str },
    Step3(Int, Str),
    Step4(Int, Str),
    Step5(Int, Str),
}

/// The match every enum in a real program has somewhere.
export fn rank31_3(state: State31_3): Int {
    match (state) {
        .Idle => 0,
        .Running(ticks) => ticks + 1,
        .Failed { code, .. } => code * -1,
        .Step3(k, _) => k + 3,
        .Step4(k, _) => k + 4,
        .Step5(k, _) => k + 5,
    }
}

/// Construction, so the variants are reachable from a root.
export fn start31_3(ticks: Int): State31_3 {
    if (ticks == 0) {
        .Idle
    } else if (ticks < 93) {
        .Running(ticks)
    } else {
        .Failed { code: ticks, message: "overrun" }
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe31_3<C: Alloc>(ctx: C): Int {
    let s = start31_3(5);
    rank31_3(s) + s.show(ctx).len()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label31_4<C: Alloc>(ctx: C, id: Int, name: Str): Str {
    let prefix = if (id < 0) { "charlie" } else { "delta" };
    let body = str.format(ctx, "${prefix}-${name}-${id}");
    body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants31_4(): (Int, Int, Float, Char, Str) {
    (935965, 0x755C, 553.165, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe31_4<C: Alloc>(ctx: C): Int {
    let (a, b, _, _, e) = constants31_4();
    label31_4(ctx, a, e).len() + b
}

