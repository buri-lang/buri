/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest28_7<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [2718, 4987, 1095, 1795, 7047, 7440, 401, 2828, 436, 4994];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain28_7(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe28_7<C: Alloc>(ctx: C): Int {
  digest28_7(ctx) + drain28_7()
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label28_8<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "charlie" } else { "alpha" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants28_8(): (Int, Int, Float, Char, Str) {
  (38127, 0x015B, 772.527, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe28_8<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants28_8();
  label28_8(ctx, a, e).len() + b
}

/// A body of 4 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute28_9(input: Int): Int {
  let a0 = input * 4 + 562;
  let a1 = a0 * 9;
  let a2 = a1 * 36;
  let a3 = a2 + 15;
  if (a3 > 5547) { a3 } else { a3 - 3 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe28_9<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute28_9(7)
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach28<C: Alloc>(ctx: C): Int {
  0
    + probe28_0(ctx)
    + probe28_1(ctx)
    + probe28_2(ctx)
    + probe28_3(ctx)
    + probe28_4(ctx)
    + probe28_5(ctx)
    + probe28_6(ctx)
    + probe28_7(ctx)
    + probe28_8(ctx)
    + probe28_9(ctx)
    + reach27(ctx)
    + reach19(ctx)
    + reach22(ctx)
}
