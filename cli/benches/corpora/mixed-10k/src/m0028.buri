/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node28 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node28;

export fn seed28(): Int { 1733 }

/// Folds this module's seed together with its dependencies'.
export fn blend28(base: Int): Int {
  let d0 = blend27(base) + seed27();
  let d1 = blend19(base) + seed19();
  let d2 = blend22(base) + seed22();
  d0 + d1 + d2 + seed28()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift28(n: Node27): Node28 {
  Node28 { label: n.label, value: n.value + seed28(), weight: n.weight }
}

/// An enum of 6 variants, matched exhaustively below.
export enum State28_0 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
}

derive Eq, Show for State28_0;

/// The match every enum in a real program has somewhere.
export fn rank28_0(state: State28_0): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start28_0(ticks: Int): State28_0 {
  if (ticks == 0) { .Idle } else if (ticks < 89) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe28_0<C: Alloc>(ctx: C): Int {
  let s = start28_0(5);
  rank28_0(s) + s.show(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr28_1<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll28_1<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric28_1(ns: [Int], ss: [Str]): Int {
  firstOr28_1<Int>(ns, 0) + firstOr28_1<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe28_1<C: Alloc>(ctx: C): Int {
  useGeneric28_1([1, 2], ["a"]) + describeAll28_1(ctx, [1, 2]).len()
}

