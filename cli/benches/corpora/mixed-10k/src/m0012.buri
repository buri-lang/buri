/// An enum of 6 variants, matched exhaustively below.
export enum State12_10 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
  Step5(Int, Str),
}

derive Eq, Show for State12_10;

/// The match every enum in a real program has somewhere.
export fn rank12_10(state: State12_10): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
    .Step5(k, _) => k + 5,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start12_10(ticks: Int): State12_10 {
  if (ticks == 0) { .Idle } else if (ticks < 31) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe12_10<C: Alloc>(ctx: C): Int {
  let s = start12_10(5);
  rank12_10(s) + s.show(ctx).len()
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach12<C: Alloc>(ctx: C): Int {
  0
    + probe12_0(ctx)
    + probe12_1(ctx)
    + probe12_2(ctx)
    + probe12_3(ctx)
    + probe12_4(ctx)
    + probe12_5(ctx)
    + probe12_6(ctx)
    + probe12_7(ctx)
    + probe12_8(ctx)
    + probe12_9(ctx)
    + probe12_10(ctx)
    + reach3(ctx)
    + reach7(ctx)
    + reach5(ctx)
}
