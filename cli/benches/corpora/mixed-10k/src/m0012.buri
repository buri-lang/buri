/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node12 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node12;

export fn seed12(): Int { 5029 }

/// Folds this module's seed together with its dependencies'.
export fn blend12(base: Int): Int {
  let d0 = blend3(base) + seed3();
  let d1 = blend7(base) + seed7();
  let d2 = blend5(base) + seed5();
  d0 + d1 + d2 + seed12()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift12(n: Node3): Node12 {
  Node12 { label: n.label, value: n.value + seed12(), weight: n.weight }
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label12_0<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "charlie" } else { "hotel" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants12_0(): (Int, Int, Float, Char, Str) {
  (496737, 0x3CC8, 913.282, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe12_0<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants12_0();
  label12_0(ctx, a, e).len() + b
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose12_1(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth12_1(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe12_1<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth12_1("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose12_1(.Some(3), .None) + extra
}

/// A body of 9 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute12_2(input: Int): Int {
  let a0 = input * 5 + 445;
  let a1 = a0 - 30;
  let a2 = a1 + 69;
  let a3 = a2 - 29;
  let a4 = a3 + 3;
  let a5 = a4 + 82;
  let a6 = a5 - 37;
  let a7 = a6 - 3;
  let a8 = a7 + 92;
  if (a8 > 725) { a8 } else { a8 - 78 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe12_2<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute12_2(7)
}

