}

derive Eq, Show for Node22;

export fn seed22(): Int { 4219 }

/// Folds this module's seed together with its dependencies'.
export fn blend22(base: Int): Int {
  let d0 = blend10(base) + seed10();
  let d1 = blend4(base) + seed4();
  let d2 = blend3(base) + seed3();
  d0 + d1 + d2 + seed22()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift22(n: Node10): Node22 {
  Node22 { label: n.label, value: n.value + seed22(), weight: n.weight }
}

/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label22_0<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "alpha" } else { "echo" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

