/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose22_4(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth22_4(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe22_4<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth22_4("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose22_4(.Some(3), .None) + extra
}

