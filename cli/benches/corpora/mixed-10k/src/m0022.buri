/// An enum of 5 variants, matched exhaustively below.
export enum State22_1 {
  Idle,
  Running(Int),
  Failed { code: Int, message: Str },
  Step3(Int, Str),
  Step4(Int, Str),
}

derive Eq, Show for State22_1;

/// The match every enum in a real program has somewhere.
export fn rank22_1(state: State22_1): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start22_1(ticks: Int): State22_1 {
  if (ticks == 0) { .Idle } else if (ticks < 16) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe22_1<C: Alloc>(ctx: C): Int {
  let s = start22_1(5);
  rank22_1(s) + s.show(ctx).len()
}

