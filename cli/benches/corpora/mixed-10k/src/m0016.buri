/// A record with 3 fields, derived comparisons and two methods.
export struct Rec16_7 {
  export f0: Int,
  export f1: Str,
  export f2: Float,
}

derive Eq, Show for Rec16_7;

impl Rec16_7 {
  /// A pure accessor, of the kind that is most of a real impl block.
  export fn scaled(self: Rec16_7, factor: Int): Int {
    self.f0 * factor + 616
  }

  /// Allocates, and says so with `C: Alloc`.
  export fn render<C: Alloc>(self: Rec16_7, ctx: C): Str {
    str.format(ctx, "rec16_7: ${self.f0}/${self.f1}")
  }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe16_7<C: Alloc>(ctx: C): Int {
  let r = Rec16_7 { f0: 7, f1: "probe", f2: 1.5 };
  r.scaled(3) + r.render(ctx).len()
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr16_8<T>(xs: [T], fallback: T): T {
  match (xs.first()) {
    .Some(v) => v,
    .None => fallback,
  }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll16_8<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric16_8(ns: [Int], ss: [Str]): Int {
  firstOr16_8<Int>(ns, 0) + firstOr16_8<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe16_8<C: Alloc>(ctx: C): Int {
  useGeneric16_8([1, 2], ["a"]) + describeAll16_8(ctx, [1, 2]).len()
}

