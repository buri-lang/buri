from "core/effect" import { Alloc };
from "core/list" import * as list;
from "core/str" import * as str;
from "//bench/m0000.buri" import { blend0, Node0, reach0, seed0 };
from "//bench/m0004.buri" import { blend4, Node4, reach4, seed4 };
from "//bench/m0006.buri" import { blend6, Node6, reach6, seed6 };
from "//bench/m0010.buri" import { blend10, Node10, reach10, seed10 };
