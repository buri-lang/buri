//! Generated module 10 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/str" import * as str;
from "core/list" import * as list;
from "core/cap" import { Alloc };
from "//bench/m0003" import { Node3, seed3, blend3, reach3 };
from "//bench/m0007" import { Node7, seed7, blend7, reach7 };
from "//bench/m0004" import { Node4, seed4, blend4, reach4 };
from "//bench/m0001" import { Node1, seed1, blend1, reach1 };

/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node10 {
  export label: Str,
  export value: Int,
  export weight: Float,
}

derive Eq, Show for Node10;

export fn seed10(): Int { 9191 }

/// Folds this module's seed together with its dependencies'.
export fn blend10(base: Int): Int {
  let d0 = blend3(base) + seed3();
  let d1 = blend7(base) + seed7();
  let d2 = blend4(base) + seed4();
  let d3 = blend1(base) + seed1();
  d0 + d1 + d2 + d3 + seed10()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift10(n: Node3): Node10 {
  Node10 { label: n.label, value: n.value + seed10(), weight: n.weight }
}

/// A fold and a filter over a literal list, with lambdas — closures
/// are their own path in both the checker and the backend.
export fn digest10_0<C: Alloc>(ctx: C): Int {
  let xs: [Int] = [9669, 9271, 4222, 2694, 8476];
  let kept = xs.filter(ctx, fn(x) => x % 2 == 0);
  let total = kept.fold(fn(acc, x) => acc + x, 0);
  total + xs.len()
}

/// An empty list of an explicit type, which is the other side of
/// inference: nothing constrains the element type but the annotation.
export fn drain10_0(): Int {
  let empty: [Int] = list.empty<Int>();
  empty.len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe10_0<C: Alloc>(ctx: C): Int {
  digest10_0(ctx) + drain10_0()
}

/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach10<C: Alloc>(ctx: C): Int {
  0
    + probe10_0(ctx)
    + reach3(ctx)
    + reach7(ctx)
    + reach4(ctx)
    + reach1(ctx)
}
