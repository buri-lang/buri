/// An enum of 5 variants, matched exhaustively below.
export enum State2_4 {
  export Idle,
  export Running(Int),
  export Failed { code: Int, message: Str },
  export Step3(Int, Str),
  export Step4(Int, Str),
}

derive Eq, Show, Ord, Hash, ToJson, FromJson for State2_4;

/// The match every enum in a real program has somewhere.
export fn rank2_4(state: State2_4): Int {
  match (state) {
    .Idle => 0,
    .Running(ticks) => ticks + 1,
    .Failed { code, .. } => code * -1,
    .Step3(k, _) => k + 3,
    .Step4(k, _) => k + 4,
  }
}

/// Construction, so the variants are reachable from a root.
export fn start2_4(ticks: Int): State2_4 {
  if (ticks == 0) { .Idle } else if (ticks < 93) { .Running(ticks) }
  else { .Failed { code: ticks, message: "overrun" } }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_4<C: Alloc>(ctx: C): Int {
  let s = start2_4(5);
  rank2_4(s) + s.show(ctx).len()
}

