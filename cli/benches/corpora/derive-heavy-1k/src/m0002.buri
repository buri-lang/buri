  r.scaled(3) + r.render(ctx).len()
}

/// A body of 7 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute2_2(input: Int): Int {
  let a0 = input * 8 + 228;
  let a1 = a0 * 71;
  let a2 = a1 - 75;
  let a3 = a2 + 64;
  let a4 = a3 * 33;
  let a5 = a4 - 29;
  let a6 = a5 * 26;
  if (a6 > 9744) { a6 } else { a6 - 72 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe2_2<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  compute2_2(7)
}

