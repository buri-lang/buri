//! Generated module 1 of the compiler benchmark corpus.
//!
//! Emitted by `cli/benches/generate.rs` from a fixed seed. Nothing in
//! here is meant to be read; it is meant to be *compiled*, at a
//! controlled size and with the construct mix of real source.

from "core/effect" import { Alloc };
from "core/json" import { FromJson, ToJson };
from "core/list" import * as list;
from "core/str" import * as str;
from "//bench/m0000.buri" import { blend0, Node0, reach0, seed0 };

derive Eq, Show, Ord, Hash, ToJson, FromJson for Node1;
/// The record every module in this corpus exports, so that an import
/// of any module resolves to a known shape.
export struct Node1 {
    export label: Str,
    export value: Int,
    export weight: Float,
}

export fn seed1(): Int {
    7920
}

/// Folds this module's seed together with its dependencies'.
export fn blend1(base: Int): Int {
    let d0 = blend0(base) + seed0();
    d0 + seed1()
}

/// Reads a dependency's record, so the import carries a type as
/// well as a function.
export fn lift1(n: Node0): Node1 {
    Node1 { label: n.label, value: n.value + seed1(), weight: n.weight }
}

derive Eq, Show, Ord, Hash, ToJson, FromJson for State1_0;
/// An enum of 5 variants, matched exhaustively below.
export enum State1_0 {
    Idle,
    Running(Int),
    Failed { code: Int, message: Str },
    Step3(Int, Str),
    Step4(Int, Str),
}

/// The match every enum in a real program has somewhere.
export fn rank1_0(state: State1_0): Int {
    match (state) {
        .Idle => 0,
        .Running(ticks) => ticks + 1,
        .Failed { code, .. } => code * -1,
        .Step3(k, _) => k + 3,
        .Step4(k, _) => k + 4,
    }
}

/// Construction, so the variants are reachable from a root.
export fn start1_0(ticks: Int): State1_0 {
    if (ticks == 0) {
        .Idle
    } else if (ticks < 33) {
        .Running(ticks)
    } else {
        .Failed { code: ticks, message: "overrun" }
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_0<C: Alloc>(ctx: C): Int {
    let s = start1_0(5);
    rank1_0(s) + s.show(ctx).len()
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose1_1(a: Option<Int>, b: Option<Int>): Int {
    match ((a, b)) {
        (.Some(x), .Some(y)) if x > y => x - y,
        (.Some(x), .Some(y)) => y - x,
        (.Some(x), .None) => x,
        (.None, .Some(y)) => y,
        (.None, .None) => 0,
    }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth1_1(left: Str, right: Str): Option<Int> {
    let a = left.toInt()?;
    let b = right.toInt()?;
    .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_1<C: Alloc>(ctx: C): Int {
    let _ = ctx;
    let extra = match (parseBoth1_1("1", "2")) {
        .Some(v) => v,
        .None => 0,
    };
    choose1_1(.Some(3), .None) + extra
}

derive Eq, Show, Ord, Hash, ToJson, FromJson for Rec1_2;
/// A record with 4 fields, derived comparisons and two methods.
export struct Rec1_2 {
    export f0: Int,
    export f1: Str,
    export f2: Float,
    export f3: Bool,
}

impl Rec1_2 {
    /// A pure accessor, of the kind that is most of a real impl block.
    export fn scaled(self, factor: Int): Int {
        self.f0 * factor + 436
    }

    /// Allocates, and says so with `C: Alloc`.
    export fn render<C: Alloc>(self, ctx: C): Str {
        str.format(ctx, "rec1_2: ${self.f0}/${self.f1}")
    }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_2<C: Alloc>(ctx: C): Int {
    let r = Rec1_2 { f0: 7, f1: "probe", f2: 1.5, f3: true };
    r.scaled(3) + r.render(ctx).len()
}

