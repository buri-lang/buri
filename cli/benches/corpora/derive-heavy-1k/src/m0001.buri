/// A body of 9 bindings over integer arithmetic — the shape most
/// lines in most programs actually have.
export fn compute1_5(input: Int): Int {
    let a0 = input * 9 + 193;
    let a1 = a0 * 72;
    let a2 = a1 + 79;
    let a3 = a2 * 33;
    let a4 = a3 * 20;
    let a5 = a4 + 71;
    let a6 = a5 - 33;
    let a7 = a6 - 84;
    let a8 = a7 - 24;
    if (a8 > 3284) { a8 } else { a8 - 10 }
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_5<C: Alloc>(ctx: C): Int {
    let _ = ctx;
    compute1_5(7)
}

/// A generic over an unconstrained parameter, instantiated below.
export fn firstOr1_6<T>(xs: [T], fallback: T): T {
    match (xs.first()) {
        .Some(v) => v,
        .None => fallback,
    }
}

/// A generic with a bound, which is the case the checker does real
/// work for: the bound has to be discharged at each instantiation.
export fn describeAll1_6<T: Show, C: Alloc>(ctx: C, xs: [T]): [Str] {
    xs.mapCtx(ctx, fn(c, x) => x.show(c))
}

/// Two instantiations, so monomorphization has copies to make.
export fn useGeneric1_6(ns: [Int], ss: [Str]): Int {
    firstOr1_6<Int>(ns, 0) + firstOr1_6<Str>(ss, "").len()
}

/// Reaches everything above from one call. See `reach` below.
export fn probe1_6<C: Alloc>(ctx: C): Int {
    useGeneric1_6([1, 2], ["a"]) + describeAll1_6(ctx, [1, 2]).len()
}

