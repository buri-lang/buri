/// Every declaration in this module, reachable from one call, so that
/// monomorphization has to visit the whole of it.
export fn reach3<C: Alloc>(ctx: C): Int {
  0
    + probe3_0(ctx)
    + probe3_1(ctx)
    + probe3_2(ctx)
    + probe3_3(ctx)
    + probe3_4(ctx)
    + probe3_5(ctx)
    + probe3_6(ctx)
    + reach2(ctx)
    + reach0(ctx)
}
