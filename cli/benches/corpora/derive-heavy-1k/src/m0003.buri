/// String building through interpolation, which is a template
/// literal in the lexer and a `format` call in the backend.
export fn label3_4<C: Alloc>(ctx: C, id: Int, name: Str): Str {
  let prefix = if (id < 0) { "bravo" } else { "delta" };
  let body = str.format(ctx, "${prefix}-${name}-${id}");
  body.toUpper(ctx)
}

/// Literals of the kinds the lexer has separate paths for: decimal,
/// hexadecimal, float, char, escaped string.
export fn constants3_4(): (Int, Int, Float, Char, Str) {
  (563898, 0x9DE8, 63.867, 'q', "a\ttab and a \"quote\"")
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_4<C: Alloc>(ctx: C): Int {
  let (a, b, _, _, e) = constants3_4();
  label3_4(ctx, a, e).len() + b
}

/// Nested matching over `Option` and a tuple, with a guard — the
/// three things a decision tree has to merge.
export fn choose3_5(a: Option<Int>, b: Option<Int>): Int {
  match ((a, b)) {
    (.Some(x), .Some(y)) if x > y => x - y,
    (.Some(x), .Some(y)) => y - x,
    (.Some(x), .None) => x,
    (.None, .Some(y)) => y,
    (.None, .None) => 0,
  }
}

/// A `?` chain, which is the other half of how errors move.
export fn parseBoth3_5(left: Str, right: Str): Option<Int> {
  let a = left.toInt()?;
  let b = right.toInt()?;
  .Some(a + b)
}

/// Reaches everything above from one call. See `reach` below.
export fn probe3_5<C: Alloc>(ctx: C): Int {
  let _ = ctx;
  let extra = match (parseBoth3_5("1", "2")) {
    .Some(v) => v,
    .None => 0,
  };
  choose3_5(.Some(3), .None) + extra
}

