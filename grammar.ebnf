(* ==========================================================================
   Buri — Extended BNF grammar
   Version 0.3 (draft)
   File extension: .buri

   NOTATION
     A ::= B          definition
     A | B            alternation
     ( ... )          grouping
     X?               zero or one
     X*               zero or more
     X+               one or more
     "..."            terminal (literal token text)
     UPPER_CAMEL      non-terminal
     ALL_CAPS         lexical token class (see LEXICAL GRAMMAR at the end)
     (* ... *)        comment

   PROPERTIES
     The syntactic grammar below is context-free and unambiguous, and is
     LR(1) / LALR(1) parseable. No production requires knowledge of what a
     name refers to; no production requires "feedback" from the type checker
     or from name resolution. See SPEC.md section 12 for the specific design
     decisions that buy this property, and section 14 for the well-formedness
     rules that are deliberately NOT encoded here.

     The type system is NOMINAL throughout: every type has a declaration, and
     trait conformance is declared rather than inferred from shape.
   ========================================================================== *)


(* --------------------------------------------------------------------------
   1. COMPILATION UNIT
   -------------------------------------------------------------------------- *)

Module          ::= Item*

Item            ::= Import
                  | ReExport
                  | Exportable
                  | ImplDecl               (* never exported: conformance is *)
                  | DeriveDecl             (* a property of the type         *)
                  | TestDecl               (* test sources only; SPEC 11.2   *)


(* --------------------------------------------------------------------------
   2. IMPORTS

   The module path comes first so that an editor knows which module is being
   named before the specifier list is typed, and can complete it.
   -------------------------------------------------------------------------- *)

Import          ::= "from" STRING "import" ImportClause ";"

(* A namespace import MUST be named: `import * as list` is the only wildcard
   form, and bare `import *` is not derivable. Nothing ever enters a scope
   without a name written in the importing file. *)
ImportClause    ::= "{" ImportSpecs? "}"
                  | "*" "as" IDENT

ImportSpecs     ::= ImportSpec ("," ImportSpec)* ","?

ImportSpec      ::= IDENT ("as" IDENT)?

(* A re-export publishes a name this module imported, and mirrors `import` in
   both shape and restriction: there is no `export *`, so every name a module
   publishes is written in that module's own source. A library's lib.buri is
   made of these. *)
ReExport        ::= "from" STRING "export" "{" ImportSpecs? "}" ";"

(* STRING in an Import or ReExport is a module path, and has two forms:
     "core/list"           a standard library module
     "//lib/money"         a module of this repository, from the root
   There are no relative paths: a leading "." is not a module path. *)


(* --------------------------------------------------------------------------
   3. DECLARATIONS
   -------------------------------------------------------------------------- *)

Exportable      ::= "export"? ExportableBody

ExportableBody  ::= FnDecl
                  | StructDecl
                  | EnumDecl
                  | TypeAliasDecl
                  | ConstDecl
                  | TraitDecl
                  | EffectDecl
                  | ContextDecl            (* exportable only from a test-only *)
                                           (* module; SPEC 11.3               *)

FnDecl          ::= "fn" IDENT GenericParams? "(" Params? ")" ":" Type Block

(* A function is a METHOD if and only if its first parameter is written `self`.
   A function is EFFECTFUL if and only if it has a `ctx` parameter, which comes
   first, or immediately after `self`. Both are declarations, not conventions
   about position or type. *)
Params          ::= SelfParam ("," CtxParam)? ("," Param)* ","?
                  | CtxParam ("," Param)* ","?
                  | Param ("," Param)* ","?
SelfParam       ::= "self" ":" Type
CtxParam        ::= "ctx" ":" Type
Param           ::= IDENT ":" Type

GenericParams   ::= "<" GenericParam ("," GenericParam)* ","? ">"
GenericParam    ::= IDENT (":" Bounds)?
Bounds          ::= NamedType ("+" NamedType)*

(* Struct fields and enum variants are module-private unless exported. That is
   the only visibility mechanism: record structs, tuple structs, and enums all
   use the same rule, and there is no `opaque` modifier. *)
StructDecl      ::= "struct" IDENT GenericParams? StructBody
StructBody      ::= "{" FieldDecls? "}"              (* record struct *)
                  | "(" TupleFields? ")" ";"         (* tuple struct  *)

FieldDecls      ::= FieldDecl ("," FieldDecl)* ","?
FieldDecl       ::= "export"? IDENT ":" Type

TupleFields     ::= TupleField ("," TupleField)* ","?
TupleField      ::= "export"? Type

EnumDecl        ::= "enum" IDENT GenericParams? "{" Variants? "}"
Variants        ::= Variant ("," Variant)* ","?
Variant         ::= "export"? IDENT VariantPayload?
VariantPayload  ::= "(" Types ")"
                  | "{" FieldDecls "}"

TypeAliasDecl   ::= "type" IDENT GenericParams? "=" Type ";"

ConstDecl       ::= "const" IDENT ":" Type "=" Expr ";"


(* --- Traits and effects ----------------------------------------------------
   A trait is an interface: a named set of method signatures. Conformance is
   NOMINAL -- a type satisfies a trait only where an `impl` or `derive` says
   so, never by accident of shape.

   An effect is the same declaration with one extra consequence: its
   implementors are effect-carrying, so they may only be passed as `self` or
   `ctx`. Effects may be declared only by platform modules, and no type may
   implement both an effect and a trait. *)

TraitDecl       ::= "trait" IDENT GenericParams? "{" MethodSig* "}"
EffectDecl      ::= "effect" IDENT GenericParams? "{" MethodSig* "}"
MethodSig       ::= "fn" IDENT GenericParams? "(" Params? ")" ":" Type ";"

ImplDecl        ::= "impl" GenericParams? NamedType "for" NamedType "{" FnDecl* "}"

DeriveDecl      ::= "derive" NamedType ("," NamedType)* "for" NamedType ";"


(* --- Contexts --------------------------------------------------------------
   A context binds each effect it provides to a value implementing it. It is
   the only construct in which more than one effect-carrying value may appear,
   and the only place a context is created rather than received (SPEC.md 11.3).

   Two forms, told apart by one token of lookahead after `context`: an IDENT
   opens a declaration, a `{` opens an expression. A declaration takes no
   parameters and is constructed by calling it -- `Hermetic()` -- so each use
   gets a fresh one. Where either form may appear is a static rule, not a
   grammar one.

   The left side of a binding is a NamedType because it names an effect, which
   may be written qualified (`cap.Alloc`). The right side is any expression. *)

ContextDecl     ::= "context" IDENT ContextBody

ContextExpr     ::= "context" ContextBody

ContextBody     ::= "{" Spread? ContextBindings? "}"
ContextBindings ::= ContextBinding ("," ContextBinding)* ","?
ContextBinding  ::= NamedType ":" Expr

(* Spread is the same production a struct literal uses (section 5): a context
   and a struct literal are both a brace-delimited list of `Name: value` pairs
   over an optional base. What differs is that the name on the left is an
   effect rather than a field, which is visible in its case. *)


(* --- Tests -----------------------------------------------------------------
   Legal only in a test source (SPEC.md 11.2). A test takes no parameters and
   returns nothing: it builds whatever context it needs with a ContextExpr, or
   calls one the file declared, and passes unless an assertion fails. The name
   is a STRING because test names are prose. *)

TestDecl        ::= "test" STRING Block


(* --------------------------------------------------------------------------
   4. TYPES

   `<` and `>` are unambiguous inside Type because the type grammar has no
   comparison operators. In expressions, type arguments are always introduced
   by the turbofish `::<...>`.
   -------------------------------------------------------------------------- *)

Type            ::= FnType
                  | PrimaryType

FnType          ::= "fn" "(" Types? ")" "=>" Type

Types           ::= Type ("," Type)* ","?

PrimaryType     ::= NamedType
                  | SelfType
                  | UnitType
                  | TupleType
                  | ArrayType
                  | GroupedType

(* `Self` is the implementing type; legal only inside a trait, effect, or
   impl body. *)
SelfType        ::= "Self"

(* The unit type and its only value are both written `()`. There is no empty
   record, because there are no records. *)
UnitType        ::= "(" ")"

NamedType       ::= TypePath TypeArgs?
TypePath        ::= IDENT ("." IDENT)*

TypeArgs        ::= "<" Type ("," Type)* ","? ">"

ArrayType       ::= "[" Type "]"

GroupedType     ::= "(" Type ")"

(* Tuples have arity >= 2. `(T)` is grouping and `()` is unit. *)
TupleType       ::= "(" Type ("," Type)+ ","? ")"


(* --------------------------------------------------------------------------
   5. EXPRESSIONS

   Precedence, lowest to highest:

       lambda / crash        (top level only; never a sub-operand)
       ||                    left
       ??                    right
       &&                    left
       == != < <= > >=       non-associative
       |                     left
       ^                     left
       &                     left
       + -                   left
       * / %                 left
       - ! ~                 prefix
       postfix chain         . .N (args) [i] ? ::<T> {fields}
   -------------------------------------------------------------------------- *)

Expr            ::= Lambda
                  | CrashExpr
                  | OrExpr

Lambda          ::= "fn" "(" LambdaParams? ")" (":" Type)? "=>" Expr
LambdaParams    ::= LambdaParam ("," LambdaParam)* ","?
LambdaParam     ::= IDENT (":" Type)?

CrashExpr       ::= "crash" Expr

OrExpr          ::= OrExpr "||" CoalesceExpr
                  | CoalesceExpr

CoalesceExpr    ::= AndExpr ("??" CoalesceExpr)?

AndExpr         ::= AndExpr "&&" CmpExpr
                  | CmpExpr

CmpExpr         ::= BitOrExpr (CmpOp BitOrExpr)?
CmpOp           ::= "==" | "!=" | "<" | "<=" | ">" | ">="

BitOrExpr       ::= BitOrExpr "|" BitXorExpr
                  | BitXorExpr

BitXorExpr      ::= BitXorExpr "^" BitAndExpr
                  | BitAndExpr

BitAndExpr      ::= BitAndExpr "&" AddExpr
                  | AddExpr

AddExpr         ::= AddExpr ("+" | "-") MulExpr
                  | MulExpr

MulExpr         ::= MulExpr ("*" | "/" | "%") UnaryExpr
                  | UnaryExpr

UnaryExpr       ::= ("-" | "!" | "~") UnaryExpr
                  | PostfixExpr
                  | BlockLikeExpr

(* Brace-terminated, self-delimiting expressions. They may appear as operands
   of binary operators, but they may NOT be the head of a postfix chain --
   that restriction is what keeps `if (c) { a } else { b } { x: 1 }`
   from having two parses. *)
BlockLikeExpr   ::= Block
                  | IfExpr
                  | MatchExpr
                  | ContextExpr

PostfixExpr     ::= PostfixExpr PostfixOp
                  | PrimaryExpr

(* Method calls have no production of their own: `sq.area()` is `"." IDENT`
   followed by a call, identical in shape to a field access or a module member
   access. Which one it is, is settled during name resolution. *)
PostfixOp       ::= "." IDENT                   (* field / member / method *)
                  | "." INT                     (* tuple element access    *)
                  | "(" Args? ")"               (* call                    *)
                  | "[" Expr "]"                (* index -> Option<T>      *)
                  | "?"                         (* try-propagate           *)
                  | "::" TypeArgs               (* turbofish               *)
                  | StructLitBody               (* struct literal          *)

(* With records gone, a `{` that opens an expression is ALWAYS a block, and a
   `{` following a path is ALWAYS a struct literal. Nothing competes, so field
   shorthand is unambiguous here. *)
StructLitBody   ::= "{" Spread? FieldInits? "}"
Spread          ::= ".." Expr ","?
FieldInits      ::= FieldInit ("," FieldInit)* ","?
FieldInit       ::= IDENT (":" Expr)?

Args            ::= Expr ("," Expr)* ","?

(* `self` and `ctx` are keywords, so IDENT does not cover them, but both are
   ordinary values once bound and appear in expressions like any other name. *)
PrimaryExpr     ::= Literal
                  | IDENT
                  | "self"                      (* in a method body        *)
                  | "ctx"                       (* the context in scope    *)
                  | "." IDENT                   (* inferred-type variant   *)
                  | UnitLit
                  | ArrayLit
                  | TupleLit
                  | GroupedExpr

UnitLit         ::= "(" ")"

ArrayLit        ::= "[" (Expr ("," Expr)* ","?)? "]"

(* Arity >= 2; `(e)` is grouping and `()` is unit. *)
TupleLit        ::= "(" Expr ("," Expr)+ ","? ")"

GroupedExpr     ::= "(" Expr ")"

IfExpr          ::= "if" "(" Expr ")" Block "else" ElseBranch
ElseBranch      ::= Block
                  | IfExpr

MatchExpr       ::= "match" "(" Expr ")" "{" MatchArms? "}"
MatchArms       ::= MatchArm ("," MatchArm)* ","?
MatchArm        ::= Pattern Guard? "=>" Expr
Guard           ::= "if" Expr

(* There are no loops. Iteration is recursion (guaranteed tail-call
   eliminated) or a fold. See SPEC.md 15.1. *)


(* --------------------------------------------------------------------------
   6. BLOCKS AND STATEMENTS

   A block is a sequence of `let` bindings followed by a result expression.
   There are no expression statements, no `return`, and no loops.
   -------------------------------------------------------------------------- *)

Block           ::= "{" Stmt+ "}"
                  | "{" Stmt* Expr "}"

(* `let` is the only statement outside a test source. ExprStmt is legal only in
   a test source and only when its type is () -- both static rules, SPEC 11.2 --
   so nothing must-use can be dropped by it. It stays LR(1): after an Expr, a
   ";" means statement and a "}" means result expression. *)
Stmt            ::= LetStmt
                  | ExprStmt

(* The second form binds a context. It takes no pattern and no type annotation,
   because a context's type is generated and never written (SPEC.md 11.3), and
   it is legal only where a context may be built. After "let", one token of
   lookahead decides which form this is. *)
LetStmt         ::= "let" Pattern (":" Type)? "=" Expr ";"
                  | "let" "ctx" "=" Expr ";"

ExprStmt        ::= Expr ";"


(* --------------------------------------------------------------------------
   7. PATTERNS

   A bare IDENT is ALWAYS a binding. Enum variants must be written qualified
   (`Option.None`) or with the inferred-type dot form (`.None`). This is what
   makes patterns parseable without name resolution.
   -------------------------------------------------------------------------- *)

Pattern         ::= PatternNoOr ("|" PatternNoOr)*

PatternNoOr     ::= BindPattern
                  | WildcardPattern
                  | LiteralPattern
                  | PathPattern
                  | UnitPattern
                  | TuplePattern
                  | ArrayPattern
                  | GroupedPattern

BindPattern     ::= IDENT ("@" PatternNoOr)?

WildcardPattern ::= "_"

LiteralPattern  ::= "-"? INT
                  | "-"? FLOAT
                  | STRING
                  | CHAR
                  | "true"
                  | "false"

PathPattern     ::= IDENT PatternPayload                  (* struct / tuple-struct *)
                  | QualifiedPath PatternPayload?         (* Enum.Variant          *)
                  | "." IDENT PatternPayload?             (* .Variant              *)

QualifiedPath   ::= IDENT "." IDENT ("." IDENT)*

PatternPayload  ::= "(" Patterns? ")"
                  | "{" FieldPatterns? "}"

Patterns        ::= Pattern ("," Pattern)* ","?

FieldPatterns   ::= FieldPattern ("," FieldPattern)* ("," "..")? ","?
                  | ".." ","?
FieldPattern    ::= IDENT (":" Pattern)?

UnitPattern     ::= "(" ")"

TuplePattern    ::= "(" Pattern ("," Pattern)+ ","? ")"

GroupedPattern  ::= "(" Pattern ")"

ArrayPattern    ::= "[" ArrayPatternBody? "]"
ArrayPatternBody
                ::= Pattern ("," Pattern)* ("," RestPattern)? ","?
                  | RestPattern ","?
RestPattern     ::= ".." IDENT?


(* --------------------------------------------------------------------------
   8. LITERALS
   -------------------------------------------------------------------------- *)

Literal         ::= INT
                  | FLOAT
                  | STRING
                  | CHAR
                  | "true"
                  | "false"
                  | TemplateLiteral

(* String interpolation. The three token classes are produced by the lexer's
   template mode; the nesting is handled lexically so that the *syntactic*
   grammar stays context-free.

       "score: ${a + b} pts"
        \_TEMPLATE_HEAD_/     \_TEMPLATE_TAIL_/                          *)
TemplateLiteral ::= TEMPLATE_HEAD Expr (TEMPLATE_SPAN Expr)* TEMPLATE_TAIL


(* ==========================================================================
   LEXICAL GRAMMAR
   ========================================================================== *)

(* Source text is UTF-8. Whitespace and comments are insignificant and may
   appear between any two tokens. Buri is NOT newline-sensitive. *)

Whitespace      ::= (" " | "\t" | "\r" | "\n")+

Comment         ::= LineComment | BlockComment
LineComment     ::= "//" (any character except "\n")*
BlockComment    ::= "/*" (BlockComment | any character)* "*/"     (* nestable *)
DocComment      ::= "///" (any character except "\n")*            (* a LineComment
                                                                     attached to the
                                                                     next Item      *)

IDENT           ::= (Letter | "_") (Letter | Digit | "_")*
                    minus Keyword minus ReservedWord

Letter          ::= "A".."Z" | "a".."z"
Digit           ::= "0".."9"

Keyword         ::= "as"     | "const"  | "context"| "crash"  | "ctx"
                  | "derive" | "effect" | "else"   | "enum"   | "export"
                  | "false"  | "fn"     | "for"    | "from"   | "if"
                  | "impl"   | "import" | "let"    | "match"  | "self"
                  | "Self"   | "struct" | "test"   | "trait"  | "true"
                  | "type"

(* `as` appears only in import specifiers. `for` only in `impl ... for ...`
   and `derive ... for ...`. There is no cast operator: numeric conversions
   are ordinary methods (SPEC.md 6.2.1).

   `test` and `context` are reserved in every module, so no function is named
   either, but a TestDecl is legal only in a test source and a ContextDecl or
   ContextExpr only where SPEC.md 11.3 says -- both static rules, not grammar
   ones. `assert` is NOT a keyword: assertions are the ordinary module
   `core/testing/assert`, and the name comes from `import * as assert`.

   `ctx` is a keyword, so it is legal as a parameter name in the fixed position
   CtxParam gives it, and as a LetStmt binding where a context may be built.
   Both restrictions are static rules. *)

(* Reserved but unused in v0.3; rejected by the lexer so that later versions
   can claim them without breaking source compatibility. *)
ReservedWord    ::= "async"  | "await"  | "break"  | "continue"
                  | "do"     | "in"     | "is"     | "loop"   | "module"
                  | "mut"    | "opaque" | "pub"    | "return" | "use"
                  | "when"   | "where"  | "while"  | "with"   | "yield"

(* --- Numbers ---------------------------------------------------------------
   A FLOAT must begin with a digit: `.5` is not a literal. This is what makes
   tuple access `pair.0` lex as IDENT "." INT rather than IDENT FLOAT.        *)

INT             ::= DecInt | HexInt | OctInt | BinInt
DecInt          ::= Digit (Digit | "_")*
HexInt          ::= "0x" HexDigit (HexDigit | "_")*
OctInt          ::= "0o" OctDigit (OctDigit | "_")*
BinInt          ::= "0b" BinDigit (BinDigit | "_")*
HexDigit        ::= Digit | "a".."f" | "A".."F"
OctDigit        ::= "0".."7"
BinDigit        ::= "0" | "1"

FLOAT           ::= DecInt "." DecInt Exponent?
                  | DecInt Exponent
Exponent        ::= ("e" | "E") ("+" | "-")? DecInt

(* --- Text ---------------------------------------------------------------- *)

STRING          ::= '"' StrChar* '"'
CHAR            ::= "'" (CharChar | Escape) "'"

StrChar         ::= any character except '"', "\", or an unescaped "${"
                  | Escape
CharChar        ::= any character except "'" or "\"

Escape          ::= "\\" ("n" | "r" | "t" | "0" | "\\" | '"' | "'" | "$"
                          | "u" "{" HexDigit+ "}")

TEMPLATE_HEAD   ::= '"' StrChar* "${"
TEMPLATE_SPAN   ::= "}"  StrChar* "${"
TEMPLATE_TAIL   ::= "}"  StrChar* '"'

(* The lexer keeps a stack of open interpolations so that a `}` closing a
   block inside a hole is distinguished from the `}` that resumes template
   text. This is the only mode-dependent part of the lexer. *)

(* --- Punctuation and operators ---------------------------------------------
   Longest-match wins. Note the deliberate absences:
     * there is no ">>" or "<<" token, so `Map<Str, List<Int>>` never
       mis-lexes; use bits.shl / bits.shr instead.
     * there is no "?." token, so `x?.field` is `x` `?` `.` `field`.
     * there is no "..." token; "``..``" serves in patterns and struct
       spreads alike.                                                        *)

Punctuation     ::= "{" | "}" | "(" | ")" | "[" | "]"
                  | "," | ";" | ":" | "::" | "." | ".." | "@" | "_"
                  | "=" | "=>"
                  | "==" | "!=" | "<" | "<=" | ">" | ">="
                  | "+" | "-" | "*" | "/" | "%"
                  | "&&" | "||" | "!" | "??"
                  | "&" | "|" | "^" | "~"
                  | "?"

(* Known lexical wart (shared with Rust): `t.0.1` lexes as `t` `.` `0.1`.
   Write `(t.0).1`. *)
(* Known lexical wart: `Foo<Bar<Int>>= x` lexes `>` `>=`. Write a space, i.e.
   `Foo<Bar<Int>> = x`. *)
