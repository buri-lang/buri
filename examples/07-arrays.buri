// 07 — Arrays
//
// `[T]` is an immutable, densely packed sequence. Note which operations need a
// context and which do not: anything whose result size depends on runtime data
// must allocate, and allocation is a effect.

from "core/list" import * as list;
from "core/str" import * as str;
from "core/order" import * as order;
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

// --- Pure: no context parameter, therefore no allocation, no effects --------

fn total(xs: [Int]): Int {
  xs.fold(fn(acc, x) => acc + x, 0)
}

fn maximum(xs: [Int]): Option<Int> {
  xs.fold(fn(best, x) => match (best) {
      .None => .Some(x),
      .Some(b) => if (x > b) { .Some(x) } else { .Some(b) },
    }, .None)
}

fn countMatching(pred: fn(Int) => Bool, xs: [Int]): Int {
  xs.fold(fn(acc, x) => if (pred(x)) { acc + 1 } else { acc }, 0)
}

// Indexing yields Option<T>. There is no way to read out of bounds.
fn secondOr(fallback: Int, xs: [Int]): Int {
  xs[1] ?? fallback
}

fn safeAverage(xs: [Int]): Option<Int> {
  if (xs.isEmpty()) {
    .None
  } else {
    .Some(total(xs) / xs.len())
  }
}

// --- Deterministic but allocating: bounded by <C: Alloc> --------------------

fn evensDoubled<C: Alloc>(ctx: C, xs: [Int]): [Int] {
  xs.filter(ctx, fn(x) => x % 2 == 0).map(ctx, fn(x) => x * 2)
}

fn descending<C: Alloc>(ctx: C, xs: [Int]): [Int] {
  xs.sortBy(ctx, order.reverse(order.int))
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  // An array literal has a statically known length, so it is not an
  // allocation the programmer has to account for.
  let xs: [Int] = [5, 3, 9, 1, 4, 8];
  let empty: [Int] = [];

  let _ = ctx.println("len          = ${xs.len()}");
  let _ = ctx.println("isEmpty      = ${empty.isEmpty()}");
  let _ = ctx.println("total        = ${total(xs)}");
  let _ = ctx.println("count even   = ${countMatching(fn(x) => x % 2 == 0, xs)}");
  let _ = ctx.println("xs[1]        = ${secondOr(-1, xs)}");
  let _ = ctx.println("xs[99]       = ${secondOr(-1, empty)}");

  // Option-returning results are matched, not unwrapped by faith.
  let _ = match (maximum(xs)) {
    .Some(m) => ctx.println("max          = ${m}"),
    .None => ctx.println("max          = (empty)"),
  };

  let _ = match (safeAverage(xs)) {
    .Some(a) => ctx.println("average      = ${a}"),
    .None => ctx.println("average      = (empty)"),
  };

  let doubled = evensDoubled(ctx, xs);
  let sorted = descending(ctx, xs);
  // A lambda may not capture `ctx`, so a mapper that itself needs to allocate
  // takes the context as its first parameter and goes through `mapCtx`.
  // Writing `sorted.map(ctx, fn(n) => str.fromInt(ctx, n))` is an error.
  let rendered = sorted.mapCtx(ctx, fn(c, n) => str.fromInt(c, n));
  let joined = rendered.join(ctx, ", ");

  let _ = ctx.println("evensDoubled = ${doubled.len()} items");
  let _ = ctx.println("descending   = ${joined}");

  // Zipping, taking, dropping, ranges — all size-dependent, all take ctx.
  let indices = list.range(ctx, 0, xs.len());
  let pairs = indices.zip(ctx, xs);
  let firstThree = xs.take(ctx, 3);
  let _ = ctx.println("pairs        = ${pairs.len()}, firstThree = ${firstThree.len()}");

  .Ok(())
}
