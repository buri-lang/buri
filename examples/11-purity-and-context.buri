// 11 — Purity and the context struct
//
// This is the example to read if you read only one.
//
// An effect is an interface only the platform implements. A context is a value
// bounded by the effects a function needs. A function that was not handed
// a effect cannot perform the corresponding effect — not directly, not
// through a helper, not through a dependency.
//
// Purity is therefore not a keyword and not an inferred annotation. It is the
// absence of a parameter, and you can check it by looking at the signature.

from "core/io" import * as io;
from "core/list" import * as list;
from "core/str" import * as str;
from "core/time" import * as time;
from "core/random" import * as random;
from "core/cap" import { Alloc, Clock, Rand, Stdout };

// ---------------------------------------------------------------------------
// TIER 1: PURE
//
// No context parameter at all. Cannot allocate, cannot print, cannot read the
// clock, cannot fail nondeterministically. Two calls with equal arguments
// always produce equal results, and the compiler may cache, reorder, or delete
// them freely.
// ---------------------------------------------------------------------------

fn celsiusToFahrenheit(c: F64): F64 {
  c * 9.0 / 5.0 + 32.0
}

fn isPalindrome(s: Str): Bool {
  let n = s.len();
  isPalindromeAt(s, 0, n - 1)
}

fn isPalindromeAt(s: Str, lo: Int, hi: Int): Bool {
  if (lo >= hi) {
    true
  } else {
    // `str.slice` is pure: Str is immutable, so a slice is a view, not a copy.
    if (s.slice(lo, lo + 1) == s.slice(hi, hi + 1)) {
      isPalindromeAt(s, lo + 1, hi - 1)
    } else {
      false
    }
  }
}

// Folding is pure: the result is one value, not a new collection.
fn mean(xs: [F64]): Option<F64> {
  if (xs.isEmpty()) {
    .None
  } else {
    // `toF64` on an integer is exact to 53 bits and rounds beyond that. It is
    // the one conversion the language lets you write without a Result, because
    // turning a count into a float is too common to route through one.
    .Some(xs.fold(fn(a, b) => a + b, 0.0) / (xs.len().toF64()))
  }
}

// ---------------------------------------------------------------------------
// TIER 2: DETERMINISTIC BUT ALLOCATING
//
// Bounded by <C: Alloc> and nothing else. Still referentially
// transparent — it just needs memory, which can fail and which costs
// something. `Alloc` is a resource effect, not an effect effect.
// ---------------------------------------------------------------------------

fn normalize<C: Alloc>(ctx: C, values: [F64]): [F64] {
  match (mean(values)) {
    .None => [],
    .Some(m) => values.map(ctx, fn(v) => v - m),
  }
}

fn slugify<C: Alloc>(ctx: C, title: Str): Str {
  title.toLower(ctx).split(ctx, " ").join(ctx, "-")
}

// ---------------------------------------------------------------------------
// TIER 3: EFFECTFUL
//
// Anything that observes or changes the world names the effect it needs.
// Callers pass whatever richer context they hold; row polymorphism (`..`)
// makes the wider record acceptable.
// ---------------------------------------------------------------------------

fn timed<C: Clock + Stdout, T>(
  ctx: C,
  label: Str,
  value: T,
): T {
  // Reading a clock is nondeterministic, so it needs Clock.
  let start = time.now(ctx);
  let elapsed = time.since(ctx, start);
  let _ = ctx.println("${label} took ${elapsed}ms");
  value
}

fn rollDice<C: Rand>(ctx: C, sides: Int): Int {
  random.int(ctx, 1, sides + 1)
}

// ---------------------------------------------------------------------------
// WHAT THE SIGNATURES BUY YOU
// ---------------------------------------------------------------------------

// This function's parameters are all effect-free, so it is pure — and no
// amount of code inside could change that. There is no ambient allocator, no
// global stdout, no `import fs` that would work here. Try to call
// ctx.println and the name `ctx` simply is not in scope.
fn provablyPure(xs: [Int], k: Int): Int {
  xs.fold(fn(acc, x) => acc + x * k, 0)
}

// This one takes only Alloc. It cannot log, cannot read the clock, cannot
// reach the network — a reviewer knows that without reading the body, and a
// reviewer of *its callees* does not have to be consulted either.
fn deterministicPipeline<C: Alloc>(ctx: C, xs: [F64]): [F64] {
  normalize(ctx, xs)
}

export fn main<C: Alloc + Clock + Rand + Stdout>(ctx: C): Result<(), Str> {
  let temps: [F64] = [12.0, 18.5, 21.0, 9.5];

  let word = "racecar";
  let title = "Hello Brave New World";

  let _ = ctx.println("68F         = ${celsiusToFahrenheit(20.0)}");
  let _ = ctx.println("palindrome  = ${isPalindrome(word)}");
  let _ = ctx.println("mean        = ${mean(temps) ?? 0.0}");
  let _ = ctx.println("slug        = ${slugify(ctx, title)}");
  let _ = ctx.println("pure        = ${provablyPure([1, 2, 3], 10)}");
  let _ = ctx.println("normalized  = ${deterministicPipeline(ctx, temps).len()} values");
  let _ = ctx.println("dice        = ${rollDice(ctx, 20)}");

  // `timed` needs clock + stdout; `ctx` has both plus more, and the extra
  // fields are absorbed by the trailing `..` in its signature.
  let answer = timed(ctx, "sum", provablyPure([1, 2, 3, 4], 1));
  let _ = ctx.println("timed       = ${answer}");

  .Ok(())
}
