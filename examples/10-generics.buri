// 10 — Generics and row variables
//
// Type parameters have no bounds, because there are no traits. Code that needs
// an operation takes that operation as an argument.

from "core/list" import * as list;
from "core/order" import * as order;
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

// --- Type parameters --------------------------------------------------------

fn identity<T>(x: T): T { x }

fn constant<A, B>(a: A, b: B): A {
  let _ = b;
  a
}

fn flip<A, B, C>(f: fn(A, B) => C, b: B, a: A): C {
  f(a, b)
}

// Generic data types.
struct Pair<A, B> {
  first: A,
  second: B,
}

enum Tree<T> {
  Leaf,
  Node(Tree<T>, T, Tree<T>),
}

enum Validation<T, E> {
  Valid(T),
  Invalid([E]),
}

// --- Passing operations instead of constraining types -----------------------
//
// There is no `T: Ord`. `insert` takes the comparison it needs. That is more
// typing at the call site and less machinery in the language.

fn insert<T>(self: Tree<T>, cmp: fn(T, T) => Order, value: T): Tree<T> {
  match (self) {
    .Leaf => Tree.Node(Tree.Leaf, value, Tree.Leaf),
    .Node(left, here, right) => match (cmp(value, here)) {
      .Less => Tree.Node(left.insert(cmp, value), here, right),
      .Greater => Tree.Node(left, here, right.insert(cmp, value)),
      .Equal => Tree.Node(left, here, right),
    },
  }
}

fn contains<T>(self: Tree<T>, cmp: fn(T, T) => Order, value: T): Bool {
  match (self) {
    .Leaf => false,
    .Node(left, here, right) => match (cmp(value, here)) {
      .Equal => true,
      .Less => left.contains(cmp, value),
      .Greater => right.contains(cmp, value),
    },
  }
}

fn size<T>(self: Tree<T>): Int {
  match (self) {
    .Leaf => 0,
    .Node(l, _, r) => 1 + l.size() + r.size(),
  }
}

// --- Generic functions that allocate ----------------------------------------

fn duplicate<C: Alloc, T>(ctx: C, xs: [T]): [T] {
  xs.concat(ctx, xs)
}

fn mapPair<A, B, C>(f: fn(A) => C, g: fn(B) => C, p: Pair<A, B>): Pair<C, C> {
  Pair { first: f(p.first), second: g(p.second) }
}

// --- Row variables ----------------------------------------------------------
//
// The context is one type variable, so handing the same context to a callback
// is just naming `C` again. Row variables used to be needed for this; effect
// bounds made them unnecessary and they were removed.

fn withLogging<C: Stdout, T>(
  ctx: C,
  label: Str,
  action: fn(C) => T,
): T {
  let _ = ctx.println("-> ${label}");
  let out = action(ctx);
  let _ = ctx.println("<- ${label}");
  out
}

// A function names the effects it needs and nothing else.
fn requiresOnlyAlloc<C: Alloc>(ctx: C, n: Int): [Int] {
  list.range(ctx, 0, n)
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  // Turbofish supplies explicit type arguments in expression position.
  let n = identity::<Int>(7);
  let s = identity("seven");

  let tree =
    Tree.Leaf.insert(order.int, 5).insert(order.int, 3).insert(order.int, 8).insert(order.int, 3);

  let _ = ctx.println("identity  = ${n} / ${s}");
  let _ = ctx.println("constant  = ${constant(1, s)}");
  let _ = ctx.println("tree size = ${tree.size()}");
  let _ = ctx.println("has 8     = ${tree.contains(order.int, 8)}");
  let _ = ctx.println("has 9     = ${tree.contains(order.int, 9)}");
  let _ = ctx.println("flip      = ${flip(fn(a: Int, b: Int) => a - b, 1, 10)}");

  let p = mapPair(fn(x: Int) => x * 2, fn(b: Bool) => if (b) { 1 } else { 0 }, Pair { first: 21, second: true });
  let _ = ctx.println("mapPair   = ${p.first}, ${p.second}");

  // `withLogging` receives a context with both alloc and stdout, requires only
  // stdout, and passes the whole thing through to the callback — which is
  // therefore free to allocate.
  let doubled = withLogging(ctx, "duplicate", fn(c) => duplicate(c, [1, 2, 3]));
  let _ = ctx.println("duplicate = ${doubled.len()} items");
  let _ = ctx.println("range     = ${requiresOnlyAlloc(ctx, 5).len()} items");

  .Ok(())
}
