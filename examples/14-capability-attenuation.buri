// 14 — Attenuating capabilities
//
// Two ways to give a callee less than you hold, with different guarantees.
//
//   Static confinement — bound the callee to fewer capability traits. It
//   receives the same value and cannot use, or pass on, anything its bounds do
//   not name. Free, and enough almost always.
//
//   Attenuation — hand it a wrapper that satisfies fewer traits, so the value
//   itself lacks the rest. Stronger, and worth the ceremony at trust
//   boundaries.
//
// Note that attenuation narrows the CONTEXT rather than extracting one
// capability out of it. That is what keeps the `ctx` rule satisfiable: there is
// still exactly one capability-carrying parameter.

from "core/io" import * as io;
from "core/fs" import * as fs;
from "core/fs" import { IoError };
from "core/cap" import { Alloc, Fs, Rand, Stdout, Region };

// ---------------------------------------------------------------------------
// Static confinement
// ---------------------------------------------------------------------------

// `logOnly` can print. It cannot read a file, and neither can anything it
// calls, because it has nothing bounded by Fs to hand on. No wrapper, no copy,
// no runtime cost — the bound is the whole mechanism.
fn logOnly<C: Stdout>(ctx: C, msg: Str): {} {
  let _ = io.println(ctx, msg);
  // fs.readText(ctx, "/etc/passwd")   // ERROR: C is not bounded by Fs
  // loadTemplate(ctx, "x")            // ERROR: loadTemplate needs C: Fs
}

// Confinement is transitive: `C` is opaque at every call site downstream, so
// there is no way to recover the capabilities the bound left out.
fn loadTemplate<C: Alloc + Fs>(ctx: C, name: Str): Str {
  match (fs.readText(ctx, name)) {
    .Ok(text) => text,
    .Err(_) => "<missing>",
  }
}

// ---------------------------------------------------------------------------
// module: safe/readonly
//
// Attenuation. `ReadOnly<C>` wraps a whole context and forwards only the
// operations this module chooses to expose.
// ---------------------------------------------------------------------------

export opaque struct ReadOnly<C>(C);

export fn readOnly<C>(ctx: C): ReadOnly<C> {
  // Constructing an opaque type is legal only inside its defining module.
  ReadOnly(ctx)
}

// Forwards allocation, so ReadOnly<C> satisfies Alloc whenever C does.
impl<C: Alloc> Alloc for ReadOnly<C> {
  fn allocate(self: ReadOnly<C>, bytes: Int): Region { self.0.allocate(bytes) }
}

// Forwards reading — and deliberately not writing. Because Fs requires both
// `readFile` and `writeFile`, ReadOnly<C> does not satisfy Fs no matter what C
// is, so it cannot be passed anywhere that asks for it.
export fn readFile<C: Fs>(self: ReadOnly<C>, path: Str): Result<Str, IoError> {
  self.0.readFile(path)
}

// ---------------------------------------------------------------------------
// module: safe/scoped
//
// The same shape, with a runtime check the wrapper can enforce because it is
// the only path to the underlying capability.
// ---------------------------------------------------------------------------

export opaque struct Scoped<C> {
  inner: C,
  prefix: Str,
}

export fn scopeTo<C>(ctx: C, prefix: Str): Scoped<C> {
  Scoped { inner: ctx, prefix: prefix }
}

enum ScopeError {
  Escapes(Str),
  Io(IoError),
}

impl<C: Alloc> Alloc for Scoped<C> {
  fn allocate(self: Scoped<C>, bytes: Int): Region { self.inner.allocate(bytes) }
}

export fn readFileScoped<C: Fs>(self: Scoped<C>, path: Str): Result<Str, ScopeError> {
  if (!path.startsWith(self.prefix) || path.contains("..")) {
    .Err(.Escapes(path))
  } else {
    match (self.inner.readFile(path)) {
      .Ok(text) => .Ok(text),
      .Err(e) => .Err(.Io(e)),
    }
  }
}

// ---------------------------------------------------------------------------
// module: safe/seeded
//
// A deterministic stand-in for Rand. Because capability traits are ordinary
// interfaces, a fake is just a struct with the right methods — no mocking
// framework, and the call site does not change.
// ---------------------------------------------------------------------------

export struct Seeded { export state: U64 }

export fn seeded(seed: U64): Seeded { Seeded { state: seed } }

/// Returns the next value and the next generator; no mutation anywhere.
export fn nextInt(self: Seeded, lo: Int, hi: Int): (Int, Seeded) {
  // An LCG relies on wrapping, and `+`/`*` crash on overflow, so the wrapping
  // intent is spelled out. The literals are typed U64 by unification with
  // `self.state`, and range-checked at compile time.
  let next = self.state.wrappingMul(6364136223846793005).wrappingAdd(1442695040888963407);
  let span = hi - lo;
  // U64 -> I64 is not lossless, so this is `as%` rather than `as`.
  let value = lo + ((next / 65536) as% Int) % span;
  (value, Seeded { state: next })
}

// ---------------------------------------------------------------------------
// Application code
// ---------------------------------------------------------------------------

// Takes a ReadOnly context. It can read and allocate; there is no expression it
// could write that reaches the file system for writing.
fn render<C: Alloc + Fs>(ctx: ReadOnly<C>, name: Str): Str {
  match (ctx.readFile(name)) {
    .Ok(text) => text,
    .Err(_) => "<missing>",
  }
}

fn loadConfig<C: Alloc + Fs>(ctx: Scoped<C>, name: Str): Str {
  match (ctx.readFileScoped(name)) {
    .Ok(text) => text,
    .Err(.Escapes(_)) => "<denied>",
    .Err(.Io(_)) => "<missing>",
  }
}

// Pure: given a seed, the sequence is fixed. Production and test code call the
// identical function.
fn threeRolls(g: Seeded): ([Int], Seeded) {
  let (a, g1) = g.nextInt(1, 7);
  let (b, g2) = g1.nextInt(1, 7);
  let (c, g3) = g2.nextInt(1, 7);
  ([a, b, c], g3)
}

export fn main<C: Alloc + Fs + Rand + Stdout>(ctx: C): Result<{}, Str> {
  // Hand out narrowed contexts once, at the top of the program.
  let reader = readOnly(ctx);
  let scoped = scopeTo(ctx, "/etc/app/");

  let templateName = "greeting.txt";
  let allowedPath = "/etc/app/config.toml";
  let deniedPath = "/etc/shadow";

  let _ = logOnly(ctx, "starting");
  let _ = io.println(ctx, "template = ${render(reader, templateName)}");
  let _ = io.println(ctx, "allowed  = ${loadConfig(scoped, allowedPath)}");
  let _ = io.println(ctx, "denied   = ${loadConfig(scoped, deniedPath)}");

  let (rolls, _) = threeRolls(seeded(42));
  let _ = io.println(ctx, "seeded   = ${rolls[0] ?? 0} ${rolls[1] ?? 0} ${rolls[2] ?? 0}");

  .Ok({})
}
