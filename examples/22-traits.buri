// 22 — Traits
//
// A trait is an interface: a named set of method signatures. Conformance is
// NOMINAL — a type satisfies a trait only where an `impl` or `derive` says so,
// never by accident of shape — so checking `T: Ord` is one lookup in one table,
// not a search over implementations.
//
// There are no blanket implementations, no associated types, no `where`
// clauses, no supertraits, no trait objects, and no dynamic dispatch. Each of
// those turns resolution from a lookup into a search, and the search is the
// entire compile-time cost of a trait system.

from "core/str" import * as str;
from "core/order" import { Ord, Eq, Show };
from "core/num" import { Add, Sub, Checked, Bounded };
from "core/cap" import { Alloc, Stdout };

// ---------------------------------------------------------------------------
// Declaring a trait
//
// `Self` is the implementing type. Trait methods declare `self` first, exactly
// like any other method.
// ---------------------------------------------------------------------------

trait Measurable {
  fn size<C: Alloc>(self: Self): Int;
  fn isEmptyThing(self: Self): Bool;
}

// A trait may require a context, and every implementation then gets exactly
// that context and nothing more. A `Renderable` implementation provably cannot
// read a file or open a socket — the trait declaration is a effect contract
// binding every future implementor.
trait Renderable {
  fn render(self: Self, ctx: C): Str;
}

// ---------------------------------------------------------------------------
// Conformance is declared
//
// Declaring a method that happens to match a trait's signature does NOT make
// the type conform. Nothing is inferred from shape, which is what keeps a
// module's public API from implicitly including "which traits its types happen
// to satisfy" — the thing that would otherwise wreck incremental rebuilds.
// ---------------------------------------------------------------------------

export struct Version {
  export major: Int,
  export minor: Int,
}

// This method alone does not make Version an Ord. The `impl` below is what
// does, and it is checked against the trait's signatures.
impl Ord for Version {
  fn compare(self: Version, other: Version): Order {
    match (self.major.compare(other.major)) {
      .Equal => self.minor.compare(other.minor),
      ord => ord,
    }
  }
}

// ---------------------------------------------------------------------------
// `impl` supplies the methods, and is checked against the trait
//
// The methods land in the type's ordinary method namespace, so `v.compare(w)`
// resolves like any other method. An `impl` may appear only in the defining
// module of the type, and is never exported — conformance is a property of the
// type, visible wherever the type is.
// ---------------------------------------------------------------------------

export struct Playlist {
  export name: Str,
  export tracks: [Str],
}

impl Measurable for Playlist {
  fn size(self: Playlist): Int { self.tracks.len() } 
  fn isEmptyThing(self: Playlist): Bool { self.tracks.isEmpty() }
}

impl Renderable for Playlist {
  fn render<C: Alloc>(self: Playlist, ctx: C): Str {
    str.format(ctx, "${self.name} (${self.tracks.len()} tracks)")
  }
}

// ---------------------------------------------------------------------------
// `derive` generates the implementation structurally
//
// Struct fields in declaration order, enum variants in declaration order,
// recursing into field types. A fold over one type definition — no search.
// ---------------------------------------------------------------------------

derive Eq, Show for Version;   // Ord is hand-written above
derive Eq, Ord, Show for Playlist;

// ---------------------------------------------------------------------------
// Operators are trait methods
//
//   a + b  ->  Add.add        a == b  ->  Eq.eq
//   a - b  ->  Sub.sub        a < b   ->  Ord.compare
//
// which is what makes newtype wrappers usable.
// ---------------------------------------------------------------------------

struct Meters(F64);
derive Add, Sub, Ord, Eq, Show for Meters;

struct Pixels(I32);
derive Add, Sub, Ord, Eq, Show for Pixels;

fn distances(): Meters {
  let a = Meters(1.5);
  let b = Meters(2.0);

  // `derive Add for Meters` provides Meters + Meters and nothing else, so the
  // unit safety the newtype exists for survives contact with arithmetic.
  //   let bad = a + 2.0;          // ERROR: F64 is not Meters
  //   let alsoBad = a + Pixels(3); // ERROR: Pixels is not Meters
  a + b
}

// An operator implementation cannot allocate or perform an effect: `a + b` has
// no argument position through which a context could be passed. You cannot
// write an expensive `+` in this language. Matrix addition allocates, so it is
// spelled as a method that says so:
//
//   fn add<C: Alloc>(self: Matrix, ctx: C, other: Matrix): Matrix

// ---------------------------------------------------------------------------
// Bounds
//
// Multiple bounds join with `+`. Inside the function, the bounds' methods are
// callable on the parameter and nothing else is.
// ---------------------------------------------------------------------------

fn largest<T: Ord>(xs: [T]): Option<T> {
  xs.fold(
    fn(best, x) => match (best) {
      .None => .Some(x),
      .Some(b) => if (x > b) { .Some(x) } else { .Some(b) },
    },
    .None,
  )
}

fn describeAll<C: Alloc, T: Show + Measurable>(ctx: C, xs: [T]): [Str] {
  xs.mapCtx(ctx, fn(c, x) => str.format(c, "${x.show(c)}: ${x.size()}"))
}

// Numeric bounds are just traits now. There is no blob bound named "any
// number": a function names the operations it actually needs.
fn total<N: Add>(zero: N, xs: [N]): N {
  xs.fold(fn(acc, x) => acc + x, zero)
}

fn safeTotal<N: Add + Checked + Bounded>(zero: N, xs: [N]): Option<N> {
  xs.fold(
    fn(acc, x) => match (acc) {
      .None => .None,
      .Some(sum) => sum.checkedAdd(x),
    },
    .Some(zero),
  )
}

// And ordinary code needs none of it. `Int` is a concrete type.
fn area(self: Version): Int {
  self.major * self.minor
}

export fn main<C: Alloc + Stdout>(ctx: C): Result<(), Str> {
  let v1 = Version { major: 1, minor: 2 };
  let v2 = Version { major: 1, minor: 10 };
  let playlist = Playlist { name: "Focus", tracks: ["a", "b", "c"] };
  let versions = [v2, v1];
  let heights = [Meters(1.0), Meters(2.5)];

  let _ = ctx.println("compare   = ${v1.compare(v2) == Order.Less}");
  let _ = ctx.println("derived== = ${v1 == v1}");
  let _ = ctx.println("show      = ${v1.show(ctx)}");
  let _ = ctx.println("size      = ${playlist.size()}");
  let _ = ctx.println("render    = ${playlist.render(ctx)}");
  let _ = ctx.println("distance  = ${distances().show(ctx)}");
  let _ = ctx.println("total     = ${total(Meters(0.0), heights).show(ctx)}");
  let _ = ctx.println("area      = ${v1.area()}");

  let _ = match (largest(versions)) {
    .Some(v) => ctx.println("largest   = ${v.show(ctx)}"),
    .None => ctx.println("largest   = none"),
  };

  let _ = match (safeTotal(0, [1, 2, 3])) {
    .Some(n) => ctx.println("safeTotal = ${n}"),
    .None => ctx.println("safeTotal = overflowed"),
  };

  .Ok(())
}
