// 02 — Literals, primitives, and operators

from "core/str" import * as str;
from "core/num" import * as num;
from "core/bits" import * as bits;
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

/// Doc comments start with three slashes and attach to the next declaration.
/* Block comments /* nest */ properly. */

const MAX_RETRIES: Int = 5;
const PI: Float = 3.14159265358979;
const GREETING: Str = "hello";

fn numbers(): () {
  // `Int` and `Float` are ALIASES, not separate types: Int == I64,
  // Float == F64, Uint == U64, Byte == U8. Write Int/Float for ordinary code
  // and the sized names when the width is part of the problem.
  let decimal = 1_000_000;      // nothing constrains it -> Int
  let hex = 0xDEAD_BEEF;
  let octal = 0o755;
  let binary = 0b1010_0110;

  // A numeric literal has no type on sight. It takes one from context, and
  // only falls back to Int/Float when nothing pins it down.
  let byte: U8 = 200;           // the annotation pins it -> U8, not a conversion
  let tiny: I8 = -5;
  let single: F32 = 1.5;
  let bytes: [U8] = [1, 2, 3];  // every element is a U8

  // Because the literal's type is known before it is checked, a literal that
  // does not fit is a COMPILE error, not a runtime surprise:
  //   let bad: U8 = 300;        // ERROR: 300 is not representable in U8
  //   let worse: U32 = -1;      // ERROR: U32 has no negative values

  // Sized types are distinct and there is no implicit promotion anywhere.
  let small: I32 = 7;
  //   let mixed = small + decimal;   // ERROR: I32 + I64
  //   let alsoBad = 1 + 1.0;         // ERROR: Int + Float

  // Conversions are ordinary methods. Whether one can fail is visible in its
  // return type rather than in a choice of operator.
  let wide = small.toI64();     // always exact -> I64
  //   let neg = small.toU32();  // Result: an I32 could be negative
  let back = wide.toI32();      // may not fit -> Result<I32, RangeError>
  let low = wide.wrapToU8();    // modular; keeps the low 8 bits

  // Float literals must begin with a digit: `.5` is not a literal.
  let f = 0.5;
  let sci = 6.022e23;
  let neg = -1.0e-9;

  // Integer -> float is a conversion like any other, and F64 has the mantissa
  // to hold every I32 exactly, so `as` accepts it.
  let ratio = small.toF64() / 3.0;

  // Overflow is undefined behaviour. When wrapping is the intent, say so.
  let checked: Option<U8> = byte.checkedAdd(100);
  let wrapped: U8 = byte.wrappingAdd(100);

  let _ = (decimal, hex, octal, binary, tiny, single, bytes, wide, back, low,
           f, sci, neg, ratio, checked, wrapped);
  ()
}

// Generic numeric code names the traits it needs, and nothing more. There is no
// blob bound called "any number": `Ord` gives comparison, `Add`/`Sub`/`Div` give
// arithmetic, `Checked` gives the overflow-aware operations.
fn clamp<N: Ord>(lo: N, hi: N, x: N): N {
  if (x < lo) { lo } else if (x > hi) { hi } else { x }
}

fn midpoint<N: Add + Sub + Div>(a: N, b: N, two: N): N {
  a + (b - a) / two
}

// Ordinary code needs none of that. `Int` and `F64` are concrete types, so a
// function over them carries no bounds and no ceremony at all.
fn celsiusToF(c: F64): F64 { c * 9.0 / 5.0 + 32.0 }

fn text(): () {
  let s: Str = "immutable UTF-8";
  let escaped: Str = "tab\there, newline\nthere, quote\", dollar \$";
  let unicode: Str = "\u{1F980} crab";
  let c: Char = 'x';
  let nl: Char = '\n';

  // Pure string operations: no allocation, so no context needed.
  let n = s.len();
  let head = s.slice(0, 9);
  let clean = "  padded  ".trim();

  let _ = (escaped, unicode, c, nl, n, head, clean);
  ()
}

fn operators(a: Int, b: Int, p: Bool, q: Bool): () {
  let arithmetic = a + b - a * b / 2 % 3;

  // Comparison is NON-associative: `a < b < c` is a parse error.
  let compared = a < b;
  let equal = a == b;

  // Equality is structural, never referential — there are no references to
  // compare. Tuples, arrays, and records have `Eq` built in; your own structs
  // and enums opt in with `derive Eq`.
  let sameTuple = (1, "one") == (1, "one");

  // Logical operators short-circuit. There is no truthiness: conditions must
  // be Bool.
  let logical = p && !q || (a > 0);

  // Bitwise operators bind tighter than comparison, as in Rust, so this is
  // (a & 0xFF) == 0 and not a & (0xFF == 0).
  let masked = a & 0xFF == 0;
  let combined = a | b ^ (~a);

  // There is no `<<` or `>>` token; nested generics would mis-lex.
  let shifted = bits.shl(a, 3);

  let _ = (arithmetic, compared, equal, sameTuple, logical, masked, combined, shifted);
  ()
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let _ = numbers();
  let _ = text();
  let _ = operators(6, 7, true, false);

  // A string literal with a hole has type `Template`, not `Str`. Building one
  // allocates nothing, so printing needs only `stdout`.
  let _ = ctx.println("retries=${MAX_RETRIES} pi=${PI} greeting=${GREETING}");

  // Turning a Template into a Str does allocate, so it takes the context.
  let rendered: Str = str.format(ctx, "2 + 2 = ${2 + 2}");
  let _ = ctx.println(rendered);

  // Bounded generics instantiate at whatever numeric type the arguments have.
  let _ = ctx.println("clamp Int = ${clamp(0, 10, 42)}");
  let _ = ctx.println("clamp F64 = ${clamp(0.0, 1.0, 2.5)}");
  let _ = ctx.println("midpoint  = ${midpoint(10, 20, 2)}");
  let _ = ctx.println("celsius   = ${celsiusToF(20.0)}");

  .Ok(())
}
