// 15 — Modules, imports, exports, and member visibility
//
// A file is a module. Declarations are private unless exported. Declaration
// order does not matter anywhere.

// Namespace import: everything reachable as `list.<name>`.
from "core/list" import * as list;
from "core/str" import * as str;

// Named imports, with optional renaming.
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;
from "core/list" import { filter as filterList };

// Importing from this repository. Paths are absolute from the root — there are
// no relative module paths — and `//lib/money` names that library's public
// surface, while `//lib/money/cents` names a module inside it and resolves
// only from within that same library.
// from "//lib/money" import * as money;
// from "//lib/money" import { Cents };

// --- Visibility --------------------------------------------------------------

// Private to this module.
fn normalizeKey(k: Str): Str {
  k.trim()
}

// Part of the public surface.
export fn lookupKey(pairs: [(Str, Str)], key: Str): Option<Str> {
  let wanted = normalizeKey(key);
  match (pairs.find(fn(p) => normalizeKey(p.0) == wanted)) {
    .Some(p) => .Some(p.1),
    .None => .None,
  }
}

// --- Opaque types: exporting a name without its representation ---------------

/// Cents are exported, but the fact that they are an I64 is not. Outside this
/// module you cannot write `Cents(500)` and you cannot pattern-match one open.
export struct Cents(I64);

export fn fromDollars(d: I64): Cents { Cents(d * 100) } 
export fn fromCents(c: I64): Cents { Cents(c) } 
export fn addMoney(a: Cents, b: Cents): Cents { Cents(a.0 + b.0) }

export fn formatMoney<C: Alloc>(ctx: C, c: Cents): Str {
  let dollars = c.0 / 100;
  let remainder = c.0 % 100;
  let pad = if (remainder < 10) { "0" } else { "" };
  // `\$` escapes a literal dollar sign so it does not start a hole.
  str.format(ctx, "\$${dollars}.${pad}${remainder}")
}

// The invariant that money is never a raw integer is enforced by the type, not
// by convention: there is no way to add a Cents to a plain I64.

// --- Opaque enums work the same way -----------------------------------------

/// The variants are hidden; callers go through the constructors and the
/// inspector below.
export enum Status {
  Draft,
  Published { at: Str },
  Archived,
}

export fn draft(): Status { Status.Draft } 
export fn publish(at: Str): Status { Status.Published { at: at } }

export fn isVisible(s: Status): Bool {
  match (s) {
    .Draft => false,
    .Published { .. } => true,
    .Archived => false,
  }
}

// --- Type aliases are transparent -------------------------------------------

type Row = (Str, Str);
type Table = [Row];
type Renderer = fn(Row) => Str;

// `Row` and `(Str, Str)` are the same type; aliases document, they do not
// protect. Use a tuple struct when you want a distinct type.
export fn renderTable<C: Alloc>(ctx: C, render: Renderer, t: Table): Str {
  // `map`, not the local alias: a method resolves through its receiver's
  // type rather than through scope, so renaming the import renames only the
  // free function (SPEC 6.7.3).
  t.map(ctx, render).join(ctx, "\n")
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let table: Table = [("host", "localhost"), ("port", "8080"), ("tls", "false")];

  let paddedKey = "  port  ";
  let unknown = "?";
  let _ = ctx.println("lookup = ${lookupKey(table, paddedKey) ?? unknown}");

  let subtotal = fromDollars(19);
  let shipping = fromCents(499);
  let total = addMoney(subtotal, shipping);
  let _ = ctx.println("total  = ${formatMoney(ctx, total)}");

  let today = "2026-08-13";
  let _ = ctx.println("visible = ${isVisible(publish(today))}");

  // As a free function the receiver stays first: `xs.filter(ctx, p)` and
  // `filterList(xs, ctx, p)` are the same call.
  let onlyLong = filterList(table, ctx, fn(r) => r.1.len() > 4);
  let rendered = renderTable(ctx, fn(r) => r.0, onlyLong);
  let _ = ctx.println("rows   = ${rendered}");

  .Ok(())
}
