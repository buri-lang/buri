// 19 — Grammar corners
//
// Every construct in this file exists to demonstrate a specific decision that
// keeps the grammar context-free and unambiguous. Cross-references are to
// SPEC.md section 12.

from "core/list" import * as list;
from "core/bits" import * as bits;
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

struct Point { export x: Int, export y: Int }
derive Eq for Point;   // `==` on a struct is opt-in
struct Wrapper<T> { value: T }

enum Choice { Yes, No }

// --- 12.1 Parenthesized conditions -------------------------------------------
//
// `if (c) { ... }` closes the condition at `)`, so the `{` that follows is
// always a block and never a struct literal. Unparenthesized conditions are
// exactly what forces Rust to ban struct literals in condition position.

fn conditions(p: Point): Str {
  if (p == Point { x: 0, y: 0 }) { "origin" } else { "elsewhere" }
}

// --- 12.2 No expression statements -------------------------------------------
//
// A block is `let`s then a result expression. A call made only for its effect
// has to be bound.

fn effects<C: Stdout>(ctx: C): Int {
  let _ = ctx.println("side effect");
  let _ = ctx.println("another");
  42
}

// --- 12.3 No records, so `{` is never ambiguous ------------------------------
//
// Structural records once made `{ x }` ambiguous — a record with a shorthand
// field, or a block whose result expression is `x` — and an earlier draft paid
// for that by banning shorthand in literals. Removing records removed the
// ambiguity at its source, and shorthand came back.

struct Sized { export x: Int, export y: Int }

fn shorthand(x: Int, y: Int): Int {
  let literal = Sized { x, y };         // shorthand: `x` means `x: x`
  let Sized { x: a, y: b } = literal;   // patterns have it too
  let Sized { x, y } = literal;
  a + b + x + y
}

// A block and a struct literal, side by side. The leading path is the entire
// difference, and it is one token.
fn blockOrLiteral(n: Int): Int {
  let asLiteral = Sized { x: n, y: n };   // path then `{`  -> struct literal
  let asBlock = { n + 1 };                // bare `{`       -> block
  let unit = ();                          // `()`           -> the unit value
  let _ = unit;
  asLiteral.x + asBlock
}

// --- 12.4 Turbofish -----------------------------------------------------------

fn identity<T>(x: T): T { x }

fn typeArguments(): Int {
  // In a *type*, angle brackets are unambiguous because types have no
  // comparison operators.
  let boxed: Wrapper<Wrapper<Int>> = Wrapper { value: Wrapper { value: 1 } };

  // In an *expression*, `f<a>(b)` would be two comparisons, so explicit type
  // arguments use `::<>`.
  let n = identity::<Int>(7);
  (boxed.value).value + n
}

// --- 12.5 No cast operator -----------------------------------------------------
//
// `as`, `as?`, and `as%` were three tokens and a precedence level doing work
// that methods do with none: a conversion is resolved by its receiver's type
// either way. Removing them also let the fallible conversions return Result
// instead of encoding failure in the choice of operator.

fn conversions(small: I32, big: I64): Int {
  let widened = small.toI64();        // always exact
  let narrowed = big.toI32();         // Result<I32, RangeError>
  let low = big.wrapToU8();           // modular
  widened + (narrowed ?? 0).toI64() + low.toI64()
}

// --- 12.6 No `<<` / `>>` tokens ------------------------------------------------
//
// Longest-match lexing would turn the `>>` closing nested type arguments into a
// shift operator. Removing the operators removes the problem.

fn shifting(x: Int): Int {
  bits.shl(x, 3) + bits.shr(x, 1)
}

// Note the space in `>> =` below: `Wrapper<Wrapper<Int>>= v` would lex as
// `>` `>=`. This is the one lexical wart that remains.
fn nestedGenerics(v: Wrapper<Wrapper<Int>>): Int {
  let w: Wrapper<Wrapper<Int>> = v;
  (w.value).value
}

// --- 12.6 Variants must be qualified or dot-prefixed in patterns ---------------

fn variantPatterns(c: Choice, o: Option<Int>): Str {
  let a = match (c) {
    // `Yes =>` would bind every Choice to a variable named `Yes`. The dot
    // makes it a variant, and makes the parser independent of name resolution.
    .Yes => "yes",
    Choice.No => "no",
  };

  let b = match (o) {
    .Some(n) if n > 0 => "positive",
    .Some(_) => "non-positive",
    .None => "nothing",
  };

  if (a == "yes") { b } else { a }
}

// A bare identifier in a pattern is always a binding; `IDENT(` and `IDENT{`
// are struct patterns. The token after the identifier decides, always.
fn bindingVersusPattern(p: Point): Int {
  match (p) {
    Point { x: 0, y } => y,          // IDENT `{` -> struct pattern
    anything => anything.x,          // IDENT alone -> binding
  }
}

// --- 12.7 Tuples have arity >= 2; unit is `{}` ---------------------------------

fn tuples(): Int {
  let grouped = (1 + 2);           // parentheses, not a 1-tuple
  let pair = (1, 2);               // 2-tuple
  let triple = (1, 2, 3);          // 3-tuple
  let nothing: () = ();            // unit
  let _ = nothing;
  grouped + pair.0 + triple.2
}

// --- 12.8 Lambdas begin with `fn` ------------------------------------------------

fn lambdaForms(): Int {
  let a = fn(x) => x + 1;
  let b = fn(x: Int): Int => x * 2;
  let c = fn(x: Int) => { let doubled = x * 2; doubled + 1 };

  // 12.10: a lambda body extends maximally right, so a lambda is never a bare
  // operand. `2 * fn(x) => x` does not parse; parenthesize.
  let d = 2 * (fn(x: Int) => x)(3);

  a(1) + b(2) + c(3) + d
}

// --- 12.9 / 12.10 Block-like expressions as operands ------------------------------
//
// `if`, `match`, and blocks are brace-terminated and self-delimiting, so they
// CAN be operands. `else` is mandatory, which kills dangling-else outright.

fn blockLikeOperands(n: Int): Int {
  let a = 1 + if (n > 0) { n } else { 0 };
  let b = 10 * match (n) { 0 => 1, _ => 2 };
  let c = { let t = n * n; t } - 1;
  a + b + c
}

// --- 12.11 Match arms are comma-separated, always ---------------------------------
//
// Without a required separator, an arm body `x` followed by an arm starting
// `-1 =>` would greedily parse as `x - 1`.

fn commas(n: Int): Int {
  match (n) {
    0 => 100,
    -1 => 200,
    _ => { let doubled = n * 2; doubled },   // comma required even after `}`
  }
}

// --- 12.12 Block-like expressions cannot head a postfix chain ----------------------

fn postfixHeads(o: Option<Point>): Int {
  // `match (o) { ... }.x` is a parse error; parenthesize instead.
  let p = (match (o) {
    .Some(v) => v,
    .None => Point { x: 0, y: 0 },
  }).x;

  // Struct literals are a postfix form, which is why the head must be a path.
  let q = Point { x: 1, y: 2 }.y;

  p + q
}

// --- 12.13 Floats start with a digit ------------------------------------------------

fn floatsAndTuples(t: (Int, (Int, Int))): Int {
  let half = 0.5;              // `.5` is not a literal
  let _ = half;
  let outer = t.0;             // lexes as IDENT `.` INT
  let inner = (t.1).0;         // `t.1.0` would lex `1.0` as a float
  outer + inner
}

// --- 12.18 `context` has two forms, told apart by one token -------------------------
//
// `context Name { ... }` is a declaration and `context { ... }` is an
// expression; an IDENT or a `{` after the keyword decides which. The expression
// is brace-terminated, so it is a block-like operand — and, like every other
// one, it cannot head a postfix chain. Where either may appear is a static
// rule, not a grammar one: in a program, only `main`'s body.

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let p = Point { x: 3, y: 4 };

  let _ = ctx.println("conditions   = ${conditions(p)}");
  let _ = ctx.println("effects      = ${effects(ctx)}");
  let _ = ctx.println("shorthand    = ${shorthand(1, 2)}");
  let _ = ctx.println("blockOrLit   = ${blockOrLiteral(5)}");
  let _ = ctx.println("typeArgs     = ${typeArguments()}");
  let _ = ctx.println("conversions  = ${conversions(7, 300)}");
  let _ = ctx.println("shifting     = ${shifting(8)}");
  let _ = ctx.println("nested       = ${nestedGenerics(Wrapper { value: Wrapper { value: 9 } })}");
  let _ = ctx.println("variants     = ${variantPatterns(Choice.Yes, .Some(1))}");
  let _ = ctx.println("binding      = ${bindingVersusPattern(p)}");
  let _ = ctx.println("tuples       = ${tuples()}");
  let _ = ctx.println("lambdas      = ${lambdaForms()}");
  let _ = ctx.println("blockLike    = ${blockLikeOperands(3)}");
  let _ = ctx.println("commas       = ${commas(-1)}");
  let _ = ctx.println("postfix      = ${postfixHeads(.Some(p))}");
  let _ = ctx.println("floats       = ${floatsAndTuples((1, (2, 3)))}");
  let _ = ctx.println("list         = ${[1, 2, 3].len()}");

  .Ok(())
}
