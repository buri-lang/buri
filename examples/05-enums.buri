// 05 — Enums (Rust-style sum types)
//
// A value of an enum type is exactly one variant. Variants may be nullary,
// tuple-like, or record-like, and one enum may mix all three.

from "core/io" import * as io;
from "core/str" import * as str;
from "core/list" import * as list;
from "core/cap" import { Alloc, Stdout };

enum Shape {
  Empty,
  Circle(F64),
  Rect { width: F64, height: F64 },
  Polygon([Point]),
}

struct Point { x: F64, y: F64 }

// Generic enums.
enum Either<L, R> {
  Left(L),
  Right(R),
}

// Recursive enums need no explicit indirection; the runtime boxes as needed.
enum Json {
  Null,
  Bool(Bool),
  Number(F64),
  Text(Str),
  Array([Json]),
  Object([(Str, Json)]),
}

// The prelude defines these; shown here for reference.
//   enum Option<T> { Some(T), None }
//   enum Result<T, E> { Ok(T), Err(E) }
//   enum Order { Less, Equal, Greater }

enum HttpError {
  Timeout { afterMs: Int },
  Status(Int),
  Transport(Str),
}

fn area(s: Shape): F64 {
  match (s) {
    .Empty => 0.0,
    .Circle(r) => 3.14159265358979 * r * r,
    .Rect { width, height } => width * height,
    // Shoelace formula omitted; this arm just shows a payload binding.
    .Polygon(points) => polygonArea(points),
  }
}

fn polygonArea(points: [Point]): F64 {
  // Real implementation elsewhere; see 12-recursion-and-adts.buri.
  let _ = points;
  0.0
}

fn constructing(): [Shape] {
  // Fully qualified form works anywhere.
  let a = Shape.Circle(1.0);
  let b = Shape.Rect { width: 2.0, height: 3.0 };
  let c = Shape.Empty;

  // The leading-dot form infers the type from context. Here the array's
  // element type is fixed by `a`.
  let d: Shape = .Empty;
  let e: Shape = .Rect { width: 1.0, height: 1.0 };

  [a, b, c, d, e]
}

fn errorMessage(e: HttpError): Str {
  match (e) {
    .Timeout { afterMs } => if (afterMs > 10000) { "timed out (slow)" } else { "timed out" },
    // Or-patterns: alternatives must bind the same names at the same types.
    .Status(404) | .Status(410) => "gone",
    .Status(code) => if (code >= 500) { "server error" } else { "client error" },
    .Transport(detail) => detail,
  }
}

fn render(j: Json): Str {
  match (j) {
    .Null => "null",
    .Bool(true) => "true",
    .Bool(false) => "false",
    .Number(_) => "<number>",
    .Text(s) => s,
    .Array(_) => "<array>",
    .Object(_) => "<object>",
  }
}

fn partition(e: Either<Int, Str>): Str {
  match (e) {
    .Left(_) => "left",
    .Right(s) => s,
  }
}

export fn main(ctx: { alloc: Alloc, stdout: Stdout }): Result<{}, Str> {
  let shapes = constructing();
  let total = shapes.fold(fn(acc, s) => acc + area(s), 0.0);

  let _ = io.println(ctx, "total area = ${total}");
  let _ = io.println(ctx, "${errorMessage(HttpError.Timeout { afterMs: 30000 })}");
  let _ = io.println(ctx, "${errorMessage(HttpError.Status(503))}");
  let text = Json.Text("  hi  ".trim());
  let right = Either.Right("right");
  let _ = io.println(ctx, "${render(text)}");
  let _ = io.println(ctx, "${partition(right)}");
  .Ok({})
}
