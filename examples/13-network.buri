// 13 — Network requests
//
// `Net` is what makes a socket possible. A module that does not receive it in
// its context cannot open a connection, and neither can anything it calls.

from "core/net/http" import * as http;
from "core/str" import * as str;
from "core/list" import * as list;
from "core/result" import * as result;
from "core/time" import * as time;
from "core/cap" import { Alloc, Clock, Net, Stdout };
from "core/host" import * as host;

struct Repo {
  name: Str,
  stars: Int,
}

enum FetchError {
  Transport(Str),
  Status(Int),
  Body { reason: Str },
}

// --- Pure: shaping requests and interpreting responses ----------------------

fn repoUrl(owner: Str, name: Str): Str {
  // Pure because the pieces are literals plus slices; no allocation happens
  // until something actually needs a new Str.
  let _ = (owner, name);
  "https://api.example.com/repos"
}

fn classify(status: Int): Result<(), FetchError> {
  if (status >= 200 && status < 300) {
    .Ok(())
  } else {
    .Err(.Status(status))
  }
}

// --- Effectful: needs Net ---------------------------------------------------

fn fetchText<C: Alloc + Net>(ctx: C, url: Str): Result<Str, FetchError> {
  let response = http.get(ctx, url).mapErr(fn(e) => FetchError.Transport(http.errorText(e)))?;

  let _ = classify(response.status)?;
  .Ok(response.body)
}

fn fetchRepo<C: Alloc + Net>(
  ctx: C,
  owner: Str,
  name: Str,
): Result<Repo, FetchError> {
  let body = fetchText(ctx, repoUrl(owner, name))?;
  match (parseRepo(body)) {
    .None => .Err(.Body { reason: "unexpected response shape" }),
    .Some(repo) => .Ok(repo),
  }
}

fn parseRepo(body: Str): Option<Repo> {
  // Pure. A real implementation would decode JSON; the point is that decoding
  // needs no effect, so it can be tested without a network.
  if (body.isEmpty()) {
    .None
  } else {
    .Some(Repo { name: body.trim(), stars: 0 })
  }
}

// --- Retry with backoff -----------------------------------------------------
//
// The action takes its context as an argument rather than capturing one:
// a lambda may not close over a effect, and this is the shape that rule
// pushes you toward. `C` is one type variable, so whatever the caller held is
// handed straight through to the action with its bounds intact.

fn withRetry<C: Clock, T>(
  ctx: C,
  attempts: Int,
  action: fn(C) => Result<T, FetchError>,
): Result<T, FetchError> {
  match (action(ctx)) {
    .Ok(value) => .Ok(value),
    .Err(e) => if (attempts <= 1) {
      .Err(e)
    } else {
      let _ = time.sleepMs(ctx, 250);
      withRetry(ctx, attempts - 1, action)
    },
  }
}

fn errorText<C: Alloc>(ctx: C, e: FetchError): Str {
  match (e) {
    .Transport(detail) => detail,
    .Status(code) => str.format(ctx, "HTTP ${code}"),
    .Body { reason } => reason,
  }
}

// --- Fetching several things ------------------------------------------------

fn fetchAll<C: Alloc + Net>(
  ctx: C,
  urls: [Str],
): [Result<Str, FetchError>] {
  // `mapCtx` threads the context through instead of letting the callback
  // capture it.
  urls.mapCtx(ctx, fn(c, url) => fetchText(c, url))
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Net:    host.net,
    Clock:  host.clock,
    Stdout: host.stdout,
  };

  let outcome = withRetry(ctx, 3, fn(c) => fetchRepo(c, "buri-lang", "buri"));

  let _ = match (outcome) {
    .Ok(repo) => ctx.println("${repo.name}: ${repo.stars} stars"),
    .Err(e) => ctx.println("fetch failed: ${errorText(ctx, e)}"),
  };

  let urls: [Str] = [
    "https://api.example.com/a",
    "https://api.example.com/b",
  ];
  let results = fetchAll(ctx, urls);
  let okCount = results.fold(fn(acc, r) => match (r) { .Ok(_) => acc + 1, .Err(_) => acc }, 0);
  let _ = ctx.println("${okCount} of ${results.len()} succeeded");

  .Ok(())
}
