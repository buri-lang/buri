// 12 — File I/O
//
// Every function here that touches the disk says so in its signature. Note
// that the *parsing* is pure and testable with no harness at all; only the
// reading and writing need effects.

from "core/fs" import * as fs;
from "core/fs" import { IoError };
from "core/str" import * as str;
from "core/list" import * as list;
from "core/result" import * as result;
from "core/cap" import { Alloc, Fs, Stdout };
from "core/host" import * as host;

struct Record {
  name: Str,
  score: Int,
}

enum LoadError {
  Io(IoError),
  Parse { line: Int, text: Str },
}

// --- Pure: the interesting logic ---------------------------------------------

fn parseLine(index: Int, line: Str): Result<Record, LoadError> {
  match (line.splitOnce(", ")) {
    .None => .Err(.Parse { line: index, text: line }),
    .Some(parts) => {
      let name = parts.0.trim();
      match (parts.1.trim().toInt()) {
        .None => .Err(.Parse { line: index, text: line }),
        .Some(score) => .Ok(Record { name: name, score: score }),
      }
    },
  }
}

fn best(records: [Record]): Option<Record> {
  records.fold(fn(acc, r) => match (acc) {
      .None => .Some(r),
      .Some(b) => if (r.score > b.score) { .Some(r) } else { .Some(b) },
    }, .None)
}

// --- Allocating but deterministic --------------------------------------------

fn parseAll<C: Alloc>(ctx: C, text: Str): Result<[Record], LoadError> {
  let lines = text.split(ctx, "\n");
  let nonEmpty = lines.filter(ctx, fn(l) => !l.trim().isEmpty());
  let indices = list.range(ctx, 0, nonEmpty.len());

  // `list.zip` pairs them so the parser can report a line number without
  // needing mutable state or an index variable.
  let numbered = indices.zip(ctx, nonEmpty);

  // A fold would need its callback to capture `ctx` in order to allocate, and
  // capturing a effect is forbidden. Recursion threads it explicitly.
  parseFrom(ctx, numbered, [])
}

fn parseFrom<C: Alloc>(
  ctx: C,
  remaining: [(Int, Str)],
  done: [Record],
): Result<[Record], LoadError> {
  match (remaining) {
    [] => .Ok(done),
    [pair, ..rest] => {
      let record = parseLine(pair.0, pair.1)?;
      parseFrom(ctx, rest, done.push(ctx, record))
    },
  }
}

// --- Effectful: needs Fs ------------------------------------------------------

fn loadScores<C: Alloc + Fs>(ctx: C, path: Str): Result<[Record], LoadError> {
  // `?` propagates the Err case. The error types must match, so the IoError
  // is wrapped explicitly.
  let text = fs.readText(ctx, path).mapErr(fn(e) => LoadError.Io(e))?;
  parseAll(ctx, text)
}

fn saveReport<C: Alloc + Fs>(
  ctx: C,
  path: Str,
  records: [Record],
): Result<(), IoError> {
  // A lambda may not capture `ctx`, so a per-item renderer that itself
  // allocates takes the context as its first parameter and runs via `mapCtx`.
  let lines = records.mapCtx(ctx, fn(c, r) => str.format(c, "${r.name}: ${r.score}"));
  let body = lines.join(ctx, "\n");
  fs.writeText(ctx, path, body)
}

fn errorText<C: Alloc>(ctx: C, e: LoadError): Str {
  match (e) {
    .Io(_) => "could not read the file",
    .Parse { line, text } => str.format(ctx, "line ${line} is malformed: ${text}"),
  }
}

// --- Entry point --------------------------------------------------------------
//
// The context binds exactly alloc, fs, and stdout. `host.net` is never named,
// so nothing in the program — or in anything it depends on — can open a socket.

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Fs:     host.fs,
    Stdout: host.stdout,
  };

  let inputPath = "scores.csv";
  let outputPath = "report.txt";

  match (loadScores(ctx, inputPath)) {
    .Err(e) => {
      let _ = ctx.println("load failed: ${errorText(ctx, e)}");
      .Err("load failed")
    },
    .Ok(records) => {
      let _ = ctx.println("loaded ${records.len()} records");

      let _ = match (best(records)) {
        .Some(top) => ctx.println("best: ${top.name} with ${top.score}"),
        .None => ctx.println("no records"),
      };

      match (saveReport(ctx, outputPath, records)) {
        .Ok(_) => {
          let _ = ctx.println("wrote ${outputPath}");
          .Ok(())
        },
        .Err(_) => .Err("could not write the report"),
      }
    },
  }
}
