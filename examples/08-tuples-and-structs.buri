// 08 — Tuples and structs
//
// Tuples are positional and anonymous; structs are named and nominal. There is
// nothing in between: Buri has no record types, so every product type with
// field names has a declaration somewhere.
//
// That is what makes `{` unambiguous — a bare `{` always opens a block, and a
// `{` after a path always opens a struct literal. Nothing competes, which is
// why struct literals get field shorthand.

from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

// --- Tuples -----------------------------------------------------------------

fn divMod(a: Int, b: Int): (Int, Int) {
  (a / b, a % b)
}

fn swap<A, B>(pair: (A, B)): (B, A) {
  let (a, b) = pair;
  (b, a)
}

fn tuples(): Int {
  let pair: (Int, Str) = (42, "answer");

  // Positional access.
  let n = pair.0;
  let label = pair.1;

  // Nested tuple access must be parenthesized, because `0.1` lexes as a float.
  let nested: ((Int, Int), Int) = ((1, 2), 3);
  let inner = (nested.0).1;

  // `(e)` is grouping, not a 1-tuple; there is no 1-tuple. `()` is unit.
  let grouped = (n + 1);
  let nothing: () = ();

  let _ = (label, nothing);
  grouped + inner
}

// --- Structs ----------------------------------------------------------------
//
// What used to be an anonymous record is a named struct. Fields are
// module-private unless exported.

struct Config {
  export host: Str,
  export port: Int,
  export tls: Bool,
}

fn defaultConfig(): Config {
  Config { host: "localhost", port: 8080, tls: false }
}

impl Config {
  fn withPort(self: Config, port: Int): Config {
    // Spread first, then overrides. `..self` copies the fields you do not name,
    // including private ones.
    Config { ..self, port: port }
  }
}

// Field shorthand: `host` means `host: host`. This is unambiguous because a
// struct literal is only ever reached through a path, so it never competes
// with a block.
fn configFor(host: Str, port: Int): Config {
  let tls = port == 443;
  Config { host, port, tls }
}

impl Config {
  fn endpoint(self: Config): Str {
    let scheme = if (self.tls) { "https" } else { "http" };
    let _ = scheme;
    self.host
  }

  // Struct patterns have shorthand too.
  fn unpack(self: Config): Int {
    let Config { host, port, tls } = self;
    let _ = (host, tls);
    port
  }
}

// --- Generic structs --------------------------------------------------------

struct Pair<A, B> {
  export first: A,
  export second: B,
}

impl<A, B> Pair<A, B> {
  fn mapFirst<C>(self: Pair<A, B>, f: fn(A) => C): Pair<C, B> {
    Pair { first: f(self.first), second: self.second }
  }
}

// --- Where records used to be needed ----------------------------------------
//
// An open record type `{ host: Str, .. }` once meant "any record with at least
// a host field". That was mainly for contexts, and contexts are effect bounds
// now. When you want to accept many shapes, name a trait and bound on it.

trait HasHost {
  // Not `host`: a method may not share a name with a field of its `self` type
  // (SPEC 14.18), because a `.` resolves to a field before a method.
  fn hostname(self: Self): Str;
}

impl HasHost for Config {
  fn hostname(self: Config): Str { self.host }
}

fn describeHost<T: HasHost>(thing: T): Str {
  thing.hostname()
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let (q, r) = divMod(17, 5);
  let flipped = swap((1, "one"));
  let cfg = defaultConfig().withPort(9090);
  let derived = configFor("example.com", 443);
  let paired = Pair { first: 1, second: "one" }.mapFirst(fn(x) => x * 2);

  let _ = ctx.println("divMod    = ${q} rem ${r}");
  let _ = ctx.println("swap.0    = ${flipped.0}");
  let _ = ctx.println("tuples    = ${tuples()}");
  let _ = ctx.println("port      = ${cfg.unpack()}");
  let _ = ctx.println("endpoint  = ${cfg.endpoint()}");
  let _ = ctx.println("shorthand = ${derived.port}, tls=${derived.tls}");
  let _ = ctx.println("mapFirst  = ${paired.first}");
  let _ = ctx.println("hasHost   = ${describeHost(cfg)}");

  .Ok(())
}
