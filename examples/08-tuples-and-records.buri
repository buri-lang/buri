// 08 — Tuples and anonymous records
//
// Tuples are positional and have arity >= 2. Records are structural, and are
// what contexts are made of.

from "core/io" import * as io;
from "core/cap" import { Alloc, Stdout };

// --- Tuples -----------------------------------------------------------------

fn divMod(a: Int, b: Int): (Int, Int) {
  (a / b, a % b)
}

fn swap<A, B>(pair: (A, B)): (B, A) {
  let (a, b) = pair;
  (b, a)
}

fn tuples(): Int {
  let pair: (Int, Str) = (42, "answer");

  // Positional access.
  let n = pair.0;
  let label = pair.1;

  // Nested tuple access must be parenthesized, because `0.1` lexes as a float:
  let nested: ((Int, Int), Int) = ((1, 2), 3);
  let inner = (nested.0).1;

  // `(e)` is grouping, not a 1-tuple; there is no 1-tuple.
  let grouped = (n + 1);

  // Unit is the empty record `{}`, not `()`.
  let nothing: {} = {};

  let _ = (label, nothing);
  grouped + inner
}

// --- Records ----------------------------------------------------------------

type Config = {
  host: Str,
  port: Int,
  tls: Bool,
};

fn defaultConfig(): Config {
  // Record literals have NO field shorthand: write `host: host`, never `host`.
  // That restriction is what keeps `{ x }` from being ambiguous with a block
  // whose result expression is `x`.
  {
    host: "localhost",
    port: 8080,
    tls: false,
  }
}

fn withPort(self: Config, port: Int): Config {
  // Spread first, then overrides.
  { ..self, port: port }
}

fn endpoint(c: Config): Str {
  let scheme = if (c.tls) { "https" } else { "http" };
  let _ = scheme;
  c.host
}

// Record patterns DO have shorthand.
fn unpack(c: Config): Int {
  let { host, port, tls } = c;
  let _ = (host, tls);
  port
}

// --- Row polymorphism -------------------------------------------------------
//
// An open record type means "at least these fields". This is how one context
// value satisfies many different requirements.

fn describeHost(c: { host: Str, .. }): Str {
  c.host
}

// A named row variable relates two positions: whatever extra fields came in,
// come back out.
fn tagged<..R>(c: { host: Str, ..R }, newHost: Str): { host: Str, ..R } {
  { ..c, host: newHost }
}

export fn main<C: Alloc + Stdout>(ctx: C): Result<{}, Str> {
  let (q, r) = divMod(17, 5);
  let flipped = swap((1, "one"));

  let cfg = defaultConfig().withPort(9090);
  let big = { host: "example.com", port: 443, tls: true, region: "eu-west-1" };

  let _ = io.println(ctx, "divMod       = ${q} rem ${r}");
  let _ = io.println(ctx, "swap.0       = ${flipped.0}");
  let _ = io.println(ctx, "tuples       = ${tuples()}");
  let _ = io.println(ctx, "port         = ${unpack(cfg)}");
  let _ = io.println(ctx, "endpoint     = ${endpoint(cfg)}");

  // Both of these satisfy `{ host: Str, .. }`, even though one has four
  // fields and the other has three.
  let _ = io.println(ctx, "describe cfg = ${describeHost(cfg)}");
  let _ = io.println(ctx, "describe big = ${describeHost(big)}");

  // `tagged` preserves the extra fields, so `.region` survives the round trip.
  let renamed = tagged(big, "eu.example.com");
  let _ = io.println(ctx, "renamed      = ${renamed.host} in ${renamed.region}");

  .Ok({})
}
