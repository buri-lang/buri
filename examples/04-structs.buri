// 04 — Structs
//
// Structs are nominal: two structs with identical fields are different types.
// They have no methods. Functions that operate on a struct are just functions.

from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

struct Point {
  x: F64,
  y: F64,
}

struct User {
  id: UserId,
  name: Str,
  email: Option<Str>,
  tags: [Str],
}

// Tuple structs give you a distinct type over an existing one. They are
// terminated with a semicolon; record structs are not.
struct UserId(Str);
struct Meters(F64);
struct Pair<A, B>(A, B);

// Generic record struct.
struct Boxed<T> {
  value: T,
  label: Str,
}

fn origin(): Point {
  Point { x: 0.0, y: 0.0 }
}

fn translate(p: Point, dx: F64, dy: F64): Point {
  // Values are immutable. "Updating" builds a new value; `..p` copies the rest.
  Point { ..p, x: p.x + dx, y: p.y + dy }
}

fn distanceSquared(a: Point, b: Point): F64 {
  let dx = a.x - b.x;
  let dy = a.y - b.y;
  dx * dx + dy * dy
}

fn newUser(id: Str, name: Str): User {
  User {
    id: UserId(id),
    name: name,
    email: .None,
    tags: [],
  }
}

impl User {
  fn withEmail(self: User, email: Str): User {
    User { ..self, email: .Some(email) }
  }
}

fn rawId(u: User): Str {
  // Tuple-struct fields are positional.
  u.id.0
}

// Structs destructure in patterns, and patterns DO have field shorthand
// (only record *literals* lack it).
fn describe(p: Point): Str {
  match (p) {
    Point { x: 0.0, y: 0.0 } => "origin",
    Point { x, y: 0.0 } => if (x > 0.0) { "positive x-axis" } else { "negative x-axis" },
    Point { x: 0.0, .. } => "y-axis",
    Point { .. } => "somewhere else",
  }
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let a = origin();
  let b = translate(a, 3.0, 4.0);

  let ada = newUser("u-1", "Ada").withEmail("ada@example.com");

  // Struct patterns work in `let` too, as long as they are irrefutable.
  let Point { x, y } = b;

  let _ = ctx.println("b        = (${x}, ${y})");
  let _ = ctx.println("distance = ${distanceSquared(a, b)}");
  let _ = ctx.println("describe = ${describe(b)}");
  let _ = ctx.println("user id  = ${rawId(ada)}");

  // Nominal typing means this is a type error, and that is the point:
  //   let m: Meters = 9.8;         // ERROR: F64 is not Meters
  let m = Meters(9.8);
  let _ = ctx.println("meters   = ${m.0}");

  let boxed = Boxed { value: 42, label: "answer" };
  let paired = Pair(1, "one");
  let _ = ctx.println("boxed    = ${boxed.label}=${boxed.value}, pair.1=${paired.1}");

  .Ok(())
}
