// 17 — Method chains, blocks, shadowing, and evaluation order

from "core/list" import * as list;
from "core/str" import * as str;
from "core/order" import * as order;
from "core/math" import * as math;
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

// --- Method chains -------------------------------------------------------------
//
//   x.f(a, b)   ==   f(x, a, b)
//
// The receiver comes first and the context second, so a chain reads in the order
// the data actually moves. This is what replaced the `|>` operator: every step
// here is an operation on the type it is called on, which is exactly the case
// method resolution covers.

fn topWords<C: Alloc>(ctx: C, text: Str, minLength: Int): [Str] {
  text
    .toLower(ctx)
    .split(ctx, " ")
    .filter(ctx, fn(w) => w.len() >= minLength)
    .sortBy(ctx, order.str)
    .take(ctx, 5)
}

// The same thing with every step named. Identical program; the chain above
// says the same thing without inventing five names for values that are used
// exactly once. Each `let` scopes to the rest of the block and no further.
fn topWordsNamed<C: Alloc>(ctx: C, text: Str, minLength: Int): [Str] {
  let lowered = text.toLower(ctx);
  let words = lowered.split(ctx, " ");
  let long = words.filter(ctx, fn(w) => w.len() >= minLength);
  let sorted = long.sortBy(ctx, order.str);
  sorted.take(ctx, 5)
}

// A step that is NOT an operation on the receiver's type cannot be a method —
// `slugify` below lives in this module, not in core/str. Bind it with `let`.
fn headline<C: Alloc>(ctx: C, text: Str): Str {
  let words = text.toLower(ctx).split(ctx, " ").take(ctx, 3);
  let joined = words.join(ctx, " ");
  joined.trim()
}

// --- Blocks --------------------------------------------------------------------
//
// A block is `let` bindings followed by a result expression. It is an
// expression, so it can appear anywhere a value can.

fn quadratic(a: F64, b: F64, c: F64): Option<(F64, F64)> {
  let discriminant = {
    let squared = b * b;
    squared - 4.0 * a * c
  };

  if (discriminant < 0.0) {
    .None
  } else {
    let root = math.sqrt(discriminant);
    let denominator = 2.0 * a;
    .Some(((-b + root) / denominator, (-b - root) / denominator))
  }
}

// A block whose last item is a `let` has type `{}`. That is the shape of a
// function that exists only for its effects.
fn banner<C: Stdout>(ctx: C, title: Str): () {
  let line = "------------------------";
  let _ = ctx.println(line);
  let _ = ctx.println(title);
  let _ = ctx.println(line);
}

// --- Shadowing ------------------------------------------------------------------
//
// Rebinding a name is legal, including in the same block. Nothing mutates: the
// earlier binding still exists, it is just no longer reachable by that name.

fn cleanup<C: Alloc>(ctx: C, raw: Str): Str {
  let value = raw.trim();
  let value = value.toLower(ctx);
  let value = value.replace(ctx, "  ", " ");
  value
}

// --- Evaluation order ------------------------------------------------------------
//
// Buri is strict, and the order is specified: `let` bindings run top to bottom,
// arguments left to right, and `&&`, `||`, `??` short-circuit. This is what
// makes effect sequencing meaningful in a language where effects are performed
// by ordinary calls instead of by a monad.

fn ordered<C: Stdout>(ctx: C): () {
  let _ = ctx.println("one");
  let _ = ctx.println("two");    // always after "one"
  let _ = ctx.println("three");  // always after "two"
}

fn shortCircuit(xs: [Int]): Bool {
  // `xs.len() > 0` is checked first; `xs[0] ?? 0` is only reached if it
  // holds. `??` evaluates its right operand only on None.
  xs.len() > 0 && (xs[0] ?? 0) > 100
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let text = "the quick brown fox jumps over the lazy dog";

  let _ = banner(ctx, "method chains");
  let chained = topWords(ctx, text, 4);
  let named = topWordsNamed(ctx, text, 4);
  let space = " ";
  let _ = ctx.println("chained = ${chained.join(ctx, space)}");
  let _ = ctx.println("named   = ${named.join(ctx, space)}");
  let _ = ctx.println("headline= ${headline(ctx, text)}");

  let _ = banner(ctx, "blocks");
  let _ = match (quadratic(1.0, -3.0, 2.0)) {
    .Some(roots) => ctx.println("roots  = ${roots.0}, ${roots.1}"),
    .None => ctx.println("roots  = none"),
  };

  let _ = banner(ctx, "shadowing");
  let messy = "   Mixed   CASE Input   ";
  let _ = ctx.println("cleaned = ${cleanup(ctx, messy)}");

  let _ = banner(ctx, "order");
  let _ = ordered(ctx);
  let _ = ctx.println("shortCircuit = ${shortCircuit([])}");

  .Ok(())
}
