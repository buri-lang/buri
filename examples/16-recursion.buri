// 16 — Recursion, accumulators, and tail calls
//
// Recursion is the only looping construct in Buri. Implementations must
// eliminate tail calls, including mutually recursive ones, so a tail-recursive
// function runs in constant stack space.

from "core/list" import * as list;
from "core/str" import * as str;
from "core/cap" import { Alloc, Stdout };
from "core/host" import * as host;

// --- Not tail recursive: the multiply happens after the recursive call ------

fn factorialNaive(n: Int): Int {
  if (n <= 1) { 1 } else { n * factorialNaive(n - 1) }
}

// --- Tail recursive: an accumulator carries the work forward ----------------
//
// The recursive call is the whole result expression, so the frame is reused.

fn factorial(n: Int): Int {
  factorialFrom(n, 1)
}

fn factorialFrom(n: Int, acc: Int): Int {
  if (n <= 1) { acc } else { factorialFrom(n - 1, acc * n) }
}

fn fib(n: Int): Int {
  fibFrom(n, 0, 1)
}

fn fibFrom(n: Int, a: Int, b: Int): Int {
  if (n == 0) { a } else { fibFrom(n - 1, b, a + b) }
}

// --- Mutual recursion, also tail-call eliminated -----------------------------

fn isEven(n: Int): Bool {
  if (n == 0) { true } else { isOdd(n - 1) }
}

fn isOdd(n: Int): Bool {
  if (n == 0) { false } else { isEven(n - 1) }
}

// --- Recursion over arrays ---------------------------------------------------
//
// Pattern matching on `[first, ..rest]` is the idiomatic replacement for an
// index variable, which you could not increment anyway.

fn sumAll(xs: [Int]): Int {
  match (xs) {
    [] => 0,
    [x, ..rest] => x + sumAll(rest),
  }
}

fn sumTail(xs: [Int]): Int {
  sumTailFrom(xs, 0)
}

fn sumTailFrom(xs: [Int], acc: Int): Int {
  match (xs) {
    [] => acc,
    [x, ..rest] => sumTailFrom(rest, acc + x),
  }
}

fn findFirst<T>(pred: fn(T) => Bool, xs: [T]): Option<T> {
  match (xs) {
    [] => .None,
    [x, ..rest] => if (pred(x)) { .Some(x) } else { findFirst(pred, rest) },
  }
}

// --- Recursion over trees ----------------------------------------------------

enum Tree<T> {
  Leaf,
  Node(Tree<T>, T, Tree<T>),
}

fn depth<T>(t: Tree<T>): Int {
  match (t) {
    .Leaf => 0,
    .Node(l, _, r) => {
      let dl = depth(l);
      let dr = depth(r);
      1 + if (dl > dr) { dl } else { dr }
    },
  }
}

fn toArray<C: Alloc, T>(ctx: C, t: Tree<T>): [T] {
  match (t) {
    .Leaf => [],
    .Node(l, v, r) => {
      let left = toArray(ctx, l);
      let right = toArray(ctx, r);
      left.push(ctx, v).concat(ctx, right)
    },
  }
}

// --- Recursion over Str -------------------------------------------------------
//
// `str.slice` is pure, so walking a string costs nothing but time.

fn countChar(needle: Char, s: Str): Int {
  countCharFrom(needle, s, 0, 0)
}

fn countCharFrom(needle: Char, s: Str, i: Int, acc: Int): Int {
  if (i >= s.len()) {
    acc
  } else {
    let matched = match (s.charAt(i)) {
      .Some(c) => c == needle,
      .None => false,
    };
    countCharFrom(needle, s, i + 1, if (matched) { acc + 1 } else { acc })
  }
}

// --- Collatz, as an example of "loop until" ----------------------------------

fn collatzSteps(n: Int): Int {
  collatzFrom(n, 0)
}

fn collatzFrom(n: Int, steps: Int): Int {
  if (n <= 1) {
    steps
  } else if (n % 2 == 0) {
    collatzFrom(n / 2, steps + 1)
  } else {
    collatzFrom(3 * n + 1, steps + 1)
  }
}

export fn main(): Result<(), Str> {
  let ctx = context {
    Alloc:  host.alloc,
    Stdout: host.stdout,
  };

  let xs: [Int] = [4, 8, 15, 16, 23, 42];

  let tree =
    Tree.Node(
      Tree.Node(Tree.Leaf, 1, Tree.Leaf),
      2,
      Tree.Node(Tree.Leaf, 3, Tree.Node(Tree.Leaf, 4, Tree.Leaf)),
    );

  let _ = ctx.println("factorial 10 = ${factorial(10)}");
  let _ = ctx.println("naive 10     = ${factorialNaive(10)}");
  let _ = ctx.println("fib 30       = ${fib(30)}");

  // Constant stack space: this would overflow in a language without
  // guaranteed tail calls.
  let _ = ctx.println("isEven 1e6   = ${isEven(1_000_000)}");

  let _ = ctx.println("sumAll       = ${sumAll(xs)}");
  let _ = ctx.println("sumTail      = ${sumTail(xs)}");
  let _ = ctx.println("findFirst    = ${findFirst(fn(x) => x > 15, xs) ?? -1}");
  let _ = ctx.println("depth        = ${depth(tree)}");
  let _ = ctx.println("flattened    = ${toArray(ctx, tree).len()} nodes");
  let phrase = "parallel lines";
  let _ = ctx.println("count 'l'    = ${countChar('l', phrase)}");
  let _ = ctx.println("collatz 27   = ${collatzSteps(27)}");

  .Ok(())
}
