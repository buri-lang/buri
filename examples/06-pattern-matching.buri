// 06 — Pattern matching
//
// `match` is exhaustive, ordered, and the primary control-flow construct.
// A non-exhaustive match is a compile error; an unreachable arm is too.

from "core/io" import * as io;
from "core/list" import * as list;
from "core/cap" import { Alloc, Stdout };

struct Point { x: Int, y: Int }
struct Meters(F64);

enum Token {
  Number(Int),
  Word(Str),
  Symbol(Char),
  Eof,
}

enum Node {
  Leaf(Int),
  Branch { left: Node, right: Node },
}

// --- Literals, wildcards, guards --------------------------------------------

fn classify(n: Int): Str {
  match (n) {
    0 => "zero",
    1 | 2 | 3 => "small",
    -1 => "minus one",
    // A guard runs only after its pattern matched. Guards do not count toward
    // exhaustiveness, so a catch-all arm is still required.
    m if m < 0 => "negative",
    m if m > 1000 => "huge",
    _ => "ordinary",
  }
}

// --- Enum variants ----------------------------------------------------------
//
// Variants must be written qualified (`Token.Eof`) or with the leading dot
// (`.Eof`). A bare identifier in a pattern is ALWAYS a new binding: writing
// `Eof =>` would silently bind every token to a variable named `Eof`.
// Requiring the dot is what lets the parser work without name resolution.

fn tokenText(t: Token): Str {
  match (t) {
    .Number(0) => "zero literal",
    .Number(n) if n < 0 => "negative literal",
    .Number(_) => "number",
    .Word(w) => w,
    .Symbol(';') => "semicolon",
    .Symbol(_) => "symbol",
    .Eof => "<eof>",
  }
}

// --- Structs, tuples, records -----------------------------------------------

fn quadrant(p: Point): Str {
  match (p) {
    Point { x: 0, y: 0 } => "origin",
    // Field shorthand is allowed in patterns (unlike in record literals).
    Point { x, y } if x > 0 && y > 0 => "I",
    Point { x, y } if x < 0 && y > 0 => "II",
    Point { x, y } if x < 0 && y < 0 => "III",
    Point { x, y } if x > 0 && y < 0 => "IV",
    Point { .. } => "on an axis",
  }
}

fn diagonal(pair: (Point, Point)): Bool {
  match (pair) {
    (Point { x: x1, y: y1 }, Point { x: x2, y: y2 }) => (x2 - x1) == (y2 - y1),
  }
}

fn unwrapMeters(m: Meters): F64 {
  // Tuple-struct pattern.
  match (m) {
    Meters(v) => v,
  }
}

// Anonymous record patterns, used constantly for contexts.
fn hasAlloc(ctx: { alloc: Alloc, .. }): Bool {
  match (ctx) {
    { alloc, .. } => {
      let _ = alloc;
      true
    },
  }
}

// --- Arrays -----------------------------------------------------------------

fn summarize(xs: [Int]): Str {
  match (xs) {
    [] => "empty",
    [_] => "one element",
    [a, b] if a == b => "a matched pair",
    [_, _] => "two elements",
    // A rest pattern binds the tail. It may only appear in final position.
    // `[]`, `[_]`, `[_, _]` and this arm together cover every length, so no
    // `_` arm is permitted here — an unreachable arm is a compile error.
    [_, ..rest] => if (rest.isEmpty()) { "unreachable" } else { "three or more" },
  }
}

// --- Binding a whole value with @ -------------------------------------------

fn keepOriginal(t: Token): Token {
  match (t) {
    whole @ .Number(n) if n > 100 => whole,
    .Number(_) => Token.Number(0),
    other => other,
  }
}

// --- Nested matching --------------------------------------------------------

fn depth(n: Node): Int {
  match (n) {
    .Leaf(_) => 1,
    .Branch { left: .Leaf(_), right: .Leaf(_) } => 2,
    .Branch { left, right } => {
      let l = depth(left);
      let r = depth(right);
      1 + if (l > r) { l } else { r }
    },
  }
}

// --- `let` patterns must be irrefutable -------------------------------------

fn destructuring(p: Point, pair: (Int, Str)): Int {
  let Point { x, y } = p;       // OK: a struct has exactly one shape
  let (n, label) = pair;        // OK: tuples are irrefutable
  // let .Some(v) = maybe;      // ERROR: refutable. Use `match` or `??`.
  let _ = label;
  x + y + n
}

export fn main(ctx: { alloc: Alloc, stdout: Stdout }): Result<{}, Str> {
  let p = Point { x: 3, y: -2 };
  let _ = io.println(ctx, "classify(-5)  = ${classify(-5)}");
  let _ = io.println(ctx, "token         = ${tokenText(Token.Symbol(';'))}");
  let _ = io.println(ctx, "quadrant      = ${quadrant(p)}");
  let _ = io.println(ctx, "diagonal      = ${diagonal((Point { x: 0, y: 0 }, p))}");
  let _ = io.println(ctx, "meters        = ${unwrapMeters(Meters(1.5))}");
  let _ = io.println(ctx, "hasAlloc      = ${hasAlloc(ctx)}");
  let _ = io.println(ctx, "summarize     = ${summarize([1, 2, 3])}");
  let _ = io.println(ctx, "depth         = ${depth(Node.Branch { left: Node.Leaf(1), right: Node.Leaf(2) })}");
  let pair = (7, "seven");
  let _ = io.println(ctx, "destructuring = ${destructuring(p, pair)}");
  let _ = keepOriginal(Token.Eof);
  .Ok({})
}
