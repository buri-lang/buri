//! The two sections of the language reference that a screenshot of an editor
//! is judged on: the structs of `lang/types.md` 5.6, and the import forms of
//! `lang/modules.md` 4.1. Every construct here is one `check_highlighting.sh`
//! asserts a colour for, in both layers — the grammar's and the server's.

from "core/effect/lib.buri" import { Alloc };
from "core/list/lib.buri" import * as list;
from "core/math/lib.buri" import { round as rounded };
from "core/str/lib.buri" import { fromFloat, fromInt };

/// How many times a lookup is retried before it gives up.
let MAX_RETRIES: Int = 3;

/// A user's identifier, distinct from the string inside it.
struct UserId(Str);

struct User {
    export id: UserId,
    export name: Str,
    // `passwordHash` is private to this module: no `export`.
    passwordHash: Str,
}

// A tuple struct, and a generic one.
struct Meters(export Float);

struct Pair<A, B>(A, B);

/// Where a shelf edge got its label.
export enum Source {
    /// The shelf itself.
    Shelf,
    /// A page of the printed catalogue.
    Catalogue { page: Int },
}

/* A block comment sits in the gap between two tokens, which is where both
   layers go looking for one. */

/// Every struct form the reference writes, in one body.
export fn describe<C: Alloc>(ctx: C, hash: Str): Str {
    let id = UserId("u1");
    let name = "Ada";
    let passwordHash = hash;
    let u = User { id: UserId("u1"), name: "Ada", passwordHash: hash };
    let shorthand = User { id, name, passwordHash };
    let u2 = User { ..u, name: "Ada L." };
    let d = Meters(rounded(9.8));
    let raw = d.0;
    let pair = Pair(raw, shorthand.name);
    let counts = list.range(ctx, 0, MAX_RETRIES);
    let nothing = list.empty<Int>();
    let origin = Source.Catalogue {
        page: u2.name.len() + counts.len() + nothing.len(),
    };
    let shelf: Source = .Shelf;
    match (origin) {
        .Catalogue { page } => shelf.label().concat(ctx, fromInt(ctx, page)),
        other => fromFloat(ctx, pair.0).concat(ctx, other.label()),
    }
}

impl Source {
    /// What the label says, whichever source it came from.
    fn label(self): Str {
        match (self) {
            .Shelf => "shelf",
            _ => "catalogue",
        }
    }
}

/// The anonymous literal of 5.6: the type is the annotation's, and the
/// braces hold the same fields a headed literal would.
export fn anonymous(hash: Str): User {
    let seed: User = { id: UserId("u2"), name: "Grace", passwordHash: hash };
    { ..seed, name: "Grace H." }
}

/// The two private-by-omission fields, read. `check_highlighting.sh` asserts
/// about a file the compiler has nothing to say about, and a field written at
/// every literal and read at none is a field `unused-field` has something to
/// say about — so the reads live here, after every row the tables pin.
export fn credential(u: User): Str {
    let stored = u.passwordHash;
    let mark = u.id.0;
    match (stored) {
        "" => mark,
        _ => stored,
    }
}
