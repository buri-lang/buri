//! core/orderedmap — a persistent B-tree keyed by `Ordered`.
//!
//! The collection `core/map` is not: keyed *and* ordered. Lookup, insert and
//! remove are O(log n). `entries`, `keys` and `values` come out in key order,
//! and `range` and `prefix` are scans that visit only what they answer rather
//! than filters over the whole map. Reach for a hash map instead when
//! expected-constant lookup beats logarithmic.
//!
//! **Why a B-tree, and why seven entries to a node.** Every write copies one
//! root-to-leaf path and shares the rest of the tree, which is what makes an
//! immutable collection affordable. A node holding at most `2t - 1` entries
//! makes the tree about `log_t n` deep, so what decides the arity is everything
//! a node costs *besides* its entries: here the heap blocks the runtime
//! reference-counts, plus retain/release traffic along the copied path. Seven
//! entries — minimum degree four, so three at the least outside the root — buys
//! between a half and a third of a binary tree's depth, and so that fraction of
//! its allocations, for roughly two to three times the entries moved. It is also
//! short enough that the linear scan within a node beats a binary search's
//! branches.
//!
//! **`range` is half-open**: `start` is in, `end` is out, so adjacent ranges
//! tile without overlapping and `range(ctx, k, k)` is empty.
//!
//! **`prefix` is `Str` only, and means a prefix of the key's scalar values.**
//! `Str.compare` is lexicographic over Unicode scalar values and `startsWith`
//! asks about the same units, which is what makes the matching keys one
//! contiguous run. So `prefix` is a `range` whose upper end is a predicate
//! rather than a key — it invents no successor string, and `prefix(ctx, "")` is
//! every entry.
//!
//! **A compound key is a struct with `derive Ordered`.** Tuples have no methods, so
//! a tuple is not `Ordered`. A derived `Ordered` compares fields in declaration order,
//! which is what a multi-column index wants.
//!
//! **Two maps are equal when they hold the same entries**, whatever order they
//! were built in and whatever shape that gave their trees. So a struct holding
//! one can `derive Equal, Show`, which is what a generated protobuf message does.
//!
//! ```buri run
//! from "core/io" import * as io;
//! from "core/orderedmap" import * as orderedmap;
//! from "node" import { NodeHost };
//! from "platform/effect" import { Allocator, Stdout };
//!
//! export fn main(host: NodeHost): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let scores = orderedmap.of(ctx, [("carol", 3), ("alice", 1), ("bob", 2)]);
//!     // Key order, whatever order the entries arrived in.
//!     let names = scores.keys(ctx).join(ctx, " ");
//!     // Half-open: "alice" and "bob" are in the scan, "carol" is not.
//!     let scanned = scores.range(ctx, "alice", "carol").length();
//!     let _ = io.println(ctx, "${names}: ${scanned} in [alice, carol)").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! alice bob carol: 2 in [alice, carol)
//! ```

from "core/list" import * as list;
from "core/order" import { Equal, Show };
from "core/str" import * as str;
from "platform/effect" import { Allocator };

/// The most entries a node may hold: minimum degree four, so `2 * 4 - 1`.
/// The module comment says why four.
let MAX_ENTRIES: Int = 7;

/// The fewest any node but the root may hold. A split of `MAX_ENTRIES + 1`
/// entries leaves this many on the short side, and a merge of two short nodes
/// and a separator fits.
let MIN_ENTRIES: Int = MAX_ENTRIES / 2;

/// A node. A leaf holds entries: its keys in order and the value under each,
/// and no children. A branch holds no values: its keys are separators, and it
/// has one more child than it has keys. Every key under child `i` is at least
/// separator `i - 1` and below separator `i`. The functions that split, borrow
/// and merge maintain that, which the type cannot express.
///
/// Keys and values are two lists rather than one list of pairs, so a search
/// reads keys alone: a lookup copies no value but the one it answers, and
/// `has` copies none. Every value sits in a leaf, so `values` and `keys` are
/// the leaves' own lists end to end.
struct Node<K, V> {
    keys: [K],
    values: [V],
    children: [Node<K, V>],
}

/// An ordered map, as a value.
///
/// `size` is carried rather than walked: callers ask `length` far more often than
/// the tree changes.
export struct OrderedMap<K, V> {
    root: Node<K, V>,
    export size: Int,
}

/// The empty map. Pure: a context type has no name, so a `<K, V, C>` here could
/// not be written at a call site.
export fn empty<K, V>(): OrderedMap<K, V> {
    OrderedMap { root: leaf(list.empty<K>(), list.empty<V>()), size: 0 }
}

fn leaf<K, V>(keys: [K], values: [V]): Node<K, V> {
    Node { keys: keys, values: values, children: list.empty<Node<K, V>>() }
}

fn branch<K, V>(keys: [K], children: [Node<K, V>]): Node<K, V> {
    Node { keys: keys, values: list.empty<V>(), children: children }
}

fn isLeaf<K, V>(n: Node<K, V>): Bool {
    n.children.isEmpty()
}

/// The elements of `items` collected under `key(x)`, each group in the order the
/// elements arrived in and the keys in key order.
///
/// A free function rather than a method on `[T]`, because the answer is a map
/// and `core/list` is the bottom of the dependency order. `core/map` has the
/// same pair for an unordered answer.
export fn groupBy<A, K: Ordered, C: Allocator>(
    ctx: C,
    items: [A],
    key: fn(A) => K,
): OrderedMap<K, [A]> {
    collected(
        ctx,
        items.map(ctx, fn(x) => (key(x), x)),
        fn(_c, x) => [x],
        fn(c, group, x) => group.push(c, x),
    )
}

/// How many elements answer each key, the keys in key order. `core/map` has the
/// same pair for an unordered answer.
export fn countBy<A, K: Ordered, C: Allocator>(
    ctx: C,
    xs: [A],
    key: fn(A) => K,
): OrderedMap<K, Int> {
    collected(
        ctx,
        xs.map(ctx, fn(x) => (key(x), 1)),
        fn(_c, one) => one,
        fn(_c, n, one) => n + one,
    )
}

/// One element per key rather than a group of them: `key(x)` to `x`, with a
/// later element replacing an earlier one that answered the same key.
export fn indexBy<A, K: Ordered, C: Allocator>(
    ctx: C,
    items: [A],
    key: fn(A) => K,
): OrderedMap<K, A> {
    of(ctx, items.map(ctx, fn(x) => (key(x), x)))
}

/// A map holding the given entries, later ones winning.
///
/// Entries already in key order are built in one pass, as `fromSorted` builds
/// them. Any others are sorted first, which costs O(n log n) comparisons but
/// far less than an insert per key, because an insert copies a root-to-leaf
/// path.
export fn of<K: Ordered, V, C: Allocator>(ctx: C, entries: [(K, V)]): OrderedMap<K, V> {
    match (unsorted(entries)) {
        .None => sorted(ctx, entries),
        .Some(_at) => collected(ctx, entries, fn(_c, v) => v, fn(_c, _old, v) => v),
    }
}

/// The map of `pairs` sorted by key, each run of equal keys collapsed into one
/// entry: `first` makes it from the run's first value and `next` adds each
/// later one. The sort is stable, so a run is in arrival order, and the key
/// kept is the run's last, as an insert would keep it.
fn collected<K: Ordered, V, W, C: Allocator>(
    ctx: C,
    pairs: [(K, V)],
    first: fn(C, V) => W,
    next: fn(C, W, V) => W,
): OrderedMap<K, W> {
    let inOrder = pairs.sortBy(ctx, fn(a, b) => {
        let (ka, _va) = a;
        let (kb, _vb) = b;
        ka.compare(kb)
    });
    sorted(ctx, runs(ctx, inOrder, first, next, 0, list.empty<(K, W)>()))
}

fn runs<K: Ordered, V, W, C: Allocator>(
    ctx: C,
    pairs: [(K, V)],
    first: fn(C, V) => W,
    next: fn(C, W, V) => W,
    at: Int,
    acc: [(K, W)],
): [(K, W)] {
    match (pairs.get(at)) {
        .None => acc,
        .Some(p) => {
            let (k, v) = p;
            let (end, run) = runFrom(ctx, pairs, next, at + 1, (k, first(ctx, v)));
            runs(ctx, pairs, first, next, end, acc.push(ctx, run))
        },
    }
}

/// The run that `run` began, extended over every following pair with an equal
/// key, and the index just past it.
fn runFrom<K: Ordered, V, W, C: Allocator>(
    ctx: C,
    pairs: [(K, V)],
    next: fn(C, W, V) => W,
    at: Int,
    run: (K, W),
): (Int, (K, W)) {
    let (k, w) = run;
    match (pairs.get(at)) {
        .None => (at, run),
        .Some(p) => {
            let (pk, v) = p;
            if (k.compare(pk).isEqual()) {
                runFrom(ctx, pairs, next, at + 1, (pk, next(ctx, w, v)))
            } else {
                (at, run)
            }
        },
    }
}

/// A map of entries already in key order, built in one O(n) pass rather than
/// one insert per key.
///
/// The keys must be strictly increasing. Otherwise the answer is `.Err(i)`, the
/// index of the first entry whose key is not greater than the one before it.
///
/// ```buri run
/// from "core/io" import * as io;
/// from "core/orderedmap" import * as orderedmap;
/// from "node" import { NodeHost };
/// from "platform/effect" import { Allocator, Stdout };
///
/// export fn main(host: NodeHost): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let days = match (
///         orderedmap.fromSorted(ctx, [(1, "mon"), (2, "tue"), (3, "wed")])
///     ) {
///         .Ok(m) => m.length(),
///         .Err(_at) => 0,
///     };
///     // Key 2 comes after key 3, so index 2 is the first out of order.
///     let refused = match (
///         orderedmap.fromSorted(ctx, [(1, "mon"), (3, "wed"), (2, "tue")])
///     ) {
///         .Ok(_m) => -1,
///         .Err(at) => at,
///     };
///     let _ = io.println(ctx, "${days} days; out of order at ${refused}").ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// 3 days; out of order at 2
/// ```
export fn fromSorted<K: Ordered, V, C: Allocator>(
    ctx: C,
    entries: [(K, V)],
): Result<OrderedMap<K, V>, Int> {
    match (unsorted(entries)) {
        .None => .Ok(sorted(ctx, entries)),
        .Some(at) => .Err(at),
    }
}

/// The index of the first entry whose key is not greater than the one before
/// it.
fn unsorted<K: Ordered, V>(entries: [(K, V)]): Option<Int> {
    match (entries.get(0)) {
        .None => .None,
        .Some(e) => {
            let (k, _v) = e;
            unsortedAfter(entries, k, 1)
        },
    }
}

fn unsortedAfter<K: Ordered, V>(entries: [(K, V)], before: K, at: Int): Option<Int> {
    match (entries.get(at)) {
        .None => .None,
        .Some(e) => {
            let (k, _v) = e;
            if (before.compare(k).isLess()) {
                unsortedAfter(entries, k, at + 1)
            } else {
                .Some(at)
            }
        },
    }
}

// -----------------------------------------------------------------------------
// Building bottom-up
//
// The leaves come from the entries, `ceil(n / MAX_ENTRIES)` of them with the
// entries spread evenly, so no two differ by more than one. Each leaf's first
// key but the first leaf's is a separator in the level above. Each branch
// level is built from the one below it, with one separator held back between
// each pair of neighbouring nodes: the separators held back are the next
// level's, and the nodes just built are its children. A level that fits in one
// node is the root.
//
// A branch level of n separators makes `ceil((n + 1) / (MAX_ENTRIES + 1))`
// nodes, the fewest that hold n once the separators between them are taken
// out. For n above `MAX_ENTRIES` that is at least `MIN_ENTRIES` a node, as it
// is for the leaves, so every node but the root starts at or above its
// minimum, and every leaf sits at the same depth. That is all insert and
// remove ask of a tree. The nodes are nearly full, which keeps the tree
// shallow and its node count low; an insert into a full one splits it the way
// any insert would.
// -----------------------------------------------------------------------------

/// A map of `entries`, which the caller knows are strictly increasing by key.
fn sorted<K, V, C: Allocator>(ctx: C, entries: [(K, V)]): OrderedMap<K, V> {
    let keys = entries.map(ctx, fn(e) => e.0);
    let values = entries.map(ctx, fn(e) => e.1);
    let n = entries.length();
    let root = if (n <= MAX_ENTRIES) {
        leaf(keys, values)
    } else {
        let count = (n + MAX_ENTRIES - 1) / MAX_ENTRIES;
        let none = branch(list.empty<K>(), list.empty<Node<K, V>>());
        level(ctx, leaves(ctx, keys, values, n / count, n % count, 0, none))
    };
    OrderedMap { root: root, size: n }
}

/// The leaves over `keys` and `values` from entry `at`, as the children of the
/// level above, each first key but the first leaf's its separator. The first
/// `extra` leaves take one entry more than `base`.
fn leaves<K, V, C: Allocator>(
    ctx: C,
    keys: [K],
    values: [V],
    base: Int,
    extra: Int,
    at: Int,
    above: Node<K, V>,
): Node<K, V> {
    match (keys.get(at)) {
        .None => above,
        .Some(first) => {
            let size = if (above.children.length() < extra) { base + 1 } else { base };
            let built = leaf(
                keys.slice(ctx, at, at + size),
                values.slice(ctx, at, at + size),
            );
            let separators = if (at == 0) {
                above.keys
            } else {
                above.keys.push(ctx, first)
            };
            let next = branch(separators, above.children.push(ctx, built));
            leaves(ctx, keys, values, base, extra, at + size, next)
        },
    }
}

/// The tree over one branch level: `flat`'s separators and the children
/// between them. A level that fits in one node is that node.
fn level<K, V, C: Allocator>(ctx: C, flat: Node<K, V>): Node<K, V> {
    let n = flat.keys.length();
    if (n <= MAX_ENTRIES) {
        flat
    } else {
        let count = (n + MAX_ENTRIES + 1) / (MAX_ENTRIES + 1);
        let held = n - (count - 1);
        let none = branch(list.empty<K>(), list.empty<Node<K, V>>());
        level(ctx, group(ctx, flat, held / count, held % count, 0, none))
    }
}

/// The nodes of one branch level, starting at separator `at`, as the children
/// of the level above, with the separators between them as its own. The first
/// `extra` nodes take one separator more than `base`.
fn group<K, V, C: Allocator>(
    ctx: C,
    flat: Node<K, V>,
    base: Int,
    extra: Int,
    at: Int,
    above: Node<K, V>,
): Node<K, V> {
    let size = if (above.children.length() < extra) { base + 1 } else { base };
    let end = at + size;
    let built = branch(
        flat.keys.slice(ctx, at, end),
        flat.children.slice(ctx, at, end + 1),
    );
    let nodes = above.children.push(ctx, built);
    match (flat.keys.get(end)) {
        .None => branch(above.keys, nodes),
        .Some(k) => {
            group(
                ctx,
                flat,
                base,
                extra,
                end + 1,
                branch(above.keys.push(ctx, k), nodes),
            )
        },
    }
}

/// Whether a merge of `few` keys into `many` should insert them one at a time
/// rather than walk both maps and build a new one.
fn fewInto(few: Int, many: Int): Bool {
    few * ENTRIES_PER_INSERT < many
}

/// Roughly how many entries a merge can walk and build for the cost of one
/// insert, which copies a root-to-leaf path. Measured at about 40 on a map of
/// 150,000, natively; this errs toward inserting.
let ENTRIES_PER_INSERT: Int = 32;

/// Two entry lists in key order, merged into one, with `combine(mine, theirs)`
/// deciding a key in both. The key kept is `theirs`, as an insert would keep
/// it.
fn interleave<K: Ordered, V, C: Allocator>(
    ctx: C,
    mine: [(K, V)],
    theirs: [(K, V)],
    combine: fn(V, V) => V,
    i: Int,
    j: Int,
    acc: [(K, V)],
): [(K, V)] {
    match (mine.get(i)) {
        .None => acc.concat(ctx, theirs.drop(ctx, j)),
        .Some(a) => {
            match (theirs.get(j)) {
                .None => acc.concat(ctx, mine.drop(ctx, i)),
                .Some(b) => {
                    let (ka, va) = a;
                    let (kb, vb) = b;
                    match (ka.compare(kb)) {
                        .Less => {
                            interleave(
                                ctx,
                                mine,
                                theirs,
                                combine,
                                i + 1,
                                j,
                                acc.push(ctx, a),
                            )
                        },
                        .Greater => {
                            interleave(
                                ctx,
                                mine,
                                theirs,
                                combine,
                                i,
                                j + 1,
                                acc.push(ctx, b),
                            )
                        },
                        .Equal => {
                            let both = (kb, combine(va, vb));
                            interleave(
                                ctx,
                                mine,
                                theirs,
                                combine,
                                i + 1,
                                j + 1,
                                acc.push(ctx, both),
                            )
                        },
                    }
                },
            }
        },
    }
}

// -----------------------------------------------------------------------------
// Splicing
//
// Free functions over an unbounded `T` rather than lambdas, because a lambda
// may not capture a value whose type could be a context (SPEC 10.6). Each is
// `core/list`'s splices, which copy a node once, or write into it where it is
// unique, where `take`, `push`, `concat` and `drop` built it three times over.
// -----------------------------------------------------------------------------

fn insertAt<T, C: Allocator>(ctx: C, xs: [T], at: Int, x: T): [T] {
    xs.insertAt(ctx, at, x)
}

fn replaceAt<T, C: Allocator>(ctx: C, xs: [T], at: Int, x: T): [T] {
    xs.replaceAt(ctx, at, x)
}

fn removeAt<T, C: Allocator>(ctx: C, xs: [T], at: Int): [T] {
    xs.removeAt(ctx, at)
}

/// Replaces `xs[at]` with two, which is what a split hands its parent.
fn splitAt<T, C: Allocator>(ctx: C, xs: [T], at: Int, a: T, b: T): [T] {
    xs.replaceAt(ctx, at, a).insertAt(ctx, at + 1, b)
}

/// Replaces `xs[at]` and `xs[at + 1]` with one, which is what a merge leaves.
fn joinAt<T, C: Allocator>(ctx: C, xs: [T], at: Int, x: T): [T] {
    xs.replaceAt(ctx, at, x).removeAt(ctx, at + 1)
}

// -----------------------------------------------------------------------------
// The shape of a node
// -----------------------------------------------------------------------------

/// A leaf's entry at `at`, if there is one.
fn entryAt<K, V>(n: Node<K, V>, at: Int): Option<(K, V)> {
    match (n.keys.get(at)) {
        .None => .None,
        .Some(k) => {
            match (n.values.get(at)) {
                .None => .None,
                .Some(v) => .Some((k, v)),
            }
        },
    }
}

/// Where `key` belongs among `keys`, and whether it is already there.
///
/// Linear from `at`. A node holds at most `MAX_ENTRIES`, so this is a bounded
/// scan; the module comment says why a short one beats a binary search.
fn seek<K: Ordered>(keys: [K], key: K, at: Int): (Int, Bool) {
    match (keys.get(at)) {
        .None => (at, false),
        .Some(k) => {
            match (key.compare(k)) {
                .Less => (at, false),
                .Equal => (at, true),
                .Greater => seek(keys, key, at + 1),
            }
        },
    }
}

/// The child of a branch that `key` belongs under: one past every separator
/// at or below it.
fn route<K: Ordered, V>(n: Node<K, V>, key: K): Int {
    let (at, found) = seek(n.keys, key, 0);
    if (found) { at + 1 } else { at }
}

// -----------------------------------------------------------------------------
// Reading
// -----------------------------------------------------------------------------

fn lookup<K: Ordered, V>(n: Node<K, V>, key: K): Option<V> {
    if (isLeaf(n)) {
        let (at, found) = seek(n.keys, key, 0);
        if (found) { n.values.get(at) } else { .None }
    } else {
        match (n.children.get(route(n, key))) {
            .None => .None,
            .Some(child) => lookup(child, key),
        }
    }
}

/// `lookup` without the value.
fn holds<K: Ordered, V>(n: Node<K, V>, key: K): Bool {
    if (isLeaf(n)) {
        let (_at, found) = seek(n.keys, key, 0);
        found
    } else {
        match (n.children.get(route(n, key))) {
            .None => false,
            .Some(child) => holds(child, key),
        }
    }
}

fn leftmost<K, V>(n: Node<K, V>): Option<(K, V)> {
    match (n.children.get(0)) {
        .None => entryAt(n, 0),
        .Some(child) => leftmost(child),
    }
}

fn rightmost<K, V>(n: Node<K, V>): Option<(K, V)> {
    match (n.children.get(n.children.length() - 1)) {
        .None => entryAt(n, n.keys.length() - 1),
        .Some(child) => rightmost(child),
    }
}

// -----------------------------------------------------------------------------
// Insert
// -----------------------------------------------------------------------------

/// What a subtree answers an insert with: itself, or the two halves it broke
/// into and the separator between them.
enum Grown<K, V> {
    Fit(Node<K, V>),
    Split(Node<K, V>, K, Node<K, V>),
}

/// A node that may be holding one key too many, split if it is.
///
/// A leaf splits in two and its right half's first key goes up as a copy. A
/// branch's middle separator moves up and leaves it. Either way the tree grows
/// at the root and every leaf stays the same distance from it.
fn overfull<K, V, C: Allocator>(ctx: C, n: Node<K, V>): Grown<K, V> {
    let count = n.keys.length();
    let half = count / 2;
    if (count <= MAX_ENTRIES) {
        .Fit(n)
    } else if (isLeaf(n)) {
        let right = leaf(n.keys.drop(ctx, half), n.values.drop(ctx, half));
        match (right.keys.get(0)) {
            .None => .Fit(n),
            .Some(up) => {
                .Split(
                    leaf(n.keys.take(ctx, half), n.values.take(ctx, half)),
                    up,
                    right,
                )
            },
        }
    } else {
        match (n.keys.get(half)) {
            .None => .Fit(n),
            .Some(up) => {
                .Split(
                    branch(n.keys.take(ctx, half), n.children.take(ctx, half + 1)),
                    up,
                    branch(n.keys.drop(ctx, half + 1), n.children.drop(ctx, half + 1)),
                )
            },
        }
    }
}

/// Answers the subtree after the insert, and whether the key was a new one.
///
/// The `Bool` keeps `size` right without a second descent.
fn insertInto<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    key: K,
    value: V,
): (Grown<K, V>, Bool) {
    if (isLeaf(n)) {
        let (at, found) = seek(n.keys, key, 0);
        if (found) {
            let replaced = leaf(
                replaceAt(ctx, n.keys, at, key),
                replaceAt(ctx, n.values, at, value),
            );
            (.Fit(replaced), false)
        } else {
            let added = leaf(
                insertAt(ctx, n.keys, at, key),
                insertAt(ctx, n.values, at, value),
            );
            (overfull(ctx, added), true)
        }
    } else {
        let at = route(n, key);
        match (n.children.get(at)) {
            .None => (.Fit(n), false),
            .Some(child) => {
                let (grown, added) = insertInto(ctx, child, key, value);
                match (grown) {
                    .Fit(one) => (.Fit(placed(ctx, n, at, one)), added),
                    .Split(left, up, right) => {
                        let wider = branch(
                            insertAt(ctx, n.keys, at, up),
                            splitAt(ctx, n.children, at, left, right),
                        );
                        (overfull(ctx, wider), added)
                    },
                }
            },
        }
    }
}

// -----------------------------------------------------------------------------
// Remove
// -----------------------------------------------------------------------------

/// The branch `n` with `child` put back at `at`.
fn placed<K, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    at: Int,
    child: Node<K, V>,
): Node<K, V> {
    branch(n.keys, replaceAt(ctx, n.children, at, child))
}

/// Puts `child` back at `at`, restoring the minimum occupancy if it fell short
/// — by borrowing one key from a sibling, or by merging with one.
///
/// The result may itself be short, which is what the caller's own `fixChild`
/// handles; at the root, `shrinkRoot` handles it instead.
fn fixChild<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    at: Int,
    child: Node<K, V>,
): Node<K, V> {
    if (child.keys.length() >= MIN_ENTRIES) {
        placed(ctx, n, at, child)
    } else if (at > 0) {
        match (n.children.get(at - 1)) {
            .None => placed(ctx, n, at, child),
            .Some(left) => fixWithLeft(ctx, n, at, child, left),
        }
    } else {
        match (n.children.get(at + 1)) {
            .None => placed(ctx, n, at, child),
            .Some(right) => fixWithRight(ctx, n, at, child, right),
        }
    }
}

/// The short child and the sibling before it: move one key across, or fuse
/// the two. Separator `at - 1` sits between them.
fn fixWithLeft<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    at: Int,
    child: Node<K, V>,
    left: Node<K, V>,
): Node<K, V> {
    let last = left.keys.length() - 1;
    match ((n.keys.get(at - 1), left.keys.get(last))) {
        (.Some(separator), .Some(up)) => {
            if (left.keys.length() > MIN_ENTRIES) {
                // The sibling's last entry moves into the short child, and its
                // key is the separator between them now.
                let (grownChild, shrunkLeft, between) = if (isLeaf(child)) {
                    match (left.values.get(last)) {
                        .None => (child, left, separator),
                        .Some(v) => {
                            (
                                leaf(
                                    insertAt(ctx, child.keys, 0, up),
                                    insertAt(ctx, child.values, 0, v),
                                ),
                                leaf(
                                    left.keys.take(ctx, last),
                                    left.values.take(ctx, last),
                                ),
                                up,
                            )
                        },
                    }
                } else {
                    // A branch's separator comes down into the short child and the
                    // sibling's last goes up, with the subtree between them.
                    (
                        branch(
                            insertAt(ctx, child.keys, 0, separator),
                            left
                                .children
                                .drop(ctx, last + 1)
                                .concat(ctx, child.children),
                        ),
                        branch(
                            left.keys.take(ctx, last),
                            left.children.take(ctx, last + 1),
                        ),
                        up,
                    )
                };
                let children = replaceAt(
                    ctx,
                    replaceAt(ctx, n.children, at, grownChild),
                    at - 1,
                    shrunkLeft,
                );
                branch(replaceAt(ctx, n.keys, at - 1, between), children)
            } else {
                // At most `MIN_ENTRIES` each side, plus a branch's separator, so
                // the fused node is never overfull.
                let merged = if (isLeaf(child)) {
                    leaf(
                        left.keys.concat(ctx, child.keys),
                        left.values.concat(ctx, child.values),
                    )
                } else {
                    branch(
                        left.keys.push(ctx, separator).concat(ctx, child.keys),
                        left.children.concat(ctx, child.children),
                    )
                };
                branch(
                    removeAt(ctx, n.keys, at - 1),
                    joinAt(ctx, n.children, at - 1, merged),
                )
            }
        },
        _ => placed(ctx, n, at, child),
    }
}

/// The mirror of [`fixWithLeft`], for the child that has no sibling before it.
/// Separator `at` sits between them.
fn fixWithRight<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    at: Int,
    child: Node<K, V>,
    right: Node<K, V>,
): Node<K, V> {
    match ((n.keys.get(at), right.keys.get(0))) {
        (.Some(separator), .Some(up)) => {
            if (right.keys.length() > MIN_ENTRIES) {
                let (grownChild, shrunkRight, between) = if (isLeaf(child)) {
                    let shrunk = leaf(
                        right.keys.drop(ctx, 1),
                        right.values.drop(ctx, 1),
                    );
                    match ((right.values.get(0), shrunk.keys.get(0))) {
                        (.Some(v), .Some(next)) => {
                            (
                                leaf(
                                    child.keys.push(ctx, up),
                                    child.values.push(ctx, v),
                                ),
                                shrunk,
                                next,
                            )
                        },
                        _ => (child, right, separator),
                    }
                } else {
                    (
                        branch(
                            child.keys.push(ctx, separator),
                            child.children.concat(ctx, right.children.take(ctx, 1)),
                        ),
                        branch(right.keys.drop(ctx, 1), right.children.drop(ctx, 1)),
                        up,
                    )
                };
                let children = replaceAt(
                    ctx,
                    replaceAt(ctx, n.children, at, grownChild),
                    at + 1,
                    shrunkRight,
                );
                branch(replaceAt(ctx, n.keys, at, between), children)
            } else {
                let merged = if (isLeaf(child)) {
                    leaf(
                        child.keys.concat(ctx, right.keys),
                        child.values.concat(ctx, right.values),
                    )
                } else {
                    branch(
                        child.keys.push(ctx, separator).concat(ctx, right.keys),
                        child.children.concat(ctx, right.children),
                    )
                };
                branch(removeAt(ctx, n.keys, at), joinAt(ctx, n.children, at, merged))
            }
        },
        _ => placed(ctx, n, at, child),
    }
}

/// The leaf `n` without its entry at `at`.
fn without<K, V, C: Allocator>(ctx: C, n: Node<K, V>, at: Int): Node<K, V> {
    leaf(removeAt(ctx, n.keys, at), removeAt(ctx, n.values, at))
}

/// Answers the subtree after the removal, and whether a key actually went.
///
/// Every entry sits in a leaf, so every removal is a removal from a leaf. A
/// separator equal to the key it removed still routes as it did.
fn removeFrom<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    key: K,
): (Node<K, V>, Bool) {
    if (isLeaf(n)) {
        let (at, found) = seek(n.keys, key, 0);
        if (found) { (without(ctx, n, at), true) } else { (n, false) }
    } else {
        let at = route(n, key);
        match (n.children.get(at)) {
            .None => (n, false),
            .Some(child) => {
                let (shrunk, gone) = removeFrom(ctx, child, key);
                if (gone) { (fixChild(ctx, n, at, shrunk), true) } else { (n, false) }
            },
        }
    }
}

/// A root branch left with no separators has exactly one child, and that child
/// is the tree. This is the only place the tree gets shallower.
fn shrinkRoot<K, V>(n: Node<K, V>): Node<K, V> {
    if (n.keys.isEmpty()) {
        match (n.children.get(0)) {
            .None => n,
            .Some(only) => only,
        }
    } else {
        n
    }
}

/// The leftmost entry, and the subtree without it.
///
/// **One descent.** It walks the left spine to the leaf the entry sits in,
/// takes it out, and repairs every node on the way back up — so a work queue
/// pays for one root-to-leaf path rather than the two that `first` followed by
/// `remove` costs. It compares nothing: the smallest key is wherever the shape
/// says it is.
fn takeFirst<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
): Option<((K, V), Node<K, V>)> {
    match (n.children.get(0)) {
        .None => {
            match (entryAt(n, 0)) {
                .None => .None,
                .Some(e) => .Some((e, without(ctx, n, 0))),
            }
        },
        .Some(child) => {
            match (takeFirst(ctx, child)) {
                .None => .None,
                .Some(taken) => {
                    let (e, shrunk) = taken;
                    .Some((e, fixChild(ctx, n, 0, shrunk)))
                },
            }
        },
    }
}

/// The mirror of [`takeFirst`], down the right spine.
fn takeLast<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
): Option<((K, V), Node<K, V>)> {
    let at = n.children.length() - 1;
    match (n.children.get(at)) {
        .None => {
            let last = n.keys.length() - 1;
            match (entryAt(n, last)) {
                .None => .None,
                .Some(e) => .Some((e, without(ctx, n, last))),
            }
        },
        .Some(child) => {
            match (takeLast(ctx, child)) {
                .None => .None,
                .Some(taken) => {
                    let (e, shrunk) = taken;
                    .Some((e, fixChild(ctx, n, at, shrunk)))
                },
            }
        },
    }
}

/// The largest entry whose key is at most `key`. `before` is the nearest
/// subtree to the left of the path down, whose last entry answers when the
/// leaf holds nothing at or below `key`. One descent, and one more down
/// `before` at most. Pure.
fn floorIn<K: Ordered, V>(
    n: Node<K, V>,
    key: K,
    before: Option<Node<K, V>>,
): Option<(K, V)> {
    if (isLeaf(n)) {
        let (at, found) = seek(n.keys, key, 0);
        if (found) {
            entryAt(n, at)
        } else if (at > 0) {
            entryAt(n, at - 1)
        } else {
            match (before) {
                .None => .None,
                .Some(b) => rightmost(b),
            }
        }
    } else {
        let at = route(n, key);
        let nearer = if (at > 0) { n.children.get(at - 1) } else { before };
        match (n.children.get(at)) {
            .None => .None,
            .Some(child) => floorIn(child, key, nearer),
        }
    }
}

/// The mirror of [`floorIn`]: the smallest entry whose key is at least `key`.
fn ceilingIn<K: Ordered, V>(
    n: Node<K, V>,
    key: K,
    after: Option<Node<K, V>>,
): Option<(K, V)> {
    if (isLeaf(n)) {
        let (at, _found) = seek(n.keys, key, 0);
        match (entryAt(n, at)) {
            .Some(e) => .Some(e),
            .None => {
                match (after) {
                    .None => .None,
                    .Some(a) => leftmost(a),
                }
            },
        }
    } else {
        let at = route(n, key);
        let nearer = if (at + 1 < n.children.length()) {
            n.children.get(at + 1)
        } else {
            after
        };
        match (n.children.get(at)) {
            .None => .None,
            .Some(child) => ceilingIn(child, key, nearer),
        }
    }
}

// -----------------------------------------------------------------------------
// Walking
//
// Every entry is in a leaf, so a walk visits the leaves in order. The answers
// are threaded through as accumulators rather than concatenated sublists: a
// `push` onto a list nothing else holds grows it in place (MEMORY.md §5.3), so
// the whole walk is linear. `keys` and `values` gather the leaves' own lists
// and `flatten` them, which sizes the answer once.
// -----------------------------------------------------------------------------

/// The entries under `n`, in key order.
fn foldNode<K, V, B>(n: Node<K, V>, step: fn(B, K, V) => B, acc: B): B {
    if (isLeaf(n)) {
        foldLeaf(n, 0, step, acc)
    } else {
        n.children.fold(fn(a, child) => foldNode(child, step, a), acc)
    }
}

fn foldLeaf<K, V, B>(n: Node<K, V>, i: Int, step: fn(B, K, V) => B, acc: B): B {
    match (entryAt(n, i)) {
        .Some(kv) => foldLeaf(n, i + 1, step, step(acc, kv.0, kv.1)),
        .None => acc,
    }
}

fn foldNodeCtx<K, V, B, C>(
    ctx: C,
    n: Node<K, V>,
    step: fn(C, B, K, V) => B,
    acc: B,
): B {
    if (isLeaf(n)) {
        foldLeafCtx(ctx, n, 0, step, acc)
    } else {
        n.children.foldCtx(ctx, fn(c, a, child) => foldNodeCtx(c, child, step, a), acc)
    }
}

fn foldLeafCtx<K, V, B, C>(
    ctx: C,
    n: Node<K, V>,
    i: Int,
    step: fn(C, B, K, V) => B,
    acc: B,
): B {
    match (entryAt(n, i)) {
        .Some(kv) => foldLeafCtx(ctx, n, i + 1, step, step(ctx, acc, kv.0, kv.1)),
        .None => acc,
    }
}

/// The leaves' key lists under `n`, in key order, for `flatten`.
fn keyRuns<K, V, C: Allocator>(ctx: C, n: Node<K, V>, acc: [[K]]): [[K]] {
    if (isLeaf(n)) {
        acc.push(ctx, n.keys)
    } else {
        n.children.foldCtx(ctx, fn(c, a, child) => keyRuns(c, child, a), acc)
    }
}

/// The leaves' value lists under `n`, in key order, for `flatten`.
fn valueRuns<K, V, C: Allocator>(ctx: C, n: Node<K, V>, acc: [[V]]): [[V]] {
    if (isLeaf(n)) {
        acc.push(ctx, n.values)
    } else {
        n.children.foldCtx(ctx, fn(c, a, child) => valueRuns(c, child, a), acc)
    }
}

/// The leaves under `n`, in key order, pushed onto `acc`.
fn leavesOf<K, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    acc: [Node<K, V>],
): [Node<K, V>] {
    if (isLeaf(n)) {
        acc.push(ctx, n)
    } else {
        n.children.foldCtx(ctx, fn(c, a, child) => leavesOf(c, child, a), acc)
    }
}

fn walk<K, V, C: Allocator>(ctx: C, n: Node<K, V>, acc: [(K, V)]): [(K, V)] {
    leavesOf(ctx, n, list.empty<Node<K, V>>()).foldCtx(
        ctx,
        fn(c, a, l) => walkLeaf(c, l, 0, a),
        acc,
    )
}

fn walkLeaf<K, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    at: Int,
    acc: [(K, V)],
): [(K, V)] {
    match (entryAt(n, at)) {
        .None => acc,
        .Some(e) => walkLeaf(ctx, n, at + 1, acc.push(ctx, e)),
    }
}

/// The same keys and shape, every value put through `transform`.
fn mapNode<K, V, W, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    transform: fn(V) => W,
): Node<K, W> {
    Node {
        keys: n.keys,
        values: n.values.map(ctx, transform),
        children: n.children.mapCtx(ctx, fn(c, child) => mapNode(c, child, transform)),
    }
}

/// The half-open scan. Routing at each branch is what makes this visit only
/// the subtrees that can hold an answer, rather than the whole tree.
fn walkRange<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    start: K,
    end: K,
    acc: [(K, V)],
): [(K, V)] {
    if (isLeaf(n)) {
        let (at, _found) = seek(n.keys, start, 0);
        rangeLeaf(ctx, n, end, at, acc)
    } else {
        rangeFrom(ctx, n, start, end, route(n, start), acc)
    }
}

/// Child `at` and every one after it that can hold a key below `end`.
fn rangeFrom<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    start: K,
    end: K,
    at: Int,
    acc: [(K, V)],
): [(K, V)] {
    match (n.children.get(at)) {
        .None => acc,
        .Some(child) => {
            let below = walkRange(ctx, child, start, end, acc);
            // The next child holds nothing below separator `at`.
            match (n.keys.get(at)) {
                .Some(k) if k.compare(end).isLess() => {
                    rangeFrom(ctx, n, start, end, at + 1, below)
                },
                _ => below,
            }
        },
    }
}

fn rangeLeaf<K: Ordered, V, C: Allocator>(
    ctx: C,
    n: Node<K, V>,
    end: K,
    at: Int,
    acc: [(K, V)],
): [(K, V)] {
    match (entryAt(n, at)) {
        .Some(e) if e.0.compare(end).isLess() => {
            rangeLeaf(ctx, n, end, at + 1, acc.push(ctx, e))
        },
        _ => acc,
    }
}

// -----------------------------------------------------------------------------
// The map
// -----------------------------------------------------------------------------

impl<K: Ordered, V> OrderedMap<K, V> {
    export fn length(self): Int {
        self.size
    }

    export fn isEmpty(self): Bool {
        self.size == 0
    }

    /// The value stored under `key`, if there is one. O(log n), and pure.
    export fn get(self, key: K): Option<V> {
        lookup(self.root, key)
    }

    /// Whether `key` is there. It reads keys alone.
    export fn has(self, key: K): Bool {
        holds(self.root, key)
    }

    /// Stores `value` under `key`, replacing whatever was there.
    ///
    /// The map you called it on is unchanged, and the two share every node
    /// outside the one root-to-leaf path this copied.
    export fn insert<C: Allocator>(self, ctx: C, key: K, value: V): OrderedMap<K, V> {
        let (grown, added) = insertInto(ctx, self.root, key, value);
        let root = match (grown) {
            .Fit(one) => one,
            // The tree gets taller only here, and by one level all at once.
            .Split(left, up, right) => branch([up], [left, right]),
        };
        OrderedMap { root: root, size: if (added) { self.size + 1 } else { self.size } }
    }

    /// Removes `key`, if it is there. Removing what is absent is not an
    /// error.
    export fn remove<C: Allocator>(self, ctx: C, key: K): OrderedMap<K, V> {
        let (next, gone) = removeFrom(ctx, self.root, key);
        if (gone) {
            OrderedMap { root: shrinkRoot(next), size: self.size - 1 }
        } else {
            self
        }
    }

    /// Insert, replace or remove in one call. `f` gets what is stored under
    /// `key` — `.Some(v)` or `.None` — and what it answers is what gets stored
    /// afterwards, with `.None` meaning "not there".
    ///
    /// A counter is `alter(ctx, k, fn(n) => .Some(n.withDefault(0) + 1))`.
    /// Answering `.None` prunes, which keeps a map of maps from filling with
    /// empty ones.
    ///
    /// ```buri run
    /// from "core/io" import * as io;
    /// from "core/orderedmap" import * as orderedmap;
    /// from "node" import { NodeHost };
    /// from "platform/effect" import { Allocator, Stdout };
    ///
    /// export fn main(host: NodeHost): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let counts = orderedmap.of(ctx, [("a", 1)]);
    ///     // One call whether or not the key is there, and one that removes.
    ///     let bumped = counts
    ///         .alter(ctx, "a", fn(n) => .Some(n.withDefault(0) + 1))
    ///         .alter(ctx, "b", fn(n) => .Some(n.withDefault(0) + 1))
    ///         .alter(ctx, "a", fn(_n) => .None);
    ///     let keys = bumped.keys(ctx).join(ctx, " ");
    ///     let b = bumped.get("b").withDefault(0);
    ///     let _ = io.println(ctx, "${keys}=${b}").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// b=1
    /// ```
    export fn alter<C: Allocator>(
        self,
        ctx: C,
        key: K,
        f: fn(Option<V>) => Option<V>,
    ): OrderedMap<K, V> {
        match (f(self.get(key))) {
            .Some(v) => self.insert(ctx, key, v),
            .None => self.remove(ctx, key),
        }
    }

    /// The value under `key` and the map without it, or `.None` when the key is
    /// not there.
    export fn pop<C: Allocator>(self, ctx: C, key: K): Option<(V, OrderedMap<K, V>)> {
        match (self.get(key)) {
            .None => .None,
            .Some(v) => .Some((v, self.remove(ctx, key))),
        }
    }

    /// The entry with the smallest key, and the map without it.
    ///
    /// **One descent**, where `first` and then `remove` is two: the walk down
    /// the left spine takes the entry out of the leaf it sits in and repairs
    /// the tree on the way back up. That is what a sorted work queue does on
    /// every step.
    ///
    /// ```buri run
    /// from "core/io" import * as io;
    /// from "core/orderedmap" import * as orderedmap;
    /// from "node" import { NodeHost };
    /// from "platform/effect" import { Allocator, Stdout };
    ///
    /// export fn main(host: NodeHost): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     let due = orderedmap.of(ctx, [(30, "c"), (10, "a"), (20, "b")]);
    ///     let (what, left) = match (due.popFirst(ctx)) {
    ///         .None => ("nothing", 0),
    ///         .Some(taken) => {
    ///             let (entry, rest) = taken;
    ///             let (_at, name) = entry;
    ///             (name, rest.length())
    ///         },
    ///     };
    ///     let _ = io.println(ctx, "${what}, ${left} left").ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// a, 2 left
    /// ```
    export fn popFirst<C: Allocator>(self, ctx: C): Option<((K, V), OrderedMap<K, V>)> {
        match (takeFirst(ctx, self.root)) {
            .None => .None,
            .Some(taken) => {
                let (e, next) = taken;
                .Some((e, OrderedMap { root: shrinkRoot(next), size: self.size - 1 }))
            },
        }
    }

    /// The entry with the largest key, and the map without it. `popFirst` from
    /// the other end, and one descent for the same reason.
    export fn popLast<C: Allocator>(self, ctx: C): Option<((K, V), OrderedMap<K, V>)> {
        match (takeLast(ctx, self.root)) {
            .None => .None,
            .Some(taken) => {
                let (e, next) = taken;
                .Some((e, OrderedMap { root: shrinkRoot(next), size: self.size - 1 }))
            },
        }
    }

    /// The entry with the largest key that is at most `key`, which `range`
    /// cannot answer: a range needs both ends, and "nearest at or below" has
    /// only one. O(log n), and pure.
    ///
    /// ```buri run
    /// from "core/io" import * as io;
    /// from "core/orderedmap" import * as orderedmap;
    /// from "node" import { NodeHost };
    /// from "platform/effect" import { Allocator, Stdout };
    ///
    /// export fn main(host: NodeHost): Result<(), Str> {
    ///     let ctx = context {
    ///         Allocator: host.alloc,
    ///         Stdout: host.stdout,
    ///     };
    ///     // A step function: the band a reading falls in.
    ///     let bands = orderedmap.of(ctx, [(0, "cold"), (10, "mild"), (25, "hot")]);
    ///     let band = match (bands.floor(17)) {
    ///         .None => "off the scale",
    ///         .Some(entry) => {
    ///             let (_from, name) = entry;
    ///             name
    ///         },
    ///     };
    ///     let _ = io.println(ctx, band).ignore();
    ///     .Ok(())
    /// }
    /// ```
    ///
    /// ```stdout
    /// mild
    /// ```
    export fn floor(self, key: K): Option<(K, V)> {
        floorIn(self.root, key, .None)
    }

    /// The entry with the smallest key that is at least `key`. `floor` from the
    /// other side.
    export fn ceiling(self, key: K): Option<(K, V)> {
        ceilingIn(self.root, key, .None)
    }

    /// Both maps' entries, `other`'s winning where a key is in both.
    ///
    /// Right-biased, like `core/map`'s: `defaults.merge(ctx, overrides)` reads
    /// the way it is used.
    export fn merge<C: Allocator>(
        self,
        ctx: C,
        other: OrderedMap<K, V>,
    ): OrderedMap<K, V> {
        if (fewInto(other.size, self.size)) {
            other
                .entries(ctx)
                .foldCtx(
                    ctx,
                    fn(c, acc: OrderedMap<K, V>, e) => {
                        let (k, v) = e;
                        acc.insert(c, k, v)
                    },
                    self,
                )
        } else {
            let both = interleave(
                ctx,
                self.entries(ctx),
                other.entries(ctx),
                fn(_mine, theirs) => theirs,
                0,
                0,
                list.empty<(K, V)>(),
            );
            sorted(ctx, both)
        }
    }

    /// Both maps' entries, with `combine(mine, theirs)` deciding a key that is
    /// in both. `combine` is called only for those keys.
    export fn mergeWith<C: Allocator>(
        self,
        ctx: C,
        other: OrderedMap<K, V>,
        combine: fn(V, V) => V,
    ): OrderedMap<K, V> {
        if (fewInto(other.size, self.size)) {
            other
                .entries(ctx)
                .foldCtx(
                    ctx,
                    fn(c, acc: OrderedMap<K, V>, e) => {
                        let (k, v) = e;
                        match (acc.get(k)) {
                            .None => acc.insert(c, k, v),
                            .Some(mine) => acc.insert(c, k, combine(mine, v)),
                        }
                    },
                    self,
                )
        } else {
            let both = interleave(
                ctx,
                self.entries(ctx),
                other.entries(ctx),
                combine,
                0,
                0,
                list.empty<(K, V)>(),
            );
            sorted(ctx, both)
        }
    }

    /// The entries `keep` answers true for, still in key order.
    export fn filter<C: Allocator>(
        self,
        ctx: C,
        keep: fn(K, V) => Bool,
    ): OrderedMap<K, V> {
        let kept = self
            .entries(ctx)
            .filter(ctx, fn(e) => {
                let (k, v) = e;
                keep(k, v)
            });
        sorted(ctx, kept)
    }

    /// The same keys, every value put through `transform`.
    ///
    /// Nothing touches the keys, so the order cannot change, and the tree keeps
    /// its shape and shares its key lists. O(n).
    export fn mapValues<W, C: Allocator>(
        self,
        ctx: C,
        transform: fn(V) => W,
    ): OrderedMap<K, W> {
        OrderedMap { root: mapNode(ctx, self.root, transform), size: self.size }
    }

    /// The entry with the smallest key. Pure: it is a walk down the left spine.
    export fn first(self): Option<(K, V)> {
        leftmost(self.root)
    }

    /// The entry with the largest key.
    export fn last(self): Option<(K, V)> {
        rightmost(self.root)
    }

    /// Every entry, in key order — the reason this module exists.
    export fn entries<C: Allocator>(self, ctx: C): [(K, V)] {
        walk(ctx, self.root, list.empty<(K, V)>())
    }

    /// Every entry, in key order, folded into `init`: `entries` without the
    /// list, so it needs no allocator.
    export fn fold<B>(self, step: fn(B, K, V) => B, init: B): B {
        foldNode(self.root, step, init)
    }

    /// The same, with a context for `step` to allocate in.
    export fn foldCtx<B, C>(self, ctx: C, step: fn(C, B, K, V) => B, init: B): B {
        foldNodeCtx(ctx, self.root, step, init)
    }

    /// The entries whose keys are at least `start` and less than `end`, in key
    /// order. Half-open, so `range(ctx, k, k)` is empty and two ranges that share
    /// an endpoint share no entry.
    ///
    /// O(log n + m) in the m entries answered: the scan descends to `start` and
    /// stops at the first key that is not below `end`.
    export fn range<C: Allocator>(self, ctx: C, start: K, end: K): [(K, V)] {
        walkRange(ctx, self.root, start, end, list.empty<(K, V)>())
    }

    export fn keys<C: Allocator>(self, ctx: C): [K] {
        keyRuns(ctx, self.root, list.empty<[K]>()).flatten(ctx)
    }

    /// Every value, in key order: the leaves' own lists, flattened into one
    /// block sized once.
    export fn values<C: Allocator>(self, ctx: C): [V] {
        valueRuns(ctx, self.root, list.empty<[V]>()).flatten(ctx)
    }
}

impl<K: Ordered, V: Equal> OrderedMap<K, V> {
    /// Same entries, whatever order either was built in. `derive Equal` would
    /// compare the trees, which two equal maps need not share.
    export fn equals<C: Allocator>(self, ctx: C, other: OrderedMap<K, V>): Bool {
        if (self.size != other.size) {
            false
        } else {
            let theirs = other;
            self
                .entries(ctx)
                .all(fn(e) => {
                    let (k, v) = e;
                    theirs.get(k) == .Some(v)
                })
        }
    }
}

/// The same entries, whatever order either was built in. O(n log n), and it
/// allocates nothing.
impl<K: Ordered, V: Equal> Equal for OrderedMap<K, V> {
    fn equal(self, other: OrderedMap<K, V>): Bool {
        self.size == other.size && allIn(self.root, other)
    }
}

fn allIn<K: Ordered, V: Equal>(n: Node<K, V>, other: OrderedMap<K, V>): Bool {
    if (isLeaf(n)) {
        sameFrom(n, 0, other)
    } else {
        n.children.all(fn(child) => allIn(child, other))
    }
}

fn sameFrom<K: Ordered, V: Equal>(
    n: Node<K, V>,
    at: Int,
    other: OrderedMap<K, V>,
): Bool {
    match (n.keys.get(at)) {
        .None => true,
        .Some(k) => other.get(k) == n.values.get(at) && sameFrom(n, at + 1, other),
    }
}

/// `{k: v, k: v}`, in key order.
impl<K: Ordered + Show, V: Show> Show for OrderedMap<K, V> {
    fn show<C: Allocator>(self, ctx: C): Str {
        let parts = self
            .entries(ctx)
            .mapCtx(ctx, fn(c, e) => {
                let (k, v) = e;
                [k.show(c), ": ", v.show(c)].join(c, "")
            });
        ["{", parts.join(ctx, ", "), "}"].join(ctx, "")
    }
}

// -----------------------------------------------------------------------------
// Prefix scans, which only string keys have
// -----------------------------------------------------------------------------

impl<V> OrderedMap<Str, V> {
    /// The entries whose keys begin with `prefix`, in key order. The empty
    /// prefix answers every entry.
    ///
    /// O(log n + m), like `range`. The matching keys are one contiguous run, so
    /// the scan stops at the first key that does not match.
    export fn prefix<C: Allocator>(self, ctx: C, prefix: Str): [(Str, V)] {
        prefixFrom(ctx, self.root, prefix, list.empty<(Str, V)>())
    }
}

fn prefixFrom<V, C: Allocator>(
    ctx: C,
    n: Node<Str, V>,
    prefix: Str,
    acc: [(Str, V)],
): [(Str, V)] {
    if (isLeaf(n)) {
        // The first key that is at least the prefix is the first that can match it.
        let (at, _found) = seek(n.keys, prefix, 0);
        prefixLeaf(ctx, n, prefix, at, acc)
    } else {
        prefixAt(ctx, n, prefix, route(n, prefix), acc)
    }
}

/// Child `at` and every one after it whose separator still matches.
fn prefixAt<V, C: Allocator>(
    ctx: C,
    n: Node<Str, V>,
    prefix: Str,
    at: Int,
    acc: [(Str, V)],
): [(Str, V)] {
    match (n.children.get(at)) {
        .None => acc,
        .Some(child) => {
            let below = prefixFrom(ctx, child, prefix, acc);
            match (n.keys.get(at)) {
                .Some(k) if k.startsWith(prefix) => {
                    prefixAt(ctx, n, prefix, at + 1, below)
                },
                _ => below,
            }
        },
    }
}

fn prefixLeaf<V, C: Allocator>(
    ctx: C,
    n: Node<Str, V>,
    prefix: Str,
    at: Int,
    acc: [(Str, V)],
): [(Str, V)] {
    match (entryAt(n, at)) {
        .Some(e) if e.0.startsWith(prefix) => {
            prefixLeaf(ctx, n, prefix, at + 1, acc.push(ctx, e))
        },
        _ => acc,
    }
}
