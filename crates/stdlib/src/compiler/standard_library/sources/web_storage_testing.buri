//! web/storage/testing — an in-memory `Storage` for a test.
//!
//! ```buri role=test
//! from "core/testing/assert" import * as assert;
//! from "platform/effect" import { Allocator };
//! from "platform/effect/testing" import { alloc };
//! from "web/storage" import * as storage;
//! from "web/storage" import { Storage };
//! from "web/storage/testing" import * as testing;
//!
//! test "a draft survives a reload" {
//!     let page = testing.storage();
//!     let ctx = context {
//!         Allocator: alloc(),
//!         Storage: page,
//!     };
//!     assert.equal(storage.set(ctx, "draft", [104, 105]), .Ok(()));
//!     let reloaded = context {
//!         Allocator: alloc(),
//!         Storage: page.reload(),
//!     };
//!     assert.equal(storage.get(reloaded, "draft"), .Ok(.Some([104, 105])));
//! }
//! ```
//!
//! Each `storage()` starts empty. `reload` opens the same store again, the way
//! a page reloaded in the same browser does. `refused` and `withQuota` make the
//! browser's two refusals happen on demand.

from "core/orderedmap" import * as orderedmap;
from "core/orderedmap" import { OrderedMap };
from "core/platforms/testing/state" import * as state;
from "platform/effect" import { Allocator };
from "web/storage" import { Storage, StorageError };

/// A store held in memory, shared by every copy and every `reload`.
export struct TestStorage {
    store: state.State<OrderedMap<Str, [U8]>>,
    quota: Option<Int>,
    refusal: Option<Str>,
}

impl Storage for TestStorage {
    fn get(self, key: Str): Result<Option<[U8]>, StorageError> {
        match (self.refusal) {
            .Some(why) => .Err(.Refused(why)),
            .None => .Ok(state.read(self.store).get(key)),
        }
    }

    /// `.QuotaExceeded` when the values held would total more bytes than the
    /// quota, and the store keeps what it had.
    fn set(self, key: Str, value: [U8]): Result<(), StorageError> {
        let quota = self.quota;
        match (self.refusal) {
            .Some(why) => .Err(.Refused(why)),
            .None => {
                state.update(self.store, fn(c, m) => {
                    let next = m.insert(c, key, value);
                    if (fits(c, next, quota)) {
                        (next, .Ok(()))
                    } else {
                        (m, .Err(.QuotaExceeded))
                    }
                })
            },
        }
    }

    fn delete(self, key: Str): Result<(), StorageError> {
        match (self.refusal) {
            .Some(why) => .Err(.Refused(why)),
            .None => state.update(self.store, fn(c, m) => (m.remove(c, key), .Ok(()))),
        }
    }

    fn keys(self, prefix: Str): Result<[Str], StorageError> {
        match (self.refusal) {
            .Some(why) => .Err(.Refused(why)),
            .None => {
                state.update(self.store, fn(c, m) => {
                    (m, .Ok(m.prefix(c, prefix).map(c, fn(entry) => entry.0)))
                })
            },
        }
    }
}

fn fits<C: Allocator>(ctx: C, m: OrderedMap<Str, [U8]>, quota: Option<Int>): Bool {
    match (quota) {
        .Some(bytes) => m.values(ctx).sumOf(fn(v) => v.length()) <= bytes,
        .None => true,
    }
}

/// An empty store with no quota.
export fn storage(): TestStorage {
    TestStorage { store: state.new(orderedmap.empty()), quota: .None, refusal: .None }
}

/// A store whose browser refuses everything, saying `why`: what a private
/// window or blocked site data looks like. Every call answers `.Refused(why)`.
export fn refused(why: Str): TestStorage {
    TestStorage { ..storage(), refusal: .Some(why) }
}

impl TestStorage {
    /// The same store, opened again: what a reloaded page sees.
    export fn reload(self): TestStorage {
        TestStorage { ..self }
    }

    /// The same store, holding at most `bytes` bytes of values. A `set` past
    /// that answers `.QuotaExceeded`.
    export fn withQuota(self, bytes: Int): TestStorage {
        TestStorage { ..self, quota: .Some(bytes) }
    }
}
