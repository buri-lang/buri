//! core/proto — the protocol buffers wire format, and the errors reading one
//! can produce.
//!
//! Nobody writes any of this by hand. A `.proto` schema a Buri module imports
//! — `from "//proto/person.proto" import { Person };` — becomes a generated
//! module holding the types *and* their four codecs, and those codecs call the
//! functions below. This module is the part of that generated code that is the
//! same for every schema.
//!
//! The four wire types this format has, and the only ones this module reads:
//!
//! ```text
//! 0  VARINT  int32 int64 uint32 uint64 sint32 sint64 bool enum
//! 1  I64     fixed64 sfixed64 double
//! 2  LEN     string bytes, embedded messages, packed repeated fields
//! 5  I32     fixed32 sfixed32 float
//! ```
//!
//! Wire types 3 and 4 are the deprecated group encoding. This module rejects
//! them rather than skipping them: a group is a nesting the reader would have to
//! understand to get past, so treating one as an unknown field would read the
//! rest of the message at the wrong offset.

from "core/bits" import * as bits;
from "core/bytes" import * as bytes;
from "core/json" import { Json };
from "core/list" import * as list;
from "core/math" import * as math;
from "core/number" import * as number;
from "core/str" import * as str;
from "platform/effect" import { Allocator };

derive Equal, Show for ProtoError;
/// Where a message stopped being one.
///
/// Every case carries a byte offset or a field number.
export enum ProtoError {
    /// The input ended in the middle of a field.
    Truncated(Int),
    /// A field header carrying wire type 3 or 4 — a group, which this format no
    /// longer has — or any other number that is not 0, 1, 2 or 5.
    BadWireType { field: Int, wire: Int },
    /// A field number of zero, which no field may have.
    BadFieldNumber(Int),
    /// A `string` field whose bytes are not UTF-8, at the offset it stopped.
    BadUtf8(Int),
    /// A JSON document that is not the message it was read as. `path` reads the
    /// way `core/json`'s does — `$` for the document, `.name` for a member.
    BadJson { path: Str, wanted: Str },
}

export let VARINT: Int = 0;

export let I64: Int = 1;

export let LEN: Int = 2;

export let I32: Int = 5;

let TWO32: Int = 4294967296;

// -----------------------------------------------------------------------------
// Writing
// -----------------------------------------------------------------------------
//
// Every writer appends to `out` and hands it back, so a message is written into
// one buffer. A generated encoder writes each header as literal bytes, and a
// nested message's length from its `size` function before its fields. proto3's
// canonical encoding writes fields in ascending field number, and the generated
// code emits them in schema order.

/// `value` as a varint, appended to `out`: the bytes `bytes.toVarint` makes,
/// ten of them for a negative number.
export fn writeVarint<C: Allocator>(ctx: C, out: [U8], value: Int): [U8] {
    if (value < 0) {
        // The low seven bits, then the other 57 of the 64-bit two's complement.
        let low = (value % 128 + 128) % 128;
        writeUnsigned(
            ctx,
            out.push(ctx, (low + 128).wrapToU8()),
            bits.shiftRight(value, 7),
        )
    } else {
        writeUnsigned(ctx, out, value)
    }
}

fn writeUnsigned<C: Allocator>(ctx: C, out: [U8], value: Int): [U8] {
    if (value < 128) {
        out.push(ctx, value.wrapToU8())
    } else {
        writeUnsigned(ctx, out.push(ctx, (value % 128 + 128).wrapToU8()), value / 128)
    }
}

/// How many bytes `writeVarint` writes for `value`.
export fn varintSize(value: Int): Int {
    if (value < 0) {
        10
    } else if (value < 128) {
        1
    } else if (value < 16384) {
        2
    } else if (value < 2097152) {
        3
    } else if (value < 268435456) {
        4
    } else if (value < 34359738368) {
        5
    } else if (value < 4398046511104) {
        6
    } else if (value < 562949953421312) {
        7
    } else if (value < 72057594037927936) {
        8
    } else {
        9
    }
}

/// The size of a length-delimited body of `length` bytes, its length included.
export fn lenSize(length: Int): Int {
    varintSize(length) + length
}

/// The size of a `string` body: its UTF-8, and the length before it.
export fn strSize(s: Str): Int {
    lenSize(s.utf8Length())
}

/// Four little-endian bytes of a value read as unsigned at 32 bits.
export fn writeFixed32<C: Allocator>(ctx: C, out: [U8], value: Int): [U8] {
    out.concat(ctx, le32(value))
}

/// The same four bytes on their own. Pure: an array literal of a fixed size
/// allocates nothing a context has to grant.
export fn le32(value: Int): [U8] {
    let v = if (value < 0) { value + TWO32 } else { value };
    [
        (v % 256).wrapToU8(),
        (divide(v, 256) % 256).wrapToU8(),
        (divide(v, 65536) % 256).wrapToU8(),
        (divide(v, 16777216) % 256).wrapToU8(),
    ]
}

/// Eight little-endian bytes, as two halves, so that a negative `sfixed64`
/// writes its two's complement exactly.
export fn writeFixed64<C: Allocator>(ctx: C, out: [U8], value: Int): [U8] {
    let (hi, lo) = halves(value);
    writeFixed32(ctx, writeFixed32(ctx, out, lo), hi)
}

/// A `double`'s eight bytes.
export fn writeF64<C: Allocator>(ctx: C, out: [U8], x: Float): [U8] {
    out.concat(ctx, bytes.f64ToBytes(ctx, x))
}

/// A `float`'s four bytes.
export fn writeF32<C: Allocator>(ctx: C, out: [U8], x: Float): [U8] {
    out.concat(ctx, bytes.f32ToBytes(ctx, x))
}

/// A `bytes` body: its length, then the bytes.
export fn writeBytes<C: Allocator>(ctx: C, out: [U8], body: [U8]): [U8] {
    writeVarint(ctx, out, body.length()).concat(ctx, body)
}

/// A `string` body. UTF-8 is what the format says a string is.
export fn writeStr<C: Allocator>(ctx: C, out: [U8], s: Str): [U8] {
    writeBytes(ctx, out, bytes.toUtf8(ctx, s))
}

fn divide(a: Int, b: Int): Int {
    (a - a % b) / b
}

/// A 64-bit value as (high 32 bits, low 32 bits), both non-negative.
fn halves(value: Int): (Int, Int) {
    if (value < 0) {
        let a = 0 - value;
        let alo = a % TWO32;
        let ahi = (a - alo) / TWO32;
        let borrow = if (alo > 0) { 1 } else { 0 };
        ((TWO32 - ahi - borrow) % TWO32, (TWO32 - alo) % TWO32)
    } else {
        let lo = value % TWO32;
        ((value - lo) / TWO32, lo)
    }
}

// -----------------------------------------------------------------------------
// Reading
// -----------------------------------------------------------------------------
//
// A nested message is read in place rather than sliced out, so every reader
// takes the index its message ends at, `end`, and the index it starts at,
// `base`. A read that would pass `end` is truncated, and an error names its
// offset from `base`: the offset inside the message it was found in.

/// One field header: the field number, the wire type, and the index just past
/// the header.
///
/// A *known* field arriving with a wire type it cannot have is not an error.
/// The generated decoder matches on the pair, so such a field does not match and
/// gets skipped as an unknown one.
export fn readTag(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Int, Int, Int), ProtoError> {
    let (key, next) = readVarint(b, at, end, base)?;
    let wire = key % 8;
    let field = divide(key - wire, 8);
    // A tag is a `uint32` and a five-byte varint carries more than 32 bits, so
    // this checks the value too rather than reading the low 32 bits.
    if (next - at > 5 || key < 0 || key > 4294967295) {
        .Err(.BadFieldNumber(at - base))
    } else if (field <= 0 || field > 536870911) {
        .Err(.BadFieldNumber(at - base))
    } else if (wire == 3 || wire == 4 || wire == 6 || wire == 7) {
        .Err(.BadWireType { field: field, wire: wire })
    } else {
        .Ok((field, wire, next))
    }
}

/// One varint, read as a signed 64-bit number, and the index just past it. A
/// varint that does not end before `end`, or within ten bytes, is a truncated
/// message.
export fn readVarint(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Int, Int), ProtoError> {
    if (at < end) {
        let first = byteAt(b, at);
        if (first < 128) {
            .Ok((first, at + 1))
        } else {
            varintFrom(b, at, at + 1, end, base, 7, first - 128)
        }
    } else {
        .Err(.Truncated(at - base))
    }
}

/// The groups past the first, each shifted into place. The tenth byte's shift
/// is 63, which keeps its lowest bit as the sign and drops the rest.
fn varintFrom(
    b: [U8],
    start: Int,
    i: Int,
    end: Int,
    base: Int,
    shift: Int,
    acc: Int,
): Result<(Int, Int), ProtoError> {
    if (i >= end || shift > 63) {
        .Err(.Truncated(start - base))
    } else {
        let x = byteAt(b, i);
        if (x < 128) {
            .Ok((acc + bits.shiftLeft(x, shift), i + 1))
        } else {
            varintFrom(
                b,
                start,
                i + 1,
                end,
                base,
                shift + 7,
                acc + bits.shiftLeft(x - 128, shift),
            )
        }
    }
}

/// The same varint, read as its low 32 bits — which is what a 32-bit field is.
export fn readVarint32(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Int, Int), ProtoError> {
    let (v, next) = readVarint(b, at, end, base)?;
    .Ok(((v % TWO32 + TWO32) % TWO32, next))
}

/// Four little-endian bytes, read as unsigned.
export fn readFixed32(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Int, Int), ProtoError> {
    if (at + 4 > end) {
        .Err(.Truncated(at - base))
    } else {
        .Ok((fixed32At(b, at), at + 4))
    }
}

fn fixed32At(b: [U8], at: Int): Int {
    byteAt(b, at)
        + byteAt(b, at + 1) * 256
        + byteAt(b, at + 2) * 65536
        + byteAt(b, at + 3) * 16777216
}

/// Eight little-endian bytes, read as a signed 64-bit number. `fixed64` and
/// `sfixed64` are the same eight bytes; a `fixed64` above 2^63 comes back
/// negative, which is what a signed reading of those bits is.
export fn readFixed64(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Int, Int), ProtoError> {
    if (at + 8 > end) {
        .Err(.Truncated(at - base))
    } else {
        let lo = fixed32At(b, at);
        let hi = fixed32At(b, at + 4);
        if (hi >= 2147483648) {
            .Ok(((hi - TWO32) * TWO32 + lo, at + 8))
        } else {
            .Ok((hi * TWO32 + lo, at + 8))
        }
    }
}

/// A 32-bit value read as unsigned, taken as signed. What `sfixed32` and
/// `int32` need and `fixed32` and `uint32` do not.
export fn signed32(v: Int): Int {
    if (v >= 2147483648) { v - TWO32 } else { v }
}

export fn readF64(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Float, Int), ProtoError> {
    if (at + 8 > end) {
        .Err(.Truncated(at - base))
    } else {
        match (bytes.f64FromBytes(b, at)) {
            .Some(x) => .Ok((x, at + 8)),
            .None => .Err(.Truncated(at - base)),
        }
    }
}

export fn readF32(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Float, Int), ProtoError> {
    if (at + 4 > end) {
        .Err(.Truncated(at - base))
    } else {
        match (bytes.f32FromBytes(b, at)) {
            .Some(x) => .Ok((x, at + 4)),
            .None => .Err(.Truncated(at - base)),
        }
    }
}

/// Where the body of a length-delimited field starts and ends. A nested message
/// is read between the two, in place.
export fn readLen(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Int, Int), ProtoError> {
    let (length, next) = readVarint(b, at, end, base)?;
    if (length < 0 || length > end - next) {
        .Err(.Truncated(at - base))
    } else {
        .Ok((next, next + length))
    }
}

/// The body of a `bytes` field, copied out, and the index just past it.
export fn readBytes<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<([U8], Int), ProtoError> {
    let (start, stop) = readLen(b, at, end, base)?;
    .Ok((b.slice(ctx, start, stop), stop))
}

/// The same, decoded as UTF-8. A `string` field whose bytes are not text is an
/// error rather than a replacement character — see `core/bytes`.
export fn readStr<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
): Result<(Str, Int), ProtoError> {
    let (raw, next) = readBytes(ctx, b, at, end, base)?;
    match (bytes.fromUtf8(ctx, raw)) {
        .Ok(s) => .Ok((s, next)),
        .Err(_e) => .Err(.BadUtf8(at - base)),
    }
}

/// Past a field the schema does not know.
///
/// This is proto3's forward compatibility: a reader built from an older schema
/// walks over a field a newer writer added and carries on. It *drops* the bytes,
/// so re-encoding a message decoded from a newer schema loses the fields that
/// schema added.
export fn skip(
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    wire: Int,
): Result<Int, ProtoError> {
    if (wire == VARINT) {
        let (_v, next) = readVarint(b, at, end, base)?;
        .Ok(next)
    } else if (wire == I64) {
        if (at + 8 > end) { .Err(.Truncated(at - base)) } else { .Ok(at + 8) }
    } else if (wire == I32) {
        if (at + 4 > end) { .Err(.Truncated(at - base)) } else { .Ok(at + 4) }
    } else if (wire == LEN) {
        let (_start, stop) = readLen(b, at, end, base)?;
        .Ok(stop)
    } else {
        .Err(.BadWireType { field: 0, wire: wire })
    }
}

fn byteAt(b: [U8], i: Int): Int {
    b.get(i).withDefault(0).toI64()
}

// --- Packed repeated fields --------------------------------------------------------
//
// proto3 packs a repeated field of a numeric type by default: one
// length-delimited field holding the values back to back with no headers. A
// reader must still accept the unpacked form, because a writer is allowed to
// send it — so the generated decoder takes both, and these read the packed
// half: the values between `at` and `end`, with an error's offset counted from
// `at`.

export fn packedVarints<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
): Result<[Int], ProtoError> {
    packedVarintsAt(ctx, b, at, end, at, list.empty<Int>())
}

fn packedVarintsAt<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: [Int],
): Result<[Int], ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (v, next) = readVarint(b, at, end, base)?;
        packedVarintsAt(ctx, b, next, end, base, acc.push(ctx, v))
    }
}

/// The same, keeping each value's low 32 bits.
export fn packedVarints32<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
): Result<[Int], ProtoError> {
    packedVarints32At(ctx, b, at, end, at, list.empty<Int>())
}

fn packedVarints32At<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: [Int],
): Result<[Int], ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (v, next) = readVarint32(b, at, end, base)?;
        packedVarints32At(ctx, b, next, end, base, acc.push(ctx, v))
    }
}

export fn packedFixed32<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
): Result<[Int], ProtoError> {
    packedFixed32At(ctx, b, at, end, at, list.empty<Int>())
}

fn packedFixed32At<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: [Int],
): Result<[Int], ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (v, next) = readFixed32(b, at, end, base)?;
        packedFixed32At(ctx, b, next, end, base, acc.push(ctx, v))
    }
}

export fn packedFixed64<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
): Result<[Int], ProtoError> {
    packedFixed64At(ctx, b, at, end, at, list.empty<Int>())
}

fn packedFixed64At<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: [Int],
): Result<[Int], ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (v, next) = readFixed64(b, at, end, base)?;
        packedFixed64At(ctx, b, next, end, base, acc.push(ctx, v))
    }
}

export fn packedF64<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
): Result<[Float], ProtoError> {
    packedF64At(ctx, b, at, end, at, list.empty<Float>())
}

fn packedF64At<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: [Float],
): Result<[Float], ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (v, next) = readF64(b, at, end, base)?;
        packedF64At(ctx, b, next, end, base, acc.push(ctx, v))
    }
}

export fn packedF32<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
): Result<[Float], ProtoError> {
    packedF32At(ctx, b, at, end, at, list.empty<Float>())
}

fn packedF32At<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: [Float],
): Result<[Float], ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (v, next) = readF32(b, at, end, base)?;
        packedF32At(ctx, b, next, end, base, acc.push(ctx, v))
    }
}

// -----------------------------------------------------------------------------
// The JSON mapping
// -----------------------------------------------------------------------------
//
// proto3 has a JSON mapping of its own, and it is not the one `derive ToJson`
// applies. Four differences, and each is why these helpers exist:
//
//   * A 64-bit integer goes out as a *string*, because a JSON number is a
//     double and `9007199254740993` is not one.
//   * `bytes` is base64, not an array of numbers.
//   * An enum is its value's name, not a tagged object.
//   * A `oneof`'s selected case goes out as an ordinary member of the
//     enclosing object, not as `{"Case": ...}`.
//
// A reader is more permissive than a writer, which is what the mapping asks
// for: it *accepts* a 64-bit integer as a number as well as a string.

/// A 64-bit integer, as proto3 JSON writes one.
export fn jsonInt64<C: Allocator>(ctx: C, x: Int): Json {
    Json.Str(str.fromInt(ctx, x))
}

/// A 32-bit integer, which fits a JSON number exactly.
export fn jsonInt32(x: Int): Json {
    Json.Num(x.toF64())
}

/// A `double` or `float`, as proto3 JSON writes one.
///
/// JSON has no NaN and no infinities, so proto3 spells all three as strings.
export fn jsonFloat(x: Float): Json {
    if (math.isNan(x)) {
        Json.Str("NaN")
    } else if (x > number.maxValue<F64>()) {
        Json.Str("Infinity")
    } else if (x < number.minValue<F64>()) {
        Json.Str("-Infinity")
    } else {
        Json.Num(x)
    }
}

/// A `uint64` or `fixed64`, whose bits a negative `Int` holds when the value
/// is past 2^63 - 1: written as the unsigned decimal of those bits.
export fn jsonUint64<C: Allocator>(ctx: C, x: Int): Json {
    Json.Str(unsignedText(ctx, x))
}

/// An integer as decimal text: a map key of a signed type, in JSON.
export fn intText<C: Allocator>(ctx: C, x: Int): Str {
    str.fromInt(ctx, x)
}

/// The unsigned decimal of an `Int`'s 64 bits: a `uint64` or `fixed64`.
export fn unsignedText<C: Allocator>(ctx: C, x: Int): Str {
    if (x >= 0) {
        str.fromInt(ctx, x)
    } else {
        // The value is 2^64 + x. Its last digit is (6 + x mod 10) mod 10, since
        // 2^64 ends in 6, and the rest is a logical halving then a fifth.
        let rest = bits.shiftRight(x, 1) / 5;
        let last = ((x % 10 + 10) % 10 + 6) % 10;
        str.format(ctx, "${rest}${last}")
    }
}

/// `bytes`, base64 with padding.
export fn jsonBytes<C: Allocator>(ctx: C, b: [U8]): Json {
    Json.Str(bytes.toBase64(ctx, b))
}

/// The member of an object, if it is an object and has one that is not null.
/// proto3 JSON writes an absent field either by omitting it or as `null`, and
/// a reader treats the two the same.
export fn member(doc: Json, name: Str): Option<Json> {
    doc.get(name).andThen(fn(v) => if (v.isNull()) { .None } else { .Some(v) })
}

/// The same, under either of a field's two names.
///
/// proto3 JSON writes the lowerCamelCase name and accepts either it or the one
/// the schema wrote. The camel name wins where a document carries both.
export fn memberEither(doc: Json, name: Str, alternate: Str): Option<Json> {
    match (member(doc, name)) {
        .Some(v) => .Some(v),
        .None => member(doc, alternate),
    }
}

/// A `oneof` holds one case, so a document setting two of them is not the
/// message. `cases` is each case's two names, and a null member is unset.
export fn atMostOne<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
    oneof: Str,
    cases: [(Str, Str)],
): Result<(), ProtoError> {
    if (cases.count(fn(k) => memberEither(doc, k.0, k.1).isSome()) > 1) {
        .Err(.BadJson {
            path: path,
            wanted: str.format(ctx, "at most one case of ${oneof}"),
        })
    } else {
        .Ok(())
    }
}

/// An integer field's value, checked against the field's own range. A JSON
/// number, or the string proto3 writes a 64-bit one as.
///
/// proto3 JSON is stricter about numbers than JSON itself. A fractional value
/// is an error, not a rounding. A value outside the field's width is an error,
/// not a truncation — the *binary* format truncates instead. A quoted value is
/// fine, but it has to be a JSON number with nothing around it: no leading zero,
/// no surrounding space.
export fn asInt(doc: Json, path: Str, lo: Int, hi: Int): Result<Int, ProtoError> {
    match (doc) {
        .Num(x) => inRange(x, path, lo, hi),
        .Str(s) => {
            match (numericText(s)) {
                .Some(x) => inRange(x, path, lo, hi),
                .None => .Err(.BadJson { path: path, wanted: "an integer" }),
            }
        },
        _ => .Err(.BadJson { path: path, wanted: "an integer" }),
    }
}

fn inRange(x: Float, path: Str, lo: Int, hi: Int): Result<Int, ProtoError> {
    match (x.toI64()) {
        .Err(_e) => {
            if (math.isFinite(x) && math.truncate(x) != x) {
                .Err(.BadJson { path: path, wanted: "an integer" })
            } else {
                .Err(.BadJson { path: path, wanted: "an integer in range" })
            }
        },
        .Ok(n) => {
            if (n < lo || n > hi) {
                .Err(.BadJson { path: path, wanted: "an integer in range" })
            } else {
                .Ok(n)
            }
        },
    }
}

/// An `int64`, `sint64` or `sfixed64` field's value.
///
/// A quoted integer is read digit by digit, so a value past 2^53 is exact and
/// one past either end of the range is refused rather than rounded into it. A
/// JSON number, or a quoted one with a fraction or an exponent, is as exact as
/// the double it is.
export fn asInt64(doc: Json, path: Str): Result<Int, ProtoError> {
    match (plainDigits(doc)) {
        .Some((negative, digits)) => {
            if (negative && digits == "9223372036854775808") {
                .Ok(-9223372036854775807 - 1)
            } else if (atMost(digits, "9223372036854775807")) {
                let n = digits.toInt().withDefault(0);
                .Ok(if (negative) { 0 - n } else { n })
            } else {
                .Err(.BadJson { path: path, wanted: "an integer in range" })
            }
        },
        .None => asInt(doc, path, -9223372036854775807 - 1, 9223372036854775807),
    }
}

/// A `uint64` or `fixed64` field's value, 0 to 2^64 - 1, as the `Int` holding
/// its bits: a value past 2^63 - 1 comes back negative, and `jsonUint64` and the
/// binary encoder write it back as the same value.
export fn asUint64(doc: Json, path: Str): Result<Int, ProtoError> {
    match (plainDigits(doc)) {
        .Some((negative, digits)) => {
            if (negative) {
                if (digits == "0") {
                    .Ok(0)
                } else {
                    .Err(.BadJson { path: path, wanted: "an integer in range" })
                }
            } else if (atMost(digits, "9223372036854775807")) {
                .Ok(digits.toInt().withDefault(0))
            } else if (atMost(digits, "18446744073709551615")) {
                // 2^64 is 1844674407370955161 * 10 + 6, and the value less 2^64
                // is negative. The sum below is in this order so no step of it
                // leaves the range of an `Int`.
                let n = digits.length();
                let q = digits.slice(0, n - 1).toInt().withDefault(0);
                let d = digits.slice(n - 1, n).toInt().withDefault(0);
                .Ok((q - 1844674407370955161 + 1) * 10 + (d - 16))
            } else {
                .Err(.BadJson { path: path, wanted: "an integer in range" })
            }
        },
        .None => {
            match (doc) {
                .Num(x) => unsignedFloat(x, path),
                .Str(s) => {
                    match (numericText(s)) {
                        .Some(x) => unsignedFloat(x, path),
                        .None => .Err(.BadJson { path: path, wanted: "an integer" }),
                    }
                },
                _ => .Err(.BadJson { path: path, wanted: "an integer" }),
            }
        },
    }
}

/// A double from 2^63 to 2^64 is an integer, and less 2^64 it is the negative
/// `Int` with the same bits — exactly, because the two are in one binade.
fn unsignedFloat(x: Float, path: Str): Result<Int, ProtoError> {
    if (x >= 9223372036854775808.0 && x < 18446744073709551616.0) {
        inRange(x - 18446744073709551616.0, path, -9223372036854775807 - 1, -1)
    } else {
        inRange(x, path, 0, 9223372036854775807)
    }
}

/// A quoted integer with nothing but digits, as its sign and its digits. JSON's
/// grammar already refuses a leading zero, so equal values are equal text.
fn plainDigits(doc: Json): Option<(Bool, Str)> {
    match (doc) {
        .Str(s) => {
            let negative = s.startsWith("-");
            let digits = if (negative) { s.slice(1, s.length()) } else { s };
            if (wellFormedNumber(s) && digits.length() > 0 && allDigits(digits, 0)) {
                .Some((negative, digits))
            } else {
                .None
            }
        },
        _ => .None,
    }
}

fn allDigits(s: Str, i: Int): Bool {
    match (s.charAt(i)) {
        .None => true,
        .Some(c) => c.isDigit() && allDigits(s, i + 1),
    }
}

/// Whether one decimal is at most another, both without leading zeros.
fn atMost(digits: Str, bound: Str): Bool {
    digits.length() < bound.length()
        || digits.length() == bound.length() && digits <= bound
}

/// A quoted number, as proto3 JSON admits one: a JSON number and nothing else.
/// `1e5` counts, because it is a JSON number. `01` and ` 1` do not.
fn numericText(s: Str): Option<Float> {
    if (wellFormedNumber(s)) { s.toFloat() } else { .None }
}

/// JSON's own number grammar, checked character by character: `-?` then an
/// integer part that is `0` or begins with a non-zero digit, then whatever a
/// fraction and an exponent are made of.
fn wellFormedNumber(s: Str): Bool {
    let body = if (s.startsWith("-")) { s.slice(1, s.length()) } else { s };
    match ((body.charAt(0), body.charAt(1))) {
        (.None, _) => false,
        (.Some('0'), .Some(c)) => {
            (c == '.' || c == 'e' || c == 'E') && allNumeric(body, 1)
        },
        (.Some(c), _) => c.isDigit() && allNumeric(body, 1),
    }
}

fn allNumeric(s: Str, i: Int): Bool {
    match (s.charAt(i)) {
        .None => true,
        .Some(c) => {
            (c.isDigit() || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-')
                && allNumeric(s, i + 1)
        },
    }
}

/// A `double`. The three values JSON cannot spell arrive as the strings proto3
/// writes them as. A quoted ordinary number is fine too, and a value the type
/// cannot hold is an error rather than an infinity.
export fn asFloat(doc: Json, path: Str): Result<Float, ProtoError> {
    match (doc) {
        .Num(x) => finite(x, path),
        .Str(s) => {
            if (s == "NaN") {
                .Ok(nan())
            } else if (s == "Infinity") {
                .Ok(infinity())
            } else if (s == "-Infinity") {
                .Ok(0.0 - infinity())
            } else {
                match (numericText(s)) {
                    .Some(x) => finite(x, path),
                    .None => .Err(.BadJson { path: path, wanted: "a number" }),
                }
            }
        },
        _ => .Err(.BadJson { path: path, wanted: "a number" }),
    }
}

/// The same, for a `float` field: the value has to survive single precision.
export fn asFloat32(doc: Json, path: Str): Result<Float, ProtoError> {
    let x = asFloat(doc, path)?;
    // NaN and the two infinities are values a `float` holds, so the range check
    // only concerns the finite ones.
    if (math.isNan(x) || x > number.maxValue<F64>() || x < number.minValue<F64>()) {
        .Ok(x)
    } else if (
        x > number.maxValue<F32>().toF64() || x < number.minValue<F32>().toF64()
    ) {
        .Err(.BadJson { path: path, wanted: "a number a float can hold" })
    } else {
        .Ok(x)
    }
}

/// A written-out number that overflowed to an infinity is a number the type
/// cannot hold, and proto3 JSON says so rather than rounding to infinity.
fn finite(x: Float, path: Str): Result<Float, ProtoError> {
    if (math.isNan(x)) {
        .Ok(x)
    } else if (x > number.maxValue<F64>() || x < number.minValue<F64>()) {
        .Err(.BadJson { path: path, wanted: "a number a double can hold" })
    } else {
        .Ok(x)
    }
}

/// Built rather than named: the language has no literal for either.
fn infinity(): Float {
    1.0 / 0.0
}

fn nan(): Float {
    0.0 / 0.0
}

export fn asBool(doc: Json, path: Str): Result<Bool, ProtoError> {
    match (doc.asBool()) {
        .Some(b) => .Ok(b),
        .None => .Err(.BadJson { path: path, wanted: "a boolean" }),
    }
}

export fn asStr(doc: Json, path: Str): Result<Str, ProtoError> {
    match (doc.asStr()) {
        .Some(s) => .Ok(s),
        .None => .Err(.BadJson { path: path, wanted: "a string" }),
    }
}

/// A `bytes` field: base64, in either alphabet and with the padding optional.
///
/// `core/bytes` writes and reads the standard alphabet, always padded. proto3
/// JSON has to accept both, so the translation lives here.
export fn asBytes<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<[U8], ProtoError> {
    match (doc.asStr()) {
        .None => .Err(.BadJson { path: path, wanted: "base64" }),
        .Some(s) => {
            let standard = s.replace(ctx, "-", "+").replace(ctx, "_", "/");
            let padded = standard.concat(
                ctx,
                PAD.slice(0, (4 - standard.length() % 4) % 4),
            );
            match (bytes.fromBase64(ctx, padded)) {
                .Ok(b) => .Ok(b),
                .Err(_e) => .Err(.BadJson { path: path, wanted: "base64" }),
            }
        },
    }
}

let PAD: Str = "===";

/// A map field's object, as its members.
export fn asObject(doc: Json, path: Str): Result<[(Str, Json)], ProtoError> {
    match (doc) {
        .Object(members) => .Ok(members),
        _ => .Err(.BadJson { path: path, wanted: "an object" }),
    }
}

/// A `bool` map key, which JSON writes as the text `true` or `false`.
export fn asBoolKey(name: Str, path: Str): Result<Bool, ProtoError> {
    if (name == "true") {
        .Ok(true)
    } else if (name == "false") {
        .Ok(false)
    } else {
        .Err(.BadJson { path: path, wanted: "true or false" })
    }
}

export fn asArray(doc: Json, path: Str): Result<[Json], ProtoError> {
    match (doc.asArray()) {
        .Some(items) => .Ok(items),
        .None => .Err(.BadJson { path: path, wanted: "an array" }),
    }
}

/// A member's own path, for the error a reader deeper down will raise.
export fn at<C: Allocator>(ctx: C, path: Str, name: Str): Str {
    str.format(ctx, "${path}.${name}")
}

/// An element's path.
export fn index<C: Allocator>(ctx: C, path: Str, i: Int): Str {
    str.format(ctx, "${path}[${i}]")
}

// -----------------------------------------------------------------------------
// The well-known types' JSON
// -----------------------------------------------------------------------------
//
// proto3 JSON writes six of `google/protobuf`'s messages as something other
// than an object, and these are the forms. The generated `core/proto/duration`,
// `core/proto/timestamp` and `core/proto/field_mask` call them.

/// The member of an object, `null` included. A `google.protobuf.Value` and a
/// `NullValue` hold `null` as a value, so for those fields it is not absence.
export fn memberKeepingNull(doc: Json, name: Str, alternate: Str): Option<Json> {
    match (doc.get(name)) {
        .Some(v) => .Some(v),
        .None => doc.get(alternate),
    }
}

/// A `Duration`, as `"1.5s"`: seconds, then a fraction of 3, 6 or 9 digits if
/// there is one, then `s`.
export fn jsonDuration<C: Allocator>(ctx: C, seconds: Int, nanos: Int): Json {
    let sign = if (seconds < 0 || nanos < 0) { "-" } else { "" };
    let s = if (seconds < 0) { 0 - seconds } else { seconds };
    let n = if (nanos < 0) { 0 - nanos } else { nanos };
    Json.Str(str.format(ctx, "${sign}${s}${fraction(ctx, n)}s"))
}

/// The largest duration proto3 JSON writes: ten thousand years of seconds.
let MAX_DURATION: Int = 315576000000;

/// A `Duration` read from its string, as `(seconds, nanos)`, both with the
/// duration's sign.
export fn asDuration<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<(Int, Int), ProtoError> {
    let bad: Result<(Int, Int), ProtoError> = .Err(.BadJson {
        path: path,
        wanted: "a duration",
    });
    match (doc) {
        .Str(text) => {
            if (!text.endsWith("s")) {
                bad
            } else {
                let body = text.slice(0, text.length() - 1);
                let negative = body.startsWith("-");
                let unsigned = if (negative) {
                    body.slice(1, body.length())
                } else {
                    body
                };
                match (decimal(ctx, unsigned)) {
                    .Some((s, n)) => {
                        if (s > MAX_DURATION) {
                            bad
                        } else if (negative) {
                            .Ok((0 - s, 0 - n))
                        } else {
                            .Ok((s, n))
                        }
                    },
                    .None => bad,
                }
            }
        },
        _ => bad,
    }
}

/// `12.5` as `(12, 500000000)`: whole digits, then optionally a point and one
/// to nine more. Twelve whole digits at most, which is past any range here.
fn decimal<C: Allocator>(ctx: C, text: Str): Option<(Int, Int)> {
    let (whole, part, pointed) = match (text.splitOnce(".")) {
        .Some((a, b)) => (a, b, true),
        .None => (text, "", false),
    };
    let wholeOk = whole.length() > 0 && whole.length() <= 12 && allDigits(whole, 0);
    let partOk = !pointed
        || part.length() > 0 && part.length() <= 9 && allDigits(part, 0);
    if (wholeOk && partOk) {
        let s = whole.toInt().withDefault(0);
        let n = if (pointed) {
            part.padEnd(ctx, 9, '0').toInt().withDefault(0)
        } else {
            0
        };
        .Some((s, n))
    } else {
        .None
    }
}

/// A fraction of a second, as the shortest of 3, 6 or 9 digits that is exact,
/// with its point; nothing for a whole number.
fn fraction<C: Allocator>(ctx: C, n: Int): Str {
    if (n == 0) {
        ""
    } else if (n % 1000000 == 0) {
        str.format(ctx, ".${digits(ctx, n / 1000000, 3)}")
    } else if (n % 1000 == 0) {
        str.format(ctx, ".${digits(ctx, n / 1000, 6)}")
    } else {
        str.format(ctx, ".${digits(ctx, n, 9)}")
    }
}

fn digits<C: Allocator>(ctx: C, n: Int, width: Int): Str {
    str.fromInt(ctx, n).padStart(ctx, width, '0')
}

/// `a / b` rounded toward negative infinity, for a positive `b`.
fn floorDiv(a: Int, b: Int): Int {
    (a - floorMod(a, b)) / b
}

fn floorMod(a: Int, b: Int): Int {
    (a % b + b) % b
}

/// The earliest and latest instants proto3 JSON writes: 0001-01-01T00:00:00Z
/// and 9999-12-31T23:59:59Z, in seconds from the epoch.
let MIN_TIMESTAMP: Int = -62135596800;

let MAX_TIMESTAMP: Int = 253402300799;

/// A `Timestamp`, as RFC 3339 in UTC: `1970-01-01T00:00:10.500Z`.
export fn jsonTimestamp<C: Allocator>(ctx: C, seconds: Int, nanos: Int): Json {
    let days = floorDiv(seconds, 86400);
    let rest = seconds - days * 86400;
    let (y, m, d) = civil(days);
    let hh = rest / 3600;
    let mm = rest % 3600 / 60;
    let ss = rest % 60;
    Json.Str(
        str.format(
            ctx,
            "${digits(ctx, y, 4)}-${digits(ctx, m, 2)}-${digits(ctx, d, 2)}T${digits(
                ctx,
                hh,
                2,
            )}:${digits(ctx, mm, 2)}:${digits(ctx, ss, 2)}${fraction(ctx, nanos)}Z",
        ),
    )
}

/// A day number from the epoch as `(year, month, day)`, in the proleptic
/// Gregorian calendar.
fn civil(days: Int): (Int, Int, Int) {
    let z = days + 719468;
    let era = floorDiv(z, 146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if (mp < 10) { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400;
    (if (m <= 2) { y + 1 } else { y }, m, d)
}

/// The inverse: a date's day number from the epoch.
fn dayNumber(year: Int, month: Int, day: Int): Int {
    let y = if (month <= 2) { year - 1 } else { year };
    let era = floorDiv(y, 400);
    let yoe = y - era * 400;
    let mp = if (month > 2) { month - 3 } else { month + 9 };
    let doy = (153 * mp + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn daysIn(year: Int, month: Int): Int {
    let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
    if (month == 2) {
        if (leap) { 29 } else { 28 }
    } else if (month == 4 || month == 6 || month == 9 || month == 11) {
        30
    } else {
        31
    }
}

/// A `Timestamp` read from RFC 3339, as `(seconds, nanos)` from the epoch in
/// UTC. The `T` and the `Z` are capitals, an offset is `+hh:mm` or `-hh:mm`,
/// and the instant has to fall between the years 1 and 9999.
export fn asTimestamp<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<(Int, Int), ProtoError> {
    let bad: Result<(Int, Int), ProtoError> = .Err(.BadJson {
        path: path,
        wanted: "a timestamp",
    });
    match (doc) {
        .Str(text) => {
            match (instant(ctx, text)) {
                .Some((s, n)) => {
                    if (s < MIN_TIMESTAMP || s > MAX_TIMESTAMP) {
                        bad
                    } else {
                        .Ok((s, n))
                    }
                },
                .None => bad,
            }
        },
        _ => bad,
    }
}

fn instant<C: Allocator>(ctx: C, text: Str): Option<(Int, Int)> {
    // `YYYY-MM-DDThh:mm:ss` is nineteen characters, at fixed places.
    let shape = text.length() >= 20
        && text.charAt(4) == .Some('-')
        && text.charAt(7) == .Some('-')
        && text.charAt(10) == .Some('T')
        && text.charAt(13) == .Some(':')
        && text.charAt(16) == .Some(':');
    if (!shape) {
        .None
    } else {
        let year = number(text, 0, 4);
        let month = number(text, 5, 7);
        let day = number(text, 8, 10);
        let hour = number(text, 11, 13);
        let minute = number(text, 14, 16);
        let second = number(text, 17, 19);
        let rest = text.slice(19, text.length());
        let (nanos, zone) = if (rest.startsWith(".")) {
            let end = digitsEnd(rest, 1);
            let part = rest.slice(1, end);
            if (part.length() == 0 || part.length() > 9) {
                (-1, "")
            } else {
                (
                    part.padEnd(ctx, 9, '0').toInt().withDefault(-1),
                    rest.slice(end, rest.length()),
                )
            }
        } else {
            (0, rest)
        };
        let offset = zoneSeconds(zone);
        match ((year, month, day, hour, minute, second, offset)) {
            (.Some(y), .Some(mo), .Some(d), .Some(h), .Some(mi), .Some(s), .Some(off)) => {
                let valid = y >= 1
                    && mo >= 1
                    && mo <= 12
                    && d >= 1
                    && d <= daysIn(y, mo)
                    && h <= 23
                    && mi <= 59
                    && s <= 59
                    && nanos >= 0;
                if (valid) {
                    .Some(
                        (
                            dayNumber(y, mo, d) * 86400 + h * 3600 + mi * 60 + s - off,
                            nanos,
                        ),
                    )
                } else {
                    .None
                }
            },
            _ => .None,
        }
    }
}

/// `Z`, `+hh:mm` or `-hh:mm`, as seconds east of UTC.
fn zoneSeconds(zone: Str): Option<Int> {
    if (zone == "Z") {
        .Some(0)
    } else if (zone.length() == 6 && zone.charAt(3) == .Some(':')) {
        let sign: Option<Int> = match (zone.charAt(0)) {
            .Some('+') => .Some(1),
            .Some('-') => .Some(-1),
            _ => .None,
        };
        match ((sign, number(zone, 1, 3), number(zone, 4, 6))) {
            (.Some(s), .Some(h), .Some(m)) => {
                if (h <= 23 && m <= 59) {
                    .Some(s * (h * 3600 + m * 60))
                } else {
                    .None
                }
            },
            _ => .None,
        }
    } else {
        .None
    }
}

/// The digits from `start` to `end` as a number, if they are all digits.
fn number(text: Str, start: Int, end: Int): Option<Int> {
    let part = text.slice(start, end);
    if (part.length() == end - start && allDigits(part, 0)) {
        part.toInt()
    } else {
        .None
    }
}

fn digitsEnd(text: Str, i: Int): Int {
    match (text.charAt(i)) {
        .Some(c) => if (c.isDigit()) { digitsEnd(text, i + 1) } else { i },
        .None => i,
    }
}

/// A `FieldMask`, as its paths in lowerCamelCase joined by commas.
export fn jsonFieldMask<C: Allocator>(ctx: C, paths: [Str]): Json {
    Json.Str(paths.mapCtx(ctx, fn(c, p) => camelPath(c, p)).join(ctx, ","))
}

fn camelPath<C: Allocator>(ctx: C, path: Str): Str {
    let pieces = path.split(ctx, "_");
    let first = pieces.first().withDefault("");
    pieces
        .drop(ctx, 1)
        .foldCtx(
            ctx,
            fn(c, acc: Str, piece) => [acc, upperFirstChar(c, piece)].join(c, ""),
            first,
        )
}

fn upperFirstChar<C: Allocator>(ctx: C, s: Str): Str {
    match (s.charAt(0)) {
        .Some(c) => {
            str.fromChars(ctx, [c.toUpper()]).concat(ctx, s.slice(1, s.length()))
        },
        .None => s,
    }
}

/// A `FieldMask` read back: each comma-separated path from lowerCamelCase to
/// the schema's snake_case. An underscore in a path is refused, because no
/// field name writes one in this form.
export fn asFieldMask<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<[Str], ProtoError> {
    match (doc) {
        .Str(text) => {
            if (text == "") {
                .Ok([])
            } else if (text.contains("_")) {
                .Err(.BadJson { path: path, wanted: "a field mask" })
            } else {
                .Ok(text.split(ctx, ",").mapCtx(ctx, fn(c, p) => snakePath(c, p)))
            }
        },
        _ => .Err(.BadJson { path: path, wanted: "a field mask" }),
    }
}

fn snakePath<C: Allocator>(ctx: C, path: Str): Str {
    let out = path
        .chars(ctx)
        .foldCtx(
            ctx,
            fn(c, acc: [Char], ch) => {
                if (ch.isUpper()) {
                    acc.push(c, '_').push(c, ch.toLower())
                } else {
                    acc.push(c, ch)
                }
            },
            list.empty<Char>(),
        );
    str.fromChars(ctx, out)
}
