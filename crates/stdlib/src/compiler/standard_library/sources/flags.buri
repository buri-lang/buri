//! core/flags — a struct of `Bool`s, packed one bit to a field.
//!
//! `derive Flags` stores the struct in the smallest unsigned word that holds
//! every field: a `U8` up to 8 fields, a `U16` up to 16, a `U32` up to 32 and a
//! `U64` up to 64. Copying one copies the word, and nothing allocates. A field
//! is read as `x.read` and set as `Access { ..x, read: true }`, exactly as on
//! any struct, so a misspelt flag is a compile error rather than a wrong bit.
//!
//! ```buri run
//! from "core/flags" import * as flags;
//! from "core/flags" import { Flags };
//! from "core/io" import * as io;
//! from "node" import { NodeHost };
//! from "platform/effect" import { Allocator, Stdout };
//!
//! derive Flags, Equal, Show for Access;
//! struct Access {
//!     read: Bool,
//!     write: Bool,
//!     share: Bool,
//! }
//!
//! export fn main(host: NodeHost): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let editor = Access { ..flags.none<Access>(), read: true, write: true };
//!     let missing = flags.all<Access>().difference(editor);
//!     let _ = io.println(ctx, "${editor.count()} granted, missing ${missing}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! 2 granted, missing Access { read: false, write: false, share: true }
//! ```
//!
//! **What the packing keeps.** `Equal`, `Hash` and `Ordered` compare the word,
//! and the order is the one a plain struct's derived `Ordered` gives: the first
//! field decides first. `Show` prints the plain struct, and `ToJson` and
//! `FromJson` read and write its object of booleans, so the packing never
//! reaches a wire format.
//!
//! **Only a derive makes one.** Every field must be a `Bool`, there must be at
//! least one, and there may be at most 64. A hand-written `impl Flags` is
//! refused, because the operations are the packing.

/// The set operations every `derive Flags` type has. Each works on the word,
/// so it is pure and allocates nothing.
export trait Flags {
    /// The flags set on either side.
    fn union(self, other: Self): Self;
    /// The flags set on both sides.
    fn intersect(self, other: Self): Self;
    /// The flags set here and not in `other`.
    fn difference(self, other: Self): Self;
    /// The flags set on exactly one side.
    fn symmetricDifference(self, other: Self): Self;
    /// Every flag flipped.
    fn complement(self): Self;
    /// Whether every flag set here is set in `other` too.
    fn isSubsetOf(self, other: Self): Bool;
    /// Whether no flag is set.
    fn isEmpty(self): Bool;
    /// How many flags are set.
    fn count(self): Int;
}

/// Every flag false. A type has no methods of its own to call, so name it as
/// the type argument, `flags.none<Access>()`, or on the binding:
/// `let empty: Access = flags.none();`.
export fn none<T: Flags>(): T;

/// Every flag true.
export fn all<T: Flags>(): T;
