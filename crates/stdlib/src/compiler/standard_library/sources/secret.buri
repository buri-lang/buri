//! core/secret — a value that prints as `***`.
//!
//! `env.get` answers a `Secret<Str>`, and `core/crypto`'s keyed functions take a
//! `Secret<[U8]>`, so a key can go from the environment to the primitive
//! without anyone holding the text.
//!
//! ```buri run
//! from "core/io" import * as io;
//! from "core/secret" import * as secret;
//! from "core/secret" import { Secret };
//! from "node" import { NodeHost };
//! from "platform/effect" import { Allocator, Stdout };
//!
//! derive Show for Config;
//! struct Config {
//!     region: Str,
//!     apiKey: Secret<Str>,
//! }
//!
//! export fn main(host: NodeHost): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let config = Config { region: "eu-west-1", apiKey: secret.of("hunter2") };
//!     let _ = io.println(ctx, "${config.show(ctx)}").ignore();
//!     let _ = io.println(ctx, "Bearer ${config.apiKey.reveal()}").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! Config { region: "eu-west-1", apiKey: *** }
//! Bearer hunter2
//! ```
//!
//! A derived `Show` calls the field's own, so a `Secret` stays masked inside any
//! struct, enum, `Option` or list. A template hole refuses it, and so it refuses
//! a struct holding one: `"${config}"` does not compile, `config.show(ctx)` does.
//!
//! There is no `Equal`, `Ordered`, `Hash`, `ToJson` or `FromJson`, so a secret
//! cannot leak through a comparison report or a serializer. A struct holding one
//! cannot derive those either. Build the body that carries it by hand, with
//! `reveal()`, and compare two with `crypto.equalsConstantTime`:
//!
//! ```buri
//! # from "core/bytes" import * as bytes;
//! # from "core/crypto" import * as crypto;
//! # from "core/secret" import { Secret };
//! # from "platform/effect" import { Allocator };
//!
//! fn same<C: Allocator>(ctx: C, given: Secret<Str>, expected: Secret<Str>): Bool {
//!     crypto.equalsConstantTime(
//!         bytes.toUtf8(ctx, given.reveal()),
//!         bytes.toUtf8(ctx, expected.reveal()),
//!     )
//! }
//! ```
//!
//! Nothing is protected after `reveal()`, and nothing zeroes the memory.

from "core/order" import { Show };
from "platform/effect" import { Allocator };

/// A value that shows as `***`. The field is private, so `of` is the only way in
/// and `reveal` the only way out.
export struct Secret<T>(T);

/// Wraps `value`.
export fn of<T>(value: T): Secret<T> {
    Secret(value)
}

impl<T> Secret<T> {
    /// The value itself. Nothing is protected after this.
    export fn reveal(self): T {
        self.0
    }

    /// A secret holding `transform` of this one's value, which never leaves the
    /// wrapper.
    export fn map<U>(self, transform: fn(T) => U): Secret<U> {
        Secret(transform(self.0))
    }

    /// `map` where the function needs an effect, such as `bytes.toUtf8`:
    ///
    /// ```buri
    /// # from "core/bytes" import * as bytes;
    /// # from "core/secret" import { Secret };
    /// # from "platform/effect" import { Allocator };
    ///
    /// fn keyBytes<C: Allocator>(ctx: C, key: Secret<Str>): Secret<[U8]> {
    ///     key.mapCtx(ctx, fn(c, text) => bytes.toUtf8(c, text))
    /// }
    /// ```
    export fn mapCtx<U, C>(self, ctx: C, transform: fn(C, T) => U): Secret<U> {
        Secret(transform(ctx, self.0))
    }
}

/// `***`, whatever the value.
impl<T> Show for Secret<T> {
    fn show<C: Allocator>(self, ctx: C): Str {
        "***"
    }
}
