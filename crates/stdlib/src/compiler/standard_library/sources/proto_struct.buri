/// proto3 JSON writes a `ListValue` as the array it is.
export fn encodeListValueJson<C: Allocator>(
    ctx: C,
    value: ListValue,
): Result<Json, ProtoError> {
    let items = value
        .values
        .foldResultCtx(
            ctx,
            fn(c, acc: [Json], v) => {
                let i = acc.length();
                let one = proto.inElement(c, encodeValueJson(c, v), i)?;
                .Ok(acc.push(c, one))
            },
            list.empty<Json>(),
        )?;
    .Ok(Json.Array(items))
}

/// Reads a proto3 JSON document.
export fn decodeListValueJson<C: Allocator>(
    ctx: C,
    doc: Json,
): Result<ListValue, ProtoError> {
    decodeListValueJsonAt(ctx, doc, "$")
}

/// The same, from somewhere inside a larger document.
export fn decodeListValueJsonAt<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<ListValue, ProtoError> {
    let items = proto.asArray(doc, path)?;
    let values = items.foldResultCtx(
        ctx,
        fn(c, acc: [Value], item) => {
            let one = decodeValueJsonAt(c, item, path)?;
            .Ok(acc.push(c, one))
        },
        list.empty<Value>(),
    )?;
    .Ok(ListValue { values: values })
}
