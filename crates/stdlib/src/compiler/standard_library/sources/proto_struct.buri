/// proto3 JSON writes a `Struct` as the object it is.
export fn encodeStructJson<C: Allocator>(
    ctx: C,
    value: Struct,
): Result<Json, ProtoError> {
    let start: Result<[(Str, Json)], ProtoError> = .Ok(list.empty<(Str, Json)>());
    let members = value
        .fields
        .foldCtx(
            ctx,
            fn(c, acc: Result<[(Str, Json)], ProtoError>, k, v): Result<[(Str, Json)], ProtoError> => {
                let done = acc?;
                let one = proto.inMember(c, encodeValueJson(c, v), k)?;
                .Ok(done.push(c, (k, one)))
            },
            start,
        )?;
    .Ok(Json.Object(members))
}

/// Reads a proto3 JSON document.
export fn decodeStructJson<C: Allocator>(
    ctx: C,
    doc: Json,
): Result<Struct, ProtoError> {
    decodeStructJsonAt(ctx, doc, "$")
}

/// The same, from somewhere inside a larger document.
export fn decodeStructJsonAt<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<Struct, ProtoError> {
    let members = proto.asObject(doc, path)?;
    let fields = members.foldResultCtx(
        ctx,
        fn(c, acc: OrderedMap<Str, Value>, item) => {
            let (name, member) = item;
            let one = decodeValueJsonAt(c, member, proto.at(c, path, name))?;
            .Ok(acc.insert(c, name, one))
        },
        orderedmap.empty<Str, Value>(),
    )?;
    .Ok(Struct { fields: fields })
}

derive Equal, Show for Value_Kind;
/// The cases of `Value`'s `kind`.
export enum Value_Kind {
    NullValue(NullValue),
    NumberValue(Float),
    StringValue(Str),
    BoolValue(Bool),
    StructValue(Struct),
    ListValue(ListValue),
}

derive Equal, Show for Value;
export struct Value {
    export kind: Option<Value_Kind>,
}

/// Every field at its proto3 default: what a message of no bytes decodes to.
export fn defaultValue(): Value {
    Value { kind: .None }
}

/// How many bytes `encodeValue` writes.
export fn sizeValue(value: Value): Int {
    let size = match (value.kind) {
        .Some(k) => {
            match (k) {
                .NullValue(x) => 1 + proto.varintSize(encodeNullValue(x)),
                .NumberValue(x) => 1 + 8,
                .StringValue(x) => 1 + proto.strSize(x),
                .BoolValue(x) => 1 + 1,
                .StructValue(x) => 1 + proto.lenSize(sizeStruct(x)),
                .ListValue(x) => 1 + proto.lenSize(sizeListValue(x)),
            }
        },
        .None => 0,
    };
    size
}

/// `encodeValue`, appended to `out`.
export fn writeValue<C: Allocator>(ctx: C, out: [U8], value: Value): [U8] {
    match (value.kind) {
        .Some(k) => {
            match (k) {
                .NullValue(x) => {
                    proto.writeVarint(ctx, out.push(ctx, 8), encodeNullValue(x))
                },
                .NumberValue(x) => proto.writeF64(ctx, out.push(ctx, 17), x),
                .StringValue(x) => proto.writeStr(ctx, out.push(ctx, 26), x),
                .BoolValue(x) => {
                    proto.writeVarint(ctx, out.push(ctx, 32), if (x) { 1 } else { 0 })
                },
                .StructValue(x) => {
                    writeStruct(
                        ctx,
                        proto.writeVarint(ctx, out.push(ctx, 42), sizeStruct(x)),
                        x,
                    )
                },
                .ListValue(x) => {
                    writeListValue(
                        ctx,
                        proto.writeVarint(ctx, out.push(ctx, 50), sizeListValue(x)),
                        x,
                    )
                },
            }
        },
        .None => out,
    }
}

/// The protobuf wire encoding, fields in schema order.
///
/// A singular field holding its default is omitted, which is what proto3
/// calls the canonical encoding; a field that tracks presence and is set is
/// written whatever it holds, because that is the difference presence buys.
export fn encodeValue<C: Allocator>(ctx: C, value: Value): [U8] {
    writeValue(ctx, list.empty<U8>(), value)
}

/// Reads one message. A field this schema does not know is skipped, which is
/// proto3's forward compatibility and the whole of it.
export fn decodeValue<C: Allocator>(ctx: C, b: [U8]): Result<Value, ProtoError> {
    readValue(ctx, b, 0, b.length(), 0, defaultValue())
}

/// Reads one message *on top of* another.
///
/// A singular message field that arrives twice is merged rather than
/// replaced — the specification says so, and it is what makes a message
/// splittable across two encodings of itself. Every other kind of field
/// takes the later value, which merging also does.
export fn mergeValue<C: Allocator>(
    ctx: C,
    b: [U8],
    into: Value,
): Result<Value, ProtoError> {
    readValue(ctx, b, 0, b.length(), 0, into)
}

/// Reads the fields between `at` and `end` on top of `acc`, in place. An
/// error's offset counts from `base`, where the message starts.
export fn readValue<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: Value,
): Result<Value, ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (field, wire, next) = proto.readTag(b, at, end, base)?;
        if (field == 1 && wire == proto.VARINT) {
            let (raw, after) = proto.readVarint32(b, next, end, base)?;
            let value = decodeNullValue(proto.signed32(raw));
            readValue(ctx, b, after, end, base, Value {
                ..acc,
                kind: .Some(Value_Kind.NullValue(value)),
            })
        } else if (field == 2 && wire == proto.I64) {
            let (raw, after) = proto.readF64(b, next, end, base)?;
            let value = raw;
            readValue(ctx, b, after, end, base, Value {
                ..acc,
                kind: .Some(Value_Kind.NumberValue(value)),
            })
        } else if (field == 3 && wire == proto.LEN) {
            let (raw, after) = proto.readStr(ctx, b, next, end, base)?;
            let value = raw;
            readValue(ctx, b, after, end, base, Value {
                ..acc,
                kind: .Some(Value_Kind.StringValue(value)),
            })
        } else if (field == 4 && wire == proto.VARINT) {
            let (raw, after) = proto.readVarint(b, next, end, base)?;
            let value = raw != 0;
            readValue(ctx, b, after, end, base, Value {
                ..acc,
                kind: .Some(Value_Kind.BoolValue(value)),
            })
        } else if (field == 5 && wire == proto.LEN) {
            let (raw, after) = proto.readLen(b, next, end, base)?;
            let value = readStruct(ctx, b, raw, after, raw, match (acc.kind) {
                .Some(.StructValue(prev)) => prev,
                _ => defaultStruct(),
            })?;
            readValue(ctx, b, after, end, base, Value {
                ..acc,
                kind: .Some(Value_Kind.StructValue(value)),
            })
        } else if (field == 6 && wire == proto.LEN) {
            let (raw, after) = proto.readLen(b, next, end, base)?;
            let value = readListValue(ctx, b, raw, after, raw, match (acc.kind) {
                .Some(.ListValue(prev)) => prev,
                _ => defaultListValue(),
            })?;
            readValue(ctx, b, after, end, base, Value {
                ..acc,
                kind: .Some(Value_Kind.ListValue(value)),
            })
        } else {
            let after = proto.skip(b, next, end, base, wire)?;
            readValue(ctx, b, after, end, base, acc)
