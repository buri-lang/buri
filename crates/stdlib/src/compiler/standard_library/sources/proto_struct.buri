derive Equal, Show for NullValue;
export enum NullValue {
    NULL_VALUE,
    /// A number this schema does not name.
    ///
    /// Editions enums are open, and an open enum keeps a value it does not
    /// recognise rather than losing it — so a message written by a newer
    /// schema survives being read and written again by this one.
    Unrecognized(Int),
}

/// The number `NullValue` goes on the wire as.
export fn encodeNullValue(value: NullValue): Int {
    match (value) {
        .NULL_VALUE => 0,
        .Unrecognized(n) => n,
    }
}

/// A number this schema does not name is kept as `Unrecognized`.
///
/// That is what `features.enum_type = OPEN` means, and it is edition 2026's
/// default: adding a value to an enum does not break a reader built before
/// it, and the number it did not know comes back out unchanged.
export fn decodeNullValue(number: Int): NullValue {
    if (number == 0) { NullValue.NULL_VALUE } else { NullValue.Unrecognized(number) }
}

/// proto3 JSON writes `NullValue` as `null`.
export fn encodeNullValueJson(value: NullValue): Json {
    let _ = value;
    Json.Null
}

/// `null`, or the value's name.
export fn decodeNullValueJson(doc: Json, path: Str): Result<NullValue, ProtoError> {
    match (doc) {
        .Null => .Ok(NullValue.NULL_VALUE),
        .Str(s) => {
            if (s == "NULL_VALUE") {
                .Ok(NullValue.NULL_VALUE)
            } else {
                .Err(.BadJson { path: path, wanted: "null" })
            }
        },
        _ => .Err(.BadJson { path: path, wanted: "null" }),
    }
}

