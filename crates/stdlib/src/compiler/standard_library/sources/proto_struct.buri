/// proto3 JSON writes a `Value` as whichever JSON value it holds. NaN and
/// the infinities are refused, since JSON has no number for them.
export fn encodeValueJson<C: Allocator>(
    ctx: C,
    value: Value,
): Result<Json, ProtoError> {
    match (value.kind) {
        .Some(k) => {
            match (k) {
                .NullValue(_n) => .Ok(Json.Null),
                .NumberValue(x) => proto.jsonNumber(x),
                .StringValue(s) => .Ok(Json.Str(s)),
                .BoolValue(b) => .Ok(Json.Bool(b)),
                .StructValue(s) => encodeStructJson(ctx, s),
                .ListValue(l) => encodeListValueJson(ctx, l),
            }
        },
        .None => .Ok(Json.Null),
    }
}

/// Reads a proto3 JSON document.
export fn decodeValueJson<C: Allocator>(ctx: C, doc: Json): Result<Value, ProtoError> {
    decodeValueJsonAt(ctx, doc, "$")
}

/// The same, from somewhere inside a larger document. Any JSON value is one.
export fn decodeValueJsonAt<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<Value, ProtoError> {
    match (doc) {
        .Null => .Ok(Value { kind: .Some(Value_Kind.NullValue(NullValue.NULL_VALUE)) }),
        .Num(x) => .Ok(Value { kind: .Some(Value_Kind.NumberValue(x)) }),
        .Str(s) => .Ok(Value { kind: .Some(Value_Kind.StringValue(s)) }),
        .Bool(b) => .Ok(Value { kind: .Some(Value_Kind.BoolValue(b)) }),
        .Object(_members) => {
            .Ok(Value {
                kind: .Some(
                    Value_Kind.StructValue(decodeStructJsonAt(ctx, doc, path)?),
                ),
            })
        },
        .Array(_items) => {
            .Ok(Value {
                kind: .Some(
                    Value_Kind.ListValue(decodeListValueJsonAt(ctx, doc, path)?),
                ),
            })
        },
    }
}

derive Equal, Show for ListValue;
export struct ListValue {
    export values: [Value],
}

/// Every field at its proto3 default: what a message of no bytes decodes to.
export fn defaultListValue(): ListValue {
    ListValue { values: list.empty<Value>() }
}

/// How many bytes `encodeListValue` writes.
export fn sizeListValue(value: ListValue): Int {
    let size = value.values.fold(fn(n, x) => n + (1 + proto.lenSize(sizeValue(x))), 0);
    size
}

/// `encodeListValue`, appended to `out`.
export fn writeListValue<C: Allocator>(ctx: C, out: [U8], value: ListValue): [U8] {
    value
        .values
        .foldCtx(
            ctx,
            fn(c, acc: [U8], x) => {
                writeValue(c, proto.writeVarint(c, acc.push(c, 10), sizeValue(x)), x)
            },
            out,
        )
}

/// The protobuf wire encoding, fields in schema order.
///
/// A singular field holding its default is omitted, which is what proto3
/// calls the canonical encoding; a field that tracks presence and is set is
/// written whatever it holds, because that is the difference presence buys.
export fn encodeListValue<C: Allocator>(ctx: C, value: ListValue): [U8] {
    writeListValue(ctx, list.empty<U8>(), value)
}

/// Reads one message. A field this schema does not know is skipped, which is
/// proto3's forward compatibility and the whole of it.
export fn decodeListValue<C: Allocator>(
    ctx: C,
    b: [U8],
): Result<ListValue, ProtoError> {
    readListValue(ctx, b, 0, b.length(), 0, defaultListValue())
}

/// Reads one message *on top of* another.
///
/// A singular message field that arrives twice is merged rather than
/// replaced — the specification says so, and it is what makes a message
/// splittable across two encodings of itself. Every other kind of field
/// takes the later value, which merging also does.
export fn mergeListValue<C: Allocator>(
    ctx: C,
    b: [U8],
    into: ListValue,
): Result<ListValue, ProtoError> {
    readListValue(ctx, b, 0, b.length(), 0, into)
}

/// Reads the fields between `at` and `end` on top of `acc`, in place. An
/// error's offset counts from `base`, where the message starts.
export fn readListValue<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: ListValue,
): Result<ListValue, ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (field, wire, next) = proto.readTag(b, at, end, base)?;
        if (field == 1 && wire == proto.LEN) {
            let (raw, after) = proto.readLen(b, next, end, base)?;
            let value = readValue(ctx, b, raw, after, raw, defaultValue())?;
            readListValue(ctx, b, after, end, base, ListValue {
                ..acc,
                values: acc.values.push(ctx, value),
            })
        } else {
            let after = proto.skip(b, next, end, base, wire)?;
            readListValue(ctx, b, after, end, base, acc)
        }
    }
