/// How many bytes `encodeStruct` writes.
export fn sizeStruct(value: Struct): Int {
    let size = value
        .fields
        .fold(
            fn(n, k, x) => {
                n
                    + (1
                        + proto.lenSize(
                            1 + proto.strSize(k) + (1 + proto.lenSize(sizeValue(x))),
                        ))
            },
            0,
        );
    size
