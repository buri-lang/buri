                                c,
                                proto
                                    .writeVarint(
                                        c,
                                        acc.push(c, 10),
                                        1
                                            + proto.strSize(k)
                                            + (1 + proto.lenSize(sizeValue(x))),
                                    )
                                    .push(c, 10),
                                k,
                            )
                            .push(c, 18),
                        sizeValue(x),
                    ),
                    x,
                )
            },
            out,
        )
