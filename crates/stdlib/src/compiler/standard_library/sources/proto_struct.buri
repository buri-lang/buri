fn readStruct_fieldsEntry<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    key: Str,
    value: Value,
): Result<(Str, Value), ProtoError> {
    if (at >= end) {
        .Ok((key, value))
    } else {
        let (field, wire, next) = proto.readTag(b, at, end, base)?;
        if (field == 1 && wire == proto.LEN) {
            let (raw, after) = proto.readStr(ctx, b, next, end, base)?;
            let got = raw;
            readStruct_fieldsEntry(ctx, b, after, end, base, got, value)
        } else if (field == 2 && wire == proto.LEN) {
            let (raw, after) = proto.readLen(b, next, end, base)?;
            let got = readValue(ctx, b, raw, after, raw, value)?;
            readStruct_fieldsEntry(ctx, b, after, end, base, key, got)
        } else {
            let after = proto.skip(b, next, end, base, wire)?;
            readStruct_fieldsEntry(ctx, b, after, end, base, key, value)
        }
