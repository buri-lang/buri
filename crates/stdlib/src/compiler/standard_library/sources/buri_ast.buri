//! core/buri/ast — the Buri grammar as Buri data, with a printer that writes it
//! back out as source and a parser that reads source in.
//!
//! A generator builds a [`Module`] and calls [`print`]. What comes back is the
//! source text and one [`Anchor`] per node that knows where it came from, so a
//! diagnostic about a generated declaration can point at the input line that
//! produced it. A generator cannot emit a parse error, because there is no
//! variant here that spells one.
//!
//! [`parse`] is the door the other way, for a generator that has to look at
//! source it did not write, and [`tokenize`] is the lexer under it for a tool
//! that wants the tokens and no tree. Both are **written in Buri**: the
//! compiler's own parser is Rust in the toolchain, and a generator is linked as
//! JavaScript, so it could never be reached from one. What holds this
//! implementation to that one is `language::round_trip`, which rewrites the
//! whole conformance repository through `parse` and `print` and then runs it.
//!
//! **A child position is a one-element array.** A Buri type recurses through
//! `[T]`, so `If`'s condition is `[Expr]` and not `Expr`. An empty array is
//! where the child is optional: `FnDecl.body` is `[]` for a signature and
//! `[block]` for a body, and `Arm.guard` is `[]` for an arm with no `if`.
//!
//! **`print` writes what `buri format` leaves alone**, with one limit worth
//! stating: it does not know the page width. Every construct the formatter
//! always breaks — a function body, a struct or enum body, a `match`, a
//! `context`, a trait or an impl — comes out broken, and everything else comes
//! out on one line. A generated line past 88 columns is therefore the one
//! place `buri format` would still move the text.
//!
//! ```buri run
//! from "core/buri/ast" import * as ast;
//! from "core/io" import * as io;
//! from "node" import { NodeHost };
//! from "platform/effect" import { Allocator, Stdout };
//!
//! export fn main(host: NodeHost): Result<(), Str> {
//!     let ctx = context {
//!         Allocator: host.alloc,
//!         Stdout: host.stdout,
//!     };
//!     let id = ast.Type {
//!         kind: .Named(ast.Name { text: "Int", origin: ast.nowhere() }, []),
//!         origin: ast.nowhere(),
//!     };
//!     let tree = ast.Module {
//!         items: [
//!             ast.Item {
//!                 kind: .TypeAlias(ast.TypeAliasDecl {
//!                     name: ast.Name { text: "Id", origin: ast.nowhere() },
//!                     generics: [],
//!                     ty: id,
//!                     exported: true,
//!                     docs: ["A row's key."],
//!                 }),
//!                 origin: ast.origin("rows.schema", 0, 6),
//!             },
//!         ],
//!         docs: [],
//!     };
//!     let out = ast.print(ctx, tree);
//!     let _ = io.print(ctx, out.text).ignore();
//!     let _ = io.println(ctx, "${out.anchors.length()} anchor(s)").ignore();
//!     .Ok(())
//! }
//! ```
//!
//! ```stdout
//! /// A row's key.
//! export type Id = Int;
//! 1 anchor(s)
//! ```

from "core/bytes" import * as bytes;
from "core/list" import * as list;
from "core/map" import * as map;
from "core/math" import * as math;
from "core/number" import * as number;
from "core/order" import * as order;
from "core/str" import * as str;
from "platform/effect" import { Allocator };

// -----------------------------------------------------------------------------
// Where a node came from
// -----------------------------------------------------------------------------

derive Equal, Show for Span;
/// A half-open byte range.
export struct Span {
    export start: Int,
    export end: Int,
}

derive Equal, Show for Origin;
/// The input a node came from. An empty `file` means the generator invented
/// the node, and [`print`] records no anchor for it.
export struct Origin {
    export file: Str,
    export span: Span,
}

/// The origin of a node nothing produced.
export fn nowhere(): Origin {
    Origin { file: "", span: Span { start: 0, end: 0 } }
}

/// The origin of a node `file[start..end]` produced.
export fn origin(file: Str, start: Int, end: Int): Origin {
    Origin { file: file, span: Span { start: start, end: end } }
}

// -----------------------------------------------------------------------------
// The module
// -----------------------------------------------------------------------------

/// One generated source file. `docs` are its `//!` lines, without the marker.
export struct Module {
    export items: [Item],
    export docs: [Str],
}

/// A declaration.
export struct Item {
    export kind: ItemKind,
    export origin: Origin,
}

/// Every declaration the grammar has.
///
/// `Context` and `Test` are here for [`parse`] rather than for a generator: a
/// generated module declares neither, and both are legal only in a test source
/// (SPEC 11.2, 11.3). They are in the enum because reading a source back in has
/// to be able to represent it, and a test source that could not round-trip
/// would be a hole in the corpus rather than a rule about generators.
export enum ItemKind {
    Import(Import),
    ReExport(ReExport),
    Fn(FnDecl),
    Struct(StructDecl),
    Enum(EnumDecl),
    TypeAlias(TypeAliasDecl),
    Let(LetDecl),
    Trait(TraitDecl),
    Impl(ImplDecl),
    Derive(DeriveDecl),
    Context(ContextDecl),
    Test(TestDecl),
}

/// `from "path" import ...;`
export struct Import {
    export path: Str,
    export clause: ImportClause,
}

export enum ImportClause {
    /// `import { a, b as c }`
    Named([ImportSpec]),
    /// `import * as list`
    Namespace(Name),
}

/// One name of an import clause. `alias` is `[]` where the name is not renamed.
export struct ImportSpec {
    export name: Name,
    export alias: [Name],
}

/// `from "path" export { a, b };`
export struct ReExport {
    export path: Str,
    export specs: [ImportSpec],
}

/// One type parameter and the traits it is bounded by.
export struct GenericParam {
    export name: Name,
    export bounds: [Type],
}

/// One parameter. `self` is a parameter named `self` with no type, and `ctx`
/// is one named `ctx`.
export struct Param {
    export name: Name,
    export ty: [Type],
}

/// A function. `body` is `[]` for a signature — a trait method, or a method of
/// an effect.
export struct FnDecl {
    export name: Name,
    export generics: [GenericParam],
    export params: [Param],
    export ret: Type,
    export body: [Block],
    export exported: Bool,
    export docs: [Str],
}

export struct StructDecl {
    export name: Name,
    export generics: [GenericParam],
    export body: StructBody,
    export exported: Bool,
    export docs: [Str],
}

export enum StructBody {
    /// `struct Point { x: Int, y: Int }`
    Record([FieldDecl]),
    /// `struct Meters(F64);`
    Tuple([TupleField]),
}

export struct FieldDecl {
    export name: Name,
    export ty: Type,
    export exported: Bool,
    export docs: [Str],
    export origin: Origin,
}

export struct TupleField {
    export ty: Type,
    export exported: Bool,
    export origin: Origin,
}

export struct EnumDecl {
    export name: Name,
    export generics: [GenericParam],
    export variants: [Variant],
    export exported: Bool,
    export docs: [Str],
}

/// A variant carries no visibility of its own: it is exported exactly when the
/// enum that declares it is.
export struct Variant {
    export name: Name,
    export payload: VariantPayload,
    export docs: [Str],
    export origin: Origin,
}

export enum VariantPayload {
    /// `Red`
    Empty,
    /// `Some(T)`
    Tuple([Type]),
    /// `User { id: Int }`
    Record([FieldDecl]),
}

export struct TypeAliasDecl {
    export name: Name,
    export generics: [GenericParam],
    export ty: Type,
    export exported: Bool,
    export docs: [Str],
}

/// A module-level `let`, which names a type and binds a name rather than a
/// pattern. The block-level one is a [`Stmt`].
export struct LetDecl {
    export name: Name,
    export ty: Type,
    export value: Expr,
    export exported: Bool,
    export docs: [Str],
}

/// A `trait`, or an `effect` when `isEffect`. Every method is a signature: a
/// trait method has no body.
export struct TraitDecl {
    export name: Name,
    export generics: [GenericParam],
    export methods: [FnDecl],
    export isEffect: Bool,
    export exported: Bool,
    export docs: [Str],
}

/// `traitTy` is `[]` for an inherent `impl Type { ... }`.
export struct ImplDecl {
    export generics: [GenericParam],
    export traitTy: [Type],
    export selfTy: Type,
    export methods: [FnDecl],
    export docs: [Str],
}

/// `derive Equal, Show for Point;`
export struct DeriveDecl {
    export traits: [Type],
    export selfTy: Type,
}

/// `context Fixture { Allocator: alloc() }` — the declaration form, which is
/// constructed by calling it, so each use gets a fresh one. The bindings are
/// the same ones a `context { ... }` expression carries.
export struct ContextDecl {
    export name: Name,
    export spread: [Expr],
    export bindings: [Binding],
    export exported: Bool,
    export docs: [Str],
}

/// `test "a name in prose" { ... }`. The name is a string because a test name
/// is a sentence.
export struct TestDecl {
    export name: Str,
    export body: Block,
    export docs: [Str],
}

// -----------------------------------------------------------------------------
// Names and types
// -----------------------------------------------------------------------------

/// A name a declaration introduces, or one a written type or expression uses.
export struct Name {
    export text: Str,
    export origin: Origin,
}

export struct Type {
    export kind: TypeKind,
    export origin: Origin,
}

/// A written type.
export enum TypeKind {
    /// `Point`, or `Option<Str>` with its arguments.
    ///
    /// **The name carries the whole path, dots and all.** A generated module
    /// names the types it imported, so a generator writes `Allocator`; but source
    /// read back in may say `effects.Allocator`, and there is one `Name` here
    /// rather than a list of segments — so `Name.text` is `"effects.Allocator"`,
    /// spanning the whole path. `Self` arrives the same way, as the text
    /// `"Self"`.
    Named(Name, [Type]),
    /// `()`
    Unit,
    /// `(A, B)`
    Tuple([Type]),
    /// `[T]`, whose element is the one entry.
    Array([Type]),
    /// `fn(A, B) => R`, whose return type is the one entry of the second list.
    Fn([Type], [Type]),
}

// -----------------------------------------------------------------------------
// Expressions
// -----------------------------------------------------------------------------

export struct Expr {
    export kind: ExprKind,
    export origin: Origin,
}

export enum ExprKind {
    Int(Int),
    /// An integer literal the way it was *written*: `0xff`, `1_000`, or
    /// `18446744073709551615`, which is a `U64` in the program that holds it
    /// and does not fit an `Int` at all.
    ///
    /// [`parse`] answers `Int` where the digits are plain decimal and fit, and
    /// this where they are not — which is what keeps a radix, a separator and a
    /// hundred-and-twenty-eight-bit constant from coming back as something
    /// else. A generator writing one has to spell it, because there is no Buri
    /// number here wide enough to carry it.
    WideInt(Str),
    Float(Float),
    Str(Str),
    Char(Char),
    Bool(Bool),
    /// `"a ${b} c"`
    Template([Part]),
    Ident(Name),
    SelfValue,
    Ctx,
    /// `.Ok`
    DotVariant(Name),
    Unit,
    Array([Expr]),
    Tuple([Expr]),
    Block(Block),
    /// Condition, then-block, else-expression. Every `if` has an else.
    If([Expr], [Block], [Expr]),
    Match([Expr], [Arm]),
    /// `context { ..base, Allocator: alloc() }` — the spread, then the bindings.
    Context([Expr], [Binding]),
    /// Parameters, the written return type, and the body.
    Lambda([LambdaParam], [Type], [Expr]),
    Unary(UnOp, [Expr]),
    Binary(BinOp, [Expr], [Expr]),
    /// `base.name`
    Field([Expr], Name),
    /// `pair.0`
    TupleIndex([Expr], Int),
    Call([Expr], [Expr]),
    Index([Expr], [Expr]),
    /// `base?`
    Try([Expr]),
    /// `base<T>`
    Generic([Expr], [Type]),
    /// The head — `[]` for the anonymous `{ ... }` — the spread, and the
    /// fields.
    StructLit([Expr], [Expr], [Init]),
}

/// One piece of a template literal.
export enum Part {
    Text(Str),
    Hole(Expr),
}

/// One arm of a `match`. `guard` is `[]` for an arm with no `if`.
export struct Arm {
    export pattern: Pattern,
    export guard: [Expr],
    export body: Expr,
}

/// One field of a struct literal. `value` is `[]` for the `{ x }` shorthand.
export struct Init {
    export name: Name,
    export value: [Expr],
}

/// One parameter of a lambda. `ty` is `[]` where none is written.
export struct LambdaParam {
    export name: Name,
    export ty: [Type],
}

/// One binding of a `context` expression.
export struct Binding {
    export effectTy: Type,
    export value: Expr,
}

/// A block: its statements, and the expression it ends with. `tail` is `[]`
/// for a block whose value is `()`.
export struct Block {
    export stmts: [Stmt],
    export tail: [Expr],
    export origin: Origin,
}

export struct Stmt {
    export kind: StmtKind,
    export origin: Origin,
}

export enum StmtKind {
    /// `let p: T = value;`, whose type annotation is `[]` when inferred.
    Let(Pattern, [Type], Expr),
    /// `let ctx = value;`, which takes no pattern and no annotation.
    LetCtx(Expr),
    /// `value;`
    Expr(Expr),
}

// -----------------------------------------------------------------------------
// Patterns
// -----------------------------------------------------------------------------

export struct Pattern {
    export kind: PatternKind,
    export origin: Origin,
}

export enum PatternKind {
    /// `_`
    Wild,
    /// `x`, or `x @ sub`.
    Bind(Name, [Pattern]),
    LitInt(Int),
    LitFloat(Float),
    LitStr(Str),
    LitChar(Char),
    LitBool(Bool),
    /// `Some(x)`, `.Ok(v)`, `User { id, .. }`. The `Bool` is the leading dot.
    Path(Name, Bool, [Payload]),
    /// `()`
    Unit,
    Tuple([Pattern]),
    /// The elements, and the `..` that may close them.
    Array([Pattern], [Rest]),
    /// `a | b`
    Or([Pattern]),
}

/// What a variant pattern matches inside itself.
export enum Payload {
    /// `Some(x)`
    Tuple([Pattern]),
    /// `User { id, .. }` — the fields, and whether `..` closes them.
    Record([FieldPat], Bool),
}

/// One field of a record pattern. `pattern` is `[]` for the `{ id }`
/// shorthand.
export struct FieldPat {
    export name: Name,
    export pattern: [Pattern],
}

/// The `..` that may end an array pattern.
export enum Rest {
    /// `..`
    Anonymous,
    /// `..tail`
    Named(Name),
}

// -----------------------------------------------------------------------------
// Operators
// -----------------------------------------------------------------------------

export enum BinOp {
    Or,
    And,
    Eq,
    Ne,
    Lt,
    Le,
    Gt,
    Ge,
    BitOr,
    BitXor,
    BitAnd,
    Add,
    Sub,
    Mul,
    Div,
    Rem,
}

export enum UnOp {
    Neg,
    Not,
    BitNot,
}

// -----------------------------------------------------------------------------
// Printing
// -----------------------------------------------------------------------------

derive Equal, Show for Anchor;
/// Where one node landed in the printed text, and where it came from.
export struct Anchor {
    export start: Int,
    export end: Int,
    export origin: Origin,
}

derive Equal, Show for Printed;
/// The printed module, and the map back to the input.
///
/// `anchors` holds one entry per printed node whose origin names a file,
/// sorted by `start`, with the outermost first where two share one.
export struct Printed {
    export text: Str,
    export anchors: [Anchor],
}

/// `module` as source text, with an anchor for every node that came from
/// somewhere.
///
/// ```buri run
/// from "core/buri/ast" import * as ast;
/// from "core/io" import * as io;
/// from "node" import { NodeHost };
/// from "platform/effect" import { Allocator, Stdout };
///
/// export fn main(host: NodeHost): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let tree = ast.Module {
///         items: [
///             ast.Item {
///                 kind: .Import(ast.Import {
///                     path: "platform/effect",
///                     clause: .Named([
///                         ast.ImportSpec {
///                             name: ast.Name { text: "Allocator", origin: ast.nowhere() },
///                             alias: [],
///                         },
///                     ]),
///                 }),
///                 origin: ast.nowhere(),
///             },
///         ],
///         docs: [],
///     };
///     let _ = io.print(ctx, ast.print(ctx, tree).text).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// from "platform/effect" import { Allocator };
/// ```
export fn print<C: Allocator>(ctx: C, m: Module): Printed {
    let empty = Out {
        pieces: [],
        at: 0,
        anchors: [],
        owed: [],
        indent: 0,
        pending: false,
    };
    let out = printModule(ctx, empty, m);
    Printed {
        text: out.pieces.join(ctx, ""),
        anchors: out.anchors.sortBy(ctx, anchorOrder),
    }
}

/// By `start`, and then by the widest first, which is what puts a declaration
/// ahead of the name inside it.
fn anchorOrder(a: Anchor, b: Anchor): Order {
    match (order.int(a.start, b.start)) {
        .Equal => order.int(b.end, a.end),
        other => other,
    }
}

// --- the writer ----------------------------------------------------------------

/// What has been written: the pieces of the text, the byte offset the next one
/// starts at, the anchors collected so far, and the indent a new line takes.
///
/// `pending` is a line break whose indentation has not been written yet, so a
/// line nothing follows carries no trailing spaces.
///
/// `owed` is where an `if`/`else if` chain keeps the links it has written and
/// not yet anchored: every link of a chain ends where the chain does.
/// [`elseChain`] owns it, empties it, and hands it back.
struct Out {
    pieces: [Str],
    at: Int,
    anchors: [Anchor],
    owed: [(Int, Origin)],
    indent: Int,
    pending: Bool,
}

fn raw<C: Allocator>(ctx: C, out: Out, text: Str): Out {
    Out { ..out, pieces: out.pieces.push(ctx, text), at: out.at + byteLen(ctx, text) }
}

/// The UTF-8 length of `text`. An anchor is a byte range and `Str.length` counts
/// scalar values.
fn byteLen<C: Allocator>(ctx: C, text: Str): Int {
    bytes.toUtf8(ctx, text).length()
}

fn emit<C: Allocator>(ctx: C, out: Out, text: Str): Out {
    if (out.pending) {
        let indented = raw(
            ctx,
            Out { ..out, pending: false },
            "    ".repeat(ctx, out.indent),
        );
        raw(ctx, indented, text)
    } else {
        raw(ctx, out, text)
    }
}

/// A line break. The indentation waits until something is written on the line.
fn nl<C: Allocator>(ctx: C, out: Out): Out {
    Out { ..raw(ctx, out, "\n"), pending: true }
}

/// A line break with an empty line above it.
fn blankLine<C: Allocator>(ctx: C, out: Out): Out {
    nl(ctx, nl(ctx, out))
}

/// The offset the next piece will start at, with any waiting indentation
/// written first — so an anchor on a node that opens a line starts at the
/// node and not at the margin.
fn ready<C: Allocator>(ctx: C, out: Out): Out {
    emit(ctx, out, "")
}

/// One anchor, for a node that knows where it came from.
fn anchor<C: Allocator>(ctx: C, out: Out, start: Int, source: Origin): Out {
    if (source.file == "") {
        out
    } else {
        Out {
            ..out,
            anchors: out
                .anchors
                .push(ctx, Anchor { start: start, end: out.at, origin: source }),
        }
    }
}

fn indented(out: Out, by: Int): Out {
    Out { ..out, indent: out.indent + by }
}

/// The separator a list writes before every item but the first.
fn comma<C: Allocator>(ctx: C, acc: (Out, Bool), separator: Str): Out {
    if (acc.1) { emit(ctx, acc.0, separator) } else { acc.0 }
}

/// The line break a block writes before every line but the first.
fn nextLine<C: Allocator>(ctx: C, acc: (Out, Bool)): Out {
    if (acc.1) { nl(ctx, acc.0) } else { acc.0 }
}

/// The blank line a declaration writes before every one but the first.
fn nextBlank<C: Allocator>(ctx: C, acc: (Out, Bool)): Out {
    if (acc.1) { blankLine(ctx, acc.0) } else { acc.0 }
}

// --- the module ----------------------------------------------------------------

fn printModule<C: Allocator>(ctx: C, out: Out, m: Module): Out {
    // Every line written here ends with its own break, so an empty module is
    // an empty text rather than a lone newline.
    let head = docs(ctx, out, m.docs, "//!");
    let gap = !m.docs.isEmpty() && !m.items.isEmpty();
    let afterDocs = if (gap) { nl(ctx, head) } else { head };
    let run = leadingImports(ctx, m.items, 0, []);
    let sorted = sortImports(ctx, run);
    let rest = m.items.drop(ctx, run.length());
    let afterImports = sorted.foldCtx(
        ctx,
        fn(c, o, it) => nl(c, item(c, o, it)),
        afterDocs,
    );
    let started = if (!run.isEmpty() && !rest.isEmpty()) {
        nl(ctx, afterImports)
    } else {
        afterImports
    };
    printDecls(ctx, started, rest)
}

/// The leading items that are imports, each beside the key it sorts by. The
/// formatter sorts that run and leaves every later import where it was
/// written, so this does the same.
fn leadingImports<C: Allocator>(
    ctx: C,
    items: [Item],
    at: Int,
    acc: [((Int, Str, Str), Item)],
): [((Int, Str, Str), Item)] {
    match (items.get(at)) {
        .None => acc,
        .Some(it) => {
            match (it.kind) {
                .Import(i) => {
                    leadingImports(
                        ctx,
                        items,
                        at + 1,
                        acc.push(ctx, (importKey(ctx, i), it)),
                    )
                },
                _other => acc,
            }
        },
    }
}

/// The run in the order the formatter puts it in: the standard library first,
/// then by path, then by clause.
fn sortImports<C: Allocator>(ctx: C, run: [((Int, Str, Str), Item)]): [Item] {
    run.sortBy(ctx, fn(a, b) => keyOrder(a.0, b.0)).map(ctx, fn(pair) => pair.1)
}

fn keyOrder(a: (Int, Str, Str), b: (Int, Str, Str)): Order {
    match (order.int(a.0, b.0)) {
        .Equal => {
            match (order.str(a.1, b.1)) {
                .Equal => order.str(a.2, b.2),
                other => other,
            }
        },
        other => other,
    }
}

fn importKey<C: Allocator>(ctx: C, i: Import): (Int, Str, Str) {
    let group = if (i.path.startsWith("//")) { 1 } else { 0 };
    (group, i.path, clauseText(ctx, i.clause))
}

fn clauseText<C: Allocator>(ctx: C, clause: ImportClause): Str {
    match (clause) {
        .Namespace(n) => str.format(ctx, "* as ${n.text}"),
        .Named(specs) => {
            let names = specList(ctx, specs).join(ctx, ", ");
            str.format(ctx, "{ ${names} }")
        },
    }
}

/// The names of a clause, sorted the way the formatter sorts them: by the
/// lowercased spelling, with the exact one breaking the tie.
fn specList<C: Allocator>(ctx: C, specs: [ImportSpec]): [Str] {
    specs
        .mapCtx(ctx, fn(c, s) => specText(c, s))
        .mapCtx(ctx, fn(c, t) => (t.toLower(c), t))
        .sortBy(ctx, fn(a, b) => {
            match (order.str(a.0, b.0)) {
                .Equal => order.str(a.1, b.1),
                other => other,
            }
        })
        .map(ctx, fn(pair) => pair.1)
}

fn specText<C: Allocator>(ctx: C, spec: ImportSpec): Str {
    spec
        .alias
        .foldCtx(
            ctx,
            fn(c, _acc, a) => { str.format(c, "${spec.name.text} as ${a.text}") },
            spec.name.text,
        )
}

/// The declarations, one blank line apart, with every `derive` sitting on the
/// declaration it is about — which is where the formatter moves it.
///
/// Both lookups are maps rather than searches: a `derive` finds its
/// declaration by name, and a declaration finds its `derive`s by index. Each
/// used to be a pass over every item, which made printing quadratic in how many
/// declarations a module holds, and a module generated from a schema of a
/// thousand messages holds several thousand.
fn printDecls<C: Allocator>(ctx: C, out: Out, items: [Item]): Out {
    let numbered = items.indexed(ctx);
    // `map.of` keeps the last entry for a name, so back to front leaves each
    // name at its first declaration.
    let declared = map.of(
        ctx,
        numbered
            .filterMap(ctx, fn(e) => declaredName(e.1).map(fn(name) => (name, e.0)))
            .reverse(ctx),
    );
    // Each item beside its index and the index of the declaration it sits on.
    let rows = numbered.map(ctx, fn(e) => (e.0, attachment(declared, e.1), e.1));
    let derives = map.groupBy(ctx, rows.filter(ctx, fn(r) => r.1 >= 0), fn(r) => r.1);
    rows.foldCtx(
        ctx,
        fn(c, acc, r) => {
            if (r.1 >= 0) {
                acc
            } else {
                let opened = nextLine(c, acc);
                let derived = derives
                    .get(r.0)
                    .withDefault([])
                    .foldCtx(c, fn(d, o, row) => nl(d, item(d, o, row.2)), opened);
                (nl(c, item(c, derived, r.2)), true)
            }
        },
        (out, false),
    ).0
}

fn unitType(): Type {
    Type { kind: .Unit, origin: nowhere() }
}

/// The index of the declaration a `derive` belongs above, or `-1` for anything
/// that is not one, or a `derive` for a type this module does not declare.
fn attachment(declared: map.Map<Str, Int>, it: Item): Int {
    match (derivedName(it)) {
        .None => -1,
        .Some(name) => declared.get(name).withDefault(-1),
    }
}

/// The type a `derive` is about, when that is a bare name.
fn derivedName(it: Item): Option<Str> {
    match (it.kind) {
        .Derive(d) => {
            match (d.selfTy.kind) {
                .Named(n, args) => if (args.isEmpty()) { .Some(n.text) } else { .None },
                _other => .None,
            }
        },
        _other => .None,
    }
}

fn declaredName(it: Item): Option<Str> {
    match (it.kind) {
        .Struct(d) => .Some(d.name.text),
        .Enum(d) => .Some(d.name.text),
        .TypeAlias(d) => .Some(d.name.text),
        _other => .None,
    }
}

// --- declarations --------------------------------------------------------------

fn item<C: Allocator>(ctx: C, out: Out, it: Item): Out {
    let lead = itemDocs(ctx, out, it);
    let started = ready(ctx, lead);
    let written = itemKind(ctx, started, it.kind);
    anchor(ctx, written, started.at, it.origin)
}

fn itemDocs<C: Allocator>(ctx: C, out: Out, it: Item): Out {
    match (it.kind) {
        .Fn(d) => docs(ctx, out, d.docs, "///"),
        .Struct(d) => docs(ctx, out, d.docs, "///"),
        .Enum(d) => docs(ctx, out, d.docs, "///"),
        .TypeAlias(d) => docs(ctx, out, d.docs, "///"),
        .Let(d) => docs(ctx, out, d.docs, "///"),
        .Trait(d) => docs(ctx, out, d.docs, "///"),
        .Impl(d) => docs(ctx, out, d.docs, "///"),
        .Context(d) => docs(ctx, out, d.docs, "///"),
        .Test(d) => docs(ctx, out, d.docs, "///"),
        _other => out,
    }
}

fn docs<C: Allocator>(ctx: C, out: Out, lines: [Str], marker: Str): Out {
    lines.foldCtx(
        ctx,
        fn(c, o, line) => {
            let text = if (line == "") {
                marker
            } else {
                str.format(c, "${marker} ${line}")
            };
            nl(c, emit(c, o, text))
        },
        out,
    )
}

fn itemKind<C: Allocator>(ctx: C, out: Out, kind: ItemKind): Out {
    match (kind) {
        .Import(i) => importDecl(ctx, out, i),
        .ReExport(r) => {
            nameList(
                ctx,
                out,
                str.format(ctx, "from ${quote(ctx, r.path)} export"),
                r.specs,
            )
        },
        .Fn(d) => fnDecl(ctx, out, d),
        .Struct(d) => structDecl(ctx, out, d),
        .Enum(d) => enumDecl(ctx, out, d),
        .TypeAlias(d) => typeAlias(ctx, out, d),
        .Let(d) => letDecl(ctx, out, d),
        .Trait(d) => traitDecl(ctx, out, d),
        .Impl(d) => implDecl(ctx, out, d),
        .Derive(d) => deriveDecl(ctx, out, d),
        .Context(d) => contextDecl(ctx, out, d),
        .Test(d) => testDecl(ctx, out, d),
    }
}

/// `context Fixture { ... }`, whose braces are the ones a `context` expression
/// writes — the same production, with a name in front of it.
fn contextDecl<C: Allocator>(ctx: C, out: Out, d: ContextDecl): Out {
    let lead = if (d.exported) { "export context " } else { "context " };
    let named = name(ctx, emit(ctx, out, lead), d.name);
    contextBraces(ctx, emit(ctx, named, " {"), d.spread, d.bindings)
}

fn testDecl<C: Allocator>(ctx: C, out: Out, d: TestDecl): Out {
    braceBlock(
        ctx,
        emit(ctx, out, str.format(ctx, "test ${quote(ctx, d.name)}")),
        d.body,
    )
}

fn importDecl<C: Allocator>(ctx: C, out: Out, i: Import): Out {
    let head = str.format(ctx, "from ${quote(ctx, i.path)} import");
    match (i.clause) {
        .Namespace(n) => {
            let opened = emit(ctx, out, str.format(ctx, "${head} * as "));
            emit(ctx, name(ctx, opened, n), ";")
        },
        .Named(specs) => nameList(ctx, out, head, specs),
    }
}

fn nameList<C: Allocator>(ctx: C, out: Out, head: Str, specs: [ImportSpec]): Out {
    let names = specList(ctx, specs);
    if (names.isEmpty()) {
        emit(ctx, out, str.format(ctx, "${head} {};"))
    } else {
        emit(ctx, out, str.format(ctx, "${head} { ${names.join(ctx, ", ")} };"))
    }
}

fn fnDecl<C: Allocator>(ctx: C, out: Out, d: FnDecl): Out {
    let lead = if (d.exported) { "export fn " } else { "fn " };
    let opened = emit(ctx, out, lead);
    let named = name(ctx, opened, d.name);
    let generic = generics(ctx, named, d.generics);
    let params = d
        .params
        .foldCtx(
            ctx,
            fn(c, acc, p) => {
                let o = comma(c, acc, ", ");
                (param(c, o, p), true)
            },
            (emit(ctx, generic, "("), false),
        );
    let signature = ty(ctx, emit(ctx, params.0, "): "), d.ret);
    if (d.body.isEmpty()) {
        emit(ctx, signature, ";")
    } else {
        d.body.foldCtx(ctx, fn(c, o, b) => braceBlock(c, o, b), signature)
    }
}

fn param<C: Allocator>(ctx: C, out: Out, p: Param): Out {
    let named = name(ctx, out, p.name);
    p.ty.foldCtx(ctx, fn(c, o, t) => ty(c, emit(c, o, ": "), t), named)
}

fn generics<C: Allocator>(ctx: C, out: Out, gs: [GenericParam]): Out {
    if (gs.isEmpty()) {
        out
    } else {
        let listed = gs.foldCtx(
            ctx,
            fn(c, acc, g) => {
                let o = name(c, comma(c, acc, ", "), g.name);
                let bounded = g
                    .bounds
                    .foldCtx(
                        c,
                        fn(d, inner, b) => { (ty(d, comma(d, inner, " + "), b), true) },
                        (
                            if (g.bounds.isEmpty()) { o } else { emit(c, o, ": ") },
                            false,
                        ),
                    );
                (bounded.0, true)
            },
            (emit(ctx, out, "<"), false),
        );
        emit(ctx, listed.0, ">")
    }
}

/// ` { ... }` under a signature or a head, on lines of its own — or ` {}` for
/// a body with nothing in it.
fn braceBlock<C: Allocator>(ctx: C, out: Out, b: Block): Out {
    if (b.stmts.isEmpty() && b.tail.isEmpty()) {
        emit(ctx, out, " {}")
    } else {
        let opened = nl(ctx, emit(ctx, out, " {"));
        let inner = blockLines(ctx, indented(opened, 1), b);
        emit(ctx, nl(ctx, Out { ..inner, indent: out.indent }), "}")
    }
}

fn structDecl<C: Allocator>(ctx: C, out: Out, d: StructDecl): Out {
    let lead = if (d.exported) { "export struct " } else { "struct " };
    let head = generics(ctx, name(ctx, emit(ctx, out, lead), d.name), d.generics);
    match (d.body) {
        .Tuple(fields) => {
            let listed = fields.foldCtx(
                ctx,
                fn(c, acc, f) => {
                    let o = comma(c, acc, ", ");
                    let vis = if (f.exported) { emit(c, o, "export ") } else { o };
                    let started = ready(c, vis);
                    (anchor(c, ty(c, started, f.ty), started.at, f.origin), true)
                },
                (emit(ctx, head, "("), false),
            );
            emit(ctx, listed.0, ");")
        },
        .Record(fields) => {
            if (fields.isEmpty()) {
                emit(ctx, head, " {}")
            } else {
                let opened = nl(ctx, emit(ctx, head, " {"));
                let inner = fields.foldCtx(
                    ctx,
                    fn(c, acc, f) => {
                        (emit(c, fieldDecl(c, nextLine(c, acc), f), ","), true)
                    },
                    (indented(opened, 1), false),
                );
                emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), "}")
            }
        },
    }
}

fn fieldDecl<C: Allocator>(ctx: C, out: Out, f: FieldDecl): Out {
    let documented = docs(ctx, out, f.docs, "///");
    let started = ready(ctx, documented);
    let vis = if (f.exported) { emit(ctx, started, "export ") } else { started };
    let written = ty(ctx, emit(ctx, name(ctx, vis, f.name), ": "), f.ty);
    anchor(ctx, written, started.at, f.origin)
}

fn enumDecl<C: Allocator>(ctx: C, out: Out, d: EnumDecl): Out {
    let lead = if (d.exported) { "export enum " } else { "enum " };
    let head = generics(ctx, name(ctx, emit(ctx, out, lead), d.name), d.generics);
    if (d.variants.isEmpty()) {
        emit(ctx, head, " {}")
    } else {
        let opened = nl(ctx, emit(ctx, head, " {"));
        let inner = d
            .variants
            .foldCtx(
                ctx,
                fn(c, acc, v) => {
                    (emit(c, variant(c, nextLine(c, acc), v), ","), true)
                },
                (indented(opened, 1), false),
            );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), "}")
    }
}

fn variant<C: Allocator>(ctx: C, out: Out, v: Variant): Out {
    let documented = docs(ctx, out, v.docs, "///");
    let started = ready(ctx, documented);
    let named = name(ctx, started, v.name);
    let written = match (v.payload) {
        .Empty => named,
        .Tuple(types) => {
            let listed = types.foldCtx(
                ctx,
                fn(c, acc, t) => { (ty(c, comma(c, acc, ", "), t), true) },
                (emit(ctx, named, "("), false),
            );
            emit(ctx, listed.0, ")")
        },
        .Record(fields) => {
            let listed = fields.foldCtx(
                ctx,
                fn(c, acc, f) => { (fieldDecl(c, comma(c, acc, ", "), f), true) },
                (emit(ctx, named, " { "), false),
            );
            emit(ctx, listed.0, " }")
        },
    };
    anchor(ctx, written, started.at, v.origin)
}

fn typeAlias<C: Allocator>(ctx: C, out: Out, d: TypeAliasDecl): Out {
    let lead = if (d.exported) { "export type " } else { "type " };
    let head = generics(ctx, name(ctx, emit(ctx, out, lead), d.name), d.generics);
    emit(ctx, ty(ctx, emit(ctx, head, " = "), d.ty), ";")
}

fn letDecl<C: Allocator>(ctx: C, out: Out, d: LetDecl): Out {
    let lead = if (d.exported) { "export let " } else { "let " };
    let head = ty(ctx, emit(ctx, name(ctx, emit(ctx, out, lead), d.name), ": "), d.ty);
    emit(ctx, expr(ctx, emit(ctx, head, " = "), d.value), ";")
}

fn traitDecl<C: Allocator>(ctx: C, out: Out, d: TraitDecl): Out {
    let keyword = if (d.isEffect) { "effect " } else { "trait " };
    let lead = if (d.exported) {
        str.format(ctx, "export ${keyword}")
    } else {
        keyword
    };
    let head = generics(ctx, name(ctx, emit(ctx, out, lead), d.name), d.generics);
    if (d.methods.isEmpty()) {
        emit(ctx, head, " {}")
    } else {
        let opened = nl(ctx, emit(ctx, head, " {"));
        let inner = d
            .methods
            .foldCtx(
                ctx,
                fn(c, acc, m) => {
                    let o = nextLine(c, acc);
                    (fnDecl(c, docs(c, o, m.docs, "///"), signatureOnly(m)), true)
                },
                (indented(opened, 1), false),
            );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), "}")
    }
}

/// A trait method is a signature: the grammar gives it no body.
fn signatureOnly(m: FnDecl): FnDecl {
    FnDecl { ..m, body: [], exported: false, docs: [] }
}

fn implDecl<C: Allocator>(ctx: C, out: Out, d: ImplDecl): Out {
    let head = generics(ctx, emit(ctx, out, "impl"), d.generics);
    let named = d
        .traitTy
        .foldCtx(
            ctx,
            fn(c, o, t) => { emit(c, ty(c, emit(c, o, " "), t), " for") },
            head,
        );
    let target = ty(ctx, emit(ctx, named, " "), d.selfTy);
    if (d.methods.isEmpty()) {
        emit(ctx, target, " {}")
    } else {
        let opened = nl(ctx, emit(ctx, target, " {"));
        let inner = d
            .methods
            .foldCtx(
                ctx,
                fn(c, acc, m) => {
                    let o = nextBlank(c, acc);
                    (fnDecl(c, docs(c, o, m.docs, "///"), m), true)
                },
                (indented(opened, 1), false),
            );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), "}")
    }
}

fn deriveDecl<C: Allocator>(ctx: C, out: Out, d: DeriveDecl): Out {
    let listed = d
        .traits
        .foldCtx(
            ctx,
            fn(c, acc, t) => { (ty(c, comma(c, acc, ", "), t), true) },
            (emit(ctx, out, "derive "), false),
        );
    emit(ctx, ty(ctx, emit(ctx, listed.0, " for "), d.selfTy), ";")
}

// --- names and types -----------------------------------------------------------

fn name<C: Allocator>(ctx: C, out: Out, n: Name): Out {
    let started = ready(ctx, out);
    anchor(ctx, emit(ctx, started, n.text), started.at, n.origin)
}

fn ty<C: Allocator>(ctx: C, out: Out, t: Type): Out {
    let started = ready(ctx, out);
    let written = match (t.kind) {
        .Named(n, args) => {
            let named = name(ctx, started, n);
            if (args.isEmpty()) {
                named
            } else {
                emit(ctx, typeList(ctx, emit(ctx, named, "<"), args), ">")
            }
        },
        .Unit => emit(ctx, started, "()"),
        .Tuple(elems) => emit(ctx, typeList(ctx, emit(ctx, started, "("), elems), ")"),
        .Array(elem) => emit(ctx, typeList(ctx, emit(ctx, started, "["), elem), "]"),
        .Fn(params, ret) => {
            let head = emit(
                ctx,
                typeList(ctx, emit(ctx, started, "fn("), params),
                ") => ",
            );
            typeList(ctx, head, ret)
        },
    };
    anchor(ctx, written, started.at, t.origin)
}

fn typeList<C: Allocator>(ctx: C, out: Out, types: [Type]): Out {
    types.foldCtx(
        ctx,
        fn(c, acc, t) => (ty(c, comma(c, acc, ", "), t), true),
        (out, false),
    ).0
}

// --- statements ----------------------------------------------------------------

fn blockLines<C: Allocator>(ctx: C, out: Out, b: Block): Out {
    let afterStmts = b
        .stmts
        .foldCtx(
            ctx,
            fn(c, acc, s) => { (stmt(c, nextLine(c, acc), s), true) },
            (out, false),
        );
    b
        .tail
        .foldCtx(
            ctx,
            fn(c, acc, t) => { (expr(c, nextLine(c, acc), t), true) },
            afterStmts,
        ).0
}

fn stmt<C: Allocator>(ctx: C, out: Out, s: Stmt): Out {
    let started = ready(ctx, out);
    let written = match (s.kind) {
        .Let(p, annotation, value) => {
            let bound = pattern(ctx, emit(ctx, started, "let "), p);
            let typed = annotation.foldCtx(
                ctx,
                fn(c, o, t) => { ty(c, emit(c, o, ": "), t) },
                bound,
            );
            emit(ctx, expr(ctx, emit(ctx, typed, " = "), value), ";")
        },
        .LetCtx(value) => {
            emit(ctx, expr(ctx, emit(ctx, started, "let ctx = "), value), ";")
        },
        .Expr(value) => emit(ctx, expr(ctx, started, value), ";"),
    };
    anchor(ctx, written, started.at, s.origin)
}

// --- patterns ------------------------------------------------------------------

fn pattern<C: Allocator>(ctx: C, out: Out, p: Pattern): Out {
    let started = ready(ctx, out);
    let written = match (p.kind) {
        .Wild => emit(ctx, started, "_"),
        .Bind(n, sub) => {
            let bound = name(ctx, started, n);
            sub.foldCtx(ctx, fn(c, o, q) => pattern(c, emit(c, o, " @ "), q), bound)
        },
        .LitInt(n) => emit(ctx, started, str.fromInt(ctx, n)),
        .LitFloat(x) => emit(ctx, started, floatText(ctx, x)),
        .LitStr(text) => emit(ctx, started, quote(ctx, text)),
        .LitChar(ch) => emit(ctx, started, quoteChar(ctx, ch)),
        .LitBool(b) => emit(ctx, started, if (b) { "true" } else { "false" }),
        .Path(n, dotted, payload) => {
            let lead = if (dotted) { emit(ctx, started, ".") } else { started };
            let named = name(ctx, lead, n);
            payload.foldCtx(ctx, fn(c, o, pay) => patternPayload(c, o, pay), named)
        },
        .Unit => emit(ctx, started, "()"),
        .Tuple(elems) => {
            emit(ctx, patternList(ctx, emit(ctx, started, "("), elems), ")")
        },
        .Array(elems, rest) => {
            let listed = elems.foldCtx(
                ctx,
                fn(c, acc, q) => { (pattern(c, comma(c, acc, ", "), q), true) },
                (emit(ctx, started, "["), false),
            );
            let ended = rest.foldCtx(
                ctx,
                fn(c, acc, r) => {
                    let o = comma(c, acc, ", ");
                    match (r) {
                        .Anonymous => (emit(c, o, ".."), true),
                        .Named(n) => (name(c, emit(c, o, ".."), n), true),
                    }
                },
                listed,
            );
            emit(ctx, ended.0, "]")
        },
        .Or(alts) => {
            alts.foldCtx(
                ctx,
                fn(c, acc, q) => { (pattern(c, comma(c, acc, " | "), q), true) },
                (started, false),
            ).0
        },
    };
    anchor(ctx, written, started.at, p.origin)
}

fn patternList<C: Allocator>(ctx: C, out: Out, ps: [Pattern]): Out {
    ps.foldCtx(
        ctx,
        fn(c, acc, p) => (pattern(c, comma(c, acc, ", "), p), true),
        (out, false),
    ).0
}

fn patternPayload<C: Allocator>(ctx: C, out: Out, pay: Payload): Out {
    match (pay) {
        .Tuple(ps) => emit(ctx, patternList(ctx, emit(ctx, out, "("), ps), ")"),
        .Record(fields, rest) => {
            if (fields.isEmpty() && !rest) {
                emit(ctx, out, " {}")
            } else {
                let listed = fields.foldCtx(
                    ctx,
                    fn(c, acc, f) => {
                        let o = name(c, comma(c, acc, ", "), f.name);
                        (
                            f
                                .pattern
                                .foldCtx(
                                    c,
                                    fn(d, inner, q) => {
                                        pattern(d, emit(d, inner, ": "), q)
                                    },
                                    o,
                                ),
                            true,
                        )
                    },
                    (emit(ctx, out, " { "), false),
                );
                let ended = if (rest) { comma(ctx, listed, ", ") } else { listed.0 };
                emit(ctx, if (rest) { emit(ctx, ended, "..") } else { ended }, " }")
            }
        },
    }
}

// --- expressions ---------------------------------------------------------------

fn expr<C: Allocator>(ctx: C, out: Out, e: Expr): Out {
    let started = ready(ctx, out);
    let written = exprKind(ctx, started, e);
    anchor(ctx, written, started.at, e.origin)
}

fn exprKind<C: Allocator>(ctx: C, out: Out, e: Expr): Out {
    match (e.kind) {
        .Int(n) => emit(ctx, out, str.fromInt(ctx, n)),
        .WideInt(digits) => emit(ctx, out, digits),
        .Float(x) => emit(ctx, out, floatText(ctx, x)),
        .Str(text) => emit(ctx, out, quote(ctx, text)),
        .Char(ch) => emit(ctx, out, quoteChar(ctx, ch)),
        .Bool(b) => emit(ctx, out, if (b) { "true" } else { "false" }),
        .Template(parts) => template(ctx, out, parts),
        .Ident(n) => name(ctx, out, n),
        .SelfValue => emit(ctx, out, "self"),
        .Ctx => emit(ctx, out, "ctx"),
        .DotVariant(n) => name(ctx, emit(ctx, out, "."), n),
        .Unit => emit(ctx, out, "()"),
        .Array(elems) => bracketed(ctx, out, "[", elems, "]"),
        .Tuple(elems) => bracketed(ctx, out, "(", elems, ")"),
        .Block(b) => blockExpr(ctx, out, b),
        .If(cond, then, otherwise) => ifChain(ctx, out, cond, then, otherwise),
        .Match(scrutinee, arms) => matchExpr(ctx, out, scrutinee, arms),
        .Context(spread, bindings) => contextExpr(ctx, out, spread, bindings),
        .Lambda(params, ret, body) => lambda(ctx, out, params, ret, body),
        .Unary(op, operand) => atPrec(ctx, emit(ctx, out, unOpText(op)), operand, 10),
        .Binary(op, lhs, rhs) => {
            if (forces(e)) {
                brokenRun(ctx, out, e, binPrec(op))
            } else {
                let p = binPrec(op);
                let left = atPrec(ctx, out, lhs, leftBinding(p));
                let spaced = emit(ctx, left, str.format(ctx, " ${binOpText(op)} "));
                atPrec(ctx, spaced, rhs, p + 1)
            }
        },
        .Field(base, n) => name(ctx, emit(ctx, headOf(ctx, out, base), "."), n),
        .TupleIndex(base, index) => {
            let head = base.foldCtx(
                ctx,
                fn(c, o, b) => {
                    if (isTupleIndex(b)) {
                        emit(c, expr(c, emit(c, o, "("), b), ")")
                    } else {
                        operand(c, o, b)
                    }
                },
                out,
            );
            emit(ctx, head, str.format(ctx, ".${str.fromInt(ctx, index)}"))
        },
        .Call(callee, args) => callExpr(ctx, headOf(ctx, out, callee), args),
        .Index(base, index) => {
            emit(ctx, exprList(ctx, emit(ctx, headOf(ctx, out, base), "["), index), "]")
        },
        .Try(base) => emit(ctx, headOf(ctx, out, base), "?"),
        .Generic(base, args) => {
            emit(ctx, typeList(ctx, emit(ctx, headOf(ctx, out, base), "<"), args), ">")
        },
        .StructLit(head, spread, fields) => {
            structLit(ctx, out, head, spread, fields, forces(e))
        },
    }
}

/// A run of operators of one precedence that something inside has broken: the
/// head where it starts, and each operator after it opening a line of its own,
/// one level in. The formatter breaks the whole run together, so a chain of
/// `&&` reads down as a list of conditions.
fn brokenRun<C: Allocator>(ctx: C, out: Out, e: Expr, p: Int): Out {
    let (head, links) = spine(ctx, e, p);
    let first = atPrec(ctx, out, head, leftBinding(p));
    let rest = links.foldCtx(
        ctx,
        fn(c, o, link) => {
            let opened = emit(c, nl(c, o), str.format(c, "${binOpText(link.0)} "));
            atPrec(c, opened, link.1, p + 1)
        },
        indented(first, 1),
    );
    Out { ..rest, indent: out.indent }
}

/// The operands of the run of `p`-precedence operators `e` heads: the first,
/// and each of the rest beside the operator written before it. A comparison
/// under a comparison is one operand, since the rung does not associate and
/// one standing there was written in parentheses.
fn spine<C: Allocator>(ctx: C, e: Expr, p: Int): ([Expr], [(BinOp, [Expr])]) {
    match (e.kind) {
        .Binary(op, lhs, rhs) if binPrec(op) == p => {
            let (head, links) = if (p == 3) {
                (lhs, [])
            } else {
                lhs.foldCtx(ctx, fn(c, _acc, l) => spine(c, l, p), ([], []))
            };
            (head, links.push(ctx, (op, rhs)))
        },
        _other => ([e], []),
    }
}

/// `open`, the expressions and `close` on one line — or, when one of them
/// breaks, on lines of their own one level in, the way the formatter writes a
/// condition or a scrutinee.
fn parenthesised<C: Allocator>(
    ctx: C,
    out: Out,
    open: Str,
    xs: [Expr],
    close: Str,
): Out {
    if (xs.any(fn(e) => forces(e))) {
        let inner = exprList(ctx, indented(nl(ctx, emit(ctx, out, open)), 1), xs);
        emit(ctx, nl(ctx, Out { ..inner, indent: out.indent }), close)
    } else {
        emit(ctx, exprList(ctx, emit(ctx, out, open), xs), close)
    }
}

/// The head of a postfix chain, parenthesised where the grammar needs it.
fn headOf<C: Allocator>(ctx: C, out: Out, base: [Expr]): Out {
    base.foldCtx(ctx, fn(c, o, b) => operand(c, o, b), out)
}

fn operand<C: Allocator>(ctx: C, out: Out, e: Expr): Out {
    if (needsParens(e)) {
        emit(ctx, expr(ctx, emit(ctx, out, "("), e), ")")
    } else {
        expr(ctx, out, e)
    }
}

/// Parentheses only where precedence needs them.
fn atPrec<C: Allocator>(ctx: C, out: Out, xs: [Expr], parent: Int): Out {
    xs.foldCtx(
        ctx,
        fn(c, o, e) => {
            if (exprPrec(e) < parent) {
                emit(c, expr(c, emit(c, o, "("), e), ")")
            } else {
                expr(c, o, e)
            }
        },
        out,
    )
}

fn exprList<C: Allocator>(ctx: C, out: Out, xs: [Expr]): Out {
    xs.foldCtx(
        ctx,
        fn(c, acc, e) => (expr(c, comma(c, acc, ", "), e), true),
        (out, false),
    ).0
}

/// `[a, b]`, or one element to a line when something inside it must break.
fn bracketed<C: Allocator>(ctx: C, out: Out, open: Str, xs: [Expr], close: Str): Out {
    if (xs.isEmpty()) {
        emit(ctx, out, str.format(ctx, "${open}${close}"))
    } else if (!xs.any(fn(e) => forces(e))) {
        emit(ctx, exprList(ctx, emit(ctx, out, open), xs), close)
    } else {
        let opened = nl(ctx, emit(ctx, out, open));
        let inner = xs.foldCtx(
            ctx,
            fn(c, acc, e) => { (emit(c, expr(c, nextLine(c, acc), e), ","), true) },
            (indented(opened, 1), false),
        );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), close)
    }
}

/// An argument list. The last argument **hugs** when it has a shape of its own
/// to spill into and every argument before it stays on the head line.
fn callExpr<C: Allocator>(ctx: C, out: Out, args: [Expr]): Out {
    let last = args.length() - 1;
    let earlier = args.take(ctx, number.max(last, 0));
    if (args.isEmpty() || !args.any(fn(e) => forces(e))) {
        emit(ctx, exprList(ctx, emit(ctx, out, "("), args), ")")
    } else if (!earlier.any(fn(e) => forces(e)) && args.any(fn(e) => huggable(e))) {
        let head = earlier.foldCtx(
            ctx,
            fn(c, o, e) => emit(c, expr(c, o, e), ", "),
            emit(ctx, out, "("),
        );
        emit(
            ctx,
            args.drop(ctx, last).foldCtx(ctx, fn(c, o, e) => expr(c, o, e), head),
            ")",
        )
    } else {
        bracketed(ctx, out, "(", args, ")")
    }
}

fn template<C: Allocator>(ctx: C, out: Out, parts: [Part]): Out {
    let inner = parts.foldCtx(
        ctx,
        fn(c, o, part) => {
            match (part) {
                .Text(text) => emit(c, o, escapeTemplate(c, text)),
                // The two characters are written apart because a `Str` literal
                // holding `${` is a literal the formatter cannot print back.
                .Hole(e) => emit(c, expr(c, emit(c, emit(c, o, "$"), "{"), e), "}"),
            }
        },
        emit(ctx, out, "\""),
    );
    emit(ctx, inner, "\"")
}

/// `{ x }`, or a block on lines of its own.
fn blockExpr<C: Allocator>(ctx: C, out: Out, b: Block): Out {
    if (b.stmts.isEmpty() && b.tail.isEmpty()) {
        emit(ctx, nl(ctx, emit(ctx, out, "{")), "}")
    } else if (blockForces(b)) {
        let opened = nl(ctx, emit(ctx, out, "{"));
        let inner = blockLines(ctx, indented(opened, 1), b);
        emit(ctx, nl(ctx, Out { ..inner, indent: out.indent }), "}")
    } else {
        emit(ctx, blockLines(ctx, emit(ctx, out, "{ "), b), " }")
    }
}

/// The braces of an `if` branch, which are the chain's rather than the block's.
fn branch<C: Allocator>(ctx: C, out: Out, blocks: [Block], broken: Bool): Out {
    blocks.foldCtx(
        ctx,
        fn(c, o, b) => {
            // The brace that closes a branch belongs to the `else` that
            // follows it, so it is written here with its space attached.
            if (broken) {
                let opened = nl(c, emit(c, o, "{"));
                let inner = blockLines(c, indented(opened, 1), b);
                emit(c, nl(c, Out { ..inner, indent: o.indent }), "} ")
            } else {
                emit(c, blockLines(c, emit(c, o, "{ "), b), " } ")
            }
        },
        out,
    )
}

/// An `if`/`else if`/`else` chain, written link by link.
///
/// **A chain is as long as whatever wrote it made it, so printing one may not
/// spend stack on its length.** A generated decoder can be one link per field of
/// a message, and recursing into the `else` would cost two frames a link. The
/// links are walked instead, so what a chain costs is its text.
fn ifChain<C: Allocator>(
    ctx: C,
    out: Out,
    cond: [Expr],
    then: [Block],
    otherwise: [Expr],
): Out {
    let broken = ifForces(cond, then, otherwise);
    let head = parenthesised(ctx, out, "if (", cond, ") ");
    let body = branch(ctx, head, then, broken);
    elseChain(ctx, emit(ctx, body, "else "), otherwise, broken)
}

/// The `else` tail of a chain, and the anchors its links were owed.
///
/// A link's anchor covers the whole of the rest of the chain — the `else if` a
/// reader sees is a nested `if` in the tree — and nothing is written after a
/// chain's last link, so every one of those ends at the same offset.
///
/// The pending links live on `Out`, because a chain inside a chain's branch has
/// links of its own: this empties the seat before the walk and puts the outer
/// chain's back afterwards.
fn elseChain<C: Allocator>(ctx: C, out: Out, otherwise: [Expr], broken: Bool): Out {
    let outer = out.owed;
    let walked = elseLinks(ctx, Out { ..out, owed: [] }, otherwise, broken);
    let links = walked.owed;
    let restored = Out { ..walked, owed: outer };
    links.foldCtx(ctx, fn(c, o, l) => anchor(c, o, l.0, l.1), restored)
}

/// One link written, then the next — a self tail call, which is a loop by the
/// time it runs (SPEC 8.3).
fn elseLinks<C: Allocator>(ctx: C, out: Out, otherwise: [Expr], broken: Bool): Out {
    match (otherwise.first()) {
        .None => out,
        .Some(e) => {
            match (e.kind) {
                .Block(b) => {
                    let started = ready(ctx, out);
                    owe(ctx, branchBlock(ctx, started, b, broken), started.at, e.origin)
                },
                .If(cond, then, rest) => {
                    let started = ready(ctx, out);
                    let head = parenthesised(ctx, started, "if (", cond, ") ");
                    let body = emit(ctx, branch(ctx, head, then, broken), "else ");
                    elseLinks(ctx, owe(ctx, body, started.at, e.origin), rest, broken)
                },
                // An `else` takes a block or another `if`, so anything else is
                // wrapped in braces rather than written bare. `else .Line(n)`
                // is not Buri, and a printer that wrote one would be emitting
                // a parse error out of a tree that cannot hold one.
                _other => {
                    let started = ready(ctx, out);
                    let wrapped = Block { stmts: [], tail: [e], origin: e.origin };
                    owe(
                        ctx,
                        branchBlock(ctx, started, wrapped, broken),
                        started.at,
                        e.origin,
                    )
                },
            }
        },
    }
}

/// One link, remembered until the chain it belongs to ends.
///
/// The same test [`anchor`] makes, made before the offset is kept rather than
/// after: a node nobody can point at is owed nothing.
fn owe<C: Allocator>(ctx: C, out: Out, start: Int, source: Origin): Out {
    if (source.file == "") {
        out
    } else {
        Out { ..out, owed: out.owed.push(ctx, (start, source)) }
    }
}

fn branchBlock<C: Allocator>(ctx: C, out: Out, b: Block, broken: Bool): Out {
    if (broken) {
        let opened = nl(ctx, emit(ctx, out, "{"));
        let inner = blockLines(ctx, indented(opened, 1), b);
        emit(ctx, nl(ctx, Out { ..inner, indent: out.indent }), "}")
    } else {
        emit(ctx, blockLines(ctx, emit(ctx, out, "{ "), b), " }")
    }
}

fn matchExpr<C: Allocator>(ctx: C, out: Out, scrutinee: [Expr], arms: [Arm]): Out {
    let head = parenthesised(ctx, out, "match (", scrutinee, ") {");
    if (arms.isEmpty()) {
        emit(ctx, nl(ctx, head), "}")
    } else {
        let opened = nl(ctx, head);
        let inner = arms.foldCtx(
            ctx,
            fn(c, acc, a) => (arm(c, nextLine(c, acc), a), true),
            (indented(opened, 1), false),
        );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), "}")
    }
}

fn arm<C: Allocator>(ctx: C, out: Out, a: Arm): Out {
    let matched = pattern(ctx, out, a.pattern);
    let guarded = a
        .guard
        .foldCtx(ctx, fn(c, o, g) => expr(c, emit(c, o, " if "), g), matched);
    let arrow = emit(ctx, guarded, " => ");
    let body = match (a.body.kind) {
        .Block(_b) => expr(ctx, arrow, a.body),
        _other => {
            if (forces(a.body)) {
                let opened = nl(ctx, emit(ctx, arrow, "{"));
                let inner = expr(ctx, indented(opened, 1), a.body);
                emit(ctx, nl(ctx, Out { ..inner, indent: out.indent }), "}")
            } else {
                expr(ctx, arrow, a.body)
            }
        },
    };
    emit(ctx, body, ",")
}

fn contextExpr<C: Allocator>(
    ctx: C,
    out: Out,
    spread: [Expr],
    bindings: [Binding],
): Out {
    contextBraces(ctx, emit(ctx, out, "context {"), spread, bindings)
}

/// The braces of a `context`, whichever of its two forms wrote the head. The
/// head is already emitted, so the indent to come back to is the one it kept.
fn contextBraces<C: Allocator>(
    ctx: C,
    head: Out,
    spread: [Expr],
    bindings: [Binding],
): Out {
    if (spread.isEmpty() && bindings.isEmpty()) {
        emit(ctx, nl(ctx, head), "}")
    } else {
        let opened = indented(nl(ctx, head), 1);
        let spilled = spread.foldCtx(
            ctx,
            fn(c, acc, e) => {
                (emit(c, expr(c, emit(c, nextLine(c, acc), ".."), e), ","), true)
            },
            (opened, false),
        );
        let inner = bindings.foldCtx(
            ctx,
            fn(c, acc, b) => {
                let o = ty(c, nextLine(c, acc), b.effectTy);
                (emit(c, expr(c, emit(c, o, ": "), b.value), ","), true)
            },
            spilled,
        );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: head.indent }), "}")
    }
}

fn lambda<C: Allocator>(
    ctx: C,
    out: Out,
    params: [LambdaParam],
    ret: [Type],
    body: [Expr],
): Out {
    let listed = params.foldCtx(
        ctx,
        fn(c, acc, p) => {
            let o = name(c, comma(c, acc, ", "), p.name);
            (
                p.ty.foldCtx(c, fn(d, inner, t) => ty(d, emit(d, inner, ": "), t), o),
                true,
            )
        },
        (emit(ctx, out, "fn("), false),
    );
    let typed = ret.foldCtx(
        ctx,
        fn(c, o, t) => ty(c, emit(c, o, ": "), t),
        emit(ctx, listed.0, ")"),
    );
    let arrow = emit(ctx, typed, " => ");
    body.foldCtx(
        ctx,
        fn(c, o, e) => {
            match (e.kind) {
                .Block(_b) => expr(c, o, e),
                _other => {
                    if (forces(e)) {
                        let opened = nl(c, emit(c, o, "{"));
                        let inner = expr(c, indented(opened, 1), e);
                        emit(c, nl(c, Out { ..inner, indent: o.indent }), "}")
                    } else {
                        expr(c, o, e)
                    }
                },
            }
        },
        arrow,
    )
}

/// A struct literal, on one line unless `broken`: a break anywhere in it,
/// its head included, breaks all of it, as the formatter does.
fn structLit<C: Allocator>(
    ctx: C,
    out: Out,
    head: [Expr],
    spread: [Expr],
    fields: [Init],
    broken: Bool,
): Out {
    let named = head.foldCtx(ctx, fn(c, o, e) => emit(c, operand(c, o, e), " "), out);
    if (spread.isEmpty() && fields.isEmpty()) {
        emit(ctx, named, "{ }")
    } else if (!broken) {
        let opened = spread.foldCtx(
            ctx,
            fn(c, acc, e) => { (expr(c, emit(c, comma(c, acc, ", "), ".."), e), true) },
            (emit(ctx, named, "{ "), false),
        );
        let inner = fields.foldCtx(
            ctx,
            fn(c, acc, f) => (init(c, comma(c, acc, ", "), f), true),
            opened,
        );
        emit(ctx, inner.0, " }")
    } else {
        let opened = indented(nl(ctx, emit(ctx, named, "{")), 1);
        let spilled = spread.foldCtx(
            ctx,
            fn(c, acc, e) => {
                (emit(c, expr(c, emit(c, nextLine(c, acc), ".."), e), ","), true)
            },
            (opened, false),
        );
        let inner = fields.foldCtx(
            ctx,
            fn(c, acc, f) => { (emit(c, init(c, nextLine(c, acc), f), ","), true) },
            spilled,
        );
        emit(ctx, nl(ctx, Out { ..inner.0, indent: out.indent }), "}")
    }
}

fn init<C: Allocator>(ctx: C, out: Out, f: Init): Out {
    let named = name(ctx, out, f.name);
    f.value.foldCtx(ctx, fn(c, o, e) => expr(c, emit(c, o, ": "), e), named)
}

// --- what breaks whatever the width --------------------------------------------

/// Whether the formatter breaks this expression however wide the page is —
/// which is what `print` follows, having no width of its own.
fn forces(e: Expr): Bool {
    match (e.kind) {
        .Match(_s, _a) => true,
        .Context(_s, _b) => true,
        .Block(b) => blockForces(b),
        .If(cond, then, otherwise) => ifForces(cond, then, otherwise),
        .Template(parts) => parts.any(fn(p) => partForces(p)),
        .Array(xs) => xs.any(fn(x) => forces(x)),
        .Tuple(xs) => xs.any(fn(x) => forces(x)),
        .Lambda(_p, _r, body) => body.any(fn(x) => forces(x)),
        .Unary(_op, x) => x.any(fn(y) => forces(y)),
        .Binary(_op, lhs, rhs) => {
            lhs.any(fn(x) => forces(x)) || rhs.any(fn(x) => forces(x))
        },
        .Field(base, _n) => base.any(fn(x) => forces(x)),
        .TupleIndex(base, _i) => base.any(fn(x) => forces(x)),
        .Call(callee, args) => {
            callee.any(fn(x) => forces(x)) || args.any(fn(x) => forces(x))
        },
        .Index(base, index) => {
            base.any(fn(x) => forces(x)) || index.any(fn(x) => forces(x))
        },
        .Try(base) => base.any(fn(x) => forces(x)),
        .Generic(base, _a) => base.any(fn(x) => forces(x)),
        .StructLit(head, spread, fields) => {
            head.any(fn(x) => forces(x))
                || spread.any(fn(x) => forces(x))
                || fields.any(fn(f) => initForces(f))
        },
        _other => false,
    }
}

fn partForces(p: Part): Bool {
    match (p) {
        .Text(_t) => false,
        .Hole(e) => forces(e),
    }
}

fn initForces(f: Init): Bool {
    f.value.any(fn(e) => forces(e))
}

/// A block of two or more lines has a break in it, and so does an empty one —
/// its braces go on lines of their own.
fn blockForces(b: Block): Bool {
    b.stmts.length() + b.tail.length() != 1
        || b.stmts.any(fn(s) => stmtForces(s))
        || b.tail.any(fn(e) => forces(e))
}

fn stmtForces(s: Stmt): Bool {
    match (s.kind) {
        .Let(_p, _t, value) => forces(value),
        .LetCtx(value) => forces(value),
        .Expr(value) => forces(value),
    }
}

fn ifForces(cond: [Expr], then: [Block], otherwise: [Expr]): Bool {
    cond.any(fn(e) => forces(e))
        || then.any(fn(b) => branchForces(b))
        || elseForces(otherwise)
}

/// An `if` branch is laid out by the chain rather than as a block expression,
/// so an empty one does not break the chain the way an empty block does.
fn branchForces(b: Block): Bool {
    b.stmts.length() + b.tail.length() > 1
        || b.stmts.any(fn(s) => stmtForces(s))
        || b.tail.any(fn(e) => forces(e))
}

/// The `else` tail of a chain, walked rather than recursed into, for the reason
/// [`elseChain`] gives.
fn elseForces(otherwise: [Expr]): Bool {
    match (otherwise.first()) {
        .None => false,
        .Some(e) => {
            match (e.kind) {
                .Block(b) => branchForces(b),
                .If(cond, then, rest) => {
                    if (
                        cond.any(fn(x) => forces(x))
                            || then.any(fn(b) => branchForces(b))
                    ) {
                        true
                    } else {
                        elseForces(rest)
                    }
                },
                _other => forces(e),
            }
        },
    }
}

/// Whether a trailing argument has a shape a wide call can spill into.
fn huggable(e: Expr): Bool {
    match (e.kind) {
        .Lambda(_p, _r, _b) => true,
        .Array(_x) => true,
        .StructLit(_h, _s, _f) => true,
        _other => isBlockLike(e),
    }
}

fn isBlockLike(e: Expr): Bool {
    match (e.kind) {
        .Block(_b) => true,
        .If(_c, _t, _e) => true,
        .Match(_s, _a) => true,
        .Context(_s, _b) => true,
        _other => false,
    }
}

fn isTupleIndex(e: Expr): Bool {
    match (e.kind) {
        .TupleIndex(_b, _i) => true,
        _other => false,
    }
}

/// A block-like expression may not head a postfix chain, so it takes
/// parentheses; so does anything binding looser than a postfix operator.
fn needsParens(e: Expr): Bool {
    exprPrec(e) < 10 || isBlockLike(e)
}

fn exprPrec(e: Expr): Int {
    match (e.kind) {
        .Lambda(_p, _r, _b) => 0,
        .Binary(op, _l, _r) => binPrec(op),
        .Unary(_op, _x) => 9,
        _other => 10,
    }
}

/// The precedence ladder of SPEC 6.1, lowest to highest.
fn binPrec(op: BinOp): Int {
    match (op) {
        .Or => 1,
        .And => 2,
        .Eq => 3,
        .Ne => 3,
        .Lt => 3,
        .Le => 3,
        .Gt => 3,
        .Ge => 3,
        .BitOr => 4,
        .BitXor => 5,
        .BitAnd => 6,
        .Add => 7,
        .Sub => 7,
        .Mul => 8,
        .Div => 8,
        .Rem => 8,
    }
}

/// What the left operand of a `p`-precedence operator must bind at least as
/// tightly as. The ladder associates left, so a left operand may sit on its
/// operator's own rung — except at the comparison rung, which does not
/// associate at all.
fn leftBinding(p: Int): Int {
    if (p == 3) { p + 1 } else { p }
}

fn binOpText(op: BinOp): Str {
    match (op) {
        .Or => "||",
        .And => "&&",
        .Eq => "==",
        .Ne => "!=",
        .Lt => "<",
        .Le => "<=",
        .Gt => ">",
        .Ge => ">=",
        .BitOr => "|",
        .BitXor => "^",
        .BitAnd => "&",
        .Add => "+",
        .Sub => "-",
        .Mul => "*",
        .Div => "/",
        .Rem => "%",
    }
}

fn unOpText(op: UnOp): Str {
    match (op) {
        .Neg => "-",
        .Not => "!",
        .BitNot => "~",
    }
}

// --- literals ------------------------------------------------------------------

/// `str.fromFloat` already writes a point or an exponent, so what comes back
/// reads as a float. Infinity and NaN have no literal, so they print as the
/// division that makes them.
fn floatText<C: Allocator>(ctx: C, x: Float): Str {
    if (math.isNan(x)) {
        "(0.0 / 0.0)"
    } else if (math.isFinite(x)) {
        str.fromFloat(ctx, x)
    } else if (x > 0.0) {
        "(1.0 / 0.0)"
    } else {
        "(-1.0 / 0.0)"
    }
}

/// A quoted string literal, escaped the way the formatter escapes one.
///
/// `${` is escaped on top of what `escapeChar` names: the pair reads back as
/// the start of a hole, which would make this a template rather than the
/// string it came from.
fn quote<C: Allocator>(ctx: C, text: Str): Str {
    let inner = escapeText(ctx, text, false).replace(ctx, "\${", "\\\${");
    str.format(ctx, "\"${inner}\"")
}

/// `text` as a literal's body: each character as `escapeChar` spells it, but
/// as itself where an emoji sequence holds it, and each `$` escaped too when
/// `dollar` says so.
fn escapeText<C: Allocator>(ctx: C, text: Str, dollar: Bool): Str {
    let cs = text.chars(ctx);
    cs
        .mapIndexedCtx(ctx, fn(c, i, ch) => {
            if (dollar && ch == '$') {
                "\\$"
            } else if (inEmojiSequence(cs, i)) {
                str.fromChars(c, [ch])
            } else {
                escapeChar(c, ch)
            }
        })
        .join(ctx, "")
}

/// The escape a character takes inside a literal, or the character itself.
///
/// A literal writes every character `Char.isPrintable` says no to as an escape
/// and every other scalar as itself, the rule `buri format` follows. `\n`,
/// `\r`, `\t` and `\0` have names of their own; the rest go as `\u{...}`, so a
/// byte-order mark or a bidirectional override is spelled where it can be seen.
fn escapeChar<C: Allocator>(ctx: C, ch: Char): Str {
    if (ch == '"') {
        "\\\""
    } else if (ch == '\\') {
        "\\\\"
    } else if (ch == '\n') {
        "\\n"
    } else if (ch == '\r') {
        "\\r"
    } else if (ch == '\t') {
        "\\t"
    } else if (ch == '\0') {
        "\\0"
    } else if (isUnprintable(ch)) {
        let digits = number.toHex(ctx, ch.toU32().toI64(), 1);
        str.format(ctx, "\\u{${digits}}")
    } else {
        str.fromChars(ctx, [ch])
    }
}

/// The characters no literal holds as themselves: everything in General
/// Categories `C` and `Z` but the space.
fn isUnprintable(ch: Char): Bool {
    !ch.isPrintable()
}

/// Whether the character at `index` is an unprintable one that an emoji
/// sequence (UTS #51) holds, and so stays itself: a zero-width joiner between
/// two emoji, or a tag character inside a flag's tag sequence. A joiner or a
/// tag anywhere else is an escape like any other invisible character.
///
/// The variation selectors, the keycap mark and the skin tones are printable
/// already. `buri format` keeps the same rule, read off the same
/// `PICTOGRAPHIC` table, in `crates/syntax/src/formatting.rs`.
fn inEmojiSequence(cs: [Char], index: Int): Bool {
    let ch = charAtOr(cs, index);
    if (ch == '\u{200d}') {
        joinsEmoji(cs, index)
    } else if (isTagSpec(ch) || ch == '\u{e007f}') {
        inFlagTag(cs, index)
    } else {
        false
    }
}

/// A joiner joins emoji when an Extended_Pictographic character follows it and
/// one comes before it, maybe carrying a `U+FE0F` or a skin tone: a family, a
/// rainbow flag, an astronaut with a skin tone.
fn joinsEmoji(cs: [Char], index: Int): Bool {
    let before = charAtOr(cs, index - 1);
    let code = before.toU32().toI64();
    let base = if (code == 0xfe0f || code >= 0x1f3fb && code <= 0x1f3ff) {
        index - 2
    } else {
        index - 1
    };
    base >= 0
        && isPictographic(charAtOr(cs, base))
        && isPictographic(charAtOr(cs, index + 1))
}

/// A flag's tag sequence: `U+1F3F4`, one or more of `U+E0020` to `U+E007E`,
/// and the cancel tag `U+E007F`, which is how England's flag is spelled.
fn inFlagTag(cs: [Char], index: Int): Bool {
    let end = if (charAtOr(cs, index) == '\u{e007f}') {
        index
    } else {
        tagSpecEnd(cs, index)
    };
    let start = tagSpecStart(cs, end);
    start < end
        && start >= 1
        && charAtOr(cs, start - 1) == '🏴'
        && charAtOr(cs, end) == '\u{e007f}'
}

/// The first index from `index` on that is not a tag spec character.
fn tagSpecEnd(cs: [Char], index: Int): Int {
    if (index < cs.length() && isTagSpec(charAtOr(cs, index))) {
        tagSpecEnd(cs, index + 1)
    } else {
        index
    }
}

/// Where the run of tag spec characters that ends just before `index` starts.
fn tagSpecStart(cs: [Char], index: Int): Int {
    if (index >= 1 && isTagSpec(charAtOr(cs, index - 1))) {
        tagSpecStart(cs, index - 1)
    } else {
        index
    }
}

/// `U+E0020` to `U+E007E`, the tag characters that spell a flag's region.
fn isTagSpec(ch: Char): Bool {
    let code = ch.toU32().toI64();
    code >= 0xe0020 && code <= 0xe007e
}

fn isPictographic(ch: Char): Bool {
    inRanges(PICTOGRAPHIC, ch.toU32().toI64(), 0, PICTOGRAPHIC.length() / 8)
}

/// Whether `cp` is inside one of `table`'s ranges, eight base-36 digits each.
/// `core/character` carries the same three helpers for its own tables.
fn inRanges(table: Str, cp: Int, lo: Int, hi: Int): Bool {
    if (lo >= hi) {
        false
    } else {
        let mid = lo + (hi - lo) / 2;
        if (cp < codeAt(table, mid * 8)) {
            inRanges(table, cp, lo, mid)
        } else if (cp <= codeAt(table, mid * 8 + 4)) {
            true
        } else {
            inRanges(table, cp, mid + 1, hi)
        }
    }
}

/// The four base-36 digits at `at`, as a number.
fn codeAt(table: Str, at: Int): Int {
    digitAt(table, at) * 46656
        + digitAt(table, at + 1) * 1296
        + digitAt(table, at + 2) * 36
        + digitAt(table, at + 3)
}

fn digitAt(table: Str, at: Int): Int {
    match (table.charAt(at)) {
        .Some(c) => c.toDigit(36).withDefault(0),
        .None => 0,
    }
}

// --- Generated Unicode tables (Unicode 16.0) ---------------------------
//
// Written by `crates/stdlib/src/compiler/standard_library/unicode_tables.py`, which
// says what the fields are. Regenerate rather than edit.

/// Extended_Pictographic, less what is unassigned: what an emoji ZWJ sequence joins.
let PICTOGRAPHIC: Str =
    "";

// --- End of the generated Unicode tables -------------------

/// The text of a template, where `$` is an escape as well.
fn escapeTemplate<C: Allocator>(ctx: C, text: Str): Str {
    escapeText(ctx, text, true)
}

fn quoteChar<C: Allocator>(ctx: C, ch: Char): Str {
    if (ch == '\'') {
        "'\\''"
    } else if (ch == '\\') {
        "'\\\\'"
    } else if (ch == '\n') {
        "'\\n'"
    } else if (ch == '\r') {
        "'\\r'"
    } else if (ch == '\t') {
        "'\\t'"
    } else if (ch == '\0') {
        "'\\0'"
    } else if (isUnprintable(ch)) {
        let digits = number.toHex(ctx, ch.toU32().toI64(), 1);
        str.format(ctx, "'\\u{${digits}}'")
    } else {
        str.format(ctx, "'${str.fromChars(ctx, [ch])}'")
    }
}

// -----------------------------------------------------------------------------
// Reading source back in
// -----------------------------------------------------------------------------

derive Equal, Show for TokenKind;
/// What one token is. A `Keyword` and a `Punctuation` are told apart from each
/// other by their [`Token.text`], which is short and exact — there are
/// twenty-five of the first and thirty-two of the second, and a variant apiece
/// would be a second copy of the lexical grammar to keep in step.
///
/// `Unknown` is a word the grammar reserves and no production names — `await`,
/// `while` — or a character that is not punctuation at all.
export enum TokenKind {
    Identifier,
    Keyword,
    Int,
    Float,
    Str,
    Char,
    TemplateHead,
    TemplateSpan,
    TemplateTail,
    Punctuation,
    LineComment,
    DocComment,
    ModuleDoc,
    BlockComment,
    Unknown,
}

derive Equal, Show for Token;
/// One token: what it is, the source under it, and where that source was.
///
/// `text` is the *raw* slice — a string literal keeps its quotes and its
/// backslashes, and a template head reads `"a${`. Nothing is unescaped, so
/// `source.slice` over the span and `text` are the same characters.
export struct Token {
    export kind: TokenKind,
    export text: Str,
    export span: Span,
}

/// The lexer's whole state. There is only ever one of these alive: a scanner
/// reads ahead with a [`Cursor`] and hands the record and the cursor it stopped
/// at to [`pushToken`] together, so nothing else holds `tokens` and each push
/// writes into the list rather than copying it.
///
/// `errors` is what the compiler's lexer refuses, and `open` is where each
/// string with no closing quote starts.
struct Lex {
    source: Str,
    chars: [Char],
    index: Int,
    at: Int,
    tokens: [Token],
    modes: [Int],
    errors: [ParseError],
    open: [Int],
}

/// A position a scanner has read up to: the scalar index into `chars`, and the
/// byte offset beside it. It carries no tokens, so reading ahead with one leaves
/// the [`Lex`] it started from the only holder of its list.
struct Cursor {
    chars: [Char],
    index: Int,
    at: Int,
}

/// A `{` is on the mode stack, so the `}` that matches it is punctuation.
let BRACE: Int = 0;

/// A `${` is on the mode stack, so the `}` that matches it resumes the template.
let HOLE: Int = 1;

/// Every token of `source`, in order, comments included.
///
/// ```buri run
/// from "core/buri/ast" import * as ast;
/// from "core/io" import * as io;
/// from "core/list" import * as list;
/// from "node" import { NodeHost };
/// from "platform/effect" import { Allocator, Stdout };
///
/// export fn main(host: NodeHost): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     let tokens = ast.tokenize(ctx, "let x = 1;");
///     let _ = io.println(ctx, tokens.map(ctx, fn(t) => t.text).join(ctx, " ")).ignore();
///     .Ok(())
/// }
/// ```
///
/// ```stdout
/// let x = 1 ;
/// ```
///
/// **This classifies; it does not validate.** Nothing is refused: an
/// unterminated string is a `Str` token running to the end of its line, a
/// `0b12` is an `Int`, and a stray backtick is `Unknown`. What a mistake means
/// is [`parse`]'s answer, and this is the one place a tool that only wants to
/// see the text — a highlighter, a token count, a rename — needs no answer at
/// all.
///
/// Whitespace is dropped and every comment is kept, so the tokens' spans cover
/// the source apart from the gaps between them.
export fn tokenize<C: Allocator>(ctx: C, source: Str): [Token] {
    lex(ctx, source).tokens
}

fn lex<C: Allocator>(ctx: C, source: Str): Lex {
    let start = Lex {
        source: source,
        chars: source.chars(ctx),
        index: 0,
        at: 0,
        tokens: [],
        modes: [],
        errors: [],
        open: [],
    };
    lexRun(ctx, start)
}

fn lexRun<C: Allocator>(ctx: C, lx: Lex): Lex {
    if (lx.index >= lx.chars.length()) { lx } else { lexRun(ctx, lexStep(ctx, lx)) }
}

fn lexStep<C: Allocator>(ctx: C, lx: Lex): Lex {
    let c = charOf(lx.chars, lx.index);
    if (isWhitespace(c)) {
        let end = scanWhitespace(cursor(lx));
        Lex { ..lx, index: end.index, at: end.at }
    } else if (c == '/') {
        scanSlash(ctx, lx)
    } else if (c == '"') {
        scanText(ctx, lx)
    } else if (c == '\'') {
        scanChar(ctx, lx)
    } else if (isDigit(c)) {
        scanNumber(ctx, lx)
    } else if (isWordStart(c)) {
        scanWord(ctx, lx)
    } else if (c == '{') {
        oneChar(
            ctx,
            Lex { ..lx, modes: lx.modes.push(ctx, BRACE) },
            TokenKind.Punctuation,
        )
    } else if (c == '}') {
        scanCloser(ctx, lx)
    } else {
        scanPunctuation(ctx, lx)
    }
}

// --- the cursor ---------------------------------------------------------------

fn charOf(cs: [Char], i: Int): Char {
    match (cs.get(i)) {
        .Some(c) => c,
        .None => '\0',
    }
}

/// How many UTF-8 bytes a scalar takes. A span is a byte range and `Str` is
/// indexed in scalars, so the two are carried side by side.
fn utf8Width(c: Char): Int {
    let u = c.toU32().toI64();
    if (u < 128) { 1 } else if (u < 2048) { 2 } else if (u < 65536) { 3 } else { 4 }
}

/// Where `lx` is, to read ahead from.
fn cursor(lx: Lex): Cursor {
    Cursor { chars: lx.chars, index: lx.index, at: lx.at }
}

fn nextChar(cur: Cursor): Cursor {
    Cursor {
        ..cur,
        index: cur.index + 1,
        at: cur.at + utf8Width(charOf(cur.chars, cur.index)),
    }
}

fn skipChars(cur: Cursor, count: Int): Cursor {
    if (count <= 0) { cur } else { skipChars(nextChar(cur), count - 1) }
}

fn atEnd(cur: Cursor): Bool {
    cur.index >= cur.chars.length()
}

/// The token from where `lx` is to `end`, pushed, with `lx` moved to `end`.
///
/// A scanner binds `end` before it calls this, so `lx` is not read again after
/// it is passed here.
fn pushToken<C: Allocator>(ctx: C, lx: Lex, kind: TokenKind, end: Cursor): Lex {
    Lex {
        ..lx,
        index: end.index,
        at: end.at,
        tokens: lx
            .tokens
            .push(ctx, Token {
                kind: kind,
                text: lx.source.slice(lx.index, end.index),
                span: Span { start: lx.at, end: end.at },
            }),
    }
}

/// One character, as its own token.
fn oneChar<C: Allocator>(ctx: C, lx: Lex, kind: TokenKind): Lex {
    let end = nextChar(cursor(lx));
    pushToken(ctx, lx, kind, end)
}

/// `lx` with `message` refused from byte `start` to byte `end`.
fn refuse<C: Allocator>(ctx: C, lx: Lex, message: Str, start: Int, end: Int): Lex {
    Lex {
        ..lx,
        errors: lx
            .errors
            .push(ctx, ParseError {
                message: message,
                span: Span { start: start, end: end },
            }),
    }
}

/// Whether `cur` is at a line break or the end of the source, where no
/// literal reads on.
fn atLineEnd(cur: Cursor): Bool {
    atEnd(cur) || charOf(cur.chars, cur.index) == '\n'
}

// --- classes ------------------------------------------------------------------

fn isWhitespace(c: Char): Bool {
    c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

fn isDigit(c: Char): Bool {
    c >= '0' && c <= '9'
}

fn isLetter(c: Char): Bool {
    c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z'
}

fn isWordStart(c: Char): Bool {
    isLetter(c) || c == '_'
}

fn isWordPart(c: Char): Bool {
    isLetter(c) || isDigit(c) || c == '_'
}

// --- whitespace and comments ----------------------------------------------------

fn scanWhitespace(cur: Cursor): Cursor {
    if (atEnd(cur) == false && isWhitespace(charOf(cur.chars, cur.index))) {
        scanWhitespace(nextChar(cur))
    } else {
        cur
    }
}

fn scanSlash<C: Allocator>(ctx: C, lx: Lex): Lex {
    let next = charOf(lx.chars, lx.index + 1);
    if (next == '/') {
        scanLineComment(ctx, lx)
    } else if (next == '*') {
        scanBlockComment(ctx, lx)
    } else {
        scanPunctuation(ctx, lx)
    }
}

/// `//!` documents the module, `///` the declaration below it, and `////` is an
/// ordinary comment — the longer run of slashes wins.
fn scanLineComment<C: Allocator>(ctx: C, lx: Lex): Lex {
    let third = charOf(lx.chars, lx.index + 2);
    let fourth = charOf(lx.chars, lx.index + 3);
    let kind = if (third == '!') {
        TokenKind.ModuleDoc
    } else if (third == '/' && fourth != '/') {
        TokenKind.DocComment
    } else {
        TokenKind.LineComment
    };
    let end = scanToEndOfLine(cursor(lx));
    pushToken(ctx, lx, kind, end)
}

fn scanToEndOfLine(cur: Cursor): Cursor {
    if (atEnd(cur) == false && charOf(cur.chars, cur.index) != '\n') {
        scanToEndOfLine(nextChar(cur))
    } else {
        cur
    }
}

fn scanBlockComment<C: Allocator>(ctx: C, lx: Lex): Lex {
    let start = lx.at;
    let (end, closed) = scanNesting(skipChars(cursor(lx), 2), 1);
    let pushed = pushToken(ctx, lx, TokenKind.BlockComment, end);
    if (closed) {
        pushed
    } else {
        refuse(ctx, pushed, "unterminated block comment", start, end.at)
    }
}

/// Block comments nest, so the scan carries a depth rather than stopping at the
/// first `*/`. Says whether the comment closed.
fn scanNesting(cur: Cursor, depth: Int): (Cursor, Bool) {
    if (depth <= 0) {
        (cur, true)
    } else if (atEnd(cur)) {
        (cur, false)
    } else {
        let c = charOf(cur.chars, cur.index);
        let next = charOf(cur.chars, cur.index + 1);
        if (c == '/' && next == '*') {
            scanNesting(skipChars(cur, 2), depth + 1)
        } else if (c == '*' && next == '/') {
            scanNesting(skipChars(cur, 2), depth - 1)
        } else {
            scanNesting(nextChar(cur), depth)
        }
    }
}

// --- words ---------------------------------------------------------------------

fn scanWord<C: Allocator>(ctx: C, lx: Lex): Lex {
    let end = scanWordEnd(nextChar(cursor(lx)));
    let spelling = lx.source.slice(lx.index, end.index);
    if (spelling == "_") {
        pushToken(ctx, lx, TokenKind.Punctuation, end)
    } else if (isKeyword(spelling)) {
        pushToken(ctx, lx, TokenKind.Keyword, end)
    } else if (isReserved(spelling)) {
        let start = lx.at;
        refuse(
            ctx,
            pushToken(ctx, lx, TokenKind.Unknown, end),
            str.format(
                ctx,
                "`${spelling}` is a reserved word and may not be used as an identifier",
            ),
            start,
            end.at,
        )
    } else {
        pushToken(ctx, lx, TokenKind.Identifier, end)
    }
}

fn scanWordEnd(cur: Cursor): Cursor {
    if (atEnd(cur) == false && isWordPart(charOf(cur.chars, cur.index))) {
        scanWordEnd(nextChar(cur))
    } else {
        cur
    }
}

/// The twenty-five keywords of the lexical grammar.
fn isKeyword(spelling: Str): Bool {
    spelling == "as"
        || spelling == "const"
        || spelling == "context"
        || spelling == "ctx"
        || spelling == "derive"
        || spelling == "effect"
        || spelling == "else"
        || spelling == "enum"
        || spelling == "export"
        || spelling == "false"
        || spelling == "fn"
        || spelling == "for"
        || spelling == "from"
        || spelling == "if"
        || spelling == "impl"
        || spelling == "import"
        || spelling == "let"
        || spelling == "match"
        || spelling == "self"
        || spelling == "Self"
        || spelling == "struct"
        || spelling == "test"
        || spelling == "trait"
        || spelling == "true"
        || spelling == "type"
}

/// Reserved in v0.3 and claimed by no production, so a source that uses one is
/// answered here rather than somewhere further on.
fn isReserved(spelling: Str): Bool {
    spelling == "async"
        || spelling == "await"
        || spelling == "break"
        || spelling == "continue"
        || spelling == "do"
        || spelling == "in"
        || spelling == "is"
        || spelling == "loop"
        || spelling == "module"
        || spelling == "mut"
        || spelling == "opaque"
        || spelling == "panic"
        || spelling == "pub"
        || spelling == "return"
        || spelling == "unreachable"
        || spelling == "use"
        || spelling == "when"
        || spelling == "where"
        || spelling == "while"
        || spelling == "with"
        || spelling == "yield"
}

// --- numbers -------------------------------------------------------------------

fn scanNumber<C: Allocator>(ctx: C, lx: Lex): Lex {
    let radix = radixOf(charOf(lx.chars, lx.index + 1));
    if (charOf(lx.chars, lx.index) == '0' && radix > 0) {
        let start = lx.at;
        let end = scanRadixDigits(skipChars(cursor(lx), 2));
        let raw = lx.source.slice(lx.index, end.index);
        let digits = raw.slice(2, raw.length()).replace(ctx, "_", "");
        let pushed = pushToken(ctx, lx, TokenKind.Int, end);
        if (digits.isEmpty()) {
            refuse(
                ctx,
                pushed,
                str.format(ctx, "`${raw}` has no digits"),
                start,
                end.at,
            )
        } else if (radixFits(digits.chars(ctx), 0, radix, 0)) {
            pushed
        } else {
            let base = radix.show(ctx);
            let message = str.format(
                ctx,
                "`${raw}` is not a valid base-${base} integer, or does not fit in 128 bits",
            );
            refuse(ctx, pushed, message, start, end.at)
        }
    } else {
        scanDecimal(ctx, lx)
    }
}

/// The base a prefix's letter names, in either case, or 0 for none.
fn radixOf(c: Char): Int {
    if (c == 'x' || c == 'X') {
        16
    } else if (c == 'o' || c == 'O') {
        8
    } else if (c == 'b' || c == 'B') {
        2
    } else {
        0
    }
}

/// A prefixed literal runs on through every letter, as the compiler reads it,
/// so `0xfg` is one literal with a digit its base lacks rather than two tokens.
fn scanRadixDigits(cur: Cursor): Cursor {
    let c = charOf(cur.chars, cur.index);
    if (atEnd(cur) == false && isWordPart(c)) {
        scanRadixDigits(nextChar(cur))
    } else {
        cur
    }
}

/// Whether `cs[index..]` are all digits of `radix`, a power of two, and the
/// whole literal fits in 128 bits. `bits` is how many the digits before
/// `index` take, which leading zeros leave at 0.
fn radixFits(cs: [Char], index: Int, radix: Int, bits: Int): Bool {
    match (cs.get(index)) {
        .None => bits <= 128,
        .Some(c) => {
            match (c.toDigit(radix)) {
                .Some(d) => {
                    let width = if (bits == 0) {
                        bitLength(d)
                    } else {
                        bits + bitLength(radix - 1)
                    };
                    radixFits(cs, index + 1, radix, width)
                },
                .None => false,
            }
        },
    }
}

fn bitLength(n: Int): Int {
    if (n == 0) { 0 } else { 1 + bitLength(n / 2) }
}

/// The widest integer a literal may spell, 2^128 - 1.
let U128_MAX: Str = "340282366920938463463374607431768211455";

/// Whether decimal `digits` fit in 128 bits.
fn decimalFits(digits: Str): Bool {
    let significant = digits.slice(leadingZeros(digits, 0), digits.length());
    significant.length() < U128_MAX.length()
        || significant.length() == U128_MAX.length() && significant <= U128_MAX
}

fn leadingZeros(digits: Str, index: Int): Int {
    if (digits.slice(index, index + 1) == "0") {
        leadingZeros(digits, index + 1)
    } else {
        index
    }
}

fn scanDecimalDigits(cur: Cursor): Cursor {
    let c = charOf(cur.chars, cur.index);
    if (atEnd(cur) == false && (isDigit(c) || c == '_')) {
        scanDecimalDigits(nextChar(cur))
    } else {
        cur
    }
}

/// A float must begin with a digit and carry a digit after the point, which is
/// what makes `pair.0` a tuple index rather than a float.
fn scanDecimal<C: Allocator>(ctx: C, lx: Lex): Lex {
    let whole = scanDecimalDigits(cursor(lx));
    let afterPoint = if (
        charOf(whole.chars, whole.index) == '.'
            && isDigit(charOf(whole.chars, whole.index + 1))
    ) {
        scanDecimalDigits(nextChar(whole))
    } else {
        whole
    };
    let float = afterPoint.index > whole.index;
    let e = charOf(afterPoint.chars, afterPoint.index);
    let sign = charOf(afterPoint.chars, afterPoint.index + 1);
    let digitAfterSign = isDigit(charOf(afterPoint.chars, afterPoint.index + 2));
    let hasExponent = (e == 'e' || e == 'E')
        && (isDigit(sign) || (sign == '+' || sign == '-') && digitAfterSign);
    let end = if (hasExponent) {
        scanDecimalDigits(skipChars(afterPoint, if (isDigit(sign)) { 1 } else { 2 }))
    } else {
        afterPoint
    };
    if (float || hasExponent) {
        pushToken(ctx, lx, TokenKind.Float, end)
    } else {
        let start = lx.at;
        let raw = lx.source.slice(lx.index, end.index);
        let pushed = pushToken(ctx, lx, TokenKind.Int, end);
        if (decimalFits(raw.replace(ctx, "_", ""))) {
            pushed
        } else {
            refuse(
                ctx,
                pushed,
                str.format(ctx, "`${raw}` does not fit in 128 bits"),
                start,
                end.at,
            )
        }
    }
}

// --- text ----------------------------------------------------------------------

/// A `"` opens a string, or a template when a `${` is reached before the closing
/// quote. The mode stack is what tells the `}` that closes a block inside a hole
/// from the `}` that resumes template text.
fn scanText<C: Allocator>(ctx: C, lx: Lex): Lex {
    let (end, stop) = scanStrBody(nextChar(cursor(lx)));
    match (stop) {
        .Hole => {
            pushToken(
                ctx,
                Lex { ..lx, modes: lx.modes.push(ctx, HOLE) },
                TokenKind.TemplateHead,
                end,
            )
        },
        .Quote => pushToken(ctx, lx, TokenKind.Str, end),
        .Open => openText(ctx, lx, TokenKind.Str, end),
    }
}

/// The `}` that resumes a template, or an ordinary closing brace.
fn scanCloser<C: Allocator>(ctx: C, lx: Lex): Lex {
    match (lx.modes.last()) {
        .Some(mode) => {
            if (mode == HOLE) {
                let (end, stop) = scanStrBody(nextChar(cursor(lx)));
                match (stop) {
                    .Hole => pushToken(ctx, lx, TokenKind.TemplateSpan, end),
                    .Quote => {
                        pushToken(ctx, popMode(ctx, lx), TokenKind.TemplateTail, end)
                    },
                    .Open => {
                        openText(ctx, popMode(ctx, lx), TokenKind.TemplateTail, end)
                    },
                }
            } else {
                let end = nextChar(cursor(lx));
                pushToken(ctx, popMode(ctx, lx), TokenKind.Punctuation, end)
            }
        },
        .None => oneChar(ctx, lx, TokenKind.Punctuation),
    }
}

/// `lx` with the innermost mode taken off the stack.
fn popMode<C: Allocator>(ctx: C, lx: Lex): Lex {
    Lex { ..lx, modes: lx.modes.take(ctx, lx.modes.length() - 1) }
}

/// `lx` with text that runs to the end of its line pushed and refused, the way
/// the compiler refuses it: at the line break, or where the file ends.
fn openText<C: Allocator>(ctx: C, lx: Lex, kind: TokenKind, end: Cursor): Lex {
    let pushed = pushToken(
        ctx,
        Lex { ..lx, open: lx.open.push(ctx, lx.at) },
        kind,
        end,
    );
    let width = if (atEnd(end)) { 0 } else { 1 };
    refuse(ctx, pushed, "unterminated string literal", end.at, end.at + width)
}

/// Where a run of string text stops.
enum TextStop {
    Quote,
    Hole,
    Open,
}

/// Scans to the `"` that ends a string, the `${` that opens a hole, or the end
/// of the line, and says which it found. The opener is already consumed.
fn scanStrBody(cur: Cursor): (Cursor, TextStop) {
    if (atLineEnd(cur)) {
        (cur, .Open)
    } else {
        let c = charOf(cur.chars, cur.index);
        if (c == '"') {
            (nextChar(cur), .Quote)
        } else if (c == '\\') {
            // A backslash at the end of its line escapes nothing.
            let past = nextChar(cur);
            scanStrBody(if (atLineEnd(past)) { past } else { nextChar(past) })
        } else if (c == '$' && charOf(cur.chars, cur.index + 1) == '{') {
            (skipChars(cur, 2), .Hole)
        } else {
            scanStrBody(nextChar(cur))
        }
    }
}

/// A character literal, refused the way the compiler refuses one: open when its
/// line ends before a character, too long when the first character is not
/// followed by `'`. A long one runs on to a `'` or the end of its line.
fn scanChar<C: Allocator>(ctx: C, lx: Lex): Lex {
    let start = lx.at;
    let quote = nextChar(cursor(lx));
    let escaped = charOf(quote.chars, quote.index) == '\\';
    let body = if (escaped) { nextChar(quote) } else { quote };
    if (atLineEnd(body)) {
        let pushed = pushToken(ctx, lx, TokenKind.Char, body);
        refuse(ctx, pushed, "unterminated character literal", start, body.at)
    } else {
        let one = if (escaped) { scanEscape(body) } else { nextChar(body) };
        if (charOf(one.chars, one.index) == '\'') {
            pushToken(ctx, lx, TokenKind.Char, nextChar(one))
        } else {
            let stop = skipToQuote(one);
            let end = if (charOf(stop.chars, stop.index) == '\'') {
                nextChar(stop)
            } else {
                stop
            };
            refuse(
                ctx,
                pushToken(ctx, lx, TokenKind.Char, end),
                "a character literal holds exactly one Unicode scalar value",
                start,
                one.at,
            )
        }
    }
}

/// The `'` or line end a too-long character literal stops at.
fn skipToQuote(cur: Cursor): Cursor {
    if (atLineEnd(cur) || charOf(cur.chars, cur.index) == '\'') {
        cur
    } else {
        skipToQuote(nextChar(cur))
    }
}

/// The escape's own characters, as the compiler reads them: one for `\n`, and
/// for `\u{...}` the brace, its hex digits, and a `}` only if one follows them.
fn scanEscape(cur: Cursor): Cursor {
    if (
        charOf(cur.chars, cur.index) == 'u' && charOf(cur.chars, cur.index + 1) == '{'
    ) {
        let (stop, _value) = hexRun(cur.chars, cur.index + 2, 0);
        let digits = skipChars(cur, stop - cur.index);
        if (charOf(digits.chars, digits.index) == '}') {
            nextChar(digits)
        } else {
            digits
        }
    } else {
        nextChar(cur)
    }
}

// --- punctuation ----------------------------------------------------------------

/// Longest match. There is no `<<`, no `>>` and no `?.`, which is what keeps
/// `Map<Str, [Int]>` and `x?.field` lexing the way they read.
fn scanPunctuation<C: Allocator>(ctx: C, lx: Lex): Lex {
    let two = lx.source.slice(lx.index, lx.index + 2);
    let paired = two == "::"
        || two == ".."
        || two == "=>"
        || two == "=="
        || two == "!="
        || two == "<="
        || two == ">="
        || two == "&&"
        || two == "||";
    if (paired) {
        let end = skipChars(cursor(lx), 2);
        pushToken(ctx, lx, TokenKind.Punctuation, end)
    } else if (isPunctuation(charOf(lx.chars, lx.index))) {
        oneChar(ctx, lx, TokenKind.Punctuation)
    } else {
        let c = charOf(lx.chars, lx.index);
        let code = number.toHex(ctx, c.toU32().toI64(), 4).toUpper(ctx);
        let start = lx.at;
        let pushed = oneChar(ctx, lx, TokenKind.Unknown);
        refuse(
            ctx,
            pushed,
            str.format(
                ctx,
                "unexpected character `${lx
                    .source
                    .slice(lx.index, lx.index + 1)}` (U+${code})",
            ),
            start,
            pushed.at,
        )
    }
}

/// `{`, `}` and `_` never reach here: `lexStep` takes them first.
fn isPunctuation(c: Char): Bool {
    c == '('
        || c == ')'
        || c == '['
        || c == ']'
        || c == ','
        || c == ';'
        || c == ':'
        || c == '.'
        || c == '@'
        || c == '='
        || c == '<'
        || c == '>'
        || c == '+'
        || c == '-'
        || c == '*'
        || c == '/'
        || c == '%'
        || c == '&'
        || c == '|'
        || c == '^'
        || c == '~'
        || c == '!'
        || c == '?'
}

// -----------------------------------------------------------------------------
// Reading a module back in
// -----------------------------------------------------------------------------

derive Equal, Show for ParseError;
/// Why a source did not parse, and where.
///
/// `message` is the compiler's own wording for the mistake —
/// `expected an identifier, found `=`` — and `span` is the byte range it
/// reports, so an editor can underline it. There is no `file`: it is
/// the one [`parse`] was handed.
export struct ParseError {
    export message: Str,
    export span: Span,
}

/// The parser's whole state: where it is, what it has said, and whether it is
/// unwinding to the next place it can pick the walk back up.
///
/// It is the compiler's parser read as a value. `panicking` is the compiler's
/// bail: while it is set every step is a no-op, until a recovery point clears
/// it and skips to where reading can resume. `reported` is every span already
/// spoken for, the lexer's included, so one mistake is said once. `open` is
/// which tokens are strings with no closing quote. `trial` counts speculative
/// readings, which say nothing. `early` is a token written one place too soon
/// and held for the production that wants it, or `-1`. `armBody` is how many
/// match-arm bodies the cursor is inside, `closed` how the last closer was
/// found — `0` where it was, `1` further on, `2` nowhere — and `depth` how
/// deep the reading nests.
struct P {
    file: Str,
    source: Str,
    tokens: [Token],
    docs: [[Str]],
    index: Int,
    errors: [ParseError],
    panicking: Bool,
    reported: [Span],
    open: [Int],
    trial: Int,
    early: Int,
    armBody: Int,
    closed: Int,
    depth: Int,
}

/// The token stream with its trivia sorted: the significant tokens, the doc
/// lines standing above each one, the module's own `//!` lines, what the lexer
/// refused, and which tokens are open strings.
struct Prep {
    tokens: [Token],
    docs: [[Str]],
    moduleDocs: [Str],
    pending: [Str],
    errors: [ParseError],
    open: [Int],
}

// -----------------------------------------------------------------------------
// The door
// -----------------------------------------------------------------------------

/// Reads `source` as a module, or answers everything it could not read.
///
/// `file` is the name every [`Origin`] carries, so a node parsed here and a
/// node a generator built are the same shape and [`print`] anchors both.
///
/// ```buri run
/// from "core/buri/ast" import * as ast;
/// from "core/io" import * as io;
/// from "node" import { NodeHost };
/// from "platform/effect" import { Allocator, Stdout };
///
/// export fn main(host: NodeHost): Result<(), Str> {
///     let ctx = context {
///         Allocator: host.alloc,
///         Stdout: host.stdout,
///     };
///     match (ast.parse(ctx, "rows.buri", "export type Id = Int;\n")) {
///         .Ok(tree) => {
///             let _ = io.print(ctx, ast.print(ctx, tree).text).ignore();
///             .Ok(())
///         },
///         .Err(errors) => .Err(errors.length().show(ctx)),
///     }
/// }
/// ```
///
/// ```stdout
/// export type Id = Int;
/// ```
///
/// **The errors are the compiler's.** Each syntax error comes back with the
/// message and span `buri build` reports for it, and the walk recovers where
/// the compiler's does: a missing `,`, `;` or closing bracket is reported and
/// read past, a statement that fails costs that statement, and a declaration
/// that fails costs that declaration. So a file with three mistakes in three
/// functions answers three errors.
///
/// **The text that comes back is not the text that went in.** `print` has no
/// page width, it drops `//` comments, it sorts the leading import run and it
/// moves a `derive` onto the declaration it is about. What survives is the
/// *program*: `language::round_trip` rewrites the whole conformance repository
/// through this pair and runs it.
///
/// **It reads the grammar and nothing else.** Where a source is well-formed
/// text and ill-formed *program* — `export fn` on a method that satisfies a
/// trait, a function with no body, a `test` outside a test source, a `//!`
/// after the first declaration — this answers a tree and the compiler is what
/// says no. So a `.Ok` here is not a promise that the source compiles.
///
/// Reading costs one `[Char]` of the source, one `[Token]`, and a walk.
export fn parse<C: Allocator>(
    ctx: C,
    file: Str,
    source: Str,
): Result<Module, [ParseError]> {
    let prepared = prepare(ctx, lex(ctx, source));
    let start = P {
        file: file,
        source: source,
        tokens: prepared.tokens,
        docs: prepared.docs,
        index: 0,
        errors: prepared.errors,
        panicking: false,
        reported: prepared.errors.map(ctx, fn(e) => e.span),
        open: prepared.open,
        trial: 0,
        early: -1,
        armBody: 0,
        closed: 0,
        depth: 0,
    };
    let (end, items) = parseItems(ctx, start, []);
    if (end.errors.isEmpty()) {
        .Ok(Module { items: items, docs: prepared.moduleDocs })
    } else {
        .Err(end.errors.sortBy(ctx, fn(a, b) => order.int(a.span.start, b.span.start)))
    }
}

/// A reserved word reads on as a name, and a character no token starts with
/// is gone, as they are to the compiler once its lexer has refused them.
fn prepare<C: Allocator>(ctx: C, lx: Lex): Prep {
    lx
        .tokens
        .foldCtx(
            ctx,
            fn(c, acc, t) => {
                if (t.kind == TokenKind.ModuleDoc) {
                    Prep { ..acc, moduleDocs: acc.moduleDocs.push(c, docBody(t.text)) }
                } else if (t.kind == TokenKind.DocComment) {
                    Prep { ..acc, pending: acc.pending.push(c, docBody(t.text)) }
                } else if (
                    t.kind == TokenKind.LineComment
                        || t.kind == TokenKind.BlockComment
                        || t.kind == TokenKind.Unknown && isReserved(t.text) == false
                ) {
                    acc
                } else {
                    let kind = if (t.kind == TokenKind.Unknown) {
                        TokenKind.Identifier
                    } else {
                        t.kind
                    };
                    let open = if (lx.open.contains(t.span.start)) {
                        acc.open.push(c, acc.tokens.length())
                    } else {
                        acc.open
                    };
                    Prep {
                        ..acc,
                        tokens: acc.tokens.push(c, Token { ..t, kind: kind }),
                        docs: acc.docs.push(c, acc.pending),
                        pending: [],
                        errors: badEscapes(
                            c,
                            t,
                            t.text.chars(c),
                            0,
                            t.span.start,
                            acc.errors,
                        ),
                        open: open,
                    }
                }
            },
            Prep {
                tokens: [],
                docs: [],
                moduleDocs: [],
                pending: [],
                errors: lx.errors,
                open: [],
            },
        )
}

/// A doc line without its marker: one leading space taken off, the trailing
/// whitespace trimmed. What `print` writes back.
fn docBody(text: Str): Str {
    let rest = text.slice(3, text.length());
    let body = if (rest.startsWith(" ")) { rest.slice(1, rest.length()) } else { rest };
    body.trimEnd()
}

// -----------------------------------------------------------------------------
// The cursor
// -----------------------------------------------------------------------------

/// How deep the reading may nest, and how far a lookahead may scan: the
/// compiler's own bounds.
let MAX_DEPTH: Int = 256;

let MAX_LOOKAHEAD: Int = 256;

fn tokenAt(p: P, offset: Int): Token {
    match (p.tokens.get(p.index + offset)) {
        .Some(t) => t,
        .None => endToken(p),
    }
}

/// The zero-width token at the end of the source. Its empty text is what tells
/// it from every real token, none of which is empty.
fn endToken(p: P): Token {
    let at = p.source.length();
    Token { kind: TokenKind.Unknown, text: "", span: Span { start: at, end: at } }
}

fn isEnd(p: P): Bool {
    p.index >= p.tokens.length()
}

/// One token on. The cursor stays on the end of the file once it is there.
fn advance(p: P): P {
    if (isEnd(p)) { p } else { P { ..p, index: p.index + 1 } }
}

fn at(p: P, text: Str): Bool {
    p.panicking == false && tokenAt(p, 0).text == text
}

fn here(p: P): Span {
    tokenAt(p, 0).span
}

/// The token just read, or the first one before anything has been.
fn prevSpan(p: P): Span {
    tokenAt(p, -1).span
}

fn point(at: Int): Span {
    Span { start: at, end: at }
}

/// The end of the token just consumed, which is where a node stops.
fn lastEnd(p: P): Int {
    prevSpan(p).end
}

fn spanFrom(p: P, start: Span): Span {
    Span { start: start.start, end: lastEnd(p) }
}

fn originFrom(p: P, start: Span): Origin {
    Origin { file: p.file, span: spanFrom(p, start) }
}

fn originAt(p: P, span: Span): Origin {
    Origin { file: p.file, span: span }
}

fn docsHere(p: P): [Str] {
    p.docs.getOr(p.index, [])
}

fn nameOf(p: P, t: Token): Name {
    Name { text: t.text, origin: originAt(p, t.span) }
}

// --- what a token can begin ------------------------------------------------------

fn isIdent(t: Token): Bool {
    t.kind == TokenKind.Identifier
}

fn isStr(t: Token): Bool {
    t.kind == TokenKind.Str
}

fn isCtx(t: Token): Bool {
    t.text == "ctx"
}

fn startsExpr(t: Token): Bool {
    [
        TokenKind.Identifier,
        TokenKind.Int,
        TokenKind.Float,
        TokenKind.Str,
        TokenKind.Char,
        TokenKind.TemplateHead,
    ].contains(t.kind)
        || [
            "true",
            "false",
            "self",
            "ctx",
            "if",
            "match",
            "context",
            "fn",
            ".",
            "[",
            "(",
            "{",
            "-",
            "!",
            "~",
        ].contains(t.text)
}

/// [`startsExpr`] less the three tokens that continue the expression before
/// them.
fn startsStatement(t: Token): Bool {
    startsExpr(t) && [".", "(", "["].contains(t.text) == false
}

fn startsPattern(t: Token): Bool {
    [
        TokenKind.Identifier,
        TokenKind.Int,
        TokenKind.Float,
        TokenKind.Str,
        TokenKind.Char,
    ].contains(t.kind)
        || ["_", "-", "true", "false", ".", "[", "("].contains(t.text)
}

fn startsType(t: Token): Bool {
    isIdent(t) || ["fn", "Self", "[", "("].contains(t.text)
}

fn startsName(t: Token): Bool {
    isIdent(t)
}

fn startsField(t: Token): Bool {
    isIdent(t) || t.text == "export"
}

fn startsParam(t: Token): Bool {
    isIdent(t) || ["self", "ctx"].contains(t.text)
}

fn startsTupleField(t: Token): Bool {
    startsType(t) || t.text == "export"
}

/// The keywords no statement starts with, so a block that reaches one has
/// lost its `}`.
fn startsDeclaration(t: Token): Bool {
    [
        "from",
        "export",
        "struct",
        "enum",
        "type",
        "trait",
        "effect",
        "impl",
        "derive",
        "test",
        "const",
    ].contains(t.text)
}

fn startsPostfix(t: Token): Bool {
    [".", "(", "[", "?", "<", "::", "{"].contains(t.text)
}

/// A token written in front of what a production wants rather than part of
/// it: two operators of other constructs, and a misplaced modifier.
fn strayToken(t: Token): Bool {
    ["@", "?", "export"].contains(t.text)
}

fn opener(t: Token): Bool {
    ["{", "(", "["].contains(t.text)
}

fn closer(t: Token): Bool {
    ["}", ")", "]"].contains(t.text)
}

// -----------------------------------------------------------------------------
// Saying no
// -----------------------------------------------------------------------------

fn bail(p: P): P {
    P { ..p, panicking: true }
}

/// A recovery point: the walk reads again from here.
fn resume(p: P): P {
    P { ..p, panicking: false }
}

fn onOpen(p: P): Bool {
    p.open.contains(p.index)
}

/// Whether the token just read was a string with no closing quote, which may
/// be holding whatever comes next.
fn afterOpen(p: P): Bool {
    p.open.contains(p.index - 1)
}

/// How a message names a token.
fn describe<C: Allocator>(ctx: C, t: Token): Str {
    if (t.text == "") {
        "end of file"
    } else if (t.kind == TokenKind.Str) {
        "a string literal"
    } else if (t.kind == TokenKind.Char) {
        "a character literal"
    } else if (
        [
            TokenKind.TemplateHead,
            TokenKind.TemplateSpan,
            TokenKind.TemplateTail,
        ].contains(t.kind)
    ) {
        "an interpolated string"
    } else {
        str.format(ctx, "`${t.text}`")
    }
}

/// One error, said once: nothing while unwinding, nothing in a trial, and
/// nothing at a span already spoken for.
fn report<C: Allocator>(ctx: C, p: P, span: Span, message: Str): P {
    if (p.panicking || p.trial > 0 || p.reported.contains(span)) {
        p
    } else {
        P {
            ..p,
            reported: p.reported.push(ctx, span),
            errors: p.errors.push(ctx, ParseError { message: message, span: span }),
        }
    }
}

/// The compiler's `unexpected-token`. A string with no closing quote under the
/// cursor is the mistake, and the lexer already said so.
fn expectedAs<C: Allocator>(ctx: C, p: P, span: Span, want: Str, found: Str): P {
    if (span == here(p) && onOpen(p)) {
        p
    } else {
        report(ctx, p, span, str.format(ctx, "expected ${want}, found ${found}"))
    }
}

fn expected<C: Allocator>(ctx: C, p: P, want: Str): P {
    expectedAs(ctx, p, here(p), want, describe(ctx, tokenAt(p, 0)))
}

fn expect<C: Allocator>(ctx: C, p: P, text: Str): P {
    if (at(p, text)) {
        advance(p)
    } else {
        bail(expected(ctx, p, str.format(ctx, "`${text}`")))
    }
}

fn eatComma(p: P): P {
    if (at(p, ",")) { advance(p) } else { p }
}

/// Whether the list being read has ended, closer or no closer: a delimiter it
/// did not open, a `;` or the end of the file belongs to something outside it.
fn listEnded(p: P, close: Str): Bool {
    p.panicking || [close, ";", "}", ")", "]", ""].contains(tokenAt(p, 0).text)
}

/// One element read: whether another follows. A missing `,` with the next
/// element already under the cursor is reported where the comma belongs, and
/// the list reads on.
fn moreElements<C: Allocator>(
    ctx: C,
    p: P,
    close: Str,
    construct: Str,
    starts: fn(Token) => Bool,
): (P, Bool) {
    let t = tokenAt(p, 0);
    if (at(p, ",")) {
        (advance(p), true)
    } else if (p.panicking || t.text == close || starts(t) == false) {
        (p, false)
    } else if (afterOpen(p)) {
        (p, true)
    } else {
        (separatorMissing(ctx, p, construct), true)
    }
}

fn separatorMissing<C: Allocator>(ctx: C, p: P, construct: Str): P {
    report(
        ctx,
        p,
        point(prevSpan(p).end),
        str.format(ctx, "${construct} ends with `,`"),
    )
}

/// A construct's closing delimiter, or the error that names what never
/// closed. The walk then reads on as though the closer were there — past it,
/// when it is still ahead at this depth. A trial gives up instead: a
/// speculative reading that repaired itself would always win.
fn expectClose<C: Allocator>(ctx: C, p: P, close: Str, construct: Str): P {
    if (at(p, close)) {
        P { ..advance(p), closed: 0 }
    } else if (p.panicking || p.trial > 0) {
        bail(p)
    } else {
        let told = if (afterOpen(p)) {
            p
        } else {
            report(
                ctx,
                p,
                here(p),
                str.format(ctx, "this ${construct} is missing its closing `${close}`"),
            )
        };
        match (findClose(told, close, 0, 0)) {
            .Some(steps) => P { ..told, index: told.index + steps + 1, closed: 1 },
            .None => P { ..told, closed: 2 },
        }
    }
}

/// How far ahead this construct's closer is, if it is there at all: a
/// delimiter that closes something outside, a `;`, a declaration or the end of
/// the file says it was never written.
fn findClose(p: P, close: Str, steps: Int, depth: Int): Option<Int> {
    let t = tokenAt(p, steps);
    if (steps >= MAX_LOOKAHEAD || t.text == "") {
        .None
    } else if (depth == 0 && t.text == close) {
        .Some(steps)
    } else if (depth == 0 && (startsDeclaration(t) || closer(t) || t.text == ";")) {
        .None
    } else if (opener(t)) {
        findClose(p, close, steps + 1, depth + 1)
    } else if (closer(t)) {
        findClose(p, close, steps + 1, depth - 1)
    } else {
        findClose(p, close, steps + 1, depth)
    }
}

/// Whether what is under the cursor could begin the next declaration, the
/// next statement, or the end of the block.
fn startsSomething(p: P): Bool {
    let t = tokenAt(p, 0);
    ["}", "", "let"].contains(t.text) || startsDeclaration(t) || startsStatement(t)
}

/// The `;` that ends `construct`. Where what follows could not start anything
/// the token is the mistake, not the terminator.
fn expectTerminator<C: Allocator>(ctx: C, p: P, construct: Str): P {
    if (at(p, ";")) {
        advance(p)
    } else if (p.panicking || afterOpen(p)) {
        p
    } else if (startsSomething(p) == false) {
        bail(expected(ctx, p, "`;`"))
    } else {
        report(
            ctx,
            p,
            point(prevSpan(p).end),
            str.format(ctx, "${construct} ends with `;`"),
        )
    }
}

/// The `=>` of a match arm. The body is read anyway where one follows.
fn expectArrow<C: Allocator>(ctx: C, p: P): P {
    if (at(p, "=>")) {
        advance(p)
    } else if (p.panicking || afterOpen(p)) {
        bail(p)
    } else {
        let told = report(
            ctx,
            p,
            point(prevSpan(p).end),
            "a match arm is `pattern => expression`",
        );
        if (startsExpr(tokenAt(p, 0))) { told } else { bail(told) }
    }
}

fn expectName<C: Allocator>(ctx: C, p: P): (P, Name) {
    let t = tokenAt(p, 0);
    if (p.panicking) {
        (p, noName())
    } else if (isIdent(t)) {
        (advance(p), nameOf(p, t))
    } else {
        nameMissing(ctx, p)
    }
}

/// A name held from earlier, or a stray token in front of the name stepped
/// over, or an `export` where the name goes read as the name.
fn nameMissing<C: Allocator>(ctx: C, p: P): (P, Name) {
    match (takeEarly(p, isIdent)) {
        .Some(taken) => (taken.0, nameOf(p, taken.1)),
        .None => {
            let told = expected(ctx, p, "an identifier");
            let t = tokenAt(p, 0);
            let next = tokenAt(p, 1);
            if (strayToken(t) && isIdent(next)) {
                (advance(advance(told)), nameOf(p, next))
            } else if (t.text == "export" && next.kind != TokenKind.Keyword) {
                (advance(told), nameOf(p, t))
            } else {
                (bail(told), noName())
            }
        },
    }
}

fn noName(): Name {
    Name { text: "", origin: nowhere() }
}

/// The token held from earlier, when it is what this production wants. It is
/// used once.
fn takeEarly(p: P, wanted: fn(Token) => Bool): Option<(P, Token)> {
    match (p.tokens.get(p.early)) {
        .Some(t) => if (wanted(t)) { .Some((P { ..p, early: -1 }, t)) } else { .None },
        .None => .None,
    }
}

/// A string literal, as an import's path or a test's name.
fn expectString<C: Allocator>(ctx: C, p: P): (P, Str) {
    let t = tokenAt(p, 0);
    if (onOpen(p)) {
        (bail(p), "")
    } else if (isStr(t)) {
        (advance(p), literalText(ctx, t.text))
    } else {
        match (takeEarly(p, isStr)) {
            .Some(taken) => (taken.0, literalText(ctx, taken.1.text)),
            .None => {
                let told = expected(ctx, p, "a string literal");
                let next = tokenAt(p, 1);
                if (
                    strayToken(t)
                        && isStr(next)
                        && p.open.contains(p.index + 1) == false
                ) {
                    (advance(advance(told)), literalText(ctx, next.text))
                } else {
                    (bail(told), "")
                }
            },
        }
    }
}

/// One level deeper, or `expression-too-deep`. The caller puts `depth` back.
fn enter<C: Allocator>(ctx: C, p: P): P {
    if (p.depth >= MAX_DEPTH) {
        bail(report(ctx, p, here(p), "expression nests too deeply"))
    } else {
        P { ..p, depth: p.depth + 1 }
    }
}

// --- recovery --------------------------------------------------------------------

/// How many delimiters the tokens from `from` to the cursor left open.
fn openSince(p: P, mark: Int, bracesOnly: Bool): Int {
    countOpen(p, mark, 0, bracesOnly)
}

fn countOpen(p: P, i: Int, depth: Int, bracesOnly: Bool): Int {
    if (i >= p.index) {
        depth
    } else {
        let t = tokenAt(p, i - p.index).text;
        let counted = bracesOnly == false || t == "{" || t == "}";
        if (counted && ["{", "(", "["].contains(t)) {
            countOpen(p, i + 1, depth + 1, bracesOnly)
        } else if (counted && ["}", ")", "]"].contains(t)) {
            countOpen(p, i + 1, depth - 1, bracesOnly)
        } else {
            countOpen(p, i + 1, depth, bracesOnly)
        }
    }
}

/// On to the next token that can begin a declaration outside every brace,
/// or past the `;` or `}` that ends this one.
fn syncItem(p: P, depth: Int): P {
    let t = tokenAt(p, 0).text;
    if (isEnd(p)) {
        p
    } else if (t == "{") {
        syncItem(advance(p), depth + 1)
    } else if (t == "}") {
        if (depth <= 1) { advance(p) } else { syncItem(advance(p), depth - 1) }
    } else if (depth <= 0 && t == ";") {
        advance(p)
    } else if (
        depth <= 0
            && [
                "from",
                "export",
                "fn",
                "struct",
                "enum",
                "type",
                "const",
                "trait",
                "effect",
                "impl",
                "derive",
                "test",
            ].contains(t)
    ) {
        p
    } else {
        syncItem(advance(p), depth)
    }
}

/// To the end of the statement: past its `;`, answering `true`, or to the `}`
/// or the end of the file, answering `false`.
fn syncStmt(p: P, depth: Int): (P, Bool) {
    let t = tokenAt(p, 0);
    if (isEnd(p)) {
        (p, false)
    } else if (depth <= 0 && t.text == ";") {
        (advance(p), true)
    } else if (opener(t)) {
        syncStmt(advance(p), depth + 1)
    } else if (depth <= 0 && t.text == "}") {
        (p, false)
    } else if (closer(t)) {
        syncStmt(advance(p), depth - 1)
    } else {
        syncStmt(advance(p), depth)
    }
}

/// To the end of the arm: to the `,` after it, answering `true`, or to the `}`
/// or the end of the file. Neither is consumed.
fn syncMatchArm(p: P, depth: Int): (P, Bool) {
    let t = tokenAt(p, 0);
    if (isEnd(p)) {
        (p, false)
    } else if (depth <= 0 && t.text == ",") {
        (p, true)
    } else if (depth <= 0 && t.text == "}") {
        (p, false)
    } else if (opener(t)) {
        syncMatchArm(advance(p), depth + 1)
    } else if (closer(t)) {
        syncMatchArm(advance(p), depth - 1)
    } else {
        syncMatchArm(advance(p), depth)
    }
}

// -----------------------------------------------------------------------------
// Declarations
// -----------------------------------------------------------------------------

fn parseItems<C: Allocator>(ctx: C, p: P, acc: [Item]): (P, [Item]) {
    if (isEnd(p)) {
        (p, acc)
    } else {
        let mark = p.index;
        let (after, made) = parseItem(ctx, p);
        let next = if (after.panicking == false) {
            after
        } else if (after.index == mark) {
            skipStray(resume(after))
        } else {
            syncItem(resume(after), openSince(after, mark, true))
        };
        parseItems(ctx, P { ..next, early: -1 }, acc.concat(ctx, made))
    }
}

/// Past a token no declaration starts with, and on to the next one.
fn skipStray(p: P): P {
    let t = tokenAt(p, 0).text;
    if (t == "{") {
        syncItem(advance(p), 1)
    } else if (t == "}" || t == ";") {
        advance(p)
    } else {
        syncItem(advance(p), 0)
    }
}

/// One declaration, as a list of nought or one so that a failure adds nothing.
fn parseItem<C: Allocator>(ctx: C, p: P): (P, [Item]) {
    let start = here(p);
    let docs = docsHere(p);
    let (after, kind) = parseItemKind(ctx, exchangedHead(ctx, p), docs);
    if (after.panicking) {
        (after, [])
    } else {
        (after, [Item { kind: kind, origin: originFrom(after, start) }])
    }
}

fn parseItemKind<C: Allocator>(ctx: C, p: P, docs: [Str]): (P, ItemKind) {
    if (at(p, "from")) {
        parseImport(ctx, advance(p))
    } else if (at(p, "impl")) {
        parseImpl(ctx, advance(p), docs)
    } else if (at(p, "derive")) {
        parseDerive(ctx, advance(p))
    } else if (at(p, "test")) {
        parseTest(ctx, advance(p), docs)
    } else {
        let exportTaken = at(p, "export");
        let (q, late) = exportAfterTheKeyword(ctx, if (exportTaken) {
            advance(p)
        } else {
            p
        });
        let exported = exportTaken || late;
        let (r, exchanged) = exchangedBinding(ctx, q);
        if (exchanged) {
            parseLet(ctx, advance(r), docs, exported)
        } else {
            parseExportable(ctx, r, docs, exported)
        }
    }
}

fn parseExportable<C: Allocator>(
    ctx: C,
    p: P,
    docs: [Str],
    exported: Bool,
): (P, ItemKind) {
    if (at(p, "fn")) {
        let (after, d) = parseFn(ctx, advance(p), docs, exported);
        (after, .Fn(d))
    } else if (at(p, "struct")) {
        parseStruct(ctx, advance(p), docs, exported)
    } else if (at(p, "enum")) {
        parseEnum(ctx, advance(p), docs, exported)
    } else if (at(p, "type")) {
        parseTypeAlias(ctx, advance(p), docs, exported)
    } else if (at(p, "let")) {
        parseLet(ctx, advance(p), docs, exported)
    } else if (at(p, "const")) {
        let told = report(
            ctx,
            p,
            here(p),
            "there is no `const` declaration; a module-level binding is written with `let`",
        );
        parseLet(ctx, advance(told), docs, exported)
    } else if (at(p, "trait")) {
        parseTrait(ctx, advance(p), docs, exported, false)
    } else if (at(p, "effect")) {
        parseTrait(ctx, advance(p), docs, exported, true)
    } else if (at(p, "context")) {
        parseContext(ctx, advance(p), docs, exported)
    } else if (at(p, "from")) {
        (
            bail(
                report(
                    ctx,
                    p,
                    here(p),
                    "write `from \"...\" export { ... }`, without a leading `export`",
                ),
            ),
            emptyKind(),
        )
    } else {
        (bail(expected(ctx, p, "a declaration")), emptyKind())
    }
}

fn emptyKind(): ItemKind {
    .Derive(DeriveDecl { traits: [], selfTy: unitType() })
}

/// `"core/list" from import * as list;`: a declaration's keyword written one
/// token late. Reported once, and the token is held for the declaration to
/// ask for.
fn exchangedHead<C: Allocator>(ctx: C, p: P): P {
    let t = tokenAt(p, 0);
    let keyword = tokenAt(p, 1);
    if (headTakes(keyword, t) == false || headTakes(keyword, tokenAt(p, 2))) {
        p
    } else if (p.source.slice(t.span.end, keyword.span.start).contains("\n")) {
        p
    } else {
        let told = expectedAs(
            ctx,
            p,
            t.span,
            str.format(ctx, "`${keyword.text}`"),
            describe(ctx, t),
        );
        advance(P { ..told, early: p.index })
    }
}

/// What a declaration's keyword is followed by, where that is one token.
fn headTakes(keyword: Token, t: Token): Bool {
    if (["from", "test"].contains(keyword.text)) {
        isStr(t)
    } else {
        isIdent(t)
            && [
                "impl",
                "derive",
                "struct",
                "enum",
                "type",
                "trait",
                "effect",
                "context",
                "const",
                "fn",
            ].contains(keyword.text)
    }
}

/// `fn export one()`: the keyword and its `export`, exchanged. Reported at the
/// `export`, which the name is then read past.
fn exportAfterTheKeyword<C: Allocator>(ctx: C, p: P): (P, Bool) {
    let mark = tokenAt(p, 1);
    if (
        tokenAt(p, 0).kind != TokenKind.Keyword
            || mark.text != "export"
            || isIdent(tokenAt(p, 2)) == false
    ) {
        (p, false)
    } else {
        (expectedAs(ctx, p, mark.span, "an identifier", describe(ctx, mark)), true)
    }
}

/// `total let = 1;`: the binding keyword and its name, exchanged. The name is
/// held for the binding to ask for.
fn exchangedBinding<C: Allocator>(ctx: C, p: P): (P, Bool) {
    let t = tokenAt(p, 0);
    if (
        isIdent(t) == false && isCtx(t) == false
            || tokenAt(p, 1).text != "let"
            || [":", "="].contains(tokenAt(p, 2).text) == false
    ) {
        (p, false)
    } else {
        let told = expectedAs(ctx, p, t.span, "`let`", describe(ctx, t));
        (advance(P { ..told, early: p.index }), true)
    }
}

// --- imports -------------------------------------------------------------------

fn parseImport<C: Allocator>(ctx: C, p: P): (P, ItemKind) {
    let (q, path) = expectString(ctx, p);
    if (at(q, "export")) {
        let opened = expect(ctx, advance(q), "{");
        let (afterSpecs, specs) = parseSpecs(ctx, opened, []);
        let closed = expectClose(ctx, afterSpecs, "}", "re-export list");
        (
            expectTerminator(ctx, closed, "a re-export declaration"),
            .ReExport(ReExport { path: path, specs: specs }),
        )
    } else {
        let started = expect(ctx, q, "import");
        if (at(started, "*")) {
            let starred = advance(started);
            if (at(starred, "as")) {
                let (named, alias) = expectName(ctx, advance(starred));
                (
                    expectTerminator(ctx, named, "an import declaration"),
                    .Import(Import { path: path, clause: .Namespace(alias) }),
                )
            } else {
                (
                    bail(
                        report(
                            ctx,
                            starred,
                            prevSpan(starred),
                            "a namespace import must be named",
                        ),
                    ),
                    emptyKind(),
                )
            }
        } else {
            let opened = expect(ctx, started, "{");
            let (afterSpecs, specs) = parseSpecs(ctx, opened, []);
            let closed = expectClose(ctx, afterSpecs, "}", "import list");
            (
                expectTerminator(ctx, closed, "an import declaration"),
                .Import(Import { path: path, clause: .Named(specs) }),
            )
        }
    }
}

fn parseSpecs<C: Allocator>(ctx: C, p: P, acc: [ImportSpec]): (P, [ImportSpec]) {
    if (listEnded(p, "}")) {
        (p, acc)
    } else {
        let (named, name) = expectName(ctx, p);
        let (aliased, alias) = if (at(named, "as")) {
            let (a, n) = expectName(ctx, advance(named));
            (a, [n])
        } else {
            (named, [])
        };
        let grown = acc.push(ctx, ImportSpec { name: name, alias: alias });
        let (q, more) = moreElements(ctx, aliased, "}", "an import name", startsName);
        if (more) { parseSpecs(ctx, q, grown) } else { (q, grown) }
    }
}

// --- functions -----------------------------------------------------------------

fn parseFn<C: Allocator>(ctx: C, p: P, docs: [Str], exported: Bool): (P, FnDecl) {
    let (named, name) = expectName(ctx, p);
    let (afterGenerics, generics) = parseGenerics(ctx, named);
    let opened = expect(ctx, afterGenerics, "(");
    let (afterParams, params) = parseParams(ctx, opened, []);
    let closed = expectClose(ctx, afterParams, ")", "parameter list");
    let colon = expect(ctx, closed, ":");
    let (afterRet, ret) = parseType(ctx, colon);
    let decl = FnDecl {
        name: name,
        generics: generics,
        params: params,
        ret: ret,
        body: [],
        exported: exported,
        docs: docs,
    };
    if (at(afterRet, "{")) {
        let (afterBody, body) = parseBlock(ctx, afterRet, "function body");
        (afterBody, FnDecl { ..decl, body: [body] })
    } else if (at(afterRet, ";")) {
        (advance(afterRet), decl)
    } else {
        (bail(expected(ctx, afterRet, "a function body")), decl)
    }
}

/// A trait's or an effect's method: no body, and a `;`.
fn parseMethodSig<C: Allocator>(ctx: C, p: P): (P, FnDecl) {
    let docs = docsHere(p);
    let (named, name) = expectName(ctx, expect(ctx, p, "fn"));
    let (afterGenerics, generics) = parseGenerics(ctx, named);
    let opened = expect(ctx, afterGenerics, "(");
    let (afterParams, params) = parseParams(ctx, opened, []);
    let closed = expectClose(ctx, afterParams, ")", "parameter list");
    let colon = expect(ctx, closed, ":");
    let (afterRet, ret) = parseType(ctx, colon);
    (
        expectTerminator(ctx, afterRet, "a method signature"),
        FnDecl {
            name: name,
            generics: generics,
            params: params,
            ret: ret,
            body: [],
            exported: false,
            docs: docs,
        },
    )
}

fn parseParams<C: Allocator>(ctx: C, p: P, acc: [Param]): (P, [Param]) {
    let t = tokenAt(p, 0);
    if (listEnded(p, ")") || acc.isEmpty() && t.text == ":") {
        (p, acc)
    } else {
        let (afterOne, param) = if (t.text == "self") {
            let taken = advance(p);
            let placed = if (acc.isEmpty()) {
                taken
            } else {
                report(
                    ctx,
                    taken,
                    t.span,
                    "`self` may appear only as a function's first parameter",
                )
            };
            (selfAnnotation(ctx, placed), Param { name: nameOf(p, t), ty: [] })
        } else if (t.text == "ctx") {
            let colon = expect(ctx, advance(p), ":");
            let (afterTy, ty) = parseType(ctx, colon);
            (afterTy, Param { name: nameOf(p, t), ty: [ty] })
        } else {
            let (named, name) = expectName(ctx, p);
            let colon = expect(ctx, named, ":");
            let (afterTy, ty) = parseType(ctx, colon);
            (afterTy, Param { name: name, ty: [ty] })
        };
        let grown = acc.push(ctx, param);
        let (q, more) = moreElements(
            ctx,
            afterOne,
            ")",
            "a function parameter",
            startsParam,
        );
        if (more) { parseParams(ctx, q, grown) } else { (q, grown) }
    }
}

/// The old `self: Type`, read and reported. A trial reading decides first: in
/// `fn area(self: Int;` the `: Int` is the return type of a list whose `)` is
/// missing, and the old form is only where the list goes on or ends after it.
fn selfAnnotation<C: Allocator>(ctx: C, p: P): P {
    if (at(p, ":") == false) {
        p
    } else {
        let (tried, _) = parseType(ctx, P { ..advance(p), trial: p.trial + 1 });
        if (tried.panicking || [",", ")"].contains(tokenAt(tried, 0).text) == false) {
            p
        } else {
            let colon = here(p);
            let (typed, ty) = parseType(ctx, advance(p));
            report(
                ctx,
                typed,
                Span { start: colon.start, end: ty.origin.span.end },
                "`self` is written without a type",
            )
        }
    }
}

fn parseGenerics<C: Allocator>(ctx: C, p: P): (P, [GenericParam]) {
    if (at(p, "<")) {
        let (afterList, generics) = parseGenericList(ctx, advance(p), []);
        (expectClose(ctx, afterList, ">", "generic parameter list"), generics)
    } else {
        (p, [])
    }
}

fn parseGenericList<C: Allocator>(
    ctx: C,
    p: P,
    acc: [GenericParam],
): (P, [GenericParam]) {
    if (listEnded(p, ">")) {
        (p, acc)
    } else {
        let (named, name) = expectName(ctx, p);
        let (afterBounds, bounds) = if (at(named, ":")) {
            parseBounds(ctx, advance(named), [])
        } else {
            (named, [])
        };
        let grown = acc.push(ctx, GenericParam { name: name, bounds: bounds });
        let (q, more) = moreElements(
            ctx,
            afterBounds,
            ">",
            "a generic parameter",
            startsName,
        );
        if (more) { parseGenericList(ctx, q, grown) } else { (q, grown) }
    }
}

fn parseBounds<C: Allocator>(ctx: C, p: P, acc: [Type]): (P, [Type]) {
    let (afterOne, ty) = parseNamedType(ctx, p);
    let grown = acc.push(ctx, ty);
    if (at(afterOne, "+")) {
        parseBounds(ctx, advance(afterOne), grown)
    } else {
        (afterOne, grown)
    }
}

// --- structs and enums -----------------------------------------------------------

fn parseStruct<C: Allocator>(ctx: C, p: P, docs: [Str], exported: Bool): (P, ItemKind) {
    let (named, name) = expectName(ctx, p);
    let (afterGenerics, generics) = parseGenerics(ctx, named);
    let decl = StructDecl {
        name: name,
        generics: generics,
        body: .Tuple([]),
        exported: exported,
        docs: docs,
    };
    if (at(afterGenerics, "(")) {
        let (afterFields, fields) = parseTupleFields(ctx, advance(afterGenerics), []);
        let closed = expectClose(ctx, afterFields, ")", "tuple-struct field list");
        (
            expectTerminator(ctx, closed, "a `struct` declaration"),
            .Struct(StructDecl { ..decl, body: .Tuple(fields) }),
        )
    } else {
        let opened = expect(ctx, afterGenerics, "{");
        let (afterFields, fields) = parseFieldDecls(ctx, opened, "}", true, []);
        (
            expectClose(ctx, afterFields, "}", "`struct` body"),
            .Struct(StructDecl { ..decl, body: .Record(fields) }),
        )
    }
}

/// A struct's fields carry their own `export`. A variant's payload fields take
/// the enum's, so one written there is reported.
fn parseFieldDecls<C: Allocator>(
    ctx: C,
    p: P,
    close: Str,
    perField: Bool,
    acc: [FieldDecl],
): (P, [FieldDecl]) {
    if (listEnded(p, close)) {
        (p, acc)
    } else {
        let start = here(p);
        let docs = docsHere(p);
        let marked = at(p, "export");
        let (named, name) = expectName(ctx, if (marked) { advance(p) } else { p });
        let told = if (marked && perField == false) {
            variantExport(ctx, named, start)
        } else {
            named
        };
        let colon = expect(ctx, told, ":");
        let (afterTy, ty) = parseType(ctx, colon);
        let grown = acc.push(ctx, FieldDecl {
            name: name,
            ty: ty,
            exported: marked && perField,
            docs: docs,
            origin: originFrom(afterTy, start),
        });
        let construct = if (perField) {
            "a record field"
        } else {
            "a variant payload field"
        };
        let (q, more) = moreElements(ctx, afterTy, close, construct, startsField);
        if (more) {
            parseFieldDecls(ctx, q, close, perField, grown)
        } else {
            (q, grown)
        }
    }
}

fn variantExport<C: Allocator>(ctx: C, p: P, keyword: Span): P {
    report(
        ctx,
        p,
        keyword,
        "a variant carries no `export` of its own; an exported enum exports every one of its variants",
    )
}

fn parseTupleFields<C: Allocator>(ctx: C, p: P, acc: [TupleField]): (P, [TupleField]) {
    if (listEnded(p, ")")) {
        (p, acc)
    } else {
        let start = here(p);
        let exported = at(p, "export");
        let (afterTy, ty) = parseType(ctx, if (exported) { advance(p) } else { p });
        let grown = acc.push(ctx, TupleField {
            ty: ty,
            exported: exported,
            origin: originFrom(afterTy, start),
        });
        let (q, more) = moreElements(
            ctx,
            afterTy,
            ")",
            "a tuple-struct field",
            startsTupleField,
        );
        if (more) { parseTupleFields(ctx, q, grown) } else { (q, grown) }
    }
}

fn parseEnum<C: Allocator>(ctx: C, p: P, docs: [Str], exported: Bool): (P, ItemKind) {
    let (named, name) = expectName(ctx, p);
    let (afterGenerics, generics) = parseGenerics(ctx, named);
    let opened = expect(ctx, afterGenerics, "{");
    let (afterVariants, variants, recovered) = parseVariants(ctx, opened, [], false);
    // A body that lost a variant has said what went wrong, and a `}` missing
    // after that is the same mistake again.
    let closed = if (recovered == false || at(afterVariants, "}")) {
        expectClose(ctx, afterVariants, "}", "`enum`")
    } else {
        afterVariants
    };
    (
        closed,
        .Enum(EnumDecl {
            name: name,
            generics: generics,
            variants: variants,
            exported: exported,
            docs: docs,
        }),
    )
}

/// The variants, each one that fails skipped to the next.
fn parseVariants<C: Allocator>(
    ctx: C,
    p: P,
    acc: [Variant],
    recovered: Bool,
): (P, [Variant], Bool) {
    if (listEnded(p, "}")) {
        (p, acc, recovered)
    } else {
        let mark = p.index;
        let (after, v) = parseVariant(ctx, p);
        let (synced, grown, lost) = if (after.panicking) {
            (syncMatchArm(resume(after), openSince(after, mark, false)).0, acc, true)
        } else {
            (after, acc.push(ctx, v), recovered)
        };
        let moved = if (synced.index == mark) { advance(synced) } else { synced };
        let (q, more) = moreElements(ctx, moved, "}", "an enum variant", startsField);
        if (more) { parseVariants(ctx, q, grown, lost) } else { (q, grown, lost) }
    }
}

fn parseVariant<C: Allocator>(ctx: C, p: P): (P, Variant) {
    let start = here(p);
    let docs = docsHere(p);
    let marked = at(p, "export");
    let (named, name) = expectName(ctx, if (marked) { advance(p) } else { p });
    let told = if (marked) { variantExport(ctx, named, start) } else { named };
    let (afterPayload, payload) = if (at(told, "(")) {
        let (a, types) = parseTypes(
            ctx,
            advance(told),
            [],
            ")",
            "a variant payload field",
        );
        (expectClose(ctx, a, ")", "variant payload"), VariantPayload.Tuple(types))
    } else if (at(told, "{")) {
        let (a, fields) = parseFieldDecls(ctx, advance(told), "}", false, []);
        (expectClose(ctx, a, "}", "variant field list"), VariantPayload.Record(fields))
    } else {
        (told, VariantPayload.Empty)
    };
    (
        afterPayload,
        Variant {
            name: name,
            payload: payload,
            docs: docs,
            origin: originFrom(afterPayload, start),
        },
    )
}

// --- the rest of the declarations -------------------------------------------------

fn parseTypeAlias<C: Allocator>(
    ctx: C,
    p: P,
    docs: [Str],
    exported: Bool,
): (P, ItemKind) {
    let (named, name) = expectName(ctx, p);
    let (afterGenerics, generics) = parseGenerics(ctx, named);
    let equals = expect(ctx, afterGenerics, "=");
    let (afterTy, ty) = parseType(ctx, equals);
    (
        expectTerminator(ctx, afterTy, "a type alias"),
        .TypeAlias(TypeAliasDecl {
            name: name,
            generics: generics,
            ty: ty,
            exported: exported,
            docs: docs,
        }),
    )
}

fn parseLet<C: Allocator>(ctx: C, p: P, docs: [Str], exported: Bool): (P, ItemKind) {
    let (named, name) = expectName(ctx, p);
    let colon = expect(ctx, named, ":");
    let (afterTy, ty) = parseType(ctx, colon);
    let equals = expect(ctx, afterTy, "=");
    let (afterValue, value) = parseExpr(ctx, equals);
    (
        expectTerminator(ctx, afterValue, "a `let` declaration"),
        .Let(LetDecl {
            name: name,
            ty: ty,
            value: value,
            exported: exported,
            docs: docs,
        }),
    )
}

fn parseTrait<C: Allocator>(
    ctx: C,
    p: P,
    docs: [Str],
    exported: Bool,
    isEffect: Bool,
): (P, ItemKind) {
    let (named, name) = expectName(ctx, p);
    let (afterGenerics, generics) = parseGenerics(ctx, named);
    let opened = expect(ctx, afterGenerics, "{");
    let (afterMethods, methods) = parseMethods(ctx, opened, [], false);
    let construct = if (isEffect) { "`effect` body" } else { "`trait` body" };
    (
        expectClose(ctx, afterMethods, "}", construct),
        .Trait(TraitDecl {
            name: name,
            generics: generics,
            methods: methods,
            isEffect: isEffect,
            exported: exported,
            docs: docs,
        }),
    )
}

fn parseImpl<C: Allocator>(ctx: C, p: P, docs: [Str]): (P, ItemKind) {
    let (afterGenerics, generics) = parseGenerics(ctx, p);
    let (afterFirst, first) = parseType(ctx, afterGenerics);
    let (afterHead, selfTy, traitTy) = if (at(afterFirst, "for")) {
        let (a, t) = parseType(ctx, advance(afterFirst));
        (a, t, [first])
    } else {
        (afterFirst, first, [])
    };
    let opened = expect(ctx, afterHead, "{");
    let (afterMethods, methods) = parseMethods(ctx, opened, [], true);
    (
        expectClose(ctx, afterMethods, "}", "`impl` body"),
        .Impl(ImplDecl {
            generics: generics,
            traitTy: traitTy,
            selfTy: selfTy,
            methods: methods,
            docs: docs,
        }),
    )
}

/// The methods of a trait or an `impl`. One that fails is skipped to its `;`
/// or to the body's `}`, and the rest are read.
fn parseMethods<C: Allocator>(
    ctx: C,
    p: P,
    acc: [FnDecl],
    inImpl: Bool,
): (P, [FnDecl]) {
    if (p.panicking || at(p, "}") || isEnd(p)) {
        (p, acc)
    } else {
        let mark = p.index;
        let (after, d) = if (inImpl) {
            let docs = docsHere(p);
            let exported = at(p, "export");
            let started = expect(ctx, if (exported) { advance(p) } else { p }, "fn");
            parseFn(ctx, started, docs, exported)
        } else {
            parseMethodSig(ctx, p)
        };
        if (after.panicking) {
            let (synced, _) = syncStmt(resume(after), openSince(after, mark, false));
            if (at(synced, "}")) {
                (synced, acc)
            } else {
                parseMethods(ctx, synced, acc, inImpl)
            }
        } else {
            parseMethods(ctx, after, acc.push(ctx, d), inImpl)
        }
    }
}

fn parseDerive<C: Allocator>(ctx: C, p: P): (P, ItemKind) {
    if (at(p, "for")) {
        (
            bail(report(ctx, p, here(p), "a `derive` clause names no traits")),
            emptyKind(),
        )
    } else {
        let (afterFirst, first) = parseNamedType(ctx, p);
        let (afterTraits, traits) = parseDeriveList(ctx, afterFirst, [first]);
        let forKeyword = expect(ctx, afterTraits, "for");
        let (afterSelf, selfTy) = parseNamedType(ctx, forKeyword);
        (
            expectTerminator(ctx, afterSelf, "a `derive` declaration"),
            .Derive(DeriveDecl { traits: traits, selfTy: selfTy }),
        )
    }
}

/// The traits after the first. `for` ends the list, so a name where it goes is
/// another trait with its comma missing.
fn parseDeriveList<C: Allocator>(ctx: C, p: P, acc: [Type]): (P, [Type]) {
    if (at(p, ",")) {
        let (afterOne, ty) = parseNamedType(ctx, advance(p));
        parseDeriveList(ctx, afterOne, acc.push(ctx, ty))
    } else if (p.panicking || isIdent(tokenAt(p, 0)) == false) {
        (p, acc)
    } else {
        let (afterOne, ty) = parseNamedType(
            ctx,
            separatorMissing(ctx, p, "a derived trait"),
        );
        parseDeriveList(ctx, afterOne, acc.push(ctx, ty))
    }
}

fn parseContext<C: Allocator>(
    ctx: C,
    p: P,
    docs: [Str],
    exported: Bool,
): (P, ItemKind) {
    let (named, name) = expectName(ctx, p);
    let (afterBody, spread, bindings) = parseContextBody(ctx, named);
    (
        afterBody,
        .Context(ContextDecl {
            name: name,
            spread: spread,
            bindings: bindings,
            exported: exported,
            docs: docs,
        }),
    )
}

fn parseTest<C: Allocator>(ctx: C, p: P, docs: [Str]): (P, ItemKind) {
    let (named, name) = expectString(ctx, p);
    let (afterBody, body) = parseBlock(ctx, named, "`test` body");
    (afterBody, .Test(TestDecl { name: name, body: body, docs: docs }))
}

// -----------------------------------------------------------------------------
// Types
// -----------------------------------------------------------------------------

fn parseType<C: Allocator>(ctx: C, p: P): (P, Type) {
    if (p.panicking) {
        (p, unitType())
    } else {
        let (after, ty) = parseTypeInner(ctx, enter(ctx, p));
        (P { ..after, depth: p.depth }, ty)
    }
}

fn parseTypeInner<C: Allocator>(ctx: C, p: P): (P, Type) {
    let start = here(p);
    if (at(p, "fn")) {
        let opened = expect(ctx, advance(p), "(");
        let (afterArgs, args) = parseTypes(
            ctx,
            opened,
            [],
            ")",
            "a function-type parameter",
        );
        let closed = expectClose(ctx, afterArgs, ")", "function type");
        let arrow = expect(ctx, closed, "=>");
        let (afterRet, ret) = parseType(ctx, arrow);
        (afterRet, Type { kind: .Fn(args, [ret]), origin: originFrom(afterRet, start) })
    } else if (at(p, "Self")) {
        parseNamedType(ctx, p)
    } else if (at(p, "[")) {
        let (afterElem, elem) = parseType(ctx, advance(p));
        let closed = expectClose(ctx, afterElem, "]", "array type");
        (closed, Type { kind: .Array([elem]), origin: originFrom(closed, start) })
    } else if (at(p, "(")) {
        parseParenType(ctx, advance(p), start)
    } else if (isIdent(tokenAt(p, 0)) || takeEarly(p, isIdent).isSome()) {
        parseNamedType(ctx, p)
    } else {
        (bail(expected(ctx, p, "a type")), unitType())
    }
}

/// `()`, a grouped type, or a tuple. A grouped type keeps the inner node, so
/// the parentheses a reader wrote leave no trace — the printer puts back the
/// ones the grammar needs. The `(` is already read.
fn parseParenType<C: Allocator>(ctx: C, p: P, start: Span): (P, Type) {
    if (at(p, ")")) {
        let closed = advance(p);
        (closed, Type { kind: .Unit, origin: originFrom(closed, start) })
    } else {
        let (afterFirst, first) = parseType(ctx, p);
        if (at(afterFirst, ")")) {
            (advance(afterFirst), first)
        } else {
            let (afterRest, elements) = tupleTypeRest(ctx, afterFirst, [first]);
            let closed = expectClose(ctx, afterRest, ")", "tuple type");
            let told = if (elements.length() < 2) {
                report(
                    ctx,
                    closed,
                    spanFrom(closed, start),
                    "a tuple type has two elements or more",
                )
            } else {
                closed
            };
            (told, Type { kind: .Tuple(elements), origin: originFrom(closed, start) })
        }
    }
}

fn tupleTypeRest<C: Allocator>(ctx: C, p: P, acc: [Type]): (P, [Type]) {
    let (q, more) = moreElements(ctx, p, ")", "a tuple type element", startsType);
    if (more == false || at(q, ")")) {
        (q, acc)
    } else {
        let (afterOne, ty) = parseType(ctx, q);
        tupleTypeRest(ctx, afterOne, acc.push(ctx, ty))
    }
}

/// Types up to `close`, which is left for the caller to ask for.
fn parseTypes<C: Allocator>(
    ctx: C,
    p: P,
    acc: [Type],
    close: Str,
    construct: Str,
): (P, [Type]) {
    if (listEnded(p, close)) {
        (p, acc)
    } else {
        let (afterOne, ty) = parseType(ctx, p);
        let grown = acc.push(ctx, ty);
        let (q, more) = moreElements(ctx, afterOne, close, construct, startsType);
        if (more) { parseTypes(ctx, q, grown, close, construct) } else { (q, grown) }
    }
}

/// A path and its arguments. `Self` is a name like any other, and a dotted path
/// is one name spanning the whole of it.
fn parseNamedType<C: Allocator>(ctx: C, p: P): (P, Type) {
    let start = here(p);
    if (at(p, "Self")) {
        let after = advance(p);
        (
            after,
            Type {
                kind: .Named(Name { text: "Self", origin: originAt(p, start) }, []),
                origin: originFrom(after, start),
            },
        )
    } else {
        let (named, first) = expectName(ctx, p);
        let (afterPath, segments) = parsePath(ctx, named, [first.text]);
        let name = Name {
            text: segments.join(ctx, "."),
            origin: originFrom(afterPath, start),
        };
        let (afterArgs, args) = parseTypeArgs(ctx, afterPath);
        (
            afterArgs,
            Type { kind: .Named(name, args), origin: originFrom(afterArgs, start) },
        )
    }
}

fn parsePath<C: Allocator>(ctx: C, p: P, acc: [Str]): (P, [Str]) {
    if (at(p, ".")) {
        let (named, name) = expectName(ctx, advance(p));
        parsePath(ctx, named, acc.push(ctx, name.text))
    } else {
        (p, acc)
    }
}

/// `<...>`, or nothing when there is no `<`.
fn parseTypeArgs<C: Allocator>(ctx: C, p: P): (P, [Type]) {
    if (at(p, "<")) {
        let (afterArgs, args) = parseTypes(ctx, advance(p), [], ">", "a type argument");
        (expectClose(ctx, afterArgs, ">", "type argument list"), args)
    } else {
        (p, [])
    }
}

// -----------------------------------------------------------------------------
// Blocks and statements
// -----------------------------------------------------------------------------

fn parseBlock<C: Allocator>(ctx: C, p: P, construct: Str): (P, Block) {
    let start = here(p);
    let opened = expect(ctx, enter(ctx, p), "{");
    let (afterBody, stmts, tail) = parseBlockBody(ctx, opened, [], []);
    let closed = expectClose(ctx, afterBody, "}", construct);
    (
        P { ..closed, depth: p.depth },
        Block { stmts: stmts, tail: tail, origin: originFrom(closed, start) },
    )
}

/// The statements up to the `}`. A declaration keyword means the block ended
/// and its `}` is what is missing.
fn parseBlockBody<C: Allocator>(
    ctx: C,
    p: P,
    acc: [Stmt],
    tail: [Expr],
): (P, [Stmt], [Expr]) {
    if (p.panicking || at(p, "}") || isEnd(p) || startsDeclaration(tokenAt(p, 0))) {
        (p, acc, tail)
    } else {
        let (after, made, value, more) = parseStatement(ctx, p);
        let grown = acc.concat(ctx, made);
        if (more) {
            parseBlockBody(ctx, P { ..after, early: -1 }, grown, value)
        } else {
            (P { ..after, early: -1 }, grown, value)
        }
    }
}

/// One statement, or the recovery from one: what it adds, the block's value
/// if this is it, and whether the block reads on.
fn parseStatement<C: Allocator>(ctx: C, p: P): (P, [Stmt], [Expr], Bool) {
    let mark = p.index;
    let start = here(p);
    let (q, isLet) = if (at(p, "let")) { (p, true) } else { exchangedBinding(ctx, p) };
    if (isLet) {
        let (after, kind) = parseLetStmt(ctx, q);
        if (after.panicking) {
            let (synced, semi) = syncStmt(resume(after), openSince(after, mark, false));
            (synced, [], [], semi)
        } else {
            (after, [Stmt { kind: kind, origin: originFrom(after, start) }], [], true)
        }
    } else {
        let opening = tokenAt(p, 0);
        let (after, e) = parseExpr(ctx, p);
        let next = tokenAt(after, 0);
        if (after.panicking) {
            let (synced, semi) = syncStmt(resume(after), openSince(after, mark, false));
            (synced, [], [], semi)
        } else if (next.text == ";") {
            let done = advance(after);
            (done, [Stmt { kind: .Expr(e), origin: originFrom(done, start) }], [], true)
        } else if (next.text == "=") {
            let told = report(
                ctx,
                after,
                next.span,
                "there is no assignment; a binding is given its value once, where it is declared",
            );
            let (rhs, _) = parseExpr(ctx, advance(told));
            let read = resume(rhs);
            (if (at(read, ";")) { advance(read) } else { read }, [], [], true)
        } else if (next.text == "let" || startsStatement(next)) {
            let done = expectTerminator(ctx, after, statementKind(e));
            (done, [Stmt { kind: .Expr(e), origin: originFrom(done, start) }], [], true)
        } else if (next.text == "}" || next.text == "") {
            (after, [], [e], true)
        } else if (statementEndsAhead(after, 0, 0)) {
            let told = expected(ctx, refusePostfix(ctx, after, opening), "`;`");
            (syncStmt(told, 0).0, [], [], true)
        } else {
            (refusePostfix(ctx, after, opening), [], [], false)
        }
    }
}

/// What to call a statement whose `;` is missing.
fn statementKind(e: Expr): Str {
    match (e.kind) {
        .Match(_, _) => "a `match` used as a statement",
        .If(_, _, _) => "an `if` used as a statement",
        .Block(_) => "a block used as a statement",
        .Context(_, _) => "a `context` used as a statement",
        _ => "a statement",
    }
}

/// Whether the statement still ends with a `;` inside this block.
fn statementEndsAhead(p: P, steps: Int, depth: Int): Bool {
    let t = tokenAt(p, steps);
    if (steps >= MAX_LOOKAHEAD || t.text == "") {
        false
    } else if (depth == 0 && (t.text == ";" || startsDeclaration(t))) {
        t.text == ";"
    } else if (opener(t)) {
        statementEndsAhead(p, steps + 1, depth + 1)
    } else if (closer(t)) {
        depth > 0 && statementEndsAhead(p, steps + 1, depth - 1)
    } else {
        statementEndsAhead(p, steps + 1, depth)
    }
}

/// The chain a block-like expression may not head, named where a reader would
/// otherwise be told the block's `}` is missing.
fn refusePostfix<C: Allocator>(ctx: C, p: P, opening: Token): P {
    let token = tokenAt(p, 0).text;
    let what = if (opening.text == "{") {
        "a block"
    } else if (opening.text == "if") {
        "an `if`"
    } else if (opening.text == "match") {
        "a `match`"
    } else {
        "a `context`"
    };
    if (
        [".", "(", "[", "?"].contains(token) == false
            || ["{", "if", "match", "context"].contains(opening.text) == false
    ) {
        p
    } else {
        report(
            ctx,
            p,
            here(p),
            str.format(ctx, "${what} is an operand, not the head of a `${token}`"),
        )
    }
}

fn parseLetStmt<C: Allocator>(ctx: C, p: P): (P, StmtKind) {
    let opened = expect(ctx, p, "let");
    let next = tokenAt(opened, 1);
    let q = if (
        strayToken(tokenAt(opened, 0)) && (startsPattern(next) || isCtx(next))
    ) {
        advance(expected(ctx, opened, "a pattern"))
    } else {
        opened
    };
    match (takeEarly(q, isCtx)) {
        .Some(taken) => {
            let (afterValue, value) = parseLetValue(ctx, taken.0);
            (afterValue, .LetCtx(value))
        },
        .None => {
            if (at(q, "ctx")) {
                let (afterValue, value) = parseLetValue(ctx, advance(q));
                (afterValue, .LetCtx(value))
            } else {
                let (afterPat, pattern) = parsePattern(ctx, q);
                let (afterTy, ty) = if (at(afterPat, ":")) {
                    let (a, t) = parseType(ctx, advance(afterPat));
                    (a, [t])
                } else {
                    (afterPat, [])
                };
                if (afterTy.panicking) {
                    (afterTy, .LetCtx(unitExpr()))
                } else {
                    let (afterValue, value) = parseLetValue(ctx, afterTy);
                    (afterValue, .Let(pattern, ty, value))
                }
            }
        },
    }
}

/// `= value;`. The pattern is behind us, so a mistake in the value costs the
/// value and not the binding: the statement is kept and the walk reads on
/// past its `;`.
fn parseLetValue<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let mark = p.index;
    let equals = expect(ctx, p, "=");
    let (afterValue, value) = parseExpr(ctx, equals);
    let ended = expectTerminator(ctx, afterValue, "a statement");
    if (ended.panicking) {
        (syncStmt(resume(ended), openSince(ended, mark, false)).0, unitExpr())
    } else {
        (ended, value)
    }
}

// -----------------------------------------------------------------------------
// Expressions
// -----------------------------------------------------------------------------

/// The precedence ladder of SPEC 6.1, lowest rung first. Written as a table
/// rather than as nine functions that differ only in their operator.
fn levelOps(level: Int): [Str] {
    if (level == 0) {
        ["||"]
    } else if (level == 1) {
        ["&&"]
    } else if (level == 2) {
        ["==", "!=", "<", "<=", ">", ">="]
    } else if (level == 3) {
        ["|"]
    } else if (level == 4) {
        ["^"]
    } else if (level == 5) {
        ["&"]
    } else if (level == 6) {
        ["+", "-"]
    } else {
        ["*", "/", "%"]
    }
}

let LEVELS: Int = 8;

/// The comparison rung, which does not associate: one operator and no more.
let COMPARISON: Int = 2;

fn parseExpr<C: Allocator>(ctx: C, p: P): (P, Expr) {
    if (p.panicking) {
        (p, unitExpr())
    } else {
        let entered = enter(ctx, p);
        let (after, e) = if (at(entered, "fn")) {
            parseLambda(ctx, entered)
        } else {
            parseBinary(ctx, entered, 0)
        };
        (P { ..after, depth: p.depth }, e)
    }
}

fn parseBinary<C: Allocator>(ctx: C, p: P, level: Int): (P, Expr) {
    if (level >= LEVELS) {
        parseUnary(ctx, p)
    } else {
        let start = here(p);
        let (afterLeft, left) = parseBinary(ctx, p, level + 1);
        binaryRest(ctx, afterLeft, level, left, start)
    }
}

fn binaryRest<C: Allocator>(
    ctx: C,
    p: P,
    level: Int,
    left: Expr,
    start: Span,
): (P, Expr) {
    if (p.panicking || levelOps(level).contains(tokenAt(p, 0).text) == false) {
        (p, left)
    } else {
        let op = binOpOf(tokenAt(p, 0).text);
        let (afterRight, right) = parseBinary(ctx, advance(p), level + 1);
        let node = Expr {
            kind: .Binary(op, [left], [right]),
            origin: originFrom(afterRight, start),
        };
        if (level == COMPARISON) {
            (refuseChain(ctx, afterRight), node)
        } else {
            binaryRest(ctx, afterRight, level, node, start)
        }
    }
}

/// `a < b < c`: said once, and the rest of the chain read and dropped.
fn refuseChain<C: Allocator>(ctx: C, p: P): P {
    if (p.panicking || levelOps(COMPARISON).contains(tokenAt(p, 0).text) == false) {
        p
    } else {
        dropChain(
            ctx,
            report(ctx, p, here(p), "comparison operators are non-associative"),
        )
    }
}

fn dropChain<C: Allocator>(ctx: C, p: P): P {
    if (p.panicking || levelOps(COMPARISON).contains(tokenAt(p, 0).text) == false) {
        p
    } else {
        dropChain(ctx, parseBinary(ctx, advance(p), COMPARISON + 1).0)
    }
}

fn binOpOf(text: Str): BinOp {
    if (text == "||") {
        .Or
    } else if (text == "&&") {
        .And
    } else if (text == "==") {
        .Eq
    } else if (text == "!=") {
        .Ne
    } else if (text == "<") {
        .Lt
    } else if (text == "<=") {
        .Le
    } else if (text == ">") {
        .Gt
    } else if (text == ">=") {
        .Ge
    } else if (text == "|") {
        .BitOr
    } else if (text == "^") {
        .BitXor
    } else if (text == "&") {
        .BitAnd
    } else if (text == "+") {
        .Add
    } else if (text == "-") {
        .Sub
    } else if (text == "*") {
        .Mul
    } else if (text == "/") {
        .Div
    } else {
        .Rem
    }
}

fn parseUnary<C: Allocator>(ctx: C, p: P): (P, Expr) {
    if (p.panicking) {
        (p, unitExpr())
    } else {
        let (after, e) = parseUnaryInner(ctx, enter(ctx, p));
        (P { ..after, depth: p.depth }, e)
    }
}

fn parseUnaryInner<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    let text = tokenAt(p, 0).text;
    if (p.panicking) {
        (p, unitExpr())
    } else if (["-", "!", "~"].contains(text)) {
        let (afterInner, inner) = parseUnary(ctx, advance(p));
        let op = if (text == "-") {
            UnOp.Neg
        } else if (text == "!") {
            UnOp.Not
        } else {
            UnOp.BitNot
        };
        (
            afterInner,
            Expr { kind: .Unary(op, [inner]), origin: originFrom(afterInner, start) },
        )
    } else if (["if", "match", "context", "{"].contains(text)) {
        parseBlockLike(ctx, p)
    } else {
        parsePostfix(ctx, p)
    }
}

fn unitExpr(): Expr {
    Expr { kind: .Unit, origin: nowhere() }
}

/// The brace-terminated expressions. They may be operands and may not head a
/// postfix chain, which is what keeps `if (c) { a } else { b } { x: 1 }` from
/// having two parses.
fn parseBlockLike<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    if (at(p, "if")) {
        parseIf(ctx, p)
    } else if (at(p, "match")) {
        parseMatch(ctx, p)
    } else if (at(p, "context")) {
        let (afterBody, spread, bindings) = parseContextBody(ctx, advance(p));
        (
            afterBody,
            Expr {
                kind: .Context(spread, bindings),
                origin: originFrom(afterBody, start),
            },
        )
    } else if (opensFields(p, 0)) {
        let (afterLit, spread, fields) = parseStructFields(ctx, advance(p));
        (
            afterLit,
            Expr {
                kind: .StructLit([], spread, fields),
                origin: originFrom(afterLit, start),
            },
        )
    } else if (isIdent(tokenAt(p, 1)) && opensFields(p, 1)) {
        // `{ Point x: 1 }`: the type written inside the brace it belongs in
        // front of, reported and read as the literal it says it is.
        let told = expectedAs(ctx, p, start, "a struct literal's type", "`{`");
        let typeName = tokenAt(p, 1);
        let head = Expr {
            kind: .Ident(nameOf(p, typeName)),
            origin: originAt(p, typeName.span),
        };
        let (afterLit, spread, fields) = parseStructFields(ctx, advance(advance(told)));
        (
            afterLit,
            Expr {
                kind: .StructLit([head], spread, fields),
                origin: originFrom(afterLit, start),
            },
        )
    } else {
        let (afterBlock, b) = parseBlock(ctx, p, "block");
        (afterBlock, Expr { kind: .Block(b), origin: originFrom(afterBlock, start) })
    }
}

/// Whether the token after the one at `offset` opens a field list: a `..`, or a
/// name and a `:`. Neither can begin a statement or an expression, so `{ }`,
/// `{ name }` and `{ name, ... }` are all blocks.
fn opensFields(p: P, offset: Int): Bool {
    tokenAt(p, offset + 1).text == ".."
        || isIdent(tokenAt(p, offset + 1)) && tokenAt(p, offset + 2).text == ":"
}

fn parseIf<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    let opened = expect(ctx, advance(p), "(");
    let (afterCond, cond) = parseExpr(ctx, opened);
    let closed = expectClose(ctx, afterCond, ")", "`if` condition");
    let (afterThen, then) = parseBlock(ctx, closed, "`if` branch");
    let (afterElse, otherwise) = if (at(afterThen, "else")) {
        let elseKeyword = advance(afterThen);
        if (at(elseKeyword, "if")) {
            parseIf(ctx, elseKeyword)
        } else {
            let elseStart = here(elseKeyword);
            let (a, b) = parseBlock(ctx, elseKeyword, "`else` branch");
            (a, Expr { kind: .Block(b), origin: originFrom(a, elseStart) })
        }
    } else if (tokenAt(afterThen, 1).text == "else") {
        // A stray token right before the `else` is the whole mistake.
        (bail(expected(ctx, afterThen, "`else`")), unitExpr())
    } else if (afterThen.closed == 0) {
        (
            bail(
                report(
                    ctx,
                    afterThen,
                    then.origin.span,
                    "`if` requires an `else` branch",
                ),
            ),
            unitExpr(),
        )
    } else {
        (bail(afterThen), unitExpr())
    };
    (
        afterElse,
        Expr {
            kind: .If([cond], [then], [otherwise]),
            origin: originFrom(afterElse, start),
        },
    )
}

fn parseMatch<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    let opened = expect(ctx, advance(p), "(");
    let (afterValue, value) = parseExpr(ctx, opened);
    let closed = expectClose(ctx, afterValue, ")", "`match` scrutinee");
    let braced = expect(ctx, closed, "{");
    let (afterArms, arms) = parseArms(ctx, braced, []);
    let done = expectClose(ctx, afterArms, "}", "`match`");
    (done, Expr { kind: .Match([value], arms), origin: originFrom(done, start) })
}

/// The arms. One that fails is skipped to the `,` after it.
fn parseArms<C: Allocator>(ctx: C, p: P, acc: [Arm]): (P, [Arm]) {
    if (listEnded(p, "}")) {
        (p, acc)
    } else {
        let mark = p.index;
        let (after, arm) = parseArm(ctx, p);
        if (after.panicking) {
            let (synced, comma) = syncMatchArm(
                resume(after),
                openSince(after, mark, false),
            );
            if (comma) { parseArms(ctx, advance(synced), acc) } else { (synced, acc) }
        } else {
            let grown = acc.push(ctx, arm);
            let (q, more) = moreElements(ctx, after, "}", "a match arm", startsPattern);
            if (more) { parseArms(ctx, q, grown) } else { (q, grown) }
        }
    }
}

fn parseArm<C: Allocator>(ctx: C, p: P): (P, Arm) {
    let (afterPat, pattern) = parsePattern(ctx, p);
    let (afterGuard, guard) = if (at(afterPat, "if")) {
        let (a, g) = parseExpr(ctx, P { ..advance(afterPat), armBody: 0 });
        (P { ..a, armBody: p.armBody }, [g])
    } else {
        (afterPat, [])
    };
    let arrow = expectArrow(ctx, afterGuard);
    let (afterBody, body) = parseExpr(ctx, P { ..arrow, armBody: p.armBody + 1 });
    (
        P { ..afterBody, armBody: p.armBody },
        Arm { pattern: pattern, guard: guard, body: body },
    )
}

/// The body of a `context`, which both of its forms share, from its `{`.
fn parseContextBody<C: Allocator>(ctx: C, p: P): (P, [Expr], [Binding]) {
    let (afterSpread, spread) = parseSpread(ctx, expect(ctx, p, "{"));
    let (afterBindings, bindings) = parseBindings(ctx, afterSpread, []);
    (expectClose(ctx, afterBindings, "}", "context"), spread, bindings)
}

fn parseSpread<C: Allocator>(ctx: C, p: P): (P, [Expr]) {
    if (at(p, "..")) {
        let (afterExpr, e) = parseExpr(ctx, advance(p));
        (eatComma(afterExpr), [e])
    } else {
        (p, [])
    }
}

fn parseBindings<C: Allocator>(ctx: C, p: P, acc: [Binding]): (P, [Binding]) {
    if (listEnded(p, "}")) {
        (p, acc)
    } else {
        let (afterTy, effectTy) = parseNamedType(ctx, p);
        let colon = expect(ctx, afterTy, ":");
        let (afterValue, value) = parseExpr(ctx, colon);
        let grown = acc.push(ctx, Binding { effectTy: effectTy, value: value });
        let (q, more) = moreElements(
            ctx,
            afterValue,
            "}",
            "a context binding",
            startsName,
        );
        if (more) { parseBindings(ctx, q, grown) } else { (q, grown) }
    }
}

fn parseLambda<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    let opened = expect(ctx, advance(p), "(");
    let (afterParams, params) = parseLambdaParams(ctx, opened, []);
    let closed = expectClose(ctx, afterParams, ")", "lambda parameter list");
    let (afterRet, ret) = if (at(closed, ":")) {
        let (a, t) = parseType(ctx, advance(closed));
        (a, [t])
    } else {
        (closed, [])
    };
    let arrow = expect(ctx, afterRet, "=>");
    let (afterBody, body) = parseExpr(ctx, arrow);
    (
        afterBody,
        Expr {
            kind: .Lambda(params, ret, [body]),
            origin: originFrom(afterBody, start),
        },
    )
}

fn parseLambdaParams<C: Allocator>(
    ctx: C,
    p: P,
    acc: [LambdaParam],
): (P, [LambdaParam]) {
    if (listEnded(p, ")")) {
        (p, acc)
    } else {
        let (named, name) = expectName(ctx, p);
        let (afterTy, ty) = if (at(named, ":")) {
            let (a, t) = parseType(ctx, advance(named));
            (a, [t])
        } else {
            (named, [])
        };
        let grown = acc.push(ctx, LambdaParam { name: name, ty: ty });
        let (q, more) = moreElements(
            ctx,
            afterTy,
            ")",
            "a lambda parameter",
            startsName,
        );
        if (more) { parseLambdaParams(ctx, q, grown) } else { (q, grown) }
    }
}

// --- the postfix chain -------------------------------------------------------------

fn parsePostfix<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    let (afterBase, base) = parsePrimary(ctx, p);
    postfixRest(ctx, afterBase, base, start)
}

fn postfixRest<C: Allocator>(ctx: C, p: P, base: Expr, start: Span): (P, Expr) {
    let text = tokenAt(p, 0).text;
    if (p.panicking || startsPostfix(tokenAt(p, 0)) == false) {
        (p, base)
    } else if (text == ".") {
        if (p.armBody > 0 && armPatternFollows(p)) {
            (p, base)
        } else {
            postfixDot(ctx, advance(p), base, start)
        }
    } else if (text == "(") {
        let (afterArgs, args) = parseArgs(ctx, advance(p), []);
        let closed = expectClose(ctx, afterArgs, ")", "call");
        postfixRest(
            ctx,
            closed,
            Expr { kind: .Call([base], args), origin: originFrom(closed, start) },
            start,
        )
    } else if (text == "[") {
        if (prevSpan(p).end < here(p).start && opensAnArray(p, 0, 0)) {
            (p, base)
        } else {
            let (afterIndex, index) = parseExpr(ctx, advance(p));
            let closed = expectClose(ctx, afterIndex, "]", "index");
            postfixRest(
                ctx,
                closed,
                Expr {
                    kind: .Index([base], [index]),
                    origin: originFrom(closed, start),
                },
                start,
            )
        }
    } else if (text == "?") {
        let after = advance(p);
        postfixRest(
            ctx,
            after,
            Expr { kind: .Try([base]), origin: originFrom(after, start) },
            start,
        )
    } else if (text == "<") {
        match (tryTypeArgs(ctx, p)) {
            .Some(taken) => {
                postfixRest(
                    ctx,
                    taken.0,
                    Expr {
                        kind: .Generic([base], taken.1),
                        origin: originFrom(taken.0, start),
                    },
                    start,
                )
            },
            .None => (p, base),
        }
    } else if (text == "::") {
        let colons = here(p);
        let after = advance(p);
        if (at(after, "<")) {
            let told = report(
                ctx,
                after,
                colons,
                "type arguments in an expression are written without `::`",
            );
            let (afterArgs, args) = parseTypeArgs(ctx, told);
            postfixRest(
                ctx,
                afterArgs,
                Expr {
                    kind: .Generic([base], args),
                    origin: originFrom(afterArgs, start),
                },
                start,
            )
        } else {
            (bail(report(ctx, after, colons, "`::` is not an operator")), base)
        }
    } else {
        let (afterLit, spread, fields) = parseStructFields(ctx, advance(p));
        postfixRest(
            ctx,
            afterLit,
            Expr {
                kind: .StructLit([base], spread, fields),
                origin: originFrom(afterLit, start),
            },
            start,
        )
    }
}

/// After a `.`: a tuple index, or a field.
fn postfixDot<C: Allocator>(ctx: C, p: P, base: Expr, start: Span): (P, Expr) {
    let t = tokenAt(p, 0);
    if (t.kind == TokenKind.Int) {
        let after = advance(p);
        match (intValue(ctx, t.text).filter(fn(n) => n <= 4294967295)) {
            .Some(n) => {
                postfixRest(
                    ctx,
                    after,
                    Expr {
                        kind: .TupleIndex([base], n),
                        origin: originFrom(after, start),
                    },
                    start,
                )
            },
            .None => {
                postfixRest(
                    ctx,
                    report(
                        ctx,
                        after,
                        t.span,
                        str.format(ctx, "`${t.text}` is not a tuple index"),
                    ),
                    base,
                    start,
                )
            },
        }
    } else if (t.kind == TokenKind.Float) {
        (
            bail(
                report(
                    ctx,
                    p,
                    t.span,
                    str.format(
                        ctx,
                        "`.${t.text}` lexes as a float, not two tuple indices",
                    ),
                ),
            ),
            base,
        )
    } else {
        let (named, name) = expectName(ctx, p);
        postfixRest(
            ctx,
            named,
            Expr { kind: .Field([base], name), origin: originFrom(named, start) },
            start,
        )
    }
}

/// Inside a match arm's body, whether the `.` under the cursor opens the next
/// arm's pattern, with the comma between them missing: a whole variant pattern
/// and then its `=>`.
fn armPatternFollows(p: P): Bool {
    if (isIdent(tokenAt(p, 1)) == false) {
        false
    } else {
        let after = if (tokenAt(p, 2).text == "(") {
            pastGroup(p, 2, ")", 0, 0)
        } else if (tokenAt(p, 2).text == "{") {
            pastGroup(p, 2, "}", 0, 0)
        } else {
            .Some(2)
        };
        match (after) {
            .Some(i) => {
                let t = tokenAt(p, i);
                t.text == "=>"
                    || ["if", "|"].contains(t.text) && arrowBeforeTheArmEnds(p, i, 0, 0)
            },
            .None => false,
        }
    }
}

/// The offset just past the group opening at `i`, if it closes with `close`.
fn pastGroup(p: P, i: Int, close: Str, steps: Int, depth: Int): Option<Int> {
    let t = tokenAt(p, i + steps);
    if (steps >= MAX_LOOKAHEAD || t.text == "") {
        .None
    } else if (opener(t)) {
        pastGroup(p, i, close, steps + 1, depth + 1)
    } else if (closer(t) && depth == 1) {
        if (t.text == close) { .Some(i + steps + 1) } else { .None }
    } else if (closer(t)) {
        pastGroup(p, i, close, steps + 1, depth - 1)
    } else {
        pastGroup(p, i, close, steps + 1, depth)
    }
}

/// Whether a `=>` comes before anything that would end the arm.
fn arrowBeforeTheArmEnds(p: P, i: Int, steps: Int, depth: Int): Bool {
    let t = tokenAt(p, i + steps);
    if (steps >= MAX_LOOKAHEAD || t.text == "") {
        false
    } else if (depth <= 0 && t.text == "=>") {
        true
    } else if (opener(t)) {
        arrowBeforeTheArmEnds(p, i, steps + 1, depth + 1)
    } else if (depth <= 0 && ([",", ";"].contains(t.text) || closer(t))) {
        false
    } else if (closer(t)) {
        arrowBeforeTheArmEnds(p, i, steps + 1, depth - 1)
    } else {
        arrowBeforeTheArmEnds(p, i, steps + 1, depth)
    }
}

/// Whether the spaced `[` under the cursor opens a group with a `,` directly in
/// it — an array, the next element of the list this expression is in, rather
/// than an index.
fn opensAnArray(p: P, steps: Int, depth: Int): Bool {
    let t = tokenAt(p, steps);
    if (steps >= MAX_LOOKAHEAD) {
        false
    } else if (depth == 1 && [",", "<"].contains(t.text)) {
        t.text == ","
    } else if (opener(t)) {
        opensAnArray(p, steps + 1, depth + 1)
    } else if (closer(t)) {
        depth > 1 && opensAnArray(p, steps + 1, depth - 1)
    } else {
        opensAnArray(p, steps + 1, depth)
    }
}

fn parseArgs<C: Allocator>(ctx: C, p: P, acc: [Expr]): (P, [Expr]) {
    if (listEnded(p, ")")) {
        (p, acc)
    } else {
        let (afterOne, e) = parseExpr(ctx, p);
        let grown = acc.push(ctx, e);
        let (q, more) = moreElements(ctx, afterOne, ")", "a call argument", startsExpr);
        if (more) { parseArgs(ctx, q, grown) } else { (q, grown) }
    }
}

/// `..base, a: 1, b }`, from inside the brace.
fn parseStructFields<C: Allocator>(ctx: C, p: P): (P, [Expr], [Init]) {
    let (afterSpread, spread) = parseSpread(ctx, p);
    let (afterFields, fields) = parseInits(ctx, afterSpread, []);
    (expectClose(ctx, afterFields, "}", "struct literal"), spread, fields)
}

fn parseInits<C: Allocator>(ctx: C, p: P, acc: [Init]): (P, [Init]) {
    if (listEnded(p, "}")) {
        (p, acc)
    } else {
        let (named, name) = expectName(ctx, p);
        let (afterValue, value) = if (at(named, ":")) {
            let (a, e) = parseExpr(ctx, advance(named));
            (a, [e])
        } else {
            (named, [])
        };
        let grown = acc.push(ctx, Init { name: name, value: value });
        let (q, more) = moreElements(
            ctx,
            afterValue,
            "}",
            "a struct-literal field",
            startsName,
        );
        if (more) { parseInits(ctx, q, grown) } else { (q, grown) }
    }
}

// --- type arguments in expression position -------------------------------------------

/// The one place the grammar is not LR(1): a `<` opens type arguments or is a
/// comparison, and which one cannot be known until the `>` is found.
///
/// Three steps, cheapest first: a bounded token scan for a `>` over the tokens
/// a type may be built from, the real type-argument parser on trial, and then
/// the token *after* the `>`, which is what settles the readings both parse.
/// The trial says nothing, so a list that commits is read again for real.
fn tryTypeArgs<C: Allocator>(ctx: C, p: P): Option<(P, [Type])> {
    if (scanForTypeArgs(p, 0, 0) == false) {
        .None
    } else {
        let (tried, args) = parseTypeArgs(ctx, P { ..p, trial: p.trial + 1 });
        if (tried.panicking == false && args.isEmpty() == false && commits(tried)) {
            .Some(parseTypeArgs(ctx, p))
        } else {
            .None
        }
    }
}

/// A `(` and a `{` are what type arguments are for. Anything that cannot begin
/// an expression leaves the comparison reading with no right operand, so type
/// arguments are the only reading that is a program at all. Anything else keeps
/// the comparison.
fn commits(p: P): Bool {
    let t = tokenAt(p, 0);
    ["(", "{"].contains(t.text) || startsExpr(t) == false
}

fn scanForTypeArgs(p: P, steps: Int, depth: Int): Bool {
    let t = tokenAt(p, steps);
    if (steps >= MAX_LOOKAHEAD) {
        false
    } else if (t.text == "<") {
        scanForTypeArgs(p, steps + 1, depth + 1)
    } else if (t.text == ">") {
        depth <= 1 || scanForTypeArgs(p, steps + 1, depth - 1)
    } else if (
        isIdent(t)
            || ["Self", "fn", ".", ",", "(", ")", "[", "]", "=>"].contains(t.text)
    ) {
        scanForTypeArgs(p, steps + 1, depth)
    } else {
        false
    }
}

// --- primary expressions -------------------------------------------------------------

fn parsePrimary<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let t = tokenAt(p, 0);
    let start = t.span;
    let after = advance(p);
    if (t.kind == TokenKind.Int) {
        (after, Expr { kind: intKind(ctx, t.text), origin: originAt(p, start) })
    } else if (t.kind == TokenKind.Float) {
        (after, Expr { kind: .Float(floatOf(ctx, t.text)), origin: originAt(p, start) })
    } else if (t.kind == TokenKind.Str) {
        (
            after,
            Expr { kind: .Str(literalText(ctx, t.text)), origin: originAt(p, start) },
        )
    } else if (t.kind == TokenKind.Char) {
        (
            after,
            Expr { kind: .Char(charLiteral(ctx, t.text)), origin: originAt(p, start) },
        )
    } else if (t.kind == TokenKind.TemplateHead) {
        parseTemplate(ctx, p)
    } else if (t.text == "true") {
        (after, Expr { kind: .Bool(true), origin: originAt(p, start) })
    } else if (t.text == "false") {
        (after, Expr { kind: .Bool(false), origin: originAt(p, start) })
    } else if (t.text == "self") {
        (after, Expr { kind: .SelfValue, origin: originAt(p, start) })
    } else if (t.text == "ctx") {
        (after, Expr { kind: .Ctx, origin: originAt(p, start) })
    } else if (isIdent(t)) {
        (after, Expr { kind: .Ident(nameOf(p, t)), origin: originAt(p, start) })
    } else if (t.text == ".") {
        let (named, name) = expectName(ctx, after);
        (named, Expr { kind: .DotVariant(name), origin: originFrom(named, start) })
    } else if (t.text == "[") {
        let (afterItems, items) = parseArrayItems(ctx, after, []);
        let closed = expectClose(ctx, afterItems, "]", "array");
        (closed, Expr { kind: .Array(items), origin: originFrom(closed, start) })
    } else if (t.text == "(") {
        parseParenExpr(ctx, after, start)
    } else {
        (bail(expected(ctx, p, "an expression")), unitExpr())
    }
}

fn parseArrayItems<C: Allocator>(ctx: C, p: P, acc: [Expr]): (P, [Expr]) {
    if (listEnded(p, "]")) {
        (p, acc)
    } else {
        let (afterOne, e) = parseExpr(ctx, p);
        let grown = acc.push(ctx, e);
        let (q, more) = moreElements(
            ctx,
            afterOne,
            "]",
            "an array element",
            startsExpr,
        );
        if (more) { parseArrayItems(ctx, q, grown) } else { (q, grown) }
    }
}

/// `()`, a grouped expression, or a tuple, from after the `(`.
fn parseParenExpr<C: Allocator>(ctx: C, p: P, start: Span): (P, Expr) {
    if (at(p, ")")) {
        let closed = advance(p);
        (closed, Expr { kind: .Unit, origin: originFrom(closed, start) })
    } else {
        let (afterFirst, first) = parseExpr(ctx, p);
        if (at(afterFirst, ")")) {
            (advance(afterFirst), first)
        } else {
            let (afterRest, elements) = tupleRest(ctx, afterFirst, [first]);
            let whole = at(afterRest, ")");
            let closed = expectClose(ctx, afterRest, ")", "tuple");
            // What is inside a group that never closed is whatever the
            // recovery stopped at, so its count is not a thing to report.
            let told = if (whole && elements.length() < 2) {
                report(
                    ctx,
                    closed,
                    spanFrom(closed, start),
                    "a tuple has two elements or more",
                )
            } else {
                closed
            };
            (told, Expr { kind: .Tuple(elements), origin: originFrom(closed, start) })
        }
    }
}

fn tupleRest<C: Allocator>(ctx: C, p: P, acc: [Expr]): (P, [Expr]) {
    let (q, more) = moreElements(ctx, p, ")", "a tuple element", startsExpr);
    if (more == false || at(q, ")")) {
        (q, acc)
    } else {
        let (afterOne, e) = parseExpr(ctx, q);
        tupleRest(ctx, afterOne, acc.push(ctx, e))
    }
}

/// `"a${b}c"` — the head, then a hole and a span until the tail.
fn parseTemplate<C: Allocator>(ctx: C, p: P): (P, Expr) {
    let start = here(p);
    let head = tokenAt(p, 0).text;
    let opening = [Part.Text(unescape(ctx, head.slice(1, head.length() - 2)))];
    let (afterParts, parts) = templateParts(ctx, advance(p), opening);
    (afterParts, Expr { kind: .Template(parts), origin: originFrom(afterParts, start) })
}

fn templateParts<C: Allocator>(ctx: C, p: P, acc: [Part]): (P, [Part]) {
    let (afterHole, hole) = parseExpr(ctx, p);
    let withHole = acc.push(ctx, Part.Hole(hole));
    let t = tokenAt(afterHole, 0);
    if (afterHole.panicking) {
        (afterHole, withHole)
    } else if (t.kind == TokenKind.TemplateSpan) {
        templateParts(
            ctx,
            advance(afterHole),
            withHole.push(
                ctx,
                .Text(unescape(ctx, t.text.slice(1, t.text.length() - 2))),
            ),
        )
    } else if (t.kind == TokenKind.TemplateTail) {
        (
            advance(afterHole),
            withHole.push(
                ctx,
                .Text(unescape(ctx, t.text.slice(1, t.text.length() - 1))),
            ),
        )
    } else {
        (bail(expected(ctx, afterHole, "the rest of the string")), withHole)
    }
}

// -----------------------------------------------------------------------------
// Patterns
// -----------------------------------------------------------------------------

fn parsePattern<C: Allocator>(ctx: C, p: P): (P, Pattern) {
    let entered = enter(ctx, p);
    let start = here(p);
    let (afterFirst, first) = parsePatternNoOr(ctx, entered);
    let (after, pattern) = if (at(afterFirst, "|")) {
        let (afterRest, rest) = parseOrPatterns(ctx, afterFirst, []);
        (
            afterRest,
            Pattern {
                kind: .Or([first].concat(ctx, rest)),
                origin: originFrom(afterRest, start),
            },
        )
    } else {
        (afterFirst, first)
    };
    (P { ..after, depth: p.depth }, pattern)
}

fn parseOrPatterns<C: Allocator>(ctx: C, p: P, acc: [Pattern]): (P, [Pattern]) {
    if (at(p, "|")) {
        let (afterOne, one) = parsePatternNoOr(ctx, advance(p));
        parseOrPatterns(ctx, afterOne, acc.push(ctx, one))
    } else {
        (p, acc)
    }
}

fn parsePatternNoOr<C: Allocator>(ctx: C, p: P): (P, Pattern) {
    let t = tokenAt(p, 0);
    let start = t.span;
    let after = advance(p);
    if (p.panicking) {
        (p, wildPattern())
    } else if (t.text == "_") {
        (after, Pattern { kind: .Wild, origin: originAt(p, start) })
    } else if (t.text == "-") {
        let number = tokenAt(after, 0);
        let done = advance(after);
        if (number.kind == TokenKind.Int) {
            (
                done,
                Pattern {
                    kind: .LitInt(0 - intOf(ctx, number.text)),
                    origin: originFrom(done, start),
                },
            )
        } else if (number.kind == TokenKind.Float) {
            (
                done,
                Pattern {
                    kind: .LitFloat(0.0 - floatOf(ctx, number.text)),
                    origin: originFrom(done, start),
                },
            )
        } else {
            (bail(expected(ctx, after, "a number after `-`")), wildPattern())
        }
    } else if (t.kind == TokenKind.Int) {
        (
            after,
            Pattern { kind: .LitInt(intOf(ctx, t.text)), origin: originAt(p, start) },
        )
    } else if (t.kind == TokenKind.Float) {
        (
            after,
            Pattern {
                kind: .LitFloat(floatOf(ctx, t.text)),
                origin: originAt(p, start),
            },
        )
    } else if (t.kind == TokenKind.Str) {
        (
            after,
            Pattern {
                kind: .LitStr(literalText(ctx, t.text)),
                origin: originAt(p, start),
            },
        )
    } else if (t.kind == TokenKind.Char) {
        (
            after,
            Pattern {
                kind: .LitChar(charLiteral(ctx, t.text)),
                origin: originAt(p, start),
            },
        )
    } else if (t.text == "true") {
        (after, Pattern { kind: .LitBool(true), origin: originAt(p, start) })
    } else if (t.text == "false") {
        (after, Pattern { kind: .LitBool(false), origin: originAt(p, start) })
    } else if (t.text == ".") {
        let (named, name) = expectName(ctx, after);
        let (afterPayload, payload) = parsePayload(ctx, named);
        (
            afterPayload,
            Pattern {
                kind: .Path(name, true, payload),
                origin: originFrom(afterPayload, start),
            },
        )
    } else if (t.text == "[") {
        parseArrayPattern(ctx, after, start)
    } else if (t.text == "(") {
        parseParenPattern(ctx, after, start)
    } else if (isIdent(t)) {
        parseIdentPattern(ctx, p, start)
    } else {
        match (takeEarly(p, isIdent)) {
            .Some(taken) => {
                (
                    taken.0,
                    Pattern {
                        kind: .Bind(nameOf(p, taken.1), []),
                        origin: originAt(p, taken.1.span),
                    },
                )
            },
            .None => (bail(expected(ctx, p, "a pattern")), wildPattern()),
        }
    }
}

fn wildPattern(): Pattern {
    Pattern { kind: .Wild, origin: nowhere() }
}

/// A bare name binds. A dotted one, or one with a payload behind it, names a
/// variant or a struct — which is what makes a pattern parseable with no name
/// resolution behind it.
fn parseIdentPattern<C: Allocator>(ctx: C, p: P, start: Span): (P, Pattern) {
    let name = nameOf(p, tokenAt(p, 0));
    let after = advance(p);
    if (at(after, ".")) {
        let (afterPath, segments) = parsePath(ctx, after, [name.text]);
        let path = Name {
            text: segments.join(ctx, "."),
            origin: originFrom(afterPath, start),
        };
        let (afterPayload, payload) = parsePayload(ctx, afterPath);
        (
            afterPayload,
            Pattern {
                kind: .Path(path, false, payload),
                origin: originFrom(afterPayload, start),
            },
        )
    } else if (at(after, "(") || at(after, "{")) {
        let (afterPayload, payload) = parsePayload(ctx, after);
        (
            afterPayload,
            Pattern {
                kind: .Path(name, false, payload),
                origin: originFrom(afterPayload, start),
            },
        )
    } else if (at(after, "@")) {
        let (afterSub, sub) = parsePatternNoOr(ctx, advance(after));
        (
            afterSub,
            Pattern { kind: .Bind(name, [sub]), origin: originFrom(afterSub, start) },
        )
    } else {
        (after, Pattern { kind: .Bind(name, []), origin: originAt(p, start) })
    }
}

fn parsePayload<C: Allocator>(ctx: C, p: P): (P, [Payload]) {
    if (at(p, "(")) {
        let (after, items) = parsePatternList(ctx, advance(p), []);
        (
            expectClose(ctx, after, ")", "variant payload pattern"),
            [Payload.Tuple(items)],
        )
    } else if (at(p, "{")) {
        let (after, fields, rest) = parseFieldPats(ctx, advance(p), []);
        (
            expectClose(ctx, after, "}", "variant field pattern"),
            [Payload.Record(fields, rest)],
        )
    } else {
        (p, [])
    }
}

fn parsePatternList<C: Allocator>(ctx: C, p: P, acc: [Pattern]): (P, [Pattern]) {
    if (listEnded(p, ")")) {
        (p, acc)
    } else {
        let (afterOne, one) = parsePattern(ctx, p);
        let grown = acc.push(ctx, one);
        let (q, more) = moreElements(
            ctx,
            afterOne,
            ")",
            "a variant-pattern field",
            startsPattern,
        );
        if (more) { parsePatternList(ctx, q, grown) } else { (q, grown) }
    }
}

fn parseFieldPats<C: Allocator>(ctx: C, p: P, acc: [FieldPat]): (P, [FieldPat], Bool) {
    if (listEnded(p, "}")) {
        (p, acc, false)
    } else if (at(p, "..")) {
        (eatComma(advance(p)), acc, true)
    } else {
        let (named, name) = expectName(ctx, p);
        let (afterPat, inner) = if (at(named, ":")) {
            let (a, one) = parsePattern(ctx, advance(named));
            (a, [one])
        } else {
            (named, [])
        };
        let grown = acc.push(ctx, FieldPat { name: name, pattern: inner });
        let (q, more) = moreElements(ctx, afterPat, "}", "a field pattern", startsName);
        if (more) { parseFieldPats(ctx, q, grown) } else { (q, grown, false) }
    }
}

fn parseArrayPattern<C: Allocator>(ctx: C, p: P, start: Span): (P, Pattern) {
    let (after, items, rest) = arrayPatternBody(ctx, p, []);
    let closed = expectClose(ctx, after, "]", "array pattern");
    (closed, Pattern { kind: .Array(items, rest), origin: originFrom(closed, start) })
}

fn arrayPatternBody<C: Allocator>(
    ctx: C,
    p: P,
    acc: [Pattern],
): (P, [Pattern], [Rest]) {
    if (listEnded(p, "]")) {
        (p, acc, [])
    } else if (at(p, "..")) {
        let after = advance(p);
        let (named, tail) = if (isIdent(tokenAt(after, 0))) {
            let (a, n) = expectName(ctx, after);
            (a, [Rest.Named(n)])
        } else {
            (after, [Rest.Anonymous])
        };
        let done = eatComma(named);
        if (at(done, "]")) {
            (done, acc, tail)
        } else {
            (
                bail(report(ctx, done, here(done), "a rest pattern must come last")),
                acc,
                tail,
            )
        }
    } else {
        let (afterOne, one) = parsePattern(ctx, p);
        let grown = acc.push(ctx, one);
        let (q, more) = moreElements(
            ctx,
            afterOne,
            "]",
            "an array-pattern element",
            startsPattern,
        );
        if (more) { arrayPatternBody(ctx, q, grown) } else { (q, grown, []) }
    }
}

/// `()`, a grouped pattern, or a tuple, from after the `(`.
fn parseParenPattern<C: Allocator>(ctx: C, p: P, start: Span): (P, Pattern) {
    if (at(p, ")")) {
        let closed = advance(p);
        (closed, Pattern { kind: .Unit, origin: originFrom(closed, start) })
    } else {
        let (afterFirst, first) = parsePattern(ctx, p);
        if (at(afterFirst, ")")) {
            (advance(afterFirst), first)
        } else {
            let (afterRest, elements) = tuplePatternRest(ctx, afterFirst, [first]);
            let closed = expectClose(ctx, afterRest, ")", "tuple pattern");
            (
                closed,
                Pattern { kind: .Tuple(elements), origin: originFrom(closed, start) },
            )
        }
    }
}

fn tuplePatternRest<C: Allocator>(ctx: C, p: P, acc: [Pattern]): (P, [Pattern]) {
    let (q, more) = moreElements(ctx, p, ")", "a tuple-pattern element", startsPattern);
    if (more == false || at(q, ")")) {
        (q, acc)
    } else {
        let (afterOne, one) = parsePattern(ctx, q);
        tuplePatternRest(ctx, afterOne, acc.push(ctx, one))
    }
}

// -----------------------------------------------------------------------------
// What a literal says
// -----------------------------------------------------------------------------

/// An integer literal as a node: the number where the digits are plain decimal
/// and fit an `Int`, and the spelling where they are not.
///
/// The test is exact rather than approximate — the number is rendered back and
/// compared with what was written — so `0xff`, `1_000` and `18446744073709551615`
/// all keep the text a reader wrote, and nothing silently becomes `255`.
fn intKind<C: Allocator>(ctx: C, text: Str): ExprKind {
    let value = intOf(ctx, text);
    if (str.fromInt(ctx, value) == text) { .Int(value) } else { .WideInt(text) }
}

/// The digits of an integer literal, whatever radix it was written in. Answers
/// zero for one that does not fit, which is why [`intKind`] asks first.
fn intOf<C: Allocator>(ctx: C, text: Str): Int {
    intValue(ctx, text).withDefault(0)
}

/// The digits of an integer literal, or nothing for one that does not fit.
fn intValue<C: Allocator>(ctx: C, text: Str): Option<Int> {
    let bare = text.replace(ctx, "_", "");
    let radix = if (bare.startsWith("0x")) {
        16
    } else if (bare.startsWith("0o")) {
        8
    } else if (bare.startsWith("0b")) {
        2
    } else {
        10
    };
    let digits = if (radix == 10) { bare } else { bare.slice(2, bare.length()) };
    digits.toRadix(radix)
}

fn floatOf<C: Allocator>(ctx: C, text: Str): Float {
    match (text.replace(ctx, "_", "").toFloat()) {
        .Some(x) => x,
        .None => 0.0,
    }
}

/// The characters between a string literal's quotes, unescaped.
fn literalText<C: Allocator>(ctx: C, raw: Str): Str {
    unescape(ctx, raw.slice(1, raw.length() - 1))
}

fn charLiteral<C: Allocator>(ctx: C, raw: Str): Char {
    let body = unescape(ctx, raw.slice(1, raw.length() - 1));
    match (body.charAt(0)) {
        .Some(c) => c,
        .None => ' ',
    }
}

fn unescape<C: Allocator>(ctx: C, body: Str): Str {
    str.fromChars(ctx, unescapeChars(ctx, body.chars(ctx), 0, []))
}

fn unescapeChars<C: Allocator>(ctx: C, cs: [Char], index: Int, acc: [Char]): [Char] {
    if (index >= cs.length()) {
        acc
    } else {
        let c = charAtOr(cs, index);
        if (c != '\\') {
            unescapeChars(ctx, cs, index + 1, acc.push(ctx, c))
        } else {
            let next = charAtOr(cs, index + 1);
            if (next == 'u') {
                let (close, value) = hexRun(cs, index + 3, 0);
                let named = match (escapeScalar(index + 3, close, value)) {
                    .Some(scalar) => acc.push(ctx, scalar),
                    .None => acc,
                };
                unescapeChars(ctx, cs, close + 1, named)
            } else {
                unescapeChars(ctx, cs, index + 2, acc.push(ctx, escapeOf(next)))
            }
        }
    }
}

fn charAtOr(cs: [Char], index: Int): Char {
    match (cs.get(index)) {
        .Some(c) => c,
        .None => ' ',
    }
}

fn escapeOf(c: Char): Char {
    if (c == 'n') {
        '\n'
    } else if (c == 'r') {
        '\r'
    } else if (c == 't') {
        '\t'
    } else if (c == '0') {
        '\0'
    } else {
        c
    }
}

/// Where the run of hex digits from `index` stops, and the value they spell.
/// Past `10FFFF` the value stops growing, so no run of digits overflows.
fn hexRun(cs: [Char], index: Int, value: Int): (Int, Int) {
    match (charAtOr(cs, index).toDigit(16)) {
        .Some(d) => hexRun(cs, index + 1, number.min(value * 16 + d, 0x110000)),
        .None => (index, value),
    }
}

/// The scalar a `\u{...}` escape's digits name, or `.None` where they name
/// none: no digits, a surrogate, or a value past `10FFFF`.
fn escapeScalar(start: Int, close: Int, value: Int): Option<Char> {
    if (close == start) {
        .None
    } else {
        match (value.wrapToU32().toChar()) {
            .Ok(c) => .Some(c),
            .Err(_e) => .None,
        }
    }
}

/// `acc` and an error for every escape in a token's text that the compiler
/// refuses, in its words and under the escape's own span. `at` is where
/// `cs[index]` starts in the source. Only a literal's text has a backslash in
/// it.
fn badEscapes<C: Allocator>(
    ctx: C,
    t: Token,
    cs: [Char],
    index: Int,
    at: Int,
    acc: [ParseError],
): [ParseError] {
    if (index >= cs.length()) {
        acc
    } else if (charAtOr(cs, index) != '\\') {
        badEscapes(ctx, t, cs, index + 1, at + utf8Width(charAtOr(cs, index)), acc)
    } else {
        let (end, problem) = escapeProblem(ctx, t.text, cs, index);
        let width = widthOf(cs, index, end, 0);
        let found = match (problem) {
            .Some(message) => {
                acc.push(ctx, ParseError {
                    message: message,
                    span: Span { start: at, end: at + width },
                })
            },
            .None => acc,
        };
        badEscapes(ctx, t, cs, end, at + width, found)
    }
}

/// Where the escape whose backslash is at `index` ends, and what the compiler
/// says is wrong with it, if anything.
fn escapeProblem<C: Allocator>(
    ctx: C,
    text: Str,
    cs: [Char],
    index: Int,
): (Int, Option<Str>) {
    let named = text.slice(index + 1, index + 2);
    if (named != "u") {
        if ("nrt0\\\"'$".contains(named)) {
            (index + 2, .None)
        } else {
            (index + 2, .Some(str.format(ctx, "unknown escape `\\${named}`")))
        }
    } else if (charAtOr(cs, index + 2) != '{') {
        (index + 2, .Some("`\\u` must be followed by `{`, as in `\\u{1F600}`"))
    } else {
        let (close, value) = hexRun(cs, index + 3, 0);
        if (charAtOr(cs, close) != '}') {
            (close, .Some("unterminated `\\u{...}` escape"))
        } else {
            match (escapeScalar(index + 3, close, value)) {
                .Some(_scalar) => (close + 1, .None),
                .None => {
                    let digits = text.slice(index + 3, close);
                    (
                        close + 1,
                        .Some(
                            str.format(
                                ctx,
                                "`\\u{${digits}}` is not a Unicode scalar value",
                            ),
                        ),
                    )
                },
            }
        }
    }
}

/// How many UTF-8 bytes `cs[start..stop]` takes, on top of `acc`.
fn widthOf(cs: [Char], start: Int, stop: Int, acc: Int): Int {
    if (start >= stop) {
        acc
    } else {
        widthOf(cs, start + 1, stop, acc + utf8Width(charAtOr(cs, start)))
    }
}
