//! ui/style — how a container arranges and paints what is inside it.
//!
//! A `Style` is one property or a group of them, and it is inert data.
//! Building one needs no context, no allocator and no authority (SPEC 10.5).
//! That is what lets a pure component describe its appearance and hand the
//! description to whoever renders it.
//!
//! **No property is named after a CSS declaration**: `AlignMain` and
//! `AlignCross` name the axis rather than the writing direction, so a
//! right-to-left page and a column stack mean the same thing by them. And
//! **arrangement is style while meaning is the role**, so nothing here says what
//! a region *is*. `ui/node` owns that.
//!
//! ## Two tiers, and where each one ends up
//!
//! **Static** is everything except `Computed`. The compiler evaluates it, turns
//! each distinct property value into one atomic class, and writes the classes
//! into a stylesheet that ships in the artifact. Two modules that ask for the
//! same padding get the same class and one rule. `On` (a pseudo-class) and `At`
//! (a breakpoint) live only in this tier, because neither can go in an
//! element's own style attribute. `When` puts both of its branches in the
//! stylesheet and leaves the runtime a precomputed class string to choose
//! between. **Nothing is generated at run time, ever.**
//!
//! **Computed** is the other tier: a value a signal drives — a drag or a
//! cursor-follow. It applies inline, per element, and gets
//! re-serialised on every change. It never reaches the stylesheet. Reach for the
//! static tier first.
//!
//! A style the compiler cannot evaluate — one built out of a function's
//! parameters, say — is not an error. It degrades to the same inline
//! application `Computed` gets. `On` and `At` are the exceptions: they have
//! nowhere to degrade *to*, so the compiler rejects a program that writes one
//! out of values it cannot know statically.
//!
//! ## Design tokens
//!
//! A colour may be a `Token` — a name whose value the app decides at mount.
//! `token(namespace, name)` is the constructor a package builds its own closed
//! token enum on, and the reference it holds is opaque. In the static tier a
//! token lowers to a namespaced custom property, so a class does not depend on
//! what a token turns out to be worth and switching a theme changes no class.
//! `ui/theme` is the other half.
//!
//! ## Conflict resolution
//!
//! Per property, last wins. `[.Padding(.Px(8)), .Padding(.Px(4))]` is four
//! pixels, whether the compiler resolved it or a runtime scan did — a runtime
//! scan only ever *chooses between* classes the compiler already emitted.
//!
//! Between two *different* properties that touch the same CSS declaration —
//! `Padding` and `PaddingX`, `BorderWidth` and `BorderStyle`, `Layout` and
//! `Truncate` — the declaration order of the variants below decides, because
//! the stylesheet gets written in that order and equal-specificity rules
//! resolve by position. The narrower property always comes after the broader
//! one. **The variant order is load-bearing for that reason and for one
//! more:** the JavaScript runtime reads a `Style` by its tag.

from "core/alloc" import * as alloc;
from "core/str" import * as str;
from "platform/effect" import { Allocator, Scope };
from "ui/prop" import { Prop };

/// The pairs a static style was extracted into: a conflict slot, and the name
/// of a class that is already in the stylesheet.
///
/// Its field is private, so only this module — and the compiler, which writes
/// one wherever a style folded — can mint one. That keeps `Style::Extracted`
/// unwritable: the variant is reachable, its payload is not.
export struct Classes([(Int, Str)]);

impl Classes {
    /// The pairs, in the order the compiler wrote them. Last slot wins.
    ///
    /// Reading them is not minting one: a program still cannot build a
    /// `Classes`. `ui/node`'s `describe` needs this to put the classes in a
    /// scene.
    export fn pairs(self): [(Int, Str)] {
        self.0
    }
}

/// One appearance property, or a group, a condition, or a computation over
/// them.
export enum Style {
    /// Several properties as one value. Composition, with no allocator: an array
    /// literal is fixed-size construction.
    Group([Style]),
    /// Styles that apply only while the element is in a given state — hovered,
    /// focused, pressed. A pseudo-class in the stylesheet, so it costs nothing
    /// at run time and a mouse move writes no signal.
    ///
    /// Statically known or rejected: `:hover` has no inline form.
    ///
    /// One state at a time. An `On` inside an `On` keeps the innermost, because
    /// this vocabulary has no way to name two pseudo-classes at once. An `On`
    /// inside an `At` is both, and that is the useful nesting.
    On(State, [Style]),
    /// Styles that apply only from a given screen width upwards. Mobile-first: a
    /// larger breakpoint overrides a smaller one, and the styles outside any `At`
    /// belong to the smallest screen.
    ///
    /// Statically known or rejected: a media query has no inline form. `When`
    /// inside `At` is fine; `Computed` inside it is not.
    At(Screen, [Style]),
    /// One of two style lists, chosen by something that can change. Both lists
    /// get extracted into the stylesheet, and the runtime swaps between two
    /// precomputed class strings.
    When(Prop<Bool>, [Style], [Style]),
    /// Styles derived from whatever the closure reads. Applied inline and
    /// re-serialised on every change, never in the stylesheet, so it is the last
    /// resort rather than the first.
    Computed(fn(Scope) => [Style]),
    /// **Compiler-produced, and the one variant a program cannot write.** Holds
    /// the pairs a static style was extracted into: a conflict slot, and the name
    /// of a class that is already in the stylesheet. Last slot wins.
    ///
    /// Its payload is a `Classes`, whose field is private, so a class name
    /// reaches an element only by having been emitted.
    Extracted(Classes),

    /// How this container arranges its children.
    Layout(Layout),
    /// Where the children sit along the axis the layout runs along.
    AlignMain(Align),
    /// Where the children sit across that axis. The three distributions —
    /// `SpaceBetween`, `SpaceAround`, `SpaceEvenly` — have no cross-axis
    /// meaning and resolve to `Stretch`, the way a browser drops the invalid
    /// declaration and falls back to it.
    AlignCross(Align),
    /// Where this child sits across its parent's main axis, overriding the
    /// parent's `AlignCross` for it alone. A distribution resolves to
    /// `Stretch`, as it does for `AlignCross`.
    AlignSelf(Align),
    /// Whether children that do not fit start a new line.
    Wrap(Bool),
    /// Which way this container scrolls when its content is larger than it is.
    Scroll(Axis),
    /// How much of the leftover space along the main axis this child takes,
    /// relative to its siblings. `0` is "none of it".
    Grow(Int),
    /// How much this child gives up when there is not enough room, relative to
    /// its siblings. `0` is "none of it", which is how a sidebar keeps its width.
    Shrink(Int),
    /// How many grid tracks this child covers.
    Span(Int),
    /// Fixes one edge of a child at a distance, taking it out of the flow. Two
    /// `Pin`s naming different edges compose. The distance is measured from the
    /// nearest ancestor with a `Position`, or from the page.
    ///
    /// A pin is all an element needs to leave the flow, and a `Position` beside
    /// it wins: `.Position(.PinViewport)` with four pins is an overlay held to
    /// the viewport's edges.
    Pin(Edge, Length),
    /// How this element relates to the flow — and, declared after `Pin` so it
    /// wins, what a pinned child gets measured against.
    Position(Position),

    /// The space between children, both ways.
    Gap(Length),
    /// The space between children along the text direction.
    GapX(Length),
    /// The space between children down the page.
    GapY(Length),
    /// Space inside every edge.
    Padding(Length),
    /// Space inside the two edges the text direction runs along.
    PaddingX(Length),
    /// Space inside the top and bottom edges.
    PaddingY(Length),
    /// Space inside one edge. Two `PaddingEdge`s naming different edges
    /// compose.
    PaddingEdge(Edge, Length),

    /// How wide.
    Width(Length),
    /// How tall.
    Height(Length),
    /// No narrower than this.
    MinWidth(Length),
    /// No wider than this.
    MaxWidth(Length),
    /// No shorter than this.
    MinHeight(Length),
    /// No taller than this.
    MaxHeight(Length),
    /// Width divided by height, for an element that should keep its proportions
    /// as it resizes. `1.0` is a square.
    AspectRatio(Float),

    /// What is painted behind the content.
    Background(Color),
    /// What the text is painted in.
    Foreground(Color),
    /// How thick the border is. A width on its own draws a solid border,
    /// because a border nobody can see is not what asking for one means.
    /// `BorderStyle` is declared after it and overrides that.
    BorderWidth(Length),
    /// How thick the border is on one edge. A row's rule, a submenu's guide
    /// line, a divider under a header: one edge of a box rather than a box of
    /// its own. Two `BorderEdge`s naming different edges compose, and each
    /// draws a solid line the way `BorderWidth` does.
    ///
    /// `BorderColor` stays whole-box: a border painted two colours is a
    /// picture, not a property.
    BorderEdge(Edge, Length),
    /// What colour the border is. A border with no colour draws in the
    /// foreground colour, which is what every other toolkit does.
    BorderColor(Color),
    /// What the border is drawn like.
    BorderStyle(BorderStyle),
    /// How rounded the corners are. A `Full` is a pill on any box, the way
    /// Tailwind's `rounded-full` is. A `Percent` is a share of the width across
    /// and of the height down, so a percentage on a box wider than it is tall
    /// rounds to an ellipse rather than a circle.
    Radius(Length),
    /// How rounded one corner is. Two `RadiusCorner`s naming different corners
    /// compose, which is how a caller that knows where a child sits — the
    /// middle button of a joined group — squares the side that meets its
    /// neighbour.
    RadiusCorner(Corner, Length),
    /// How opaque the whole element is, `0.0` to `1.0`, content included.
    Opacity(Float),
    /// A shadow cast by this element.
    Shadow(Shadow),
    /// Several shadows at once, the first written painted over the ones after
    /// it. Every elevation worth having is two layers — a wide soft one, and a
    /// tight one that keeps the near edge crisp — and a focus ring is a third
    /// beside them.
    ///
    /// It shares `Shadow`'s conflict slot, so the last of the two written is
    /// the element's shadow and the other is gone. Reach for `Shadow` when
    /// there is one layer.
    Shadows([Shadow]),

    /// Which family the text is set in.
    FontFamily(FontFamily),
    /// How large the text is.
    FontSize(Length),
    /// How heavy the text is.
    FontWeight(Weight),
    /// Whether the text slants.
    Italic(Bool),
    /// The distance between baselines, as a multiple of the text size. `1.5` is
    /// the usual body setting.
    LineHeight(Float),
    /// Extra space between letters. Negative tightens.
    LetterSpacing(Length),
    /// Where the text sits in its line box. The three `Space*` distributions and
    /// `Stretch` all mean *justified*, which is the nearest thing text has to
    /// distributing leftover room.
    TextAlign(Align),
    /// Whether the text is re-cased for display. The text itself does not
    /// change, so what a reader copies out and what a screen reader announces
    /// are what was written.
    TextCase(TextCase),
    /// A line drawn through or under the text.
    TextLine(TextLine),
    /// How the text breaks across lines.
    TextWrap(TextWrap),
    /// Show at most this many lines and end the last one with an ellipsis. Zero
    /// means no limit.
    Truncate(Int),

    /// What the pointer looks like over this element.
    Cursor(Cursor),

    /// What marks each item of a list region. Nothing marks one unless this
    /// asks for it — the role is what a reader is told, and a browser's disc
    /// is styling nobody asked for. A mark hangs outside the item, so give the
    /// list `PaddingEdge(.Start, ...)` and the marks sit in it.
    ListMarker(ListMarker),

    /// How far past one of its parent's edges a child reaches.
    ///
    /// The container still owns the space between its children — this is the
    /// way *out* of the box one put a child in, and the only one. A hairline
    /// that runs from edge to edge of a padded menu asks for `.Bleed(.Start,
    /// space)` and `.Bleed(.End, space)`; an avatar laid over the one before it
    /// asks for `.Bleed(.Start, ...)` on every avatar but the first.
    ///
    /// The length is a distance outwards, so `.Bleed(.Start, .Px(8))` starts
    /// eight pixels before its parent's content does and overlaps whatever is
    /// there. Two `Bleed`s naming different edges compose. `.Auto` and a
    /// negative length bleed nothing: inward is a margin, and a margin is what
    /// this vocabulary leaves to the container.
    ///
    /// Declared down here because it is the only property that writes a margin,
    /// so there is nothing for its position in the sheet to resolve against.
    Bleed(Edge, Length),

    /// Shifts this element after it has been laid out: along the text
    /// direction first, then down the page. Nothing around it moves, which is
    /// what a press wants — `On(.Active, [.Translate(.Px(0), .Px(1))])` is the
    /// pixel every button in a design system sinks by, and a padding would
    /// reflow the row instead. A percentage is of the element's own size.
    ///
    /// Down here for `Bleed`'s reason: it is the only property that writes a
    /// transform, so its position in the sheet resolves nothing either.
    Translate(Length, Length),

    /// Whether content outside this element's box is painted.
    ///
    /// `.Clip(true)` cuts a child to its parent's box, corners included, which
    /// is how a card holds a full-bleed picture without the picture squaring
    /// the card's radius off. Nothing here becomes scrollable: `Scroll` is the
    /// property that says content can be reached by scrolling to it, and this
    /// one says it is not painted at all.
    ///
    /// Declared after `Scroll`, which writes the same declaration, so an
    /// element carrying both gets this one's answer — `.Clip(false)` included,
    /// which paints the overflow a `Scroll` beside it asked to cut.
    Clip(Bool),

    /// Whether the pointer passes through this element to whatever is behind
    /// it.
    ///
    /// It follows the platform's own inheritance: a subtree opts out and a
    /// child opts back in. A toaster dock pinned across the viewport asks for
    /// `.Passthrough(true)` so the page under it still answers a press, and
    /// each toast in it asks for `.Passthrough(false)`. An icon inside a button
    /// asks for `.Passthrough(true)` so the press lands on the button rather
    /// than on the glyph.
    ///
    /// What the pointer *looks* like is `Cursor`, which is a different
    /// question: an element can refuse the pointer and still name a cursor,
    /// and the cursor is then whatever is behind it.
    Passthrough(Bool),

    /// How far the page behind this element is blurred, so a modal scrim
    /// separates its panel from the page by softening it rather than by hiding
    /// it under a heavy wash. A tenth of black over a blurred page is the
    /// separation a dialog wants; a half of black over a sharp one is the
    /// heavier thing a scrim reaches for without this.
    ///
    /// It is `backdrop-filter: blur()`: only what is already painted behind the
    /// box is blurred, and the box's own background and content paint over the
    /// blur untouched. Blur is the whole of it — a backdrop that also shifts
    /// hue or drops saturation is a picture, not a property, so there is no
    /// general filter here.
    ///
    /// The length is the blur radius, so `.Px(0)` blurs nothing. A length that
    /// follows the reader — `.Rem` or `.Em` — makes a radius that grows with
    /// the text; `.Percent`, `.Auto` and `.Full` name no radius a blur can use.
    BackdropBlur(Length),

    /// What the text insertion caret is painted in.
    ///
    /// On its own the caret is whatever `Foreground` is, because the web's
    /// `caret-color` defaults to the text colour — so a field whose text is
    /// `.Transparent`, which is how a syntax-highlighted mirror is drawn under
    /// an `<input>`, has a transparent, invisible caret. This names the caret
    /// on its own, so the text can go transparent and the caret stay visible.
    /// A `Token` like every other colour here.
    CaretColor(Color),

    /// Hidden from sight, kept in the tree. The element paints nothing and
    /// takes no space, but stays where it was written, so its text still
    /// counts towards the accessible name of what holds it. This is the
    /// "sr-only" technique: a caption a structure editor pins outside its
    /// scroll box can be silenced for a reader who sees the layout while it
    /// still names the field for one who does not, without drawing a second
    /// copy over the page (#188).
    ///
    /// The mirror image of `Passthrough`, which opts an element out of the
    /// pointer while it stays in sight; this opts it out of sight while it
    /// stays in the tree.
    VisuallyHidden,

    /// How this element moves, forever. A loading placeholder pulses and a
    /// busy indicator spins:
    ///
    /// ```buri
    /// from "ui/node" import * as ui;
    /// from "ui/node" import { Node };
    ///
    /// export fn spinner<C>(): Node<C> {
    ///     ui.progress({
    ///         label: .Const("Loading"),
    ///         styles: [.Width(.Px(20)), .Height(.Px(20)), .Animation(.Spin)],
    ///     })
    /// }
    /// ```
    ///
    /// Meaning stays with the node: a spinner is an indeterminate `progress`,
    /// and the animation is only how it is drawn.
    ///
    /// When the platform's reduce-motion setting is on, the element is drawn
    /// still. A snapshot draws it still too. Each variant is a fixed class and
    /// a fixed set of keyframes in the stylesheet, so nothing runs per frame in
    /// the program, and `Computed` is the wrong tool for a loop that never ends.
    ///
    /// The set is closed. A variant is added when a component needs one.
    Animation(Animation),
}

/// How an element moves. Each one runs forever.
export enum Animation {
    /// Fades out to half and back, every two seconds.
    Pulse,
    /// Turns a full circle, every second.
    Spin,
}

/// How a container arranges its children.
///
/// `Column` is the default, because a document is a column: a container with
/// no `Layout` stacks its children downwards.
export enum Layout {
    /// Children run down the page.
    Column,
    /// Children run along it.
    Row,
    /// Children run down the page, painted last to first. The order stays the
    /// caller's — it is what a screen reader and the tab ring read — and only
    /// the paint reverses.
    ColumnReverse,
    /// Children run along the page, painted last to first, on the same terms.
    RowReverse,
    /// Children fill named columns, left to right, wrapping into rows.
    Grid([Track]),
    /// Children share one space, later ones over earlier ones. There is no
    /// depth number to get wrong: they stack in the order you write them.
    Layers,
}

/// One column of a `Grid`.
export enum Track {
    /// A share of the leftover room. Two `Fraction(1)`s split it evenly; a
    /// `Fraction(2)` beside a `Fraction(1)` takes twice as much.
    Fraction(Int),
    /// Exactly this wide.
    Fixed(Length),
    /// As wide as its content needs.
    Auto,
}

/// A distance.
export enum Length {
    /// Device-independent pixels.
    Px(Int),
    /// Multiples of the root text size, so it follows a reader who has made
    /// text larger.
    Rem(Float),
    /// Multiples of *this element's* text size, so it follows whatever the
    /// element is set at rather than the root. Tracking is the reason it
    /// exists: tracking that does not scale with the text is the wrong
    /// tracking at every other size.
    Em(Float),
    /// A fraction of the containing space, as a percentage.
    Percent(Float),
    /// Whatever the content needs.
    Auto,
    /// All of the containing space.
    Full,
}

/// A colour.
export enum Color {
    /// Red, green and blue, each 0-255.
    Rgb(Int, Int, Int),
    /// Red, green and blue, and how opaque, 0.0 to 1.0.
    Rgba(Int, Int, Int, Float),
    /// One package's design token: a name whose value the app decides at mount.
    ///
    /// A token in the static tier is a custom property — `var(--cardlib-surface)`
    /// — so an element carries the same class whatever the token turns out to
    /// be worth, and switching a theme changes no class at all. A `Theme`
    /// (`ui/theme`) says what each name resolves to.
    Token(TokenReference),
    /// Nothing is painted, and whatever is behind shows through.
    Transparent,
    /// Whatever the containing element uses.
    Inherit,
    /// A design token at a fraction of its opacity, which is what `alpha`
    /// answers for a token.
    ///
    /// Nothing knows what a token is worth until a theme is installed, so the
    /// fade cannot be done here: it lowers to `color-mix(in srgb,
    /// var(--pkg-name) 50%, transparent)` and the token stays a token. It is
    /// **last** in this enum because the order is the tag the runtime reads,
    /// and the five above it were already numbered.
    Faded(TokenReference, Float),
}

impl Color {
    /// The same colour, at `a` of its opacity — `0.0` is invisible and `1.0`
    /// is unchanged.
    ///
    /// ```buri
    /// from "ui/style" import * as style;
    /// from "ui/style" import { Style };
    ///
    /// export let halo: Style = .BorderColor(style.token("ui", "ring").alpha(0.5));
    /// ```
    ///
    /// A colour written out fades to a plain `Rgba`, because its channels are
    /// known. A token cannot be blended until a theme says what it is worth,
    /// so it stays a token inside a `color-mix` and follows the theme the way
    /// every other `var()` does — which is what saves a design system from
    /// minting `--ring-soft` beside `--ring` and hand-blending the pair in
    /// every theme.
    ///
    /// `Transparent` and `Inherit` answer themselves. Neither names a colour
    /// there is anything to fade.
    ///
    /// The fraction is `0.0` to `1.0`, and the extractor refuses anything else
    /// (`alpha-out-of-range`).
    export fn alpha(self, a: Float): Color {
        match (self) {
            .Rgb(r, g, b) => .Rgba(r, g, b, a),
            .Rgba(r, g, b, _was) => .Rgba(r, g, b, a),
            .Token(reference) => .Faded(reference, a),
            .Faded(reference, _was) => .Faded(reference, a),
            .Transparent => .Transparent,
            .Inherit => .Inherit,
        }
    }
}

/// An opaque name for one package's design token: the package it belongs to,
/// and the token's own name inside that package.
///
/// Its fields are private, so `token` below is the only way to make one and a
/// `Theme` is the only way to say what one is worth. A library styles itself
/// against its own closed enum, and only a reference crosses the boundary.
export struct TokenReference(Str, Str);

impl TokenReference {
    /// The package the token belongs to.
    ///
    /// With `name` below, this is the custom property `--namespace-name`.
    export fn namespace(self): Str {
        self.0
    }

    /// The token's own name inside that package.
    export fn name(self): Str {
        self.1
    }
}

/// The colour a design token names.
///
/// This is the constructor a package builds its token vocabulary on. A package
/// declares `enum Token { Surface, OnSurface }` and an `impl Token` whose
/// `color` answers `style.token("cardlib", "surface")` for each variant.
///
/// `namespace` is the package the token belongs to and `name` is its own name.
/// Together they become the custom property `--namespace-name`, so a library's
/// tokens can never collide with an app's. Keep both to plain letters and
/// digits: a name with anything else still works, but the class the compiler
/// derives from it falls back to a digest.
export fn token(namespace: Str, name: Str): Color {
    .Token(TokenReference(namespace, name))
}

/// Where something sits along an axis.
///
/// The three `Space*` values distribute the *leftover* room between children
/// and mean nothing for a single one.
export enum Align {
    /// Where the axis begins.
    Start,
    /// The middle.
    Center,
    /// Where the axis ends.
    End,
    /// Filling the axis.
    Stretch,
    /// The leftover room divided between the children, none at either end.
    SpaceBetween,
    /// The leftover room divided around the children, half of a share at each
    /// end.
    SpaceAround,
    /// The leftover room divided evenly, including at the ends.
    SpaceEvenly,
}

/// One direction, or both.
export enum Axis {
    /// The direction the text runs.
    X,
    /// Down the page.
    Y,
    /// Both of them.
    Both,
}

/// One edge of a box, named by where it is in the reading order rather than by
/// where it is on the screen, so a right-to-left page comes out right by
/// construction.
export enum Edge {
    /// The top.
    Top,
    /// The bottom.
    Bottom,
    /// Where the text begins: the left edge in English, the right in Arabic.
    Start,
    /// Where the text ends.
    End,
}

/// One corner of a box, named by the two edges that meet at it, in the reading
/// order rather than on the screen, so a right-to-left page comes out right by
/// construction.
export enum Corner {
    /// Where the top meets the start of the text.
    TopStart,
    /// Where the top meets the end.
    TopEnd,
    /// Where the bottom meets the start.
    BottomStart,
    /// Where the bottom meets the end.
    BottomEnd,
}

/// A screen size, from this width upwards.
///
/// Closed names rather than numbers, so a library's breakpoints and an app's
/// are the same four and compose. The widths are 40, 48, 64 and 80 rem, which
/// follow the reader's text size rather than the device's pixels.
export enum Screen {
    /// From 40rem up — a large phone held sideways, and everything above it.
    Small,
    /// From 48rem up — a tablet.
    Medium,
    /// From 64rem up — a laptop.
    Large,
    /// From 80rem up — a desktop display.
    ExtraLarge,
}

/// A state an element can be in, which the platform tracks so a program does
/// not have to.
///
/// This is why hover is not an event. A pseudo-class costs nothing, survives
/// into an email's `<style>` block, and maps to a native pressed or focused
/// trait.
export enum State {
    /// A pointer is over it.
    Hover,
    /// It has the keyboard's attention, and the platform judged that showing so
    /// is useful — `:focus-visible`, so a mouse press draws no focus ring.
    Focus,
    /// Something inside it has the keyboard. What an input group is: the
    /// wrapper owns the hairline and the ring, and the control inside it is
    /// bare. A container is never itself focus-visible, so `Focus` is no
    /// substitute.
    FocusWithin,
    /// It is being pressed right now.
    Active,
    /// It refuses input.
    Disabled,
    /// It is a toggle and it is on.
    Checked,
    /// It is failing validation. A `field` and a `toggle` take an `invalid`
    /// that puts them in it, and that is the only way in: the platform is told
    /// as well as shown, so a reader hears "invalid" and sees the ring.
    Invalid,
}

/// How an element relates to the flow of the page.
export enum Position {
    /// In the flow, and the origin anything pinned inside it is measured from.
    Flow,
    /// In the flow until it would scroll out of view, and then held at the edge.
    Sticky,
    /// Out of the flow and fixed to the viewport, so scrolling does not move it.
    PinViewport,
    /// Out of every ancestor's clip, but placed against the nearest `Flow`
    /// ancestor the way a `Pin` is — so a panel pinned to a trigger inside a
    /// `Scroll` box or a dialog hangs below the trigger rather than being cut
    /// off at the scroller's edge. This is the escape hatch a `select`,
    /// combobox or menu wants: `PinViewport` leaves the clip too, but sticks to
    /// the viewport and cannot come back against its trigger.
    PinAnchor,
}

/// How heavy text is.
///
/// Named rather than numeric, because a name is what a font family actually
/// has.
export enum Weight {
    /// Body text.
    Regular,
    /// A little heavier than body text.
    Medium,
    /// Heavier again — the usual weight for a heading.
    Semibold,
    /// The heaviest of the four.
    Bold,
}

/// Which kind of letterform.
///
/// The three unnamed families resolve to whatever the platform's own interface
/// font is, so an app that names none of them looks native everywhere.
export enum FontFamily {
    /// The platform's interface face.
    Sans,
    /// A face with serifs, for long reading.
    Serif,
    /// A fixed-pitch face, for code and figures that must line up.
    Mono,
    /// A face by name, with the matching generic family behind it.
    Named(Str),
}

/// What a border is drawn like.
export enum BorderStyle {
    /// No border at all, whatever its width.
    None,
    /// One unbroken line.
    Solid,
    /// A broken line.
    Dashed,
}

/// Whether text is re-cased for display.
export enum TextCase {
    /// However it was written.
    AsWritten,
    /// ALL CAPITALS.
    Upper,
    /// all lower case.
    Lower,
    /// The First Letter Of Each Word.
    Capitalize,
}

/// A line drawn through or under text.
export enum TextLine {
    /// None.
    None,
    /// Underlined.
    Underline,
    /// Struck through.
    Strike,
}

/// How text breaks across lines.
export enum TextWrap {
    /// Wherever it has to.
    Wrap,
    /// Never — it overflows instead.
    NoWrap,
    /// Wherever it has to, with the line lengths evened out. For headings.
    Balance,
}

/// What the pointer looks like.
export enum Cursor {
    /// Whatever the platform would have chosen.
    Default,
    /// Something to press.
    Pointer,
    /// Something to select.
    Text,
    /// Something that would refuse.
    NotAllowed,
}

/// What marks each item of a list.
///
/// A list region is a list because of its role, and a role paints nothing. The
/// stylesheet clears the browser's own marker and indent from every list, so
/// this is how a list that wants marks asks for them.
export enum ListMarker {
    /// Nothing at all. What a navigation rail, a menu and a tab strip want.
    None,
    /// A filled disc.
    Disc,
    /// 1., 2., 3., counting the items in order.
    Decimal,
}

/// A shadow cast by an element.
///
/// It is painted outside the element's box, never under it, whatever its
/// offset, blur and spread: a spread with no blur is a ring around the element
/// rather than a slab behind it, and a blurred offset is a fringe below a
/// transparent element rather than a wash across it.
export struct Shadow {
    /// How far along the text direction the shadow is offset.
    export x: Length,
    /// How far down the page.
    export y: Length,
    /// How far the edge is softened.
    export blur: Length,
    /// How much larger than the element the shadow grows before the blur.
    export spread: Length,
    /// What colour it is.
    export color: Color,
}

// ---------------------------------------------------------------------------
// Classes at run time
// ---------------------------------------------------------------------------

/// What a style, or a list of them, comes to here.
enum Found {
    /// Its classes, the last per slot winning, each one the stylesheet holds.
    Classes([(Int, Str)]),
    /// A name the stylesheet holds no class for.
    Missing(Str),
    /// Not settled yet: a `When`, a `Computed`, or classes already.
    Dynamic,
}

/// `styles` as the stylesheet's classes for them.
///
/// The compiler wraps a node's styles in this where the node is handed a
/// parameter, a field or a result rather than a literal, so that every other
/// reader of the value sees the variant the source wrote. It names each class
/// the way the compiler does, and `known` pairs every name a value reaching
/// here can have with the class the sheet holds for it. A name is the class
/// itself, except where the class ends in a digest: then the name holds the
/// text that was digested.
///
/// A list whose names are not all known keeps each part that is, and the rest
/// stays a value the runtime writes inline. `strict` says the compiler saw
/// every value that can reach here, which `unextracted` checks in a test build.
fn classify(styles: [Style], known: [(Str, Str)], strict: Bool): [Style] {
    classifyList(alloc.generalPurpose(), styles, known, strict, -1, -1)
}

/// `classify` for one `Style`.
fn classifyStyle(style: Style, known: [(Str, Str)], strict: Bool): Style {
    classifyOne(alloc.generalPurpose(), style, known, strict, -1, -1)
}

/// Stops a test build whose compiler left a style it saw out of the sheet.
fn unextracted(strict: Bool, name: Str): ();

fn classifyList<C: Allocator>(
    ctx: C,
    styles: [Style],
    known: [(Str, Str)],
    strict: Bool,
    state: Int,
    screen: Int,
): [Style] {
    match (found(ctx, styles, known, state, screen)) {
        .Classes(pairs) => {
            match (pairs.isEmpty()) {
                true => [],
                false => [.Extracted(Classes(pairs))],
            }
        },
        .Missing(name) => {
            let _ = unextracted(strict, name);
            styles.mapCtx(ctx, fn(c, s) => {
                classifyOne(c, s, known, strict, state, screen)
            })
        },
        .Dynamic => {
            styles.mapCtx(ctx, fn(c, s) => {
                classifyOne(c, s, known, strict, state, screen)
            })
        },
    }
}

fn classifyOne<C: Allocator>(
    ctx: C,
    style: Style,
    known: [(Str, Str)],
    strict: Bool,
    state: Int,
    screen: Int,
): Style {
    match (found(ctx, [style], known, state, screen)) {
        .Classes(pairs) => .Extracted(Classes(pairs)),
        .Missing(name) => {
            let _ = unextracted(strict, name);
            within(ctx, style, known, strict, state, screen)
        },
        .Dynamic => within(ctx, style, known, strict, state, screen),
    }
}

/// A style that is not classes whole, with each part that is made classes. A
/// condition goes into the classes of what it holds, as the compiler puts it.
fn within<C: Allocator>(
    ctx: C,
    style: Style,
    known: [(Str, Str)],
    strict: Bool,
    state: Int,
    screen: Int,
): Style {
    match (style) {
        .Group(items) => .Group(classifyList(ctx, items, known, strict, state, screen)),
        .On(on, items) => {
            .Group(classifyList(ctx, items, known, strict, stateIndex(on), screen))
        },
        .At(at, items) => {
            .Group(classifyList(ctx, items, known, strict, state, screenIndex(at)))
        },
        .When(condition, then, otherwise) => {
            .When(
                condition,
                classifyList(ctx, then, known, strict, state, screen),
                classifyList(ctx, otherwise, known, strict, state, screen),
            )
        },
        .Computed(build) => {
            .Computed(fn(scope) => classify(build(scope), known, strict))
        },
        other => other,
    }
}

fn found<C: Allocator>(
    ctx: C,
    styles: [Style],
    known: [(Str, Str)],
    state: Int,
    screen: Int,
): Found {
    match (atomsIn(ctx, styles, state, screen, .Some([]))) {
        .None => .Dynamic,
        .Some(atoms) => {
            named(
                ctx,
                atoms.foldCtx(ctx, fn(c, out, a) => place(c, out, a), []),
                known,
                0,
                [],
            )
        },
    }
}

/// Each atom's class, or the first name the stylesheet has none for.
fn named<C: Allocator>(
    ctx: C,
    atoms: [(Int, Str)],
    known: [(Str, Str)],
    at: Int,
    acc: [(Int, Str)],
): Found {
    match (atoms.get(at)) {
        .None => .Classes(acc),
        .Some(atom) => {
            match (known.find(fn(entry) => entry.0 == atom.1)) {
                .None => .Missing(atom.1),
                .Some(entry) => {
                    named(ctx, atoms, known, at + 1, acc.push(ctx, (atom.0, entry.1)))
                },
            }
        },
    }
}

/// The last atom per slot, in the slot's first position, as the compiler
/// resolves a conflict.
fn place<C: Allocator>(ctx: C, out: [(Int, Str)], atom: (Int, Str)): [(Int, Str)] {
    match (out.findIndex(fn(o) => o.0 == atom.0)) {
        .Some(i) => out.replaceAt(ctx, i, atom),
        .None => out.push(ctx, atom),
    }
}

fn atomsIn<C: Allocator>(
    ctx: C,
    styles: [Style],
    state: Int,
    screen: Int,
    acc: Option<[(Int, Str)]>,
): Option<[(Int, Str)]> {
    styles.foldCtx(
        ctx,
        fn(c, sofar, style) => {
            sofar.andThenCtx(c, fn(inner, atoms) => {
                atomsOf(inner, style, state, screen, atoms)
            })
        },
        acc,
    )
}

/// The `(slot, name)` atoms of one style under a condition, or `.None` for
/// one that is not settled.
fn atomsOf<C: Allocator>(
    ctx: C,
    style: Style,
    state: Int,
    screen: Int,
    acc: [(Int, Str)],
): Option<[(Int, Str)]> {
    match (style) {
        .Group(items) => atomsIn(ctx, items, state, screen, .Some(acc)),
        .On(on, items) => atomsIn(ctx, items, stateIndex(on), screen, .Some(acc)),
        .At(at, items) => atomsIn(ctx, items, state, screenIndex(at), .Some(acc)),
        .When(_, _, _) => .None,
        .Computed(_) => .None,
        .Extracted(_) => .None,
        property => {
            let (variant, sub, abbreviation, key) = declared(ctx, property);
            // A pin keeps its `position` in a class of its own, ahead of its inset.
            let before = match (variant) {
                15 => acc.push(ctx, atom(ctx, 15, 4, state, screen, "pin", "out")),
                _ => acc,
            };
            .Some(
                before.push(
                    ctx,
                    atom(ctx, variant, sub, state, screen, abbreviation, key),
                ),
            )
        },
    }
}

/// One `(slot, name)`, slot and prefix as the compiler numbers and names them.
fn atom<C: Allocator>(
    ctx: C,
    variant: Int,
    sub: Int,
    state: Int,
    screen: Int,
    abbreviation: Str,
    key: Str,
): (Int, Str) {
    // `Shadows` writes the `box-shadow` `Shadow` does, so it shares the slot.
    let property = match (variant) {
        41 => 40,
        other => other,
    };
    let slot = (property * 5 + sub) * 40 + (state + 1) * 5 + screen + 1;
    let screens = match (screen) {
        0 => "sm_",
        1 => "md_",
        2 => "lg_",
        3 => "xl_",
        _ => "",
    };
    let states = match (state) {
        0 => "hover_",
        1 => "focus_",
        2 => "focuswithin_",
        3 => "active_",
        4 => "disabled_",
        5 => "checked_",
        6 => "invalid_",
        _ => "",
    };
    (slot, str.format(ctx, "${screens}${states}${abbreviation}-${key}"))
}

fn stateIndex(state: State): Int {
    match (state) {
        .Hover => 0,
        .Focus => 1,
        .FocusWithin => 2,
        .Active => 3,
        .Disabled => 4,
        .Checked => 5,
        .Invalid => 6,
    }
}

fn screenIndex(screen: Screen): Int {
    match (screen) {
        .Small => 0,
        .Medium => 1,
        .Large => 2,
        .ExtraLarge => 3,
    }
}

/// A property's variant, sub-key, abbreviation and key, as the compiler
/// declares it.
fn declared<C: Allocator>(ctx: C, style: Style): (Int, Int, Str, Str) {
    match (style) {
        .Layout(layout) => (6, 0, "lay", layoutKey(ctx, layout)),
        .AlignMain(align) => (7, 0, "am", alignKey(align)),
        .AlignCross(align) => (8, 0, "ac", crossKey(align)),
        .AlignSelf(align) => (9, 0, "as", crossKey(align)),
        .Wrap(on) => (10, 0, "wrap", choose(on, "wrap", "nowrap")),
        .Scroll(axis) => {
            (
                11,
                0,
                "scroll",
                match (axis) {
                    .X => "x",
                    .Y => "y",
                    .Both => "both",
                },
            )
        },
        .Grow(n) => (12, 0, "grow", integerKey(ctx, n)),
        .Shrink(n) => (13, 0, "shrink", integerKey(ctx, n)),
        .Span(n) => (14, 0, "span", integerKey(ctx, n)),
        .Pin(edge, length) => (15, edgeIndex(edge), "pin", edgeKey(ctx, edge, length)),
        .Position(position) => {
            (
                16,
                0,
                "pos",
                match (position) {
                    .Flow => "flow",
                    .Sticky => "sticky",
                    .PinViewport => "viewport",
                    .PinAnchor => "anchor",
                },
            )
        },
        .Gap(length) => (17, 0, "gap", lengthKey(ctx, length)),
        .GapX(length) => (18, 0, "gapx", lengthKey(ctx, length)),
        .GapY(length) => (19, 0, "gapy", lengthKey(ctx, length)),
        .Padding(length) => (20, 0, "p", lengthKey(ctx, length)),
        .PaddingX(length) => (21, 0, "px", lengthKey(ctx, length)),
        .PaddingY(length) => (22, 0, "py", lengthKey(ctx, length)),
        .PaddingEdge(edge, length) => {
            (23, edgeIndex(edge), "pe", edgeKey(ctx, edge, length))
        },
        .Width(length) => (24, 0, "w", lengthKey(ctx, length)),
        .Height(length) => (25, 0, "h", lengthKey(ctx, length)),
        .MinWidth(length) => (26, 0, "minw", lengthKey(ctx, length)),
        .MaxWidth(length) => (27, 0, "maxw", lengthKey(ctx, length)),
        .MinHeight(length) => (28, 0, "minh", lengthKey(ctx, length)),
        .MaxHeight(length) => (29, 0, "maxh", lengthKey(ctx, length)),
        .AspectRatio(ratio) => (30, 0, "ar", numberKey(ctx, ratio)),
        .Background(color) => (31, 0, "bg", colorKey(ctx, color)),
        .Foreground(color) => (32, 0, "fg", colorKey(ctx, color)),
        .BorderWidth(length) => (33, 0, "bw", lengthKey(ctx, length)),
        .BorderEdge(edge, length) => {
            (34, edgeIndex(edge), "be", edgeKey(ctx, edge, length))
        },
        .BorderColor(color) => (35, 0, "bc", colorKey(ctx, color)),
        .BorderStyle(line) => {
            (
                36,
                0,
                "bs",
                match (line) {
                    .None => "none",
                    .Solid => "solid",
                    .Dashed => "dashed",
                },
            )
        },
        .Radius(length) => (37, 0, "r", lengthKey(ctx, length)),
        .RadiusCorner(corner, length) => {
            let (index, name) = match (corner) {
                .TopStart => (0, "topstart"),
                .TopEnd => (1, "topend"),
                .BottomStart => (2, "bottomstart"),
                .BottomEnd => (3, "bottomend"),
            };
            (38, index, "rc", str.format(ctx, "${name}-${lengthKey(ctx, length)}"))
        },
        .Opacity(value) => (39, 0, "op", numberKey(ctx, value)),
        .Shadow(shadow) => (40, 0, "sh", digest(ctx, shadowCss(ctx, shadow))),
        .Shadows(layers) => {
            (
                41,
                0,
                "sh",
                digest(
                    ctx,
                    layers
                        .mapCtx(ctx, fn(c, layer) => shadowCss(c, layer))
                        .join(ctx, ","),
                ),
            )
        },
        .FontFamily(family) => {
            (
                42,
                0,
                "ff",
                digest(ctx, match (family) {
                    .Sans => "ui-sans-serif,system-ui,sans-serif",
                    .Serif => "ui-serif,Georgia,serif",
                    .Mono => "ui-monospace,SFMono-Regular,monospace",
                    .Named(name) => {
                        str.format(ctx, "\"${name}\",ui-sans-serif,sans-serif")
                    },
                }),
            )
        },
        .FontSize(length) => (43, 0, "fs", lengthKey(ctx, length)),
        .FontWeight(weight) => {
            (
                44,
                0,
                "fw",
                match (weight) {
                    .Regular => "regular",
                    .Medium => "medium",
                    .Semibold => "semibold",
                    .Bold => "bold",
                },
            )
        },
        .Italic(on) => (45, 0, "it", choose(on, "italic", "normal")),
        .LineHeight(value) => (46, 0, "lh", numberKey(ctx, value)),
        .LetterSpacing(length) => (47, 0, "ls", lengthKey(ctx, length)),
        .TextAlign(align) => (48, 0, "ta", alignKey(align)),
        .TextCase(case) => {
            (
                49,
                0,
                "tc",
                match (case) {
                    .AsWritten => "aswritten",
                    .Upper => "upper",
                    .Lower => "lower",
                    .Capitalize => "capitalize",
                },
            )
        },
        .TextLine(line) => {
            (
                50,
                0,
                "tl",
                match (line) {
                    .None => "none",
                    .Underline => "underline",
                    .Strike => "strike",
                },
            )
        },
        .TextWrap(wrap) => {
            (
                51,
                0,
                "tw",
                match (wrap) {
                    .Wrap => "wrap",
                    .NoWrap => "nowrap",
                    .Balance => "balance",
                },
            )
        },
        .Truncate(lines) => {
            (
                52,
                0,
                "trunc",
                match (lines > 0) {
                    true => integerKey(ctx, lines),
                    false => "0",
                },
            )
        },
        .Cursor(cursor) => {
            (
                53,
                0,
                "cur",
                match (cursor) {
                    .Default => "default",
                    .Pointer => "pointer",
                    .Text => "text",
                    .NotAllowed => "notallowed",
                },
            )
        },
        .ListMarker(marker) => {
            (
                54,
                0,
                "lm",
                match (marker) {
                    .None => "none",
                    .Disc => "disc",
                    .Decimal => "decimal",
                },
            )
        },
        .Bleed(edge, length) => {
            (55, edgeIndex(edge), "bleed", edgeKey(ctx, edge, length))
        },
        .Translate(x, y) => {
            (56, 0, "tr", str.format(ctx, "${lengthKey(ctx, x)}-${lengthKey(ctx, y)}"))
        },
        .Clip(on) => (57, 0, "clip", choose(on, "clip", "visible")),
        .Passthrough(on) => (58, 0, "pass", choose(on, "none", "auto")),
        .BackdropBlur(length) => (59, 0, "bdblur", lengthKey(ctx, length)),
        .CaretColor(color) => (60, 0, "caret", colorKey(ctx, color)),
        .VisuallyHidden => (61, 0, "vh", "on"),
        .Animation(animation) => {
            (
                62,
                0,
                "anim",
                match (animation) {
                    .Pulse => "pulse",
                    .Spin => "spin",
                },
            )
        },
        // `atomsOf` answers every composition itself.
        _ => (0, 0, "", ""),
    }
}

fn choose(on: Bool, yes: Str, no: Str): Str {
    match (on) {
        true => yes,
        false => no,
    }
}

fn layoutKey<C: Allocator>(ctx: C, layout: Layout): Str {
    match (layout) {
        .Column => "col",
        .Row => "row",
        .ColumnReverse => "colrev",
        .RowReverse => "rowrev",
        .Grid(tracks) => {
            let columns = tracks
                .mapCtx(ctx, fn(c, track) => trackCss(c, track))
                .join(ctx, " ");
            str.format(ctx, "grid-${digest(ctx, columns)}")
        },
        .Layers => "layers",
    }
}

fn trackCss<C: Allocator>(ctx: C, track: Track): Str {
    match (track) {
        .Fraction(n) => str.format(ctx, "${str.fromInt(ctx, n)}fr"),
        .Fixed(length) => lengthCss(ctx, length),
        .Auto => "auto",
    }
}

fn alignKey(align: Align): Str {
    match (align) {
        .Start => "start",
        .Center => "center",
        .End => "end",
        .Stretch => "stretch",
        .SpaceBetween => "between",
        .SpaceAround => "around",
        .SpaceEvenly => "evenly",
    }
}

/// A distribution means nothing across the axis and lands on `stretch`.
fn crossKey(align: Align): Str {
    match (align) {
        .Start => "start",
        .Center => "center",
        .End => "end",
        _ => "stretch",
    }
}

fn edgeIndex(edge: Edge): Int {
    match (edge) {
        .Top => 0,
        .Bottom => 1,
        .Start => 2,
        .End => 3,
    }
}

fn edgeKey<C: Allocator>(ctx: C, edge: Edge, length: Length): Str {
    let name = match (edge) {
        .Top => "top",
        .Bottom => "bottom",
        .Start => "start",
        .End => "end",
    };
    str.format(ctx, "${name}-${lengthKey(ctx, length)}")
}

fn lengthKey<C: Allocator>(ctx: C, length: Length): Str {
    match (length) {
        .Px(n) => integerKey(ctx, n),
        .Rem(n) => str.format(ctx, "r${numberKey(ctx, n)}"),
        .Em(n) => str.format(ctx, "e${numberKey(ctx, n)}"),
        .Percent(n) => str.format(ctx, "pc${numberKey(ctx, n)}"),
        .Auto => "auto",
        .Full => "full",
    }
}

fn lengthCss<C: Allocator>(ctx: C, length: Length): Str {
    match (length) {
        .Px(n) => str.format(ctx, "${str.fromInt(ctx, n)}px"),
        .Rem(n) => str.format(ctx, "${number(ctx, n)}rem"),
        .Em(n) => str.format(ctx, "${number(ctx, n)}em"),
        .Percent(n) => str.format(ctx, "${number(ctx, n)}%"),
        .Auto => "auto",
        .Full => "100%",
    }
}

fn colorKey<C: Allocator>(ctx: C, color: Color): Str {
    match (color) {
        .Rgb(r, g, b) => str.format(ctx, "${hex(ctx, r)}${hex(ctx, g)}${hex(ctx, b)}"),
        .Rgba(r, g, b, a) => {
            str.format(
                ctx,
                "${hex(ctx, r)}${hex(ctx, g)}${hex(ctx, b)}a${numberKey(ctx, a)}",
            )
        },
        .Token(token) => tokenKey(ctx, token),
        .Transparent => "none",
        .Inherit => "inherit",
        .Faded(token, a) => {
            str.format(ctx, "${tokenKey(ctx, token)}a${numberKey(ctx, a)}")
        },
    }
}

fn colorCss<C: Allocator>(ctx: C, color: Color): Str {
    match (color) {
        .Rgb(r, g, b) => str.format(ctx, "rgb(${channels(ctx, r, g, b)})"),
        .Rgba(r, g, b, a) => {
            str.format(ctx, "rgba(${channels(ctx, r, g, b)},${number(ctx, a)})")
        },
        .Token(token) => str.format(ctx, "var(--${token.0}-${token.1})"),
        .Transparent => "transparent",
        .Inherit => "inherit",
        .Faded(token, a) => {
            let percent = number(ctx, a * 100.0);
            str.format(
                ctx,
                "color-mix(in srgb,var(--${token.0}-${token.1}) ${percent}%,transparent)",
            )
        },
    }
}

fn channels<C: Allocator>(ctx: C, r: Int, g: Int, b: Int): Str {
    str.format(
        ctx,
        "${str.fromInt(ctx, r)},${str.fromInt(ctx, g)},${str.fromInt(ctx, b)}",
    )
}

fn shadowCss<C: Allocator>(ctx: C, shadow: Shadow): Str {
    let offset = str.format(
        ctx,
        "${lengthCss(ctx, shadow.x)} ${lengthCss(ctx, shadow.y)}",
    );
    let size = str.format(
        ctx,
        "${lengthCss(ctx, shadow.blur)} ${lengthCss(ctx, shadow.spread)}",
    );
    str.format(ctx, "${offset} ${size} ${colorCss(ctx, shadow.color)}")
}

/// A namespace and a name of plain letters and digits name the class, and any
/// other pair is digested.
fn tokenKey<C: Allocator>(ctx: C, token: TokenReference): Str {
    match ((plain(ctx, token.0), plain(ctx, token.1))) {
        (true, true) => str.format(ctx, "t_${token.0}_${token.1}"),
        _ => {
            str.format(
                ctx,
                "t_${digest(ctx, str.format(ctx, "${token.0}\u{1}${token.1}"))}",
            )
        },
    }
}

fn plain<C: Allocator>(ctx: C, text: Str): Bool {
    match (text.isEmpty()) {
        true => false,
        false => {
            text
                .splitAny(
                    ctx,
                    "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ",
                )
                .all(fn(piece) => piece.isEmpty())
        },
    }
}

/// The name of a class that ends in a digest: the digested text, behind a `#`
/// no class holds. `known` pairs it with the class.
fn digest<C: Allocator>(ctx: C, text: Str): Str {
    str.format(ctx, "#${text}")
}

/// Two lowercase hex digits, or a name no class has for a channel out of range.
fn hex<C: Allocator>(ctx: C, n: Int): Str {
    let digits = "0123456789abcdef";
    match ((n >= 0, n < 256)) {
        (true, true) => {
            let high = digits.slice(n / 16, n / 16 + 1);
            let low = digits.slice(n % 16, n % 16 + 1);
            str.format(ctx, "${high}${low}")
        },
        _ => "?",
    }
}

fn integerKey<C: Allocator>(ctx: C, n: Int): Str {
    match (n < 0) {
        true => str.format(ctx, "n${str.fromInt(ctx, 0 - n)}"),
        false => str.fromInt(ctx, n),
    }
}

/// A float as the compiler renders one: a whole number has no `.0`.
fn number<C: Allocator>(ctx: C, n: Float): Str {
    let text = str.fromFloat(ctx, n);
    match (text.endsWith(".0")) {
        true => text.slice(0, text.length() - 2),
        false => text,
    }
}

/// A point is not legal in a class name and a minus sign reads as a range.
fn numberKey<C: Allocator>(ctx: C, n: Float): Str {
    number(ctx, n).replace(ctx, ".", "_").replace(ctx, "-", "n")
}
