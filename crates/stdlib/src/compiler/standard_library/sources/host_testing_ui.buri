//! platform/effect/testing/ui — the headless renderer `platform/effect/testing`
//! re-exports: `render`, the `Rendered` tree a test acts on, the theme it
//! paints with, and the snapshots.
//!
//! A module of its own because the renderer is most of what a compilation
//! loads through `platform/effect/testing`, which every test that takes an
//! allocator imports. A standard library module's re-export is loaded only
//! when an import names it (`compiler/modules.rs`), so a test that renders
//! nothing never loads `ui/node`. It is internal: only the standard library
//! imports it, and a test names it through `platform/effect/testing`.

from "core/alloc" import * as alloc;
from "platform/effect" import { Allocator, Ui };
from "platform/effect/testing" import { headless };

// The headless renderer's vocabulary: what a test renders, and the theme it
// paints with.
from "ui/node" import * as node;
from "ui/node" import { Builder, Node };
from "ui/style" import { State };
from "ui/theme" import * as theme;
from "ui/theme" import { Theme };

/// A tree the runtime rendered, ready to look at and act on.
///
/// Behind it is the renderer `ui/node`'s `mount` uses, pointed at a document
/// the runtime supplies rather than a browser. Which element each role became,
/// which style reached which element, what a press did, and which rows a keyed
/// list moved rather than rebuilt are all answerable here.
///
/// What only a browser does is out of reach, and needs a suite that drives a
/// real one:
///
/// - **Layout and painting.** A test asserts a style as the declaration it
///   became, not as pixels.
/// - **The browser's own dispatch.** That Enter and Space on a button produce a
///   press, that the keystroke reaching a form is Enter in one of its fields,
///   and that a press inside a label reaches the input it wraps. What `submit`
///   models is the rule that decides *whether* the keypress submits, not the
///   keypress.
/// - **The caret.** That a moved row keeps the caret. What a test asserts here
///   is the identity that makes it possible. The focus is in reach: `focus`,
///   `tab`, `key` and `focused` move it and read it the way a reader does.
/// - **What assistive technology announces**, past what `spoken` and
///   `isCurrent` answer. A test asserts a role as the element it became.
export struct Rendered(I64);

/// Renders `root` into a document of its own.
///
/// The tree's handlers get this context, exactly as `mount` hands over the
/// context its caller passed.
///
/// The walk `renderInto` is `render`'s and not `mount`'s: `mount` is the one
/// half that differs between backends — the JavaScript renderer builds its
/// document double and drops the walk, the native one drives it into the
/// element arena — so the destructuring of the tree is handed to it as a
/// closure rather than baked into either.
export fn render<C: Ui>(ctx: C, root: Node<C>): Rendered {
    Rendered(mount(ctx, root, node.renderInto))
}

/// `render`'s per-backend half: build the document and answer the handle a
/// `Rendered` carries.
///
/// The context is dropped — the runtime allocates for itself — `root` crosses
/// by reference to the one `Node` the walk destructures, and `walk` crosses as
/// the closure `render` handed over, which the native side invokes once and the
/// JavaScript side ignores.
fn mount<C: Ui>(ctx: C, root: Node<C>, walk: fn(C, Builder, Node<C>) => ()): I64;

impl Rendered {
    /// The tree as markup: elements, their attributes, their styles and their
    /// text, in order.
    ///
    /// An element a reader hears by a name ends in a `label:` declaration
    /// holding it: a button's or a file picker's label, an image's or a
    /// drawing's alt, a labelled stack's, picker's, dialog's or progress bar's
    /// label. A labelled shape's name is an `aria-label` in its drawing's
    /// artwork.
    ///
    /// It leaves out the runtime's own bookkeeping, the markers it puts around
    /// a region that can change.
    export fn markup(self): Str;

    /// Every run of text in the tree, in order, separated by a space.
    export fn text(self): Str;

    /// What a screen reader reads, in order, separated by a space: each
    /// element's name, where `markup` writes it, and each run of text, without
    /// what an `isDecorative` stack, a decorative image or a decorative
    /// drawing hides.
    ///
    /// A container's name comes before what is in it, so a labelled
    /// navigation holding "Home" reads "Primary Home". A button's name stands
    /// in for what it draws, as a browser reads it: an icon-only button reads
    /// its label, and a button that draws its label reads it once.
    export fn spoken(self): Str;

    /// Whether the element named `name` is announced as the current page — a
    /// `button`, a `link` or a `stack` whose `isCurrent` holds.
    ///
    /// An element's name is its label, or else its text, the way `pointerDown`
    /// names one. Aborts when no element has that name.
    export fn isCurrent(self, name: Str): Bool;

    /// The description a reader hears with the element named `name`: the text
    /// of the `tooltip` around it, whether or not its bubble is showing, and
    /// `""` for an element in none. Aborts when no element has that name.
    export fn description(self, name: Str): Str;

    /// Moves the focus to the element named `name`, the way a reader clicking
    /// it does. A field's label focuses its field, and the text inside a button
    /// focuses the button.
    ///
    /// What can take the focus is what a browser lets take it: a control or a
    /// link that is enabled, and a stack given a `hasFocus` or an
    /// `isInFocusOrder`. The `hasFocus` signals of the element that had the
    /// focus and the one that has it now are written, and a tooltip around the
    /// focused element shows its bubble. Then `onFocus(false)` runs on the
    /// element that had the focus and every element around it, and
    /// `onFocus(true)` on the one that has it now and every element around it,
    /// as a browser's `focusout` and `focusin` do. `tab`, `shiftTab`, `press`
    /// and a write to a `hasFocus` signal move the focus the same way. So does
    /// a `dialog` as it opens: the focus moves to the first element inside it
    /// that can take it, Tab or no Tab, or off the page when none can.
    ///
    /// Aborts when no element has that name,
    /// or when it is nothing a reader can focus: one that is disabled, or that
    /// an open `dialog` has taken out of reach.
    export fn focus(self, name: Str): ();

    /// The name of the element that has the focus — its label, or else its
    /// text, and a field's label for a field — or `""` when nothing has it.
    export fn focused(self): Str;

    /// Presses Tab: every `onKey` from the focused element out hears `"Tab"`,
    /// and unless one claims it the focus moves to the next element in the
    /// focus order, in document order, wrapping round at the end.
    ///
    /// The order is every element a reader can focus, less what
    /// `isInFocusOrder` takes out of it. A radio group is one stop, at its
    /// checked option. With a `dialog` open, it is what is inside the dialog.
    export fn tab(self): ();

    /// Presses Shift+Tab: `tab`, the other way round the order.
    export fn shiftTab(self): ();

    /// Presses `key` — `"Escape"`, `"ArrowDown"`, the name a browser gives one
    /// — while the focus is where it is.
    ///
    /// Every `onKey` from the focused element out to the root hears it, the
    /// innermost first. When none of them claims it, what a browser does with
    /// the key by itself follows:
    ///
    ///  * Escape hides a tooltip that is showing and shuts the open `dialog`,
    ///    writing its `isOpen` `false`. However a dialog shuts, the focus goes
    ///    back to the element that had it when the dialog opened, while that
    ///    element can still take it.
    ///  * Enter and Space press a focused button, as `press` does, and open or
    ///    shut a focused disclosure. Enter follows a focused link, as `follow`
    ///    does.
    ///  * Space flips a focused toggle and checks a focused radio.
    ///  * The arrow keys move a radio group's focus and choice to the next
    ///    option or the one before, wrapping round.
    ///  * On a slider, an arrow moves the value one `step` (one when it has
    ///    none), Page Up and Page Down a tenth of the track or a step when that
    ///    is more, and Home and End to either end.
    ///  * Enter in a form's field submits the form, as `submit` does. A
    ///    multiline field takes Enter as a new line, so it submits nothing.
    ///  * In a text, multiline, password or search field that keeps a
    ///    `selection`, the left and right arrows move
    ///    the caret one character, or to the start or the end of a selection,
    ///    and Home and End move it to the start or the end of the line. A
    ///    character is what a reader sees as one, an emoji with its skin tone
    ///    too. The offsets count UTF-16 code units and a line break as one, as
    ///    a browser's do. The
    ///    up and down arrows leave the caret where it is: where they take it
    ///    depends on the platform and on how the field wraps its lines.
    export fn key(self, key: Str): () {
        if (pressKey(self, key)) {
            moveCaret(self, key, caretText(self).graphemes(alloc.generalPurpose()))
        } else {}
    }

    /// Presses the button whose label is `label`.
    ///
    /// Addressed by label rather than by position, the way a reader addresses
    /// it. Aborts when no button carries that label.
    ///
    /// A press is the pointer's, so a button under a `Passthrough(true)` does
    /// nothing at all — which is what a browser does with a click on one, and
    /// what the pass-through is for. A disabled button does nothing either: it
    /// is not dispatched to, so the handler behind it cannot run. Both are a
    /// control this found and refused, not a control it could not find.
    ///
    /// Pressing a `.Submit` button submits the form around it, which is the
    /// browser's own default action for the press rather than a handler the
    /// button carries.
    ///
    /// The press focuses the button before its handler runs, the way a
    /// browser's does, so a handler that hands the focus elsewhere is the one
    /// that decides where it ends up.
    ///
    /// A `dialog` refuses one the same way, both ways round: what is behind an
    /// open modal is inert, and what is inside a shut one is drawn nowhere.
    /// `fill`, `flip` and `submit` follow the same rule.
    export fn press(self, label: Str): ();

    /// Follows the `web.routeLink` labelled `label` with a plain left-click.
    ///
    /// Addressed by the text it shows, the way a reader addresses a link, and it
    /// aborts when no anchor carries that text. A route link answers a plain
    /// click in place — the address moves and the tree stays — so this is how a
    /// test drives an in-app navigation. An ordinary `ui.link` lets the browser
    /// follow the anchor, which a headless document cannot do, so following one
    /// changes nothing and a test says so by what stayed the same.
    ///
    /// A link under a `Passthrough(true)`, or one a `dialog` has taken out of
    /// reach, is not followed, the same rule `press` keeps.
    export fn follow(self, label: Str): ();

    /// Clicks the anchor labelled `label` with ⌘/Ctrl held — what a reader does
    /// to open a link in a new tab.
    ///
    /// A `web.routeLink` leaves a modified click to the browser, so the address
    /// bar does not move: this is the other half of what `follow` asserts, the
    /// click a route does *not* answer. The reachability rules are `follow`'s.
    export fn openInNewTab(self, label: Str): ();

    /// Types `value` into the field labelled `label`, the way a reader replacing
    /// what was there would.
    ///
    /// Nothing is typed into a disabled field, or into one a `dialog` has taken
    /// out of reach, so the signal behind one stays where it was.
    export fn fill(self, label: Str, value: Str): ();

    /// Moves the caret and selection of the field labelled `label` to the
    /// `(anchor, focus)` offsets `start` and `end` — what a reader clicking into
    /// the text, or the program calling `setSelectionRange`, does.
    ///
    /// The two are equal for a plain caret and differ for a selection. It writes
    /// the field's `selection` signal, so a field built without one is left
    /// alone, and a disabled or inert field is not moved. This is how a test
    /// drives the caret a completion or an auto-close reads; what only a browser
    /// does — that a moved row keeps the caret — stays out of reach.
    export fn select(self, label: Str, start: Int, end: Int): ();

    /// Flips the toggle labelled `label`, unless it is disabled or a `dialog`
    /// has taken it out of reach. A radio labelled `label` is checked.
    export fn flip(self, label: Str): ();

    /// Chooses a file in the `filePicker` labelled `label`, the way a reader
    /// picking one in the platform's chooser does.
    ///
    /// ```text
    /// page.pickFile("Import", "sales.csv", "text/csv", bytes.toUtf8(ctx, "a,b\n1,2"));
    /// ```
    ///
    /// `mimeType` is the type a browser reports for the file (`""` when it
    /// knows none) and `content` is its bytes. The picker's `onPick` runs with
    /// what the page would hand it: the file, or `.Err` when the file matches
    /// no `accept` entry, is over `maxBytes`, or is not UTF-8. A disabled
    /// picker, or one a `dialog` has taken out of reach, runs nothing. Aborts
    /// when no picker carries that label.
    export fn pickFile(self, label: Str, name: Str, mimeType: Str, content: [U8]): () {
        let _ = offerFile(self, name, mimeType, content);
        deliverFile(self, label)
    }

    /// Presses the pointer on the element named `label`, at (`x`, `y`).
    ///
    /// ```text
    /// page.pointerDown("Apples", 4.0, 10.0);
    /// page.pointerMove("Pears", 4.0, 60.0);
    /// page.pointerUp("Pears", 4.0, 60.0);
    /// ```
    ///
    /// An element's name is its label, or else its text, the way `follow`
    /// names a link; the innermost element with that name is the one pressed.
    /// The press bubbles: every element from there out to the root that has an
    /// `onPointerDown` runs it. The nearest one with any pointer handler
    /// captures the pointer, so `pointerMove` and `pointerUp` reach it until the
    /// release, wherever they land. The press also reaches `onPressOutside`.
    ///
    /// A headless document has no layout, so every element sits at the
    /// viewport's origin: a handler's `x` and `viewportX` are both `x`. An
    /// element under a `Passthrough(true)` or behind an open `dialog` is not
    /// pressed. Aborts when no element has that name.
    export fn pointerDown(self, label: Str, x: Float, y: Float): ();

    /// Moves the pointer over the element named `over`, to (`x`, `y`).
    ///
    /// While a press is held the move reaches the element that captured it,
    /// not `over`. Otherwise it reaches `over`. Either way it bubbles, and
    /// `over` is what each handler's `overRow` is read from.
    ///
    /// `over` is what the pointer hovers now, so a tooltip around it shows and
    /// one around what it left hides. `onHover(false)` runs on each element
    /// the pointer left, the innermost first, and `onHover(true)` on each one
    /// it entered, the outermost first, as a browser's `mouseleave` and
    /// `mouseenter` do. `pointerDown`, `pointerUp` and `press` hover what they
    /// name the same way.
    export fn pointerMove(self, over: Str, x: Float, y: Float): ();

    /// Releases the pointer over the element named `over`, at (`x`, `y`), and
    /// ends the capture. It is routed the way `pointerMove` is.
    export fn pointerUp(self, over: Str, x: Float, y: Float): ();

    /// Drags the element named `label` onto the element named `to`: a
    /// `pointerDown` on the one, then a `pointerMove` and a `pointerUp` over the
    /// other, all at the origin.
    ///
    /// ```text
    /// page.drag("Apples", "Cherries");
    /// ```
    export fn drag(self, label: Str, to: Str): () {
        let _ = self.pointerDown(label, 0.0, 0.0);
        let _ = self.pointerMove(to, 0.0, 0.0);
        self.pointerUp(to, 0.0, 0.0)
    }

    /// Submits the `index`th form, oldest first — what pressing Enter in one of
    /// its fields does.
    ///
    /// Implicit submission is the platform's rule, so this follows it: a form
    /// is submitted through its first `.Submit` button, unless that button is
    /// disabled, and a form with none is submitted only while exactly one of
    /// its fields blocks implicit submission. A form
    /// of two fields ending in an ordinary `button` is left alone, because that
    /// is what a browser does with the keypress. A double that submitted it
    /// anyway would pass a suite whose form nobody can send. A form a `dialog`
    /// has taken out of reach submits nothing.
    export fn submit(self, index: Int): ();

    /// How many elements of this kind the tree holds. The name is the one
    /// `markup` shows.
    export fn count(self, name: Str): Int;

    /// What the `index`th element of this kind is, as a number the runtime gives
    /// an element when it creates it and never gives to another.
    ///
    /// This is how a test says a keyed list *moved* a row rather than rebuilding
    /// it: the identity survives a reorder, and a rebuild changes it.
    export fn identity(self, name: Str, index: Int): Int;
}

/// `Rendered.key` up to the caret: every `onKey` hears `key`, and what a
/// browser does with it by itself follows. Answers whether what is left is a
/// caret key in the focused field that keeps a `selection`.
fn pressKey(page: Rendered, key: Str): Bool;

/// The text of the focused field.
fn caretText(page: Rendered): Str;

/// Moves the focused field's caret for `key`, over its text's `graphemes`.
fn moveCaret(page: Rendered, key: Str, graphemes: [Str]): ();

/// `pickFile`'s first half: keep the file on the document for the picker's
/// handler to read. Two calls rather than one, because five arguments are more
/// machine words than a runtime call takes (`stencil/abi.rs`'s `MAX_INT_ARGS`).
fn offerFile(page: Rendered, name: Str, mimeType: Str, content: [U8]): ();

/// `pickFile`'s second half: fire the handler of the picker labelled `label`.
fn deliverFile(page: Rendered, label: Str): ();

/// The stylesheet the compiler extracted for this artifact.
///
/// It holds every static style in the program, as one atomic class per distinct
/// property value, deduped across the whole build. So a test can assert what a
/// class *means*, and see that two modules asking for one padding produced one
/// rule and not two.
///
/// Ahead of the classes is the reset: what a browser would paint by itself on
/// a heading, a button, a link or a field, dropped for the elements this
/// program builds.
export fn stylesheet(): Str;

/// Installs `themes` exactly as `mount` does, and answers the `:root` block
/// they resolve to — the custom properties, and the `color-scheme` a
/// `theme.scheme` writes.
///
/// This is how a test asserts what a token is *worth*: the stylesheet says only
/// that a class reads `var(--cardlib-surface)`. A chain resolves here once, the
/// way it resolves at mount.
///
/// `themes` resolves in `ui/theme` — ordinary Buri that runs on every backend —
/// so this flattens them to the document `ui/theme`'s `document` builds and
/// hands that over to be installed. It installs *reactively*: a `switching`
/// theme's condition is read through the computation's scope, so writing that
/// signal re-flattens and installs the other branch, and reading `variables`
/// again shows it. A **snapshot** needs no installing at all: `snapshot` takes
/// its themes the way `mount` does.
export fn install(themes: [Theme]): Str {
    let ui = headless();
    let _ = ui.watch(fn(scope) => {
        let _ = theme.installDoc(theme.documentUnder(scope, themes));
    });
    theme.variables()
}

/// The custom-property block installed right now.
///
/// Write a signal a `switching` theme's condition depends on, then read this
/// again: that is how a test sees a theme switch.
export fn variables(): Str {
    theme.variables()
}

/// Paints `root` under `themes` and compares it against
/// `test/__snapshots__/<name>.png`.
///
/// ```text
/// snapshot(ctx, "card", card(ctx, "Ada"), .Hover, [cardlib.themed(light)]);
/// ```
///
/// Fails the test when the bytes differ, and writes
/// `test/__snapshots__/<name>.diff.png` beside the golden, or
/// `<name>.2.diff.png` when another test sharing the golden already failed in
/// this run. `buri test --update` writes the golden instead of comparing.
///
/// No window and no browser: `describe` resolves the tree to a scene document
/// and the toolchain's own renderer paints it. `state` is the pseudo-class to
/// paint in, so a hovered card and a resting one are two snapshots of one
/// tree.
///
/// **The picture is the size of what is in it.** The page is 800 CSS pixels
/// across — a viewport width, which `At(.Small)` and every percentage resolve
/// against — and as tall as the paint came to, never less than one line. So a
/// snapshot of a button is the size of a button, a page taller than a screen
/// is painted whole, and nothing is cut off: where paint runs past the page
/// sideways — a dock pinned wider than it, a bleed, a translate off the edge —
/// the picture is wider too, and the layout still ran against the 800.
/// `snapshotWide` is the same picture on a page of a stated width.
///
/// `themes` is `mount`'s parameter, in the same place in the sentence and
/// meaning the same thing: one theme per package whose design tokens this tree
/// uses, and where a chain of tokens resolves into the values the painter
/// reads. That is how a component is snapshotted light and dark — two calls,
/// two theme lists, two pictures. A tree with no tokens passes the empty list.
///
/// The name is a file name and nothing more. It may not be empty and may not
/// hold a path separator.
export fn snapshot<C: Allocator + Ui>(
    ctx: C,
    name: Str,
    root: Node<C>,
    state: State,
    themes: [Theme],
): () {
    snapshotWide(ctx, name, root, state, themes, 800)
}

/// `snapshot`, on a page `width` CSS pixels across rather than on the 800-wide
/// one.
///
/// ```text
/// snapshotWide(ctx, "card-phone", card(ctx, "Ada"), .Hover, [], 390);
/// ```
///
/// A **breakpoint** is the whole of what this is for. `At(.Small)` and its
/// four siblings resolve against the page, so the only way to see one apply
/// and not apply is to paint one tree twice — once narrow enough that it does
/// not and once wide enough that it does.
///
/// Only the width is stated. The page still fits what it holds, because a
/// height a test picks is a height that cuts something off, which is what this
/// picture is not allowed to do.
export fn snapshotWide<C: Allocator + Ui>(
    ctx: C,
    name: Str,
    root: Node<C>,
    state: State,
    themes: [Theme],
    width: Int,
): () {
    let _ = installThemes(theme.document(themes));
    paint(name, node.describeWide(ctx, root, state, width), stateName(state))
}

/// The runner's side: what each token is worth, for the paint that follows.
///
/// A call of its own rather than a fifth argument to `paint`, because four
/// `Str`s is twelve machine words and a runtime call is ten
/// (`stencil/abi.rs`'s `MAX_INT_ARGS`).
fn installThemes(document: Str): ();

/// The runner's side: paint the scene, then compare or record.
fn paint(name: Str, scene: Str, state: Str): ();

/// The state, as the painter spells it.
fn stateName(state: State): Str {
    match (state) {
        .Hover => "hover",
        .Focus => "focus",
        .FocusWithin => "focus-within",
        .Active => "active",
        .Disabled => "disabled",
        .Checked => "checked",
        .Invalid => "invalid",
    }
}
