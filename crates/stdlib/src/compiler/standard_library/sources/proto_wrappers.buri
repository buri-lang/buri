            let value = raw != 0;
            readBoolValue(ctx, b, after, end, base, BoolValue { ..acc, value: value })
        } else {
            let after = proto.skip(b, next, end, base, wire)?;
            readBoolValue(ctx, b, after, end, base, acc)
        }
    }
}

/// proto3 JSON writes a wrapper as the value it wraps, and `null` as absence.
export fn encodeBoolValueJson<C: Allocator>(
    ctx: C,
    value: BoolValue,
): Result<Json, ProtoError> {
    let _ = ctx;
    .Ok(Json.Bool(value.value))
}

/// Reads a proto3 JSON document.
export fn decodeBoolValueJson<C: Allocator>(
    ctx: C,
    doc: Json,
): Result<BoolValue, ProtoError> {
    decodeBoolValueJsonAt(ctx, doc, "$")
}

/// The same, from somewhere inside a larger document.
export fn decodeBoolValueJsonAt<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<BoolValue, ProtoError> {
    let _ = ctx;
    .Ok(BoolValue { value: proto.asBool(doc, path)? })
}

derive Equal, Show for StringValue;
export struct StringValue {
    export value: Str,
}

/// Every field at its proto3 default: what a message of no bytes decodes to.
export fn defaultStringValue(): StringValue {
    StringValue { value: "" }
}

/// How many bytes `encodeStringValue` writes.
export fn sizeStringValue(value: StringValue): Int {
    let size = if (value.value == "") { 0 } else { 1 + proto.strSize(value.value) };
    size
}

/// `encodeStringValue`, appended to `out`.
export fn writeStringValue<C: Allocator>(ctx: C, out: [U8], value: StringValue): [U8] {
    if (value.value == "") {
        out
    } else {
        proto.writeStr(ctx, out.push(ctx, 10), value.value)
    }
}

/// The protobuf wire encoding, fields in schema order.
///
/// A singular field holding its default is omitted, which is what proto3
/// calls the canonical encoding; a field that tracks presence and is set is
/// written whatever it holds, because that is the difference presence buys.
export fn encodeStringValue<C: Allocator>(ctx: C, value: StringValue): [U8] {
    writeStringValue(ctx, list.empty<U8>(), value)
}

/// Reads one message. A field this schema does not know is skipped, which is
/// proto3's forward compatibility and the whole of it.
export fn decodeStringValue<C: Allocator>(
    ctx: C,
    b: [U8],
): Result<StringValue, ProtoError> {
    readStringValue(ctx, b, 0, b.length(), 0, defaultStringValue())
}

/// Reads one message *on top of* another.
///
/// A singular message field that arrives twice is merged rather than
/// replaced — the specification says so, and it is what makes a message
/// splittable across two encodings of itself. Every other kind of field
/// takes the later value, which merging also does.
export fn mergeStringValue<C: Allocator>(
    ctx: C,
    b: [U8],
    into: StringValue,
): Result<StringValue, ProtoError> {
    readStringValue(ctx, b, 0, b.length(), 0, into)
}

/// Reads the fields between `at` and `end` on top of `acc`, in place. An
/// error's offset counts from `base`, where the message starts.
export fn readStringValue<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: StringValue,
): Result<StringValue, ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (field, wire, next) = proto.readTag(b, at, end, base)?;
        if (field == 1 && wire == proto.LEN) {
            let (raw, after) = proto.readStr(ctx, b, next, end, base)?;
            let value = raw;
            readStringValue(ctx, b, after, end, base, StringValue {
                ..acc,
                value: value,
            })
        } else {
            let after = proto.skip(b, next, end, base, wire)?;
            readStringValue(ctx, b, after, end, base, acc)
        }
    }
}

/// proto3 JSON writes a wrapper as the value it wraps, and `null` as absence.
export fn encodeStringValueJson<C: Allocator>(
    ctx: C,
    value: StringValue,
): Result<Json, ProtoError> {
    let _ = ctx;
    .Ok(Json.Str(value.value))
}

/// Reads a proto3 JSON document.
export fn decodeStringValueJson<C: Allocator>(
    ctx: C,
    doc: Json,
): Result<StringValue, ProtoError> {
    decodeStringValueJsonAt(ctx, doc, "$")
}

/// The same, from somewhere inside a larger document.
export fn decodeStringValueJsonAt<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<StringValue, ProtoError> {
    let _ = ctx;
    .Ok(StringValue { value: proto.asStr(doc, path)? })
}

derive Equal, Show for BytesValue;
export struct BytesValue {
    export value: [U8],
}

/// Every field at its proto3 default: what a message of no bytes decodes to.
export fn defaultBytesValue(): BytesValue {
    BytesValue { value: list.empty<U8>() }
}

/// How many bytes `encodeBytesValue` writes.
export fn sizeBytesValue(value: BytesValue): Int {
    let size = if (value.value.length() == 0) {
        0
    } else {
        1 + proto.lenSize(value.value.length())
    };
    size
}

/// `encodeBytesValue`, appended to `out`.
export fn writeBytesValue<C: Allocator>(ctx: C, out: [U8], value: BytesValue): [U8] {
    if (value.value.length() == 0) {
        out
    } else {
        proto.writeBytes(ctx, out.push(ctx, 10), value.value)
    }
}

/// The protobuf wire encoding, fields in schema order.
///
/// A singular field holding its default is omitted, which is what proto3
/// calls the canonical encoding; a field that tracks presence and is set is
/// written whatever it holds, because that is the difference presence buys.
export fn encodeBytesValue<C: Allocator>(ctx: C, value: BytesValue): [U8] {
    writeBytesValue(ctx, list.empty<U8>(), value)
}

/// Reads one message. A field this schema does not know is skipped, which is
/// proto3's forward compatibility and the whole of it.
export fn decodeBytesValue<C: Allocator>(
    ctx: C,
    b: [U8],
): Result<BytesValue, ProtoError> {
    readBytesValue(ctx, b, 0, b.length(), 0, defaultBytesValue())
}

/// Reads one message *on top of* another.
///
/// A singular message field that arrives twice is merged rather than
/// replaced — the specification says so, and it is what makes a message
/// splittable across two encodings of itself. Every other kind of field
/// takes the later value, which merging also does.
export fn mergeBytesValue<C: Allocator>(
    ctx: C,
    b: [U8],
    into: BytesValue,
): Result<BytesValue, ProtoError> {
    readBytesValue(ctx, b, 0, b.length(), 0, into)
}

/// Reads the fields between `at` and `end` on top of `acc`, in place. An
/// error's offset counts from `base`, where the message starts.
export fn readBytesValue<C: Allocator>(
    ctx: C,
    b: [U8],
    at: Int,
    end: Int,
    base: Int,
    acc: BytesValue,
): Result<BytesValue, ProtoError> {
    if (at >= end) {
        .Ok(acc)
    } else {
        let (field, wire, next) = proto.readTag(b, at, end, base)?;
        if (field == 1 && wire == proto.LEN) {
            let (raw, after) = proto.readBytes(ctx, b, next, end, base)?;
            let value = raw;
            readBytesValue(ctx, b, after, end, base, BytesValue { ..acc, value: value })
        } else {
            let after = proto.skip(b, next, end, base, wire)?;
            readBytesValue(ctx, b, after, end, base, acc)
        }
    }
}

/// proto3 JSON writes a wrapper as the value it wraps, and `null` as absence.
export fn encodeBytesValueJson<C: Allocator>(
    ctx: C,
    value: BytesValue,
): Result<Json, ProtoError> {
    .Ok(proto.jsonBytes(ctx, value.value))
}

/// Reads a proto3 JSON document.
export fn decodeBytesValueJson<C: Allocator>(
    ctx: C,
    doc: Json,
): Result<BytesValue, ProtoError> {
    decodeBytesValueJsonAt(ctx, doc, "$")
}

/// The same, from somewhere inside a larger document.
export fn decodeBytesValueJsonAt<C: Allocator>(
    ctx: C,
    doc: Json,
    path: Str,
): Result<BytesValue, ProtoError> {
    .Ok(BytesValue { value: proto.asBytes(ctx, doc, path)? })
}
