// `expand` (exhaustiveness.rs) only splits or-patterns it finds at the TOP of a
// column. A nested one survives, is exposed by `specialize`, and is then
// dropped -- `specializeRow` and `defaultRow` both ignore an or-headed row.
// Prediction: this exhaustive match is rejected.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn describe(x: Option<Bool>): Int {
    match (x) {
        .Some(true | false) => 1,
        .None => 0,
    }
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let n = describe(.Some(true));
    let _ = io.println(ctx, "${n}").ignore();
    .Ok(())
}
