// FINDING 4: `Ty::Param(i)` with no effect bound is not effect-carrying, and
// `check_ctx_rule` runs on the pre-instantiation signature. So a generic
// closure-builder should typecheck, and instantiating T at a context type
// would put a capability in a closure the capture rule never inspected.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

// Nothing here mentions an effect, so the capture rule is silent.
fn hide<T>(x: T): fn() => T {
    fn() => x
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };

    // Does the *instantiation* at a context type get caught?
    let smuggler = hide(ctx);
    let recovered = smuggler();
    let _ = io.println(recovered, "laundered").ignore();
    .Ok(())
}
