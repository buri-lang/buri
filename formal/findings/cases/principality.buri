// FINDING 5: `satisfies` returns true for Ty::Var (infer.rs), so bounds are
// discharged only AFTER default_numerics commits a literal to I64/F64. Is
// there a bound that I64 fails but another integer type satisfies?
from "core/effect" import { Allocator, Stdout };
from "core/host" import * as host;
from "core/io" import * as io;
from "core/number" import { Negate, Wrapping };

fn negate<T: Negate>(x: T): T {
    -x
}

export fn main(): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    // Only constraint on this literal is `T: Negate`. Defaulting picks I64, which
    // has Negate -- so this should work.
    let a = negate(5);
    let _ = io.println(ctx, "negate(5) = ${a}").ignore();
    .Ok(())
}
