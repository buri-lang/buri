// FINDING 1: `boom` is pure by every criterion SPEC 10.4 names — no `ctx`, no
// effect-carrying `self`, no capture, no context construction. If a pure call
// "may be freely eliminated", then eliminating `let _ = boom(0)` turns an
// aborting program into a printing one. Those are not the same program.

from "core/io" import * as io;
from "node" import { NodeHost };
from "platform/effect" import { Allocator, Stdout };

fn boom(x: Int): Int {
    100 / x
}

export fn main(host: NodeHost): Result<(), Str> {
    let ctx = context {
        Allocator: host.alloc,
        Stdout: host.stdout,
    };
    let _ = boom(0);
    let _ = io.println(ctx, "if you can read this, the call was eliminated").ignore();
    .Ok(())
}
